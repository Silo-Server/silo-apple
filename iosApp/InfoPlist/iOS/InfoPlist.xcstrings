{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "comment" : "iOS permission prompt text the system shows when Silo first asks for this access. Keep it in step with iosApp/iosApp/Info.plist.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Silo شبكتك المحلية للعثور على خوادم Silo، ولإعداد Silo على التلفزيون والعثور عليه والتحكم فيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo verwendet dein lokales Netzwerk, um Silo-Server zu finden und um Silo auf deinem Fernseher einzurichten, zu finden und zu steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo uses your local network to find Silo servers, and to set up, find, and control Silo on your TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo usa tu red local para encontrar servidores de Silo y para configurar, encontrar y controlar Silo en tu TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo utilise votre réseau local pour trouver des serveurs Silo, et pour configurer, trouver et contrôler Silo sur votre TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloはローカルネットワークを使用して、Siloサーバーを検出したり、テレビのSiloを設定・検出・操作したりします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo usa sua rede local para encontrar servidores Silo e para configurar, encontrar e controlar o Silo na sua TV."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo使用你的本地网络查找Silo服务器，以及在你的电视上设置、查找和控制Silo。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
