{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "comment" : "tvOS permission prompt text the system shows when Silo first asks for this access. Keep it in step with iosApp/iosApp/tvOS-Info.plist.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Silo شبكتك المحلية للعثور على خوادم Silo، ولإعداد Silo على Apple TV والتحكم فيه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo използва локалната ви мрежа, за да намира сървъри на Silo и да настройва и управлява Silo на вашия Apple TV."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo utilitza la xarxa local per trobar servidors de Silo i per configurar i controlar Silo a l’Apple TV."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo používá vaši místní síť k vyhledání serverů Silo a k nastavení a ovládání aplikace Silo na vašem Apple TV."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo bruger dit lokale netværk til at finde Silo-servere og til at konfigurere og styre Silo på dit Apple TV."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo verwendet dein lokales Netzwerk, um Silo-Server zu finden und um Silo auf deinem Apple TV einzurichten und zu steuern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Silo χρησιμοποιεί το τοπικό σας δίκτυο για να βρίσκει διακομιστές Silo και για να ρυθμίζει και να ελέγχει το Silo στο Apple TV σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo uses your local network to find Silo servers, and to set up and control Silo on your Apple TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo usa tu red local para encontrar servidores de Silo y para configurar y controlar Silo en tu Apple TV."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kasutab teie kohtvõrku, et leida Silo servereid ning seadistada ja juhtida Silot teie Apple TV-s."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo käyttää lähiverkkoasi Silo-palvelimien löytämiseen sekä Silon määrittämiseen ja ohjaamiseen Apple TV:ssäsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo utilise votre réseau local pour trouver des serveurs Silo, et pour configurer et contrôler Silo sur votre Apple TV."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרשת המקומית שלך משמשת את Silo כדי למצוא שרתי Silo, וכדי להגדיר את Silo ב-Apple TV ולשלוט בו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo सर्वर ढूँढने के लिए और आपके Apple TV पर Silo को सेट अप और कंट्रोल करने के लिए Silo आपके लोकल नेटवर्क का इस्तेमाल करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo upotrebljava vašu lokalnu mrežu za pronalaženje poslužitelja Silo te za postavljanje i upravljanje aplikacijom Silo na vašem Apple TV-u."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo a helyi hálózatot használja a Silo szerverek megkereséséhez, valamint az Apple TV-n futó Silo beállításához és vezérléséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo menggunakan jaringan lokal Anda untuk menemukan server Silo, serta untuk menyiapkan dan mengontrol Silo di Apple TV Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo usa la tua rete locale per trovare i server Silo e per configurare e controllare Silo sulla tua Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloはローカルネットワークを使用して、Siloサーバーを検出したり、Apple TV のSiloを設定・操作したりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo는 로컬 네트워크를 사용해 Silo 서버를 찾고, Apple TV에서 Silo를 설정하고 제어해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Silo“ naudoja jūsų vietinį tinklą, kad rastų „Silo“ serverius, taip pat kad nustatytų ir valdytų „Silo“ jūsų „Apple TV“ įrenginyje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo izmanto jūsu lokālo tīklu, lai atrastu Silo serverus, kā arī lai iestatītu un vadītu Silo jūsu Apple TV ierīcē."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo menggunakan rangkaian setempat anda untuk mencari pelayan Silo, serta untuk menyediakan dan mengawal Silo pada Apple TV anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo bruker det lokale nettverket ditt til å finne Silo-servere og til å konfigurere og styre Silo på Apple TV-en din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo gebruikt je lokale netwerk om Silo-servers te vinden, en om Silo op je Apple TV in te stellen en te bedienen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo używa sieci lokalnej do wyszukiwania serwerów Silo oraz do konfigurowania aplikacji Silo na urządzeniu Apple TV i sterowania nią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo usa sua rede local para encontrar servidores Silo e para configurar e controlar o Silo na sua Apple TV."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo usa a sua rede local para encontrar servidores Silo e para configurar e controlar o Silo na sua Apple TV."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo folosește rețeaua locală pentru a găsi servere Silo și pentru a configura și controla Silo pe Apple TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo использует локальную сеть, чтобы находить серверы Silo, а также настраивать Silo на вашем Apple TV и управлять им."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo používa vašu lokálnu sieť na vyhľadávanie serverov Silo a na nastavenie a ovládanie aplikácie Silo na vašom Apple TV."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo uporablja vaše lokalno omrežje za iskanje strežnikov Silo ter za nastavitev in upravljanje aplikacije Silo v napravi Apple TV."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo använder ditt lokala nätverk för att hitta Silo-servrar och för att konfigurera och styra Silo på din Apple TV."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ใช้เครือข่ายภายในเพื่อค้นหาเซิร์ฟเวอร์ Silo และเพื่อตั้งค่าและควบคุม Silo บน Apple TV"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo, Silo sunucularını bulmak ve Apple TV’nizde Silo’yu kurmak ve kontrol etmek için yerel ağınızı kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo використовує вашу локальну мережу, щоб знаходити сервери Silo, а також налаштовувати Silo на Apple TV і керувати ним."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo dùng mạng cục bộ của bạn để tìm máy chủ Silo, cũng như để thiết lập và điều khiển Silo trên Apple TV."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo使用你的本地网络查找Silo服务器，以及在你的Apple TV上设置和控制Silo。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo 會使用你的區域網路來尋找 Silo 伺服器，以及在你的 Apple TV 上設定和控制 Silo。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
