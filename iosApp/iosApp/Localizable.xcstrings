    "signIn.expired" : {
      "comment" : "Message on the Roku sign-in screen shown when the saved session ended. {server}: the server name. Apple (iPhone, iPad, Mac, Apple TV): same line on the sign-in screen after the saved session ended.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تسجيل خروجك من %1$@. سجّل الدخول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сесията ви в сървъра %1$@ приключи. Влезте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ha tancat la teva sessió al servidor %1$@. Torna a iniciar la sessió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relace na serveru %1$@ skončila. Je nutné se znovu přihlásit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blev logget ud af %1$@. Log ind igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wurdest von %1$@ abgemeldet. Melde dich erneut an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποσυνδεθήκατε από τον διακομιστή %1$@. Συνδεθείτε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You were signed out of %1$@. Sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerró tu sesión en %1$@. Vuelve a iniciar sesión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teid logiti serverist %1$@ välja. Logige uuesti sisse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinut kirjattiin ulos palvelimelta %1$@. Kirjaudu uudelleen sisään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre session sur %1$@ a expiré. Reconnectez-vous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התנתקת מהשרת %1$@. יש להתחבר שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको %1$@ से साइन आउट कर दिया गया। फिर से साइन इन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odjavljeni ste s poslužitelja %1$@. Ponovno se prijavite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A munkamenet lejárt a(z) %1$@ szerveren. Jelentkezzen be újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda telah dikeluarkan dari server %1$@. Masuk lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei stato disconnesso da %1$@. Accedi di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@からサインアウトされました。もう一度サインインしてください。"
