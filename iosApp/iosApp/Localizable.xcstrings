        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that %1$@ shows"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que %1$@ muestre"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
