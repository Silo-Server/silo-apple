    "settingsManifest.player.resume_rewind_seconds.description" : {
      "comment" : "Help text under the player.resume_rewind_seconds setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرجوع هذا القدر عند استئناف عنصر شوهد جزئيًا، لاستعادة السياق. القيمة 0 تعطّل هذا الخيار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Fortsetzen eines teilweise angesehenen Titels so weit zurückspulen, um wieder in die Handlung zu finden. 0 schaltet es aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip back this far when resuming a partly watched item, to re-establish context. 0 turns it off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrocede esta cantidad al reanudar un elemento visto en parte, para retomar el contexto. Con 0 se desactiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reculer d’autant lors de la reprise d’un élément partiellement regardé, pour retrouver le fil. 0 désactive cette option."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "途中まで視聴した項目を再開するとき、内容を思い出せるようにこの秒数だけ巻き戻します。0にするとオフになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volta esse tanto ao retomar um item assistido em parte, para relembrar o contexto. 0 desativa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续播放看过一部分的内容时，先后退这么多，帮你回忆上下文。设为0则关闭。"
          }
        }
      }
    },
    "settingsManifest.player.resume_rewind_seconds.label" : {
