    "tvPair.link.addServerBody" : {
      "comment" : "Apple (iPhone, iPad) Sign in a TV from a link: body under \"Add this server?\". {host}: the server's host name (for example media.example.com).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينتمي رمز التلفزيون إلى %1$@، وهو غير موجود على هذا الجهاز بعد. أضفه وسجّل الدخول، ثم وافق على التلفزيون."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kód televize patří k serveru %1$@, který na tomto zařízení zatím není. Přidejte ho a po přihlášení televizi schvalte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tv’ets kode hører til %1$@, som ikke er på denne enhed endnu. Tilføj den og log ind, og godkend derefter tv’et."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code des Fernsehers gehört zu %1$@, der noch nicht auf diesem Gerät ist. Füge ihn hinzu, melde dich an und genehmige dann den Fernseher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The TV's code belongs to %1$@, which isn't on this device yet. Add it and sign in, then approve the TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código de la TV pertenece a %1$@, que aún no está en este dispositivo. Añádelo, inicia sesión y luego aprueba la TV."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tv:n koodi kuuluu palvelimelle %1$@, jota ei ole vielä tällä laitteella. Lisää se ja kirjaudu sisään, ja hyväksy sitten tv."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code de la TV appartient à %1$@, qui n’est pas encore sur cet appareil. Ajoutez-le et connectez-vous, puis approuvez la TV."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kôd TV-a pripada poslužitelju %1$@, koji još nije na ovom uređaju. Dodajte ga i prijavite se, a zatim odobrite TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il codice della TV appartiene a %1$@, un server non ancora presente su questo dispositivo. Aggiungi il server e accedi, poi approva la TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テレビのコードは%1$@のものですが、このデバイスにはまだ追加されていません。追加してサインインしてから、テレビを承認してください。"
