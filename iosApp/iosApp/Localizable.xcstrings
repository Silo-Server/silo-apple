    "player.error.unauthenticatedTransport" : {
      "comment" : "Apple iOS/tvOS/macOS: player error when the server's playback plan doesn't use the authenticated media transport this app requires. Used by the audiobook player.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يلتزم هذا الخادم بنقل الوسائط المصادَق عليه في خطة التشغيل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този сървър не спази удостоверения медиен транспорт за плана за възпроизвеждане."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest servidor no ha respectat el transport multimèdia autenticat per al pla de reproducció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server nedodržel pro plán přehrávání ověřený přenos médií."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren overholdt ikke godkendt medietransport for afspilningsplanen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server hat den authentifizierten Medientransport für den Wiedergabeplan nicht eingehalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο διακομιστής δεν τήρησε την πιστοποιημένη μεταφορά πολυμέσων για το σχέδιο αναπαραγωγής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server did not honor authenticated media transport for the playback plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
