    "remote.replace.profileWatchingTheTv" : {
      "comment" : "Apple iOS: Remote Control \"Replace What's Playing?\" alert message when the TV's name is not known. {profile}: the other profile's name, {title}: what it is watching (title, or series and episode).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشاهد %1$@ %2$@ على التلفزيون. هل تريد تشغيل ما اخترته بدلًا منه؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil %1$@ na televizi sleduje %2$@. Přehrát místo toho váš výběr?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ser %2$@ på tv’et. Vil du afspille dit i stedet?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ schaut gerade %2$@ auf dem Fernseher. Stattdessen deine Auswahl abspielen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is watching %2$@ on the TV. Play yours instead?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está viendo %2$@ en la TV. ¿Reproducir lo tuyo en su lugar?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ katsoo tv:ssä kohdetta %2$@. Toistetaanko omasi sen sijaan?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ regarde %2$@ sur la TV. Lire votre contenu à la place ?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gleda %2$@ na TV-u. Želite li umjesto toga reproducirati svoje?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sta guardando %2$@ sulla TV. Vuoi riprodurre il tuo contenuto?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@がテレビで%2$@を視聴中です。代わりに再生しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@님이 TV에서 %2$@을(를) 보고 있어요. 대신 내 항목을 재생할까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ser på %2$@ på TV-en. Vil du spille av ditt i stedet?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kijkt op de tv naar %2$@. Wil je in plaats daarvan jouw titel afspelen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ogląda na telewizorze: %2$@. Odtworzyć zamiast tego twój wybór?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está assistindo a %2$@ na TV. Reproduzir o seu no lugar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На телевизоре профиль %1$@ смотрит «%2$@». Воспроизвести ваше вместо этого?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tittar på %2$@ på tv:n. Vill du spela upp ditt i stället?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ profili TV’de %2$@ içeriğini izliyor. Bunun yerine sizinkini oynatmak istiyor musunuz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ дивиться %2$@ на телевізорі. Відтворити ваше натомість?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@正在电视上观看%2$@。要改为播放你的内容吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 正在電視上觀看 %2$@。要改播你的內容嗎？"
          }
        }
      }
    },
