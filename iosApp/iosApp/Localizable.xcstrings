          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu neizdevies pieprasījums vienumam „%1$@” tiks izdzēsts. Vēlāk šo vienumu varēsiet pieprasīt vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan anda yang gagal untuk “%1$@” akan dipadam. Anda boleh meminta tajuk ini lagi kemudian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den mislykkede forespørselen din om «%1$@» blir slettet. Du kan be om tittelen igjen senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mislukte aanvraag voor “%1$@” wordt verwijderd. Je kunt de titel later opnieuw aanvragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja nieudana prośba o „%1$@” zostanie usunięta. Możesz później ponownie poprosić o ten tytuł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua solicitação com falha de “%1$@” será excluída. Você pode solicitar o título novamente mais tarde."
          }
