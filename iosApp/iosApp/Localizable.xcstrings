          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte prijedlog u red da bi bio sljedeći."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegyen egyet a várólistára, hogy az következzen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
