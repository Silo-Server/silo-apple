    "requests.remove.body" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message of the Remove this request? dialog. {title}: the movie or series title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف طلبك الفاشل لـ«%1$@». يمكنك طلب العنوان مرة أخرى لاحقًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неуспешната ви заявка за „%1$@“ ще бъде изтрита. По-късно можете да заявите заглавието отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’eliminarà la sol·licitud de «%1$@» que ha fallat. Podràs tornar a sol·licitar el títol més endavant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše neúspěšná žádost o titul „%1$@“ bude smazána. Později si ho můžete vyžádat znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din mislykkede anmodning om ”%1$@” bliver slettet. Du kan anmode om titlen igen senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine fehlgeschlagene Anfrage für „%1$@“ wird gelöscht. Du kannst den Titel später erneut anfragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αποτυχημένο αίτημά σας για τον τίτλο «%1$@» θα διαγραφεί. Μπορείτε να ζητήσετε ξανά τον τίτλο αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your failed request for “%1$@” will be deleted. You can request the title again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará tu solicitud fallida de “%1$@”. Puedes volver a solicitar el título más adelante."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie ebaõnnestunud taotlus pealkirjale „%1$@“ kustutatakse. Saate seda pealkirja hiljem uuesti taotleda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epäonnistunut pyyntösi kohteesta ”%1$@” poistetaan. Voit pyytää nimikettä uudelleen myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre demande échouée pour « %1$@ » sera supprimée. Vous pourrez demander ce titre à nouveau plus tard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבקשה שנכשלה עבור ”%1$@” תימחק. אפשר לבקש את הפריט שוב מאוחר יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” के लिए आपका विफल अनुरोध मिटा दिया जाएगा। इस टाइटल का बाद में फिर से अनुरोध किया जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš neuspjeli zahtjev za „%1$@“ bit će izbrisan. Naslov možete ponovno zatražiti kasnije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A következő címre vonatkozó sikertelen kérése törlődik: „%1$@”. A címet később újra igényelheti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan Anda yang gagal untuk “%1$@” akan dihapus. Anda dapat meminta judul ini lagi nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua richiesta non riuscita per “%1$@” verrà eliminata. Potrai richiedere di nuovo il titolo più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」の失敗したリクエストを削除します。このタイトルは後でもう一度リクエストできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”에 대한 실패한 요청이 삭제돼요. 나중에 다시 요청할 수 있어요."
          }
