            "value" : "Вибір якості недоступний для офлайн-відтворення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离线播放时无法选择画质。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
