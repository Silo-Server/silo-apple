    "player.notice.liveSubtitlesPreparing" : {
      "comment" : "Apple iOS/tvOS/macOS: video player notice text under Preparing subtitles while AI subtitles are generated.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ إنشاء الترجمة للمشهد الحالي — سيُستأنف التشغيل بعد لحظات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generují se titulky pro aktuální scénu — přehrávání bude za chvíli pokračovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genererer undertekster til den aktuelle scene — afspilningen fortsætter om et øjeblik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel für die aktuelle Szene werden erstellt – die Wiedergabe wird gleich fortgesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generating subtitles for the current scene — playback resumes in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generando subtítulos para la escena actual: la reproducción se reanudará en un momento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luodaan tekstitystä nykyiselle kohtaukselle – toisto jatkuu hetken kuluttua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Génération des sous-titres pour la scène en cours — la lecture reprend dans un instant."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generiranje titlova za trenutačnu scenu — reprodukcija se nastavlja za trenutak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generazione dei sottotitoli per la scena corrente — la riproduzione riprenderà a breve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のシーンの字幕を生成しています。まもなく再生が再開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 장면의 자막을 생성하고 있어요. 잠시 후 재생이 다시 시작돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lager undertekster for gjeldende scene – avspillingen fortsetter om et øyeblikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondertitels voor de huidige scène worden gemaakt — het afspelen gaat zo verder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generowanie napisów dla bieżącej sceny — odtwarzanie zostanie za chwilę wznowione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerando legendas para a cena atual — a reprodução será retomada em instantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаются субтитры для текущей сцены — воспроизведение скоро продолжится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapar undertexter för den aktuella scenen – uppspelningen fortsätter strax."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli sahne için altyazılar oluşturuluyor — oynatma birazdan devam edecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створюємо субтитри для поточної сцени – відтворення відновиться за мить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在为当前场景生成字幕，播放即将恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在為目前場景產生字幕，稍後就會繼續播放。"
          }
        }
      }
    },
