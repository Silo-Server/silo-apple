    "downloads.seriesSheet.monitorHint" : {
      "comment" : "Apple iOS/macOS: series Download sheet, opened from a series page; note under the segments when Monitor is chosen. {device}: the device model name from the system, such as iPhone, iPad or Mac.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مواصلة تنزيل الحلقات الجديدة على جهاز %1$@ هذا فور عرضها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové díly se budou do zařízení %1$@ stahovat hned po odvysílání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få nye afsnit til denne %1$@, efterhånden som de sendes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Folgen kommen nach der Ausstrahlung automatisch auf dieses %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep new episodes coming to this %1$@ as they air."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe los episodios nuevos en este %1$@ a medida que se estrenan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudet jaksot ladataan laitteeseen %1$@ sitä mukaa kuin ne julkaistaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez les nouveaux épisodes sur votre %1$@ dès leur diffusion."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nove epizode stizat će na ovaj %1$@ čim se emitiraju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi i nuovi episodi su questo %1$@ appena vanno in onda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいエピソードが配信されるたびに、この%1$@にダウンロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 에피소드가 방영되면 이 %1$@에 계속 받아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få nye episoder på %1$@ etter hvert som de sendes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe afleveringen komen naar je %1$@ zodra ze verschijnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe odcinki będą trafiać na urządzenie %1$@ w miarę emisji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba novos episódios neste %1$@ conforme forem ao ar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые серии будут скачиваться на устройство %1$@ по мере выхода."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nya avsnitt laddas ned till den här enheten (%1$@) när de sänds."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bölümler yayınlandıkça bu %1$@ cihazına indirilmeye devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові епізоди завантажуватимуться на цей %1$@ у міру виходу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新集播出后自动下载到这台%1$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新集數播出後，會持續下載到此 %1$@。"
          }
        }
      }
    },
    "downloads.seriesSheet.monitorOriginal" : {
      "comment" : "Apple iOS/macOS: series Download sheet, opened from a series page; note under the Monitor options; may follow the next episode's air day and a period.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنزَّل الحلقات المتابَعة بالجودة الأصلية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledované díly se stahují v původní kvalitě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overvågede afsnit downloades i originalkvalitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überwachte Folgen werden in Originalqualität heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitored episodes download in original quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios supervisados se descargan en calidad original."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seurattavat jaksot ladataan alkuperäisessä laadussa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes surveillés sont téléchargés en qualité originale."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praćene epizode preuzimaju se u izvornoj kvaliteti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli episodi monitorati vengono scaricati in qualità originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "監視中のエピソードはオリジナル画質でダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모니터링하는 에피소드는 원본 화질로 다운로드돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overvåkede episoder lastes ned i originalkvalitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gevolgde afleveringen worden in originele kwaliteit gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitorowane odcinki są pobierane w oryginalnej jakości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episódios monitorados são baixados na qualidade original."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживаемые серии скачиваются в оригинальном качестве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevakade avsnitt laddas ned i originalkvalitet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takip edilen bölümler orijinal kalitede indirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відстежувані епізоди завантажуються в оригінальній якості."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "监控的集以原始画质下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "監看的集數會以原始畫質下載。"
          }
        }
      }
    },
