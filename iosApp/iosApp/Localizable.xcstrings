          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server did not preserve authenticated media transport during replanning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no mantuvo el transporte autenticado del contenido durante la replanificación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
