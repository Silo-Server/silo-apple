          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj på din telefon eller surfplatta vilka servrar den här Apple TV:n ska logga in på."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บนโทรศัพท์หรือแท็บเล็ต ให้เลือกเซิร์ฟเวอร์ที่ Apple TV เครื่องนี้จะลงชื่อเข้าใช้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
