    "home.recipe.nextInSeriesDefault.description" : {
      "comment" : "One-line description of the Next in Series preset in the Add row gallery (shared key `home.recipe.nextInSeriesDefault.description`, sent as description_short_key). Shown under or beside the preset's name.",
