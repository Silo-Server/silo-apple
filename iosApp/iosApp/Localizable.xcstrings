    "settingsManifest.player.audiobook_skip_forward_seconds.description" : {
      "comment" : "Help text under the player.audiobook_skip_forward_seconds setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الثواني للتقديم أثناء تشغيل الكتاب الصوتي. ينطبق على الأزرار واختصارات لوحة المفاتيح والإيماءات وعناصر التحكم في الوسائط المدعومة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekunden, um die bei der Hörbuch-Wiedergabe vorgespult wird. Gilt für Schaltflächen, Tastenkürzel, Gesten und unterstützte Mediensteuerungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seconds to skip forward in audiobook playback. Applies to buttons, keyboard shortcuts, gestures, and supported media controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos que se avanzan en la reproducción de audiolibros. Se aplica a botones, atajos de teclado, gestos y controles multimedia compatibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de secondes d’avance rapide lors de la lecture de livres audio. S’applique aux boutons, aux raccourcis clavier, aux gestes et aux commandes multimédias prises en charge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオブック再生時に早送りする秒数です。ボタン、キーボードショートカット、ジェスチャー、対応するメディアコントロールに適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos para avançar na reprodução de audiolivros. Vale para botões, atalhos de teclado, gestos e controles de mídia compatíveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有声书播放时快进的秒数。适用于按钮、键盘快捷键、手势和受支持的媒体控件。"
          }
        }
      }
    },
