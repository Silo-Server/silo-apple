    "home.recipe.genreRouletteWeekly.description" : {
      "comment" : "One-line description of the Genre Roulette preset in the Add row gallery (shared key `home.recipe.genreRouletteWeekly.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نوع مختلف كل أسبوع، بتقييم 6.0+ على TMDB و100 صوت أو أكثر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý týden jiný žánr, hodnocení 6,0+ na TMDB se 100+ hlasy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny genre hver uge, bedømt 6,0+ på TMDB med 100+ stemmer."
