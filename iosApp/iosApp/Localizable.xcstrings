        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šio „Apple TV“ naudotojo kontekste nenustatyta saugoti atskirų programos nuostatų. „Silo“ naudoja profilio susiejimą, pasiekiamą dabartiniame programos kontekste, ir jį bet kada galite pakeisti čia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī Apple TV lietotāja kontekstā nav iestatīts glabāt atsevišķas lietotnes preferences. Silo izmanto profila savienojumu pārī, kas pieejams pašreizējā lietotnes kontekstā, un jūs to šeit varat mainīt jebkurā laikā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konteks pengguna Apple TV ini tidak ditetapkan untuk menyimpan pilihan apl yang berasingan. Silo menggunakan penggandingan profil yang tersedia kepada konteks apl semasa, dan anda boleh menukarnya di sini pada bila-bila masa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Apple TV-brukerkonteksten er ikke satt til å beholde egne appinnstillinger. Silo bruker profilsammenkoblingen som er tilgjengelig i gjeldende appkontekst, og du kan når som helst endre den her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
