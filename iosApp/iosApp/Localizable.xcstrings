        "cs" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Hostované zprávy používají pseudonymní instalační přihlašovací údaj, který není propojen s vaším účtem Silo. Neobsahují identifikátory účtu, profilu, adresy serveru ani relací přehrávání, uchovávají se až %1$lld dny a nikdy se neodesílají automaticky."
                }
