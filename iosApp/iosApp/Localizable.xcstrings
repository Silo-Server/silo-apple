      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت النسخة الاحتياطية منذ اخترتها. اخترها مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záloha se od vašeho výběru změnila. Vyberte ji znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backuppen er ændret, siden du valgte den. Vælg den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sicherung hat sich geändert, seit du sie ausgewählt hast. Wähle sie erneut aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup changed since you chose it. Choose it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia de seguridad cambió desde que la elegiste. Vuelve a elegirla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmuuskopio on muuttunut sen jälkeen, kun valitsit sen. Valitse se uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde a changé depuis que vous l’avez choisie. Choisissez-la à nouveau."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurnosna kopija promijenila se otkad ste je odabrali. Ponovno je odaberite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il backup è cambiato dopo che l’hai scelto. Sceglilo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択後にバックアップが変更されました。もう一度選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 후에 백업이 변경됐어요. 다시 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhetskopien er endret siden du valgte den. Velg den på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De back-up is gewijzigd sinds je hem koos. Kies hem opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia zapasowa zmieniła się od czasu jej wybrania. Wybierz ją ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O backup mudou desde que você o escolheu. Escolha-o novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервная копия изменилась после того, как вы её выбрали. Выберите её снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhetskopian har ändrats sedan du valde den. Välj den igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedek, siz seçtikten sonra değişti. Yeniden seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервна копія змінилася після того, як ви її вибрали. Виберіть її знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自你选择以来，此备份已更改。请重新选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份在你選擇後已變更。請重新選擇。"
          }
        }
      }
    },
    "error.session_expired" : {
      "comment" : "Error message shown when the server answers with the v2 problem type `session_expired` (server title: \"Session expired\"). Clients show it instead of the server's English detail in a translated interface, so it must make sense on its own, without the request's specifics.",
