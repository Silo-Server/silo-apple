    "pin.forgot" : {
      "comment" : "Phone: hint at the bottom of the full-screen PIN prompt for someone who has forgotten the profile's PIN. Apple (iPhone, iPad, Mac): same hint at the bottom of the PIN prompt.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
