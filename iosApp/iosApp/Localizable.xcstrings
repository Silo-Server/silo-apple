    "diagnostics.prompt.uncleanShutdownCountHosted" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad, Apple TV), shown after a problem report is captured: message when several reports of one kind are waiting: the app did not shut down cleanly this many times. Reports go to Silo Diagnostics, the Silo project's hosted service; Silo Diagnostics is a product name. {count}: how many reports (2 or more in practice).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "لم يُغلق Silo بشكل سليم %1$lld مرات. يمكنك مراجعة التقارير قبل إرسالها إلى فريق Silo Diagnostics."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
