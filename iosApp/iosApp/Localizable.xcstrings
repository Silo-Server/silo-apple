    "shell.error.notFound" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error message under the Not found heading (HTTP 404).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
