    "tvSignIn.nearbyHint" : {
      "comment" : "Android TV hint on the sign-in screen saying nearby phones with Silo on the same Wi-Fi can sign in this TV. Apple TV: same hint on the sign-in screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل لديك Silo على هاتفك؟ افتحه على شبكة Wi‑Fi نفسها لتسجيل دخول هذا التلفزيون."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du Silo auf deinem Smartphone? Öffne die App im selben WLAN, um diesen Fernseher anzumelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have Silo on your phone? Open it on the same Wi‑Fi to sign in this TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes Silo en tu teléfono? Ábrelo en la misma red Wi‑Fi para iniciar sesión en esta TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez Silo sur votre téléphone ? Ouvrez-le sur le même Wi‑Fi pour connecter cette TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンにSiloがありますか？同じWi‑Fiで開くと、このテレビにサインインできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem o Silo no celular? Abra o app na mesma rede Wi‑Fi para conectar esta TV."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机上有Silo？在同一Wi‑Fi下打开它，即可登录这台电视。"
          }
        }
      }
    },
