    "signIn.forgot.loginPlaceholder" : {
      "comment" : "Apple (iPhone, iPad, Mac) Reset password screen: placeholder in the field for the account's username or email address.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسم المستخدم أو البريد الإلكتروني"
          }
        },
        "bg" : {
