        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turpinot daļēji skatītu vienumu, pārtīt atpakaļ par šo laiku, lai atsauktu atmiņā kontekstu. 0 to izslēdz."
