    "settingsManifest.ui.title_art.description" : {
      "comment" : "Help text under the ui.title_art setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام شعار العنوان اسمًا له في صفحات التفاصيل عند توفره. عند تعطيل الخيار، يظهر الاسم نصًا دائمًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използване на логото на заглавието вместо името му в страниците с подробности, когато има такова. Когато е изключено, името винаги се показва като текст."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza el logotip d’un títol com a nom a les pàgines de detalls quan n’hi hagi un. Si està desactivat, el nom es mostra sempre com a text."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na stránkách s podrobnostmi zobrazit místo názvu logo titulu, pokud je k dispozici. Když je tato možnost vypnutá, název se vždy zobrazí jako text."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug en titels logografik som navn på detaljesider, når den findes. Når indstillingen er slået fra, vises navnet altid som tekst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Detailseiten das Logo eines Titels als Namen verwenden, wenn eines verfügbar ist. Bei Aus wird der Name immer als Text angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρήση του λογότυπου ενός τίτλου ως ονόματός του στις σελίδες λεπτομερειών, όταν υπάρχει. Όταν η επιλογή είναι ανενεργή, το όνομα εμφανίζεται πάντα ως κείμενο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a title's logo artwork as its name on detail pages when one is available. When off, the name is always shown as text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el logotipo de un título como su nombre en las páginas de detalles cuando esté disponible. Si está desactivado, el nombre siempre se muestra como texto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui pealkirja logo on saadaval, kasutatakse üksikasjade lehtedel nime asemel seda. Kui see valik on väljas, kuvatakse nimi alati tekstina."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä nimikkeen logokuvaa sen nimenä tietosivuilla, kun sellainen on saatavilla. Kun asetus on pois, nimi näytetään aina tekstinä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le logo d’un titre comme nom sur les pages de détails lorsqu’il est disponible. Si cette option est désactivée, le nom est toujours affiché en texte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שימוש בלוגו של הפריט במקום שמו בדפי הפרטים, כשיש לוגו זמין. כשהאפשרות כבויה, השם תמיד מוצג כטקסט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपलब्ध होने पर, विवरण पेज पर टाइटल के नाम की जगह उसका लोगो आर्टवर्क इस्तेमाल करें। बंद होने पर, नाम हमेशा टेक्स्ट के रूप में दिखाया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na stranicama s detaljima umjesto naziva prikazuje se logotip naslova kad je dostupan. Kad je isključeno, naziv se uvijek prikazuje kao tekst."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha elérhető, a részletes oldalakon a cím logógrafikája jelenik meg névként. Kikapcsolva a név mindig szövegként jelenik meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan artwork logo judul sebagai namanya di halaman detail jika tersedia. Jika nonaktif, nama selalu ditampilkan sebagai teks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle pagine di dettaglio, usa il logo di un titolo al posto del nome quando è disponibile. Se l’opzione è disattivata, il nome viene sempre mostrato come testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルのロゴアートワークがある場合、詳細ページで名前の代わりに使用します。オフの場合、名前は常にテキストで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상세 페이지에서 타이틀 로고 아트워크가 있으면 이름 대신 표시해요. 끄면 이름을 항상 텍스트로 표시해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išsamios informacijos puslapiuose vietoj pavadinimo rodyti jo logotipą, kai toks yra. Kai išjungta, pavadinimas visada rodomas tekstu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informācijas lapās izmantot nosaukuma logotipa attēlu kā nosaukumu, ja tas ir pieejams. Ja izslēgts, nosaukums vienmēr tiek rādīts kā teksts."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan karya seni logo sesuatu tajuk sebagai namanya pada halaman butiran jika tersedia. Apabila dimatikan, nama sentiasa dipaparkan sebagai teks."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk logoen til en tittel som navn på detaljsider når den finnes. Når dette er av, vises navnet alltid som tekst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik het logo van een titel als naam op detailpagina’s wanneer dat beschikbaar is. Als dit uit staat, wordt de naam altijd als tekst getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na stronach szczegółów wyświetla logo tytułu zamiast jego nazwy, gdy jest dostępne. Po wyłączeniu nazwa jest zawsze wyświetlana jako tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa a arte do logotipo de um título como nome nas páginas de detalhes, quando houver. Quando desativado, o nome sempre aparece como texto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o logótipo de um título como nome nas páginas de detalhes, quando existir. Quando desativado, o nome é sempre mostrado como texto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosiți sigla unui titlu drept nume pe paginile de detalii, când este disponibilă. Când opțiunea este dezactivată, numele apare mereu ca text."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать логотип вместо названия на страницах с подробностями, если он есть. Если выключено, название всегда показывается текстом."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je k dispozícii logo titulu, na stránkach s podrobnosťami sa zobrazí namiesto jeho názvu. Keď je táto možnosť vypnutá, názov sa vždy zobrazí ako text."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na straneh s podrobnostmi namesto imena naslova prikaži njegov logotip, če je na voljo. Ko je izklopljeno, je ime vedno prikazano kot besedilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd titelns logotyp som namn på detaljsidor när en sådan finns. När inställningen är av visas namnet alltid som text."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ภาพโลโก้ของเรื่องเป็นชื่อในหน้ารายละเอียดเมื่อมี เมื่อปิดไว้ จะแสดงชื่อเป็นข้อความเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsa, ayrıntı sayfalarında içeriğin adı olarak logo görselini kullanır. Kapalıyken ad her zaman metin olarak gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовувати логотип назви замість тексту на сторінках із подробицями, якщо він є. Якщо вимкнено, назва завжди відображається текстом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng ảnh logo của nội dung làm tên trên trang chi tiết khi có. Khi tắt, tên luôn hiển thị dạng văn bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如有标志图，在详情页上用它代替标题名称。关闭后，名称始终以文字显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若有標誌圖片，在詳細資料頁面上以標誌圖片顯示作品名稱。關閉時，名稱一律以文字顯示。"
          }
        }
      }
    },
