    "tvPairing.consentNote" : {
      "comment" : "Android TV warning on the setup request: allow only if the user started setup on their own device. Apple TV: same warning on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تسمح بذلك إلا إذا بدأت الإعداد على هاتفك أو جهازك اللوحي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешете само ако вие сте започнали настройката от своя телефон или таблет."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet-ho només si has iniciat la configuració des del teu telèfon o la teva tauleta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte to, jen pokud jste nastavení spustili ve svém vlastním telefonu nebo tabletu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad det kun, hvis du har startet konfigurationen på din egen telefon eller tablet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass es nur zu, wenn du die Einrichtung auf deinem eigenen Smartphone oder Tablet gestartet hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε το μόνο αν ξεκινήσατε τη ρύθμιση από το δικό σας τηλέφωνο ή tablet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only allow it if you started setup on your own phone or tablet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permítelo solo si iniciaste la configuración en tu propio teléfono o tableta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
