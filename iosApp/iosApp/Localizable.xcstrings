    "player.subtitleSync.resetFailed" : {
      "comment" : "Apple iOS/tvOS/macOS: error after the Reset Timing request failed. Shown under the selected subtitle's timing actions in the player: the iOS Audio & Subtitles sheet, the macOS player options panel and the tvOS info panel's Subtitles tab.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت إعادة ضبط التوقيت. حاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časování se nepodařilo obnovit. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke nulstille timingen. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Timing konnte nicht zurückgesetzt werden. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reset the timing. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron restablecer los tiempos. Vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoituksen palauttaminen epäonnistui. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de réinitialiser le minutage. Réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće vratiti izvorno vrijeme. Pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile ripristinare i tempi. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイミングをリセットできませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이밍을 초기화하지 못했어요. 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke tilbakestille timingen. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de timing niet herstellen. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zresetować czasu. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível redefinir a sincronia. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сбросить тайминг. Повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att återställa tidsinställningen. Försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanlama sıfırlanamadı. Tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося скинути час. Спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法重置时间。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法重設時間。請再試一次。"
          }
        }
      }
    },
    "player.subtitleSync.resultAlreadyMatches" : {
      "comment" : "Apple iOS/tvOS/macOS: result of the last sync when the timing was already right. Shown under the selected subtitle's timing actions in the player: the iOS Audio & Subtitles sheet, the macOS player options panel and the tvOS info panel's Subtitles tab. Android phone and TV player subtitle timing: same result under the timing actions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التوقيت يطابق الصوت بالفعل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už odpovídá zvuku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer allerede til lyden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt bereits zum Ton."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Already matches the audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya coincide con el audio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastaa jo ääntä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correspond déjà à l’audio."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Već je usklađeno sa zvukom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempi già allineati all’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに音声と一致しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 오디오와 일치해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsvarer allerede med lyden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loopt al gelijk met de audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Już pasują do dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já está sincronizada com o áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже совпадает с аудио."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matchar redan ljudet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaten sesle eşleşiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже збігається з аудіо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已与音频匹配。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已與音訊相符。"
          }
        }
      }
    },
    "player.subtitleSync.resultNoMatch" : {
      "comment" : "Apple iOS/tvOS/macOS: result of the last sync when the subtitle could not be matched. Shown under the selected subtitle's timing actions in the player: the iOS Audio & Subtitles sheet, the macOS player options panel and the tvOS info panel's Subtitles tab. Android phone and TV player subtitle timing: same result under the timing actions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تطابق صوت هذا الفيديو؛ ربما تخص إصدارًا آخر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neodpovídá zvuku tohoto videa; pravděpodobně patří k jinému vydání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer ikke til lyden i denne video; sandsynligvis til en anden udgivelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt nicht zum Ton dieses Videos; vermutlich für eine andere Fassung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doesn't match this video's audio; probably for another release."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No coincide con el audio de este video; probablemente es de otra versión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vastaa tämän videon ääntä; luultavasti toiselle julkaisulle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne correspond pas à l’audio de cette vidéo ; probablement prévu pour une autre version."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne odgovara zvuku ovog videozapisa; vjerojatno je za drugo izdanje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non corrisponde all’audio di questo video; probabilmente è per un’altra versione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビデオの音声と一致しません。別のリリース用の字幕と思われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 동영상의 오디오와 일치하지 않아요. 다른 릴리스용 자막일 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsvarer ikke med lyden i denne videoen; sannsynligvis for en annen utgivelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komt niet overeen met de audio van deze video; waarschijnlijk voor een andere release."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie pasują do dźwięku tego filmu; prawdopodobnie pochodzą z innego wydania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não corresponde ao áudio deste vídeo; provavelmente é de outra versão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не совпадает с аудио этого видео; вероятно, от другого релиза."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matchar inte den här videons ljud; hör förmodligen till en annan utgåva."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu videonun sesiyle eşleşmiyor; büyük olasılıkla başka bir sürüme ait."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не збігається з аудіо цього відео; імовірно, для іншого релізу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与此视频的音频不匹配，可能属于其他版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與此影片的音訊不符，可能屬於其他版本。"
          }
        }
      }
    },
