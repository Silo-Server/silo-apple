    "error.upload_limit_reached" : {
      "comment" : "Error message shown when the server answers with the v2 problem type `upload_limit_reached` (server title: \"Upload limit reached\"). Clients show it instead of the server's English detail in a translated interface, so it must make sense on its own, without the request's specifics.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هناك عمليات رفع كثيرة جارية. حاول مرة أخرى عند انتهاء إحداها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В момента се качват твърде много файлове. Опитайте отново, когато някое качване приключи."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja s’estan penjant massa fitxers. Torna-ho a provar quan n’acabi un."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probíhá příliš mnoho nahrávání. Zkuste to znovu, až některé skončí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange uploads er i gang. Prøv igen, når en af dem er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es laufen zu viele Uploads. Versuche es erneut, wenn einer abgeschlossen ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βρίσκονται σε εξέλιξη πάρα πολλές μεταφορτώσεις. Δοκιμάστε ξανά όταν ολοκληρωθεί μία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many uploads are in progress. Try again when one finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay demasiadas subidas en curso. Vuelve a intentarlo cuando termine una."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liiga palju üleslaadimisi on pooleli. Proovige uuesti, kui mõni neist lõpeb."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian monta lähetystä on käynnissä. Yritä uudelleen, kun jokin niistä valmistuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop d’envois sont en cours. Réessayez quand l’un d’eux sera terminé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יותר מדי העלאות מתבצעות כרגע. אפשר לנסות שוב כשאחת מהן תסתיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत सारे अपलोड चल रहे हैं। किसी एक के पूरा होने पर फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U tijeku je previše prijenosa. Pokušajte ponovno kad neki završi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túl sok feltöltés van folyamatban. Próbálja újra, ha valamelyik befejeződött."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak unggahan yang sedang berlangsung. Coba lagi setelah salah satunya selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppi caricamenti in corso. Riprova quando uno è terminato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
