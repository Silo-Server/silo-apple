    "pairing.error.noResponse" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: error when the TV never answered the first request (its viewer may not have allowed it). {tv}: the TV's name as it advertises itself (for example Living Room).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
