    "player.notice.connectionLostBeforeEnd" : {
      "comment" : "Apple iOS/tvOS/macOS: video player notice text under Connection lost, shown with the Up Next panel.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الاتصال بالخادم قبل انتهاء الحلقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Връзката със сървъра прекъсна преди края на епизода."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ha perdut la connexió amb el servidor abans que acabés l’episodi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojení se serverem se přerušilo před koncem dílu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen til serveren blev afbrudt, før afsnittet var slut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zum Server ist vor dem Ende der Folge abgebrochen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σύνδεση με τον διακομιστή χάθηκε πριν από το τέλος του επεισοδίου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lost connection to the server before the episode finished."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perdió la conexión con el servidor antes de que terminara el episodio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ühendus serveriga katkes enne osa lõppu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteys palvelimeen katkesi ennen jakson loppua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion au serveur a été perdue avant la fin de l’épisode."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
