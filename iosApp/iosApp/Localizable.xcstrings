    "signIn.forgot.unavailableLead" : {
      "comment" : "Apple (iPhone, iPad, Mac) Reset password screen: line shown when the server stopped offering self-service password resets.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوفّر هذا الخادم إعادة تعيين كلمة المرور من شاشة تسجيل الدخول. اطلب من مسؤول الخادم إعادة تعيين كلمة المرور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server bietet auf dem Anmeldebildschirm kein Zurücksetzen des Passworts an. Bitte deinen Server-Admin, dein Passwort zurückzusetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server doesn't offer password resets from the sign-in screen. Ask your server admin to reset your password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no permite restablecer la contraseña desde la pantalla de inicio de sesión. Pide al administrador del servidor que restablezca tu contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur ne propose pas la réinitialisation du mot de passe depuis l’écran de connexion. Demandez à l’administrateur de votre serveur de réinitialiser votre mot de passe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーでは、サインイン画面からパスワードをリセットできません。サーバー管理者にパスワードのリセットを依頼してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor não oferece redefinição de senha na tela de login. Peça ao administrador do servidor para redefinir sua senha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器不支持在登录界面重置密码。请让你的服务器管理员重置你的密码。"
          }
        }
      }
    },
