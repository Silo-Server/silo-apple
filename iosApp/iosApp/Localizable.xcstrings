          }
        }
      }
    },
    "downloads.settings.qualityScopeDownloads" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; last sentences of the quality footer, when monitored series always download in original quality.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا هو الإعداد الافتراضي لكل تنزيل؛ ويمكن تغييره من لوحة «تنزيل». تُنزَّل المسلسلات المراقَبة بالجودة الأصلية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist die Standardeinstellung für jeden Download; im Download-Fenster kannst du sie ändern. Überwachte Serien werden in Originalqualität heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the default for every download; the Download sheet can change it. Monitored series download in original quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el valor predeterminado para cada descarga; puedes cambiarlo en el panel Descargar. Las series supervisadas se descargan en calidad original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’agit de la valeur par défaut pour chaque téléchargement ; la fenêtre Télécharger peut la modifier. Les séries suivies sont téléchargées en qualité originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはすべてのダウンロードのデフォルトで、ダウンロードシートで変更できます。監視中のシリーズはオリジナル画質でダウンロードされます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é o padrão para todos os downloads; o painel de download pode alterá-lo. Séries monitoradas são baixadas na qualidade original."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是所有下载的默认设置，可在下载面板中更改。受监控的剧集以原始质量下载。"
          }
        }
      }
    },
    "downloads.settings.qualityScopeMonitors" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; last sentence of the quality footer, when monitored series can use a preset too.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
