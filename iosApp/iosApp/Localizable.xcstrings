    "player.progress.positionState" : {
      "comment" : "Android phone: screen reader state of the player's seek bar. {position}: the current playback time, already formatted, such as 12:04. {duration}: the video's length, already formatted, such as 1:42:10. Apple iOS/tvOS/macOS: full audiobook player; screen reader value of the progress bar. Apple iOS: screen reader value of the iPhone and iPad player seek bar.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ من %2$@"
          }
        },
