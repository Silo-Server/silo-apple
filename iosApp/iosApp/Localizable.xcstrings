    "errors.apple.downloadRegistry.unexpectedReceipt" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error on the Downloads screen when the server's answer to a download action did not match the request.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل الخادم ردًا غير متوقع بشأن التنزيل. حدّث التنزيلات قبل المحاولة مرة أخرى."
