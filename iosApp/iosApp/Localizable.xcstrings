    "signIn.phoneHintSso" : {
      "comment" : "Hint on the Roku password sign-in screen for accounts that use single sign-on, when no provider name is known. Apple TV: same hint under the password form when the server lists several sign-in providers.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
