    "settingsManifest.player.video_skip_forward_seconds.description" : {
      "comment" : "Help text under the player.video_skip_forward_seconds setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الثواني للتقديم أثناء تشغيل الفيديو. ينطبق على الأزرار واختصارات لوحة المفاتيح والإيماءات وعناصر التحكم في الوسائط المدعومة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekunden, um die bei der Videowiedergabe vorgespult wird. Gilt für Schaltflächen, Tastenkürzel, Gesten und unterstützte Mediensteuerungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seconds to skip forward in video playback. Applies to buttons, keyboard shortcuts, gestures, and supported media controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos que se avanzan en la reproducción de video. Se aplica a botones, atajos de teclado, gestos y controles multimedia compatibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de secondes d’avance rapide lors de la lecture vidéo. S’applique aux boutons, aux raccourcis clavier, aux gestes et aux commandes multimédias prises en charge."
          }
