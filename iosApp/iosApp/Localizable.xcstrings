    "tvPair.approval.anotherAccountMessage" : {
      "comment" : "Apple (iPhone, iPad) Sign in a TV approval card: message of the \"Approve as another account?\" dialog. {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر حساب %1$@ الذي سيسجّل الدخول على التلفزيون. تبقى الحسابات على هذا الجهاز مسجّلة الدخول، ويبقى رمز التلفزيون جاهزًا للموافقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, který účet na serveru %1$@ přihlásí televizi. Účty na tomto zařízení zůstanou přihlášené a kód televize zůstane připravený ke schválení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvilken %1$@-konto der logger tv’et ind. Konti på denne enhed forbliver logget ind, og tv’ets kode er stadig klar til godkendelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, mit welchem %1$@-Konto der Fernseher angemeldet wird. Die Konten auf diesem Gerät bleiben angemeldet, und der Code des Fernsehers kann weiterhin genehmigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which %1$@ account signs in the TV. Accounts on this device stay signed in, and the TV's code stays ready to approve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué cuenta de %1$@ inicia sesión en la TV. Las cuentas de este dispositivo siguen con la sesión iniciada y el código de la TV sigue listo para aprobarse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, millä palvelimen %1$@ tilillä tv kirjataan sisään. Tämän laitteen tilit pysyvät kirjautuneina, ja tv:n koodi odottaa yhä hyväksyntää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le compte %1$@ qui connecte la TV. Les comptes de cet appareil restent connectés, et le code de la TV reste prêt à être approuvé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite kojim će se računom na poslužitelju %1$@ prijaviti TV. Računi na ovom uređaju ostaju prijavljeni, a kôd na TV-u ostaje spreman za odobrenje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli con quale account di %1$@ far accedere la TV. Gli account su questo dispositivo restano connessi e il codice della TV resta pronto per l’approvazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テレビをサインインさせる%1$@のアカウントを選択してください。このデバイスのアカウントはサインインしたままで、テレビのコードも承認できる状態のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 서버에서 TV에 로그인할 계정을 선택하세요. 이 기기의 계정은 로그인 상태로 유지되고, TV의 코드도 계속 승인할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hvilken %1$@-konto som logger på TV-en. Kontoene på denne enheten forblir pålogget, og TV-ens kode er fortsatt klar til godkjenning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies met welk %1$@-account de tv wordt ingelogd. Accounts op dit apparaat blijven ingelogd en de code van de tv blijft klaar om goed te keuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz konto na serwerze %1$@, które zaloguje telewizor. Konta na tym urządzeniu pozostaną zalogowane, a kod telewizora nadal będzie czekać na zatwierdzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha qual conta de %1$@ vai conectar a TV. As contas neste dispositivo continuam conectadas, e o código da TV continua pronto para aprovação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите аккаунт на сервере %1$@, с которым войти на телевизоре. Вход в аккаунты на этом устройстве сохранится, а код на телевизоре останется готовым к подтверждению."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj vilket konto på %1$@ som ska logga in tv:n. Konton på den här enheten förblir inloggade, och tv:ns kod väntar fortfarande på att godkännas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV’de hangi %1$@ hesabıyla oturum açılacağını seçin. Bu cihazdaki hesapların oturumu açık kalır ve TV’nin kodu onaylanmaya hazır bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть обліковий запис %1$@, з яким увійде телевізор. Облікові записи на цьому пристрої залишаться в системі, а код телевізора й далі чекатиме на схвалення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择用哪个%1$@账户登录电视。此设备上的账户会保持登录，电视的代码也会继续等待批准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇要讓電視登入的 %1$@ 帳號。此裝置上的帳號會保持登入，電視上的代碼也仍可供核准。"
          }
        }
      }
    },
    "tvPair.approval.anotherAccountTitle" : {
      "comment" : "Apple (iPhone, iPad) Sign in a TV approval card: title of the dialog opened by \"Not you?\", to approve the TV with a different account.",
