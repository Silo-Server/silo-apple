    "upNext.noNextOnDeck" : {
      "comment" : "Message on the Roku Up Next panel when there is no next episode; the On Deck row below offers other titles to pick from. Apple tvOS: message on the player's Up Next screen above On Deck.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتوفر حلقة تالية. اختر شيئًا من «قيد المشاهدة» بدلًا من ذلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма наличен следващ епизод. Вместо това изберете нещо от „В процес“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hi ha cap episodi següent disponible. Tria alguna cosa de la fila En curs."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Další díl není k dispozici. Vyberte místo toho něco v sekci Rozkoukané."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ikke noget næste afsnit. Vælg noget fra I gang i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist keine nächste Folge verfügbar. Wähle stattdessen etwas aus „Laufend“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει διαθέσιμο επόμενο επεισόδιο. Επιλέξτε κάτι από την ενότητα «Σε εξέλιξη»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No next episode is available. Pick something from On Deck instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún episodio siguiente disponible. Elige algo de En curso."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järgmist osa pole saadaval. Valige selle asemel midagi reast „Pooleli“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraavaa jaksoa ei ole saatavilla. Valitse sen sijaan jotain Kesken-riviltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun épisode suivant n’est disponible. Choisissez plutôt un titre dans En cours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין פרק נוסף זמין. אפשר לבחור במקום זאת משהו מהשורה ”בצפייה”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई अगला एपिसोड उपलब्ध नहीं है। इसके बजाय “जारी” में से कुछ चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sljedeća epizoda nije dostupna. Umjesto toga odaberite nešto iz retka U tijeku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs elérhető következő epizód. Válasszon inkább valamit a Folyamatban sorból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada episode berikutnya. Pilih sesuatu dari Sedang ditonton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun episodio successivo disponibile. Scegli invece qualcosa dalla riga In corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のエピソードはありません。代わりに視聴中から選んでください。"
