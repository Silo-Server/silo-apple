    "downloads.seriesSheet.stopMessage" : {
      "comment" : "Apple iOS/macOS: series Download sheet, opened from a series page; message of the Stop monitoring alert. {device}: the device model name from the system, such as iPhone, iPad or Mac.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الحلقات الموجودة على جهاز %1$@ هذا حتى تحذفها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díly, které už jsou v zařízení %1$@, zůstanou, dokud je nesmažete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afsnit, der allerede er på denne %1$@, bliver, indtil du sletter dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgen, die schon auf diesem %1$@ sind, bleiben, bis du sie löschst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episodes already on this %1$@ stay until you delete them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios que ya están en este %1$@ se quedan hasta que los elimines."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteessa %1$@ jo olevat jaksot säilyvät, kunnes poistat ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes déjà sur votre %1$@ y restent jusqu’à ce que vous les supprimiez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epizode koje su već na uređaju %1$@ ostaju dok ih ne izbrišete."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli episodi già presenti su questo %1$@ restano finché non li elimini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%1$@にあるエピソードは、削除するまで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 %1$@에 이미 있는 에피소드는 삭제하기 전까지 남아 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episoder som allerede er på %1$@, blir værende til du sletter dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afleveringen die al op je %1$@ staan, blijven staan tot je ze verwijdert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odcinki zapisane już na urządzeniu %1$@ pozostaną, dopóki ich nie usuniesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os episódios que já estão neste %1$@ permanecem até que você os exclua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серии, уже скачанные на устройство %1$@, останутся, пока вы их не удалите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsnitt som redan finns på den här enheten (%1$@) ligger kvar tills du raderar dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu %1$@ cihazındaki bölümler, siz silene kadar kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Епізоди, що вже є на цьому %1$@, залишаться, доки ви їх не видалите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在这台%1$@上的集会保留，直到你将其删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在此 %1$@ 上的集數會保留，直到你刪除為止。"
          }
        }
      }
    },
