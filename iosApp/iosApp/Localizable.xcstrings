    "settings.signIn.disconnectFailedGeneric" : {
      "comment" : "Apple Settings > Sign-in (iPhone, iPad, Mac): error when unlinking a provider failed for another reason.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إلغاء ربط مزود تسجيل الدخول. حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung mit dem Anmeldeanbieter konnte nicht getrennt werden. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't disconnect the sign-in provider. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo desconectar el proveedor de inicio de sesión. Vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de déconnecter le fournisseur de connexion. Réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインプロバイダーの連携を解除できませんでした。もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível desconectar o provedor de login. Tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法取消关联登录提供商。请重试。"
          }
        }
      }
    },
    "settings.signIn.disconnectMessage" : {
      "comment" : "Apple Settings > Sign-in (iPhone, iPad, Mac): message of the confirmation before unlinking a sign-in provider, when the server doesn't say whether the account can disconnect it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تتمكن بعد الآن من تسجيل الدخول باستخدام حساب المزود هذا. يبقى حسابك في Silo وملفاته الشخصية. إذا كانت هذه طريقتك الوحيدة لتسجيل الدخول، فسيبقى الربط قائمًا حتى يعيّن مسؤول كلمة مرور لحسابك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst dich dann nicht mehr mit diesem Anbieterkonto anmelden. Dein Silo-Konto und seine Profile bleiben erhalten. Wenn dies deine einzige Anmeldemethode ist, bleibt die Verbindung bestehen, bis ein Administrator ein Passwort für dein Konto festlegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll no longer be able to sign in with this provider account. Your Silo account and its profiles stay. If this is your only way to sign in, it stays connected until an administrator sets a password for your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no podrás iniciar sesión con esta cuenta del proveedor. Tu cuenta de Silo y sus perfiles se conservan. Si es tu única forma de iniciar sesión, seguirá conectada hasta que un administrador configure una contraseña para tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pourrez plus vous connecter avec ce compte du fournisseur. Votre compte Silo et ses profils sont conservés. S’il s’agit de votre seul moyen de connexion, il reste connecté jusqu’à ce qu’un administrateur définisse un mot de passe pour votre compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロバイダーのアカウントでサインインできなくなります。Siloのアカウントとそのプロフィールは残ります。これが唯一のサインイン方法の場合は、管理者がアカウントにパスワードを設定するまで連携は解除されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não vai mais conseguir entrar com esta conta do provedor. Sua conta do Silo e os perfis dela continuam. Se esta for sua única forma de entrar, ela continua conectada até um administrador definir uma senha para sua conta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将无法再使用此提供商账户登录。你的Silo账户及其个人资料会保留。如果这是你唯一的登录方式，在管理员为你的账户设置密码之前，它将保持关联。"
          }
        }
      }
    },
    "settings.signIn.disconnectMessageAllowed" : {
      "comment" : "Apple Settings > Sign-in (iPhone, iPad, Mac): message of the confirmation before unlinking a sign-in provider, when the server says the account can disconnect it.",
      "extractionState" : "manual",
