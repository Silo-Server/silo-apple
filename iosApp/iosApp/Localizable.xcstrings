    "home.emptyBody" : {
      "comment" : "Body under 'Nothing to watch yet' on an empty Home, telling the user how to fill it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف وسائط إلى مكتباتك أو ابدأ المشاهدة لتظهر هنا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете медия в библиотеките си или започнете да гледате, за да се показва тук."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix contingut a les biblioteques o comença a veure alguna cosa i apareixerà aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte média do svých knihoven nebo začněte sledovat a obsah se zobrazí zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj medier til dine biblioteker, eller begynd at se noget, så vises det her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge deinen Mediatheken Medien hinzu oder fang an zu schauen, damit sie hier erscheinen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε πολυμέσα στις βιβλιοθήκες σας ή ξεκινήστε να παρακολουθείτε κάτι για να εμφανιστεί εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add media to your libraries or start watching to see it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade contenido a tus bibliotecas o empieza a ver algo para que aparezca aquí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisage oma meediakogudesse meediat või alustage vaatamist, et seda siin näha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää mediaa kirjastoihisi tai aloita katselu, niin se näkyy täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des médias à vos bibliothèques ou commencez à regarder pour les voir ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להוסיף מדיה לספריות שלך או להתחיל לצפות כדי לראות אותה כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी लाइब्रेरियों में मीडिया जोड़ें या कुछ देखना शुरू करें, फिर वह यहाँ दिखेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte medije u svoje medijateke ili počnite gledati kako bi se ovdje prikazali."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjon hozzá médiát a könyvtáraihoz, vagy kezdjen el nézni valamit, hogy itt megjelenjen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan media ke perpustakaan Anda atau mulai menonton untuk melihatnya di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi contenuti alle tue librerie o inizia a guardare qualcosa per vederlo qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリにメディアを追加するか、視聴を始めるとここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리에 미디어를 추가하거나 시청을 시작하면 여기에 표시돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridėkite medijos į savo bibliotekas arba pradėkite žiūrėti, kad ji būtų rodoma čia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pievienojiet multividi savām bibliotēkām vai sāciet skatīties, lai to redzētu šeit."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah media ke pustaka anda atau mula menonton untuk melihatnya di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til medier i bibliotekene dine eller begynn å se for å få innhold her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg media toe aan je bibliotheken of begin met kijken om ze hier te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj multimedia do bibliotek lub zacznij oglądać, aby zobaczyć je tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione mídia às suas bibliotecas ou comece a assistir para ver tudo aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione conteúdos às suas bibliotecas ou comece a ver algo para que apareça aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adăugați conținut media în biblioteci sau începeți o vizionare pentru a-l vedea aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте медиафайлы в медиатеки или начните просмотр, и они появятся здесь."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridajte médiá do svojich knižníc alebo začnite pozerať a zobrazia sa tu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte vsebine v knjižnice ali začnite gledati, da se prikažejo tukaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till media i dina bibliotek eller börja titta för att se det här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มสื่อลงในคลังหรือเริ่มดูเพื่อให้แสดงที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada görmek için kitaplıklarınıza medya ekleyin veya izlemeye başlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте медіа до своїх бібліотек або почніть перегляд, щоб побачити їх тут."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm nội dung vào thư viện hoặc bắt đầu xem để thấy nội dung ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向你的媒体库添加媒体或开始观看，内容就会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將媒體加入你的媒體庫，或開始觀看，內容就會顯示在這裡。"
          }
        }
      }
    },
