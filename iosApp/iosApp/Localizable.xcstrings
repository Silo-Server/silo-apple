    "library.emptyNamedBody" : {
      "comment" : "Roku and Apple tvOS library screen: supporting line under the named empty-state heading, telling the user media must be added on the server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف وسائط إلى هذه المكتبة على الخادم لتظهر هنا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете медия в тази библиотека на сървъра, за да я видите тук."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix contingut a aquesta biblioteca al servidor per veure’l aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte do této knihovny média na serveru a zobrazí se zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj medier til dette bibliotek på serveren for at se dem her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge auf dem Server Medien zu dieser Mediathek hinzu, damit sie hier erscheinen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε πολυμέσα σε αυτή τη βιβλιοθήκη στον διακομιστή για να εμφανιστούν εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
