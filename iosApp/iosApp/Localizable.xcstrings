        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switches between time remaining and total duration"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterna entre el tiempo restante y la duración total"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahetab järelejäänud aja ja kogukestuse vahel"
