        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See video pole veel režiimiks „Pilt pildis“ valmis. Proovige hetke pärast uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä video ei ole vielä valmis Kuva kuvassa -tilaan. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette vidéo n’est pas encore prête pour le mode Image dans l’image. Réessayez dans un instant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסרטון הזה עדיין לא מוכן לתמונה בתוך תמונה. אפשר לנסות שוב בעוד רגע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह वीडियो अभी पिक्चर इन पिक्चर के लिए तैयार नहीं है। थोड़ी देर में फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj videozapis još nije spreman za način Slika u slici. Pokušajte ponovno za trenutak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a videó még nem áll készen a Kép a képben módra. Próbálja újra egy pillanat múlva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video ini belum siap untuk Gambar dalam Gambar. Coba lagi sebentar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo video non è ancora pronto per Picture in Picture. Riprova tra un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビデオはまだピクチャ・イン・ピクチャの準備ができていません。しばらくしてからもう一度お試しください。"
