    "watchParty.ballot.empty" : {
      "comment" : "Phone: Watch Party voting lobby when no title has been suggested. Apple (iPhone, iPad): same line in the voting lobby when nothing is suggested.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
