    "error.precondition_failed" : {
      "comment" : "Error message shown when the server answers with the v2 problem type `precondition_failed` (server title: \"Precondition failed\"). Clients show it instead of the server's English detail in a translated interface, so it must make sense on its own, without the request's specifics.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر هذا منذ تحميله. أعد التحميل وحاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsah se od načtení změnil. Obnovte ho a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
