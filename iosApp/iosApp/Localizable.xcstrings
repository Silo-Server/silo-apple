    "settingsManifest.ui.next_up_new_releases_first.description" : {
      "comment" : "Help text under the ui.next_up_new_releases_first setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقل المسلسل الذي لحقت بآخر حلقاته إلى بداية متابعة المشاهدة والحلقات التالية عند وصول حلقة أو موسم جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Serie, bei der du auf dem neuesten Stand bist, rückt in Weiterschauen und Nächste Folgen nach vorne, sobald eine neue Folge oder Staffel erscheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move a show you've caught up on to the front of Continue Watching and Next Up when a new episode or season arrives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve una serie que tienes al día al principio de Seguir viendo y Próximos cuando llega un episodio o una temporada nuevos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placer en tête de Reprendre la lecture et de Prochains épisodes une série que vous avez rattrapée lorsqu’un nouvel épisode ou une nouvelle saison arrive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新話まで視聴済みのシリーズに新しいエピソードやシーズンが追加されると、視聴を続けると次のエピソードの先頭に移動します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leva uma série que você já pôs em dia para o início de Continuar assistindo e Próximos episódios quando chega um novo episódio ou uma nova temporada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你已追平的剧集有新的一集或一季推出时，将其移到继续观看和接下来的最前面。"
          }
        }
      }
    },
