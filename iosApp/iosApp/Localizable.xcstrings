        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei elokuvajulkaisuja tai jaksojen esityksiä tällä viikolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune sortie de film ni diffusion d’épisode cette semaine."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj tjedan nema izlazaka filmova ni emitiranja epizoda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna uscita di film o messa in onda di episodi questa settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週は映画の公開やエピソードの放送はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주에 공개되는 영화나 방영되는 에피소드가 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen filmutgivelser eller episodesendinger denne uken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze week geen filmreleases of uitzendingen van afleveringen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak premier filmów i emisji odcinków w tym tygodniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum lançamento de filme ou exibição de episódio nesta semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этой неделе не выходят ни фильмы, ни серии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga filmsläpp eller avsnitt som sänds den här veckan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
