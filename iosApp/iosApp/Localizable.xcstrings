    },
    "watchParty.hero.pickCaption" : {
      "comment" : "Roku: caption under the host's 'pick something' headline in the lobby. Tells the host friends can already join with the code. Apple (iPhone, iPad, Apple TV): same caption in the lobby. Android phone and TV Watch Party lobby: same line under the host's heading.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للأصدقاء الانضمام الآن بالرمز. سيرون اختيارك فور أن تختار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freunde können jetzt mit dem Code beitreten. Sie sehen deine Wahl, sobald du dich entscheidest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Friends can join now with the code. They'll see your pick the moment you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quienes tengan el código ya pueden unirse. Verán tu elección en cuanto la hagas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos amis peuvent rejoindre dès maintenant avec le code. Ils verront votre choix dès que vous l’aurez fait."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友だちはコードを使って今すぐ参加できます。選択するとすぐに、友だちにも表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus amigos já podem entrar com o código. Eles verão sua escolha assim que você decidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友现在就可以用代码加入。你一选好，他们就能看到。"
          }
        }
      }
    },
    "watchParty.hero.voteCaption.guest" : {
      "comment" : "Roku: caption in the voting lobby shown to guests. {host}: the host's display name. Apple (iPhone, iPad, Apple TV): same caption in the voting lobby. Android phone and TV Watch Party lobby: same line under the voting heading for a guest. 1: the host's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على عنوان للتصويت. سيبدأ %1$@ العنوان الفائز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Titel, um abzustimmen. %1$@ startet den Gewinner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a title to vote. %1$@ starts the winner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un título para votar. %1$@ inicia el más votado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un titre pour voter. %1$@ lance le titre gagnant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルを選んで投票してください。%1$@が1位のタイトルを開始します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione um título para votar. %1$@ inicia o vencedor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点作品即可投票。%1$@将开始播放得票最多的作品。"
          }
        }
      }
    },
    "watchParty.hero.voteCaption.manager" : {
      "comment" : "Roku: caption in the voting lobby shown to the host or manager, who starts the title currently leading. Apple (iPhone, iPad, Apple TV): same caption in the voting lobby. Android phone and TV Watch Party lobby: same line under the voting heading for the host.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجميع يصوّت. وأنت تبدأ العنوان المتصدّر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle stimmen ab. Du startest den Titel, der vorne liegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone votes. You start the leader."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el mundo vota. Tú inicias el que va ganando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde vote. Vous lancez le titre en tête."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員が投票します。トップのタイトルを開始してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos votam. Você inicia o mais votado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大家一起投票，由你开始播放领先的作品。"
          }
        }
      }
    },
    "watchParty.hero.voteTitle" : {
      "comment" : "Roku: headline on the lobby hero while members vote on what to watch. Apple (iPhone, iPad, Apple TV): same headline in the voting lobby. Android phone and TV Watch Party lobby: same heading of a voting lobby.",
      "extractionState" : "manual",
