    "requests.error.network" : {
      "comment" : "Error toast on Roku when the server cannot be reached while handling a request. Apple (iPhone, iPad, Mac, Apple TV): error message on any screen that failed to load because the server couldn't be reached.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى الخادم. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server ist nicht erreichbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach the server. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con el servidor. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le serveur. Vérifiez votre connexion et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーに接続できません。接続を確認して、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o servidor. Verifique sua conexão e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接服务器。请检查你的网络连接，然后重试。"
          }
        }
      }
    },
    "requests.error.permission" : {
      "comment" : "Error toast on Roku when the user lacks permission for a request action. Suggests asking the server admin. Apple (iPhone, iPad, Mac, Apple TV): error message under the Not allowed heading on any screen the server refuses (HTTP 403).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس لديك إذن للقيام بذلك. اطلب من مسؤول الخادم منحك الوصول إذا كنت تحتاج إليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafür hast du keine Berechtigung. Frag die Person, die den Server verwaltet, wenn du Zugriff brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have permission to do this. Ask your server admin if you need access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes permiso para hacer esto. Si necesitas acceso, pídeselo a quien administra tu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas l’autorisation d’effectuer cette action. Demandez l’accès à l’administrateur de votre serveur si nécessaire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作を行う権限がありません。アクセスが必要な場合は、サーバー管理者にお問い合わせください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não tem permissão para fazer isso. Peça acesso ao administrador do servidor, se precisar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你没有执行此操作的权限。如需访问权限，请联系你的服务器管理员。"
          }
        }
      }
    },
