    "player.subtitleTools.lostTrack" : {
      "comment" : "Apple iOS/tvOS/macOS: AI subtitle error in the Translate with AI menu and player notice when the app can no longer follow a running job.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقد Silo تتبّع عملية الترجمة هذه. إذا اكتملت، فستظهر الترجمة في قائمة الترجمات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo изгуби връзка с това задание за субтитри. Ако завърши, субтитрите ще се появят в списъка със субтитри."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ha perdut el seguiment d’aquest treball de subtítols. Si acaba, els subtítols apareixeran a la llista de subtítols."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ztratilo přehled o této úloze titulků. Pokud se dokončí, titulky se objeví v seznamu titulků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo mistede overblikket over dette undertekstjob. Hvis det bliver færdigt, vises underteksterne på undertekstlisten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kann diesen Untertitel-Auftrag nicht mehr verfolgen. Wenn er abgeschlossen wird, erscheinen die Untertitel in der Untertitelliste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Silo έχασε την παρακολούθηση αυτής της διεργασίας υποτίτλων. Αν ολοκληρωθεί, οι υπότιτλοι θα εμφανιστούν στη λίστα υποτίτλων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo lost track of this subtitle job. If it finishes, the subtitles will appear in the subtitle list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo perdió el seguimiento de este trabajo de subtítulos. Si termina, los subtítulos aparecerán en la lista de subtítulos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kaotas selle subtiitritöö jälje. Kui töö lõpeb, ilmuvad subtiitrid subtiitrite loendisse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo menetti tämän tekstitystyön seurannan. Jos työ valmistuu, tekstitys tulee näkyviin tekstitysluetteloon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo a perdu le suivi de ce travail de sous-titres. S’il se termine, les sous-titres apparaîtront dans la liste des sous-titres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo איבד את המעקב אחרי עבודת הכתוביות הזו. אם היא תסתיים, הכתוביות יופיעו ברשימת הכתוביות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo अब इस सबटाइटल जॉब को ट्रैक नहीं कर पा रहा। जॉब पूरी होने पर सबटाइटल, सबटाइटल की सूची में दिखेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo više ne može pratiti ovaj posao izrade titlova. Ako se dovrši, titlovi će se pojaviti na popisu titlova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo elvesztette a feliratművelet nyomon követését. Ha a művelet befejeződik, a feliratok megjelennek a feliratlistában."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kehilangan jejak pekerjaan subtitel ini. Jika pekerjaan selesai, subtitel akan muncul di daftar subtitel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ha perso traccia di questo processo dei sottotitoli. Se viene completato, i sottotitoli compariranno nell’elenco dei sottotitoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloはこの字幕ジョブを追跡できなくなりました。ジョブが完了すると、字幕リストに字幕が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo에서 이 자막 작업을 더 이상 추적할 수 없어요. 작업이 완료되면 자막 목록에 자막이 표시돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Silo“ nebegali sekti šio subtitrų darbo. Jei jis bus baigtas, subtitrai atsiras subtitrų sąraše."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo vairs nevar sekot šim subtitru darbam. Ja tas tiks pabeigts, subtitri parādīsies subtitru sarakstā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo tidak lagi dapat menjejak kerja sari kata ini. Jika kerja itu selesai, sari kata akan muncul dalam senarai sari kata."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo mistet oversikten over denne undertekstjobben. Hvis den fullføres, vises undertekstene i undertekstlisten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kan deze ondertiteljob niet meer volgen. Als de job klaar is, verschijnen de ondertitels in de ondertitellijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Silo nie śledzi już tego zlecenia napisów. Jeśli zostanie ukończone, napisy pojawią się na liście napisów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo perdeu o acompanhamento deste trabalho de legendas. Se ele for concluído, as legendas aparecerão na lista de legendas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
