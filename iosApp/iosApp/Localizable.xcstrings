            "value" : "Original bevorzugt die Qualität der Quelle und bereitet eventuell eine kompatible Datei vor, falls dieses Gerät eine benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original prefers source quality and may prepare a compatibility file if this device needs one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original prioriza la calidad de origen y puede preparar un archivo compatible si este dispositivo lo necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’option Original privilégie la qualité de la source et peut préparer un fichier de compatibilité si cet appareil en a besoin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「オリジナル」はソースの画質を優先し、このデバイスで必要な場合は互換ファイルを準備することがあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Original prefere a qualidade da origem e pode preparar um arquivo de compatibilidade se este dispositivo precisar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“原始”优先使用来源质量；如果此设备需要，可能会准备一个兼容文件。"
          }
        }
      }
    },
    "downloads.settings.qualityPresets" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; second sentence of the quality footer, when seasons and series can also be downloaded in a preset and the server reports no resolutions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجهَّز إعدادات معدل البت المسبقة على الخادم عندما يكون الملف الأصلي أكبر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitraten-Voreinstellungen werden auf dem Server vorbereitet, wenn das Original größer ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitrate presets are prepared on the server when the original is larger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes predefinidos de tasa de bits se preparan en el servidor cuando el original es más grande."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les préréglages de débit sont préparés sur le serveur lorsque l’original est plus volumineux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オリジナルの方が大きい場合、ビットレートプリセットがサーバーで準備されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As predefinições de taxa de bits são preparadas no servidor quando o original é maior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当原始文件较大时，服务器会准备码率预设版本。"
          }
        }
      }
    },
    "downloads.settings.qualityPresetsResolution" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; second sentence of the quality footer, when seasons and series can also be downloaded in a preset and presets show a resolution.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجهَّز إعدادات معدل البت المسبقة على الخادم عندما يكون الملف الأصلي أكبر، بدقة تصل إلى الدقة المعروضة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitraten-Voreinstellungen werden auf dem Server vorbereitet, wenn das Original größer ist, und zwar bis zur angezeigten Auflösung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitrate presets are prepared on the server when the original is larger, at up to the resolution shown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes predefinidos de tasa de bits se preparan en el servidor cuando el original es más grande, hasta la resolución indicada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les préréglages de débit sont préparés sur le serveur lorsque l’original est plus volumineux, jusqu’à la résolution indiquée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オリジナルの方が大きい場合、ビットレートプリセットが表示されている解像度までの範囲でサーバーで準備されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As predefinições de taxa de bits são preparadas no servidor quando o original é maior, com até a resolução mostrada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
