    "settingsManifest.player.subtitle_sync_ms.description" : {
      "comment" : "Help text under the player.subtitle_sync_ms setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقديم الترجمة أو تأخيرها لهذا الملف الشخصي. يمكن لكل جهاز الاحتفاظ بإزاحته الخاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel für dieses Profil früher oder später anzeigen. Ein Gerät kann seinen eigenen Versatz behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shift subtitles earlier or later for this profile. A device can keep its own offset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adelanta o retrasa los subtítulos para este perfil. Cada dispositivo puede mantener su propio desfase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décaler les sous-titres plus tôt ou plus tard pour ce profil. Un appareil peut conserver son propre décalage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールの字幕を早めたり遅らせたりします。デバイスごとに独自のオフセットを保持できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adianta ou atrasa as legendas neste perfil. Um dispositivo pode manter seu próprio ajuste."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为此个人资料将字幕提前或延后。设备可以保留自己的偏移量。"
          }
        }
      }
    },
