    "diagnostics.prompt.notRespondingCountSelfHosted" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad, Apple TV), shown after a problem report is captured: message when several reports of one kind are waiting: the app stopped responding this many times. Reports go to the user's own Silo server, run by their server administrator. {count}: how many reports (2 or more in practice).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "توقف Silo عن الاستجابة %1$lld مرات. يمكنك مراجعة التقارير قبل إرسالها إلى مسؤول الخادم لديك."
                }
              },
              "many" : {
