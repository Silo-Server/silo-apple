    "error.sync_reset_required" : {
      "comment" : "Error message shown when the server answers with the v2 problem type `sync_reset_required` (server title: \"Progress reset required\"). Clients show it instead of the server's English detail in a translated interface, so it must make sense on its own, without the request's specifics.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب مزامنة تقدم المشاهدة من جديد. أعد التحميل وحاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Průběh sledování je potřeba znovu synchronizovat. Obnovte obsah a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspilningsstatus skal synkroniseres igen. Genindlæs, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wiedergabefortschritt muss neu synchronisiert werden. Lade neu und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch progress needs to sync again. Reload and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El progreso de visualización debe volver a sincronizarse. Vuelve a cargar e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katselun edistyminen on synkronoitava uudelleen. Päivitä ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La progression de visionnage doit être resynchronisée. Rechargez et réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napredak gledanja treba ponovno sinkronizirati. Ponovno učitajte i pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’avanzamento della visione deve essere sincronizzato di nuovo. Ricarica e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴状況を再同期する必要があります。再読み込みしてもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시청 진행률을 다시 동기화해야 해요. 새로고침한 후 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerfremdriften må synkroniseres på nytt. Last inn på nytt og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kijkvoortgang moet opnieuw worden gesynchroniseerd. Laad opnieuw en probeer het nog eens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postęp oglądania wymaga ponownej synchronizacji. Załaduj ponownie i spróbuj jeszcze raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O progresso de exibição precisa ser sincronizado novamente. Recarregue e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогресс просмотра нужно синхронизировать заново. Обновите и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tittarförloppet behöver synkroniseras igen. Ladda om och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzleme ilerlemesinin yeniden eşitlenmesi gerekiyor. Yeniden yükleyip tekrar deneyin."
