        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu profil için altyazıları daha erken veya daha geç gösterir. Bir cihaz kendi kayma değerini koruyabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зсунути субтитри раніше або пізніше для цього профілю. Пристрій може мати власне зміщення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch phụ đề sớm hơn hoặc muộn hơn cho hồ sơ này. Mỗi thiết bị có thể giữ độ lệch riêng."
          }
