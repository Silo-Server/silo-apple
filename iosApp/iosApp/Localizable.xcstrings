          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the default for every download and monitor; the Download sheet can change it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el valor predeterminado para cada descarga y supervisión; puedes cambiarlo en el panel Descargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’agit de la valeur par défaut pour chaque téléchargement et chaque suivi ; la fenêtre Télécharger peut la modifier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはすべてのダウンロードと監視のデフォルトで、ダウンロードシートで変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é o padrão para todos os downloads e monitoramentos; o painel de download pode alterá-lo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是所有下载和监控的默认设置，可在下载面板中更改。"
          }
        }
      }
    },
    "downloads.settings.qualityScopeOriginalOnly" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; last sentence of the quality footer, when the server downloads seasons and series only in original quality.",
