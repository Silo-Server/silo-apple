    "shell.error.temporaryPassword" : {
      "comment" : "Apple (iPhone, iPad, Mac): error message when the server refuses a request because the account still has a temporary password set by an admin. Android phone and TV: the same error on any screen whose request the server refused for that reason.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عيّن أحد المسؤولين كلمة مرور مؤقتة لهذا الحساب. سجّل الخروج، ثم سجّل الدخول مرة أخرى لاختيار كلمة مرورك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Správce nastavil pro tento účet dočasné heslo. Odhlaste se a znovu se přihlaste. Pak si zvolíte vlastní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En administrator har angivet en midlertidig adgangskode til denne konto. Log ud, og log derefter ind igen for at vælge din egen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Admin hat für dieses Konto ein temporäres Passwort festgelegt. Melde dich ab und dann erneut an, um ein eigenes zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An admin set a temporary password for this account. Sign out, then sign in again to choose your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un administrador estableció una contraseña temporal para esta cuenta. Cierra sesión y vuelve a iniciar sesión para elegir la tuya."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ylläpitäjä asetti tälle tilille väliaikaisen salasanan. Kirjaudu ulos ja kirjaudu sitten uudelleen sisään valitaksesi oman salasanan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mot de passe temporaire a été défini par l’administration pour ce compte. Déconnectez-vous, puis reconnectez-vous pour choisir le vôtre."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrator je postavio privremenu lozinku za ovaj račun. Odjavite se, a zatim se ponovno prijavite da biste odabrali vlastitu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un admin ha impostato una password temporanea per questo account. Esci, poi accedi di nuovo per sceglierne una tua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者がこのアカウントに一時パスワードを設定しました。サインアウトしてから再度サインインし、ご自身のパスワードを設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관리자가 이 계정에 임시 비밀번호를 설정했어요. 로그아웃한 후 다시 로그인해서 직접 비밀번호를 정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En administrator har angitt et midlertidig passord for denne kontoen. Logg ut, og logg deretter på igjen for å velge ditt eget."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een beheerder heeft een tijdelijk wachtwoord voor dit account ingesteld. Log uit en log in om zelf een wachtwoord te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To konto ma hasło tymczasowe ustawione przez administratora. Wyloguj się, a potem zaloguj ponownie, aby wybrać własne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um administrador definiu uma senha temporária para esta conta. Saia e entre novamente para escolher sua própria senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Администратор задал временный пароль для этого аккаунта. Выйдите и войдите снова, чтобы задать свой пароль."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En administratör har angett ett tillfälligt lösenord för det här kontot. Logga ut och logga sedan in igen för att välja ett eget."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yönetici bu hesap için geçici bir parola belirledi. Kendi parolanızı seçmek için oturumu kapatıp yeniden oturum açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адміністратор установив тимчасовий пароль для цього облікового запису. Вийдіть, а потім знову ввійдіть, щоб вибрати власний."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理员为此账户设置了临时密码。请退出登录，然后重新登录以设置你自己的密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理員已為此帳號設定臨時密碼。請先登出，再重新登入以設定你自己的密碼。"
          }
        }
      }
    },
    "shell.error.timeout" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error message when the server timed out (HTTP 408 or 504).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استغرق الخادم وقتًا طويلًا للرد. حاول مرة أخرى بعد قليل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server neodpověděl včas. Zkuste to za chvíli znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren var for længe om at svare. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat zu lange nicht geantwortet. Versuche es gleich noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server took too long to respond. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor tardó demasiado en responder. Vuelve a intentarlo en un momento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin ei vastannut ajoissa. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a mis trop de temps à répondre. Réessayez dans un instant."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj predugo nije odgovarao. Pokušajte ponovno za trenutak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha impiegato troppo tempo a rispondere. Riprova tra un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの応答に時間がかかりすぎました。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 응답 시간이 너무 오래 걸렸어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren brukte for lang tid på å svare. Prøv igjen om litt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server reageerde te traag. Probeer het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer zbyt długo nie odpowiadał. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor demorou demais para responder. Tente novamente em instantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер слишком долго не отвечал. Повторите попытку чуть позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern tog för lång tid att svara. Försök igen om en stund."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunun yanıt vermesi çok uzun sürdü. Biraz sonra tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер надто довго не відповідає. Спробуйте ще раз за мить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器响应时间过长。请稍后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器回應時間過長。請稍後再試一次。"
          }
        }
      }
