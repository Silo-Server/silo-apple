    "settings.spoilers.footer" : {
      "comment" : "Android phone and TV. Phone: note under the two spoiler switches on Settings → Playback, saying where they apply. TV: Settings > Playback > Spoilers: help text under the two spoiler switches. Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: note under the spoiler switches.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينطبق على الحلقات التي لم تبدأ مشاهدتها، على كل جهاز يستخدم هذا الملف الشخصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Folgen, die du noch nicht begonnen hast, auf allen Geräten, die dieses Profil verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to episodes you have not started, on every device that uses this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a los episodios que no has empezado, en todos los dispositivos que usan este perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique aux épisodes que vous n’avez pas commencés, sur chaque appareil qui utilise ce profil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールを使用するすべてのデバイスで、未視聴のエピソードに適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale para episódios que você ainda não começou, em todos os dispositivos que usam este perfil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于你尚未开始观看的集，并作用于使用此个人资料的所有设备。"
          }
        }
      }
    },
