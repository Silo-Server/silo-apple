    "errors.apple.http.authorityChanged" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error shown when the user switched account or profile while a server request was running, so its answer was discarded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
