            "state" : "translated",
            "value" : "Erstat det, der afspilles?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuelle Wiedergabe ersetzen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replace What's Playing?"
          }
        },
        "es" : {
