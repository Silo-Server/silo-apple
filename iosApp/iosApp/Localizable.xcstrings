    "companion.linked.cardNoteSetup" : {
      "comment" : "Roku side card hint during setup; Continue is a button on the phone app. Apple TV: same side card hint on the pairing screen during setup.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
