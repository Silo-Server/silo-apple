    "settings.subtitles.scopeProfile" : {
      "comment" : "Android phone and TV. Phone: footer under the subtitle Appearance switches while subtitle style changes are saved for the profile. TV: Settings > Subtitles: footer saying the appearance settings follow the profile to other devices. Apple Settings > Subtitles (iPhone, iPad, Mac) and Apple TV Settings > Subtitles: same footer.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ لهذا الملف الشخصي على جميع الأجهزة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазено за този профил на всички устройства."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desat per a aquest perfil en tots els dispositius."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloženo pro tento profil na všech zařízeních."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemt for denne profil på alle enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Profil auf allen Geräten gespeichert."
          }
        },
