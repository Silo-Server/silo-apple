    "settingsManifest.ui.library_order.description" : {
      "comment" : "Help text under the ui.library_order setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الترتيب الذي تظهر به مكتباتك."
