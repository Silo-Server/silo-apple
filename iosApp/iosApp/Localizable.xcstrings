          }
        }
      }
    },
    "diagnostics.notice.offLocalRetry" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: notice after the user turned Crash Reports to Never and some reports on the device couldn't be deleted yet. Crash Reports is the setting's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«تقارير الأعطال» معطّلة. تعذّر حذف بعض التقارير المحلية وستُعاد المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Absturzberichte“ ist aus. Einige lokale Berichte konnten nicht gelöscht werden; das Löschen wird erneut versucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crash Reports is off. Some local reports could not be deleted and will retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informes de fallos está desactivado. No se pudieron eliminar algunos informes locales; se volverá a intentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Rapports de plantage » est désactivé. Certains rapports locaux n’ont pas pu être supprimés ; la suppression sera retentée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュレポートはオフです。一部のローカルレポートを削除できなかったため、再試行します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Relatórios de falhas está desativada. Não foi possível excluir alguns relatórios locais; o Silo tentará novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "崩溃报告已关闭。部分本地报告无法删除，将会重试。"
          }
        }
      }
    },
    "diagnostics.notice.offRemoteQueued" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: notice after the user turned Crash Reports to Never while reports already sent couldn't be deleted at the destination yet. Crash Reports is the setting's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«تقارير الأعطال» معطّلة. الحذف البعيد في قائمة الانتظار وستُعاد محاولته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Absturzberichte“ ist aus. Das Löschen am Ziel steht in der Warteschlange und wird erneut versucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crash Reports is off. Remote deletion is queued and will retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informes de fallos está desactivado. La eliminación remota está en cola y se volverá a intentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Rapports de plantage » est désactivé. La suppression à distance est en file d’attente et sera retentée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュレポートはオフです。リモートでの削除はキューに追加され、再試行されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Relatórios de falhas está desativada. A exclusão remota está na fila e será tentada novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "崩溃报告已关闭。远程删除已加入队列，将会重试。"
          }
        }
      }
    },
    "diagnostics.notice.receivedValidating" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: Silo Diagnostics received the report and is still checking it. Silo Diagnostics is a product name. {reference}: the report's reference ID.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استُلم برقم %1$@؛ يتحقق Silo Diagnostics من صحته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als %1$@ empfangen; Silo Diagnostics prüft den Bericht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Received as %1$@; Silo Diagnostics is validating it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibido como %1$@; Silo Diagnostics lo está validando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reçu sous la référence %1$@ ; Silo Diagnostics est en train de le valider."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@として受信しました。Silo Diagnosticsが検証中です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recebido como %1$@; o Silo Diagnostics está validando o relatório."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已接收，参考ID为%1$@，Silo Diagnostics正在验证。"
          }
        }
      }
    },
    "diagnostics.notice.rejected" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: the hosted diagnostics collector refused the report, which stays on the device.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض المُجمِّع التقرير؛ احتُفظ بالنسخة المحلية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sammeldienst hat den Bericht abgelehnt; die lokale Kopie wurde aufbewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collector rejected the report; the local copy was kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El recopilador rechazó el informe; se conservó la copia local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collecteur a refusé le rapport ; la copie locale a été conservée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクターがレポートを拒否しました。ローカルのコピーは保持されています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O coletor recusou o relatório; a cópia local foi mantida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收集器拒绝了此报告，本地副本已保留。"
          }
        }
      }
    },
