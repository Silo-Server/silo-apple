    "setup.cleartext.title" : {
      "comment" : "Roku and Android TV: title of the warning dialog shown when the user connects to a server over plain HTTP, without encryption. Apple (iPhone, iPad, Mac, Apple TV): same alert title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاتصال دون تشفير؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да се свърже ли без шифроване?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols connectar sense xifratge?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojit bez šifrování?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret forbindelse uden kryptering?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Verschlüsselung verbinden?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύνδεση χωρίς κρυπτογράφηση;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect without encryption?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Conectar sin cifrado?"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas ühendada ilma krüpteerimiseta?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistetäänkö ilman salausta?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se connecter sans chiffrement ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להתחבר ללא הצפנה?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना एन्क्रिप्शन के कनेक्ट करें?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezati se bez šifriranja?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakozik titkosítás nélkül?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan tanpa enkripsi?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connettersi senza crittografia?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化せずに接続しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화 없이 연결할까요?"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
