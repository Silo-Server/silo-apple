        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A different genre every week, rated 6.0+ on TMDB with 100+ votes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un género distinto cada semana, con calificación de 6.0+ en TMDB y más de 100 votos."
