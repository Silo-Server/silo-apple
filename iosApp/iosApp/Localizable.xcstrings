          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toestemming gewijzigd; Crashrapporten is teruggezet naar Vragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmieniono warunki zgody; ustawienie Raporty o awariach przywrócono do opcji Pytaj."
