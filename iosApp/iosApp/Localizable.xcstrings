    "watchParty.ended.expired" : {
      "comment" : "Roku: message shown when the party connection expired or the party is gone. Apple (iPhone, iPad, Apple TV): same message on the Watch Party hub.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية الاتصال بـ Watch Party أو لم تعد متاحة. انضم مرة أخرى للمتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zur Watch Party ist abgelaufen oder nicht mehr verfügbar. Tritt erneut bei, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The party connection expired or is no longer available. Join again to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión con la Watch Party caducó o ya no está disponible. Vuelve a unirte para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à la Watch Party a expiré ou n’est plus disponible. Rejoignez-la à nouveau pour continuer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Partyへの接続の有効期限が切れたか、利用できなくなりました。続けるには、もう一度参加してください。"
          }
        },
        "pt-BR" : {
