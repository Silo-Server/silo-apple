    "account.profiles.count" : {
      "comment" : "Android phone: count of profiles on an account card on the Accounts and Change account screens. {count}: the number of profiles.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld ملفات شخصية"
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld ملفًا شخصيًا"
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ملف شخصي واحد"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld ملف شخصي"
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ملفان شخصيان"
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "لا ملفات شخصية"
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Profil"
