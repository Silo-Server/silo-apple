    "player.liveSubtitles.interrupted" : {
      "comment" : "Apple iOS/tvOS/macOS: player notice when the live AI subtitle stream is lost and the job can't be finished.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
