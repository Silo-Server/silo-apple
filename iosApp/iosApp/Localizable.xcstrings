    "error.field.invalid_sort_field" : {
      "comment" : "Error shown next to or about one request field when the server reports the field-error code `invalid_sort_field`. Clients show it instead of the server's English detail in a translated interface. The server also sends this code when a list that sorts by one field at a time is given several.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
