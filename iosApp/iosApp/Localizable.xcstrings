    "settings.subtitles.lowLegibility" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac) and Apple TV Settings > Subtitles: warning under the subtitle preview when the chosen style is hard to read.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضوح منخفض — قد تصعب قراءة النص الشفاف جدًا أو الداكن دون مربع أو حدود."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ниска четливост – много прозрачен или тъмен текст без фон или контур може да се чете трудно."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegibilitat baixa: el text molt transparent o fosc sense quadre ni contorn pot ser difícil de llegir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nízká čitelnost – velmi průhledný nebo tmavý text bez rámečku nebo obrysu může být špatně čitelný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lav læsbarhed – meget gennemsigtig eller mørk tekst uden boks eller kontur kan være svær at læse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlecht lesbar – sehr transparenter oder dunkler Text ohne Kasten oder Kontur kann schwer zu lesen sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χαμηλή αναγνωσιμότητα – πολύ διαφανές ή σκούρο κείμενο χωρίς πλαίσιο ή περίγραμμα μπορεί να διαβάζεται δύσκολα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low legibility — very transparent or dark text without a box or outline can be hard to read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poca legibilidad: el texto muy transparente u oscuro sin recuadro ni contorno puede ser difícil de leer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halb loetavus – väga läbipaistvat või tumedat teksti ilma kasti või kontuurita võib olla raske lugeda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heikko luettavuus – hyvin läpinäkyvää tai tummaa tekstiä ilman laatikkoa tai ääriviivaa voi olla vaikea lukea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisibilité faible — un texte très transparent ou sombre sans cadre ni contour peut être difficile à lire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קריאות נמוכה – טקסט שקוף מאוד או כהה בלי תיבה או קו מתאר עלול להיות קשה לקריאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम पठनीयता — बिना बॉक्स या आउटलाइन के बहुत पारदर्शी या गहरा टेक्स्ट पढ़ना मुश्किल हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaba čitljivost — vrlo proziran ili taman tekst bez okvira ili obruba može biti teško čitljiv."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyenge olvashatóság – a nagyon átlátszó vagy sötét szöveg doboz vagy körvonal nélkül nehezen olvasható."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keterbacaan rendah — teks yang sangat transparan atau gelap tanpa kotak atau garis tepi bisa sulit dibaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggibilità scarsa — un testo molto trasparente o scuro senza riquadro o contorno può essere difficile da leggere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読みにくい設定です。透明度が高い文字や暗い文字は、ボックスや縁取りがないと読みにくくなることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가독성 낮음 — 상자나 윤곽선이 없는 매우 투명하거나 어두운 텍스트는 읽기 어려울 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prastas įskaitomumas – labai skaidrų arba tamsų tekstą be langelio ar kontūro gali būti sunku perskaityti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zema salasāmība – ļoti caurspīdīgu vai tumšu tekstu bez lodziņa vai kontūras var būt grūti izlasīt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebolehbacaan rendah — teks yang sangat lutsinar atau gelap tanpa kotak atau garis luar mungkin sukar dibaca."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dårlig lesbarhet – svært gjennomsiktig eller mørk tekst uten boks eller kontur kan være vanskelig å lese."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slecht leesbaar — zeer transparante of donkere tekst zonder kader of omlijning kan moeilijk te lezen zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słaba czytelność — bardzo przezroczysty lub ciemny tekst bez ramki lub obrysu może być trudny do odczytania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa legibilidade — texto muito transparente ou escuro sem caixa ou contorno pode ser difícil de ler."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouca legibilidade — texto muito transparente ou escuro sem caixa nem contorno pode ser difícil de ler."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lizibilitate redusă — textul foarte transparent sau întunecat, fără casetă sau contur, poate fi greu de citit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плохая читаемость — очень прозрачный или тёмный текст без подложки или контура может быть трудно прочитать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nízka čitateľnosť – veľmi priehľadný alebo tmavý text bez obdĺžnika či obrysu môže byť ťažko čitateľný."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaba berljivost – zelo prosojno ali temno besedilo brez okvirja ali obrobe je lahko težko berljivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låg läsbarhet – mycket genomskinlig eller mörk text utan ruta eller kontur kan vara svår att läsa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านยาก — ข้อความที่โปร่งใสมากหรือสีเข้มโดยไม่มีกล่องหรือเส้นขอบอาจอ่านได้ยาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşük okunabilirlik — kutu veya kontur olmadan çok saydam ya da koyu metin zor okunabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Низька читабельність – дуже прозорий або темний текст без підкладки чи контуру може бути важко читати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khó đọc — chữ quá trong suốt hoặc tối màu mà không có hộp nền hay viền có thể khó đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可读性低——非常透明或深色的文字在没有背景框或描边时可能难以阅读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "易讀性低：非常透明或深色的文字若沒有背景框或外框，可能不易閱讀。"
          }
        }
      }
    },
