    "subtitleSearch.searchingNote" : {
      "comment" : "Note under the progress message in the Roku subtitle search panel, warning that the search may be slow. Apple iOS and tvOS: note under the progress message in the subtitle search sheet or panel.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
