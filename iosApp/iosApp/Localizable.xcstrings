    "watchParty.error.alreadyInParty" : {
      "comment" : "Roku: error shown when joining while already in another party. Apple (iPhone, iPad, Apple TV): same error on the Watch Party hub.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت في Watch Party بالفعل. غادرها للانضمام إلى أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už jste ve Watch Party. Chcete-li se připojit k jiné, opusťte ji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er allerede med i en fest. Forlad den for at deltage i en anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist schon in einer Watch Party. Verlasse sie, um einer anderen beizutreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're already in a party. Leave it to join a different one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya estás en una Watch Party. Sal de ella para unirte a otra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet jo Watch Partyssa. Poistu siitä, jos haluat liittyä toiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes déjà dans une Watch Party. Quittez-la pour en rejoindre une autre."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Već ste u partyju. Napustite ga da biste se pridružili drugome."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei già in un party. Esci per partecipare a un altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでにWatch Partyに参加しています。別のWatch Partyに参加するには、現在のWatch Partyから退出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 Watch Party에 참여 중이에요. 다른 Watch Party에 참여하려면 현재 Watch Party에서 나가세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er allerede i en Watch Party. Forlat den for å bli med i en annen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je zit al in een party. Verlaat die om aan een andere deel te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Już uczestniczysz w Watch Party. Opuść je, aby dołączyć do innego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já está em uma Watch Party. Saia dela para entrar em outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уже в Watch Party. Выйдите из неё, чтобы присоединиться к другой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är redan med i en Watch Party. Lämna den för att gå med i en annan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaten bir partidesiniz. Başka bir partiye katılmak için bundan ayrılın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви вже у Watch Party. Вийдіть із неї, щоб приєднатися до іншої."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已在一个Watch Party中。离开后才能加入其他Watch Party。"
