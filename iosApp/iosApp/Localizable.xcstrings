    "pairing.summary.saveFailed" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: result line when the TV couldn't save the session it got. {server}: the server's name, followed by \" — \" and the account name when there is one (for example Home — sam).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: وافق التلفزيون على تسجيل الدخول لكن تعذّر عليه حفظه. حاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: televize přihlášení schválila, ale nepodařilo se ho uložit. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: tv’et godkendte login, men kunne ikke gemme det. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Der Fernseher hat die Anmeldung genehmigt, konnte sie aber nicht speichern. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: the TV approved the sign-in but couldn't save it. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: la TV aprobó el inicio de sesión, pero no pudo guardarlo. Vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: tv hyväksyi kirjautumisen mutta ei voinut tallentaa sitä. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : la TV a approuvé la connexion mais n’a pas pu l’enregistrer. Réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: TV je odobrio prijavu, ali je nije mogao spremiti. Pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: la TV ha approvato l’accesso ma non è riuscita a salvarlo. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：テレビでサインインは承認されましたが、保存できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: TV에서 로그인을 승인했지만 저장하지 못했어요. 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: TV-en godkjente påloggingen, men kunne ikke lagre den. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: de tv heeft de aanmelding goedgekeurd, maar kan die niet opslaan. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: telewizor zatwierdził logowanie, ale nie mógł go zapisać. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: a TV aprovou o login, mas não conseguiu salvá-lo. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: телевизор одобрил вход, но не смог его сохранить. Повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: tv:n godkände inloggningen men kunde inte spara den. Försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: TV oturum açmayı onayladı ama kaydedemedi. Tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: телевізор схвалив вхід, але не зміг його зберегти. Спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
