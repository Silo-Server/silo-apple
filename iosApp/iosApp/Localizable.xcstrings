    "tvPairing.card.consentNote" : {
      "comment" : "Android TV note on a side card, shown while waiting for the user to Allow; a code to compare with the phone appears after allowing. Apple TV: same note on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد السماح، يظهر هنا رمز لمطابقته مع هاتفك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "След като разрешите, тук ще се появи код, който да сравните с този на телефона ви."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan ho permetis, aquí apareixerà un codi per comparar-lo amb el del telèfon."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po povolení se tu zobrazí kód, který porovnáte s kódem v telefonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har tilladt det, vises en kode her, som du kan sammenligne med din telefon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachdem du es zugelassen hast, erscheint hier ein Code zum Abgleich mit deinem Smartphone."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις το επιτρέψετε, θα εμφανιστεί εδώ ένας κωδικός για σύγκριση με το τηλέφωνό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After you allow it, a code appears here to compare with your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando lo permitas, aparecerá aquí un código para compararlo con el de tu teléfono."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pärast lubamist ilmub siia kood, mida saate oma telefoniga võrrelda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun olet sallinut, tähän tulee koodi, jota voit verrata puhelimesi koodiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois l’autorisation donnée, un code s’affiche ici pour que vous le compariez avec celui de votre téléphone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחרי האישור יופיע כאן קוד להשוואה עם הטלפון שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति देने के बाद, अपने फ़ोन से मिलान के लिए यहाँ एक कोड दिखेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada dopustite, ovdje će se pojaviti kôd koji ćete usporediti s onim na telefonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az engedélyezés után itt megjelenik egy kód, amelyet összevethet a telefonján láthatóval."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah Anda mengizinkannya, kode akan muncul di sini untuk dicocokkan dengan ponsel Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo che l’avrai consentito, qui apparirà un codice da confrontare con il telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可すると、スマートフォンと照合するコードがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용하면 휴대폰과 비교할 코드가 여기에 표시돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai leisite, čia bus parodytas kodas, kurį reikės palyginti su kodu jūsų telefone."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad to atļausiet, šeit parādīsies kods, kas jāsalīdzina ar kodu jūsu tālrunī."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selepas anda membenarkannya, kod akan dipaparkan di sini untuk dibandingkan dengan telefon anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har tillatt det, vises en kode her som du kan sammenligne med telefonen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadat je het toestaat, verschijnt hier een code om met je telefoon te vergelijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po udzieleniu zgody pojawi się tu kod do porównania z kodem na telefonie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois que você permitir, um código aparecerá aqui para comparar com o seu celular."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de permitir, aparece aqui um código para comparar com o seu telemóvel."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După ce permiteți, aici va apărea un cod pe care să-l comparați cu cel de pe telefonul dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы разрешите, здесь появится код — сравните его с кодом на телефоне."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po povolení sa tu zobrazí kód, ktorý porovnáte s telefónom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko dovolite, se tukaj prikaže koda, ki jo primerjate s kodo na telefonu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du har tillåtit det visas en kod här som du kan jämföra med din telefon."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังจากอนุญาต รหัสจะแสดงที่นี่เพื่อให้เทียบกับรหัสบนโทรศัพท์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin verdikten sonra, telefonunuzla karşılaştırmanız için burada bir kod görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли ви дозволите, тут з’явиться код, який треба звірити з телефоном."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi bạn cho phép, một mã sẽ xuất hiện ở đây để so sánh với điện thoại của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许后，这里会显示一个代码，供你与手机上的代码核对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許後，這裡會顯示一組代碼，供你與手機上的代碼比對。"
          }
        }
      }
    },
