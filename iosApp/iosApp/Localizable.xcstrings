    "diagnostics.alwaysSend.promptMessageMany" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad report review; Apple TV): message of the Always Send confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُرسل هذه التقارير وتقارير الأعطال المستقبلية لحساب الخادم هذا تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Berichte und künftige Absturzberichte für dieses Serverkonto werden automatisch gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These reports and future crash reports for this server account will be sent automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos informes y los futuros informes de fallos de esta cuenta del servidor se enviarán automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces rapports et les futurs rapports de plantage de ce compte serveur seront envoyés automatiquement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのレポートと、このサーバーアカウントの今後のクラッシュレポートは自動的に送信されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes relatórios e os futuros relatórios de falhas desta conta do servidor serão enviados automaticamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些报告以及此服务器账户今后的崩溃报告将自动发送。"
          }
        }
      }
    },
