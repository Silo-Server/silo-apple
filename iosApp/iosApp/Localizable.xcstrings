          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ से कनेक्ट नहीं हो सका। इस डिवाइस का कनेक्शन जाँचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće povezati se s poslužiteljem %1$@. Provjerite vezu ovog uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült elérni a(z) %1$@ szervert. Ellenőrizze ennek az eszköznek a kapcsolatát."
          }
        },
        "id" : {
          "stringUnit" : {
