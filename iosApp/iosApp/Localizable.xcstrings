    "settings.connection.skippedCellular" : {
      "comment" : "Footnote in Android connection settings explaining speed tests are not run on mobile data, where the Cellular Quality settings apply instead. Apple Settings > Playback (iPhone, iPad, Mac) (iPhone, iPad): replaces the connection speed on cellular.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُجرى اختبارات السرعة على شبكة الهاتف المحمول، وتُطبَّق إعدادات جودة شبكة الهاتف المحمول."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na mobilních datech se test rychlosti neprovádí a platí nastavení kvality pro mobilní data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hastighedstests springes over på mobilnetværk, og indstillingerne for Mobilkvalitet gælder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über Mobilfunk werden keine Geschwindigkeitstests ausgeführt; es gelten die Einstellungen unter „Mobilfunkqualität“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speed tests are skipped on cellular, and the Cellular Quality settings apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pruebas de velocidad no se hacen con datos móviles, y se aplica la configuración de Calidad con datos móviles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nopeustestejä ei tehdä mobiiliverkossa, vaan käytössä ovat Mobiiliverkon laatu -asetukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tests de vitesse ne sont pas effectués sur réseau mobile, et les paramètres Qualité sur réseau mobile s’appliquent."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na mobilnoj mreži testovi brzine se preskaču i primjenjuju se postavke kvalitete za mobilnu mrežu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulla rete cellulare i test di velocità non vengono eseguiti e si applicano le impostazioni Qualità rete cellulare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モバイルデータ通信では速度テストは行われず、モバイル通信の画質の設定が適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셀룰러에서는 속도 테스트를 건너뛰고 셀룰러 화질 설정이 적용돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hastighetstester hoppes over på mobilnett, og innstillingene for mobilnettkvalitet gjelder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op mobiele netwerken worden geen snelheidstests uitgevoerd; dan gelden de instellingen voor Mobiele kwaliteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W sieci komórkowej testy szybkości są pomijane i obowiązują ustawienia jakości w sieci komórkowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os testes de velocidade não são feitos em dados móveis, e as configurações de Qualidade em dados móveis se aplicam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В мобильной сети проверка скорости не выполняется — действуют настройки «Качество в мобильной сети»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hastighetstester görs inte på mobildata, och inställningarna för mobilkvalitet gäller."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hücresel bağlantıda hız testi yapılmaz ve Hücresel kalite ayarları uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У мобільній мережі тест швидкості не виконується, і діють налаштування «Якість у мобільній мережі»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用蜂窝网络时不进行测速，将应用蜂窝网络画质设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用行動網路時會略過速度測試，並套用「行動網路畫質」設定。"
          }
        }
      }
    },
    "settings.connection.skippedMetered" : {
      "comment" : "Footnote in Android and Android TV connection settings explaining speed tests are not run on metered networks (limited data plans). Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: replaces the connection speed on a metered network.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُجرى اختبارات السرعة على الشبكات محدودة البيانات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
