    "watchParty.hero.pick" : {
      "comment" : "Roku: two-line headline on the lobby hero shown to the host before a title is chosen. The line break is intentional. Apple (iPhone, iPad, Apple TV): same headline in the lobby. Android phone and TV Watch Party lobby: same heading for the host while nothing is staged; the line break is kept.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر شيئًا\nلمشاهدته"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle etwas\nzum Anschauen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick something\nto watch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
