        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queue one to put it up next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon una en cola para que sea la siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez-en une à la file d’attente pour la lire ensuite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューに追加すると次に再生されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque uma na fila para ser a próxima."
