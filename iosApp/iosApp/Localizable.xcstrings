          "stringUnit" : {
            "state" : "translated",
            "value" : "Tv:ns kod hör till %1$@, och den här enheten är inte inloggad där. Logga in och godkänn sedan tv:n."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV’nin kodu %1$@ sunucusuna ait ve bu cihazda bu sunucuya oturum açılmamış. Oturum açın, ardından TV’yi onaylayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код телевізора належить серверу %1$@, але на цьому пристрої ви не ввійшли в нього. Увійдіть, а потім схваліть телевізор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电视的代码属于%1$@，而此设备尚未登录该服务器。请登录，然后批准电视。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電視的代碼屬於 %1$@，但此裝置尚未登入該伺服器。請登入，然後核准電視。"
          }
        }
      }
    },
    "tvPair.link.unreachable" : {
      "comment" : "Apple (iPhone, iPad) Sign in a TV from a link: error when the server named in the link doesn't answer. {host}: the server's host name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى %1$@. تحقق من اتصال هذا الجهاز وافتح الرابط مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se spojit se serverem %1$@. Zkontrolujte připojení tohoto zařízení a otevřete odkaz znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke få kontakt til %1$@. Tjek denne enheds forbindelse, og åbn linket igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist nicht erreichbar. Prüfe die Verbindung dieses Geräts und öffne den Link erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach %1$@. Check this device's connection and open the link again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con %1$@. Revisa la conexión de este dispositivo y vuelve a abrir el enlace."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimeen %1$@ ei saatu yhteyttä. Tarkista tämän laitteen yhteys ja avaa linkki uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre %1$@. Vérifiez la connexion de cet appareil, puis rouvrez le lien."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće povezati se s poslužiteljem %1$@. Provjerite vezu ovog uređaja i ponovno otvorite poveznicu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere %1$@. Controlla la connessione di questo dispositivo e apri di nuovo il link."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に接続できませんでした。このデバイスの接続を確認して、もう一度リンクを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 서버에 연결할 수 없어요. 이 기기의 연결 상태를 확인하고 링크를 다시 여세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke nå %1$@. Sjekk tilkoblingen på denne enheten, og åpne lenken på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan %1$@ niet bereiken. Controleer de verbinding van dit apparaat en open de link opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z serwerem %1$@. Sprawdź połączenie tego urządzenia i otwórz link ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar %1$@. Verifique a conexão deste dispositivo e abra o link novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к серверу %1$@. Проверьте подключение этого устройства и снова откройте ссылку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att nå %1$@. Kontrollera den här enhetens anslutning och öppna länken igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sunucusuna ulaşılamadı. Bu cihazın ağ bağlantısını kontrol edin ve bağlantıyı tekrar açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося з’єднатися із сервером %1$@. Перевірте з’єднання цього пристрою й відкрийте посилання ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接%1$@。请检查此设备的网络连接，然后重新打开链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線至 %1$@。請檢查此裝置的網路連線，然後再次開啟連結。"
          }
        }
      }
    },
