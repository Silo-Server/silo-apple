    "settings.profileSettings.removesAny" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: message of the Use Profile Settings confirmation when no setting is known to be changed on this device.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل هذا أي إعدادات تم تغييرها على هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
