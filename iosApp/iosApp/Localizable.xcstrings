    "downloads.manager.emptyMonitorHintClick" : {
      "comment" : "Apple iOS/macOS: Downloads tab (page on macOS); second empty-state sentence on macOS when the server offers series monitoring.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للحصول على الحلقات الجديدة تلقائيًا، افتح مسلسلًا، وانقر على «تنزيل»، واختر «مراقبة»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да получавате новите епизоди автоматично, отворете сериал, щракнете върху „Изтегляне“ и изберете „Наблюдение“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per obtenir episodis nous automàticament, obre una sèrie, fes clic a Baixa i tria Supervisa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li nové díly dostávat automaticky, otevřete seriál, klikněte na Stáhnout a vyberte Sledovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil have nye afsnit automatisk, skal du åbne en serie, klikke på Download og vælge Overvåg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um neue Folgen automatisch zu erhalten, öffne eine Serie, klicke auf „Download“ und wähle „Beobachten“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να λαμβάνετε αυτόματα νέα επεισόδια, ανοίξτε μια σειρά, κάντε κλικ στη «Λήψη» και επιλέξτε «Παρακολούθηση»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To get new episodes automatically, open a series, click Download, and choose Monitor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para recibir episodios nuevos automáticamente, abre una serie, haz clic en Descargar y elige Supervisar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uute osade automaatseks saamiseks avage sari, klõpsake nuppu „Laadi alla“ ja valige „Jälgi“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat uudet jaksot automaattisesti avaamalla sarjan, klikkaamalla Lataa ja valitsemalla Seuraa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour recevoir automatiquement les nouveaux épisodes, ouvrez une série, cliquez sur Télécharger, puis choisissez Surveiller."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לקבל פרקים חדשים באופן אוטומטי, יש לפתוח סדרה, ללחוץ על ”הורדה” ולבחור ”מעקב”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए एपिसोड अपने-आप पाने के लिए कोई सीरीज़ खोलें, “डाउनलोड” पर क्लिक करें और “मॉनिटर करें” चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da biste automatski dobivali nove epizode, otvorite seriju, kliknite Preuzmi i odaberite Prati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha automatikusan szeretné megkapni az új epizódokat, nyisson meg egy sorozatot, kattintson a Letöltés gombra, és válassza a Figyelés lehetőséget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mendapatkan episode baru secara otomatis, buka serial, klik Unduh, lalu pilih Pantau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ricevere automaticamente i nuovi episodi, apri una serie, fai clic su Scarica e scegli Monitora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいエピソードを自動で取得するには、シリーズを開いて「ダウンロード」をクリックし、「監視」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 에피소드를 자동으로 받으려면 시리즈를 열고 다운로드를 클릭한 다음 모니터링을 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad nauji epizodai būtų gaunami automatiškai, atidarykite serialą, spustelėkite „Atsisiųsti“ ir pasirinkite „Stebėti“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lai automātiski saņemtu jaunas epizodes, atveriet seriālu, noklikšķiniet uz pogas „Lejupielādēt” un atlasiet „Uzraudzīt”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mendapatkan episod baharu secara automatik, buka siri, klik Muat turun dan pilih Pantau."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å få nye episoder automatisk, åpne en serie, klikk på Last ned og velg Overvåk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je nieuwe afleveringen automatisch krijgen? Open een serie, klik op Downloaden en kies Volgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby automatycznie otrzymywać nowe odcinki, otwórz serial, kliknij Pobierz i wybierz Monitoruj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para receber novos episódios automaticamente, abra uma série, clique em Baixar e escolha Monitorar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para receber novos episódios automaticamente, abra uma série, clique em Transferir e escolha Monitorizar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a primi automat episoade noi, deschideți un serial, faceți clic pe „Descărcați” și alegeți „Monitorizați”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы получать новые серии автоматически, откройте сериал, нажмите «Скачать» и выберите «Отслеживать»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete nové epizódy dostávať automaticky, otvorte seriál, kliknite na Stiahnuť a vyberte Sledovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če želite samodejno dobivati nove epizode, odprite serijo, kliknite Prenesi in izberite Spremljaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du vill få nya avsnitt automatiskt öppnar du en serie, klickar på Ladda ned och väljer Bevaka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการรับตอนใหม่โดยอัตโนมัติ ให้เปิดซีรีส์ คลิก “ดาวน์โหลด” แล้วเลือก “ติดตาม”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bölümleri otomatik olarak almak için bir dizi açın, İndir düğmesine tıklayın ve Takip et seçeneğini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб автоматично отримувати нові епізоди, відкрийте серіал, натисніть «Завантажити» й виберіть «Відстежувати»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để tự động nhận tập mới, mở một phim bộ, nhấp vào Tải xuống và chọn Theo dõi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要自动获取新集，请打开剧集，点击“下载”，然后选择“监控”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要自動取得新集數，請開啟影集，按一下「下載」，然後選擇「監控」。"
          }
        }
      }
    },
    "downloads.manager.emptyMonitorHintTap" : {
      "comment" : "Apple iOS/macOS: Downloads tab (page on macOS); second empty-state sentence on iPhone and iPad when the server offers series monitoring.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للحصول على الحلقات الجديدة تلقائيًا، افتح مسلسلًا، واضغط على «تنزيل»، واختر «مراقبة»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да получавате новите епизоди автоматично, отворете сериал, докоснете „Изтегляне“ и изберете „Наблюдение“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per obtenir episodis nous automàticament, obre una sèrie, toca Baixa i tria Supervisa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li nové díly dostávat automaticky, otevřete seriál, klepněte na Stáhnout a vyberte Sledovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil have nye afsnit automatisk, skal du åbne en serie, trykke på Download og vælge Overvåg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um neue Folgen automatisch zu erhalten, öffne eine Serie, tippe auf „Download“ und wähle „Beobachten“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να λαμβάνετε αυτόματα νέα επεισόδια, ανοίξτε μια σειρά, πατήστε «Λήψη» και επιλέξτε «Παρακολούθηση»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To get new episodes automatically, open a series, tap Download, and choose Monitor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para recibir episodios nuevos automáticamente, abre una serie, toca Descargar y elige Supervisar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uute osade automaatseks saamiseks avage sari, puudutage nuppu „Laadi alla“ ja valige „Jälgi“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat uudet jaksot automaattisesti avaamalla sarjan, napauttamalla Lataa ja valitsemalla Seuraa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour recevoir automatiquement les nouveaux épisodes, ouvrez une série, touchez Télécharger, puis choisissez Surveiller."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לקבל פרקים חדשים באופן אוטומטי, יש לפתוח סדרה, להקיש על ”הורדה” ולבחור ”מעקב”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए एपिसोड अपने-आप पाने के लिए कोई सीरीज़ खोलें, “डाउनलोड” पर टैप करें और “मॉनिटर करें” चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da biste automatski dobivali nove epizode, otvorite seriju, dodirnite Preuzmi i odaberite Prati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha automatikusan szeretné megkapni az új epizódokat, nyisson meg egy sorozatot, koppintson a Letöltés gombra, és válassza a Figyelés lehetőséget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mendapatkan episode baru secara otomatis, buka serial, ketuk Unduh, lalu pilih Pantau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ricevere automaticamente i nuovi episodi, apri una serie, tocca Scarica e scegli Monitora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいエピソードを自動で取得するには、シリーズを開いて「ダウンロード」をタップし、「監視」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 에피소드를 자동으로 받으려면 시리즈를 열고 다운로드를 탭한 다음 모니터링을 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad nauji epizodai būtų gaunami automatiškai, atidarykite serialą, palieskite „Atsisiųsti“ ir pasirinkite „Stebėti“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lai automātiski saņemtu jaunas epizodes, atveriet seriālu, pieskarieties pogai „Lejupielādēt” un atlasiet „Uzraudzīt”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mendapatkan episod baharu secara automatik, buka siri, ketik Muat turun dan pilih Pantau."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å få nye episoder automatisk, åpne en serie, trykk på Last ned og velg Overvåk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je nieuwe afleveringen automatisch krijgen? Open een serie, tik op Downloaden en kies Volgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby automatycznie otrzymywać nowe odcinki, otwórz serial, stuknij Pobierz i wybierz Monitoruj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para receber novos episódios automaticamente, abra uma série, toque em Baixar e escolha Monitorar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para receber novos episódios automaticamente, abra uma série, toque em Transferir e escolha Monitorizar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a primi automat episoade noi, deschideți un serial, atingeți „Descărcați” și alegeți „Monitorizați”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы получать новые серии автоматически, откройте сериал, коснитесь «Скачать» и выберите «Отслеживать»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete nové epizódy dostávať automaticky, otvorte seriál, ťuknite na Stiahnuť a vyberte Sledovať."
