    "downloads.seriesSheet.skipUnconvertible" : {
      "comment" : "Apple iOS/macOS: series Download sheet, opened from a series page; note under the options for a season or series download in a preset quality.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُتخطّى الحلقات التي يتعذّر على الخادم تحويلها إلى هذه الجودة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Епизодите, които сървърът не може да конвертира в това качество, се пропускат."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ometen els episodis que el servidor no pot convertir a aquesta qualitat."
