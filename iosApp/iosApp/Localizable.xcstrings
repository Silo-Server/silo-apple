            "value" : "Активният сървър се смени, преди входът да бъде запазен."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor actiu ha canviat abans que es pogués desar l’inici de sessió."
