    "signIn.forgot.sentLead" : {
      "comment" : "Apple (iPhone, iPad, Mac): line under Check your email after a reset link was requested. {login}: the username or email the person typed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا تطابق %1$@ مع حساب له عنوان بريد إلكتروني، فقد أرسلنا إلى ذلك العنوان رابطًا لاختيار كلمة مرور جديدة. بعد اختيارها، سجّل الدخول هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn %1$@ zu einem Konto mit E-Mail-Adresse passt, haben wir an diese Adresse einen Link gesendet, mit dem du ein neues Passwort wählen kannst. Sobald du es gewählt hast, melde dich hier an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If %1$@ matches an account with an email address, we sent that address a link to choose a new password. Once you've chosen it, sign in here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %1$@ coincide con una cuenta que tiene correo electrónico, enviamos a esa dirección un enlace para elegir una contraseña nueva. Cuando la hayas elegido, inicia sesión aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %1$@ correspond à un compte doté d’une adresse e-mail, nous avons envoyé à cette adresse un lien pour choisir un nouveau mot de passe. Une fois celui-ci choisi, connectez-vous ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@がメールアドレスを登録したアカウントと一致する場合、そのアドレスに新しいパスワードを設定するためのリンクを送信しました。設定が済んだら、ここでサインインしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se %1$@ corresponder a uma conta com endereço de e-mail, enviamos a esse endereço um link para escolher uma nova senha. Depois de escolhê-la, entre aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果%1$@与某个设有电子邮件地址的账户匹配，我们已向该地址发送了设置新密码的链接。设置完成后，请在此处登录。"
