          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilen ble byttet før dette kunne lagres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het profiel is gewijzigd voordat dit kon worden opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil zmienił się przed zapisaniem zmiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perfil mudou antes que isso pudesse ser salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль сменился до того, как изменение удалось сохранить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilen ändrades innan detta kunde sparas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişiklik kaydedilemeden profil değişti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профіль змінився, перш ніж вдалося зберегти зміну."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存完成前个人资料已更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存前個人檔案已變更。"
          }
        }
      }
    },
    "settings.profilePrefs.serverRejected" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac, Apple TV): error when the server refused the change. {status}: the HTTP status code, such as 409.",
