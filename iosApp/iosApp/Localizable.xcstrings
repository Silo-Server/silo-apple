    "settingsManifest.ui.title_art.description" : {
      "comment" : "Help text under the ui.title_art setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام شعار العنوان اسمًا له في صفحات التفاصيل عند توفره. عند تعطيل الخيار، يظهر الاسم نصًا دائمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Detailseiten das Logo eines Titels als Namen verwenden, wenn eines verfügbar ist. Bei Aus wird der Name immer als Text angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a title's logo artwork as its name on detail pages when one is available. When off, the name is always shown as text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el logotipo de un título como su nombre en las páginas de detalles cuando esté disponible. Si está desactivado, el nombre siempre se muestra como texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le logo d’un titre comme nom sur les pages de détails lorsqu’il est disponible. Si cette option est désactivée, le nom est toujours affiché en texte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルのロゴアートワークがある場合、詳細ページで名前の代わりに使用します。オフの場合、名前は常にテキストで表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa a arte do logotipo de um título como nome nas páginas de detalhes, quando houver. Quando desativado, o nome sempre aparece como texto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如有标志图，在详情页上用它代替标题名称。关闭后，名称始终以文字显示。"
          }
        }
      }
    },
