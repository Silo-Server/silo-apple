    "downloads.manager.emptyHint" : {
      "comment" : "Apple iOS/macOS: Downloads tab (page on macOS); empty-state text when nothing is downloaded; may be followed by a sentence about monitoring, joined with a space.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا الأفلام والحلقات المنزّلة للمشاهدة دون اتصال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde se zobrazí stažené filmy a díly ke sledování offline."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloadede film og afsnit vises her, så du kan se dem offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heruntergeladene Filme und Folgen erscheinen hier und lassen sich offline ansehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloaded movies and episodes appear here for offline viewing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las películas y los episodios descargados aparecen aquí para verlos sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladatut elokuvat ja jaksot näkyvät täällä offline-katselua varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les films et épisodes téléchargés s’affichent ici pour être regardés hors connexion."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzeti filmovi i epizode prikazuju se ovdje za gledanje izvan mreže."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I film e gli episodi scaricati appaiono qui per la visione offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードした映画やエピソードがここに表示され、オフラインで視聴できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 영화와 에피소드가 여기에 표시되며 오프라인으로 볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedlastede filmer og episoder vises her, slik at du kan se dem uten nett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedownloade films en afleveringen verschijnen hier, zodat je ze offline kunt bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj pojawią się pobrane filmy i odcinki do oglądania offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmes e episódios baixados aparecem aqui para assistir offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появятся скачанные фильмы и серии для просмотра офлайн."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedladdade filmer och avsnitt visas här så att du kan titta offline."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen filmler ve bölümler çevrimdışı izlemek için burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тут з’являтимуться завантажені фільми та епізоди для перегляду офлайн."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已下载的电影和单集会显示在这里，供离线观看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載的電影和集數會顯示在這裡，供你離線觀看。"
          }
