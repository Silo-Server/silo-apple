        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os vídeos reproduzidos a partir do ficheiro original continuam a poder ser reproduzidos em HDR, e a TV continua a poder mudar para HDR para esses vídeos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoclipurile redate din fișierul original se pot reda în continuare în HDR, iar televizorul poate comuta în continuare la HDR pentru ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видео, воспроизводимые из исходного файла, по-прежнему могут идти в HDR, и телевизор по-прежнему может переключаться для них в HDR."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videá prehrávané z pôvodného súboru sa stále môžu prehrávať v HDR a televízor sa pre ne stále môže prepnúť do HDR."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoposnetki, ki se predvajajo iz izvirne datoteke, se lahko še vedno predvajajo v HDR, televizor pa lahko zanje še vedno preklopi v HDR."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videor som spelas upp från originalfilen kan fortfarande spelas upp i HDR, och tv:n kan fortfarande växla till HDR för dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิดีโอที่เล่นจากไฟล์ต้นฉบับยังเล่นแบบ HDR ได้ และทีวียังสลับเป็น HDR สำหรับวิดีโอเหล่านั้นได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinal dosyadan oynatılan videolar yine de HDR olarak oynatılabilir ve TV bu videolar için yine de HDR’ye geçebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відео, що відтворюються з оригінального файлу, усе одно можуть відтворюватися в HDR, і телевізор усе одно може перемикатися для них на HDR."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video phát từ tệp gốc vẫn có thể phát ở dạng HDR và TV vẫn có thể chuyển sang HDR cho các video đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从原始文件播放的视频仍可以HDR播放，电视也仍可为其切换到HDR。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從原始檔案播放的影片仍可以 HDR 播放，電視也仍可為這些影片切換至 HDR。"
          }
        }
      }
    },
