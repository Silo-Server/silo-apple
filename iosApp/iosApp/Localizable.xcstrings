    "settingsManifest.playback.show_marker_confidence.description" : {
      "comment" : "Help text under the playback.show_marker_confidence setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض مدى ثقة المصدر فوق زر «تخطي المقدمة». يقيّم كل مصدر وفق مقياسه الخاص، لذا لا تصلح النسبة المئوية للمقارنة إلا ضمن مصدر واحد؛ فعّل سطر المصدر لمعرفة المصدر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt über der Schaltfläche „Intro überspringen“ an, wie sicher sich die Quelle ist. Jede Quelle bewertet auf ihrer eigenen Skala, daher ist der Prozentwert nur innerhalb einer Quelle vergleichbar; schalte die Zeile zur Quelle ein, um zu sehen, welche es ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show how confident the source is above the Skip Intro button. Each source rates on its own scale, so the percentage is only comparable within one source; turn the source line on to see which one it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra sobre el botón Omitir introducción qué tan segura está la fuente. Cada fuente usa su propia escala, así que el porcentaje solo es comparable dentro de una misma fuente; activa la línea de la fuente para ver cuál es."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche au-dessus du bouton « Passer l’intro » le degré de confiance de la source. Chaque source note selon sa propre échelle : le pourcentage n’est donc comparable qu’au sein d’une même source ; activez la ligne de source pour savoir de laquelle il s’agit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「イントロをスキップ」ボタンの上にソースの信頼度を表示します。ソースごとに独自の基準で評価するため、割合は同じソース内でのみ比較できます。どのソースかを確認するには、ソースの表示をオンにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra acima do botão Pular abertura o grau de confiança da fonte. Cada fonte avalia na própria escala, então a porcentagem só é comparável dentro de uma mesma fonte; ative a linha da fonte para ver qual é."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“跳过片头”按钮上方显示来源的置信度。每个来源使用各自的评分标准，因此百分比只能在同一来源内比较；开启来源显示即可查看是哪个来源。"
          }
        }
      }
    },
    "settingsManifest.playback.show_marker_confidence.label" : {
      "comment" : "Label of the playback.show_marker_confidence setting in settings screens. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض ثقة العلامة"
