    "downloads.manager.emptyHint" : {
      "comment" : "Apple iOS/macOS: Downloads tab (page on macOS); empty-state text when nothing is downloaded; may be followed by a sentence about monitoring, joined with a space.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا الأفلام والحلقات المنزّلة للمشاهدة دون اتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heruntergeladene Filme und Folgen erscheinen hier und lassen sich offline ansehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloaded movies and episodes appear here for offline viewing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las películas y los episodios descargados aparecen aquí para verlos sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les films et épisodes téléchargés s’affichent ici pour être regardés hors connexion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードした映画やエピソードがここに表示され、オフラインで視聴できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmes e episódios baixados aparecem aqui para assistir offline."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已下载的电影和单集会显示在这里，供离线观看。"
          }
        }
      }
    },
    "downloads.manager.emptyMonitorHintClick" : {
      "comment" : "Apple iOS/macOS: Downloads tab (page on macOS); second empty-state sentence on macOS when the server offers series monitoring.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للحصول على الحلقات الجديدة تلقائيًا، افتح مسلسلًا، وانقر على «تنزيل»، واختر «مراقبة»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um neue Folgen automatisch zu erhalten, öffne eine Serie, klicke auf „Download“ und wähle „Beobachten“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To get new episodes automatically, open a series, click Download, and choose Monitor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para recibir episodios nuevos automáticamente, abre una serie, haz clic en Descargar y elige Supervisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour recevoir automatiquement les nouveaux épisodes, ouvrez une série, cliquez sur Télécharger, puis choisissez Surveiller."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいエピソードを自動で取得するには、シリーズを開いて「ダウンロード」をクリックし、「監視」を選択してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para receber novos episódios automaticamente, abra uma série, clique em Baixar e escolha Monitorar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要自动获取新集，请打开剧集，点击“下载”，然后选择“监控”。"
          }
        }
      }
    },
