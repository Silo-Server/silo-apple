    "diagnostics.manual.hostedFooter" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad): footer under Send Diagnostics Now when reports go to Silo Diagnostics, the hosted service.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتضمن التقرير المستضاف تفاصيل قدرات الجهاز وسجلات التشخيص الحديثة بعد تنقيحها. ويستبعد معرّفات الحساب والملف الشخصي وعنوان الخادم وجلسة التشغيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostovaná zpráva obsahuje podrobnosti o schopnostech zařízení a nedávné diagnostické protokoly s odstraněnými citlivými údaji. Neobsahuje identifikátory účtu, profilu, adresy serveru ani relací přehrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hostet rapport indeholder oplysninger om enhedens funktioner og nylige maskerede diagnostiske logs. Den udelader id’er for konto, profil, serveradresse og afspilningssession."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gehosteter Bericht enthält Angaben zu den Gerätefähigkeiten und aktuelle, geschwärzte Diagnoseprotokolle. Konto-, Profil-, Serveradressen- und Wiedergabe-Sitzungskennungen sind nicht enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hosted report includes device capability details and recent redacted diagnostic logs. It omits account, profile, server address, and playback session identifiers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un informe alojado incluye detalles de las capacidades del dispositivo y registros de diagnóstico recientes con los datos sensibles ocultos. Omite los identificadores de cuenta, perfil, dirección del servidor y sesión de reproducción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics -palveluun lähetettävä raportti sisältää laitteen ominaisuustiedot ja viimeaikaiset suodatetut diagnostiikkalokit. Siitä jätetään pois tilin, profiilin, palvelimen osoitteen ja toistoistuntojen tunnisteet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rapport hébergé inclut les capacités de l’appareil et les journaux de diagnostic récents expurgés. Il omet les identifiants de compte, de profil, d’adresse du serveur et de session de lecture."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvješće za hostirani servis sadrži pojedinosti o mogućnostima uređaja i nedavne redigirane dijagnostičke zapisnike. Ne sadrži identifikatore računa, profila, adrese poslužitelja ni sesije reprodukcije."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un report ospitato include i dettagli sulle funzionalità del dispositivo e i log di diagnostica recenti con i dati sensibili oscurati. Omette gli identificatori di account, profilo, indirizzo del server e sessione di riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト型のレポートには、デバイスの機能の詳細と、個人情報を除去した最近の診断ログが含まれます。アカウント、プロフィール、サーバーアドレス、再生セッションの識別子は含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스팅 보고서에는 기기 기능 세부정보와 민감한 정보를 가린 최근 진단 로그가 포함돼요. 계정, 프로필, 서버 주소, 재생 세션 식별자는 제외돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hostet rapport inneholder detaljer om enhetens funksjoner og nylige sladdede diagnostikklogger. Den utelater identifikatorer for konto, profil, serveradresse og avspillingsøkt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gehost rapport bevat gegevens over de mogelijkheden van het apparaat en recente, opgeschoonde diagnostische logs. Identificatiegegevens van account, profiel, serveradres en afspeelsessie worden weggelaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raport wysyłany do usługi hostowanej zawiera informacje o możliwościach urządzenia i najnowsze logi diagnostyczne oczyszczone z danych wrażliwych. Nie zawiera identyfikatorów konta, profilu, adresu serwera ani sesji odtwarzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um relatório hospedado inclui detalhes dos recursos do dispositivo e logs de diagnóstico recentes com dados ocultados. Ele omite identificadores de conta, perfil, endereço do servidor e sessão de reprodução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчёт для Silo Diagnostics содержит сведения о возможностях устройства и недавние обезличенные диагностические логи. В него не входят идентификаторы аккаунта, профиля, адреса сервера и сеансов воспроизведения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rapport till den värdbaserade tjänsten innehåller information om enhetens funktioner och de senaste diagnostikloggarna i maskerad form. Den innehåller inga identifierare för konto, profil, serveradress eller uppspelningssession."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barındırılan rapor, cihaz özelliği ayrıntılarını ve hassas bilgileri ayıklanmış son tanılama günlüklerini içerir. Hesap, profil, sunucu adresi ve oynatma oturumu tanımlayıcılarını içermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звіт для Silo Diagnostics містить відомості про можливості пристрою й останні діагностичні логи з вилученими особистими даними. До нього не входять ідентифікатори облікового запису, профілю, адреси сервера й сеансів відтворення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "托管报告包含设备功能详情和近期经过脱敏的诊断日志，不包含账户、个人资料、服务器地址和播放会话标识符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "託管報告包含裝置功能詳細資料和近期經過遮蔽處理的診斷記錄。報告不含帳號、個人檔案、伺服器位址和播放工作階段識別碼。"
          }
        }
      }
    },
    "diagnostics.manual.selfHostedFooter" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad): footer under Send Diagnostics Now when reports go to the user's own server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتضمن التقرير اليدوي تفاصيل قدرات الجهاز، ومعرّفات جلسات التشغيل الأخيرة، وسجلات التشخيص الحديثة لهذا الخادم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruční zpráva obsahuje podrobnosti o schopnostech zařízení, identifikátory nedávných relací přehrávání a nedávné diagnostické protokoly pro tento server."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En manuel rapport indeholder oplysninger om enhedens funktioner, nylige afspilningssessions-id’er og nylige diagnostiske logs for denne server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein manueller Bericht enthält Angaben zu den Gerätefähigkeiten, aktuelle Wiedergabe-Sitzungskennungen und aktuelle Diagnoseprotokolle für diesen Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A manual report includes device capability details, recent playback session identifiers, and recent diagnostic logs for this server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un informe manual incluye detalles de las capacidades del dispositivo, identificadores de sesiones de reproducción recientes y registros de diagnóstico recientes de este servidor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuaalinen raportti sisältää laitteen ominaisuustiedot, viimeaikaisten toistoistuntojen tunnisteet ja tämän palvelimen viimeaikaiset diagnostiikkalokit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rapport manuel inclut les capacités de l’appareil, les identifiants des sessions de lecture récentes et les journaux de diagnostic récents de ce serveur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ručno izvješće sadrži pojedinosti o mogućnostima uređaja, nedavne identifikatore sesija reprodukcije i nedavne dijagnostičke zapisnike za ovaj poslužitelj."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un report manuale include i dettagli sulle funzionalità del dispositivo, gli identificatori delle sessioni di riproduzione recenti e i log di diagnostica recenti per questo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動レポートには、デバイスの機能の詳細、最近の再生セッションの識別子、このサーバーの最近の診断ログが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수동 보고서에는 기기 기능 세부정보, 최근 재생 세션 식별자, 이 서버의 최근 진단 로그가 포함돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En manuell rapport inneholder detaljer om enhetens funksjoner, nylige identifikatorer for avspillingsøkter og nylige diagnostikklogger for denne serveren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een handmatig rapport bevat gegevens over de mogelijkheden van het apparaat, recente afspeelsessie-ID’s en recente diagnostische logs voor deze server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raport ręczny zawiera informacje o możliwościach urządzenia, identyfikatory ostatnich sesji odtwarzania i najnowsze logi diagnostyczne dla tego serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um relatório manual inclui detalhes dos recursos do dispositivo, identificadores recentes de sessão de reprodução e logs de diagnóstico recentes deste servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчёт, отправленный вручную, содержит сведения о возможностях устройства, идентификаторы недавних сеансов воспроизведения и недавние диагностические логи для этого сервера."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En manuell rapport innehåller information om enhetens funktioner, identifierare för de senaste uppspelningssessionerna och de senaste diagnostikloggarna för den här servern."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuel rapor; cihaz özelliği ayrıntılarını, son oynatma oturumu tanımlayıcılarını ve bu sunucuya ait son tanılama günlüklerini içerir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звіт, надісланий вручну, містить відомості про можливості пристрою, ідентифікатори останніх сеансів відтворення й останні діагностичні логи для цього сервера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动报告包含设备功能详情、近期的播放会话标识符以及此服务器的近期诊断日志。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動報告包含裝置功能詳細資料、近期的播放工作階段識別碼，以及此伺服器近期的診斷記錄。"
          }
        }
      }
    },
    "diagnostics.notice.consentReset" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: the destination's consent notice changed, so the Crash Reports setting went back to Ask. Crash Reports and Ask are the setting's and choice's names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت الموافقة؛ أُعيد ضبط «تقارير الأعطال» إلى «السؤال»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souhlas se změnil; nastavení Zprávy o pádech se vrátilo na možnost Zeptat se."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtykket er ændret; Nedbrudsrapporter blev nulstillet til Spørg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einwilligung geändert; „Absturzberichte“ wurde auf „Fragen“ zurückgesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consent changed; Crash Reports was reset to Ask."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
