    "settingsManifest.player.match_frame_rate.description" : {
      "comment" : "Help text under the player.match_frame_rate setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير معدل تحديث الشاشة ليطابق المحتوى قيد التشغيل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превключва честотата на опресняване на екрана според това, което се възпроизвежда."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia la freqüència d’actualització de la pantalla perquè coincideixi amb el que s’està reproduint."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepnout obnovovací frekvenci displeje podle přehrávaného obsahu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skift skærmens opdateringshastighed, så den passer til det, der afspilles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bildwiederholrate des Displays an den laufenden Inhalt anpassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αλλαγή του ρυθμού ανανέωσης της οθόνης ώστε να ταιριάζει με το περιεχόμενο που αναπαράγεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch the display refresh rate to match what is playing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la frecuencia de actualización de la pantalla para que coincida con lo que se está reproduciendo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muudab ekraani värskendussagedust vastavalt esitatavale sisule."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda näytön virkistystaajuus toistettavan sisällön mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adapter la fréquence de rafraîchissement de l’écran au contenu en cours de lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלפת קצב הרענון של המסך בהתאם לתוכן שמופעל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो चल रहा है, उसके हिसाब से डिस्प्ले का रीफ़्रेश रेट बदलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijenja frekvenciju osvježavanja zaslona prema sadržaju koji se reproducira."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kijelző frissítési gyakoriságának igazítása a lejátszott tartalomhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubah refresh rate layar agar sesuai dengan konten yang diputar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adatta la frequenza di aggiornamento dello schermo a ciò che è in riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生中のコンテンツに合わせてディスプレイのリフレッシュレートを切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 중인 콘텐츠에 맞게 디스플레이 주사율을 전환해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perjungti ekrano atnaujinimo dažnį pagal tai, kas leidžiama."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārslēgt displeja atsvaidzes intensitāti atbilstoši atskaņotajam saturam."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukar kadar segar semula paparan supaya sepadan dengan kandungan yang dimainkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt skjermens oppdateringsfrekvens så den passer til det som spilles av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de verversingssnelheid van het scherm aan op wat er wordt afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełącza częstotliwość odświeżania ekranu, aby pasowała do odtwarzanej treści."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muda a taxa de atualização da tela para corresponder ao que está sendo reproduzido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudar a taxa de atualização do ecrã para corresponder ao que está a ser reproduzido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schimbați rata de reîmprospătare a ecranului pentru a se potrivi cu ce se redă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключать частоту обновления экрана в соответствии с воспроизводимым контентом."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepne obnovovaciu frekvenciu displeja podľa práve prehrávaného obsahu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preklopi hitrost osveževanja zaslona, da se ujema s predvajano vsebino."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt skärmens uppdateringsfrekvens så att den matchar det som spelas upp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนอัตรารีเฟรชของจอแสดงผลให้ตรงกับสิ่งที่กำลังเล่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran yenileme hızını oynatılan içeriğe uyacak şekilde değiştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемикати частоту оновлення екрана відповідно до того, що відтворюється."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển tần số quét của màn hình cho khớp với nội dung đang phát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换显示刷新率以匹配正在播放的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換螢幕更新頻率以配合正在播放的內容。"
          }
        }
      }
    },
