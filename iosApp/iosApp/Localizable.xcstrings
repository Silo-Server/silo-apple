    "settings.signIn.sessionCannotChange" : {
      "comment" : "Apple Settings > Sign-in (iPhone, iPad, Mac): error when the server refuses this session changes to the account's sign-in (for example, an administrator acting for someone).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لهذه الجلسة تغيير طريقة تسجيل الدخول إلى الحساب. سجّل الدخول بحسابك الخاص وحاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази сесия не може да променя начина на влизане в акаунта. Влезте със собствения си акаунт и опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta sessió no pot canviar la manera d’iniciar la sessió en el compte. Inicia la sessió amb el teu propi compte i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato relace nemůže měnit způsob přihlašování k účtu. Přihlaste se vlastním účtem a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne session kan ikke ændre, hvordan kontoen logger ind. Log ind med din egen konto, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Sitzung kann die Anmeldung des Kontos nicht geändert werden. Melde dich mit deinem eigenen Konto an und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η περίοδος σύνδεσης δεν μπορεί να αλλάξει τον τρόπο σύνδεσης του λογαριασμού. Συνδεθείτε με τον δικό σας λογαριασμό και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This session can't change how the account signs in. Sign in with your own account and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión no puede cambiar cómo inicia sesión la cuenta. Inicia sesión con tu propia cuenta y vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See seanss ei saa muuta konto sisselogimisviisi. Logige sisse oma kontoga ja proovige uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä istunto ei voi muuttaa tilin kirjautumistapaa. Kirjaudu sisään omalla tililläsi ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette session ne peut pas modifier la façon dont le compte se connecte. Connectez-vous avec votre propre compte et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסשן הזה לא יכול לשנות את אופן ההתחברות לחשבון. יש להתחבר עם החשבון שלך ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सेशन खाते में साइन इन करने का तरीका नहीं बदल सकता। अपने खुद के खाते से साइन इन करें और फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova sesija ne može promijeniti način prijave na račun. Prijavite se vlastitim računom i pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a munkamenet nem módosíthatja a fiók bejelentkezési módját. Jelentkezzen be a saját fiókjával, és próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi ini tidak dapat mengubah cara akun masuk. Masuk dengan akun Anda sendiri dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa sessione non può modificare il modo in cui l’account accede. Accedi con il tuo account e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションでは、アカウントのサインイン方法を変更できません。ご自身のアカウントでサインインして、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세션에서는 계정의 로그인 방식을 변경할 수 없어요. 본인 계정으로 로그인한 다음 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis seansas negali keisti paskyros prisijungimo būdo. Prisijunkite savo paskyra ir bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī sesija nevar mainīt konta pierakstīšanās veidu. Pierakstieties ar savu kontu un mēģiniet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi ini tidak boleh menukar cara akaun log masuk. Log masuk dengan akaun anda sendiri dan cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne økten kan ikke endre hvordan kontoen logger på. Logg på med din egen konto, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze sessie kan niet wijzigen hoe het account inlogt. Log in met je eigen account en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta sesja nie może zmienić sposobu logowania na konto. Zaloguj się na własne konto i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sessão não pode alterar a forma de entrar da conta. Entre com sua própria conta e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sessão não pode alterar a forma como a conta inicia sessão. Inicie sessão com a sua própria conta e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această sesiune nu poate modifica modul de conectare al contului. Conectați-vă cu propriul cont și încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом сеансе нельзя изменить способ входа в аккаунт. Войдите в свой аккаунт и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tejto relácii sa nedá zmeniť spôsob prihlasovania do účtu. Prihláste sa vlastným účtom a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta seja ne more spremeniti načina prijave v račun. Prijavite se s svojim računom in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här sessionen kan inte ändra hur kontot loggar in. Logga in med ditt eget konto och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซสชันนี้เปลี่ยนวิธีลงชื่อเข้าใช้ของบัญชีไม่ได้ โปรดลงชื่อเข้าใช้ด้วยบัญชีของคุณเองแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oturum, hesabın oturum açma şeklini değiştiremez. Kendi hesabınızla oturum açıp tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цьому сеансі не можна змінити спосіб входу в обліковий запис. Увійдіть у власний обліковий запис і спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên này không thể thay đổi cách đăng nhập của tài khoản. Đăng nhập bằng tài khoản của chính bạn và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此会话无法更改此账户的登录方式。请使用你自己的账户登录，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工作階段無法變更帳號的登入方式。請使用你自己的帳號登入，然後再試一次。"
          }
        }
      }
    },
