    "remote.error.identityChanged" : {
      "comment" : "Apple iOS: Remote Control error when the phone's server or profile changed while handing playback to the TV.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر الخادم أو الملف الشخصي. حاول التشغيل مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Server oder Profil hat sich geändert. Versuche die Wiedergabe erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server or profile changed. Try playing again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor o perfil cambió. Vuelve a intentar reproducir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur ou votre profil a changé. Relancez la lecture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーまたはプロフィールが変更されました。もう一度再生してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor ou perfil mudou. Tente reproduzir novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的服务器或个人资料已更改。请重新播放。"
          }
        }
      }
    },
    "remote.error.pairingRefused" : {
      "comment" : "Apple iOS: Remote Control error when a paired Roku refuses the phone's pairing key. Keep \"Connect a Phone\" as the Roku's menu item is named.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يقبل التلفزيون إقران جهاز iPhone هذا. على التلفزيون، افتح «توصيل هاتف» في Silo وامسح رمزه مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher hat die Kopplung dieses iPhones nicht akzeptiert. Öffne auf dem Fernseher in Silo „Smartphone verbinden“ und scanne den Code erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The TV didn't accept this iPhone's pairing. On the TV, open Connect a Phone in Silo and scan its code again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV no aceptó la vinculación de este iPhone. En la TV, abre Conectar un teléfono en Silo y vuelve a escanear su código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV n’a pas accepté l’association de cet iPhone. Sur la TV, ouvrez Connecter un téléphone dans Silo et scannez de nouveau son code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テレビがこのiPhoneのペアリングを受け付けませんでした。テレビのSiloで「スマートフォンを接続」を開き、コードをもう一度スキャンしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV não aceitou o pareamento deste iPhone. Na TV, abra Conectar um celular no Silo e escaneie o código novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电视未接受此iPhone的配对。请在电视上打开Silo中的“连接手机”，然后重新扫描其代码。"
          }
        }
      }
    },
    "remote.error.profileSlow" : {
      "comment" : "Apple iOS: Remote Control error when the TV did not finish the profile handoff in time.",
      "extractionState" : "manual",
      "localizations" : {
