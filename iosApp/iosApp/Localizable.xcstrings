          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impede que o movimento do celular gire o vídeo. O botão de girar continua funcionando"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impede que o movimento do telemóvel rode o vídeo. O botão de rotação continua a funcionar"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Împiedică rotirea videoclipului la mișcarea telefonului. Butonul de rotire funcționează în continuare"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
