    "settings.subtitles.heldNotice" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac): status under the profile's subtitle options when a change is held; Try Again and Discard Held Change are below.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير محفوظ. حاول مرة أخرى أو تجاهل التغيير أدناه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gespeichert. Versuche es erneut oder verwirf die Änderung unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not saved. Try again or discard the change below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se guardó. Vuelve a intentarlo o descarta el cambio a continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non enregistré. Réessayez ou annulez la modification ci-dessous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されていません。再試行するか、下で変更を破棄してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não salvo. Tente novamente ou descarte a alteração abaixo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未保存。请重试，或在下方放弃此更改。"
          }
        }
      }
    },
    "settings.subtitles.languageFooter" : {
      "comment" : "Android phone and TV. Phone: footer under the Profile group on Settings → Subtitles. TV: Settings > Subtitles > Profile: help text under the language, behavior and forced subtitle rows. Apple Settings > Subtitles (iPhone, iPad, Mac) and Apple TV Settings > Subtitles: same footer.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم لاختيار مسار مطابق عند توفره. تغطي الترجمة الإجبارية الحوار بلغة أجنبية حتى عندما تكون الترجمة معطّلة أو مضبوطة على «تلقائي»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um eine passende Spur auszuwählen, wenn eine verfügbar ist. Erzwungene Untertitel übersetzen fremdsprachige Dialoge, auch wenn Untertitel aus oder auf Auto gestellt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to pick a matching track when one is available. Forced subtitles cover foreign-language dialogue even when subtitles are off or set to auto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para elegir una pista que coincida cuando haya una disponible. Los subtítulos forzados cubren los diálogos en otros idiomas incluso cuando los subtítulos están desactivados o en automático."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à choisir une piste correspondante lorsqu’elle est disponible. Les sous-titres forcés traduisent les dialogues en langue étrangère, même lorsque les sous-titres sont désactivés ou réglés sur Auto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致するトラックがある場合に、そのトラックを選ぶために使用します。強制字幕は、字幕がオフまたは自動の場合でも外国語の会話を表示します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para escolher uma faixa correspondente quando houver uma disponível. As legendas forçadas cobrem diálogos em idioma estrangeiro mesmo quando as legendas estão desativadas ou no modo automático."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有匹配的轨道时将据此选择。即使字幕已关闭或设为自动，强制字幕也会显示外语对白。"
          }
        }
      }
    },
