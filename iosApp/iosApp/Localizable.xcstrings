    "companion.offerSigninBody" : {
      "comment" : "Phone/tablet body text of the offer to sign in a nearby TV that is on its sign-in screen. {device}: the TV name, as claimed by the TV. Apple (iPhone, iPad): same body on the nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقول تلفزيون قريب يُدعى «%1$@» إنه على شاشة تسجيل الدخول. ستتحقق من رمزه قبل الموافقة."
          }
        },
        "de" : {
          "stringUnit" : {
