        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe una cuenta con tu correo electrónico. Inicia sesión con tu contraseña y luego conecta %1$@ en Configuración → Inicio de sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compte avec votre adresse e-mail existe déjà. Connectez-vous avec votre mot de passe, puis reliez %1$@ dans Paramètres → Connexion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じメールアドレスのアカウントがすでに存在します。パスワードでサインインしてから、設定 → サインインで%1$@を接続してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
