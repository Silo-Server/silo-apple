    "errors.apple.playback.authorityChanged" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error in the player when the user switched account or profile during a playback update, so it was not retried.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر الحساب أو الملف الشخصي. لم تتم إعادة محاولة التشغيل."
