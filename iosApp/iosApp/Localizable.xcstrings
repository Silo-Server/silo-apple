    "tvPairing.failedGeneric" : {
      "comment" : "Android TV failure message for an unknown error during pairing. {server}: the server name. Apple TV: same message on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدث خطأ أثناء تسجيل الدخول إلى %1$@. حاول مرة أخرى من هاتفك أو جهازك اللوحي، أو أضف الخادم يدويًا."
          }
        },
        "de" : {
