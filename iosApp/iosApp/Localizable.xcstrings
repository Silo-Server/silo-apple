    "signIn.passwordChange.error.sessionCannotChange" : {
      "comment" : "Apple (iPhone, iPad, Mac) and Android phone Choose a new password screen: error when the server refuses the change for this session.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لهذه الجلسة تغيير كلمة المرور. سجّل الدخول بحسابك الخاص وحاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V této relaci nelze heslo změnit. Použijte k přihlášení vlastní účet a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne session kan ikke ændre adgangskoden. Log ind med din egen konto, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
