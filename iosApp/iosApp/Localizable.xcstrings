        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobil veri veya başka bir ölçülü bağlantıda oynatmanın kullanabileceği veri miktarını sınırlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмежити обсяг даних, які може використовувати відтворення в мобільній мережі або іншому лімітному з’єднанні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giới hạn lượng dữ liệu mà việc phát có thể dùng khi dùng dữ liệu di động hoặc kết nối có đo lưu lượng khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制在移动数据或其他按流量计费的连接上播放时可使用的数据量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
