    "settings.subtitles.scopeDeviceOnly" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac): footer while Only on This Device is on.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ على هذا الجهاز فقط. تستخدم الأجهزة الأخرى إعدادات الملف الشخصي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloženo jen na tomto zařízení. Ostatní zařízení používají nastavení profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun gemt på denne enhed. Andre enheder bruger profilens indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur auf diesem Gerät gespeichert. Andere Geräte verwenden die Einstellungen des Profils."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved only on this device. Other devices use the profile's settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado solo en este dispositivo. Los demás dispositivos usan la configuración del perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennettu vain tähän laitteeseen. Muut laitteet käyttävät profiilin asetuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré sur cet appareil uniquement. Les autres appareils utilisent les paramètres du profil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremljeno samo na ovom uređaju. Ostali uređaji koriste postavke profila."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato solo su questo dispositivo. Gli altri dispositivi usano le impostazioni del profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスにのみ保存されます。ほかのデバイスはプロフィールの設定を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에만 저장돼요. 다른 기기는 프로필 설정을 사용해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagret bare på denne enheten. Andre enheter bruker profilens innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen op dit apparaat opgeslagen. Andere apparaten gebruiken de instellingen van het profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisano tylko na tym urządzeniu. Inne urządzenia używają ustawień profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo somente neste dispositivo. Os outros dispositivos usam as configurações do perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняется только на этом устройстве. Другие устройства используют настройки профиля."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparas endast på den här enheten. Andra enheter använder profilens inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu cihazda kaydedildi. Diğer cihazlar profilin ayarlarını kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережено лише на цьому пристрої. Інші пристрої використовують налаштування профілю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅保存在此设备上。其他设备使用个人资料的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只儲存在此裝置上。其他裝置會使用個人檔案的設定。"
          }
        }
      }
    },
