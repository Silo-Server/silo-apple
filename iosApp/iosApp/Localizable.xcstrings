    "settings.signIn.connectFailedGeneric" : {
      "comment" : "Apple Settings > Sign-in (iPhone, iPad, Mac): error when linking a provider failed for another reason.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر ربط مزود تسجيل الدخول. حاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можа да се осъществи връзка с доставчика на вход. Опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut connectar el proveïdor d’inici de sessió. Torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskytovatele přihlášení se nepodařilo připojit. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke tilknytte loginudbyderen. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anmeldeanbieter konnte nicht verbunden werden. Versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η σύνδεση με τον πάροχο σύνδεσης. Δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't connect the sign-in provider. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar el proveedor de inicio de sesión. Vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisselogimise teenusepakkuja ühendamine ebaõnnestus. Proovige uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjautumispalvelun yhdistäminen epäonnistui. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de connecter le fournisseur de connexion. Réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לחבר את ספק ההתחברות. אפשר לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन-इन प्रोवाइडर को कनेक्ट नहीं किया जा सका। फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće povezati pružatelja prijave. Pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült csatlakoztatni a bejelentkezési szolgáltatót. Próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menghubungkan penyedia masuk. Coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile collegare il provider di accesso. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインプロバイダーを連携できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 제공자에 연결하지 못했어요. 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko prijungti prisijungimo teikėjo. Bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās pievienot pierakstīšanās nodrošinātāju. Mēģiniet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menyambungkan pembekal log masuk. Sila cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke koble til påloggingsleverandøren. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de inlogprovider niet koppelen. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć dostawcy logowania. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível conectar o provedor de login. Tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ligar o fornecedor de início de sessão. Tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a putut conecta furnizorul de conectare. Încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключить провайдер входа. Повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa pripojiť poskytovateľa prihlásenia. Skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni bilo mogoče povezati ponudnika prijave. Poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att ansluta inloggningsleverantören. Försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อผู้ให้บริการลงชื่อเข้าใช้ไม่ได้ โปรดลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum açma sağlayıcısı bağlanamadı. Tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося під’єднати постачальника входу. Спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kết nối nhà cung cấp đăng nhập. Vui lòng thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法关联登录提供商。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連結登入提供者。請再試一次。"
          }
        }
      }
    },
    "settings.signIn.connectFooter.browser" : {
      "comment" : "Apple Settings > Sign-in > Connect (iPhone, iPad, Mac): note under the Silo password when connecting a provider whose sign-in opens in the browser (OIDC). {provider}: the provider's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكّد كلمة مرور Silo، ثم سجّل الدخول باستخدام %1$@. بعد الربط، ستسجّل الدخول باستخدام %1$@ بدلًا من كلمة المرور."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потвърдете паролата си за Silo, след което влезте чрез %1$@. След свързването влизате чрез %1$@ вместо с паролата си."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma la contrasenya de Silo i inicia la sessió amb %1$@. Un cop connectat, iniciaràs la sessió amb %1$@ en lloc de la contrasenya."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potvrďte heslo k Silo a potom se přihlaste přes %1$@. Po připojení se budete místo hesla přihlašovat přes %1$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekræft din Silo-adgangskode, og log derefter ind med %1$@. Efter tilknytningen logger du ind med %1$@ i stedet for din adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige dein Silo-Passwort und melde dich dann mit %1$@ an. Nach dem Verbinden meldest du dich mit %1$@ statt mit deinem Passwort an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιβεβαιώστε τον κωδικό πρόσβασης Silo και, στη συνέχεια, συνδεθείτε μέσω %1$@. Μετά τη σύνδεση, θα συνδέεστε μέσω %1$@ αντί για τον κωδικό πρόσβασής σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm your Silo password, then sign in with %1$@. After connecting, you sign in with %1$@ instead of your password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma tu contraseña de Silo y luego inicia sesión con %1$@. Después de conectarlo, inicias sesión con %1$@ en lugar de tu contraseña."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinnitage oma Silo parool ja logige seejärel sisse teenuse %1$@ kaudu. Pärast ühendamist logite sisse teenuse %1$@ kaudu, mitte parooliga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahvista Silo-salasanasi ja kirjaudu sitten sisään palvelun %1$@ kautta. Yhdistämisen jälkeen kirjaudut sisään palvelun %1$@ kautta salasanan sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmez votre mot de passe Silo, puis connectez-vous avec %1$@. Une fois la liaison effectuée, vous vous connectez avec %1$@ au lieu de votre mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאשר את סיסמת Silo שלך, ואז להתחבר באמצעות %1$@. אחרי החיבור, ההתחברות תתבצע באמצעות %1$@ במקום הסיסמה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने Silo पासवर्ड की पुष्टि करें, फिर %1$@ से साइन इन करें। कनेक्ट करने के बाद, आपको अपने पासवर्ड की जगह %1$@ से साइन इन करना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potvrdite lozinku za Silo, a zatim se prijavite putem usluge %1$@. Nakon povezivanja prijavljujete se putem usluge %1$@ umjesto lozinkom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erősítse meg a Silo-jelszavát, majd jelentkezzen be a(z) %1$@ szolgáltatóval. A csatlakoztatás után jelszó helyett a(z) %1$@ szolgáltatóval jelentkezik be."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfirmasi kata sandi Silo Anda, lalu masuk dengan %1$@. Setelah terhubung, Anda masuk dengan %1$@, bukan dengan kata sandi Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conferma la tua password di Silo, poi accedi con %1$@. Dopo il collegamento, accedi con %1$@ invece che con la password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloのパスワードを確認してから、%1$@でサインインしてください。連携後は、パスワードの代わりに%1$@でサインインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo 비밀번호를 확인한 다음 %1$@(으)로 로그인하세요. 연결하면 비밀번호 대신 %1$@(으)로 로그인해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patvirtinkite „Silo“ slaptažodį, tada prisijunkite per „%1$@“. Po prijungimo prisijungsite per „%1$@“, o ne slaptažodžiu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apstipriniet savu Silo paroli un pēc tam pierakstieties ar %1$@. Pēc pievienošanas jūs pierakstīsieties ar %1$@, nevis ar paroli."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sahkan kata laluan Silo anda, kemudian log masuk dengan %1$@. Selepas disambungkan, anda log masuk dengan %1$@ dan bukan dengan kata laluan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekreft Silo-passordet ditt, og logg deretter på med %1$@. Etter tilkoblingen logger du på med %1$@ i stedet for passordet ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
