    "tvSignIn.error.networkIdentityRequired" : {
      "comment" : "Android TV and phone sign-in error telling the user to open the server through a network provider's address. {provider}: the network provider's name, such as Tailscale. Apple (iPhone, iPad, Mac, Apple TV): same network sign-in error.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح هذا الخادم عبر عنوان %1$@ الخاص به لتسجيل الدخول بهذه الطريقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отворете този сървър на адреса му в %1$@, за да влезете по този начин."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre aquest servidor mitjançant l’adreça que té a %1$@ per iniciar la sessió d’aquesta manera."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li se přihlásit tímto způsobem, otevřete tento server na adrese v síti %1$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn denne server via dens %1$@-adresse for at logge ind på denne måde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne diesen Server über seine %1$@-Adresse, um dich auf diese Weise anzumelden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε αυτόν τον διακομιστή μέσω της διεύθυνσής του στον πάροχο %1$@ για να συνδεθείτε με αυτόν τον τρόπο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open this server at its %1$@ address to sign in this way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre este servidor en su dirección de %1$@ para iniciar sesión de esta forma."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sel viisil sisselogimiseks avage see server teenuse %1$@ aadressil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu näin avaamalla tämä palvelin palvelun %1$@ osoitteessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez ce serveur à son adresse %1$@ pour vous connecter de cette façon."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להתחבר בדרך הזו, יש לפתוח את השרת בכתובת שלו ב-%1$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस तरह साइन इन करने के लिए यह सर्वर उसके %1$@ पते पर खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite ovaj poslužitelj na njegovoj adresi za %1$@ da biste se prijavili na ovaj način."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ilyen bejelentkezéshez nyissa meg ezt a szervert a(z) %1$@ szolgáltatónál használt címén."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka server ini melalui alamat %1$@ untuk masuk dengan cara ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri questo server dal suo indirizzo %1$@ per accedere in questo modo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この方法でサインインするには、%1$@のアドレスでこのサーバーを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 방법으로 로그인하려면 %1$@ 주소로 이 서버를 여세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atidarykite šį serverį jo „%1$@“ adresu, kad galėtumėte prisijungti šiuo būdu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lai pierakstītos šādi, atveriet šo serveri tā %1$@ adresē."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
