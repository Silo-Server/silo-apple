    "watchParty.rejoin.takeOver" : {
      "comment" : "Roku: warning under the rejoin button. Rejoining on this device kicks the same profile off the party on its other device. Apple (iPhone, iPad, Apple TV): same line on the Watch Party hub.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانضمام مجددًا هنا يفصل الجهاز الآخر لهذا الملف الشخصي عن Watch Party."
