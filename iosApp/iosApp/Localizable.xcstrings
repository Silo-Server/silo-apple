    "diagnostics.prompt.crashedCountHosted" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad, Apple TV), shown after a problem report is captured: message when several reports of one kind are waiting: the app crashed this many times. Reports go to Silo Diagnostics, the Silo project's hosted service; Silo Diagnostics is a product name. {count}: how many reports (2 or more in practice).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعطّل Silo %1$lld مرات. يمكنك مراجعة التقارير قبل إرسالها إلى فريق Silo Diagnostics."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعطّل Silo %1$lld مرة. يمكنك مراجعة التقارير قبل إرسالها إلى فريق Silo Diagnostics."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعطّل Silo مرة واحدة. يمكنك مراجعة التقرير قبل إرساله إلى فريق Silo Diagnostics."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعطّل Silo %1$lld مرة. يمكنك مراجعة التقارير قبل إرسالها إلى فريق Silo Diagnostics."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعطّل Silo مرتين. يمكنك مراجعة التقريرين قبل إرسالهما إلى فريق Silo Diagnostics."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعطّل Silo %1$lld مرة. يمكنك مراجعة التقارير قبل إرسالها إلى فريق Silo Diagnostics."
