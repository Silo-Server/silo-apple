    "upNext.lookupFailed" : {
      "comment" : "Error message on the Roku Up Next panel when the next episode could not be loaded; the On Deck row below offers alternatives, or the user can go back. Apple tvOS: message on the player's Up Next screen above On Deck.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل الحلقة التالية. اختر شيئًا من «قيد المشاهدة» أو ارجع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можа да се зареди следващият епизод. Изберете нещо от „В процес“ или се върнете назад."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut carregar l’episodi següent. Tria alguna cosa de la fila En curs o torna enrere."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se načíst další díl. Vyberte něco v sekci Rozkoukané, nebo se vraťte zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke indlæse næste afsnit. Vælg noget fra I gang, eller gå tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nächste Folge konnte nicht geladen werden. Wähle etwas aus „Laufend“ oder gehe zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η φόρτωση του επόμενου επεισοδίου. Επιλέξτε κάτι από την ενότητα «Σε εξέλιξη» ή επιστρέψτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load the next episode. Pick something from On Deck, or go back."
