    "settings.signIn.directoryRefusedGeneric" : {
      "comment" : "Apple Settings > Sign-in > Connect (iPhone, iPad, Mac): error when the directory provider (LDAP) refuses the username and password.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يقبل الدليل اسم المستخدم وكلمة المرور هذين."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Директорията не прие това потребителско име и парола."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El directori no ha acceptat aquest nom d’usuari i aquesta contrasenya."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresář nepřijal toto uživatelské jméno a heslo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katalogtjenesten accepterede ikke det brugernavn og den adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Verzeichnis hat diesen Benutzernamen und dieses Passwort nicht akzeptiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κατάλογος δεν αποδέχτηκε αυτό το όνομα χρήστη και τον κωδικό πρόσβασης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The directory didn't accept that username and password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El directorio no aceptó ese usuario y contraseña."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kataloog ei aktsepteerinud seda kasutajanime ja parooli."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakemisto ei hyväksynyt käyttäjänimeä ja salasanaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’annuaire n’a pas accepté ce nom d’utilisateur et ce mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השירות לא קיבל את שם המשתמש והסיסמה האלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डायरेक्टरी ने वह यूज़रनेम और पासवर्ड स्वीकार नहीं किया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imenik nije prihvatio to korisničko ime i lozinku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A címtár nem fogadta el ezt a felhasználónevet és jelszót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direktori tidak menerima nama pengguna dan kata sandi itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La directory non ha accettato questo nome utente e questa password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディレクトリはこのユーザー名とパスワードを受け付けませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디렉터리에서 사용자 이름과 비밀번호를 허용하지 않았어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katalogas nepriėmė šio naudotojo vardo ir slaptažodžio."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katalogs nepieņēma šo lietotājvārdu un paroli."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direktori tidak menerima nama pengguna dan kata laluan itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katalogen godtok ikke det brukernavnet og passordet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De directory heeft die gebruikersnaam en dat wachtwoord niet geaccepteerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katalog nie zaakceptował tej nazwy użytkownika i hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O diretório não aceitou esse nome de usuário e senha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O diretório não aceitou esse nome de utilizador e palavra-passe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directorul nu a acceptat acest nume de utilizator și această parolă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каталог не принял это имя пользователя и пароль."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresár neprijal toto používateľské meno a heslo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imenik ni sprejel tega uporabniškega imena in gesla."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katalogtjänsten godkände inte det användarnamnet och lösenordet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไดเรกทอรีไม่ยอมรับชื่อผู้ใช้และรหัสผ่านนั้น"
