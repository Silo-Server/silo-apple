    "watchParty.hero.waitingCaption" : {
      "comment" : "Roku: caption under the guests' waiting headline in the lobby. {host}: the host's display name. Apple (iPhone, iPad, Apple TV): same caption in the lobby. Android phone and TV Watch Party lobby: same line under a guest's heading. 1: the host's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يختار %1$@ ما ستشاهدونه. سيظهر هنا فور اختياره."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ избира какво да гледате. Ще го видите тук веднага щом бъде избрано."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ està triant què veureu. Ho veuràs aquí tan bon punt ho triï."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostitel %1$@ vybírá, co se bude sledovat. Uvidíte to tady, jakmile vybere."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vælger, hvad der skal ses. Du ser det her, så snart det sker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wählt aus, was geschaut wird. Du siehst es hier, sobald die Wahl getroffen ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο οικοδεσπότης %1$@ επιλέγει τι θα δείτε. Θα το δείτε εδώ μόλις γίνει η επιλογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is choosing what to watch. You'll see it here the moment they do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está eligiendo qué ver. Lo verás aquí en cuanto elija."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ valib, mida vaadata. Näete seda siin kohe, kui valik on tehtud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ valitsee, mitä katsotaan. Näet valinnan täällä heti, kun se on tehty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ choisit quoi regarder. Vous le verrez ici dès que ce sera fait."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המארח %1$@ בוחר מה לראות. הבחירה תוצג כאן ברגע שהיא תתבצע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या देखना है, यह %1$@ की ओर से चुना जा रहा है। चुनते ही यह आपको यहाँ दिखेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bira što ćete gledati. Vidjet ćete to ovdje čim odabir bude gotov."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ éppen kiválasztja, mit nézzünk. Amint választott, itt azonnal látni fogja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sedang memilih tontonan. Anda akan melihatnya di sini begitu dia memilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sta scegliendo cosa guardare. Lo vedrai qui non appena avrà scelto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が観るものを選んでいます。選ばれるとすぐにここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@님이 볼 작품을 고르고 있어요. 선택하는 즉시 여기에 표시돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ renkasi, ką žiūrėti. Pamatysite tai čia, kai tik bus pasirinkta."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ izvēlas, ko skatīties. Jūs to redzēsiet šeit, tiklīdz izvēle būs izdarīta."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sedang memilih tontonan. Anda akan melihatnya di sini sebaik sahaja dia memilih."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ velger hva dere skal se. Du ser det her så snart det er valgt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kiest wat jullie gaan kijken. Je ziet het hier zodra die keuze er is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wybiera, co obejrzeć. Wybór pojawi się tutaj od razu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está escolhendo o que assistir. Você verá aqui assim que a escolha for feita."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está a escolher o que ver. Vai vê-lo aqui assim que a escolha for feita."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ alege ce vizionați. Veți vedea alegerea aici imediat ce este făcută."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ выбирает, что смотреть. Вы увидите выбор здесь, как только он будет сделан."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vyberá, čo sa bude pozerať. Hneď ako vyberie, uvidíte to tu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostitelj %1$@ izbira, kaj bomo gledali. Izbiro boste tukaj videli takoj, ko bo izbrana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ väljer vad som ska visas. Du ser det här så fort valet är gjort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ กำลังเลือกเรื่องที่จะดู คุณจะเห็นเรื่องนั้นที่นี่ทันทีที่ %1$@ เลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne izleneceğini seçiyor. Seçim yapıldığı anda burada göreceksiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ вибирає, що дивитися. Ви побачите вибір тут, щойно його буде зроблено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đang chọn nội dung để xem. Bạn sẽ thấy nội dung đó tại đây ngay khi chủ phòng chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@正在选择要看的内容。一旦选好，你就会在这里看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 正在選擇要看的內容。一選好，你就會在這裡看到。"
          }
        }
      }
    },
