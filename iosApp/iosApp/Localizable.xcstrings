          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil a changé avant que cette modification puisse être enregistrée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
