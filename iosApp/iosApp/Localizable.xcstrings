    "settings.bufferingQuality.title" : {
      "comment" : "Title of the buffering quality setting in Android playback settings; controls lowering video quality when playback keeps buffering. Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: row and picker title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
