            "value" : "%1$@ startar vinnaren när röstningen är klar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oylama netleşince kazananı %1$@ başlatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ запустить переможця, коли голосування завершиться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投票结束后，%1$@将开始播放得票最多的作品。"
