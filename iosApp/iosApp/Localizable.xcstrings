    "settingsManifest.ui.theme_music_loop.description" : {
      "comment" : "Help text under the ui.theme_music_loop setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكرار موسيقى الشارة ما دامت صفحة التفاصيل مفتوحة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повтаряне на музикалната тема, докато страницата с подробности е отворена."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeteix la música del tema mentre la pàgina de detalls continuï oberta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opakovat znělku, dokud je stránka s podrobnostmi otevřená."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentag temamusikken, så længe detaljesiden er åben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titelmusik wiederholen, solange die Detailseite geöffnet bleibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επανάληψη της μουσικής θέματος όσο η σελίδα λεπτομερειών μένει ανοιχτή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat theme music while the detail page stays open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite la música temática mientras la página de detalles siga abierta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnusmuusikat korratakse, kuni üksikasjade leht on avatud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
