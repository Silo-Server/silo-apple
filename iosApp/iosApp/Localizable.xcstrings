    "settingsManifest.player.video_skip_back_seconds.description" : {
      "comment" : "Help text under the player.video_skip_back_seconds setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الثواني للترجيع أثناء تشغيل الفيديو. ينطبق على الأزرار واختصارات لوحة المفاتيح والإيماءات وعناصر التحكم في الوسائط المدعومة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekunden, um die bei der Videowiedergabe zurückgespult wird. Gilt für Schaltflächen, Tastenkürzel, Gesten und unterstützte Mediensteuerungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seconds to skip back in video playback. Applies to buttons, keyboard shortcuts, gestures, and supported media controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos que se retroceden en la reproducción de video. Se aplica a botones, atajos de teclado, gestos y controles multimedia compatibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de secondes de retour en arrière lors de la lecture vidéo. S’applique aux boutons, aux raccourcis clavier, aux gestes et aux commandes multimédias prises en charge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画再生時に巻き戻す秒数です。ボタン、キーボードショートカット、ジェスチャー、対応するメディアコントロールに適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos para voltar na reprodução de vídeo. Vale para botões, atalhos de teclado, gestos e controles de mídia compatíveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频播放时后退的秒数。适用于按钮、键盘快捷键、手势和受支持的媒体控件。"
          }
        }
      }
    },
