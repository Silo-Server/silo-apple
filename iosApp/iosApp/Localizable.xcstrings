    "settingsManifest.ui.next_up_mode.description" : {
      "comment" : "Help text under the ui.next_up_mode setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تبقى الحلقات القادمة ضمن متابعة المشاهدة أم تظهر في صف خاص بها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дали следващите епизоди остават в „Продължете да гледате“, или получават собствен ред."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si els propers episodis es mostren a Continua veient o en una fila pròpia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zda se nadcházející díly zobrazují v řádku Pokračovat ve sledování, nebo ve vlastním řádku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om kommende afsnit vises under Fortsæt med at se eller får deres egen række."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob anstehende Folgen bei Weiterschauen bleiben oder eine eigene Reihe bekommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν τα επόμενα επεισόδια θα εμφανίζονται μαζί με τη «Συνέχεια παρακολούθησης» ή σε δική τους γραμμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether upcoming episodes stay with Continue Watching or get their own row."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica si los próximos episodios se quedan en Seguir viendo o tienen su propia fila."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas järgmised osad jäävad rea „Jätka vaatamist“ juurde või saavad oma rea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pysyvätkö tulevat jaksot Jatka katsomista -rivillä vai saavatko ne oman rivin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique si les prochains épisodes restent dans Reprendre la lecture ou ont leur propre rangée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם הפרקים הבאים יוצגו יחד עם ”המשך צפייה” או בשורה נפרדת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे के एपिसोड देखना जारी रखें में ही दिखें या उनकी अपनी अलग पंक्ति हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostaju li sljedeće epizode uz Nastavi gledati ili dobivaju vlastiti redak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A következő epizódok a Megtekintés folytatása sorban maradjanak, vagy saját sort kapjanak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah episode mendatang tetap di Lanjutkan menonton atau mendapat baris sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli se i prossimi episodi restano in Continua a guardare o hanno una riga tutta loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のエピソードを視聴を続けるの行に含めるか、専用の行に表示するかを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 에피소드를 이어서 보기에 함께 표시할지, 별도 행으로 표시할지 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar kiti epizodai rodomi kartu su eilute „Tęsti žiūrėjimą“, ar atskiroje eilutėje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai nākamās epizodes paliek rindā „Turpināt skatīties” vai tiek rādītas atsevišķā rindā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sama ada episod akan datang kekal bersama Teruskan menonton atau mendapat baris sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om kommende episoder vises sammen med Fortsett å se eller får sin egen rad."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of volgende afleveringen bij Verder kijken blijven of een eigen rij krijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Określa, czy następne odcinki pojawiają się w rzędzie Kontynuuj oglądanie, czy we własnym rzędzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define se os próximos episódios ficam em Continuar assistindo ou ganham uma fileira própria."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se os próximos episódios ficam em Continuar a ver ou têm a sua própria fila."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți dacă episoadele următoare rămân împreună cu Continuați vizionarea sau au un rând propriu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать следующие серии в ряду «Продолжить просмотр» или в отдельном ряду."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Či nadchádzajúce epizódy zostanú v rade Pokračovať v sledovaní, alebo budú mať vlastný rad."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naslednje epizode ostanejo v vrstici Nadaljuj z ogledom ali dobijo svojo vrstico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om kommande avsnitt ska visas i Fortsätt titta eller få en egen rad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกว่าจะแสดงตอนถัดไปรวมกับแถวดูต่อหรือแยกเป็นแถวของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıradaki bölümlerin “İzlemeye devam et” satırında mı kalacağı yoksa ayrı bir satırda mı gösterileceği."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи залишати наступні епізоди в ряду «Продовжити перегляд», чи показувати їх в окремому ряду."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tập sắp tới nằm chung với Tiếp tục xem hay có hàng riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即将播放的集是与继续观看放在一起，还是单独显示为一行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決定接下來的集數要留在繼續觀看中，還是自成一列。"
          }
        }
      }
    },
