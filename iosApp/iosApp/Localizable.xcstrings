    "downloads.options.qualityFooter" : {
      "comment" : "Apple iOS/macOS: Download Options sheet; footer under the quality choices.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ هذه القيمة من الإعداد الافتراضي العام للتنزيلات. تغييرها هنا يسري على هذا التنزيل فقط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Първоначално се използва общата стойност по подразбиране от „Изтегляния“. Промяната тук важи само за това изтегляне."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parteix de l’opció predeterminada global de Baixades. Si la canvies aquí, només s’aplica a aquesta baixada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výchozí hodnota pochází z globálního nastavení stahování. Změna zde platí jen pro toto stažení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette tager udgangspunkt i din generelle standard for downloads. En ændring her gælder kun denne download."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voreingestellt ist dein allgemeiner Standard aus den Download-Einstellungen. Eine Änderung hier gilt nur für diesen Download."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αρχική τιμή προέρχεται από τη γενική προεπιλογή των Λήψεων. Η αλλαγή εδώ ισχύει μόνο για αυτή τη λήψη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts from your global Downloads default. Changing it here applies only to this download."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte de tu configuración predeterminada global de descargas. Si la cambias aquí, solo se aplica a esta descarga."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähtutakse teie üldisest allalaadimiste vaikeseadistusest. Siin tehtud muudatus kehtib ainult sellele allalaadimisele."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähtökohtana on latausten yleinen oletusasetuksesi. Tässä tehty muutos koskee vain tätä latausta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette valeur reprend votre paramètre par défaut des téléchargements. La modifier ici ne s’applique qu’à ce téléchargement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערך ברירת המחדל נלקח מהגדרת ההורדות הכללית שלך. שינוי כאן חל רק על ההורדה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह डाउनलोड की आपकी ग्लोबल डिफ़ॉल्ट सेटिंग से शुरू होता है। इसे यहाँ बदलने पर बदलाव सिर्फ़ इस डाउनलोड पर लागू होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polazi od vaše globalne zadane postavke za preuzimanja. Promjena ovdje vrijedi samo za ovo preuzimanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiinduló értéke a letöltések globális alapértelmezett beállítása. Az itt végzett módosítás csak erre a letöltésre vonatkozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nilai awal ini berasal dari default Unduhan global Anda. Perubahan di sini hanya berlaku untuk unduhan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte dall’impostazione predefinita globale dei download. Se la modifichi qui, vale solo per questo download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全体のダウンロード設定のデフォルトが初期値になります。ここで変更した内容は、このダウンロードにのみ適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 다운로드 기본 설정에서 시작해요. 여기서 변경하면 이 다운로드에만 적용돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iš pradžių naudojamas jūsų bendras numatytasis atsisiuntimų nustatymas. Pakeitimas čia taikomas tik šiam atsisiuntimui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sākotnēji tiek izmantota jūsu vispārējā lejupielāžu noklusējuma vērtība. Ja to maināt šeit, izmaiņas attiecas tikai uz šo lejupielādi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihan ini bermula daripada lalai Muat turun global anda. Perubahan di sini hanya digunakan untuk muat turun ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette tar utgangspunkt i standardvalget ditt for nedlastinger. Endringer her gjelder bare denne nedlastingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit begint bij je algemene standaard voor downloads. Een wijziging hier geldt alleen voor deze download."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Początkowo używane jest globalne ustawienie domyślne pobierania. Zmiana tutaj dotyczy tylko tego pobierania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
