    "player.seekInterval.refreshFailed" : {
      "comment" : "Apple iOS/tvOS/macOS: skip interval settings (video and audiobook skip back/forward); error when a refresh failed and saved values show.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحديث فواصل التخطي. تُعرض آخر القيم المحفوظة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можаха да се обновят интервалите на прескачане. Показват се последните запазени стойности."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’han pogut actualitzar els intervals de salt. Es mostren els últims valors desats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervaly přeskočení se nepodařilo obnovit. Zobrazují se naposledy uložené hodnoty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke opdatere springintervaller. Viser de senest gemte værdier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprungintervalle konnten nicht aktualisiert werden. Die zuletzt gespeicherten Werte werden angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανανέωση των διαστημάτων μετάβασης. Εμφανίζονται οι τελευταίες αποθηκευμένες τιμές."
          }
