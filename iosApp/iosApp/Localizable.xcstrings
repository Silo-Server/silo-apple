    "player.error.audioTrackSetupFailed" : {
      "comment" : "Apple iOS/tvOS/macOS: video player error screen when the video could not start with the audio track the viewer picked.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
