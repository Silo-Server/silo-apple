        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese enlace indica un servidor que este dispositivo no puede confirmar. Introduce el código de la TV en Configuración > Iniciar sesión en una TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien désigne un serveur que cet appareil ne peut pas confirmer. Saisissez plutôt le code de la TV dans Paramètres > Connecter une TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのリンクが示すサーバーをこのデバイスで確認できません。代わりに「設定」>「テレビをサインイン」でテレビのコードを入力してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse link indica um servidor que este dispositivo não consegue confirmar. Em vez disso, insira o código da TV em Configurações > Conectar uma TV."
