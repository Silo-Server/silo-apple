    "settingsManifest.catalog.hide_unwatched_episode_overviews.description" : {
      "comment" : "Help text under the catalog.hide_unwatched_episode_overviews setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء وصف الحلقة حتى تبدأ مشاهدتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Описанието на епизода се скрива, докато не започнете да го гледате."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaga la descripció d’un episodi fins que el comencis a veure."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryje popis dílu, dokud ho nezačnete sledovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul et afsnits beskrivelse, indtil du begynder at se det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet die Beschreibung einer Folge aus, bis du sie zu schauen beginnst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απόκρυψη της περιγραφής ενός επεισοδίου μέχρι να αρχίσετε να το παρακολουθείτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide an episode's description until you start watching it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta la descripción de un episodio hasta que empieces a verlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peidab osa kirjelduse, kuni hakkate seda vaatama."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilota jakson kuvaus, kunnes aloitat sen katselun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
