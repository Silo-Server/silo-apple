          }
        }
      }
    },
    "tvPairing.failedExpired" : {
      "comment" : "Android TV failure message when the code expired before approval. {server}: the server name. Apple TV: same message on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
