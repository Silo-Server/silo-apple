    "player.error.connectionLost" : {
      "comment" : "Apple iOS/tvOS/macOS: video player error screen after reconnecting to the server failed; the first line is a heading, the second the explanation, shown above a Try again button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الاتصال\nتعذّر على Silo إعادة الاتصال بالخادم. تحقق من اتصالك، ثم حاول مرة أخرى لمتابعة المشاهدة من حيث توقفت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojení ztraceno\nAplikaci Silo se nepodařilo znovu připojit k serveru. Zkontrolujte připojení a zkuste to znovu, přehrávání bude pokračovat tam, kde skončilo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen blev afbrudt\nSilo kunne ikke genoprette forbindelsen til serveren. Tjek din forbindelse, og prøv så igen for at fortsætte, hvor du slap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung verloren\nSilo konnte keine neue Verbindung zum Server herstellen. Prüfe deine Verbindung und versuche es dann erneut, um dort weiterzuschauen, wo du aufgehört hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connection lost\nSilo couldn't reconnect to the server. Check your connection, then try again to continue where you left off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexión perdida\nSilo no pudo volver a conectarse al servidor. Revisa tu conexión y vuelve a intentarlo para continuar donde lo dejaste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteys katkesi\nSilo ei saanut yhteyttä palvelimeen uudelleen. Tarkista yhteys ja yritä sitten uudelleen jatkaaksesi siitä, mihin jäit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion perdue\nSilo n’a pas pu se reconnecter au serveur. Vérifiez votre connexion, puis réessayez pour reprendre là où vous vous étiez arrêté."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza je prekinuta\nSilo se nije uspio ponovno povezati s poslužiteljem. Provjerite vezu i pokušajte ponovno kako biste nastavili ondje gdje ste stali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connessione persa\nImpossibile riconnettersi al server. Controlla la connessione, poi riprova per continuare da dove avevi interrotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続が切断されました\nSiloはサーバーに再接続できませんでした。接続を確認してから、もう一度お試しください。中断したところから再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 끊김\nSilo에서 서버에 다시 연결할 수 없어요. 연결을 확인한 후 다시 시도하면 중단한 곳부터 이어서 볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistet tilkoblingen\nSilo kunne ikke koble til serveren igjen. Sjekk tilkoblingen, og prøv deretter igjen for å fortsette der du slapp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinding verbroken\nSilo kan niet opnieuw verbinden met de server. Controleer je verbinding en probeer het opnieuw om verder te gaan waar je gebleven was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utracono połączenie\nAplikacji Silo nie udało się ponownie połączyć z serwerem. Sprawdź połączenie i spróbuj ponownie, aby kontynuować od miejsca, w którym przerwano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexão perdida\nNão foi possível reconectar o Silo ao servidor. Verifique sua conexão e tente novamente para continuar de onde parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение потеряно\nSilo не удалось снова подключиться к серверу. Проверьте подключение и повторите попытку, чтобы продолжить с того же места."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslutningen bröts\nSilo kunde inte återansluta till servern. Kontrollera anslutningen och försök sedan igen för att fortsätta där du slutade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı kesildi\nSilo sunucuya yeniden bağlanamadı. Bağlantınızı kontrol edin, ardından kaldığınız yerden devam etmek için tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З’єднання втрачено\nSilo не вдалося знову під’єднатися до сервера. Перевірте з’єднання й спробуйте ще раз, щоб продовжити з того самого місця."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接已断开\nSilo无法重新连接到服务器。请检查你的网络连接，然后重试，从上次离开的位置继续播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線中斷\nSilo 無法重新連線至伺服器。請檢查你的連線，然後再試一次，從上次中斷的地方繼續觀看。"
          }
        }
      }
    },
    "player.error.couldNotStart" : {
      "comment" : "Apple iOS: player error screen; guidance when no retry is offered.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo بدء هذا الفيديو. ارجع واختره مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikaci Silo se nepodařilo spustit toto video. Vraťte se zpět a vyberte ho znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke starte denne video. Gå tilbage, og vælg den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte dieses Video nicht starten. Geh zurück und wähle es erneut aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn’t start this video. Go back and choose it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo iniciar este video. Vuelve atrás y elígelo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei voinut käynnistää tätä videota. Palaa takaisin ja valitse se uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a pas pu lancer cette vidéo. Revenez en arrière et sélectionnez-la de nouveau."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nije uspio pokrenuti ovaj videozapis. Vratite se i ponovno ga odaberite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo non riesce ad avviare questo video. Torna indietro e sceglilo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloはこの動画を開始できませんでした。戻ってもう一度選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
