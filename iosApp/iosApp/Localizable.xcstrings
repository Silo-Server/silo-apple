    "pairing.summary.identityMismatch" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: result line when the address the phone sent reached a different server. {server}: the server's name, followed by \" — \" and the account name when there is one (for example Home — sam).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: استجاب العنوان كخادم مختلف."
