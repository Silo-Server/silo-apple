    "requests.notice.removeConflict" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message on My Requests when the server refused to delete a request because its state changed. Android phone and TV request screens: same message on My Requests.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر هذا الطلب منذ تحميل القائمة، لذا لم تتم إزالته."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заявката е променена, след като списъкът се зареди, затова не е премахната."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta sol·licitud ha canviat des que s’ha carregat la llista, així que no s’ha tret."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádost se od načtení seznamu změnila, proto nebyla odebrána."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne anmodning er ændret, siden listen blev indlæst, så den blev ikke fjernet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anfrage hat sich seit dem Laden der Liste geändert und wurde daher nicht entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αίτημα άλλαξε μετά τη φόρτωση της λίστας και δεν αφαιρέθηκε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This request changed since the list loaded, so it wasn't removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud cambió desde que se cargó la lista, así que no se eliminó."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taotlus on pärast loendi laadimist muutunud, seega seda ei eemaldatud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyntö muuttui luettelon latautumisen jälkeen, joten sitä ei poistettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette demande a changé depuis le chargement de la liste ; elle n’a donc pas été supprimée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבקשה השתנתה מאז שהרשימה נטענה, ולכן היא לא הוסרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूची लोड होने के बाद यह अनुरोध बदल गया था, इसलिए इसे हटाया नहीं गया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj se zahtjev promijenio nakon učitavanja popisa pa nije uklonjen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kérés megváltozott a lista betöltése óta, ezért nem távolítottuk el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan ini berubah sejak daftar dimuat, jadi tidak dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa richiesta è cambiata dopo il caricamento dell’elenco, quindi non è stata rimossa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストの読み込み後にこのリクエストが変更されたため、削除されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록을 불러온 후 요청이 변경되어 제거하지 않았어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ši užklausa pasikeitė po sąrašo įkėlimo, todėl nebuvo pašalinta."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis pieprasījums tika mainīts pēc saraksta ielādes, tāpēc tas netika noņemts."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan ini berubah sejak senarai dimuatkan, jadi ia tidak dialih keluar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne forespørselen er endret siden listen ble lastet inn, så den ble ikke fjernet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze aanvraag is gewijzigd sinds de lijst werd geladen en is daarom niet verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta prośba zmieniła się od wczytania listy, więc jej nie usunięto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitação mudou desde que a lista foi carregada, por isso não foi removida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este pedido mudou depois de a lista ter sido carregada, por isso não foi removido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această cerere s-a modificat de la încărcarea listei, așa că nu a fost eliminată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос изменился после загрузки списка, поэтому он не удалён."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto žiadosť sa od načítania zoznamu zmenila, preto sa neodstránila."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta zahteva se je od nalaganja seznama spremenila, zato ni bila odstranjena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förfrågan har ändrats sedan listan lästes in, så den togs inte bort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำขอนี้มีการเปลี่ยนแปลงหลังจากโหลดรายการแล้ว จึงยังไม่ได้นำออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste yüklendikten sonra bu istek değiştiği için kaldırılmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей запит змінився після завантаження списку, тому його не вилучено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu này đã thay đổi kể từ khi danh sách được tải, nên chưa được xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此请求在列表加载后已发生变化，因此未被移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此請求在列表載入後已有變更，因此未移除。"
          }
        }
      }
    },
