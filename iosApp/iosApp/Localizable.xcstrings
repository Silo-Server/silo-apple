    "error.node_deployment_managed" : {
      "comment" : "Error message shown when the server answers with the v2 problem type `node_deployment_managed` (server title: \"Node managed by deployment configuration\"): an administrator tried to issue a key for, or delete, a transcode node that the API servers' deployment configuration lists. Clients show it instead of the server's English detail in a translated interface, so it must make sense on its own, without the request's specifics.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعيَّن هذه العقدة من إعدادات نشر الخادم. أزلها من هناك وأعد تشغيل خوادم API لإدارتها من هنا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този възел е зададен от конфигурацията за внедряване на сървъра. Премахнете го оттам и рестартирайте API сървърите, за да го управлявате тук."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest node el defineix la configuració de desplegament del servidor. Treu-lo d’allà i reinicia els servidors d’API per gestionar-lo aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento uzel je nastaven konfigurací nasazení serveru. Odeberte ho tam a restartujte servery API, abyste ho mohli spravovat zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne node er angivet af serverens udrulningskonfiguration. Fjern den dér, og genstart API-serverne for at administrere den her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
