    "boxSets.unavailableMessage" : {
      "comment" : "Android TV: message on the box set page when the box set cannot be shown, giving possible reasons.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سلسلة الأفلام هذه غير متاحة. قد تكون سلاسل الأفلام معطّلة لهذه المكتبة، أو أن عدد أفلامها الموجودة هنا قليل جدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Filmreihe ist nicht verfügbar. Filmreihen sind für diese Mediathek möglicherweise deaktiviert, oder zu wenige ihrer Filme sind vorhanden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This box set isn't available. Box sets may be turned off for this library, or too few of its movies are here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta saga no está disponible. Puede que las sagas estén desactivadas en esta biblioteca o que haya muy pocas de sus películas aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette saga n’est pas disponible. Les sagas sont peut-être désactivées pour cette bibliothèque, ou trop peu de ses films sont présents."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このボックスセットは利用できません。このライブラリでボックスセットがオフになっているか、ボックスセットの映画がライブラリに十分にありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta coletânea não está disponível. As coletâneas podem estar desativadas para esta biblioteca, ou há poucos filmes dela aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此系列电影不可用。此媒体库可能已关闭系列电影，或其中的电影数量太少。"
          }
        }
      }
    },
