          "stringUnit" : {
            "state" : "translated",
            "value" : "The phone or tablet sent an address for %1$@ that answered as a different server. Check the server on your phone or tablet, or add your server manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teléfono o la tableta envió una dirección de %1$@ que respondió como otro servidor. Revisa el servidor en tu teléfono o tableta, o añade tu servidor manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléphone ou la tablette a envoyé pour %1$@ une adresse qui a répondu comme un autre serveur. Vérifiez le serveur sur votre téléphone ou votre tablette, ou ajoutez votre serveur manuellement."
          }
        },
