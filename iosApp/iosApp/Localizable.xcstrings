    },
    "tvSignIn.signOut.localFailed" : {
      "comment" : "Android TV: message shown when a sign-out failed because the saved sign-in couldn't be cleared on the TV. Apple (iPhone, iPad, Mac, Apple TV): same message in the Account Update alert.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo مسح بيانات تسجيل الدخول المحفوظة على هذا الجهاز. حاول تسجيل الخروج مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte die gespeicherte Anmeldung auf diesem Gerät nicht löschen. Versuche erneut, dich abzumelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn't clear the saved sign-in on this device. Please try signing out again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo borrar el inicio de sesión guardado en este dispositivo. Vuelve a intentar cerrar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a pas pu effacer la connexion enregistrée sur cet appareil. Essayez à nouveau de vous déconnecter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloはこのデバイスに保存されたサインイン情報をクリアできませんでした。もう一度サインアウトをお試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo não conseguiu limpar o login salvo neste dispositivo. Tente sair novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo无法清除此设备上保存的登录信息。请再次尝试退出登录。"
          }
        }
      }
    },
    "tvSignIn.signOut.remotePlaybackNotEnded" : {
      "comment" : "Android TV: message shown when a sign-out was refused because playback started from a phone couldn't be ended. Apple TV: same message in the Account Update alert.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إنهاء التشغيل عن بُعد. حاول تسجيل الخروج مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fernwiedergabe konnte nicht beendet werden. Versuche erneut, dich abzumelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't end remote playback. Try signing out again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo finalizar la reproducción remota. Vuelve a intentar cerrar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’arrêter la lecture à distance. Essayez à nouveau de vous déconnecter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモート再生を終了できませんでした。もう一度サインアウトをお試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível encerrar a reprodução remota. Tente sair novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法结束远程播放。请再次尝试退出登录。"
          }
        }
      }
    },
