    "settings.titleArt.footer" : {
      "comment" : "Android TV Settings > General > Title Pages: help text under the Show title art switch. Apple: description of the Show Title Art switch (VoiceOver hint on iPhone, iPad and Apple TV; shown under the switch on Mac).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم صورة الشعار عنوانًا عند توفرها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използване на логото като заглавие, когато е налично."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza el logotip com a títol quan estigui disponible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li k dispozici, zobrazí se místo názvu logo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug logografik som titel, når den findes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet, wenn verfügbar, ein Logo als Titel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση του λογότυπου ως τίτλου, όταν υπάρχει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use logo artwork as the title when available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el logotipo como título cuando esté disponible."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasutab võimalusel pealkirjana logograafikat."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä logokuvaa nimenä, kun se on saatavilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le logo comme titre lorsqu’il est disponible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שימוש בלוגו ככותרת כשהוא זמין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
