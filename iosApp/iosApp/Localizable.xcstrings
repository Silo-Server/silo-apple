        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utgår från din globala standard för nedladdningar. Ändringar här gäller bara den här nedladdningen."
          }
        },
        "th" : {
          "stringUnit" : {
