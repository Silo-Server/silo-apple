        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l’icône de signet sur un élément pour l’ajouter ici"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
