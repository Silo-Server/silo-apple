          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVにのみ適用されます。ほかのデバイスはそれぞれの設定を保持します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
