    "setup.advanced.hint" : {
      "comment" : "Android phone server setup screen (first screen with no server): note under Advanced options explaining the Auto protocol and port. Keep 8090 as is. Apple (iPhone, iPad, Mac): same hint under Advanced options.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجرّب الخيار «تلقائي» HTTPS أولًا، ثم HTTP، ثم المنفذ 8090 الخاص بـ Silo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možnost Auto nejprve zkusí HTTPS, potom HTTP a nakonec port 8090 serveru Silo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto prøver først HTTPS, derefter HTTP og derefter Silos port 8090."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto versucht zuerst HTTPS, dann HTTP, dann den Silo-Port 8090."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto tries HTTPS first, then HTTP, then Silo's port 8090."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Automático prueba primero HTTPS, luego HTTP y, por último, el puerto 8090 de Silo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihtoehto Auto kokeilee ensin HTTPS:ää, sitten HTTP:tä ja sitten Silon porttia 8090."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Auto essaie d’abord HTTPS, puis HTTP, puis le port 8090 de Silo."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto najprije pokušava HTTPS, zatim HTTP, a zatim Silov port 8090."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità Auto prova prima HTTPS, poi HTTP, poi la porta 8090 di Silo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動では、HTTPS、HTTP、Siloのポート8090の順に試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동은 HTTPS, HTTP, Silo 포트 8090 순서로 시도해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto prøver først HTTPS, deretter HTTP og så Silos port 8090."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De optie Auto probeert eerst HTTPS, dan HTTP en daarna Silo’s poort 8090."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb Auto najpierw próbuje HTTPS, potem HTTP, a na końcu portu 8090 używanego przez Silo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Auto tenta primeiro HTTPS, depois HTTP e depois a porta 8090 do Silo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В режиме «Авто» сначала используется HTTPS, затем HTTP, затем порт Silo 8090."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto försöker först med HTTPS, sedan HTTP och sedan Silos port 8090."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Otomatik” seçeneği önce HTTPS, ardından HTTP, sonra da Silo’nun 8090 portu ile bağlanmayı dener."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим «Авто» спершу пробує HTTPS, потім HTTP, а потім порт Silo 8090."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动模式会先尝试HTTPS，然后尝试HTTP，最后尝试Silo的端口8090。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」會先嘗試 HTTPS，再嘗試 HTTP，最後嘗試 Silo 的連接埠 8090。"
          }
        }
      }
    },
