    "player.notice.pipNotReady" : {
      "comment" : "Apple iOS: video player notice text under Picture in Picture not ready.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الفيديو غير جاهز لوضع صورة داخل صورة بعد. حاول مرة أخرى بعد لحظات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto video zatím není připraveno pro Obraz v obraze. Zkuste to za chvíli znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne video er ikke klar til billede-i-billede endnu. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Video ist noch nicht für Bild-in-Bild bereit. Versuche es gleich erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This video isn't ready for Picture in Picture yet. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este video aún no está listo para imagen dentro de imagen. Vuelve a intentarlo en un momento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä video ei ole vielä valmis Kuva kuvassa -tilaan. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette vidéo n’est pas encore prête pour le mode Image dans l’image. Réessayez dans un instant."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj videozapis još nije spreman za način Slika u slici. Pokušajte ponovno za trenutak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo video non è ancora pronto per Picture in Picture. Riprova tra un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビデオはまだピクチャ・イン・ピクチャの準備ができていません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 동영상은 아직 PIP 모드를 사용할 준비가 되지 않았어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne videoen er ikke klar for Bilde-i-bilde ennå. Prøv igjen om et øyeblikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze video is nog niet klaar voor Beeld-in-beeld. Probeer het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wideo nie jest jeszcze gotowe do trybu Obraz w obrazie. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este vídeo ainda não está pronto para o Picture in Picture. Tente novamente em instantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это видео пока не готово к режиму «Картинка в картинке». Повторите попытку чуть позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här videon är inte redo för bild-i-bild än. Försök igen om en stund."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu video henüz Resim İçinde Resim için hazır değil. Birazdan tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це відео ще не готове до режиму «Картинка в картинці». Спробуйте ще раз за мить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此视频尚未准备好画中画。请稍后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這部影片尚無法使用子母畫面。請稍後再試一次。"
          }
        }
      }
    },
