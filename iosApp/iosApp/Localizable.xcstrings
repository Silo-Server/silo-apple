    "player.subtitleTools.lostTrack" : {
      "comment" : "Apple iOS/tvOS/macOS: AI subtitle error in the Translate with AI menu and player notice when the app can no longer follow a running job.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقد Silo تتبّع عملية الترجمة هذه. إذا اكتملت، فستظهر الترجمة في قائمة الترجمات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kann diesen Untertitel-Auftrag nicht mehr verfolgen. Wenn er abgeschlossen wird, erscheinen die Untertitel in der Untertitelliste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo lost track of this subtitle job. If it finishes, the subtitles will appear in the subtitle list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo perdió el seguimiento de este trabajo de subtítulos. Si termina, los subtítulos aparecerán en la lista de subtítulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo a perdu le suivi de ce travail de sous-titres. S’il se termine, les sous-titres apparaîtront dans la liste des sous-titres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloはこの字幕ジョブを追跡できなくなりました。ジョブが完了すると、字幕リストに字幕が表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo perdeu o acompanhamento deste trabalho de legendas. Se ele for concluído, as legendas aparecerão na lista de legendas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo已无法跟踪此字幕作业。如果作业完成，字幕将显示在字幕列表中。"
          }
        }
      }
    },
