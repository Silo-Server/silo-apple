    "library.noLibrariesVisibleBody" : {
      "comment" : "Apple iOS and tvOS: supporting line under the empty-state heading when the profile can see no libraries (the Libraries tab on iOS, a library-type tab on Apple TV).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر هنا المكتبات المرئية لهذا الملف الشخصي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde se zobrazí knihovny viditelné pro tento profil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteker, som denne profil kan se, vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediatheken, die für dieses Profil sichtbar sind, erscheinen hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libraries visible to this profile will appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las bibliotecas visibles para este perfil aparecerán aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjastot, jotka tämä profiili näkee, tulevat näkyviin tähän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bibliothèques visibles par ce profil apparaîtront ici."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovdje će se prikazati medijateke vidljive ovom profilu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le librerie visibili a questo profilo verranno mostrate qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールで表示できるライブラリがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필에서 볼 수 있는 라이브러리가 여기에 표시돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteker som er synlige for denne profilen, vises her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliotheken die zichtbaar zijn voor dit profiel verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteki widoczne dla tego profilu pojawią się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As bibliotecas visíveis para este perfil aparecerão aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появятся медиатеки, доступные этому профилю."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
