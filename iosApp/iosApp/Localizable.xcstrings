        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터 요금제 네트워크에서는 속도 테스트를 건너뛰어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
