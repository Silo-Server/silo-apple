    "settings.general.showAdvisoryAgeFooter" : {
      "comment" : "Apple Settings > General (iPhone, iPad, Mac): explanation under the Show Advisory Age switch. Common Sense Media is an organization's name; keep it as is.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض الحد الأدنى المقترح لعمر المشاهد، مثل تصنيف Common Sense Media، في تفاصيل الأفلام والمسلسلات. لا يغيّر هذا ما يُسمح للملف الشخصي بمشاهدته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí v podrobnostech filmu a seriálu doporučený minimální věk diváka, například podle Common Sense Media. Nemění to, co může profil sledovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis en anbefalet minimumsalder, f.eks. fra Common Sense Media, på detaljesiderne for film og serier. Det ændrer ikke, hvad profilen må se."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt bei Film- und Seriendetails ein empfohlenes Mindestalter an, etwa von Common Sense Media. Das ändert nicht, was im Profil geschaut werden darf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a suggested minimum viewer age, such as Common Sense Media’s, on movie and show details. This does not change what the profile may watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una edad mínima recomendada, como la de Common Sense Media, en los detalles de películas y series. Esto no cambia lo que el perfil puede ver."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää elokuvien ja sarjojen tiedoissa katsojan suositellun vähimmäisiän, kuten Common Sense Median suosituksen. Tämä ei muuta sitä, mitä profiili saa katsoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche un âge minimum conseillé, comme celui de Common Sense Media, sur les fiches des films et des séries. Cela ne modifie pas ce que le profil peut regarder."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje preporučenu minimalnu dob gledatelja, primjerice onu organizacije Common Sense Media, u pojedinostima filma i serije. To ne mijenja što profil smije gledati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un’età minima consigliata, come quella di Common Sense Media, nei dettagli di film e serie. Non cambia ciò che il profilo può guardare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Common Sense Mediaなどによる推奨視聴年齢を、映画やシリーズの詳細に表示します。プロフィールで視聴できる内容は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영화 및 시리즈 상세 정보에 Common Sense Media 등의 권장 최소 시청 연령을 표시해요. 프로필의 시청 가능 콘텐츠는 바뀌지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis en anbefalt minimumsalder, for eksempel fra Common Sense Media, på film- og seriedetaljer. Dette endrer ikke hva profilen kan se."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon een aanbevolen minimumleeftijd, zoals die van Common Sense Media, bij film- en seriedetails. Dit verandert niet wat het profiel mag bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje sugerowany minimalny wiek widza, np. według Common Sense Media, w szczegółach filmów i seriali. Nie zmienia to tego, co profil może oglądać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra uma idade mínima sugerida, como a da Common Sense Media, nos detalhes de filmes e séries. Isso não muda o que o perfil pode assistir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать рекомендуемый минимальный возраст зрителя, например от Common Sense Media, на страницах фильмов и сериалов. Это не меняет того, что разрешено смотреть в профиле."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa en rekommenderad lägsta ålder för tittare, till exempel från Common Sense Media, i film- och seriedetaljer. Det här ändrar inte vad profilen får titta på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film ve dizi ayrıntılarında, Common Sense Media gibi kaynakların önerdiği en düşük izleyici yaşını gösterir. Bu, profilin izleyebileceği içerikleri değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати рекомендований мінімальний вік глядачів, наприклад від Common Sense Media, на сторінках фільмів і серіалів. Це не змінює того, що можна дивитися в профілі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在电影和剧集详情中显示建议的最低观看年龄，例如Common Sense Media给出的年龄。这不会改变此个人资料可观看的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在電影和影集詳細資訊中顯示建議的最低觀看年齡，例如 Common Sense Media 的建議。這不會改變此個人檔案可觀看的內容。"
          }
        }
      }
    },
