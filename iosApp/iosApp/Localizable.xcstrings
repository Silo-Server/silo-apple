    "tvPair.link.mismatch" : {
      "comment" : "Apple (iPhone, iPad) Sign in a TV from a link: error when the server answering at the link's address isn't the server the link names. \"Settings > Sign in a TV\" names the menu path in the app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشير هذا الرابط إلى خادم لا يستطيع هذا الجهاز تأكيده. أدخل رمز التلفزيون في الإعدادات ← تسجيل الدخول على تلفزيون بدلًا من ذلك."
