    "player.subtitleTools.aiUnavailable" : {
      "comment" : "Apple iOS/tvOS/macOS: AI subtitle error in the Translate with AI menu when the server's AI service is unreachable (HTTP 503).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الترجمة بالذكاء الاصطناعي غير متاحة الآن. حاول مرة أخرى لاحقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI titulky teď nejsou k dispozici. Zkuste to později."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-undertekster er ikke tilgængelige lige nu. Prøv igen senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Untertitel sind derzeit nicht verfügbar. Versuche es später erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI subtitles aren't available right now. Try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos con IA no están disponibles en este momento. Vuelve a intentarlo más tarde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekoälytekstitys ei ole juuri nyt käytettävissä. Yritä myöhemmin uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
