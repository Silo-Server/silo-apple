          "stringUnit" : {
            "state" : "translated",
            "value" : "De første bokstavene i navnet nedenfor vises på flisen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eerste letters van de naam hieronder verschijnen op je tegel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na kafelku pojawią się pierwsze litery nazwy podanej poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
