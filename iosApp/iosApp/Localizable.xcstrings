          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos en %1$@ ya coinciden con el audio"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstitys (%1$@) vastaa jo ääntä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres %1$@ correspondent déjà à l’audio"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titlovi (%1$@) već su usklađeni sa zvukom"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
