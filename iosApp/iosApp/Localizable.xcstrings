    "tvPairing.failedIdentity" : {
      "comment" : "Android TV failure message when the address sent by the phone reached a different server than expected. {server}: the name of the server the phone meant. Apple TV: same message on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل الهاتف أو الجهاز اللوحي عنوانًا لـ %1$@ استجاب كخادم مختلف. تحقق من الخادم على هاتفك أو جهازك اللوحي، أو أضف الخادم يدويًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефонът или таблетът изпрати адрес за сървъра %1$@, на който отговори друг сървър. Проверете сървъра на телефона или таблета си или добавете сървъра си ръчно."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El telèfon o la tauleta ha enviat una adreça per a %1$@ que ha respost com un servidor diferent. Comprova el servidor al telèfon o la tauleta, o afegeix el servidor manualment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon nebo tablet poslal pro server %1$@ adresu, na které odpověděl jiný server. Zkontrolujte server v telefonu nebo tabletu, nebo přidejte server ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonen eller tabletten sendte en adresse til %1$@, der svarede som en anden server. Kontrollér serveren på din telefon eller tablet, eller tilføj din server manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Smartphone oder Tablet hat für %1$@ eine Adresse gesendet, unter der ein anderer Server geantwortet hat. Prüfe den Server auf deinem Smartphone oder Tablet oder füge deinen Server manuell hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το τηλέφωνο ή το tablet έστειλε μια διεύθυνση για τον διακομιστή %1$@, αλλά απάντησε διαφορετικός διακομιστής. Ελέγξτε τον διακομιστή στο τηλέφωνο ή το tablet σας ή προσθέστε τον διακομιστή σας μη αυτόματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phone or tablet sent an address for %1$@ that answered as a different server. Check the server on your phone or tablet, or add your server manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teléfono o la tableta envió una dirección de %1$@ que respondió como otro servidor. Revisa el servidor en tu teléfono o tableta, o añade tu servidor manualmente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon või tahvelarvuti saatis serveri %1$@ aadressi, mis vastas teise serverina. Kontrollige serverit oma telefonis või tahvelarvutis või lisage server käsitsi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puhelin tai tabletti lähetti palvelimen %1$@ osoitteen, josta vastasi eri palvelin. Tarkista palvelin puhelimessa tai tabletissa tai lisää palvelin manuaalisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléphone ou la tablette a envoyé pour %1$@ une adresse qui a répondu comme un autre serveur. Vérifiez le serveur sur votre téléphone ou votre tablette, ou ajoutez votre serveur manuellement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הטלפון או הטאבלט שלח כתובת לשרת %1$@ שענתה כשרת אחר. יש לבדוק את השרת בטלפון או בטאבלט שלך, או להוסיף את השרת באופן ידני."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन या टैबलेट ने सर्वर %1$@ का जो पता भेजा, उस पर किसी दूसरे सर्वर ने जवाब दिया। अपने फ़ोन या टैबलेट पर सर्वर जाँचें, या अपना सर्वर मैन्युअल रूप से जोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon ili tablet poslao je adresu za poslužitelj %1$@ na kojoj se javio drugi poslužitelj. Provjerite poslužitelj na telefonu ili tabletu ili ručno dodajte svoj poslužitelj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A telefon vagy táblagép olyan címet küldött a(z) %1$@ szerverhez, amelyen egy másik szerver válaszolt. Ellenőrizze a szervert a telefonján vagy táblagépén, vagy adja hozzá a szervert manuálisan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponsel atau tablet mengirim alamat untuk %1$@ yang ternyata merespons sebagai server lain. Periksa server di ponsel atau tablet Anda, atau tambahkan server secara manual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il telefono o tablet ha inviato per %1$@ un indirizzo che ha risposto come un server diverso. Controlla il server sul telefono o tablet, oppure aggiungi il server manualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンまたはタブレットから送信された%1$@のアドレスは、別のサーバーとして応答しました。スマートフォンまたはタブレットでサーバーを確認するか、サーバーを手動で追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰이나 태블릿이 보낸 %1$@ 서버 주소에서 다른 서버가 응답했어요. 휴대폰이나 태블릿에서 서버를 확인하거나 서버를 직접 추가하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonas arba planšetė atsiuntė serverio %1$@ adresą, kuriuo atsakė kitas serveris. Patikrinkite serverį telefone arba planšetėje arba pridėkite serverį rankiniu būdu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tālrunis vai planšetdators nosūtīja servera %1$@ adresi, bet tajā atbildēja cits serveris. Pārbaudiet serveri savā tālrunī vai planšetdatorā vai pievienojiet serveri manuāli."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon atau tablet menghantar alamat untuk %1$@ yang dijawab oleh pelayan lain. Semak pelayan pada telefon atau tablet anda, atau tambah pelayan anda secara manual."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonen eller nettbrettet sendte en adresse for %1$@ som svarte som en annen server. Kontroller serveren på telefonen eller nettbrettet, eller legg til serveren manuelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De telefoon of tablet stuurde een adres voor %1$@ dat antwoordde als een andere server. Controleer de server op je telefoon of tablet, of voeg je server handmatig toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon lub tablet wysłał adres serwera %1$@, pod którym odpowiedział inny serwer. Sprawdź serwer na telefonie lub tablecie albo dodaj serwer ręcznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O celular ou tablet enviou um endereço de %1$@ que respondeu como outro servidor. Verifique o servidor no seu celular ou tablet ou adicione o servidor manualmente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O telemóvel ou tablet enviou um endereço para o servidor %1$@ que respondeu como outro servidor. Verifique o servidor no seu telemóvel ou tablet, ou adicione o servidor manualmente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonul sau tableta a trimis pentru serverul %1$@ o adresă la care a răspuns alt server. Verificați serverul pe telefon sau tabletă ori adăugați manual serverul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон или планшет отправил адрес сервера %1$@, но по нему ответил другой сервер. Проверьте сервер на телефоне или планшете или добавьте сервер вручную."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefón alebo tablet poslal pre server %1$@ adresu, na ktorej odpovedal iný server. Skontrolujte server na telefóne alebo tablete alebo pridajte server manuálne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon ali tablični računalnik je poslal naslov za strežnik %1$@, na katerem se je odzval drug strežnik. Preverite strežnik na telefonu ali tabličnem računalniku ali pa strežnik dodajte ročno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonen eller surfplattan skickade en adress för %1$@ som svarade som en annan server. Kontrollera servern på din telefon eller surfplatta, eller lägg till servern manuellt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โทรศัพท์หรือแท็บเล็ตส่งที่อยู่ของเซิร์ฟเวอร์ %1$@ ที่ตอบกลับเป็นเซิร์ฟเวอร์อื่น ตรวจสอบเซิร์ฟเวอร์บนโทรศัพท์หรือแท็บเล็ต หรือเพิ่มเซิร์ฟเวอร์ด้วยตนเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon veya tablet, %1$@ sunucusu için farklı bir sunucu olarak yanıt veren bir adres gönderdi. Telefonunuzda veya tabletinizde sunucuyu kontrol edin ya da sunucunuzu elle ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон або планшет надіслав для %1$@ адресу, за якою відповів інший сервер. Перевірте сервер на телефоні або планшеті чи додайте сервер вручну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điện thoại hoặc máy tính bảng đã gửi một địa chỉ cho %1$@, nhưng địa chỉ đó phản hồi là một máy chủ khác. Kiểm tra máy chủ trên điện thoại hoặc máy tính bảng của bạn, hoặc thêm máy chủ theo cách thủ công."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机或平板电脑发送的%1$@地址响应的是另一台服务器。请在你的手机或平板电脑上检查服务器，或手动添加你的服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手機或平板電腦傳送的 %1$@ 位址回應的是另一台伺服器。請檢查手機或平板電腦上的伺服器，或手動新增你的伺服器。"
          }
        }
      }
    },
    "tvPairing.failedIdentitySigninAppleTv" : {
      "comment" : "Apple TV pairing screen (shown while a nearby phone sets up or signs in this Apple TV): failure body on the sign-in screen when the phone offered a different server. {server}: the offered server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض الهاتف أو الجهاز اللوحي %1$@، وهو ليس الخادم الذي يستخدمه جهاز Apple TV هذا. اختر خادم جهاز Apple TV هذا على هاتفك أو جهازك اللوحي، أو سجّل الدخول هنا باستخدام كلمة مرور."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефонът или таблетът предложи сървъра %1$@, който не е сървърът, използван от това Apple TV. Изберете сървъра на това Apple TV на телефона или таблета си или влезте тук с парола."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El telèfon o la tauleta ha ofert %1$@, que no és el servidor que utilitza aquest Apple TV. Tria el servidor d’aquest Apple TV al telèfon o la tauleta, o inicia la sessió aquí amb una contrasenya."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon nebo tablet nabídl server %1$@, který toto Apple TV nepoužívá. Vyberte v telefonu nebo tabletu server tohoto Apple TV, nebo se přihlaste zde pomocí hesla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonen eller tabletten tilbød %1$@, som ikke er den server, dette Apple TV bruger. Vælg dette Apple TV’s server på din telefon eller tablet, eller log ind her med en adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Smartphone oder Tablet hat %1$@ angeboten, aber das ist nicht der Server dieses Apple TV. Wähle auf deinem Smartphone oder Tablet den Server dieses Apple TV oder melde dich hier mit einem Passwort an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το τηλέφωνο ή το tablet πρότεινε τον διακομιστή %1$@, ο οποίος δεν είναι ο διακομιστής που χρησιμοποιεί αυτό το Apple TV. Επιλέξτε τον διακομιστή αυτού του Apple TV στο τηλέφωνο ή το tablet σας ή συνδεθείτε εδώ με κωδικό πρόσβασης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phone or tablet offered %1$@, which isn't the server this Apple TV uses. Choose this Apple TV's server on your phone or tablet, or sign in here with a password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teléfono o la tableta ofreció %1$@, que no es el servidor que usa este Apple TV. Elige el servidor de este Apple TV en tu teléfono o tableta, o inicia sesión aquí con una contraseña."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon või tahvelarvuti pakkus serverit %1$@, mida see Apple TV ei kasuta. Valige oma telefonis või tahvelarvutis selle Apple TV server või logige siin sisse parooliga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puhelin tai tabletti tarjosi palvelinta %1$@, jota tämä Apple TV ei käytä. Valitse tämän Apple TV:n palvelin puhelimessa tai tabletissa tai kirjaudu sisään täällä salasanalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléphone ou la tablette a proposé %1$@, qui n’est pas le serveur utilisé par cette Apple TV. Choisissez le serveur de cette Apple TV sur votre téléphone ou votre tablette, ou connectez-vous ici avec un mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הטלפון או הטאבלט הציע את השרת %1$@, שאינו השרת שה-Apple TV הזה משתמש בו. יש לבחור את השרת של ה-Apple TV הזה בטלפון או בטאבלט שלך, או להתחבר כאן עם סיסמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन या टैबलेट ने सर्वर %1$@ दिया, जो इस Apple TV का सर्वर नहीं है। अपने फ़ोन या टैबलेट पर इस Apple TV का सर्वर चुनें, या यहाँ पासवर्ड से साइन इन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon ili tablet ponudio je poslužitelj %1$@, a ovaj Apple TV ne koristi taj poslužitelj. Na telefonu ili tabletu odaberite poslužitelj ovog Apple TV-a ili se ovdje prijavite lozinkom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A telefon vagy táblagép a(z) %1$@ szervert ajánlotta fel, de ez az Apple TV nem ezt a szervert használja. Válassza ki ennek az Apple TV-nek a szerverét a telefonján vagy táblagépén, vagy jelentkezzen be itt jelszóval."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponsel atau tablet menawarkan %1$@, yang bukan server yang digunakan Apple TV ini. Pilih server Apple TV ini di ponsel atau tablet Anda, atau masuk di sini dengan kata sandi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il telefono o tablet ha proposto %1$@, che non è il server usato da questa Apple TV. Scegli il server di questa Apple TV sul telefono o tablet, oppure accedi qui con una password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンまたはタブレットが提示した%1$@は、このApple TVが使用しているサーバーではありません。スマートフォンまたはタブレットでこのApple TVのサーバーを選択するか、ここでパスワードを使ってサインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰이나 태블릿에서 제공한 %1$@ 서버는 이 Apple TV가 사용하는 서버가 아니에요. 휴대폰이나 태블릿에서 이 Apple TV의 서버를 선택하거나, 여기에서 비밀번호로 로그인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonas arba planšetė pasiūlė serverį %1$@, tačiau šis „Apple TV“ naudoja kitą serverį. Telefone arba planšetėje pasirinkite šio „Apple TV“ serverį arba prisijunkite čia slaptažodžiu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tālrunis vai planšetdators piedāvāja serveri %1$@, bet šī Apple TV ierīce izmanto citu serveri. Tālrunī vai planšetdatorā izvēlieties šīs Apple TV ierīces serveri vai pierakstieties šeit ar paroli."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon atau tablet menawarkan %1$@, yang bukan pelayan yang digunakan oleh Apple TV ini. Pilih pelayan Apple TV ini pada telefon atau tablet anda, atau log masuk di sini dengan kata laluan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonen eller nettbrettet tilbød %1$@, som ikke er serveren denne Apple TV-en bruker. Velg serveren til denne Apple TV-en på telefonen eller nettbrettet, eller logg på her med et passord."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De telefoon of tablet bood %1$@ aan, maar dat is niet de server die deze Apple TV gebruikt. Kies de server van deze Apple TV op je telefoon of tablet, of log hier in met een wachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon lub tablet zaproponował serwer %1$@, którego to urządzenie Apple TV nie używa. Wybierz serwer tego urządzenia Apple TV na telefonie lub tablecie albo zaloguj się tutaj hasłem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O celular ou tablet ofereceu %1$@, que não é o servidor usado por esta Apple TV. Escolha o servidor desta Apple TV no seu celular ou tablet ou entre aqui com uma senha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O telemóvel ou tablet ofereceu o servidor %1$@, que não é o servidor que esta Apple TV usa. Escolha o servidor desta Apple TV no seu telemóvel ou tablet, ou inicie sessão aqui com uma palavra-passe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonul sau tableta a oferit serverul %1$@, care nu este serverul folosit de acest Apple TV. Alegeți serverul acestui Apple TV pe telefon sau tabletă ori conectați-vă aici cu o parolă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон или планшет предложил сервер %1$@, но этот Apple TV использует другой сервер. Выберите сервер этого Apple TV на телефоне или планшете или войдите здесь с паролем."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefón alebo tablet ponúkol server %1$@, ktorý toto zariadenie Apple TV nepoužíva. Na telefóne alebo tablete vyberte server tohto zariadenia Apple TV alebo sa tu prihláste heslom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon ali tablični računalnik je ponudil strežnik %1$@, ki ga ta Apple TV ne uporablja. Na telefonu ali tabličnem računalniku izberite strežnik tega Apple TV ali pa se prijavite tukaj z geslom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonen eller surfplattan erbjöd %1$@, som inte är den server som den här Apple TV:n använder. Välj den här Apple TV:ns server på din telefon eller surfplatta, eller logga in här med ett lösenord."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โทรศัพท์หรือแท็บเล็ตเสนอเซิร์ฟเวอร์ %1$@ ซึ่งไม่ใช่เซิร์ฟเวอร์ที่ Apple TV เครื่องนี้ใช้ เลือกเซิร์ฟเวอร์ของ Apple TV เครื่องนี้บนโทรศัพท์หรือแท็บเล็ต หรือลงชื่อเข้าใช้ที่นี่ด้วยรหัสผ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon veya tablet %1$@ sunucusunu önerdi, ancak bu Apple TV bu sunucuyu kullanmıyor. Telefonunuzda veya tabletinizde bu Apple TV’nin sunucusunu seçin ya da burada parolayla oturum açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон або планшет запропонував %1$@, але цей Apple TV використовує інший сервер. Виберіть сервер цього Apple TV на телефоні або планшеті чи ввійдіть тут за допомогою пароля."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
