        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vuelves a unirte aquí, el otro dispositivo de este perfil se desconectará de la Watch Party."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoindre ici déconnecte de la Watch Party l’autre appareil de ce profil."
