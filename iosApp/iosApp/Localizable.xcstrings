    "diagnostics.prompt.uncleanShutdownHosted" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad, Apple TV), shown after a problem report is captured: message when one report is waiting. Reports go to Silo Diagnostics, the Silo project's hosted service; Silo Diagnostics is a product name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُغلق Silo بشكل سليم في المرة الأخيرة. قد يساعد إرسال تقرير تشخيص فريق Silo Diagnostics على فهم ما حدث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo wurde beim letzten Mal nicht ordnungsgemäß beendet. Ein Diagnosebericht kann dem Team von Silo Diagnostics helfen, zu verstehen, was passiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo did not shut down cleanly last time. Sending a diagnostics report can help the Silo Diagnostics team understand what happened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no se cerró correctamente la última vez. Enviar un informe de diagnóstico puede ayudar al equipo de Silo Diagnostics a entender qué pasó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ne s’est pas arrêté correctement la dernière fois. L’envoi d’un rapport de diagnostic peut aider l’équipe Silo Diagnostics à comprendre ce qui s’est passé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回、Siloは正常に終了しませんでした。診断レポートを送信すると、Silo Diagnosticsチームが原因を把握するのに役立ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo não foi encerrado corretamente da última vez. Enviar um relatório de diagnóstico pode ajudar a equipe do Silo Diagnostics a entender o que aconteceu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo上次未正常关闭。发送诊断报告可以帮助Silo Diagnostics团队了解发生了什么。"
          }
        }
      }
    },
