    "account.replace.message" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message of the replace-account confirmation. {server}: the server's display name; {new_account}: username of the account now signed in; {old_account}: username of the account Replace would sign out.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجلت الدخول الآن إلى %1$@ باسم %2$@. يؤدي الاستبدال إلى تسجيل الخروج من %3$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
