        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piekrišana avāriju pārskatiem ir saistīta ar šo servera kontu. Atkļūdošanas žurnālēšana ir šīs ierīces iestatījums."
          }
        },
        "ms" : {
          "stringUnit" : {
