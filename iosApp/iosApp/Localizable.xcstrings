    "servers.remove.confirmTitle" : {
      "comment" : "Apple TV Manage Servers: title of the confirmation before a saved server is removed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد إزالة هذا الخادم؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да се премахне ли този сървър?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols treure aquest servidor?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebrat tento server?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du fjerne denne server?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesen Server entfernen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαίρεση αυτού του διακομιστή;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove this server?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quitar este servidor?"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas eemaldada see server?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistetaanko tämä palvelin?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer ce serveur ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להסיר את השרת הזה?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सर्वर हटाएँ?"
          }
        },
