    "requests.notice.following" : {
      "comment" : "Toast on Roku after the user turns on notifications for a request. Promises a notice when the title is available. Apple (iPhone, iPad, Mac, Apple TV): same notice under the Notify Me button on a request detail page.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنُعلمك عندما يصبح متاحًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще ви уведомим, когато е налично."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T’avisarem quan estigui disponible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dáme vám vědět, až bude k dispozici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi giver dig besked, når den er tilgængelig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sagen dir Bescheid, sobald es verfügbar ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σας ειδοποιήσουμε όταν είναι διαθέσιμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll let you know when it's available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisaremos cuando esté disponible."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anname teada, kui see on saadaval."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ilmoituksen, kun se on saatavilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous vous avertirons dès que ce sera disponible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נעדכן אותך כשהפריט יהיה זמין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपलब्ध होने पर हम आपको बता देंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obavijestit ćemo vas kad bude dostupno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Értesítjük, ha elérhetővé válik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami akan memberi tahu Anda saat tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avviseremo quando sarà disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴可能になったらお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이용할 수 있게 되면 알려 드릴게요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pranešime, kai bus pasiekiama."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paziņosim jums, kad saturs būs pieejams."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami akan memberitahu anda apabila tajuk ini tersedia."
          }
        },
        "nb" : {
