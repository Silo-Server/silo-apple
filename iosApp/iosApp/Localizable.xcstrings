          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@不允许此设备登录此服务器。"
          }
        }
      }
    },
    "tvSignIn.error.rateLimited" : {
      "comment" : "Android TV and phone sign-in error after too many attempts. Apple (iPhone, iPad, Mac): also the error on the Choose a new password screen after too many attempts. Apple (iPhone, iPad): same error on the Sign in a TV approval card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محاولات كثيرة جدًا. انتظر قليلًا، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
