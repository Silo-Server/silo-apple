    "settingsManifest.downloads.wifi_only.description" : {
      "comment" : "Help text under the downloads.wifi_only setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التنزيل فقط أثناء الاتصال بشبكة Wi-Fi."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изтегляне само при връзка с Wi-Fi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa només amb connexió Wi-Fi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stahovat jen při připojení k Wi-Fi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download kun, mens der er forbindelse til Wi-Fi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt nur herunter, wenn eine Wi-Fi-Verbindung besteht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λήψη μόνο όταν υπάρχει σύνδεση σε Wi-Fi."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only download while connected to Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargar solo con conexión Wi-Fi."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laadib alla ainult siis, kui seade on Wi-Fi-ga ühendatud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataa vain, kun laite on yhdistetty Wi-Fi-verkkoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharger uniquement en étant connecté au Wi-Fi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הורדה רק בזמן חיבור ל-Wi-Fi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ Wi-Fi से कनेक्ट होने पर डाउनलोड करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzima samo dok ste povezani s Wi-Fi mrežom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letöltés csak Wi-Fi-kapcsolat esetén."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduh hanya saat terhubung ke Wi-Fi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
