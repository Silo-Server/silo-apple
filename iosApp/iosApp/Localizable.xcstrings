    "accounts.body" : {
      "comment" : "Helper text under the heading of the Roku change-account screen. Apple TV: same text on the Change account screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر خادمًا، ثم الحساب الذي تريد استخدامه عليه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете сървър, след това акаунта, който да използвате в него."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria un servidor i després el compte que vols utilitzar-hi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte server a pak účet, který na něm chcete používat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en server og derefter den konto, du vil bruge på den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Server und dann das Konto, das du dort verwenden möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε έναν διακομιστή και, στη συνέχεια, τον λογαριασμό που θα χρησιμοποιήσετε σε αυτόν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a server, then the account to use on it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un servidor y luego la cuenta que quieres usar en él."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valige server ja seejärel selles kasutatav konto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse palvelin ja sitten tili, jota käytät siinä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un serveur, puis le compte à utiliser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבחור שרת, ואז את החשבון שבו להשתמש בשרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई सर्वर चुनें, फिर उस पर इस्तेमाल करने के लिए खाता चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite poslužitelj, a zatim račun koji ćete na njemu koristiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válasszon egy szervert, majd a rajta használni kívánt fiókot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih server, lalu akun yang akan digunakan di server itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un server, poi l’account da usare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーを選択してから、そのサーバーで使用するアカウントを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버를 선택한 다음 사용할 계정을 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkite serverį, tada jame naudotiną paskyrą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvēlieties serveri un pēc tam tajā izmantojamo kontu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih pelayan, kemudian akaun yang hendak digunakan padanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en server, og deretter kontoen du vil bruke på den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een server en daarna het account dat je erop wilt gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz serwer, a potem konto, którego chcesz na nim używać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um servidor e depois a conta que será usada nele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um servidor e, depois, a conta a usar nele."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți un server, apoi contul pe care îl folosiți pe acesta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите сервер, затем аккаунт на нём."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte server a potom účet, ktorý na ňom chcete používať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izberite strežnik, nato pa račun, ki ga želite uporabljati na njem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en server och sedan vilket konto du vill använda på den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกเซิร์ฟเวอร์ แล้วเลือกบัญชีที่จะใช้บนเซิร์ฟเวอร์นั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sunucu, ardından o sunucuda kullanılacak hesabı seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть сервер, а потім обліковий запис на ньому."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn máy chủ, rồi chọn tài khoản để dùng trên máy chủ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择服务器，然后选择要在其上使用的账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇伺服器，再選擇要在上面使用的帳號。"
          }
        }
      }
    },
