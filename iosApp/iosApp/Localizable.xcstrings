          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always Send Crash Reports?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Enviar siempre los informes de fallos?"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
