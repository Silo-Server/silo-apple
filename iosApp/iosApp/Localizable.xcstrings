    "errors.apple.subtitles.outcomeUnknownOwnerChanged" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error on the subtitle search screen when the user switched account while a subtitle download was running; it may or may not have been saved.",
      "extractionState" : "manual",
