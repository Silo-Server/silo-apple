    "tvSignIn.appleTv.lead" : {
      "comment" : "Apple TV sign-in screen: paragraph under the headline beside the QR code. {page}: the server's activation address as typed, for example media.example.com/activate.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح الرمز بكاميرا هاتفك، أو انتقل إلى %1$@ وأدخله. وافق على هاتفك وسيسجّل Apple TV هذا الدخول تلقائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканирайте кода с камерата на телефона си или отидете на %1$@ и го въведете. Одобрете от телефона си и това Apple TV ще влезе автоматично."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneja el codi amb la càmera del telèfon o ves a %1$@ i introdueix-lo. Aprova-ho al telèfon i aquest Apple TV inicia la sessió automàticament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte kód fotoaparátem telefonu nebo přejděte na %1$@ a zadejte ho. Schvalte přihlášení v telefonu a Apple TV se přihlásí automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan koden med telefonens kamera, eller gå til %1$@, og indtast den. Godkend på telefonen, så logger dette Apple TV ind af sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Code mit der Kamera deines Smartphones oder öffne %1$@ und gib ihn dort ein. Bestätige auf deinem Smartphone, dann meldet sich dieses Apple TV von selbst an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαρώστε τον κωδικό με την κάμερα του τηλεφώνου σας ή μεταβείτε στη διεύθυνση %1$@ και πληκτρολογήστε τον. Εγκρίνετε στο τηλέφωνό σας και αυτό το Apple TV θα συνδεθεί αυτόματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the code with your phone's camera, or go to %1$@ and enter it. Approve on your phone and this Apple TV signs in by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código con la cámara de tu teléfono o ve a %1$@ y escríbelo. Aprueba en tu teléfono y este Apple TV iniciará sesión solo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannige kood telefoni kaameraga või avage aadress %1$@ ja sisestage kood. Kinnitage telefonis ja see Apple TV logib sisse automaatselt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannaa koodi puhelimesi kameralla tai siirry osoitteeseen %1$@ ja syötä koodi. Hyväksy puhelimessa, niin tämä Apple TV kirjautuu sisään itsestään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code avec l’appareil photo de votre téléphone, ou accédez à %1$@ et saisissez-le. Approuvez sur votre téléphone et cette Apple TV se connecte d’elle-même."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לסרוק את הקוד במצלמה של הטלפון, או לעבור לכתובת %1$@ ולהזין אותו. אחרי האישור בטלפון, מכשיר ה-Apple TV הזה יתחבר מעצמו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने फ़ोन के कैमरे से कोड स्कैन करें या %1$@ पर जाकर उसे डालें। अपने फ़ोन पर मंज़ूरी दें, यह Apple TV अपने-आप साइन इन हो जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenirajte kôd kamerom telefona ili otvorite %1$@ i unesite ga. Odobrite na telefonu i ovaj će se Apple TV sam prijaviti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvassa be a kódot a telefon kamerájával, vagy nyissa meg ezt az oldalt: %1$@, és adja meg ott a kódot. Hagyja jóvá a telefonján, és ez az Apple TV magától bejelentkezik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindai kode dengan kamera ponsel Anda, atau buka %1$@ dan masukkan kode tersebut. Setujui di ponsel Anda, dan Apple TV ini akan masuk dengan sendirinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra il codice con la fotocamera del telefono oppure vai su %1$@ e inseriscilo. Approva sul telefono e questa Apple TV accederà da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンのカメラでコードをスキャンするか、%1$@にアクセスしてコードを入力してください。スマートフォンで承認すると、このApple TVが自動的にサインインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰 카메라로 코드를 스캔하거나 %1$@에 접속해 코드를 입력하세요. 휴대폰에서 승인하면 이 Apple TV가 자동으로 로그인돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuskaitykite kodą telefono kamera arba eikite į %1$@ ir įveskite jį. Patvirtinkite telefone, ir šis „Apple TV“ įrenginys prisijungs automatiškai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noskenējiet kodu ar tālruņa kameru vai atveriet %1$@ un ievadiet to. Apstipriniet tālrunī, un šī Apple TV ierīce pierakstīsies automātiski."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbas kod dengan kamera telefon anda, atau pergi ke %1$@ dan masukkan kod itu. Luluskan pada telefon anda dan Apple TV ini akan log masuk dengan sendirinya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skann koden med telefonkameraet, eller gå til %1$@ og skriv den inn. Godkjenn på telefonen, så logger denne Apple TV-en på av seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan de code met de camera van je telefoon, of ga naar %1$@ en voer hem daar in. Keur het goed op je telefoon en deze Apple TV wordt vanzelf ingelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj kod aparatem telefonu albo otwórz stronę %1$@ i wpisz go. Zatwierdź na telefonie, a to Apple TV zaloguje się samo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie o código com a câmera do celular ou acesse %1$@ e digite-o. Aprove no celular e esta Apple TV entra sozinha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia o código com a câmara do telemóvel ou aceda a %1$@ e introduza-o. Aprove no telemóvel e esta Apple TV inicia sessão automaticamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanați codul cu camera telefonului sau accesați %1$@ și introduceți-l. Aprobați pe telefon, iar acest Apple TV se conectează automat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте код камерой телефона или откройте %1$@ и введите его. Подтвердите вход на телефоне, и этот Apple TV войдёт автоматически."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte kód fotoaparátom telefónu alebo prejdite na stránku %1$@ a zadajte ho. Schváľte prihlásenie v telefóne a toto Apple TV sa prihlási samo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodo skenirajte s kamero telefona ali obiščite %1$@ in jo vnesite. Odobrite na telefonu in ta Apple TV se prijavi sam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanna koden med telefonens kamera, eller gå till %1$@ och ange den. Godkänn på telefonen så loggar den här Apple TV:n in automatiskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สแกนรหัสด้วยกล้องโทรศัพท์ หรือไปที่ %1$@ แล้วป้อนรหัส อนุมัติในโทรศัพท์ แล้ว Apple TV เครื่องนี้จะลงชื่อเข้าใช้เอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodu telefonunuzun kamerasıyla tarayın veya %1$@ adresine gidip kodu girin. Telefonunuzda onaylayın, bu Apple TV kendiliğinden oturum açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відскануйте код камерою телефона або перейдіть на %1$@ і введіть його. Підтвердьте вхід на телефоні, і цей Apple TV увійде автоматично."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quét mã bằng camera của điện thoại, hoặc truy cập %1$@ và nhập mã. Phê duyệt trên điện thoại và Apple TV này sẽ tự đăng nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
