          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Showing the last known diagnostics state. Reports stay on this device while the server is offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra el último estado conocido de los diagnósticos. Los informes permanecen en este dispositivo mientras el servidor está sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
