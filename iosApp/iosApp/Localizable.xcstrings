    "player.subtitleSync.actionNote" : {
      "comment" : "Apple iOS/tvOS/macOS: explains Sync to Audio for a stored subtitle. Shown under the selected subtitle's timing actions in the player: the iOS Audio & Subtitles sheet, the macOS player options panel and the tvOS info panel's Subtitles tab. Android phone and TV player subtitle timing: same note under the timing actions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطابق التوقيت مع الصوت لكل من يشاهد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt das Timing für alle, die zuschauen, an den Ton an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matches the timing to the audio for everyone watching."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta los tiempos al audio para todas las personas que lo ven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cale le minutage sur l’audio pour toutes les personnes qui regardent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴中の全員に対して、タイミングを音声に合わせます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta a sincronia com o áudio para todos que estão assistindo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为所有观看者将字幕时间与音频对齐。"
          }
        }
      }
    },
    "player.subtitleSync.actionNoteExternal" : {
      "comment" : "Apple iOS/tvOS/macOS: explains Sync to Audio for a subtitle file next to the media. Shown under the selected subtitle's timing actions in the player: the iOS Audio & Subtitles sheet, the macOS player options panel and the tvOS info panel's Subtitles tab. Android phone and TV player subtitle timing: same note under the timing actions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطابق التوقيت مع الصوت للجميع. لا يتغير الملف نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt das Timing für alle an den Ton an. Die Datei selbst wird nicht geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matches the timing to the audio for everyone. The file itself isn't changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta los tiempos al audio para todas las personas. El archivo en sí no se modifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cale le minutage sur l’audio pour tout le monde. Le fichier lui-même n’est pas modifié."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員に対してタイミングを音声に合わせます。ファイル自体は変更されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta a sincronia com o áudio para todos. O arquivo em si não é alterado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为所有人将字幕时间与音频对齐。文件本身不会被更改。"
          }
        }
      }
    },
    "player.subtitleSync.dismiss" : {
