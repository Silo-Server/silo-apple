    "settingsManifest.subtitle.matches_device.description" : {
      "comment" : "Help text under the subtitle.matches_device setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام نمط التسميات التوضيحية في نظام التشغيل بدلًا من نمط Silo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Untertitelstil des Betriebssystems statt dem von Silo verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the operating system's caption style instead of Silo's."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el estilo de subtítulos del sistema operativo en lugar del de Silo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le style de sous-titres du système d’exploitation au lieu de celui de Silo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloの字幕スタイルの代わりにOSの字幕スタイルを使用します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o estilo de legendas do sistema operacional em vez do estilo do Silo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用操作系统的字幕样式，而不是Silo的样式。"
          }
        }
      }
    },
