    "diagnostics.capture.selfHostedFooter" : {
      "comment" : "Footer under the Diagnostics settings Capture section when reports go to the user's own server. Shown on Android phone and Apple (iPhone, iPad).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتبط الموافقة على تقارير الأعطال بحساب الخادم هذا. تسجيل التصحيح إعداد خاص بهذا الجهاز."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souhlas se zprávami o pádech je vázán na tento účet na serveru. Protokolování ladění je nastavení tohoto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtykke til nedbrudsrapporter er knyttet til denne serverkonto. Fejlfindingslogning er en indstilling for denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einwilligung zu Absturzberichten gilt für dieses Serverkonto. Debug-Protokollierung ist eine Einstellung für dieses Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crash report consent is tied to this server account. Debug logging is a setting for this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El consentimiento de los informes de fallos está vinculado a esta cuenta del servidor. El registro de depuración es un ajuste de este dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaatumisraporttien suostumus on sidottu tähän palvelintiliin. Virheenkorjauslokit ovat tämän laitteen asetus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le consentement aux rapports de plantage est lié à ce compte serveur. La journalisation de débogage est un paramètre propre à cet appareil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristanak za izvješća o rušenju vezan je uz ovaj račun na poslužitelju. Zapisivanje za otklanjanje pogrešaka postavka je za ovaj uređaj."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il consenso ai report sugli arresti anomali è legato a questo account del server. Il logging di debug è un’impostazione di questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュレポートの同意はこのサーバーアカウントに紐付けられます。デバッグログはこのデバイスの設定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충돌 보고서 동의는 이 서버 계정에 연결돼요. 디버그 로깅은 이 기기의 설정이에요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtykke til krasjrapporter er knyttet til denne serverkontoen. Feilsøkingslogging er en innstilling for denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toestemming voor crashrapporten is gekoppeld aan dit serveraccount. Debuglogging is een instelling voor dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgoda na raporty o awariach jest powiązana z tym kontem na serwerze. Logi debugowania to ustawienie tego urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O consentimento para relatórios de falhas está vinculado a esta conta do servidor. O log de depuração é uma configuração deste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Согласие на отправку отчётов о сбоях привязано к этому аккаунту на сервере. Отладочное логирование настраивается для этого устройства."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtycket till kraschrapporter är knutet till det här serverkontot. Felsökningsloggning är en inställning för den här enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitlenme raporu onayı bu sunucu hesabına bağlıdır. Hata ayıklama günlüğü bu cihaza özgü bir ayardır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Згода на надсилання звітів про збої прив’язана до цього облікового запису на сервері. Журнал налагодження – це налаштування цього пристрою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "崩溃报告的同意设置与此服务器账户绑定。调试日志是此设备的设置项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當機報告的同意設定與此伺服器帳號綁定。偵錯記錄是此裝置的設定。"
          }
        }
      }
    },
    "diagnostics.capture.selfHostedFooterAppleTv" : {
      "comment" : "Apple TV Settings > Diagnostics: footer under the Capture section when reports go to the user's own server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتبط الموافقة على تقارير الأعطال بحساب الخادم هذا. تسجيل التصحيح إعداد خاص بجهاز Apple TV هذا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souhlas se zprávami o pádech je vázán na tento účet na serveru. Protokolování ladění je nastavení této Apple TV."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtykke til nedbrudsrapporter er knyttet til denne serverkonto. Fejlfindingslogning er en indstilling for dette Apple TV."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einwilligung zu Absturzberichten gilt für dieses Serverkonto. Debug-Protokollierung ist eine Einstellung für dieses Apple TV."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crash report consent is tied to this server account. Debug logging is a setting for this Apple TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El consentimiento de los informes de fallos está vinculado a esta cuenta del servidor. El registro de depuración es un ajuste de este Apple TV."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaatumisraporttien suostumus on sidottu tähän palvelintiliin. Virheenkorjauslokit ovat tämän Apple TV:n asetus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le consentement aux rapports de plantage est lié à ce compte serveur. La journalisation de débogage est un paramètre propre à cette Apple TV."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristanak za izvješća o rušenju vezan je uz ovaj račun na poslužitelju. Zapisivanje za otklanjanje pogrešaka postavka je za ovaj Apple TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il consenso ai report sugli arresti anomali è legato a questo account del server. Il logging di debug è un’impostazione di questa Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュレポートの同意はこのサーバーアカウントに紐付けられます。デバッグログはこのApple TVの設定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충돌 보고서 동의는 이 서버 계정에 연결돼요. 디버그 로깅은 이 Apple TV의 설정이에요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtykke til krasjrapporter er knyttet til denne serverkontoen. Feilsøkingslogging er en innstilling for denne Apple TV-en."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toestemming voor crashrapporten is gekoppeld aan dit serveraccount. Debuglogging is een instelling voor deze Apple TV."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgoda na raporty o awariach jest powiązana z tym kontem na serwerze. Logi debugowania to ustawienie tego urządzenia Apple TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O consentimento para relatórios de falhas está vinculado a esta conta do servidor. O log de depuração é uma configuração desta Apple TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Согласие на отправку отчётов о сбоях привязано к этому аккаунту на сервере. Отладочное логирование настраивается для этого Apple TV."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtycket till kraschrapporter är knutet till det här serverkontot. Felsökningsloggning är en inställning för den här Apple TV-enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitlenme raporu onayı bu sunucu hesabına bağlıdır. Hata ayıklama günlüğü bu Apple TV’ye özgü bir ayardır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Згода на надсилання звітів про збої прив’язана до цього облікового запису на сервері. Журнал налагодження – це налаштування цього Apple TV."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "崩溃报告的同意设置与此服务器账户绑定。调试日志是此Apple TV的设置项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當機報告的同意設定與此伺服器帳號綁定。偵錯記錄是此 Apple TV 的設定。"
          }
        }
      }
    },
    "diagnostics.consent.chooseDescription" : {
      "comment" : "Apple TV Settings > Diagnostics > Crash Reports: explanation above the Ask, Always and Never choices.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما يجب أن يفعله Silo عند توفر تقرير عن عطل أو تجمّد أو إيقاف غير سليم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, co má Silo udělat, když je k dispozici zpráva o pádu, zamrznutí nebo neočekávaném ukončení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvad Silo skal gøre, når en rapport om et nedbrud, en hængning eller en ukorrekt nedlukning er tilgængelig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, was Silo tun soll, wenn ein Bericht zu einem Absturz, einem Hänger oder einem unerwarteten Beenden verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what Silo should do when a crash, hang, or unclean shutdown report is available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué debe hacer Silo cuando haya disponible un informe de fallo, bloqueo o cierre anómalo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, mitä Silon pitää tehdä, kun kaatumisesta, jumiutumisesta tai virheellisestä sammumisesta on saatavilla raportti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ce que Silo doit faire lorsqu’un rapport de plantage, de blocage ou d’arrêt inattendu est disponible."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite što Silo treba učiniti kad je dostupno izvješće o rušenju, zastoju ili nepravilnom gašenju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli cosa deve fare Silo quando è disponibile un report su un arresto anomalo, un blocco o una chiusura non corretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュ、ハング、または異常終了のレポートがあるときのSiloの動作を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충돌, 응답 없음 또는 비정상 종료 보고서가 있을 때 Silo에서 할 작업을 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hva Silo skal gjøre når en rapport om krasj, heng eller unormal avslutning er tilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies wat Silo moet doen als er een rapport over een crash, vastloper of onjuiste afsluiting beschikbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, co aplikacja Silo ma zrobić, gdy dostępny jest raport o awarii, zawieszeniu lub nieprawidłowym zamknięciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o que o Silo deve fazer quando houver um relatório de falha, travamento ou encerramento inesperado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, что должно делать приложение Silo, когда доступен отчёт о сбое, зависании или некорректном завершении работы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj vad Silo ska göra när det finns en rapport om en krasch, en frysning eller en oväntad avstängning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitlenme, donma veya beklenmedik kapanma raporu olduğunda Silo’nun ne yapacağını seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть, що Silo має робити, коли доступний звіт про збій, зависання або некоректне завершення роботи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择出现崩溃、无响应或异常关闭报告时Silo应如何处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇有當機、無回應或未正常關閉的報告時，Silo 該如何處理。"
          }
        }
      }
    },
