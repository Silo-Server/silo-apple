    "detail.unreachable.offline" : {
      "comment" : "Apple iOS: message of the Can't Reach Server dialog when the device has no network connection.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت غير متصل. اتصل بشبكة لبدء البث، أو شغّل عنوانًا تم تنزيله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Verbinde dich mit einem Netzwerk, um zu streamen, oder spiele einen heruntergeladenen Titel ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're offline. Connect to a network to stream, or play a downloaded title."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes conexión. Conéctate a una red para transmitir o reproduce un título descargado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne. Connectez-vous à un réseau pour lancer le streaming, ou lisez un titre téléchargé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインです。ストリーミングするにはネットワークに接続するか、ダウンロード済みのタイトルを再生してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está off-line. Conecte-se a uma rede para fazer streaming ou reproduza um título baixado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已离线。请连接网络以串流播放，或播放已下载的内容。"
          }
        }
      }
    },
    "detail.unreachable.serverDown" : {
      "comment" : "Apple iOS: message of the Can't Reach Server dialog when the device is online but the server doesn't answer.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب البث اتصالًا بالخادم، وهو لا يستجيب حاليًا. لا يزال بإمكانك تشغيل العناوين التي تم تنزيلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming erfordert eine Verbindung zu deinem Server, der gerade nicht antwortet. Heruntergeladene Titel können weiterhin abgespielt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming needs a connection to your server, which isn't responding right now. Downloaded titles can still be played."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transmisión necesita conexión con tu servidor, que no responde en este momento. Los títulos descargados se pueden seguir reproduciendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le streaming nécessite une connexion à votre serveur, qui ne répond pas pour le moment. Les titres téléchargés restent lisibles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストリーミングにはサーバーへの接続が必要ですが、現在サーバーが応答していません。ダウンロード済みのタイトルは引き続き再生できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O streaming precisa de uma conexão com seu servidor, que não está respondendo no momento. Os títulos baixados ainda podem ser reproduzidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "串流需要连接到你的服务器，但服务器目前没有响应。已下载的内容仍可播放。"
          }
        }
      }
    },
