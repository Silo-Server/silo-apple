    "settingsManifest.player.resume_rewind_seconds.description" : {
      "comment" : "Help text under the player.resume_rewind_seconds setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرجوع هذا القدر عند استئناف عنصر شوهد جزئيًا، لاستعادة السياق. القيمة 0 تعطّل هذا الخيار."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při pokračování v částečně zhlédnuté položce se o tolik přetočí zpět, abyste se znovu zorientovali. Hodnota 0 tuto funkci vypne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spol så langt tilbage, når du genoptager noget, der er delvist set, så du kommer ind i handlingen igen. 0 slår det fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Fortsetzen eines teilweise angesehenen Titels so weit zurückspulen, um wieder in die Handlung zu finden. 0 schaltet es aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip back this far when resuming a partly watched item, to re-establish context. 0 turns it off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrocede esta cantidad al reanudar un elemento visto en parte, para retomar el contexto. Con 0 se desactiva."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelaa näin paljon taaksepäin, kun jatkat osittain katsottua kohdetta, jotta pääset taas juonesta kiinni. 0 poistaa toiminnon käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reculer d’autant lors de la reprise d’un élément partiellement regardé, pour retrouver le fil. 0 désactive cette option."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri nastavku djelomično pogledane stavke vraća se ovoliko unatrag kako biste se prisjetili konteksta. 0 isključuje ovu opciju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna indietro di questo intervallo quando riprendi un titolo visto in parte, per ritrovare il filo. Con 0 è disattivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "途中まで視聴した項目を再開するとき、内容を思い出せるようにこの秒数だけ巻き戻します。0にするとオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 시청한 항목을 이어서 재생할 때 흐름을 다시 파악할 수 있도록 이만큼 뒤로 돌아가요. 0으로 설정하면 꺼져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spol så langt tilbake når du gjenopptar noe du har sett delvis, så du får med deg sammenhengen. 0 slår det av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoel zo ver terug bij het hervatten van een deels bekeken item, zodat je weer in het verhaal komt. 0 schakelt dit uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy wznawianiu częściowo obejrzanej pozycji cofa o tyle, aby przypomnieć kontekst. 0 wyłącza tę funkcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volta esse tanto ao retomar um item assistido em parte, para relembrar o contexto. 0 desativa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При возобновлении частично просмотренного объекта перематывать назад на это время, чтобы восстановить контекст. 0 — выключено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppa tillbaka så här långt när du återupptar något som är delvis sett, för att återfå sammanhanget. 0 stänger av funktionen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısmen izlenmiş bir öğeye devam ederken, nerede kaldığınızı hatırlamanız için bu kadar geri atlar. 0 bu seçeneği kapatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відмотувати назад на цей час під час відновлення частково переглянутого об’єкта, щоб пригадати контекст. 0 вимикає функцію."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续播放看过一部分的内容时，先后退这么多，帮你回忆上下文。设为0则关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繼續播放看到一半的項目時，倒轉這段時間以便銜接劇情。設為 0 則關閉。"
          }
        }
      }
    },
    "settingsManifest.player.resume_rewind_seconds.label" : {
      "comment" : "Label of the player.resume_rewind_seconds setting in settings screens. From the server's settings manifest.",
