    "home.recipe.aclBlank.description" : {
      "comment" : "One-line description of the Editor's Picks preset in the Add row gallery (shared key `home.recipe.aclBlank.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قائمة يرتبها المسؤول عنصرًا بعنصر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ръчно подреден списък, подбран от администратора."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llista triada per l’administració, ordenada element per element."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seznam sestavený správcem, řazený položku po položce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håndplukket liste, sorteret titel for titel af en administrator."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Admin kuratierte, Titel für Titel sortierte Liste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λίστα που επιμελείται ο διαχειριστής, ταξινομημένη στοιχείο προς στοιχείο."
          }
        },
