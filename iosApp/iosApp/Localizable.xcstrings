    "subtitleSearch.pickLanguageNote" : {
      "comment" : "Apple iOS: footer under the language list of the iPhone and iPad subtitle search sheet. Silo is the app name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر لغة وسيبحث Silo لدى مزودي الترجمة عن ترجمات لهذا الفيديو."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете език и Silo ще потърси субтитри за това видео при своите доставчици на субтитри."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria un idioma i Silo cercarà subtítols per a aquest vídeo als seus proveïdors de subtítols."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte jazyk a Silo vyhledá titulky pro toto video u svých poskytovatelů titulků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg et sprog, så søger Silo i sine undertekstudbydere efter denne video."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Sprache, und Silo durchsucht seine Untertitel-Anbieter nach diesem Video."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε μια γλώσσα και το Silo θα αναζητήσει υπότιτλους για αυτό το βίντεο στους παρόχους υπότιτλων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a language and Silo searches its subtitle providers for this video."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un idioma y Silo buscará subtítulos para este video en sus proveedores."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valige keel ja Silo otsib selle video subtiitreid oma subtiitrite teenusepakkujatelt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse kieli, niin Silo etsii tälle videolle tekstityksiä tekstityspalveluistaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une langue et Silo cherchera des sous-titres pour cette vidéo auprès de ses fournisseurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחרי בחירת שפה, Silo מחפש כתוביות לסרטון הזה אצל ספקי הכתוביות שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भाषा चुनें, Silo इस वीडियो के लिए अपने सबटाइटल प्रोवाइडर में खोजेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite jezik i Silo će kod svojih pružatelja titlova potražiti titlove za ovaj videozapis."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válasszon egy nyelvet, és a Silo megkeresi a videóhoz tartozó feliratokat a feliratszolgáltatóinál."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih bahasa, lalu Silo akan mencari subtitel video ini di penyedia subtitelnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una lingua e Silo cercherà i sottotitoli di questo video presso i suoi provider."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語を選択すると、Siloが字幕プロバイダーでこのビデオの字幕を検索します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언어를 선택하면 Silo에서 자막 제공자를 통해 이 동영상의 자막을 검색해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkite kalbą, ir „Silo“ ieškos šio vaizdo įrašo subtitrų per subtitrų teikėjus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvēlieties valodu, un Silo meklēs subtitrus šim video savos subtitru nodrošinātājos."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih bahasa dan Silo akan mencari sari kata untuk video ini daripada pembekal sari katanya."
          }
        },
        "nb" : {
