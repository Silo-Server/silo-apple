    "home.recipe.ffDefault.description" : {
      "comment" : "One-line description of the Forgotten Favorites preset in the Add row gallery (shared key `home.recipe.ffDefault.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بتقييم 7.0+ على TMDB و100 صوت أو أكثر، ولم تُشاهد خلال العام الماضي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка 7.0+ в TMDB и 100+ гласа, без гледане през последната година."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valoració de 7.0+ a TMDB amb 100+ vots, i sense veure en l’últim any."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnocení 7,0+ na TMDB se 100+ hlasy, nesledováno v posledním roce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedømt 7,0+ på TMDB med 100+ stemmer og ikke set det seneste år."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf TMDB mit 7.0+ bewertet, mit 100+ Stimmen und im letzten Jahr nicht geschaut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βαθμολογία 7.0+ στο TMDB με 100+ ψήφους, χωρίς προβολή τον τελευταίο χρόνο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rated 7.0+ on TMDB with 100+ votes, and not watched in the past year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calificación de 7.0+ en TMDB y más de 100 votos, sin ver en el último año."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TMDB hinnang 7.0+, vähemalt 100 häält ja viimase aasta jooksul vaatamata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TMDB-arvio 7.0+ ja vähintään 100 ääntä, eikä katsottu viimeisen vuoden aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note d’au moins 7,0 sur TMDB avec au moins 100 votes, et non regardés depuis un an."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דירוג 7.0+ ב-TMDB עם 100+ הצבעות, ולא נצפו בשנה האחרונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TMDB पर 7.0+ रेटिंग और 100+ वोट, और पिछले एक साल में नहीं देखे गए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocjena 7,0+ na TMDB-u uz 100+ glasova, a niste ih gledali u posljednjih godinu dana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7.0+ értékelés a TMDB-n, 100+ szavazattal, az elmúlt évben nem megtekintve."
          }
        },
        "id" : {
          "stringUnit" : {
