    "player.subtitles.dataLoadFailed" : {
      "comment" : "Apple iOS/tvOS/macOS: message over the video when a styled (ASS/SSA) subtitle track has no readable header.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل بيانات الترجمة. أوقف الترجمة ثم شغّلها لإعادة المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Untertiteldaten konnten nicht geladen werden. Schalte die Untertitel aus und wieder ein, um es erneut zu versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitle data couldn’t be loaded. Turn subtitles off and on to retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar los datos de los subtítulos. Desactiva y vuelve a activar los subtítulos para reintentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les données des sous-titres. Désactivez puis réactivez les sous-titres pour réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕データを読み込めませんでした。字幕をオフにしてからオンにすると、再試行できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar os dados das legendas. Desative e ative as legendas para tentar novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载字幕数据。请关闭字幕后再重新开启以重试。"
          }
        }
      }
    },
    "player.subtitles.deviceStyleNote" : {
      "comment" : "Apple iOS: note under the device settings switches on the Subtitle Appearance page of the iPhone and iPad player settings sheet while Use device settings is on. CC/SDH are caption types.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع لغة التسميات التوضيحية في هذا الجهاز وسلوكها وتفضيل CC/SDH والنمط الكامل من إعدادات تسهيلات الاستخدام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgt der Untertitelsprache, dem Verhalten, der CC/SDH-Präferenz und dem vollständigen Stil dieses Geräts aus den Einstellungen für Bedienungshilfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Following this device's caption language, behavior, CC/SDH preference, and complete style from Accessibility settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usan el idioma de los subtítulos, el comportamiento, la preferencia de CC/SDH y el estilo completo de la configuración de Accesibilidad de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise la langue des sous-titres, le comportement, la préférence CC/SDH et le style complet définis dans les réglages d’accessibilité de cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスのアクセシビリティ設定にある字幕の言語、動作、CC/SDHの設定、スタイル全体に従います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando o idioma, o comportamento, a preferência de CC/SDH e o estilo completo das legendas definidos nas configurações de Acessibilidade deste dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在使用此设备“辅助功能”设置中的字幕语言、行为、CC/SDH偏好和完整样式。"
          }
        }
      }
    },
