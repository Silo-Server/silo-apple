    "collections.error.changedElsewhere" : {
      "comment" : "Apple iOS and tvOS: error in a collection or group sheet when the item changed elsewhere since the sheet opened. Reload is the button below it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر هذا على جهاز آخر. أعد التحميل لرؤية الإصدار الحالي؛ ستُحفظ تعديلاتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това е променено на друго устройство. Презаредете, за да видите текущата версия; редакциите ви се запазват."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això ha canviat en un altre dispositiu. Torna a carregar per veure la versió actual; els teus canvis es conserven."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato položka se změnila na jiném zařízení. Načtěte ji znovu a zobrazte aktuální verzi; vaše úpravy zůstanou zachovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette blev ændret på en anden enhed. Genindlæs for at se den aktuelle version. Dine ændringer bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies wurde auf einem anderen Gerät geändert. Wähle „Neu laden“, um die aktuelle Version anzuzeigen; deine Änderungen bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό άλλαξε σε άλλη συσκευή. Επιλέξτε «Ανανέωση» για να δείτε την τρέχουσα έκδοση. Οι αλλαγές σας διατηρούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This changed on another device. Reload to see the current version; your edits are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto cambió en otro dispositivo. Recarga para ver la versión actual; tus cambios se conservan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seda muudeti teises seadmes. Praeguse versiooni nägemiseks valige „Laadi uuesti“; teie muudatused säilivad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä muutettiin toisella laitteella. Näet nykyisen version valitsemalla Lataa uudelleen. Muokkauksesi säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet élément a été modifié sur un autre appareil. Rechargez pour voir la version actuelle ; vos modifications sont conservées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפריט הזה השתנה במכשיר אחר. אפשר לרענן כדי לראות את הגרסה הנוכחית; העריכות שלך נשמרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे किसी दूसरे डिवाइस पर बदला गया है। मौजूदा वर्शन देखने के लिए फिर से लोड करें; आपके बदलाव बने रहेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo je promijenjeno na drugom uređaju. Ponovno učitajte kako biste vidjeli trenutačnu verziju; vaše se izmjene zadržavaju."
