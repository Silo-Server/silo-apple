    "downloads.settings.qualityPresets" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; second sentence of the quality footer, when seasons and series can also be downloaded in a preset and the server reports no resolutions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجهَّز إعدادات معدل البت المسبقة على الخادم عندما يكون الملف الأصلي أكبر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готовите настройки за битрейт се подготвят на сървъра, когато оригиналът е по-голям."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els valors predefinits de velocitat de bits es preparen al servidor quan l’original és més gran."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předvolby datového toku se připravují na serveru, pokud je originál větší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forvalg for bitrate forberedes på serveren, når originalen er større."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitraten-Voreinstellungen werden auf dem Server vorbereitet, wenn das Original größer ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι προκαθορισμένοι ρυθμοί bit προετοιμάζονται στον διακομιστή όταν το αρχικό αρχείο είναι μεγαλύτερο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitrate presets are prepared on the server when the original is larger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes predefinidos de tasa de bits se preparan en el servidor cuando el original es más grande."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
