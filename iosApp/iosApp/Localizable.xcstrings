          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Browse to see titles matching this tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Explorar para ver los títulos de esta pestaña."
          }
        },
