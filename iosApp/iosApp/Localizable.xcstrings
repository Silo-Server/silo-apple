    "tvPairing.failedGeneric" : {
      "comment" : "Android TV failure message for an unknown error during pairing. {server}: the server name. Apple TV: same message on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدث خطأ أثناء تسجيل الدخول إلى %1$@. حاول مرة أخرى من هاتفك أو جهازك اللوحي، أو أضف الخادم يدويًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při přihlašování k serveru %1$@ se něco pokazilo. Zkuste to znovu z telefonu nebo tabletu, nebo přidejte server ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noget gik galt under login på %1$@. Prøv igen fra din telefon eller tablet, eller tilføj din server manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Anmeldung bei %1$@ ist ein Fehler aufgetreten. Versuche es erneut über dein Smartphone oder Tablet oder füge deinen Server manuell hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong signing in to %1$@. Try again from your phone or tablet, or add your server manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo salió mal al iniciar sesión en %1$@. Vuelve a intentarlo desde tu teléfono o tableta, o añade tu servidor manualmente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjautumisessa palvelimelle %1$@ tapahtui virhe. Yritä uudelleen puhelimesta tai tabletista tai lisää palvelin manuaalisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur s’est produite lors de la connexion à %1$@. Réessayez depuis votre téléphone ou votre tablette, ou ajoutez votre serveur manuellement."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Došlo je do pogreške pri prijavi na poslužitelj %1$@. Pokušajte ponovno s telefona ili tableta ili ručno dodajte svoj poslužitelj."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è verificato un problema durante l’accesso a %1$@. Riprova dal telefono o tablet, oppure aggiungi il server manualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@へのサインイン中に問題が発生しました。スマートフォンまたはタブレットからもう一度お試しいただくか、サーバーを手動で追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 서버에 로그인하는 중에 문제가 발생했어요. 휴대폰이나 태블릿에서 다시 시도하거나 서버를 직접 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noe gikk galt under påloggingen på %1$@. Prøv igjen fra telefonen eller nettbrettet, eller legg til serveren manuelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ging iets mis bij het inloggen bij %1$@. Probeer het opnieuw vanaf je telefoon of tablet, of voeg je server handmatig toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas logowania do serwera %1$@ wystąpił błąd. Spróbuj ponownie z telefonu lub tabletu albo dodaj serwer ręcznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo deu errado ao entrar em %1$@. Tente novamente pelo seu celular ou tablet ou adicione o servidor manualmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При входе на сервер %1$@ произошла ошибка. Повторите попытку с телефона или планшета или добавьте сервер вручную."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något gick fel vid inloggningen på %1$@. Försök igen från din telefon eller surfplatta, eller lägg till servern manuellt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sunucusunda oturum açılırken bir sorun oluştu. Telefonunuzdan veya tabletinizden tekrar deneyin ya da sunucunuzu elle ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час входу на %1$@ сталася помилка. Спробуйте ще раз із телефона або планшета або додайте сервер вручну."
