    "subtitleSearch.pickLanguageNote" : {
      "comment" : "Apple iOS: footer under the language list of the iPhone and iPad subtitle search sheet. Silo is the app name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر لغة وسيبحث Silo لدى مزودي الترجمة عن ترجمات لهذا الفيديو."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte jazyk a Silo vyhledá titulky pro toto video u svých poskytovatelů titulků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg et sprog, så søger Silo i sine undertekstudbydere efter denne video."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Sprache, und Silo durchsucht seine Untertitel-Anbieter nach diesem Video."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a language and Silo searches its subtitle providers for this video."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un idioma y Silo buscará subtítulos para este video en sus proveedores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse kieli, niin Silo etsii tälle videolle tekstityksiä tekstityspalveluistaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une langue et Silo cherchera des sous-titres pour cette vidéo auprès de ses fournisseurs."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite jezik i Silo će kod svojih pružatelja titlova potražiti titlove za ovaj videozapis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una lingua e Silo cercherà i sottotitoli di questo video presso i suoi provider."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語を選択すると、Siloが字幕プロバイダーでこのビデオの字幕を検索します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언어를 선택하면 Silo에서 자막 제공자를 통해 이 동영상의 자막을 검색해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg et språk, så søker Silo hos undertekstleverandørene sine etter denne videoen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een taal en Silo doorzoekt zijn ondertitelproviders voor deze video."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz język, a Silo przeszuka dostawców napisów pod kątem tego wideo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um idioma e o Silo buscará legendas para este vídeo nos provedores de legendas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите язык, и Silo найдёт субтитры для этого видео у своих провайдеров."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj ett språk så söker Silo efter undertexter till den här videon hos sina undertextleverantörer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir dil seçin, Silo bu video için altyazı sağlayıcılarında arama yapsın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть мову, і Silo знайде субтитри для цього відео в постачальників субтитрів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一种语言，Silo会在其字幕提供商中为此视频搜索字幕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇語言後，Silo 會透過字幕提供者為這部影片搜尋字幕。"
          }
        }
      }
    },
