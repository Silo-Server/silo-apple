    "settings.skipIntervals.footerAudiobook" : {
      "comment" : "Android phone and TV. Phone: footer under the audiobook skip intervals group on Settings → Playback. TV: Settings > Playback > Audiobooks: help text under the audiobook skip intervals. Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: footer under the audiobook skip intervals.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدمها أزرار التخطي في مشغّل الكتب الصوتية. تنطبق على كل جهاز مسجّل الدخول إلى هذا الملف الشخصي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá se pro tlačítka přeskočení v přehrávači audioknih. Platí pro všechna zařízení přihlášená k tomuto profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges af lydbogsafspillerens springknapper. Gælder alle enheder, der er logget ind på denne profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betrifft die Sprungtasten des Hörbuch-Players. Gilt für alle Geräte, die mit diesem Profil angemeldet sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used by the audiobook player's skip buttons. Applies to every device signed in to this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa con los botones de salto del reproductor de audiolibros. Se aplica a todos los dispositivos con sesión iniciada en este perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään äänikirjasoittimen siirtopainikkeissa. Koskee kaikkia laitteita, joilla on kirjauduttu tähän profiiliin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisés par les boutons de saut du lecteur de livres audio. S’appliquent à tous les appareils connectés à ce profil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koriste ih gumbi za preskakanje u reproduktoru audioknjiga. Primjenjuje se na sve uređaje prijavljene na ovaj profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usati dai pulsanti di salto del lettore di audiolibri. Valgono per tutti i dispositivi con accesso a questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオブックプレーヤーのスキップボタンで使用します。このプロフィールでサインインしているすべてのデバイスに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오북 플레이어의 건너뛰기 버튼에 사용돼요. 이 프로필로 로그인한 모든 기기에 적용돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes av hoppknappene i lydbokspilleren. Gjelder alle enheter som er logget på denne profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt door de spoelknoppen van de luisterboekspeler. Geldt voor elk apparaat dat bij dit profiel is ingelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane przez przyciski przewijania w odtwarzaczu audiobooków. Dotyczy wszystkich urządzeń zalogowanych w tym profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usados pelos botões de salto do player de audiolivros. Valem para todos os dispositivos conectados a este perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует для кнопок перемотки в плеере аудиокниг. Применяется ко всем устройствам, где выполнен вход в этот профиль."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används av ljudboksspelarens hoppknappar. Gäller alla enheter som är inloggade på den här profilen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli kitap oynatıcısının atlama düğmeleri için kullanılır. Bu profilde oturum açmış tüm cihazlarda geçerlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовується кнопками перемотування в програвачі аудіокниг. Застосовується до всіх пристроїв, на яких виконано вхід у цей профіль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于有声书播放器的跳转按钮。适用于登录此个人资料的所有设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供有聲書播放器的略過按鈕使用。會套用至所有登入此個人檔案的裝置。"
          }
        }
      }
    },
    "settings.skipIntervals.footerVideoApple" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad): footer under the Video skip intervals.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدمها أزرار التخطي على الشاشة والنقر المزدوج ومفاتيح الأسهم ونقرات جهاز التحكم عن بُعد. تنطبق على كل جهاز مسجّل الدخول إلى هذا الملف الشخصي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá se pro tlačítka přeskočení na obrazovce, dvojité klepnutí, šipky a kliknutí na ovladači. Platí pro všechna zařízení přihlášená k tomuto profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges af springknapperne på skærmen, dobbelttryk, piletasterne og klik på fjernbetjeningen. Gælder alle enheder, der er logget ind på denne profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betrifft die Sprungtasten auf dem Bildschirm, Doppeltippen, Pfeiltasten und Klicks auf der Fernbedienung. Gilt für alle Geräte, die mit diesem Profil angemeldet sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used by the on-screen skip buttons, double-tap, arrow keys, and remote clicks. Applies to every device signed in to this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa con los botones de salto en pantalla, el doble toque, las teclas de flecha y los clics del control remoto. Se aplica a todos los dispositivos con sesión iniciada en este perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään näytön siirtopainikkeissa, kaksoisnapautuksessa, nuolinäppäimissä ja kaukosäätimen painalluksissa. Koskee kaikkia laitteita, joilla on kirjauduttu tähän profiiliin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisés par les boutons de saut à l’écran, le double appui, les touches fléchées et les clics de la télécommande. S’appliquent à tous les appareils connectés à ce profil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koriste ih gumbi za preskakanje na zaslonu, dvostruki dodir, tipke sa strelicama i klikovi na daljinskom upravljaču. Primjenjuje se na sve uređaje prijavljene na ovaj profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usati dai pulsanti di salto sullo schermo, dal doppio tocco, dai tasti freccia e dai clic del telecomando. Valgono per tutti i dispositivi con accesso a questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面上のスキップボタン、ダブルタップ、矢印キー、リモコンのクリックで使用します。このプロフィールでサインインしているすべてのデバイスに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면의 건너뛰기 버튼, 두 번 탭, 화살표 키, 리모컨 클릭에 사용돼요. 이 프로필로 로그인한 모든 기기에 적용돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes av hoppknappene på skjermen, dobbelttrykk, piltastene og klikk på fjernkontrollen. Gjelder alle enheter som er logget på denne profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt door de spoelknoppen op het scherm, dubbeltikken, de pijltjestoetsen en klikken op de afstandsbediening. Geldt voor elk apparaat dat bij dit profiel is ingelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane przez przyciski przewijania na ekranie, dwukrotne dotknięcie, klawisze strzałek i kliknięcia pilota. Dotyczy wszystkich urządzeń zalogowanych w tym profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usados pelos botões de salto na tela, pelo toque duplo, pelas teclas de seta e pelos cliques do controle remoto. Valem para todos os dispositivos conectados a este perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует для экранных кнопок перемотки, двойного касания, клавиш со стрелками и нажатий на пульте. Применяется ко всем устройствам, где выполнен вход в этот профиль."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används av hoppknapparna på skärmen, dubbeltryck, piltangenterna och klick på fjärrkontrollen. Gäller alla enheter som är inloggade på den här profilen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekrandaki atlama düğmeleri, çift dokunma, ok tuşları ve kumanda tıklamaları için kullanılır. Bu profilde oturum açmış tüm cihazlarda geçerlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовується екранними кнопками перемотування, подвійним торканням, клавішами зі стрілками й натисканнями на пульті. Застосовується до всіх пристроїв, на яких виконано вхід у цей профіль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于屏幕上的跳转按钮、双击、方向键和遥控器点按。适用于登录此个人资料的所有设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供畫面上的略過按鈕、點兩下、方向鍵和遙控器點按使用。會套用至所有登入此個人檔案的裝置。"
          }
        }
      }
    },
    "settings.skipIntervals.footerVideoAppleTv" : {
      "comment" : "Apple TV Settings > Playback > Video: footer under the skip intervals. Siri Remote is Apple's remote's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدمها النقرات والتمريرات على Siri Remote وأزرار التخطي على الشاشة. تنطبق على كل جهاز مسجّل الدخول إلى هذا الملف الشخصي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá se pro kliknutí a přejetí na ovladači Siri Remote a tlačítka přeskočení na obrazovce. Platí pro všechna zařízení přihlášená k tomuto profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges af klik og swipes på Siri Remote og af springknapperne på skærmen. Gælder alle enheder, der er logget ind på denne profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betrifft Klicks und Wischgesten auf der Siri Remote sowie die Sprungtasten auf dem Bildschirm. Gilt für alle Geräte, die mit diesem Profil angemeldet sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used by clicks and swipes on the Siri Remote and the on-screen skip buttons. Applies to every device signed in to this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa con los clics y deslizamientos en el Siri Remote y con los botones de salto en pantalla. Se aplica a todos los dispositivos con sesión iniciada en este perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään Siri Remoten painalluksissa ja pyyhkäisyissä sekä näytön siirtopainikkeissa. Koskee kaikkia laitteita, joilla on kirjauduttu tähän profiiliin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisés par les clics et les balayages sur la Siri Remote et par les boutons de saut à l’écran. S’appliquent à tous les appareils connectés à ce profil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koriste ih klikovi i prelasci prstom na daljinskom upravljaču Siri Remote te gumbi za preskakanje na zaslonu. Primjenjuje se na sve uređaje prijavljene na ovaj profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usati dai clic e dagli scorrimenti sul Siri Remote e dai pulsanti di salto sullo schermo. Valgono per tutti i dispositivi con accesso a questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri Remoteのクリックとスワイプ、画面上のスキップボタンで使用します。このプロフィールでサインインしているすべてのデバイスに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri Remote의 클릭 및 스와이프와 화면의 건너뛰기 버튼에 사용돼요. 이 프로필로 로그인한 모든 기기에 적용돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes av klikk og sveip på Siri Remote og av hoppknappene på skjermen. Gjelder alle enheter som er logget på denne profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt door klikken en vegen op de Siri Remote en de spoelknoppen op het scherm. Geldt voor elk apparaat dat bij dit profiel is ingelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane przez kliknięcia i przesunięcia na pilocie Siri Remote oraz przyciski przewijania na ekranie. Dotyczy wszystkich urządzeń zalogowanych w tym profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usados pelos cliques e deslizes no Siri Remote e pelos botões de salto na tela. Valem para todos os dispositivos conectados a este perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует для нажатий и смахиваний на пульте Siri Remote и экранных кнопок перемотки. Применяется ко всем устройствам, где выполнен вход в этот профиль."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används av klick och svep på Siri Remote och av hoppknapparna på skärmen. Gäller alla enheter som är inloggade på den här profilen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri Remote’taki tıklama ve kaydırmalar ile ekrandaki atlama düğmeleri için kullanılır. Bu profilde oturum açmış tüm cihazlarda geçerlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовується натисканнями й проведеннями на Siri Remote та екранними кнопками перемотування. Застосовується до всіх пристроїв, на яких виконано вхід у цей профіль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于Siri Remote上的点按和轻扫以及屏幕上的跳转按钮。适用于登录此个人资料的所有设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供 Siri Remote 的點按和滑動，以及畫面上的略過按鈕使用。會套用至所有登入此個人檔案的裝置。"
          }
        }
      }
    },
