    "player.seekInterval.serverUpgrade" : {
      "comment" : "Apple iOS/tvOS/macOS: skip interval settings (video and audiobook skip back/forward); status when the server is too old for the setting.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّث خادم Silo هذا لاختيار فواصل التخطي. يستخدم التشغيل الفواصل المدمجة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновете този сървър Silo, за да избирате интервали на прескачане. Възпроизвеждането използва вградените интервали."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualitza aquest servidor de Silo per triar els intervals de salt. La reproducció utilitza els intervals predeterminats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizujte tento server Silo, abyste mohli vybrat intervaly přeskočení. Přehrávání používá vestavěné intervaly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdater denne Silo-server for at vælge springintervaller. Afspilning bruger de indbyggede intervaller."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere diesen Silo-Server, um Sprungintervalle zu wählen. Die Wiedergabe nutzt die integrierten Intervalle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενημερώστε αυτόν τον διακομιστή Silo για να επιλέξετε διαστήματα μετάβασης. Η αναπαραγωγή χρησιμοποιεί τα ενσωματωμένα διαστήματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update this Silo server to choose skip intervals. Playback uses the built-in intervals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza este servidor de Silo para elegir los intervalos de salto. La reproducción usa los intervalos predeterminados."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hüppeintervallide valimiseks värskendage seda Silo serverit. Esitus kasutab sisseehitatud intervalle."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivitä tämä Silo-palvelin, niin voit valita ohitusvälit. Toisto käyttää sisäänrakennettuja välejä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour ce serveur Silo pour choisir les intervalles de saut. La lecture utilise les intervalles par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
