    "tvPairing.failedUnreachableAppleTv" : {
      "comment" : "Apple TV pairing screen (shown while a nearby phone sets up or signs in this Apple TV): failure body when the Apple TV couldn't reach the server. {server}: the server's name.",
      "extractionState" : "manual",
