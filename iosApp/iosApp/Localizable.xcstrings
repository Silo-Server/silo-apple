          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijk op de tv. Dit wordt bijgewerkt zodra %1$@ het bevestigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź telewizor. Stan zaktualizuje się, gdy serwer %1$@ to potwierdzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
