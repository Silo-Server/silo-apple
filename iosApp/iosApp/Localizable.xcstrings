          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj predugo nije odgovarao. Pokušajte ponovno za trenutak."
          }
        },
        "hu" : {
          "stringUnit" : {
