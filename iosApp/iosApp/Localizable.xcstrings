    "settingsManifest.player.match_frame_rate.description" : {
      "comment" : "Help text under the player.match_frame_rate setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير معدل تحديث الشاشة ليطابق المحتوى قيد التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bildwiederholrate des Displays an den laufenden Inhalt anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch the display refresh rate to match what is playing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la frecuencia de actualización de la pantalla para que coincida con lo que se está reproduciendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adapter la fréquence de rafraîchissement de l’écran au contenu en cours de lecture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生中のコンテンツに合わせてディスプレイのリフレッシュレートを切り替えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muda a taxa de atualização da tela para corresponder ao que está sendo reproduzido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换显示刷新率以匹配正在播放的内容。"
          }
        }
      }
    },
