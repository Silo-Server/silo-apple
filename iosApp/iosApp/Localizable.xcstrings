    "settingsManifest.ui.app_language.description" : {
      "comment" : "Help text under the ui.app_language setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لغة قوائم التطبيق وأزراره ورسائله. منفصلة عن لغات الصوت والترجمة والبيانات الوصفية."
          }
        },
        "de" : {
