        }
      }
    },
    "player.notice.reconnectingBody" : {
      "comment" : "Apple iOS/tvOS/macOS: video player notice text under Reconnecting… while the player reconnects to the server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الاتصال بالخادم. سيُستأنف التشغيل من حيث توقفت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Връзката със сървъра прекъсна. Възпроизвеждането ще продължи оттам, докъдето сте стигнали."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ha perdut la connexió amb el servidor. La reproducció continuarà on l’has deixat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojení k serveru bylo ztraceno. Přehrávání bude pokračovat tam, kde skončilo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen til serveren blev afbrudt. Afspilningen fortsætter, hvor du slap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zum Server wurde unterbrochen. Die Wiedergabe wird dort fortgesetzt, wo du aufgehört hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σύνδεση με τον διακομιστή χάθηκε. Η αναπαραγωγή θα συνεχιστεί από εκεί που σταματήσατε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection to the server was lost. Playback will continue where you left off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perdió la conexión con el servidor. La reproducción continuará donde la dejaste."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ühendus serveriga katkes. Esitus jätkub kohast, kus pooleli jäite."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteys palvelimeen katkesi. Toisto jatkuu siitä, mihin jäit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion au serveur a été perdue. La lecture reprendra là où vous l’avez laissée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיבור לשרת אבד. ההפעלה תימשך מהנקודה שבה הפסקת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर से कनेक्शन टूट गया। प्लेबैक वहीं से जारी रहेगा जहाँ आपने छोड़ा था।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza s poslužiteljem je prekinuta. Reprodukcija će se nastaviti ondje gdje ste stali."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megszakadt a kapcsolat a szerverrel. A lejátszás ott folytatódik, ahol abbahagyta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi ke server terputus. Pemutaran akan dilanjutkan dari posisi terakhir Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione al server si è interrotta. La riproduzione riprenderà da dove l’avevi lasciata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーとの接続が切れました。中断したところから再生を続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버와의 연결이 끊겼어요. 중단한 위치부터 이어서 재생돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryšys su serveriu nutrūko. Atkūrimas bus tęsiamas nuo ten, kur baigėte."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savienojums ar serveri tika zaudēts. Atskaņošana turpināsies no vietas, kur pārtraucāt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungan ke pelayan terputus. Main balik akan diteruskan dari tempat anda berhenti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilkoblingen til serveren ble brutt. Avspillingen fortsetter der du slapp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding met de server is verbroken. Het afspelen gaat verder waar je gebleven was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utracono połączenie z serwerem. Odtwarzanie będzie kontynuowane od miejsca, w którym przerwano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão com o servidor foi perdida. A reprodução continuará de onde você parou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ligação ao servidor perdeu-se. A reprodução vai continuar onde parou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiunea la server s-a pierdut. Redarea va continua de unde ați rămas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение с сервером потеряно. Воспроизведение продолжится с того же места."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojenie so serverom sa prerušilo. Prehrávanie bude pokračovať tam, kde ste prestali."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezava s strežnikom je bila prekinjena. Predvajanje se bo nadaljevalo tam, kjer ste končali."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslutningen till servern bröts. Uppspelningen fortsätter där du slutade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเชื่อมต่อกับเซิร์ฟเวอร์ขาดหาย การเล่นจะดำเนินต่อจากจุดที่ค้างไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu bağlantısı kesildi. Oynatma kaldığınız yerden devam edecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З’єднання із сервером втрачено. Відтворення продовжиться з того місця, де ви зупинилися."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã mất kết nối với máy chủ. Video sẽ phát tiếp từ chỗ bạn dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与服务器的连接已断开。播放将从你上次停止的位置继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與伺服器的連線已中斷。播放將從你上次停止的位置繼續。"
          }
        }
      }
    },
