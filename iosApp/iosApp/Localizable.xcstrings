      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo التحقق مما إذا تم حفظ كلمة المرور الجديدة. حاول مرة أخرى بعد قليل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не можа да провери дали новата ви парола е запазена. Опитайте отново след малко."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no ha pogut comprovar si s’ha desat la contrasenya nova. Torna-ho a provar d’aquí a un moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se ověřit, zda bylo nové heslo uloženo. Za chvíli to zkuste znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke kontrollere, om din nye adgangskode blev gemt. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte nicht prüfen, ob dein neues Passwort gespeichert wurde. Versuche es gleich noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Silo δεν μπόρεσε να ελέγξει αν αποθηκεύτηκε ο νέος κωδικός πρόσβασής σας. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn't check whether your new password was saved. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo comprobar si se guardó tu contraseña nueva. Vuelve a intentarlo en un momento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei saanud kontrollida, kas teie uus parool salvestati. Proovige hetke pärast uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei voinut tarkistaa, tallennettiinko uusi salasanasi. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a pas pu vérifier si votre nouveau mot de passe a été enregistré. Réessayez dans un instant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ל-Silo לא הייתה אפשרות לבדוק אם הסיסמה החדשה נשמרה. אפשר לנסות שוב בעוד רגע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo यह नहीं जाँच सका कि आपका नया पासवर्ड सेव हुआ या नहीं। थोड़ी देर में फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nije mogao provjeriti je li nova lozinka spremljena. Pokušajte ponovno za trenutak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo nem tudta ellenőrizni, hogy az új jelszó mentése megtörtént-e. Próbálja újra egy kis idő múlva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo tidak dapat memeriksa apakah kata sandi baru Anda telah disimpan. Coba lagi sebentar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo non è riuscito a verificare se la nuova password è stata salvata. Riprova tra un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloは新しいパスワードが保存されたかどうかを確認できませんでした。しばらくしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo에서 새 비밀번호가 저장됐는지 확인할 수 없어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Silo“ nepavyko patikrinti, ar naujas slaptažodis išsaugotas. Netrukus bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo neizdevās pārbaudīt, vai jūsu jaunā parole ir saglabāta. Pēc brīža mēģiniet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo tidak dapat menyemak sama ada kata laluan baharu anda telah disimpan. Cuba lagi sebentar lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke kontrollere om det nye passordet ditt ble lagret. Prøv igjen om litt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kan niet controleren of je nieuwe wachtwoord is opgeslagen. Probeer het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Silo nie mogła sprawdzić, czy nowe hasło zostało zapisane. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo não conseguiu verificar se sua nova senha foi salva. Tente novamente em instantes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo não conseguiu verificar se a sua nova palavra-passe foi guardada. Tente novamente daqui a pouco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nu a putut verifica dacă parola nouă a fost salvată. Încercați din nou peste puțin timp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не удалось проверить, сохранён ли новый пароль. Повторите попытку чуть позже."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nedokázalo overiť, či sa nové heslo uložilo. O chvíľu to skúste znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V aplikaciji Silo ni bilo mogoče preveriti, ali je bilo vaše novo geslo shranjeno. Čez trenutek poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunde inte kontrollera om ditt nya lösenord sparades. Försök igen om en stund."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ตรวจสอบไม่ได้ว่าบันทึกรหัสผ่านใหม่แล้วหรือยัง โปรดลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo, yeni parolanızın kaydedilip kaydedilmediğini kontrol edemedi. Birazdan tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не вдалося перевірити, чи збережено ваш новий пароль. Спробуйте ще раз за мить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo không thể kiểm tra mật khẩu mới đã được lưu hay chưa. Vui lòng thử lại sau giây lát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo无法确认你的新密码是否已保存。请稍后重试。"
