          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device family has a more specific subtitle setting. Changes here update the profile default, but the family override still applies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este tipo de dispositivo tiene una configuración de subtítulos más específica. Los cambios aquí actualizan la configuración predeterminada del perfil, pero la del tipo de dispositivo sigue aplicándose."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä laiteryhmällä on tarkempi tekstitysasetus. Täällä tehdyt muutokset päivittävät profiilin oletuksen, mutta laiteryhmän ohitus on edelleen voimassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette famille d’appareils a un paramètre de sous-titres plus spécifique. Les modifications effectuées ici mettent à jour la valeur par défaut du profil, mais le paramètre de la famille s’applique toujours."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova vrsta uređaja ima specifičniju postavku titlova. Promjene ovdje ažuriraju zadanu postavku profila, ali i dalje vrijedi postavka za vrstu uređaja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa famiglia di dispositivi ha un’impostazione dei sottotitoli più specifica. Le modifiche qui aggiornano il valore predefinito del profilo, ma l’impostazione della famiglia resta valida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この種類のデバイスには専用の字幕設定があります。ここでの変更はプロフィールのデフォルトを更新しますが、デバイスの種類の設定が引き続き優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기 유형에 더 구체적인 자막 설정이 있어요. 여기서 변경하면 프로필 기본값이 업데이트되지만, 기기 유형별 설정이 계속 적용돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhetstypen har en mer spesifikk undertekstinnstilling. Endringer her oppdaterer profilens standard, men overstyringen for enhetstypen gjelder fortsatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit type apparaat heeft een specifiekere ondertitelinstelling. Wijzigingen hier passen de standaard van het profiel aan, maar de instelling voor dit apparaattype blijft gelden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta rodzina urządzeń ma bardziej szczegółowe ustawienie napisów. Zmiany tutaj aktualizują domyślne ustawienie profilu, ale nadal obowiązuje ustawienie rodziny urządzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este tipo de dispositivo tem uma configuração de legendas mais específica. As alterações aqui atualizam o padrão do perfil, mas a configuração do tipo de dispositivo continua valendo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этого типа устройств задана более конкретная настройка субтитров. Изменения здесь обновят настройку профиля по умолчанию, но настройка для типа устройств продолжит действовать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enhetstypen har en mer specifik undertextinställning. Ändringar här uppdaterar profilens standardinställning, men enhetstypens åsidosättning gäller fortfarande."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihaz ailesi için daha özel bir altyazı ayarı var. Buradaki değişiklikler profil varsayılanını günceller, ancak cihaz ailesi için geçersiz kılma uygulanmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для цього типу пристроїв є конкретніше налаштування субтитрів. Зміни тут оновлюють типове значення профілю, але перевизначення для типу пристроїв і далі діє."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此类设备有更具体的字幕设置。此处的更改会更新个人资料默认值，但设备类别覆盖设置仍然生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此類裝置有更具體的字幕設定。在這裡所做的變更會更新個人檔案預設值，但此類裝置的覆寫設定仍會套用。"
          }
        }
      }
    },
    "settings.profilePrefs.overrideLibrary" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac, Apple TV): note when a library's own subtitle setting wins over the profile's.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجاوز إعداد ترجمة خاص بالمكتبة هذا الإعداد الافتراضي للملف الشخصي. تُحفظ التغييرات هنا للملف الشخصي، لكن إعداد المكتبة يظل مطبّقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení titulků pro knihovnu má přednost před tímto výchozím nastavením profilu. Změny zde se uloží pro profil, ale nastavení knihovny bude dál platit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En biblioteksspecifik undertekstindstilling tilsidesætter denne profilstandard. Ændringer her gemmes for profilen, men bibliotekets tilsidesættelse gælder stadig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Untertitel-Einstellung für eine Mediathek hat Vorrang vor diesem Profilstandard. Änderungen hier werden für das Profil gespeichert, die Einstellung der Mediathek gilt aber weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A library-specific subtitle setting overrides this profile default. Changes here are saved for the profile, but the library override still applies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una configuración de subtítulos específica de la biblioteca prevalece sobre esta configuración predeterminada del perfil. Los cambios aquí se guardan para el perfil, pero la de la biblioteca sigue aplicándose."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjastokohtainen tekstitysasetus ohittaa tämän profiilin oletuksen. Täällä tehdyt muutokset tallennetaan profiiliin, mutta kirjaston ohitus on edelleen voimassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paramètre de sous-titres propre à une bibliothèque remplace cette valeur par défaut du profil. Les modifications effectuées ici sont enregistrées pour le profil, mais le paramètre de la bibliothèque s’applique toujours."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavka titlova za medijateku nadjačava ovu zadanu postavku profila. Promjene ovdje spremaju se za profil, ali i dalje vrijedi postavka medijateke."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’impostazione dei sottotitoli specifica della libreria ha la precedenza su questo valore predefinito del profilo. Le modifiche qui vengono salvate per il profilo, ma l’impostazione della libreria resta valida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリ専用の字幕設定が、このプロフィールのデフォルトより優先されます。ここでの変更はプロフィールに保存されますが、ライブラリの設定が引き続き優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리별 자막 설정이 이 프로필 기본값보다 우선해요. 여기서 변경한 내용은 프로필에 저장되지만, 라이브러리별 설정이 계속 적용돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bibliotekspesifikk undertekstinnstilling overstyrer profilens standard. Endringer her lagres for profilen, men bibliotekoverstyringen gjelder fortsatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ondertitelinstelling voor een specifieke bibliotheek gaat voor deze profielstandaard. Wijzigingen hier worden voor het profiel opgeslagen, maar de bibliotheekinstelling blijft gelden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienie napisów dla biblioteki zastępuje domyślne ustawienie profilu. Zmiany tutaj są zapisywane w profilu, ale nadal obowiązuje ustawienie biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma configuração de legendas específica da biblioteca substitui este padrão do perfil. As alterações aqui são salvas no perfil, mas a configuração da biblioteca continua valendo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройка субтитров для медиатеки переопределяет настройку профиля по умолчанию. Изменения здесь сохранятся для профиля, но настройка медиатеки продолжит действовать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En biblioteksspecifik undertextinställning åsidosätter profilens standardinställning. Ändringar här sparas för profilen, men bibliotekets åsidosättning gäller fortfarande."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitaplığa özel bir altyazı ayarı bu profil varsayılanını geçersiz kılıyor. Buradaki değişiklikler profil için kaydedilir, ancak kitaplık için geçersiz kılma uygulanmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштування субтитрів для бібліотеки перевизначає типове значення профілю. Зміни тут зберігаються для профілю, але перевизначення для бібліотеки й далі діє."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒体库专属的字幕设置会覆盖此个人资料默认值。此处的更改会保存到个人资料，但媒体库覆盖设置仍然生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒體庫專屬的字幕設定會覆寫此個人檔案預設值。在這裡所做的變更會儲存至個人檔案，但媒體庫的覆寫設定仍會套用。"
          }
        }
      }
    },
