    "player.notice.liveSubtitlesPreparing" : {
      "comment" : "Apple iOS/tvOS/macOS: video player notice text under Preparing subtitles while AI subtitles are generated.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ إنشاء الترجمة للمشهد الحالي — سيُستأنف التشغيل بعد لحظات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Генерират се субтитри за текущата сцена – възпроизвеждането ще продължи след малко."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’estan generant subtítols per a l’escena actual — la reproducció es reprendrà d’aquí a un moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generují se titulky pro aktuální scénu — přehrávání bude za chvíli pokračovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genererer undertekster til den aktuelle scene — afspilningen fortsætter om et øjeblik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel für die aktuelle Szene werden erstellt – die Wiedergabe wird gleich fortgesetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργία υποτίτλων για την τρέχουσα σκηνή – η αναπαραγωγή θα συνεχιστεί σε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generating subtitles for the current scene — playback resumes in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generando subtítulos para la escena actual: la reproducción se reanudará en un momento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praeguse stseeni subtiitrite loomine – esitus jätkub kohe."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luodaan tekstitystä nykyiselle kohtaukselle – toisto jatkuu hetken kuluttua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Génération des sous-titres pour la scène en cours — la lecture reprend dans un instant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתבצעת יצירת כתוביות לסצנה הנוכחית – ההפעלה תימשך בעוד רגע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा सीन के लिए सबटाइटल बनाए जा रहे हैं — प्लेबैक थोड़ी देर में फिर से शुरू होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generiranje titlova za trenutačnu scenu — reprodukcija se nastavlja za trenutak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feliratok készítése az aktuális jelenethez – a lejátszás hamarosan folytatódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuat subtitel untuk adegan saat ini — pemutaran akan dilanjutkan sebentar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
