    "settings.playback.hdrFooter" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: first sentence of the Streaming footer, explaining the HDR switch. SDR is standard dynamic range.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تعطيل HDR، تُرسَل مقاطع الفيديو التي يحوّلها الخادم لهذا الجهاز بتنسيق SDR، دون Dolby Vision."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn HDR aus ist, werden Videos, die der Server für dieses Gerät umwandelt, in SDR ohne Dolby Vision gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With HDR off, videos the server converts for this device are sent in SDR, without Dolby Vision."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con HDR desactivado, los videos que el servidor convierte para este dispositivo se envían en SDR, sin Dolby Vision."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le HDR désactivé, les vidéos que le serveur convertit pour cet appareil sont envoyées en SDR, sans Dolby Vision."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRをオフにすると、サーバーがこのデバイス向けに変換する動画はDolby VisionなしのSDRで送信されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com HDR desativado, os vídeos que o servidor converte para este dispositivo são enviados em SDR, sem Dolby Vision."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭HDR后，服务器为此设备转换的视频将以SDR发送，不含Dolby Vision。"
          }
        }
      }
    },
    "settings.playback.hdrFooterOriginal" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac): sentence after the HDR explanation in the Streaming footer.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظل بإمكان مقاطع الفيديو التي تُشغَّل من الملف الأصلي أن تُعرض بتنسيق HDR."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos, die aus der Originaldatei abgespielt werden, können weiterhin in HDR laufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos that play from the original file can still play in HDR."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los videos que se reproducen desde el archivo original pueden seguir reproduciéndose en HDR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vidéos lues depuis le fichier original peuvent toujours être lues en HDR."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のファイルから再生される動画は、引き続きHDRで再生できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeos reproduzidos a partir do arquivo original ainda podem ser exibidos em HDR."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从原始文件播放的视频仍可以HDR播放。"
          }
        }
      }
    },
    "settings.playback.hdrFooterOriginalAppleTv" : {
      "comment" : "Apple TV Settings > Playback: sentence after the HDR explanation in the Streaming footer.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظل بإمكان مقاطع الفيديو التي تُشغَّل من الملف الأصلي أن تُعرض بتنسيق HDR، ويظل بإمكان التلفزيون التبديل إلى HDR من أجلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos, die aus der Originaldatei abgespielt werden, können weiterhin in HDR laufen, und der Fernseher kann für sie weiterhin auf HDR umschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos that play from the original file can still play in HDR, and the TV can still switch to HDR for them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los videos que se reproducen desde el archivo original pueden seguir reproduciéndose en HDR, y la TV puede seguir cambiando a HDR para ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vidéos lues depuis le fichier original peuvent toujours être lues en HDR, et la TV peut toujours passer en HDR pour elles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のファイルから再生される動画は、引き続きHDRで再生でき、テレビもHDRに切り替わります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeos reproduzidos a partir do arquivo original ainda podem ser exibidos em HDR, e a TV ainda pode mudar para HDR para eles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从原始文件播放的视频仍可以HDR播放，电视也仍可为其切换到HDR。"
          }
        }
      }
    },
