        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trailers were checked recently"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tráileres se buscaron hace poco"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treilereid kontrolliti hiljuti"
          }
