    "settings.playback.surroundFooter" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: sentence in the Streaming footer. Lossless Multichannel Audio is the switch's name above it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا شُغّل الصوت المحيطي كصوت ستيريو، فعطّل «صوت متعدد القنوات بلا فقدان»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако съраунд звукът се възпроизвежда като стерео, изключете опцията „Многоканално аудио без загуби“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el so envolvent es reprodueix en estèreo, desactiva Àudio multicanal sense pèrdua."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud se prostorový zvuk přehrává jako stereo, vypněte „Bezztrátový vícekanálový zvuk“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis surround afspilles som stereo, skal du slå Tabsfri flerkanalslyd fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Surround als Stereo wiedergegeben wird, schalte „Verlustfreier Mehrkanalton“ aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν ο ήχος surround αναπαράγεται ως στερεοφωνικός, απενεργοποιήστε την επιλογή «Πολυκαναλικός ήχος χωρίς απώλειες»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If surround plays as stereo, turn off Lossless Multichannel Audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el sonido envolvente se reproduce en estéreo, desactiva Audio multicanal sin pérdida."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui ruumiline heli esitatakse stereona, lülitage välja valik „Kadudeta mitmekanaliline heli“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos tilaääni toistuu stereona, poista Häviötön monikanavaääni käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le son surround est lu en stéréo, désactivez Audio multicanal sans perte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם שמע היקפי מושמע כסטריאו, יש לכבות את האפשרות ”שמע רב-ערוצי ללא אובדן”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर सराउंड ऑडियो स्टीरियो में चलता है, तो लॉसलेस मल्टीचैनल ऑडियो बंद करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako se surround reproducira kao stereo, isključite Višekanalni zvuk bez gubitaka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a térhatású hang sztereóként szól, kapcsolja ki a Veszteségmentes többcsatornás hang lehetőséget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika surround diputar sebagai stereo, nonaktifkan Audio multikanal lossless."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il surround viene riprodotto in stereo, disattiva Audio multicanale lossless."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サラウンドがステレオで再生される場合は、ロスレスマルチチャンネルオーディオをオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서라운드가 스테레오로 재생되면 무손실 멀티채널 오디오를 끄세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jei erdvinis garsas leidžiamas kaip stereo, išjunkite parinktį „Daugiakanalis garsas be nuostolių“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja telpiskā skaņa tiek atskaņota kā stereo, izslēdziet opciju „Daudzkanālu audio bez zudumiem”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika bunyi keliling dimainkan sebagai stereo, matikan Audio berbilang saluran tanpa kehilangan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis surround spilles av som stereo, slå av Tapsfri flerkanalslyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als surround als stereo wordt afgespeeld, zet Lossless meerkanaalsaudio dan uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli dźwięk przestrzenny jest odtwarzany jako stereo, wyłącz opcję „Bezstratny dźwięk wielokanałowy”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o som surround for reproduzido em estéreo, desative Áudio multicanal sem perdas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o som surround for reproduzido em estéreo, desative Áudio multicanal sem perdas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă sunetul surround se redă stereo, dezactivați Audio multicanal fără pierderi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если объёмный звук воспроизводится как стерео, выключите параметр «Многоканальный звук без потерь»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak sa priestorový zvuk prehráva ako stereo, vypnite možnosť Bezstratový viackanálový zvuk."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če se prostorski zvok predvaja kot stereo, izklopite možnost Večkanalni zvok brez izgub."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om surroundljud spelas upp som stereo, stäng av Förlustfritt flerkanalsljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากเสียงรอบทิศทางเล่นเป็นสเตอริโอ ให้ปิด “เสียงหลายช่องแบบไม่สูญเสียคุณภาพ”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevresel ses stereo olarak oynatılıyorsa “Kayıpsız çok kanallı ses” seçeneğini kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо об’ємний звук відтворюється як стерео, вимкніть «Багатоканальний звук без втрат»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu âm thanh vòm phát dưới dạng stereo, hãy tắt Âm thanh đa kênh không suy hao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果环绕声以立体声播放，请关闭无损多声道音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果環繞音效以立體聲播放，請關閉「無損多聲道音訊」。"
          }
        }
      }
    },
