    "diagnostics.availability.offlineDetail" : {
      "comment" : "Footer under the Diagnostics settings Feature State section when the server is offline. Shown on Android phone and Apple (iPhone, iPad).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم عرض آخر حالة معروفة للتشخيص. تبقى التقارير على هذا الجهاز ما دام الخادم غير متصل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показва се последното известно състояние на диагностиката. Отчетите остават на това устройство, докато сървърът е офлайн."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es mostra l’últim estat de diagnòstic conegut. Els informes es queden en aquest dispositiu mentre el servidor no té connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje se poslední známý stav diagnostiky. Zprávy zůstávají v tomto zařízení, dokud je server offline."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser den senest kendte diagnosticeringstilstand. Rapporter bliver på denne enhed, mens serveren er offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der zuletzt bekannte Diagnosestatus wird angezeigt. Berichte bleiben auf diesem Gerät, solange der Server offline ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζεται η τελευταία γνωστή κατάσταση διαγνωστικών. Οι αναφορές παραμένουν σε αυτή τη συσκευή όσο ο διακομιστής είναι εκτός σύνδεσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Showing the last known diagnostics state. Reports stay on this device while the server is offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra el último estado conocido de los diagnósticos. Los informes permanecen en este dispositivo mientras el servidor está sin conexión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvatakse viimane teadaolev diagnostika olek. Kui server on võrguühenduseta, jäävad aruanded sellesse seadmesse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
