    "watchParty.hero.waitingCaption" : {
      "comment" : "Roku: caption under the guests' waiting headline in the lobby. {host}: the host's display name. Apple (iPhone, iPad, Apple TV): same caption in the lobby. Android phone and TV Watch Party lobby: same line under a guest's heading. 1: the host's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يختار %1$@ ما ستشاهدونه. سيظهر هنا فور اختياره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wählt aus, was geschaut wird. Du siehst es hier, sobald die Wahl getroffen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is choosing what to watch. You'll see it here the moment they do."
          }
