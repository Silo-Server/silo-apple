        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报告已保留，但无法上传到此服务器。"
          }
        }
      }
    },
    "diagnostics.notice.keptServerUpdate" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: the user's Silo server is too old to accept the report; it stays on the device.",
      "extractionState" : "manual",
      "localizations" : {
