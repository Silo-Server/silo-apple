    "settings.profileLaunch.automatic.detailAppleTv" : {
      "comment" : "Apple TV Settings > General > Profile Selection: explanation under the Automatic choice. The Apple TV user is the person signed in to tvOS. A protected profile is one with a PIN.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام الملف الشخصي المختار لمستخدم Apple TV الحالي. قد يُفتح الملف الشخصي المحمي مجددًا دون طلب رمز PIN الخاص به."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použít profil vybraný pro aktuálního uživatele Apple TV. Chráněný profil se může znovu otevřít bez zadání PINu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug den profil, der er valgt til den aktuelle Apple TV-bruger. En beskyttet profil kan åbnes igen uden at bede om dens PIN-kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet das für den aktuellen Apple TV-Benutzer gewählte Profil. Ein geschütztes Profil kann sich ohne PIN-Abfrage wieder öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the profile selected for the current Apple TV user. A protected profile can reopen without asking for its PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el perfil seleccionado para el usuario actual del Apple TV. Un perfil protegido puede volver a abrirse sin pedir su PIN."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä nykyiselle Apple TV -käyttäjälle valittua profiilia. Suojattu profiili voi avautua uudelleen kysymättä PIN-koodia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le profil sélectionné pour l’utilisateur actuel de l’Apple TV. Un profil protégé peut se rouvrir sans demander son PIN."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi profil odabran za trenutačnog korisnika uređaja Apple TV. Zaštićeni profil može se ponovno otvoriti bez traženja PIN-a."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il profilo selezionato per l’utente Apple TV attuale. Un profilo protetto può riaprirsi senza chiedere il PIN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のApple TVユーザーに選択されたプロフィールを使用します。保護されたプロフィールも、PINを求めずに再び開くことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 Apple TV 사용자에게 선택된 프로필을 사용해요. 보호된 프로필도 PIN을 묻지 않고 다시 열릴 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk profilen som er valgt for den nåværende Apple TV-brukeren. En beskyttet profil kan åpnes igjen uten å be om PIN-koden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik het profiel dat voor de huidige Apple TV-gebruiker is gekozen. Een beveiligd profiel kan opnieuw openen zonder om de PIN te vragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj profilu wybranego dla bieżącego użytkownika Apple TV. Chroniony profil może się otworzyć bez pytania o PIN."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o perfil selecionado para o usuário atual da Apple TV. Um perfil protegido pode abrir novamente sem pedir o PIN."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать профиль, выбранный для текущего пользователя Apple TV. Защищённый профиль может открыться без запроса PIN."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd den profil som valts för den aktuella Apple TV-användaren. En skyddad profil kan öppnas igen utan att PIN-koden efterfrågas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli Apple TV kullanıcısı için seçilen profil kullanılır. Korumalı bir profil PIN sorulmadan yeniden açılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовувати профіль, вибраний для поточного користувача Apple TV. Захищений профіль може відкритися знову без запиту PIN-коду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用为当前Apple TV用户选择的个人资料。受保护的个人资料可能无需输入PIN即可重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用目前 Apple TV 使用者所選的個人檔案。受保護的個人檔案可能會在不要求輸入 PIN 的情況下重新開啟。"
          }
        }
      }
    },
    "settings.profileLaunch.automatic.detailPhone" : {
      "comment" : "Explanation under the Automatic choice in Settings > Profile Selection on Android phone and Apple (iPhone, iPad, Mac). A protected profile is one with a PIN.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام آخر ملف شخصي تم اختياره على هذا الجهاز. قد يُفتح الملف الشخصي المحمي مجددًا دون طلب رمز PIN الخاص به."
