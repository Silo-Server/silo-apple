    "newProfile.error.library" : {
      "comment" : "Body of the Roku validation dialog shown when a child profile is restricted to libraries but none is selected. Apple (iPhone, iPad, Mac, Apple TV): same alert body on the New Profile form.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مكتبة واحدة على الأقل لهذا الملف الشخصي للأطفال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
