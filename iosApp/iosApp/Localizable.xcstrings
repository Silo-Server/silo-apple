    "downloads.error.monitoringUncertain" : {
      "comment" : "Apple iOS/macOS: error message in the series download sheet when the connection dropped while saving monitoring.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo تأكيد تغيير المراقبة. تحقّق من هذا المسلسل مرة أخرى عند عودتك إلى الاتصال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikaci Silo se nepodařilo potvrdit změnu sledování. Až budete znovu online, zkontrolujte tento seriál."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke bekræfte ændringen af overvågningen. Tjek serien igen, når du er online igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte die Änderung der Überwachung nicht bestätigen. Prüfe diese Serie erneut, sobald du wieder online bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn't confirm the monitoring change. Check this series again once you're back online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo confirmar el cambio de supervisión. Vuelve a revisar esta serie cuando tengas conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei voinut vahvistaa seurannan muutosta. Tarkista tämä sarja uudelleen, kun olet taas verkossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a pas pu confirmer la modification du suivi. Vérifiez à nouveau cette série une fois de retour en ligne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nije mogao potvrditi promjenu praćenja. Ponovno provjerite ovu seriju kada se vratite na mrežu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo non ha potuto confermare la modifica del monitoraggio. Controlla di nuovo questa serie quando torni online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloは監視設定の変更を確認できませんでした。オンラインに戻ったら、このシリーズをもう一度確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo에서 모니터링 변경 사항을 확인하지 못했어요. 다시 온라인 상태가 되면 이 시리즈를 다시 확인해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke bekrefte endringen i overvåkingen. Sjekk denne serien igjen når du er på nett igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kan de wijziging in het volgen niet bevestigen. Controleer deze serie opnieuw zodra je weer online bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się potwierdzić zmiany monitorowania. Sprawdź ten serial ponownie po powrocie do sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo não conseguiu confirmar a alteração no monitoramento. Verifique esta série novamente quando estiver on-line."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не удалось подтвердить изменение отслеживания. Проверьте этот сериал ещё раз, когда вернётесь в сеть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunde inte bekräfta ändringen av bevakningen. Kontrollera serien igen när du är online."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo takip değişikliğini doğrulayamadı. Tekrar çevrimiçi olduğunuzda bu diziyi yeniden kontrol edin."
