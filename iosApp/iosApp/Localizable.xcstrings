    "settingsManifest.playback.cellular_preferred_quality.description" : {
      "comment" : "Help text under the playback.cellular_preferred_quality setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الدقة المستخدمة للتشغيل على بيانات الجوال أو أي اتصال محدود آخر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резолюцията за възпроизвеждане при мобилни данни или друга връзка с отчитане на трафика."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La resolució de reproducció amb dades mòbils o una altra connexió de tarifa per ús."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozlišení pro přehrávání na mobilních datech nebo jiném měřeném připojení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den opløsning, der afspilles i på mobildata eller en anden forbindelse med dataforbrug."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Auflösung für die Wiedergabe über mobile Daten oder eine andere getaktete Verbindung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ανάλυση αναπαραγωγής μέσω δεδομένων κινητής ή άλλης σύνδεσης με χρέωση βάσει χρήσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The resolution to play at on mobile data or another metered connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La resolución de reproducción con datos móviles u otra conexión medida."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eraldusvõime, millega esitada mobiilse andmeside või muu mahupõhise ühenduse kaudu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resoluutio, jolla toistetaan mobiilidatalla tai muulla käytön mukaan laskutettavalla yhteydellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La résolution de lecture en données mobiles ou sur une autre connexion limitée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרזולוציה להפעלה בחבילת גלישה או בחיבור מוגבל אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मोबाइल डेटा या किसी अन्य मीटर्ड कनेक्शन पर प्लेबैक का रिज़ॉल्यूशन।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezolucija reprodukcije na mobilnim podacima ili drugoj naplatnoj vezi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lejátszás felbontása mobilinternet vagy más forgalomkorlátos kapcsolat esetén."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolusi pemutaran pada data seluler atau koneksi terukur lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La risoluzione di riproduzione con la rete dati mobile o un’altra connessione a consumo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モバイルデータ通信などの従量制接続で再生する解像度です。"
