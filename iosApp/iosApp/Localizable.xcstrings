    "player.subtitles.dataLoadFailed" : {
      "comment" : "Apple iOS/tvOS/macOS: message over the video when a styled (ASS/SSA) subtitle track has no readable header.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل بيانات الترجمة. أوقف الترجمة ثم شغّلها لإعادة المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данните за субтитрите не можаха да се заредят. Изключете и включете субтитрите, за да опитате отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’han pogut carregar les dades dels subtítols. Desactiva i torna a activar els subtítols per tornar-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data titulků se nepodařilo načíst. Zkuste to znovu vypnutím a zapnutím titulků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undertekstdata kunne ikke indlæses. Slå undertekster fra og til igen for at prøve igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Untertiteldaten konnten nicht geladen werden. Schalte die Untertitel aus und wieder ein, um es erneut zu versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η φόρτωση των δεδομένων υποτίτλων. Απενεργοποιήστε και ενεργοποιήστε ξανά τους υπότιτλους για νέα προσπάθεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitle data couldn’t be loaded. Turn subtitles off and on to retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar los datos de los subtítulos. Desactiva y vuelve a activar los subtítulos para reintentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtiitrite andmeid ei õnnestunud laadida. Uuesti proovimiseks lülitage subtiitrid välja ja uuesti sisse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstitystietoja ei voitu ladata. Yritä uudelleen kytkemällä tekstitys pois ja takaisin päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les données des sous-titres. Désactivez puis réactivez les sous-titres pour réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לטעון את נתוני הכתוביות. כדי לנסות שוב, יש לכבות את הכתוביות ולהפעיל אותן מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबटाइटल का डेटा लोड नहीं किया जा सका। फिर से कोशिश करने के लिए सबटाइटल बंद करके फिर चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podatke titlova nije moguće učitati. Isključite i ponovno uključite titlove da biste pokušali ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült betölteni a feliratadatokat. Az újrapróbáláshoz kapcsolja ki, majd be a feliratokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data subtitel tidak dapat dimuat. Nonaktifkan lalu aktifkan kembali subtitel untuk mencoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare i dati dei sottotitoli. Disattiva e riattiva i sottotitoli per riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕データを読み込めませんでした。字幕をオフにしてからオンにすると、再試行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자막 데이터를 불러올 수 없어요. 자막을 껐다가 다시 켜서 다시 시도하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko įkelti subtitrų duomenų. Išjunkite ir vėl įjunkite subtitrus, kad bandytumėte dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās ielādēt subtitru datus. Lai mēģinātu vēlreiz, izslēdziet un ieslēdziet subtitrus."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data sari kata tidak dapat dimuatkan. Matikan dan hidupkan sari kata untuk mencuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke laste inn undertekstdataene. Slå undertekster av og på for å prøve igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de ondertitelgegevens niet laden. Zet ondertitels uit en weer aan om het opnieuw te proberen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wczytać danych napisów. Wyłącz i włącz napisy, aby spróbować ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar os dados das legendas. Desative e ative as legendas para tentar novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar os dados das legendas. Desative e volte a ativar as legendas para tentar novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele subtitrărilor nu au putut fi încărcate. Dezactivați și reactivați subtitrările pentru a reîncerca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить данные субтитров. Выключите и снова включите субтитры, чтобы повторить попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Údaje titulkov sa nepodarilo načítať. Ak to chcete skúsiť znova, vypnite a znova zapnite titulky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podatkov podnapisov ni bilo mogoče naložiti. Izklopite in znova vklopite podnapise, da poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att läsa in undertextdata. Stäng av och slå på undertexter för att försöka igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหลดข้อมูลคำบรรยายไม่ได้ ปิดแล้วเปิดคำบรรยายอีกครั้งเพื่อลองใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altyazı verileri yüklenemedi. Yeniden denemek için altyazıları kapatıp açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося завантажити дані субтитрів. Вимкніть і знову ввімкніть субтитри, щоб повторити спробу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể tải dữ liệu phụ đề. Tắt rồi bật lại phụ đề để thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载字幕数据。请关闭字幕后再重新开启以重试。"
