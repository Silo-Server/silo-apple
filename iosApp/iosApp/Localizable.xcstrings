    "settings.playback.hdrFooter" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: first sentence of the Streaming footer, explaining the HDR switch. SDR is standard dynamic range.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تعطيل HDR، تُرسَل مقاطع الفيديو التي يحوّلها الخادم لهذا الجهاز بتنسيق SDR، دون Dolby Vision."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je HDR vypnuto, videa, která server pro toto zařízení převádí, se odesílají v SDR, bez Dolby Vision."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med HDR slået fra sendes videoer, som serveren konverterer til denne enhed, i SDR uden Dolby Vision."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn HDR aus ist, werden Videos, die der Server für dieses Gerät umwandelt, in SDR ohne Dolby Vision gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With HDR off, videos the server converts for this device are sent in SDR, without Dolby Vision."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con HDR desactivado, los videos que el servidor convierte para este dispositivo se envían en SDR, sin Dolby Vision."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun HDR on pois, videot, jotka palvelin muuntaa tälle laitteelle, lähetetään SDR-muodossa ilman Dolby Visionia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le HDR désactivé, les vidéos que le serveur convertit pour cet appareil sont envoyées en SDR, sans Dolby Vision."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je HDR isključen, videozapisi koje poslužitelj pretvara za ovaj uređaj šalju se u SDR-u, bez Dolby Visiona."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con HDR disattivato, i video che il server converte per questo dispositivo vengono inviati in SDR, senza Dolby Vision."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRをオフにすると、サーバーがこのデバイス向けに変換する動画はDolby VisionなしのSDRで送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR을 끄면 서버가 이 기기용으로 변환하는 동영상은 Dolby Vision 없이 SDR로 전송돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med HDR av sendes videoer som serveren konverterer for denne enheten, i SDR, uten Dolby Vision."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met HDR uit worden video’s die de server voor dit apparaat omzet in SDR verzonden, zonder Dolby Vision."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy HDR jest wyłączony, filmy konwertowane przez serwer dla tego urządzenia są wysyłane w SDR, bez Dolby Vision."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com HDR desativado, os vídeos que o servidor converte para este dispositivo são enviados em SDR, sem Dolby Vision."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если HDR выключен, видео, которые сервер преобразует для этого устройства, передаются в SDR без Dolby Vision."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med HDR av skickas videor som servern konverterar för den här enheten i SDR, utan Dolby Vision."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR kapalıyken sunucunun bu cihaz için dönüştürdüğü videolar Dolby Vision olmadan SDR olarak gönderilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо HDR вимкнено, відео, які сервер конвертує для цього пристрою, надсилаються в SDR, без Dolby Vision."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭HDR后，服务器为此设备转换的视频将以SDR发送，不含Dolby Vision。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉 HDR 時，伺服器為此裝置轉換的影片會以 SDR 傳送，不含 Dolby Vision。"
          }
        }
      }
    },
    "settings.playback.hdrFooterOriginal" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac): sentence after the HDR explanation in the Streaming footer.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظل بإمكان مقاطع الفيديو التي تُشغَّل من الملف الأصلي أن تُعرض بتنسيق HDR."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videa přehrávaná z původního souboru se i tak mohou přehrát v HDR."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoer, der afspilles fra den originale fil, kan stadig afspilles i HDR."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos, die aus der Originaldatei abgespielt werden, können weiterhin in HDR laufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos that play from the original file can still play in HDR."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los videos que se reproducen desde el archivo original pueden seguir reproduciéndose en HDR."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkuperäisestä tiedostosta toistettavat videot voivat silti toistua HDR-muodossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vidéos lues depuis le fichier original peuvent toujours être lues en HDR."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videozapisi koji se reproduciraju iz izvorne datoteke i dalje se mogu reproducirati u HDR-u."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I video riprodotti dal file originale possono comunque essere riprodotti in HDR."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のファイルから再生される動画は、引き続きHDRで再生できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 파일로 재생하는 동영상은 계속 HDR로 재생할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoer som spilles av fra originalfilen, kan fortsatt spilles av i HDR."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video’s die vanuit het originele bestand worden afgespeeld, kunnen nog steeds in HDR worden afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmy odtwarzane z oryginalnego pliku mogą nadal być odtwarzane w HDR."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeos reproduzidos a partir do arquivo original ainda podem ser exibidos em HDR."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видео, воспроизводимые из исходного файла, по-прежнему могут идти в HDR."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videor som spelas upp från originalfilen kan fortfarande spelas upp i HDR."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinal dosyadan oynatılan videolar yine de HDR olarak oynatılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відео, що відтворюються з оригінального файлу, усе одно можуть відтворюватися в HDR."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从原始文件播放的视频仍可以HDR播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從原始檔案播放的影片仍可以 HDR 播放。"
          }
        }
      }
    },
    "settings.playback.hdrFooterOriginalAppleTv" : {
      "comment" : "Apple TV Settings > Playback: sentence after the HDR explanation in the Streaming footer.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظل بإمكان مقاطع الفيديو التي تُشغَّل من الملف الأصلي أن تُعرض بتنسيق HDR، ويظل بإمكان التلفزيون التبديل إلى HDR من أجلها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videa přehrávaná z původního souboru se i tak mohou přehrát v HDR a televize se pro ně stále může přepnout do HDR."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoer, der afspilles fra den originale fil, kan stadig afspilles i HDR, og tv’et kan stadig skifte til HDR for dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos, die aus der Originaldatei abgespielt werden, können weiterhin in HDR laufen, und der Fernseher kann für sie weiterhin auf HDR umschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos that play from the original file can still play in HDR, and the TV can still switch to HDR for them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los videos que se reproducen desde el archivo original pueden seguir reproduciéndose en HDR, y la TV puede seguir cambiando a HDR para ellos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkuperäisestä tiedostosta toistettavat videot voivat silti toistua HDR-muodossa, ja tv voi silti vaihtaa niitä varten HDR-tilaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vidéos lues depuis le fichier original peuvent toujours être lues en HDR, et la TV peut toujours passer en HDR pour elles."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videozapisi koji se reproduciraju iz izvorne datoteke i dalje se mogu reproducirati u HDR-u, a TV se za njih i dalje može prebaciti u HDR."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I video riprodotti dal file originale possono comunque essere riprodotti in HDR, e la TV può comunque passare in HDR per questi video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のファイルから再生される動画は、引き続きHDRで再生でき、テレビもHDRに切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 파일로 재생하는 동영상은 계속 HDR로 재생할 수 있고, TV도 해당 동영상에 맞춰 HDR로 전환할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoer som spilles av fra originalfilen, kan fortsatt spilles av i HDR, og TV-en kan fortsatt bytte til HDR for dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video’s die vanuit het originele bestand worden afgespeeld, kunnen nog steeds in HDR worden afgespeeld, en de tv kan daarvoor nog steeds naar HDR overschakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmy odtwarzane z oryginalnego pliku mogą nadal być odtwarzane w HDR, a telewizor może nadal przełączać się dla nich na HDR."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeos reproduzidos a partir do arquivo original ainda podem ser exibidos em HDR, e a TV ainda pode mudar para HDR para eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видео, воспроизводимые из исходного файла, по-прежнему могут идти в HDR, и телевизор по-прежнему может переключаться для них в HDR."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videor som spelas upp från originalfilen kan fortfarande spelas upp i HDR, och tv:n kan fortfarande växla till HDR för dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinal dosyadan oynatılan videolar yine de HDR olarak oynatılabilir ve TV bu videolar için yine de HDR’ye geçebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відео, що відтворюються з оригінального файлу, усе одно можуть відтворюватися в HDR, і телевізор усе одно може перемикатися для них на HDR."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从原始文件播放的视频仍可以HDR播放，电视也仍可为其切换到HDR。"
          }
        },
        "zh-Hant" : {
