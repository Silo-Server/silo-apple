    "tvSignIn.appleTv.qrLabel" : {
      "comment" : "Apple TV sign-in screen: VoiceOver label of the QR code. {url}: the activation address with each slash spoken as a word (for example media.example.com slash activate); {code}: the sign-in code's characters separated by spaces, read one by one.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رمز QR لتسجيل الدخول. أو انتقل إلى %1$@ وأدخل %2$@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlašovací QR kód. Nebo přejděte na %1$@ a zadejte %2$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-kode til login. Eller gå til %1$@, og indtast %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-Code zum Anmelden. Oder öffne %1$@ und gib %2$@ ein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign-in QR code. Or go to %1$@ and enter %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Código QR de inicio de sesión. O ve a %1$@ y escribe %2$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjautumisen QR-koodi. Tai siirry osoitteeseen %1$@ ja syötä %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR code de connexion. Ou accédez à %1$@ et saisissez %2$@"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR kôd za prijavu. Ili otvorite %1$@ i unesite %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codice QR di accesso. Oppure vai su %1$@ e inserisci %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン用QRコード。または%1$@にアクセスして%2$@を入力してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 QR 코드. 또는 %1$@에 접속해 다음 코드를 입력하세요: %2$@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-kode for pålogging. Eller gå til %1$@ og skriv inn %2$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-code voor inloggen. Of ga naar %1$@ en voer %2$@ in"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod QR do logowania. Możesz też otworzyć stronę %1$@ i wpisać kod %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR code de login. Ou acesse %1$@ e digite %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-код для входа. Или откройте %1$@ и введите %2$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-kod för inloggning. Eller gå till %1$@ och ange %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum açma QR kodu. Veya %1$@ adresine gidip %2$@ kodunu girin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-код для входу. Або перейдіть на %1$@ і введіть %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录二维码。或前往%1$@并输入%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入 QR 碼。或前往 %1$@ 並輸入 %2$@"
          }
        }
      }
    },
