            "value" : "Tillat det bare hvis du startet dette på din egen telefon eller ditt eget nettbrett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta dit alleen toe als je dit op je eigen telefoon of tablet bent gestart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól tylko, jeśli logowanie zostało uruchomione na twoim telefonie lub tablecie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
