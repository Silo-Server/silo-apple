          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer l’identité de ce serveur. Vérifiez la connexion et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לאמת את זהות השרת. יש לבדוק את החיבור ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पुष्टि नहीं की जा सकी कि यह कौन-सा सर्वर है। कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće potvrditi o kojem je poslužitelju riječ. Provjerite vezu i pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült megerősíteni, melyik szerverről van szó. Ellenőrizze a kapcsolatot, és próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
