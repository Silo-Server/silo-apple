    "error.dependency_unavailable" : {
      "comment" : "Error message shown when the server answers with the v2 problem type `dependency_unavailable` (server title: \"Dependency unavailable\"). Clients show it instead of the server's English detail in a translated interface, so it must make sense on its own, without the request's specifics.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خدمة يحتاجها الخادم غير متاحة. حاول مرة أخرى لاحقًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Услуга, от която сървърът се нуждае, не е достъпна. Опитайте отново по-късно."
