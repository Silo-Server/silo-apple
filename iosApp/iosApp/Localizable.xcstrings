    "setup.body" : {
      "comment" : "Roku and Android TV: short helper text under the heading on the server address screen, telling the user which address to type. Apple (iPhone, iPad, Mac, Apple TV): same line on the server setup screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب العنوان الذي تستخدمه للوصول إلى Silo."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Въведете адреса, който използвате за Silo."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escriu l’adreça que utilitzes per a Silo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte adresu, kterou pro Silo používáte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv den adresse, du bruger til Silo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib die Adresse ein, die du für Silo verwendest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πληκτρολογήστε τη διεύθυνση που χρησιμοποιείτε για το Silo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type the address you use for Silo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe la dirección que usas para Silo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisestage aadress, mida Silo jaoks kasutate."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita osoite, jota käytät Silossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez l’adresse que vous utilisez pour Silo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להקליד את הכתובת שמשמשת אותך לגישה ל-Silo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo के लिए इस्तेमाल होने वाला पता टाइप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upišite adresu koju koristite za Silo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adja meg a Silo eléréséhez használt címet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik alamat yang Anda gunakan untuk Silo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita l’indirizzo che usi per Silo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloで使用しているアドレスを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo에 사용하는 주소를 입력하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įveskite adresą, kurį naudojate „Silo“ pasiekti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ievadiet adresi, kuru izmantojat, lai piekļūtu Silo."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taip alamat yang anda gunakan untuk Silo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn adressen du bruker for Silo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ het adres dat je voor Silo gebruikt."
          }
        },
        "pl" : {
