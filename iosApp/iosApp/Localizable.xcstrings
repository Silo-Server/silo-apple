          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось обновить интервалы перемотки. Показаны последние сохранённые значения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att uppdatera hoppintervallen. Visar de senast sparade värdena."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
