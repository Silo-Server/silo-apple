    "settings.profileLaunch.automatic.detailAppleTv" : {
      "comment" : "Apple TV Settings > General > Profile Selection: explanation under the Automatic choice. The Apple TV user is the person signed in to tvOS. A protected profile is one with a PIN.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام الملف الشخصي المختار لمستخدم Apple TV الحالي. قد يُفتح الملف الشخصي المحمي مجددًا دون طلب رمز PIN الخاص به."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet das für den aktuellen Apple TV-Benutzer gewählte Profil. Ein geschütztes Profil kann sich ohne PIN-Abfrage wieder öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the profile selected for the current Apple TV user. A protected profile can reopen without asking for its PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el perfil seleccionado para el usuario actual del Apple TV. Un perfil protegido puede volver a abrirse sin pedir su PIN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le profil sélectionné pour l’utilisateur actuel de l’Apple TV. Un profil protégé peut se rouvrir sans demander son PIN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のApple TVユーザーに選択されたプロフィールを使用します。保護されたプロフィールも、PINを求めずに再び開くことがあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o perfil selecionado para o usuário atual da Apple TV. Um perfil protegido pode abrir novamente sem pedir o PIN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用为当前Apple TV用户选择的个人资料。受保护的个人资料可能无需输入PIN即可重新打开。"
          }
        }
      }
    },
    "settings.profileLaunch.automatic.detailPhone" : {
      "comment" : "Explanation under the Automatic choice in Settings > Profile Selection on Android phone and Apple (iPhone, iPad, Mac). A protected profile is one with a PIN.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
