    "settingsManifest.downloads.keep_watched.description" : {
      "comment" : "Help text under the downloads.keep_watched setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدم اقتراح استعادة المساحة من التنزيلات التي أنهيت مشاهدتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не се предлага освобождаване на място от изтегляния, които сте изгледали."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No suggereixis alliberar espai de les baixades que ja has acabat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenavrhuje uvolnění místa smazáním již zhlédnutých stažených položek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foreslå ikke at frigøre plads fra downloads, du har set færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt nicht vor, Speicherplatz von fertig geschauten Downloads freizugeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να μην προτείνεται η απελευθέρωση χώρου από λήψεις που έχετε ολοκληρώσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not suggest reclaiming space from downloads you have finished."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No sugerir liberar espacio de las descargas que ya terminaste."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei soovita vabastada ruumi allalaadimistest, mille olete lõpuni vaadanud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älä ehdota tilan vapauttamista latauksista, jotka olet katsonut loppuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne pas proposer de libérer l’espace occupé par les téléchargements que vous avez terminés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא להציע לפנות מקום מהורדות שסיימת לצפות בהן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे देखे जा चुके डाउनलोड हटाकर जगह खाली करने का सुझाव न दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne predlaže oslobađanje prostora od preuzimanja koja ste pogledali do kraja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo nem javasolja a tárhely felszabadítását a már megnézett letöltésekből."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan sarankan untuk mengosongkan ruang dari unduhan yang sudah selesai Anda tonton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non suggerire di liberare spazio dai download che hai finito di guardare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴し終えたダウンロードの削除による空き容量の確保を提案しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다 본 다운로드를 삭제해 공간을 확보하라고 제안하지 않아요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesiūlyti atlaisvinti vietos ištrinant atsisiuntimus, kuriuos jau peržiūrėjote."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neiesaka atbrīvot vietu, dzēšot jau noskatītās lejupielādes."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan cadangkan untuk mengosongkan ruang daripada muat turun yang telah anda habis tonton."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke foreslå å frigjøre plass fra nedlastinger du har sett ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel niet voor om ruimte vrij te maken van downloads die je hebt uitgekeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie proponuj usuwania obejrzanych pobrań w celu zwolnienia miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não sugerir liberar espaço dos downloads que você já terminou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não sugerir libertar espaço das transferências que já terminou de ver."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu se sugerează eliberarea spațiului ocupat de descărcările pe care le-ați vizionat integral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не предлагать освободить место за счёт загрузок, которые вы досмотрели."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenavrhovať uvoľnenie miesta zo stiahnutých položiek, ktoré ste už dopozerali."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne predlagaj sproščanja prostora iz prenosov, ki ste jih že pogledali."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Föreslå inte att frigöra utrymme från nedladdningar som du har sett klart."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่แนะนำให้คืนพื้นที่จากรายการดาวน์โหลดที่คุณดูจบแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlemeyi bitirdiğiniz indirmeleri silerek yer açmayı önermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не пропонувати звільняти місце від завантажень, які ви вже переглянули."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đề xuất giải phóng dung lượng từ các mục tải xuống bạn đã xem xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不建议删除已看完的下载来释放空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不建議刪除已看完的下載項目來釋放空間。"
          }
        }
      }
    },
