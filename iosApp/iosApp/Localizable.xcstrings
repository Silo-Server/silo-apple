          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ lance le film quand tout le monde est prêt."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pokreće film kad svi budu spremni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ avvierà il film quando saranno tutti pronti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員の準備ができたら、%1$@が映画を開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
