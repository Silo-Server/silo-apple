    "signIn.forgot.error.rateLimited" : {
      "comment" : "Apple (iPhone, iPad, Mac) Reset password screen: error when the server limits reset requests from this network.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلبات كثيرة جدًا من هذه الشبكة. انتظر دقيقة، ثم حاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твърде много заявки от тази мрежа. Изчакайте минута, след което опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massa sol·licituds des d’aquesta xarxa. Espera un minut i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš mnoho požadavků z této sítě. Minutu počkejte a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange anmodninger fra dette netværk. Vent et minut, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Anfragen aus diesem Netzwerk. Warte eine Minute und versuche es dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάρα πολλά αιτήματα από αυτό το δίκτυο. Περιμένετε ένα λεπτό και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many requests from this network. Wait a minute, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiadas solicitudes desde esta red. Espera un minuto y vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sellest võrgust on liiga palju taotlusi. Oodake minut ja proovige siis uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian monta pyyntöä tästä verkosta. Odota minuutti ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de demandes depuis ce réseau. Patientez une minute, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יותר מדי בקשות מהרשת הזו. יש להמתין דקה ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस नेटवर्क से बहुत ज़्यादा अनुरोध आए हैं। एक मिनट रुकें, फिर दोबारा कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previše zahtjeva s ove mreže. Pričekajte minutu pa pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túl sok kérés érkezett erről a hálózatról. Várjon egy percet, majd próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak permintaan dari jaringan ini. Tunggu satu menit, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppe richieste da questa rete. Attendi un minuto, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このネットワークからのリクエストが多すぎます。1分ほど待ってから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 네트워크에서 보낸 요청이 너무 많아요. 1분 정도 기다린 후 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per daug užklausų iš šio tinklo. Palaukite minutę ir bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārāk daudz pieprasījumu no šī tīkla. Uzgaidiet minūti un mēģiniet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak permintaan daripada rangkaian ini. Tunggu seminit, kemudian cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange forespørsler fra dette nettverket. Vent et minutt, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te veel verzoeken vanaf dit netwerk. Wacht een minuut en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt wiele żądań z tej sieci. Odczekaj minutę, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitas solicitações desta rede. Aguarde um minuto e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados pedidos a partir desta rede. Aguarde um minuto e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prea multe cereri din această rețea. Așteptați un minut, apoi încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком много запросов из этой сети. Подождите минуту и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Príliš veľa žiadostí z tejto siete. Minútu počkajte a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preveč zahtev iz tega omrežja. Počakajte minuto, nato poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För många förfrågningar från det här nätverket. Vänta en minut och försök sedan igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีคำขอจากเครือข่ายนี้มากเกินไป รอสักครู่ แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ağdan çok fazla istek geldi. Bir dakika bekleyip tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забагато запитів із цієї мережі. Зачекайте хвилину, а потім спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá nhiều yêu cầu từ mạng này. Chờ một phút, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自此网络的请求过多。请等待一分钟，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來自這個網路的請求過多。請稍候一分鐘，然後再試一次。"
          }
        }
      }
    },
    "signIn.forgot.lead" : {
      "comment" : "Apple (iPhone, iPad, Mac) Reset password screen: line under the headline explaining what happens after sending.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل اسم المستخدم أو البريد الإلكتروني. إذا تطابق مع حساب، فسنرسل إلى بريد ذلك الحساب رابطًا لاختيار كلمة مرور جديدة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Въведете потребителското си име или имейл. Ако съвпада с акаунт, ще изпратим на имейла на този акаунт връзка за избор на нова парола."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdueix el nom d’usuari o el correu electrònic. Si coincideix amb un compte, enviarem a aquest compte un enllaç per triar una contrasenya nova."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte uživatelské jméno nebo e-mail. Pokud odpovídá některému účtu, pošleme na e-mail tohoto účtu odkaz pro nastavení nového hesla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast dit brugernavn eller din e-mail. Hvis det matcher en konto, sender vi en e-mail til kontoen med et link, så du kan vælge en ny adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deinen Benutzernamen oder deine E-Mail-Adresse ein. Passt die Angabe zu einem Konto, senden wir diesem Konto per E-Mail einen Link, mit dem du ein neues Passwort wählen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε το όνομα χρήστη ή το email σας. Αν αντιστοιχεί σε λογαριασμό, θα στείλουμε σε αυτόν τον λογαριασμό ένα email με σύνδεσμο για να επιλέξετε νέο κωδικό πρόσβασης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your username or email. If it matches an account, we'll email that account a link to choose a new password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe tu nombre de usuario o correo electrónico. Si coincide con una cuenta, enviaremos a esa cuenta un enlace para elegir una contraseña nueva."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisestage oma kasutajanimi või e-posti aadress. Kui see vastab mõnele kontole, saadame selle konto e-posti aadressile lingi uue parooli valimiseks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna käyttäjänimesi tai sähköpostiosoitteesi. Jos se vastaa tiliä, lähetämme tilin sähköpostiin linkin uuden salasanan valitsemiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez votre nom d’utilisateur ou votre adresse e-mail. S’il correspond à un compte, nous enverrons à ce compte un lien par e-mail pour choisir un nouveau mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להזין שם משתמש או אימייל. אם יש התאמה לחשבון, נשלח באימייל לחשבון הזה קישור לבחירת סיסמה חדשה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना उपयोगकर्ता नाम या ईमेल डालें। अगर यह किसी खाते से मेल खाता है, तो हम उस खाते पर नया पासवर्ड चुनने का लिंक ईमेल करेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unesite korisničko ime ili e-adresu. Ako odgovara nekom računu, na e-adresu tog računa poslat ćemo poveznicu za odabir nove lozinke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adja meg a felhasználónevét vagy e-mail-címét. Ha egyezik egy fiókkal, e-mailben küldünk a fióknak egy linket, amellyel új jelszót választhat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan nama pengguna atau email Anda. Jika cocok dengan sebuah akun, kami akan mengirimkan tautan ke email akun tersebut untuk memilih kata sandi baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci il nome utente o l’email. Se corrisponde a un account, invieremo a quell’account un’email con un link per scegliere una nuova password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザー名またはメールアドレスを入力してください。一致するアカウントがある場合、新しいパスワードを設定するためのリンクをそのアカウントにメールでお送りします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 이름 또는 이메일을 입력하세요. 일치하는 계정이 있으면 새 비밀번호를 설정할 수 있는 링크를 해당 계정의 이메일로 보내 드려요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įveskite naudotojo vardą arba el. pašto adresą. Jei jis atitinka paskyrą, tos paskyros el. pašto adresu išsiųsime nuorodą naujam slaptažodžiui pasirinkti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ievadiet lietotājvārdu vai e-pasta adresi. Ja tā atbilst kādam kontam, mēs nosūtīsim uz šī konta e-pasta adresi saiti jaunas paroles izvēlei."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan nama pengguna atau e-mel anda. Jika sepadan dengan akaun, kami akan menghantar e-mel berisi pautan kepada akaun itu untuk memilih kata laluan baharu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn brukernavnet eller e-postadressen din. Hvis det samsvarer med en konto, sender vi en e-post til den kontoen med en lenke for å velge et nytt passord."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer je gebruikersnaam of e-mailadres in. Als dat bij een account hoort, mailen we dat account een link om een nieuw wachtwoord te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz nazwę użytkownika lub adres e-mail. Jeśli pasuje do konta, wyślemy na adres tego konta link do ustawienia nowego hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite seu nome de usuário ou e-mail. Se corresponder a uma conta, enviaremos a ela um link por e-mail para escolher uma nova senha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduza o seu nome de utilizador ou email. Se corresponder a uma conta, enviaremos para essa conta um email com um link para escolher uma nova palavra-passe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduceți numele de utilizator sau adresa de e-mail. Dacă acestea corespund unui cont, vom trimite prin e-mail acelui cont un link pentru a alege o parolă nouă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите имя пользователя или адрес эл. почты. Если такой аккаунт существует, мы отправим на его почту ссылку для выбора нового пароля."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadajte používateľské meno alebo e-mail. Ak zodpovedá niektorému účtu, pošleme na e-mail tohto účtu odkaz na výber nového hesla."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vnesite uporabniško ime ali e-poštni naslov. Če se ujema z računom, bomo temu računu po e-pošti poslali povezavo za izbiro novega gesla."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange ditt användarnamn eller din e-postadress. Om det matchar ett konto skickar vi en länk till kontots e-postadress där du kan välja ett nytt lösenord."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป้อนชื่อผู้ใช้หรืออีเมล หากตรงกับบัญชีใด เราจะส่งลิงก์สำหรับตั้งรหัสผ่านใหม่ไปยังอีเมลของบัญชีนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcı adınızı veya e-posta adresinizi girin. Bir hesapla eşleşirse o hesaba, yeni bir parola seçmeniz için bir bağlantı e-postayla göndeririz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть ім’я користувача або електронну адресу. Якщо вони збігаються з обліковим записом, ми надішлемо на його адресу посилання для вибору нового пароля."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập tên người dùng hoặc email. Nếu khớp với một tài khoản, chúng tôi sẽ gửi email cho tài khoản đó kèm liên kết để chọn mật khẩu mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入你的用户名或电子邮件。如果与某个账户匹配，我们会向该账户发送一封电子邮件，其中包含设置新密码的链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入你的使用者名稱或電子郵件。如果與某個帳號相符，我們會寄送連結至該帳號的電子郵件，讓你設定新密碼。"
          }
        }
      }
    },
