    "error.push_installation_key_mismatch" : {
      "comment" : "Error message shown when the server answers with the v2 problem type `push_installation_key_mismatch` (server title: \"Push installation key mismatch\"). Clients show it instead of the server's English detail in a translated interface, so it must make sense on its own, without the request's specifics.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل الإشعارات على هذا الجهاز غير متطابق. سجّل الدخول مرة أخرى على هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регистрацията за известия на това устройство не съвпада. Влезте отново на това устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registre de notificacions d’aquest dispositiu no coincideix. Torna a iniciar la sessió en aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrace oznámení tohoto zařízení nesouhlasí. Přihlaste se na tomto zařízení znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikationsregistreringen for denne enhed stemmer ikke overens. Log ind igen på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Benachrichtigungsregistrierung dieses Geräts stimmt nicht überein. Melde dich auf diesem Gerät erneut an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εγγραφή ειδοποιήσεων αυτής της συσκευής δεν αντιστοιχεί. Συνδεθείτε ξανά σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device’s notification registration doesn’t match. Sign in again on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de notificaciones de este dispositivo no coincide. Vuelve a iniciar sesión en este dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle seadme teavituste registreering ei ühti. Logige selles seadmes uuesti sisse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän laitteen ilmoitusrekisteröinti ei täsmää. Kirjaudu sisään uudelleen tällä laitteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’inscription aux notifications de cet appareil ne correspond pas. Reconnectez-vous sur cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רישום ההתראות של המכשיר הזה לא תואם. יש להתחבר שוב במכשיר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस का सूचना रजिस्ट्रेशन मेल नहीं खाता। इस डिवाइस पर फिर से साइन इन करें।"
