    "companion.progressAllowSetup" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: progress text while the TV asks its viewer to allow the setup. {tv}: the TV's name as it advertises itself (for example Living Room). {model}: the device model the person is holding, as the system names it (iPhone or iPad; not translated).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع على %1$@: اسمح لجهاز %2$@ هذا بإعداده."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokračujte na televizi %1$@: povolte, aby ji tento %2$@ nastavil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsæt på %1$@: tillad denne %2$@ at konfigurere det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fahre auf %1$@ fort: Erlaube die Einrichtung durch dieses %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue on %1$@: allow this %2$@ to set it up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continúa en %1$@: permite que este %2$@ configure la TV."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatka laitteella %1$@: salli, että tämä %2$@ ottaa sen käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez sur %1$@ : autorisez cet %2$@ à configurer la TV."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavite na uređaju %1$@: dopustite da ga ovaj %2$@ postavi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua su %1$@: consenti la configurazione da questo %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@で続行：この%2$@によるセットアップを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 계속하세요: 이 %2$@에서 설정할 수 있도록 허용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsett på %1$@: tillat at denne %2$@ konfigurerer den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga verder op %1$@: geef deze %2$@ toestemming om de tv in te stellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontynuuj na telewizorze %1$@: zezwól na konfigurację z urządzenia %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue em %1$@: permita que este %2$@ faça a configuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжите на устройстве %1$@: разрешите настройку с этого %2$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsätt på %1$@: tillåt din %2$@ att konfigurera den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ cihazında devam edin: bu %2$@ cihazının kurulumu yapmasına izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продовжте на %1$@: дозвольте налаштування з цього пристрою %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在%1$@上继续：允许此%2$@进行设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在 %1$@ 上繼續：允許這台 %2$@ 進行設定。"
          }
        }
      }
    },
