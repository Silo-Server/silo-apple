    "settings.quality.cellularFooter" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad): footer under the Cellular Quality picker. Android phone Settings > Playback: footer under the Cellular quality picker.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم على بيانات الهاتف المحمول والشبكات محدودة البيانات، مثل نقطة اتصال الهاتف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá se při mobilních datech a v sítích s měřeným připojením, například při sdílení připojení z telefonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges på mobildata og netværk med datagrænse, f.eks. et hotspot på en telefon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird bei mobilen Daten und getakteten Netzwerken verwendet, etwa einem Smartphone-Hotspot."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used on mobile data and metered networks, such as a phone hotspot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa con datos móviles y en redes de uso medido, como un punto de acceso del teléfono."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään mobiilidatalla ja käytön mukaan laskutettavissa verkoissa, kuten puhelimen yhteyspisteessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisée sur les données mobiles et les réseaux limités, comme un partage de connexion depuis un téléphone."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi se na mobilnim podacima i mrežama s ograničenim prometom, poput žarišne točke telefona."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usata con i dati mobili e sulle reti a consumo, come l’hotspot di un telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モバイルデータ通信や、スマートフォンのテザリングなどの従量制ネットワークで使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모바일 데이터와 휴대폰 핫스팟 같은 데이터 요금제 네트워크에서 사용돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes på mobildata og nettverk med databegrensning, for eksempel når en telefon deler internett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt bij mobiele data en netwerken met een datalimiet, zoals een hotspot van je telefoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używana przy danych komórkowych i w sieciach z limitem danych, np. w hotspocie telefonu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usada em dados móveis e redes limitadas, como o ponto de acesso de um celular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется в мобильной сети и в сетях с лимитным трафиком, например при раздаче интернета с телефона."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används med mobildata och nätverk med datapriser, till exempel en surfzon från en telefon."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobil veride ve telefon erişim noktası gibi ölçülü ağlarda kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовується в мобільній мережі та мережах з обмеженим трафіком, як-от точка доступу на телефоні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于移动数据和按流量计费的网络，例如手机热点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在行動數據和計量付費網路（例如手機熱點）上使用。"
          }
        }
      }
    },
    "settings.quality.footerBitrate" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: sentence added to the quality footer when a Maximum Bitrate is chosen. Android phone and TV Settings > Playback: the same sentence, under the Resolution and Maximum Bitrate pickers.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحوَّل الملفات التي يتجاوز معدل البت فيها هذا الحد لتلائمه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubory nad tímto datovým tokem se převedou, aby se vešly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer over denne bitrate konverteres, så de passer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien über dieser Bitrate werden passend konvertiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files above this bitrate are converted to fit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos que superan esta tasa de bits se convierten para ajustarse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä bittinopeutta suuremmat tiedostot muunnetaan sopiviksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers au-delà de ce débit sont convertis pour s’y adapter."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteke iznad ove brzine prijenosa konvertiraju se kako bi stale u ograničenje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file oltre questo bitrate vengono convertiti per rientrarvi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビットレートを超えるファイルは、収まるように変換されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 비트레이트를 넘는 파일은 맞게 변환돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer over denne bithastigheten konverteres så de passer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden boven deze bitrate worden omgezet zodat ze passen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki o wyższej przepływności są konwertowane, aby zmieścić się w limicie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos acima desta taxa de bits são convertidos para se ajustar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы с битрейтом выше этого значения преобразуются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer över den här bithastigheten konverteras så att de passar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bit hızının üzerindeki dosyalar sığacak şekilde dönüştürülür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файли з вищим бітрейтом перетворюються відповідно до нього."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码率超过此值的文件会被转换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過此位元速率的檔案會經過轉換以符合限制。"
          }
        }
      }
    },
    "settings.quality.footerOriginal" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: footer under Resolution when it is set to Auto. Android phone and TV Settings > Playback: the same footer, under the Resolution and Maximum Bitrate pickers.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُشغّل الملف الأصلي متى استطاع جهازك واتصالك التعامل معه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrává původní soubor, kdykoli to vaše zařízení a připojení zvládnou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspiller den originale fil, når din enhed og forbindelse kan klare det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt die Originaldatei ab, wann immer dein Gerät und deine Verbindung es zulassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays the original file whenever your device and connection can handle it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce el archivo original siempre que tu dispositivo y tu conexión lo permitan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistaa alkuperäisen tiedoston aina, kun laitteesi ja yhteytesi pystyvät siihen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit le fichier original chaque fois que votre appareil et votre connexion le permettent."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducira izvornu datoteku kad god to vaš uređaj i veza mogu podnijeti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce il file originale quando il dispositivo e la connessione lo consentono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスと接続が対応できる場合は、常に元のファイルを再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기와 연결 상태가 허용하면 항상 원본 파일을 재생해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiller av originalfilen når enheten og tilkoblingen din klarer det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt het originele bestand af wanneer je apparaat en verbinding dat aankunnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarza oryginalny plik zawsze, gdy pozwalają na to urządzenie i połączenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz o arquivo original sempre que o seu dispositivo e a sua conexão permitirem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводит исходный файл, если это позволяют ваше устройство и подключение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar upp originalfilen när din enhet och anslutning klarar det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihazınız ve bağlantınız kaldırabildiği sürece orijinal dosyayı oynatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відтворює оригінальний файл, коли ваш пристрій і з’єднання це дозволяють."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要设备和网络连接能够处理，就播放原始文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要你的裝置和連線能夠處理，就會播放原始檔案。"
          }
        }
      }
    },
    "settings.quality.footerUpTo" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: footer under Resolution when a maximum resolution is chosen. {resolution}: the chosen resolution's label, such as 1080p. Android phone and TV Settings > Playback: the same footer, under the Resolution and Maximum Bitrate pickers.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُشغّل الملف الأصلي حتى %1$@. تُحوَّل الملفات الأكبر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrává původní soubor do rozlišení %1$@. Větší soubory se převedou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspiller den originale fil op til %1$@. Større filer konverteres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt die Originaldatei bis %1$@ ab. Größere Dateien werden konvertiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays the original file up to %1$@. Larger files are converted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce el archivo original hasta %1$@. Los archivos más grandes se convierten."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistaa alkuperäisen tiedoston tarkkuuteen %1$@ asti. Suuremmat tiedostot muunnetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit le fichier original jusqu’à %1$@. Les fichiers plus grands sont convertis."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducira izvornu datoteku do %1$@. Veće datoteke se konvertiraju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce il file originale fino a %1$@. I file più grandi vengono convertiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@までは元のファイルを再生します。それより大きいファイルは変換されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 %1$@까지 원본 파일을 재생해요. 그보다 큰 파일은 변환돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiller av originalfilen opptil %1$@. Større filer konverteres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt het originele bestand af tot %1$@. Grotere bestanden worden omgezet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarza oryginalny plik do rozdzielczości %1$@. Większe pliki są konwertowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz o arquivo original até %1$@. Arquivos maiores são convertidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводит исходный файл с разрешением до %1$@. Файлы с более высоким разрешением преобразуются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar upp originalfilen upp till %1$@. Större filer konverteras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinal dosyayı en fazla %1$@ çözünürlüğe kadar oynatır. Daha büyük dosyalar dönüştürülür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відтворює оригінальний файл до %1$@. Більші файли перетворюються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高以%1$@播放原始文件。更大的文件会被转换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放最高 %1$@ 的原始檔案。更大的檔案會經過轉換。"
          }
        }
      }
    },
