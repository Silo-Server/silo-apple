    "requests.notice.following" : {
      "comment" : "Toast on Roku after the user turns on notifications for a request. Promises a notice when the title is available. Apple (iPhone, iPad, Mac, Apple TV): same notice under the Notify Me button on a request detail page.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
