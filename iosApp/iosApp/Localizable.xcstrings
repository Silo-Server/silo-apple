    "diagnostics.alwaysSend.confirmTitle" : {
      "comment" : "Apple (iPhone, iPad, Apple TV): title of the confirmation before crash reports are sent automatically, from Settings > Diagnostics > Crash Reports or the diagnostics prompt.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرسال تقارير الأعطال دائمًا؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да се изпращат ли винаги отчетите за сривове?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols enviar sempre els informes d’error?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždy odesílat zprávy o pádech?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send altid nedbrudsrapporter?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absturzberichte immer senden?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
