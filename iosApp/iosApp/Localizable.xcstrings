    "setup.recovery.leadNeedsSetup" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV) saved-server recovery screen: text under the headline when the server still needs administrator setup.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من مسؤول الخادم إكمال الإعداد، ثم حاول مرة أخرى. لم تُحذف معلومات تسجيل الدخول المحفوظة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte die Person, die den Server verwaltet, die Einrichtung abzuschließen, und versuche es dann erneut. Deine gespeicherten Anmeldedaten wurden nicht entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the server administrator to finish setup, then try again. Your saved sign-in information has not been removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide al administrador del servidor que termine la configuración y vuelve a intentarlo. Tu información de inicio de sesión guardada no se ha eliminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à la personne qui administre le serveur de terminer la configuration, puis réessayez. Vos informations de connexion enregistrées n’ont pas été supprimées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの管理者にセットアップの完了を依頼してから、もう一度お試しください。保存済みのサインイン情報は削除されていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao administrador do servidor para concluir a configuração e tente novamente. Suas informações de login salvas não foram removidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请让服务器管理员完成设置，然后重试。你已保存的登录信息未被移除。"
          }
        }
      }
    },
    "setup.recovery.leadNotRecognized" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV) saved-server recovery screen: text under the headline when the address no longer answers as the saved Silo server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما نُقل الخادم أو أُعيد ضبطه، أو ربما لم يعد هذا العنوان يشير إلى Silo. لم تُحذف معلومات تسجيل الدخول المحفوظة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server wurde möglicherweise verschoben oder zurückgesetzt, oder diese Adresse verweist nicht mehr auf Silo. Deine gespeicherten Anmeldedaten wurden nicht entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server may have moved, been reset, or this address may no longer point to Silo. Your saved sign-in information has not been removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que el servidor se haya trasladado o restablecido, o que esta dirección ya no apunte a Silo. Tu información de inicio de sesión guardada no se ha eliminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a peut-être été déplacé ou réinitialisé, ou cette adresse ne pointe peut-être plus vers Silo. Vos informations de connexion enregistrées n’ont pas été supprimées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーが移動またはリセットされたか、このアドレスがSiloを指していない可能性があります。保存済みのサインイン情報は削除されていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor pode ter mudado de lugar ou sido redefinido, ou este endereço pode não apontar mais para o Silo. Suas informações de login salvas não foram removidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器可能已迁移或被重置，或者此地址可能不再指向Silo。你已保存的登录信息未被移除。"
          }
        }
      }
    },
