    "settings.bufferingQuality.description" : {
      "comment" : "Help text under the Android Lower quality when buffering setting, explaining what Auto does and that a quality the user picked always prompts first. Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: sentence in the quality footer.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يفعله Silo في الوضع «تلقائي» عندما يتكرر التخزين المؤقت أثناء التشغيل. يسألك Silo دائمًا قبل خفض جودة اخترتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was Silo bei Auto tut, wenn die Wiedergabe immer wieder puffert. Bevor Silo eine von dir gewählte Qualität senkt, fragt es immer nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What Silo does on Auto when playback keeps buffering. Silo always asks before lowering a quality you picked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué hace Silo en Auto cuando la reproducción sigue almacenando en búfer. Silo siempre pregunta antes de bajar una calidad que hayas elegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que fait Silo en qualité Auto quand la lecture se met sans cesse en mémoire tampon. Silo demande toujours avant de baisser une qualité que vous avez choisie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動画質で再生中にバッファリングが続く場合のSiloの動作です。選択した画質を下げる前には、必ず確認します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o Silo faz na qualidade Auto quando a reprodução continua carregando. O Silo sempre pergunta antes de reduzir uma qualidade que você escolheu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“自动”模式下播放持续缓冲时Silo的处理方式。如果画质是你手动选择的，Silo总会先询问再降低。"
          }
        }
      }
    },
