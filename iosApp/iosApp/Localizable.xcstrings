    "settingsManifest.catalog.show_advisory_age.description" : {
      "comment" : "Help text under the catalog.show_advisory_age setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض الحد الأدنى الموصى به لعمر المشاهد من خدمة استشارية، مثل Common Sense Media، في صفحة تفاصيل العنصر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показва в подробностите за елемента препоръчителна минимална възраст на зрителя от консултантска услуга като Common Sense Media."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra al detall de l’element una edat mínima recomanada per a l’espectador d’un servei d’orientació, com ara Common Sense Media."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí v detailu položky doporučený minimální věk diváka od hodnoticí služby, například Common Sense Media."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis en anbefalet minimumsalder fra en vejledningstjeneste, f.eks. Common Sense Media, på elementets detaljeside."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt in den Details ein empfohlenes Mindestalter von einem Bewertungsdienst wie Common Sense Media an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση της προτεινόμενης ελάχιστης ηλικίας θεατή από μια υπηρεσία καθοδήγησης, όπως το Common Sense Media, στις λεπτομέρειες του στοιχείου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a recommended minimum viewer age from an advisory service, such as Common Sense Media, on item detail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra en los detalles del elemento una edad mínima recomendada de un servicio de orientación, como Common Sense Media."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näitab üksuse üksikasjades vaatajale soovitatud miinimumvanust, mille annab nõuandeteenus, näiteks Common Sense Media."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä kohteen tiedoissa suositeltu katsojan vähimmäisikä arviointipalvelusta, kuten Common Sense Media -palvelusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche dans la fiche d’un élément l’âge minimum recommandé par un service de conseil, comme Common Sense Media."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת גיל צפייה מינימלי מומלץ משירות המלצות לצפייה, כמו Common Sense Media, בדף הפריט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आइटम के विवरण पेज पर Common Sense Media जैसी किसी सलाहकार सेवा से दर्शक की सुझाई गई न्यूनतम आयु दिखाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U pojedinostima stavke prikazuje preporučenu minimalnu dob gledatelja prema savjetodavnoj službi kao što je Common Sense Media."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy tanácsadó szolgáltatás (például a Common Sense Media) által ajánlott minimális nézői életkor megjelenítése az elem részleteinél."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan usia minimum penonton yang disarankan dari layanan panduan, seperti Common Sense Media, di detail item."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra nei dettagli del contenuto un’età minima consigliata fornita da un servizio di valutazione, come Common Sense Media."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Common Sense Mediaなどの評価サービスによる推奨最低視聴年齢を詳細画面に表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Common Sense Media 같은 권장 연령 서비스에서 제공하는 최소 시청 권장 연령을 항목 상세 화면에 표시해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elemento išsamios informacijos puslapyje rodyti rekomenduojamą minimalų žiūrovo amžių iš rekomendacijų paslaugos, pvz., „Common Sense Media“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vienuma informācijā rāda ieteicamo minimālo skatītāja vecumu no vērtēšanas pakalpojuma, piemēram, Common Sense Media."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan umur minimum penonton yang disyorkan daripada perkhidmatan nasihat, seperti Common Sense Media, pada butiran item."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis en anbefalt minstealder fra en veiledningstjeneste, for eksempel Common Sense Media, på detaljsiden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon bij itemdetails een aanbevolen minimumleeftijd van een adviesdienst, zoals Common Sense Media."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj w szczegółach pozycji zalecany minimalny wiek widza z serwisu z rekomendacjami, takiego jak Common Sense Media."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra nos detalhes do item uma idade mínima recomendada por um serviço de orientação, como o Common Sense Media."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar nos detalhes do item uma idade mínima recomendada por um serviço de aconselhamento, como o Common Sense Media."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează în pagina de detalii a elementului o vârstă minimă recomandată pentru spectatori, de la un serviciu de recomandări precum Common Sense Media."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать на странице элемента рекомендуемый минимальный возраст зрителя от рекомендательного сервиса, например Common Sense Media."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí v podrobnostiach položky odporúčaný minimálny vek diváka zo služby s vekovými odporúčaniami, napríklad Common Sense Media."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V podrobnostih elementa prikaži priporočeno najnižjo starost gledalca iz svetovalne storitve, kot je Common Sense Media."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa en rekommenderad lägsta ålder för tittare från en rådgivningstjänst, till exempel Common Sense Media, på objektets detaljsida."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงอายุผู้ชมขั้นต่ำที่แนะนำจากบริการให้คำแนะนำ เช่น Common Sense Media ในหน้ารายละเอียดของรายการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğe ayrıntılarında, Common Sense Media gibi bir danışma hizmetinin önerdiği en düşük izleyici yaşını gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати на сторінці об’єкта рекомендований мінімальний вік глядача від сервісу оцінювання, як-от Common Sense Media."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị độ tuổi người xem tối thiểu được khuyến nghị từ một dịch vụ tư vấn, như Common Sense Media, trên trang chi tiết mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在详情页显示来自Common Sense Media等评估服务的建议最低观看年龄。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在項目詳細資料中顯示分級建議服務（例如 Common Sense Media）提供的建議最低觀看年齡。"
          }
        }
      }
    },
