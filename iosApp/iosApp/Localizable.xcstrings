    "shell.error.tooManyRequests" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error message when the server rate-limited the app (HTTP 429).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
