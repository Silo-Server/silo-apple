    "settings.metadataLanguageNote" : {
      "comment" : "Help text under the Roku metadata language row explaining descriptions and taglines are translated when available but titles are not. Apple Settings > Subtitles (iPhone, iPad, Mac) and Apple TV Settings > Subtitles: footer under Metadata Language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يترجم الأوصاف والعبارات الترويجية إلى لغتك المفضلة عند توفرها. لا تُترجم العناوين أبدًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превежда описанията и слоганите на предпочитания от вас език, когато е възможно. Заглавията никога не се превеждат."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradueix les descripcions i els eslògans a l’idioma preferit quan estan disponibles. Els títols no es tradueixen mai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je to možné, přeloží popisy a slogany do preferovaného jazyka. Názvy se nikdy nepřekládají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oversætter beskrivelser og taglines til dit foretrukne sprog, når det er muligt. Titler oversættes aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersetzt Beschreibungen und Slogans in deine bevorzugte Sprache, wenn verfügbar. Titel werden nie übersetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεταφράζει τις περιγραφές και τα σλόγκαν στη γλώσσα που προτιμάτε, όταν είναι διαθέσιμα. Οι τίτλοι δεν μεταφράζονται ποτέ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Translates descriptions and taglines into your preferred language when available. Titles are never translated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduce las descripciones y los lemas a tu idioma preferido cuando están disponibles. Los títulos nunca se traducen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tõlgib kirjeldused ja tunnuslaused võimaluse korral teie eelistatud keelde. Pealkirju ei tõlgita kunagi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kääntää kuvaukset ja iskulauseet haluamallesi kielelle, kun käännös on saatavilla. Nimiä ei koskaan käännetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduit les descriptions et les accroches dans votre langue préférée lorsque c’est possible. Les titres ne sont jamais traduits."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תרגום תיאורים וסלוגנים לשפה המועדפת שלך כשהדבר אפשרי. שמות הפריטים אף פעם לא מתורגמים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपलब्ध होने पर विवरण और टैगलाइन का आपकी पसंदीदा भाषा में अनुवाद करता है। टाइटल का कभी अनुवाद नहीं किया जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevodi opise i sloganove na željeni jezik kada je to moguće. Naslovi se nikad ne prevode."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lefordítja a leírásokat és a szlogeneket a preferált nyelvre, ha elérhető. A címeket soha nem fordítja le."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menerjemahkan deskripsi dan tagline ke bahasa pilihan Anda jika tersedia. Judul tidak pernah diterjemahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduce descrizioni e slogan nella lingua che preferisci, quando disponibili. I titoli non vengono mai tradotti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用できる場合は、説明文とキャッチコピーを優先言語に翻訳します。タイトルは翻訳されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가능한 경우 설명과 태그라인을 선호하는 언어로 번역해요. 제목은 번역하지 않아요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai įmanoma, aprašymai ir šūkiai verčiami į jūsų pageidaujamą kalbą. Pavadinimai niekada neverčiami."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apraksti un saukļi tiek tulkoti jūsu vēlamajā valodā, ja ir pieejams tulkojums. Nosaukumi nekad netiek tulkoti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menterjemahkan penerangan dan slogan ke dalam bahasa pilihan anda jika tersedia. Tajuk tidak pernah diterjemahkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oversetter beskrivelser og slagord til språket du foretrekker, når det er tilgjengelig. Titler oversettes aldri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaalt beschrijvingen en taglines naar je voorkeurstaal als dat kan. Titels worden nooit vertaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tłumaczy opisy i hasła reklamowe na preferowany język, gdy to możliwe. Tytuły nigdy nie są tłumaczone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduz descrições e slogans para o idioma de sua preferência, quando disponível. Os títulos nunca são traduzidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduz descrições e frases promocionais para o seu idioma preferido quando disponível. Os títulos nunca são traduzidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduce descrierile și sloganurile în limba preferată, când sunt disponibile. Titlurile nu sunt traduse niciodată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Описания и слоганы переводятся на выбранный вами язык, если перевод доступен. Названия никогда не переводятся."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je to možné, preloží popisy a slogany do vášho preferovaného jazyka. Názvy sa nikdy neprekladajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opise in slogane prevede v želeni jezik, ko je prevod na voljo. Naslovi se nikoli ne prevajajo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Översätter beskrivningar och slogans till ditt önskade språk när det går. Titlar översätts aldrig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แปลคำอธิบายและคำโปรยเป็นภาษาที่ต้องการเมื่อมีคำแปล ชื่อเรื่องจะไม่ถูกแปล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut olduğunda açıklamaları ve sloganları tercih ettiğiniz dile çevirir. Başlıklar hiçbir zaman çevrilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перекладає описи й слогани вашою мовою, якщо переклад доступний. Назви ніколи не перекладаються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch phần mô tả và khẩu hiệu sang ngôn ngữ bạn ưu tiên khi có. Tiêu đề không bao giờ được dịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在可用时将简介和宣传语翻译为你的首选语言。标题永远不会被翻译。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有可用翻譯時，將簡介和標語翻譯成你偏好的語言。標題一律不翻譯。"
          }
        }
      }
    },
