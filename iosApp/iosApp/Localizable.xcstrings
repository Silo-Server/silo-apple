    "downloads.settings.removeOtherProfilesMessage" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; message of the removal alert for data of other profiles on the current server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف التنزيلات المحفوظة لملفات شخصية وحسابات أخرى على هذا الخادم من هذا الجهاز. قد يؤدي التبديل إلى أحد تلك الملفات الشخصية إلى تنزيل عناصره مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stažené soubory uložené pro jiné profily a účty na tomto serveru budou z tohoto zařízení smazány. Po přepnutí na některý z těchto profilů se jeho položky mohou stáhnout znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads, der er gemt for andre profiler og konti på denne server, slettes fra denne enhed. Hvis du skifter til en af disse profiler, kan dens elementer blive downloadet igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads, die für andere Profile und Konten auf diesem Server gespeichert sind, werden von diesem Gerät gelöscht. Wenn du zu einem dieser Profile wechselst, werden dessen Titel möglicherweise erneut heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads saved for other profiles and accounts on this server will be deleted from this device. Switching to one of those profiles may download its items again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las descargas guardadas para otros perfiles y cuentas de este servidor se eliminarán de este dispositivo. Si cambias a uno de esos perfiles, es posible que sus elementos se vuelvan a descargar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän palvelimen muille profiileille ja tileille tallennetut lataukset poistetaan tästä laitteesta. Jos vaihdat johonkin näistä profiileista, sen kohteet voidaan ladata uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les téléchargements enregistrés pour d’autres profils et comptes sur ce serveur seront supprimés de cet appareil. Passer à l’un de ces profils peut télécharger à nouveau ses éléments."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzimanja spremljena za druge profile i račune na ovom poslužitelju bit će izbrisana s ovog uređaja. Nakon prelaska na neki od tih profila njegove se stavke mogu ponovno preuzeti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I download salvati per altri profili e account su questo server verranno eliminati da questo dispositivo. Se passi a uno di quei profili, i relativi elementi potrebbero essere scaricati di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーの他のプロフィールとアカウント用に保存されたダウンロードが、このデバイスから削除されます。それらのプロフィールに切り替えると、項目が再度ダウンロードされる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버의 다른 프로필 및 계정용으로 저장된 다운로드가 이 기기에서 삭제돼요. 해당 프로필로 전환하면 항목이 다시 다운로드될 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedlastinger som er lagret for andre profiler og kontoer på denne serveren, slettes fra denne enheten. Hvis du bytter til en av disse profilene, kan elementene lastes ned på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads die voor andere profielen en accounts op deze server zijn opgeslagen, worden van dit apparaat verwijderd. Als je naar een van die profielen overschakelt, kunnen de items ervan opnieuw worden gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobrane pliki zapisane dla innych profili i kont na tym serwerze zostaną usunięte z tego urządzenia. Po przełączeniu na jeden z tych profili jego pozycje mogą zostać pobrane ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os downloads salvos para outros perfis e contas neste servidor serão excluídos deste dispositivo. Mudar para um desses perfis pode baixar os itens dele novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузки, сохранённые для других профилей и аккаунтов на этом сервере, будут удалены с этого устройства. При переключении на один из этих профилей его объекты могут скачаться снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedladdningar som sparats för andra profiler och konton på den här servern raderas från den här enheten. Om du byter till någon av de profilerna kan dess objekt laddas ned igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucudaki diğer profiller ve hesaplar için kaydedilen indirmeler bu cihazdan silinecek. Bu profillerden birine geçerseniz öğeleri yeniden indirilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантаження, збережені для інших профілів і облікових записів на цьому сервері, буде видалено з цього пристрою. Після перемикання на один із цих профілів його об’єкти можуть завантажитися знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为此服务器上其他个人资料和账户保存的下载将从此设备删除。切换到其中某个个人资料后，可能会再次下载其内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為此伺服器上其他個人檔案和帳號儲存的下載項目將從此裝置刪除。切換至其中一個個人檔案時，可能會再次下載其項目。"
          }
        }
      }
    },
