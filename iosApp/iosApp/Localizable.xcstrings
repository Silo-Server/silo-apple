        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 트랙을 전환할 수 없어서 이전 트랙을 유지했어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke bytte lydspor. Det forrige sporet ble beholdt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan het audiospoor niet wisselen. Het vorige spoor is behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się przełączyć ścieżki dźwiękowej. Zachowano poprzednią ścieżkę."
