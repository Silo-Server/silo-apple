      }
    },
    "diagnostics.notice.localDeletedRemoteQueued" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: notice after deleting a pending report whose copy at the destination couldn't be deleted yet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُذف التقرير المحلي. الحذف البعيد في قائمة الانتظار وستُعاد محاولته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místní zpráva byla smazána. Vzdálené smazání je ve frontě a bude se opakovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lokale rapport blev slettet. Fjernsletning er sat i kø og forsøges igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der lokale Bericht wurde gelöscht. Das Löschen am Ziel steht in der Warteschlange und wird erneut versucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local report was deleted. Remote deletion is queued and will retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminó el informe local. La eliminación remota está en cola y se volverá a intentar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikallinen raportti poistettiin. Etäpoisto on jonossa, ja sitä yritetään uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rapport local a été supprimé. La suppression à distance est en file d’attente et sera retentée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalno izvješće izbrisano je. Udaljeno brisanje čeka u redu čekanja i pokušat će se ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il report locale è stato eliminato. L’eliminazione remota è in coda e verrà ritentata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルのレポートを削除しました。リモートでの削除はキューに追加され、再試行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 보고서를 삭제했어요. 원격 삭제는 대기열에 추가되어 다시 시도할 거예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lokale rapporten ble slettet. Ekstern sletting står i kø og prøves på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het lokale rapport is verwijderd. Verwijdering op afstand staat in de wachtrij en wordt opnieuw geprobeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięto raport lokalny. Usunięcie zdalne czeka w kolejce i zostanie ponowione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relatório local foi excluído. A exclusão remota está na fila e será tentada novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локальный отчёт удалён. Удаление отправленной копии поставлено в очередь и будет выполнено повторно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lokala rapporten raderades. Fjärradering har köats och görs ett nytt försök."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel rapor silindi. Uzak silme işlemi sıraya alındı ve yeniden denenecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локальний звіт видалено. Віддалене видалення додано в чергу, спробу буде повторено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地报告已删除。远程删除已加入队列，将会重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已刪除本機報告。遠端刪除已排入佇列，並會重試。"
          }
        }
      }
    },
    "diagnostics.notice.offLocalRetry" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: notice after the user turned Crash Reports to Never and some reports on the device couldn't be deleted yet. Crash Reports is the setting's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«تقارير الأعطال» معطّلة. تعذّر حذف بعض التقارير المحلية وستُعاد المحاولة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zprávy o pádech jsou vypnuté. Některé místní zprávy se nepodařilo smazat, pokus se bude opakovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedbrudsrapporter er slået fra. Nogle lokale rapporter kunne ikke slettes og forsøges slettet igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Absturzberichte“ ist aus. Einige lokale Berichte konnten nicht gelöscht werden; das Löschen wird erneut versucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crash Reports is off. Some local reports could not be deleted and will retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informes de fallos está desactivado. No se pudieron eliminar algunos informes locales; se volverá a intentar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaatumisraportit on pois päältä. Joitakin paikallisia raportteja ei voitu poistaa, ja poistoa yritetään uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Rapports de plantage » est désactivé. Certains rapports locaux n’ont pas pu être supprimés ; la suppression sera retentée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Izvješća o rušenju“ isključena su. Neka lokalna izvješća nije bilo moguće izbrisati pa će se brisanje ponoviti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Report arresti anomali” è disattivato. Non è stato possibile eliminare alcuni report locali: verrà effettuato un nuovo tentativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュレポートはオフです。一部のローカルレポートを削除できなかったため、再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충돌 보고서가 꺼져 있어요. 일부 로컬 보고서를 삭제하지 못해 다시 시도할 거예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krasjrapporter er av. Noen lokale rapporter kunne ikke slettes og prøves på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crashrapporten staat uit. Sommige lokale rapporten konden niet worden verwijderd; dit wordt opnieuw geprobeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raporty o awariach wyłączone. Nie udało się usunąć niektórych raportów lokalnych; próba zostanie ponowiona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Relatórios de falhas está desativada. Não foi possível excluir alguns relatórios locais; o Silo tentará novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Параметр «Отчёты о сбоях» выключен. Некоторые локальные отчёты не удалось удалить; попытка будет повторена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kraschrapporter är av. Vissa lokala rapporter kunde inte raderas, och ett nytt försök görs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitlenme raporları kapalı. Bazı yerel raporlar silinemedi; silme işlemi yeniden denenecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Звіти про збої» вимкнено. Деякі локальні звіти не вдалося видалити – спробу буде повторено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "崩溃报告已关闭。部分本地报告无法删除，将会重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當機報告已關閉。部分本機報告無法刪除，將會重試。"
          }
        }
      }
    },
    "diagnostics.notice.offRemoteQueued" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: notice after the user turned Crash Reports to Never while reports already sent couldn't be deleted at the destination yet. Crash Reports is the setting's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«تقارير الأعطال» معطّلة. الحذف البعيد في قائمة الانتظار وستُعاد محاولته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zprávy o pádech jsou vypnuté. Vzdálené smazání je ve frontě a bude se opakovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedbrudsrapporter er slået fra. Fjernsletning er sat i kø og forsøges igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Absturzberichte“ ist aus. Das Löschen am Ziel steht in der Warteschlange und wird erneut versucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crash Reports is off. Remote deletion is queued and will retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informes de fallos está desactivado. La eliminación remota está en cola y se volverá a intentar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaatumisraportit on pois päältä. Etäpoisto on jonossa, ja sitä yritetään uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Rapports de plantage » est désactivé. La suppression à distance est en file d’attente et sera retentée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Izvješća o rušenju“ isključena su. Udaljeno brisanje čeka u redu čekanja i pokušat će se ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Report arresti anomali” è disattivato. L’eliminazione remota è in coda e verrà ritentata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュレポートはオフです。リモートでの削除はキューに追加され、再試行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충돌 보고서가 꺼져 있어요. 원격 삭제는 대기열에 추가되어 다시 시도할 거예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krasjrapporter er av. Ekstern sletting står i kø og prøves på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crashrapporten staat uit. Verwijdering op afstand staat in de wachtrij en wordt opnieuw geprobeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raporty o awariach wyłączone. Usunięcie zdalne czeka w kolejce i zostanie ponowione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Relatórios de falhas está desativada. A exclusão remota está na fila e será tentada novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Параметр «Отчёты о сбоях» выключен. Удаление отправленных копий поставлено в очередь и будет выполнено повторно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kraschrapporter är av. Fjärradering har köats och görs ett nytt försök."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitlenme raporları kapalı. Uzak silme işlemi sıraya alındı ve yeniden denenecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Звіти про збої» вимкнено. Віддалене видалення додано в чергу, спробу буде повторено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "崩溃报告已关闭。远程删除已加入队列，将会重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當機報告已關閉。遠端刪除已排入佇列，並會重試。"
          }
        }
      }
    },
    "diagnostics.notice.receivedValidating" : {
