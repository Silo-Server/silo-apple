    "settings.profileLaunch.askEveryLaunch.detail" : {
      "comment" : "Explanation under the Every Time profile selection choice: in the Roku profile picker, on Android, and in Apple Settings > General profile selection (iPhone, iPad, Mac, Apple TV). Who's Watching is the name of the profile picker screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض «من يشاهد؟» كلما عدت إلى Silo."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Екранът „Кой гледа“ се показва всеки път, когато се върнете в Silo."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la pantalla Qui està mirant cada vegada que tornis a Silo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit obrazovku „Kdo se dívá“ při každém návratu do aplikace Silo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis ”Hvem ser med?”, hver gang du vender tilbage til Silo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt „Wer schaut?“ an, wann immer du zu Silo zurückkehrst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση της οθόνης «Ποιος παρακολουθεί;» κάθε φορά που επιστρέφετε στο Silo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show Who's Watching whenever you return to Silo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra “¿Quién está viendo?” cada vez que vuelvas a Silo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuva „Kes vaatab?“ näidatakse alati, kui naasete Silosse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä Kuka katsoo -näkymä aina, kun palaat Siloon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher « Qui regarde ? » chaque fois que vous revenez dans Silo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת המסך ”מי צופה?” בכל חזרה ל-Silo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo पर हर बार लौटने पर “कौन देख रहा है?” दिखाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži „Tko gleda?“ svaki put kad se vratite u Silo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megjeleníti a „Ki néz?” képernyőt, valahányszor visszatér a Silóba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan “Siapa yang menonton” setiap kali Anda kembali ke Silo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra “Chi guarda?” ogni volta che torni su Silo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloに戻るたびに、プロフィール選択画面を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo로 돌아올 때마다 “누가 보고 있나요?” 화면을 표시해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodyti ekraną „Kas žiūri?“ kaskart, kai grįžtate į „Silo“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rādīt ekrānu „Kas skatās?” ikreiz, kad atgriežaties Silo lietotnē."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan Siapa yang menonton setiap kali anda kembali ke Silo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis «Hvem ser på» hver gang du går tilbake til Silo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon “Wie kijkt er?” telkens als je terugkeert naar Silo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj ekran „Kto ogląda” przy każdym powrocie do aplikacji Silo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar Quem está assistindo sempre que você voltar ao Silo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar Quem está a ver? sempre que voltar ao Silo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se afișează ecranul „Cine vizionează?” de fiecare dată când reveniți în Silo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать экран «Кто смотрит?» при каждом возвращении в Silo."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť obrazovku Kto pozerá pri každom návrate do aplikácie Silo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži zaslon „Kdo gleda“ ob vsaki vrnitvi v aplikacijo Silo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa ”Vem tittar?” varje gång du återvänder till Silo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงหน้า “ใครกำลังดู” ทุกครั้งที่คุณกลับมาที่ Silo"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo’ya her döndüğünüzde “Kim izliyor?” ekranı gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати «Хто дивиться» щоразу, коли ви повертаєтеся в Silo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị “Ai đang xem” mỗi khi bạn quay lại Silo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次返回Silo时显示“谁在观看”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次回到 Silo 時都顯示「誰在觀看」。"
          }
        }
      }
    },
