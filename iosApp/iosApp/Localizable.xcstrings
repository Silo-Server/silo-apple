    "player.subtitleSync.noticeNoMatchDetail" : {
      "comment" : "Apple iOS/tvOS/macOS: second line of the subtitle sync card under \"… subtitles don't match the audio\". Android phone and TV player subtitle timing: same second line of the sync card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما تخص إصدارًا آخر. لم يتغير التوقيت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вероятно са за друго издание. Времето не е променено."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probablement són d’una altra versió. No s’ha canviat la sincronització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravděpodobně patří k jinému vydání. Časování se nezměnilo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De er sandsynligvis til en anden udgivelse. Timingen blev ikke ændret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie gehören wahrscheinlich zu einem anderen Release. Das Timing wurde nicht geändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πιθανότατα προορίζονται για άλλη έκδοση. Ο χρονισμός δεν άλλαξε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They're probably for another release. The timing wasn't changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probablemente son de otra versión. No se cambiaron los tiempos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Need on tõenäoliselt mõne teise väljalaske jaoks. Ajastust ei muudetud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se on luultavasti toiselle julkaisulle. Ajoitusta ei muutettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils sont probablement destinés à une autre version. Le minutage n’a pas été modifié."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כנראה שהן שייכות לגרסה אחרת. התזמון לא שונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये शायद किसी दूसरी रिलीज़ के हैं। टाइमिंग नहीं बदली गई।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vjerojatno su za drugo izdanje. Vrijeme nije promijenjeno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valószínűleg egy másik kiadáshoz készültek. Az időzítés nem változott."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemungkinan untuk rilis lain. Waktu tidak diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probabilmente sono per un’altra versione. I tempi non sono stati modificati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のリリース用の字幕と思われます。タイミングは変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 릴리스용 자막일 수 있어요. 타이밍은 변경되지 않았어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tikriausiai jie skirti kitam leidimui. Laikas nepakeistas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tie, iespējams, paredzēti citam izdevumam. Laiks netika mainīts."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sari kata ini mungkin untuk keluaran lain. Pemasaan tidak diubah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De er sannsynligvis for en annen utgivelse. Timingen ble ikke endret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze zijn waarschijnlijk voor een andere release. De timing is niet gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prawdopodobnie pochodzą z innego wydania. Czasu nie zmieniono."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provavelmente são de outra versão. A sincronia não foi alterada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provavelmente são de outra versão. Os tempos não foram alterados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probabil sunt pentru o altă versiune. Temporizarea nu a fost modificată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вероятно, они от другого релиза. Тайминг не изменён."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravdepodobne patria k inému vydaniu. Časovanie sa nezmenilo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verjetno so za drugo izdajo. Časovanje ni bilo spremenjeno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hör förmodligen till en annan utgåva. Tidsinställningen ändrades inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำบรรยายนี้อาจเป็นของเวอร์ชันอื่น เวลาไม่มีการเปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyük olasılıkla başka bir sürüme ait. Zamanlama değiştirilmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імовірно, вони для іншого релізу. Час не змінено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có thể phụ đề dành cho một bản phát hành khác. Thời gian chưa được thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些字幕可能适用于其他版本。时间未更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些字幕可能屬於其他版本。時間未變更。"
          }
        }
      }
    },
