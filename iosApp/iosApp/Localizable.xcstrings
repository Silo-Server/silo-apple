        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek, at %1$@ viser"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob %1$@ diesen Code anzeigt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε ότι η συσκευή %1$@ εμφανίζει"
