    "settingsManifest.playback.cellular_max_bitrate_kbps.description" : {
      "comment" : "Help text under the playback.cellular_max_bitrate_kbps setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحديد مقدار البيانات الذي يمكن أن يستخدمه التشغيل على بيانات الجوال أو أي اتصال محدود آخر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничава колко данни може да използва възпроизвеждането при мобилни данни или друга връзка с отчитане на трафика."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita les dades que pot fer servir la reproducció amb dades mòbils o una altra connexió de tarifa per ús."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omezí, kolik dat smí přehrávání využít na mobilních datech nebo jiném měřeném připojení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begræns, hvor meget data afspilningen må bruge på mobildata eller en anden forbindelse med dataforbrug."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenzt, wie viele Daten die Wiedergabe über mobile Daten oder eine andere getaktete Verbindung nutzen darf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όριο στα δεδομένα που μπορεί να χρησιμοποιεί η αναπαραγωγή μέσω δεδομένων κινητής ή άλλης σύνδεσης με χρέωση βάσει χρήσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap how much data playback may use on mobile data or another metered connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita cuántos datos puede usar la reproducción con datos móviles u otra conexión medida."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirab, kui palju andmeid esitus mobiilse andmeside või muu mahupõhise ühenduse kaudu kasutada tohib."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rajoita, kuinka paljon dataa toisto saa käyttää mobiilidatalla tai muulla käytön mukaan laskutettavalla yhteydellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite la quantité de données que la lecture peut utiliser en données mobiles ou sur une autre connexion limitée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגבלת כמות הנתונים שההפעלה יכולה לנצל בחבילת גלישה או בחיבור מוגבל אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मोबाइल डेटा या किसी अन्य मीटर्ड कनेक्शन पर प्लेबैक में डेटा इस्तेमाल की सीमा तय करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ograničava koliko podataka reprodukcija smije trošiti na mobilnim podacima ili drugoj naplatnoj vezi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korlátozza, mennyi adatot használhat a lejátszás mobilinternet vagy más forgalomkorlátos kapcsolat esetén."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batasi jumlah data yang boleh digunakan pemutaran pada data seluler atau koneksi terukur lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita la quantità di dati che la riproduzione può usare con la rete dati mobile o un’altra connessione a consumo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モバイルデータ通信などの従量制接続で再生に使うデータ量を制限します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모바일 데이터나 기타 종량제 연결에서 재생에 사용할 데이터양을 제한해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riboti, kiek duomenų atkūrimas gali naudoti per mobiliojo ryšio duomenis ar kitą apmokestinamą ryšį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ierobežo, cik daudz datu atskaņošana drīkst izmantot mobilajos datos vai citā savienojumā ar datu limitu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadkan jumlah data yang boleh digunakan oleh main balik pada data mudah alih atau sambungan bermeter lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrens hvor mye data avspillingen kan bruke på mobildata eller en annen tilkobling med databegrensning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperk hoeveel data het afspelen mag gebruiken via mobiele data of een andere verbinding met datalimiet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogranicz ilość danych, jaką może zużywać odtwarzanie przy danych mobilnych lub innym połączeniu taryfowym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita quantos dados a reprodução pode usar em dados móveis ou outra conexão limitada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limitar a quantidade de dados que a reprodução pode usar com dados móveis ou outra ligação com tráfego limitado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limitează cantitatea de date pe care o poate folosi redarea pe datele mobile sau pe altă conexiune contorizată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничить объём данных, который может использовать воспроизведение через мобильный интернет или другое лимитное подключение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obmedzí, koľko dát môže prehrávanie použiť cez mobilné dáta alebo iné spoplatnené pripojenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omeji, koliko podatkov lahko predvajanje porabi v mobilnem omrežju ali drugi povezavi z merjenim prenosom podatkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsa hur mycket data uppspelningen får använda via mobildata eller en annan anslutning med datapriser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำกัดปริมาณข้อมูลที่การเล่นใช้ได้เมื่อใช้ข้อมูลมือถือหรือการเชื่อมต่ออื่นที่คิดค่าบริการตามปริมาณ"
