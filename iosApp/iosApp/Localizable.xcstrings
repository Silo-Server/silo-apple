    "settingsManifest.playback.intro_skip_mode.description" : {
      "comment" : "Help text under the playback.intro_skip_mode setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يفعله Silo عند بدء المقدمة: تركها، أو عرض زر «تخطي المقدمة»، أو تخطيها مع إتاحة التراجع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was Silo tut, wenn ein Intro beginnt: nichts, die Schaltfläche „Intro überspringen“ anbieten oder es überspringen und Rückgängigmachen anbieten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What Silo does when an intro starts: leave it alone, offer a Skip Intro button, or skip it and offer an undo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué hace Silo cuando empieza una introducción: dejarla, ofrecer un botón Omitir introducción u omitirla y ofrecer la opción de deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que fait Silo au début d’une intro : ne rien faire, proposer un bouton « Passer l’intro », ou la passer et proposer d’annuler."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イントロが始まったときのSiloの動作です。何もしない、「イントロをスキップ」ボタンを表示する、またはスキップして元に戻す操作を表示する、から選びます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o Silo faz quando uma abertura começa: não fazer nada, oferecer o botão Pular abertura ou pular e oferecer a opção de desfazer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片头开始时Silo的处理方式：不做处理、显示“跳过片头”按钮，或直接跳过并提供撤销选项。"
          }
        }
      }
    },
