    "watchParty.hint.hostStarts" : {
      "comment" : "Roku: hint line shown to guests in a lobby. {host}: the host's display name. Apple (iPhone, iPad, Apple TV): same hint under the lobby's buttons. Android phone and TV Watch Party lobby: same line under a guest's buttons. 1: the host's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيبدأ %1$@ الفيلم عندما يجهز الجميع."
          }
