    "signIn.passwordChange.unconfirmedLead" : {
      "comment" : "Android phone Choose a new password screen, shown after signing in with a temporary password an admin set: text under Password not confirmed. Apple (iPhone, iPad, Mac): same text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo التحقق مما إذا تم حفظ كلمة المرور الجديدة. حاول مرة أخرى بعد قليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte nicht prüfen, ob dein neues Passwort gespeichert wurde. Versuche es gleich noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn't check whether your new password was saved. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo comprobar si se guardó tu contraseña nueva. Vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a pas pu vérifier si votre nouveau mot de passe a été enregistré. Réessayez dans un instant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloは新しいパスワードが保存されたかどうかを確認できませんでした。しばらくしてから、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo não conseguiu verificar se sua nova senha foi salva. Tente novamente em instantes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo无法确认你的新密码是否已保存。请稍后重试。"
          }
        }
      }
    },
