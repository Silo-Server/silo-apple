    "tvSignIn.declinedLead" : {
      "comment" : "Android TV text shown after a sign-in was declined, replacing the scan instructions, telling the user to request a new code. Apple TV: same text on the sign-in screen after a decline.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
