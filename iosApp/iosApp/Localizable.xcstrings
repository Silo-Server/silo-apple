    "home.recipe.esActor.description" : {
      "comment" : "One-line description of the Actor Spotlight preset in the Add row gallery (shared key `home.recipe.esActor.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسليط الضوء أسبوعيًا على ممثل في مكتبتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Седмичен акцент върху актьор от вашата библиотека."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada setmana destaquem algú del repartiment de la teva biblioteca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý týden představí herce z vaší knihovny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugentligt fokus på en skuespiller i dit bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Woche steht eine Person aus der Besetzung deiner Mediathek im Fokus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε εβδομάδα στο επίκεντρο ένας ηθοποιός της βιβλιοθήκης σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weekly spotlight on an actor in your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada semana destaca a un actor o actriz de tu biblioteca."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga nädal üks näitleja teie meediakogust fookuses."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joka viikko esittelyssä näyttelijä kirjastostasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque semaine, un ou une interprète de votre bibliothèque à l’honneur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זרקור שבועי על שחקן מהספרייה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर हफ़्ते आपकी लाइब्रेरी के किसी एक्टर पर खास नज़र।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki tjedan u fokusu je glumac iz vaše medijateke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetente egy színész a könyvtárából reflektorfényben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorotan mingguan untuk seorang aktor di perpustakaan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
