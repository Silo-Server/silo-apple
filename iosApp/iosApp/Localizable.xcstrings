    "companion.offerSigninTitle" : {
      "comment" : "Phone/tablet title of the offer to sign in a nearby TV, phrased as a question. {device}: the TV or Roku name; {server}: the server name. Apple (iPhone, iPad): same title on the nearby-TV pairing card.",
