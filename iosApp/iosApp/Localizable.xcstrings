    "watchParty.error.unavailable" : {
      "comment" : "Roku: error shown when the server version is too old to support synchronized Watch Party playback for this profile. Apple (iPhone, iPad, Apple TV): same error on the Watch Party hub.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج هذا الخادم إلى تحديث ليدعم التشغيل المتزامن في Watch Party بأمان على هذا الملف الشخصي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server potřebuje aktualizaci, aby na tomto profilu bezpečně podporoval synchronizované přehrávání Watch Party."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne server skal opdateres for at understøtte synkroniseret Watch Party-afspilning sikkert på denne profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server braucht ein Update, um synchronisierte Watch-Party-Wiedergabe für dieses Profil sicher zu unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server needs an update to support synchronized Watch Party playback safely on this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor necesita una actualización para admitir de forma segura la reproducción sincronizada de Watch Party en este perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä palvelin on päivitettävä, jotta synkronoitu Watch Party -toisto toimii turvallisesti tällä profiililla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur doit être mis à jour pour prendre en charge en toute sécurité la lecture synchronisée Watch Party sur ce profil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj poslužitelj treba ažuriranje kako bi sigurno podržavao sinkroniziranu reprodukciju u Watch Partyju na ovom profilu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo server richiede un aggiornamento per supportare in sicurezza la riproduzione sincronizzata di Watch Party su questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールでWatch Partyの同期再生を安全に行うには、サーバーのアップデートが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필에서 동기화된 Watch Party 재생을 안전하게 지원하려면 서버를 업데이트해야 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne serveren må oppdateres for å støtte synkronisert Watch Party-avspilling trygt på denne profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze server heeft een update nodig om gesynchroniseerd afspelen met Watch Party veilig te ondersteunen op dit profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten serwer wymaga aktualizacji, aby bezpiecznie obsługiwać synchronizowane odtwarzanie Watch Party w tym profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor precisa de uma atualização para oferecer com segurança a reprodução sincronizada da Watch Party neste perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для безопасного синхронного воспроизведения в Watch Party в этом профиле сервер нужно обновить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern behöver uppdateras för att säkert kunna synkronisera uppspelning i Watch Party för den här profilen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
