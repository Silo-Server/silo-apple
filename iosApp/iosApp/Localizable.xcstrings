        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องรีเซ็ตรหัสผ่าน ใช้แอป Silo บนมือถือหรือเว็บไซต์เพื่อตั้งรหัสผ่านใหม่ แล้วกลับมาที่นี่"
