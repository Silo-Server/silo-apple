        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo에서 인트로를 감지할 수 있으면 자동으로 건너뛰어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatiškai praleisti įžangas, kai „Silo“ gali jas aptikti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automātiski izlaiž ievadus, ja Silo tos spēj noteikt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkau intro secara automatik apabila Silo dapat mengesannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hopp automatisk forbi introer når Silo kan oppdage dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla intro’s automatisch over wanneer Silo ze kan detecteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie przeskakuj czołówki, gdy Silo potrafi je wykryć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pula as aberturas automaticamente quando o Silo consegue detectá-las."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltar automaticamente as introduções quando o Silo as consegue detetar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sare automat peste introduceri când Silo le poate detecta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически пропускать вступления, когда Silo может их распознать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky preskočí úvody, keď ich Silo dokáže rozpoznať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samodejno preskoči uvode, kadar jih Silo zazna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppa automatiskt förbi intron när Silo kan identifiera dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้ามอินโทรโดยอัตโนมัติเมื่อ Silo ตรวจพบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo algılayabildiğinde girişleri otomatik olarak atlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично пропускати заставки, коли Silo може їх розпізнати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động bỏ qua đoạn mở đầu khi Silo phát hiện được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo检测到片头时自动跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo 偵測到片頭時自動略過。"
          }
        }
      }
    },
