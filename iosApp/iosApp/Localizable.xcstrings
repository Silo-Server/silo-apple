    "settings.signIn.connectFooter.browser" : {
      "comment" : "Apple Settings > Sign-in > Connect (iPhone, iPad, Mac): note under the Silo password when connecting a provider whose sign-in opens in the browser (OIDC). {provider}: the provider's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكّد كلمة مرور Silo، ثم سجّل الدخول باستخدام %1$@. بعد الربط، ستسجّل الدخول باستخدام %1$@ بدلًا من كلمة المرور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige dein Silo-Passwort und melde dich dann mit %1$@ an. Nach dem Verbinden meldest du dich mit %1$@ statt mit deinem Passwort an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm your Silo password, then sign in with %1$@. After connecting, you sign in with %1$@ instead of your password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma tu contraseña de Silo y luego inicia sesión con %1$@. Después de conectarlo, inicias sesión con %1$@ en lugar de tu contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmez votre mot de passe Silo, puis connectez-vous avec %1$@. Une fois la liaison effectuée, vous vous connectez avec %1$@ au lieu de votre mot de passe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloのパスワードを確認してから、%1$@でサインインしてください。連携後は、パスワードの代わりに%1$@でサインインします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme sua senha do Silo e depois entre com %1$@. Depois de conectar, você entra com %1$@ em vez da sua senha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认你的Silo密码，然后使用%1$@登录。关联后，你将使用%1$@登录，而不是使用密码。"
          }
        }
      }
    },
    "settings.signIn.connectFooter.directory" : {
      "comment" : "Apple Settings > Sign-in > Connect (iPhone, iPad, Mac): note under the Silo password when connecting a directory provider (LDAP). {provider}: the provider's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل كلمة مرور Silo للتأكيد. بعد الربط، ستسجّل الدخول باسم المستخدم وكلمة المرور في %1$@ بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib zur Bestätigung dein Silo-Passwort ein. Nach dem Verbinden meldest du dich stattdessen mit deinem %1$@-Benutzernamen und -Passwort an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Silo password to confirm. After connecting, you sign in with your %1$@ username and password instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe tu contraseña de Silo para confirmar. Después de conectarlo, inicias sesión con tu usuario y contraseña de %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez votre mot de passe Silo pour confirmer. Une fois la liaison effectuée, vous vous connectez plutôt avec votre nom d’utilisateur et votre mot de passe %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認のため、Siloのパスワードを入力してください。連携後は、%1$@のユーザー名とパスワードでサインインします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite sua senha do Silo para confirmar. Depois de conectar, você passa a entrar com seu nome de usuário e senha de %1$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入你的Silo密码以确认。关联后，你将改用%1$@用户名和密码登录。"
          }
        }
      }
    },
    "settings.signIn.connectFooter.network" : {
      "comment" : "Apple Settings > Sign-in > Connect (iPhone, iPad, Mac): note under the Silo password when connecting a network provider such as Tailscale, owner unknown; the password stops working afterwards. {provider}: the provider's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل كلمة مرور Silo للتأكيد. يربط هذا حساب %1$@ الذي ينتمي إليه هذا الجهاز. بعد الربط، ستسجّل الدخول باستخدام %1$@ بدلًا من كلمة المرور، وفقط عند فتح هذا الخادم عبر عنوانه في %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib zur Bestätigung dein Silo-Passwort ein. Dadurch wird das %1$@-Konto verbunden, zu dem dieses Gerät gehört. Nach dem Verbinden meldest du dich mit %1$@ statt mit deinem Passwort an, und zwar nur, wenn du diesen Server über seine %1$@-Adresse öffnest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Silo password to confirm. This connects the %1$@ account this device belongs to. After connecting, you sign in with %1$@ instead of your password, and only when you open this server at its %1$@ address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe tu contraseña de Silo para confirmar. Esto conecta la cuenta de %1$@ a la que pertenece este dispositivo. Después de conectarla, inicias sesión con %1$@ en lugar de tu contraseña, y solo cuando abres este servidor en su dirección de %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez votre mot de passe Silo pour confirmer. Cela connecte le compte %1$@ auquel appartient cet appareil. Une fois la liaison effectuée, vous vous connectez avec %1$@ au lieu de votre mot de passe, et uniquement lorsque vous ouvrez ce serveur à son adresse %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認のため、Siloのパスワードを入力してください。このデバイスが属する%1$@アカウントを連携します。連携後は、パスワードの代わりに%1$@でサインインします。ただし、サインインできるのはこのサーバーを%1$@のアドレスで開いた場合のみです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite sua senha do Silo para confirmar. Isso conecta a conta de %1$@ à qual este dispositivo pertence. Depois de conectar, você entra com %1$@ em vez da sua senha, e somente quando abrir este servidor pelo endereço de %1$@ dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入你的Silo密码以确认。这将关联此设备所属的%1$@账户。关联后，你将使用%1$@登录，而不是使用密码，且仅在通过%1$@地址打开此服务器时可用。"
          }
        }
      }
    },
    "settings.signIn.connectFooter.networkKeepsPassword" : {
      "comment" : "Apple Settings > Sign-in > Connect (iPhone, iPad, Mac): note under the Silo password when connecting a network provider such as Tailscale, owner unknown, on a server that keeps the password. {provider}: the provider's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل كلمة مرور Silo للتأكيد. يربط هذا حساب %1$@ الذي ينتمي إليه هذا الجهاز. يمكنك بعد ذلك تسجيل الدخول باستخدام %1$@ أو كلمة المرور. لا يعمل تسجيل الدخول عبر %1$@ إلا عند فتح هذا الخادم عبر عنوانه في %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib zur Bestätigung dein Silo-Passwort ein. Dadurch wird das %1$@-Konto verbunden, zu dem dieses Gerät gehört. Danach kannst du dich mit %1$@ oder deinem Passwort anmelden. Die Anmeldung mit %1$@ funktioniert nur, wenn du diesen Server über seine %1$@-Adresse öffnest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Silo password to confirm. This connects the %1$@ account this device belongs to. You can then sign in with %1$@ or your password. %1$@ sign-in works only when you open this server at its %1$@ address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe tu contraseña de Silo para confirmar. Esto conecta la cuenta de %1$@ a la que pertenece este dispositivo. Luego podrás iniciar sesión con %1$@ o con tu contraseña. El inicio de sesión con %1$@ solo funciona cuando abres este servidor en su dirección de %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez votre mot de passe Silo pour confirmer. Cela connecte le compte %1$@ auquel appartient cet appareil. Vous pourrez ensuite vous connecter avec %1$@ ou votre mot de passe. La connexion %1$@ ne fonctionne que lorsque vous ouvrez ce serveur à son adresse %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認のため、Siloのパスワードを入力してください。このデバイスが属する%1$@アカウントを連携します。連携後は、%1$@またはパスワードでサインインできます。%1$@でのサインインは、このサーバーを%1$@のアドレスで開いた場合にのみ使えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite sua senha do Silo para confirmar. Isso conecta a conta de %1$@ à qual este dispositivo pertence. Depois, você pode entrar com %1$@ ou com sua senha. O login com %1$@ só funciona quando você abre este servidor pelo endereço de %1$@ dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入你的Silo密码以确认。这将关联此设备所属的%1$@账户。之后你可以使用%1$@或密码登录。%1$@登录仅在通过%1$@地址打开此服务器时可用。"
          }
        }
      }
    },
