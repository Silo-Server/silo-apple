          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synlige målene i rekkefølge, delt av klienter av samme type."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geordende zichtbare bestemmingen die gelijksoortige clients delen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
