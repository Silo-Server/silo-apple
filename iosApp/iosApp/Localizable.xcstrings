          }
        }
      }
    },
    "pairing.summary.updateRequired" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: result line when the server or an app is too old. {server}: the server's name, followed by \" — \" and the account name when there is one (for example Home — sam).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: يجب تحديث الخادم أو Silo أولًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: първо трябва да се актуализира сървърът или Silo."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: primer cal actualitzar el servidor o Silo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: server nebo Silo je nejdřív potřeba aktualizovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: serveren eller Silo skal først opdateres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Der Server oder Silo muss zuerst aktualisiert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: ο διακομιστής ή το Silo πρέπει πρώτα να ενημερωθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: the server or Silo needs to be updated first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: primero hay que actualizar el servidor o Silo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: server või Silo vajab esmalt värskendamist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: palvelin tai Silo on päivitettävä ensin."
          }
        },
        "fr" : {
          "stringUnit" : {
