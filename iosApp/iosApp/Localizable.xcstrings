    "detail.episodes.loadMoreFailed" : {
      "comment" : "Apple tvOS: message under the episode rail on a series page when the next or previous season's episodes failed to load. Moving focus away and back retries.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل المزيد من الحلقات. انتقل بعيدًا ثم عُد لإعادة المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можаха да се заредят още епизоди. Преместете фокуса и се върнете, за да опитате отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’han pogut carregar més episodis. Desplaça’t fora i torna-hi per tornar-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Další díly se nepodařilo načíst. Pro nový pokus přejděte jinam a zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke indlæse flere afsnit. Flyt væk og tilbage for at prøve igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere Folgen konnten nicht geladen werden. Wechsle den Fokus und kehre zurück, um es erneut zu versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η φόρτωση περισσότερων επεισοδίων. Μετακινηθείτε αλλού και επιστρέψτε για νέα προσπάθεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load more episodes. Move away and back to retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar más episodios. Mueve el foco fuera y vuelve para reintentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rohkemate osade laadimine ebaõnnestus. Uuesti proovimiseks liikuge eemale ja tagasi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää jaksoja ei voitu ladata. Yritä uudelleen siirtymällä pois ja takaisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger d’autres épisodes. Déplacez la sélection puis revenez pour réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לטעון פרקים נוספים. כדי לנסות שוב, יש להעביר את המיקוד למקום אחר ולחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "और एपिसोड लोड नहीं किए जा सके। फिर से कोशिश करने के लिए फ़ोकस हटाकर वापस लाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće učitati još epizoda. Pomaknite fokus i vratite ga da biste pokušali ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült további epizódokat betölteni. Az újrapróbáláshoz lépjen el, majd vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat memuat episode lainnya. Pindah lalu kembali untuk mencoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare altri episodi. Spostati altrove e torna qui per riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エピソードをさらに読み込めませんでした。フォーカスを移動して戻すと再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에피소드를 더 불러오지 못했어요. 다른 곳으로 이동했다가 돌아오면 다시 시도해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko įkelti daugiau epizodų. Perkelkite fokusą kitur ir grįžkite, kad bandytumėte dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās ielādēt vairāk epizožu. Pārvietojiet fokusu prom un atpakaļ, lai mēģinātu vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat memuatkan lebih banyak episod. Alihkan fokus dan kembali untuk mencuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke laste inn flere episoder. Gå bort og tilbake for å prøve igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan niet meer afleveringen laden. Verplaats de focus weg en weer terug om het opnieuw te proberen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wczytać kolejnych odcinków. Przenieś zaznaczenie i wróć, aby ponowić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar mais episódios. Saia e volte para tentar novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar mais episódios. Mude o foco e volte para tentar novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-au putut încărca mai multe episoade. Mutați focalizarea în altă parte și reveniți pentru a reîncerca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить другие серии. Переместите фокус и верните его, чтобы повторить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ďalšie epizódy sa nepodarilo načítať. Ak to chcete skúsiť znova, presuňte výber inam a späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni bilo mogoče naložiti več epizod. Premaknite se stran in nazaj, da poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att läsa in fler avsnitt. Flytta fokus bort och tillbaka för att försöka igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหลดตอนเพิ่มเติมไม่ได้ ย้ายโฟกัสออกแล้วกลับมาเพื่อลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha fazla bölüm yüklenemedi. Yeniden denemek için başka bir öğeye gidip geri dönün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося завантажити більше епізодів. Перемістіть фокус і поверніться, щоб повторити спробу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể tải thêm tập. Di chuyển ra rồi quay lại để thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载更多集。移开焦点再移回即可重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法載入更多集數。請將焦點移開再移回以重試。"
          }
        }
      }
    },
