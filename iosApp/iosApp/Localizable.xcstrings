        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy wznawianiu częściowo obejrzanej pozycji cofa o tyle, aby przypomnieć kontekst. 0 wyłącza tę funkcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volta esse tanto ao retomar um item assistido em parte, para relembrar o contexto. 0 desativa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuar este tempo ao retomar um item parcialmente visto, para recuperar o contexto. 0 desativa esta opção."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derulați înapoi cu atât la reluarea unui element vizionat parțial, pentru a reveni în context. 0 dezactivează opțiunea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При возобновлении частично просмотренного объекта перематывать назад на это время, чтобы восстановить контекст. 0 — выключено."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri pokračovaní v čiastočne pozretej položke sa posunie o toľkoto späť, aby ste si pripomenuli kontext. Hodnota 0 to vypne."
