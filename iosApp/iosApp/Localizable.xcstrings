        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está eligiendo qué ver. Lo verás aquí en cuanto elija."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ choisit quoi regarder. Vous le verrez ici dès que ce sera fait."
