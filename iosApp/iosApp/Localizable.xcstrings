    "profiles.error.passwordReset" : {
      "comment" : "TV: error on the Who's watching? screen when the account has a temporary password; the TV has no form to change it. Apple TV: same message on any screen the server refuses because the account has a temporary password.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب إعادة تعيين كلمة المرور. استخدم تطبيق Silo للهاتف أو موقع الويب لتعيين كلمة مرور جديدة، ثم عُد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Passwort muss zurückgesetzt werden. Lege in der mobilen Silo-App oder auf der Website ein neues fest und komm dann zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your password needs to be reset. Use the Silo mobile app or website to set a new one, then come back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes que restablecer tu contraseña. Usa la app de Silo para teléfonos o el sitio web para crear una nueva y luego vuelve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe doit être réinitialisé. Utilisez l’app mobile ou le site web Silo pour en définir un nouveau, puis revenez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードのリセットが必要です。Siloのモバイルアプリまたはウェブサイトで新しいパスワードを設定してから、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua senha precisa ser redefinida. Use o app Silo para celular ou o site para definir uma nova e depois volte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密码需要重置。请使用Silo手机应用或网站设置新密码，然后再回来。"
          }
        }
      }
    },
