    "settings.playback.hdrFooter" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: first sentence of the Streaming footer, explaining the HDR switch. SDR is standard dynamic range.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تعطيل HDR، تُرسَل مقاطع الفيديو التي يحوّلها الخادم لهذا الجهاز بتنسيق SDR، دون Dolby Vision."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При изключена опция HDR видеоклиповете, които сървърът преобразува за това устройство, се изпращат в SDR, без Dolby Vision."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb l’HDR desactivat, els vídeos que el servidor converteix per a aquest dispositiu s’envien en SDR, sense Dolby Vision."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je HDR vypnuto, videa, která server pro toto zařízení převádí, se odesílají v SDR, bez Dolby Vision."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med HDR slået fra sendes videoer, som serveren konverterer til denne enhed, i SDR uden Dolby Vision."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn HDR aus ist, werden Videos, die der Server für dieses Gerät umwandelt, in SDR ohne Dolby Vision gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με ανενεργό το HDR, τα βίντεο που μετατρέπει ο διακομιστής για αυτή τη συσκευή αποστέλλονται σε SDR, χωρίς Dolby Vision."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With HDR off, videos the server converts for this device are sent in SDR, without Dolby Vision."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con HDR desactivado, los videos que el servidor convierte para este dispositivo se envían en SDR, sin Dolby Vision."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui HDR on väljas, saadetakse videod, mille server selle seadme jaoks teisendab, SDR-vormingus ja ilma Dolby Visionita."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun HDR on pois, videot, jotka palvelin muuntaa tälle laitteelle, lähetetään SDR-muodossa ilman Dolby Visionia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le HDR désactivé, les vidéos que le serveur convertit pour cet appareil sont envoyées en SDR, sans Dolby Vision."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כש-HDR כבוי, סרטונים שהשרת ממיר עבור המכשיר הזה נשלחים ב-SDR, ללא Dolby Vision."
          }
        },
