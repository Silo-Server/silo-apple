    "signIn.error.emailInUse" : {
      "comment" : "Error on the Roku sign-in screen: an account with this email already exists and an admin must link it to the external sign-in provider. Apple (iPhone, iPad, Mac, Apple TV): same sign-in provider error (browser, network and password sign-in).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد حساب بهذا البريد الإلكتروني بالفعل. اطلب من المسؤول ربطه بمزود تسجيل الدخول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt bereits ein Konto mit dieser E-Mail-Adresse. Bitte einen Admin, es mit dem Anmeldeanbieter zu verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
