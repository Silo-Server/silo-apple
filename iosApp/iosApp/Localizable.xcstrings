    "personal.favorites.emptyAnyBody" : {
      "comment" : "Apple tvOS: supporting line under the empty-state heading of a Favorites tab with no titles.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف عناصر إلى المفضلة من أي صفحة تفاصيل وستظهر هنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte oblíbené na libovolné stránce s podrobnostmi a zobrazí se zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj favoritter fra en hvilken som helst detaljeside, så vises de her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Favoriten auf einer beliebigen Detailseite hinzu, dann erscheinen sie hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add favorites from any detail page and they will appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade favoritos desde cualquier página de detalles y aparecerán aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää suosikkeja miltä tahansa tietosivulta, niin ne näkyvät täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des favoris depuis n’importe quelle page de détails et ils apparaîtront ici."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte favorite s bilo koje stranice s detaljima i pojavit će se ovdje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi preferiti da qualsiasi pagina dei dettagli e compariranno qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細ページからお気に入りに追加すると、ここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 상세 페이지에서든 즐겨찾기에 추가하면 여기에 표시돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til favoritter fra en hvilken som helst detaljside, så vises de her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg favorieten toe vanaf een willekeurige detailpagina en ze verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj ulubione na dowolnej stronie szczegółów, a pojawią się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione favoritos em qualquer página de detalhes e eles aparecerão aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте в избранное на любой странице с подробностями — всё появится здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till favoriter från valfri detaljsida så visas de här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir ayrıntı sayfasından favori ekleyin, burada görünürler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте вміст до обраного на будь-якій сторінці з подробицями, і він з’явиться тут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任意详情页添加收藏后，它们会显示在这里。"
