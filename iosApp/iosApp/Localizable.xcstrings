    "upNext.shuffleContinueFailed" : {
      "comment" : "Notice shown when the app failed to continue the shuffle to the next item, on Roku, Android phone and TV, and in the web player's shuffle Playing Next screen. On Apple iOS, tvOS and macOS it appears in the Up Next panel during shuffle when the next item could not be fetched.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
