    "cast.replace.profileWatching" : {
      "comment" : "Android phone: Remote Control \"Replace what's playing?\" dialog; message when another profile's title is on the TV. {profile}: that profile's name; {title}: the title, such as Season 1 · Oak Street; {tv}: the TV's name. Apple iOS: Remote Control \"Replace What's Playing?\" alert message.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشاهد %1$@ «%2$@» على %3$@. هل تريد تشغيل اختيارك بدلًا منه؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil %1$@ sleduje %2$@ na televizi %3$@. Přehrát místo toho váš obsah?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ser %2$@ på %3$@. Vil du afspille dit i stedet?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ schaut gerade %2$@ auf %3$@. Stattdessen deins abspielen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is watching %2$@ on %3$@. Play yours instead?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está viendo %2$@ en %3$@. ¿Quieres reproducir lo tuyo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ katsoo kohdetta %2$@ laitteessa %3$@. Toistetaanko omasi sen sijaan?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ regarde %2$@ sur %3$@. Lire le vôtre à la place ?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gleda %2$@ na uređaju %3$@. Želite li umjesto toga reproducirati svoj sadržaj?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sta guardando %2$@ su %3$@. Vuoi riprodurre il tuo titolo al suo posto?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が%3$@で%2$@を視聴中です。代わりに再生しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@님이 %3$@에서 %2$@ 시청 중이에요. 대신 내 콘텐츠를 재생할까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ser på %2$@ på %3$@. Vil du spille av ditt i stedet?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kijkt naar %2$@ op %3$@. Wil je in plaats daarvan jouw titel afspelen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil %1$@ ogląda tytuł %2$@ na telewizorze %3$@. Odtworzyć zamiast tego twój?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está assistindo a %2$@ em %3$@. Reproduzir o seu no lugar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль %1$@ смотрит «%2$@» на телевизоре %3$@. Воспроизвести ваше видео вместо этого?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tittar på %2$@ på %3$@. Vill du spela upp ditt i stället?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %3$@ cihazında %2$@ içeriğini izliyor. Bunun yerine sizinkini oynatmak ister misiniz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ дивиться %2$@ на %3$@. Відтворити ваше?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@正在%3$@上观看%2$@。要改为播放你的内容吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 正在 %3$@ 上觀看 %2$@。要改為播放你的內容嗎？"
          }
        }
      }
    },
    "cast.replace.someoneWatching" : {
      "comment" : "Android phone: Remote Control \"Replace what's playing?\" dialog; message when another person's title is on the TV and the TV did not name the profile. {title}: the title, such as Season 1 · Oak Street; {tv}: the TV's name. Apple iOS: Remote Control \"Replace What's Playing?\" alert message when the TV sent no profile name.",
