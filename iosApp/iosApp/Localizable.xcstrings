    "remote.picker.noneFoundHint" : {
      "comment" : "Apple iOS: Remote Control TV picker sheet; text under \"No Silo TVs Found\".",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا أجهزة التلفزيون المتصلة بهذا الخادم عندما يكون Silo مفتوحًا عليها. على جهاز Roku، افتح Silo باستخدام جهاز التحكم عن بُعد الخاص بـ Roku."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телевизорите на този сървър се показват тук, докато приложението Silo е отворено на тях. На Roku отворете Silo с дистанционното на Roku."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les TV d’aquest servidor apareixen aquí mentre tenen Silo obert. En un Roku, obre Silo amb el comandament del Roku."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde se zobrazí televize na tomto serveru, na kterých je otevřená aplikace Silo. Na zařízení Roku otevřete Silo ovladačem Roku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tv’er på denne server vises her, mens Silo er åben på dem. På en Roku skal du åbne Silo med Roku-fjernbetjeningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernseher auf diesem Server erscheinen hier, solange Silo auf ihnen geöffnet ist. Öffne Silo auf einem Roku mit der Roku-Fernbedienung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τηλεοράσεις αυτού του διακομιστή εμφανίζονται εδώ όσο το Silo είναι ανοιχτό σε αυτές. Σε Roku, ανοίξτε το Silo με το τηλεχειριστήριο του Roku."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TVs on this server appear here while Silo is open on them. On a Roku, open Silo with the Roku remote."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las TV de este servidor aparecen aquí mientras tengan Silo abierto. En un Roku, abre Silo con el control remoto del Roku."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle serveri telerid kuvatakse siin, kui Silo on neis avatud. Rokus avage Silo Roku puldiga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän palvelimen tv:t näkyvät tässä, kun Silo on niissä auki. Avaa Silo Rokussa Rokun kaukosäätimellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les TV de ce serveur apparaissent ici lorsque Silo y est ouvert. Sur un Roku, ouvrez Silo avec la télécommande du Roku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טלוויזיות בשרת הזה מופיעות כאן כש-Silo פתוח בהן. ב-Roku, יש לפתוח את Silo באמצעות השלט של ה-Roku."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सर्वर के जिन टीवी पर Silo खुला है, वे यहाँ दिखते हैं। Roku पर, Roku रिमोट से Silo खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Televizori na ovom poslužitelju prikazuju se ovdje dok je na njima otvoren Silo. Na uređaju Roku otvorite Silo daljinskim upravljačem za Roku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ehhez a szerverhez tartozó TV-k itt jelennek meg, amíg a Silo meg van nyitva rajtuk. Rokun nyissa meg a Silót a Roku távirányítójával."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV di server ini muncul di sini saat Silo terbuka di TV tersebut. Di Roku, buka Silo dengan remote Roku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le TV di questo server compaiono qui quando Silo è aperto. Su un Roku, apri Silo con il telecomando del Roku."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーのテレビは、Siloを開いている間ここに表示されます。Rokuの場合は、RokuのリモコンでSiloを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버의 TV는 Silo가 열려 있을 때 여기에 표시돼요. Roku에서는 Roku 리모컨으로 Silo를 여세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šio serverio televizoriai rodomi čia, kai juose atidaryta programa „Silo“. „Roku“ įrenginyje atidarykite „Silo“ „Roku“ pultu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī servera televizori tiek parādīti šeit, kamēr tajos ir atvērta Silo lietotne. Roku ierīcē atveriet Silo ar Roku pulti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV pada pelayan ini muncul di sini semasa Silo dibuka padanya. Pada Roku, buka Silo dengan alat kawalan jauh Roku."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV-er på denne serveren vises her når Silo er åpen på dem. På en Roku åpner du Silo med Roku-fjernkontrollen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tv’s op deze server verschijnen hier zolang Silo erop geopend is. Open Silo op een Roku met de Roku-afstandsbediening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telewizory na tym serwerze pojawiają się tutaj, gdy jest na nich otwarta aplikacja Silo. Na urządzeniu Roku otwórz Silo pilotem Roku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As TVs deste servidor aparecem aqui enquanto o Silo estiver aberto nelas. Em um Roku, abra o Silo com o controle remoto do Roku."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As TVs neste servidor aparecem aqui enquanto o Silo estiver aberto nelas. Num Roku, abra o Silo com o comando do Roku."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Televizoarele de pe acest server apar aici cât timp Silo este deschis pe ele. Pe un Roku, deschideți Silo cu telecomanda Roku."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появляются телевизоры этого сервера, на которых открыто приложение Silo. На Roku откройте Silo с помощью пульта Roku."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Televízory na tomto serveri sa tu zobrazia, keď je na nich otvorená aplikácia Silo. Na zariadení Roku otvorte Silo diaľkovým ovládačom Roku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukaj so prikazani televizorji na tem strežniku, na katerih je odprta aplikacija Silo. Na napravi Roku odprite Silo z daljinskim upravljalnikom Roku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tv-apparater på den här servern visas här medan Silo är öppet på dem. På en Roku öppnar du Silo med Roku-fjärrkontrollen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทีวีบนเซิร์ฟเวอร์นี้จะแสดงที่นี่ขณะที่เปิด Silo อยู่ สำหรับ Roku ให้เปิด Silo ด้วยรีโมต Roku"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucudaki TV’ler, üzerlerinde Silo açıkken burada görünür. Roku’da Silo’yu Roku kumandasıyla açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телевізори на цьому сервері з’являються тут, коли на них відкрито Silo. На Roku відкрийте Silo за допомогою пульта Roku."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các TV trên máy chủ này sẽ hiển thị ở đây khi Silo đang mở trên đó. Trên Roku, mở Silo bằng điều khiển Roku."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器上的电视打开Silo时会显示在这里。在Roku上，请用Roku遥控器打开Silo。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此伺服器上的電視開啟 Silo 時會顯示在這裡。若是 Roku，請用 Roku 遙控器開啟 Silo。"
          }
        }
      }
    },
    "remote.picker.rokuMissing" : {
      "comment" : "Apple iOS: Remote Control TV picker sheet; hint when the Roku the phone last controlled did not turn up. 1: the Roku's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا ترى %1$@؟ افتح Silo على جهاز Roku."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не виждате телевизора %1$@? Отворете Silo на вашето Roku."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No veus %1$@? Obre Silo al Roku."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevidíte zařízení %1$@? Otevřete aplikaci Silo na zařízení Roku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan du ikke se %1$@? Åbn Silo på din Roku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wird nicht angezeigt? Öffne Silo auf deinem Roku."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βλέπετε την τηλεόραση %1$@; Ανοίξτε το Silo στο Roku σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't see %1$@? Open Silo on your Roku."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿No ves %1$@? Abre Silo en tu Roku."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas telerit %1$@ pole näha? Avage Silo oma Rokus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eikö laitetta %1$@ näy? Avaa Silo Rokussasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne voyez pas %1$@ ? Ouvrez Silo sur votre Roku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המכשיר %1$@ לא מופיע? יש לפתוח את Silo ב-Roku."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roku %1$@ नहीं दिख रहा? अपने Roku पर Silo खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne vidite uređaj %1$@? Otvorite Silo na uređaju Roku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem találja a(z) %1$@ eszközt? Nyissa meg a Silót a Rokun."
          }
