    "diagnostics.availability.offlineDetail" : {
      "comment" : "Footer under the Diagnostics settings Feature State section when the server is offline. Shown on Android phone and Apple (iPhone, iPad).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم عرض آخر حالة معروفة للتشخيص. تبقى التقارير على هذا الجهاز ما دام الخادم غير متصل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje se poslední známý stav diagnostiky. Zprávy zůstávají v tomto zařízení, dokud je server offline."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser den senest kendte diagnosticeringstilstand. Rapporter bliver på denne enhed, mens serveren er offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der zuletzt bekannte Diagnosestatus wird angezeigt. Berichte bleiben auf diesem Gerät, solange der Server offline ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Showing the last known diagnostics state. Reports stay on this device while the server is offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra el último estado conocido de los diagnósticos. Los informes permanecen en este dispositivo mientras el servidor está sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytetään viimeisin tunnettu diagnostiikan tila. Raportit pysyvät tällä laitteella, kun palvelimeen ei saada yhteyttä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichage du dernier état connu des diagnostics. Les rapports restent sur cet appareil tant que le serveur est hors ligne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje se posljednje poznato stanje dijagnostike. Izvješća ostaju na ovom uređaju dok je poslužitelj izvan mreže."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene mostrato l’ultimo stato noto della diagnostica. I report restano su questo dispositivo mentre il server è offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後に確認された診断の状態を表示しています。サーバーがオフラインの間、レポートはこのデバイスに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막으로 확인된 진단 상태를 표시하고 있어요. 서버가 오프라인인 동안 보고서는 이 기기에 보관돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser siste kjente diagnostikkstatus. Rapporter blir værende på denne enheten mens serveren er frakoblet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De laatst bekende diagnostiekstatus wordt weergegeven. Rapporten blijven op dit apparaat zolang de server offline is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlany jest ostatni znany stan diagnostyki. Gdy serwer jest offline, raporty pozostają na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando o último estado conhecido do diagnóstico. Os relatórios ficam neste dispositivo enquanto o servidor estiver offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показано последнее известное состояние диагностики. Пока сервер не в сети, отчёты хранятся на этом устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar senast kända diagnostikstatus. Rapporterna stannar på den här enheten medan servern är offline."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilinen son tanılama durumu gösteriliyor. Sunucu çevrimdışıyken raporlar bu cihazda kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показано останній відомий стан діагностики. Звіти зберігаються на цьому пристрої, поки сервер офлайн."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在显示上次已知的诊断状态。服务器离线期间，报告会保留在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在顯示最後已知的診斷狀態。伺服器離線期間，報告會保留在此裝置上。"
          }
        }
      }
    },
