          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Smartphone oder Tablet hat für %1$@ eine Adresse gesendet, unter der ein anderer Server geantwortet hat. Prüfe den Server auf deinem Smartphone oder Tablet oder füge deinen Server manuell hinzu."
          }
