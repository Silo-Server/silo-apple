    "error.field.invalid_sort_field" : {
      "comment" : "Error shown next to or about one request field when the server reports the field-error code `invalid_sort_field`. Clients show it instead of the server's English detail in a translated interface. The server also sends this code when a list that sorts by one field at a time is given several.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد الفرز حقلًا لا تفرز هذه العملية حسبه، أو يحدد حقلًا مرتين."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сортирането посочва поле, по което тази операция не сортира, или посочва едно поле два пъти."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ordenació indica un camp pel qual aquesta operació no ordena, o n’indica un dues vegades."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řazení uvádí pole, podle kterého tato operace neřadí, nebo jedno pole uvádí dvakrát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorteringen angiver et felt, som denne handling ikke sorterer efter, eller angiver det samme felt to gange."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sortierung nennt ein Feld, nach dem dieser Vorgang nicht sortiert, oder nennt ein Feld doppelt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ταξινόμηση ορίζει ένα πεδίο με το οποίο δεν ταξινομεί αυτή η λειτουργία ή ορίζει το ίδιο πεδίο δύο φορές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sort names a field this operation does not sort by, or names one twice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El orden indica un campo por el que esta operación no ordena, o repite uno."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortimine nimetab välja, mille järgi see toiming ei sordi, või nimetab sama välja kaks korda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lajittelu viittaa kenttään, jonka mukaan tätä toimintoa ei voi lajitella, tai samaan kenttään kahdesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tri désigne un champ que cette opération ne permet pas de trier, ou désigne le même champ deux fois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המיון מציין שדה שהפעולה הזו לא ממיינת לפיו, או מציין שדה פעמיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सॉर्ट में ऐसा फ़ील्ड दिया गया है जिसके हिसाब से यह ऑपरेशन सॉर्ट नहीं करता, या कोई फ़ील्ड दो बार दिया गया है।"
