    "topBar.tabSpoken" : {
      "comment" : "Apple TV: spoken label of a tab in the top bar. {title}: the tab's name, such as Home or Movies; {position}: the tab's place counted from the left, starting at 1; {total}: the number of tabs.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@، علامة تبويب، %2$lld من %3$lld"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, Tab, %2$lld von %3$lld"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, tab, %2$lld of %3$lld"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, pestaña, %2$lld de %3$lld"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, onglet, %2$lld sur %3$lld"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、タブ、%3$lld個中%2$lld個目"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, aba, %2$lld de %3$lld"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，标签页，第%2$lld个，共%3$lld个"
          }
        }
      }
    },
    "tvPair.approval.anotherAccountMessage" : {
      "comment" : "Apple (iPhone, iPad) Sign in a TV approval card: message of the \"Approve as another account?\" dialog. {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر حساب %1$@ الذي سيسجّل الدخول على التلفزيون. تبقى الحسابات على هذا الجهاز مسجّلة الدخول، ويبقى رمز التلفزيون جاهزًا للموافقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, mit welchem %1$@-Konto der Fernseher angemeldet wird. Die Konten auf diesem Gerät bleiben angemeldet, und der Code des Fernsehers kann weiterhin genehmigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which %1$@ account signs in the TV. Accounts on this device stay signed in, and the TV's code stays ready to approve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué cuenta de %1$@ inicia sesión en la TV. Las cuentas de este dispositivo siguen con la sesión iniciada y el código de la TV sigue listo para aprobarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le compte %1$@ qui connecte la TV. Les comptes de cet appareil restent connectés, et le code de la TV reste prêt à être approuvé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
