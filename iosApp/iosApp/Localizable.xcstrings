    "watchParty.ended.replaced" : {
      "comment" : "Roku: message shown on this device when the same profile joined the party elsewhere, taking over. Apple (iPhone, iPad, Apple TV): same message on the Watch Party hub.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انضم هذا الملف الشخصي إلى Watch Party على جهاز آخر. انضم مجددًا هنا لتولي التشغيل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този профил се присъедини към Watch Party на друго устройство. Присъединете се отново тук, за да поемете възпроизвеждането."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest perfil s’ha unit a la Watch Party en un altre dispositiu. Torna-t’hi a unir aquí per prendre el control de la reproducció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento profil se připojil k Watch Party na jiném zařízení. Chcete-li převzít přehrávání, připojte se znovu zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne profil deltager nu i festen på en anden enhed. Deltag igen her for at overtage afspilningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Profil ist der Watch Party auf einem anderen Gerät beigetreten. Tritt hier erneut bei, um die Wiedergabe zu übernehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το προφίλ συμμετέχει στο Watch Party από άλλη συσκευή. Συμμετάσχετε ξανά από εδώ για να αναλάβετε την αναπαραγωγή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This profile joined the party on another device. Rejoin here to take over playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil se unió a la Watch Party en otro dispositivo. Vuelve a unirte aquí para retomar la reproducción."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
