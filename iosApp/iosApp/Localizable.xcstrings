    "detail.unreachable.offline" : {
      "comment" : "Apple iOS: message of the Can't Reach Server dialog when the device has no network connection.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت غير متصل. اتصل بشبكة لبدء البث، أو شغّل عنوانًا تم تنزيله."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма мрежова връзка. Свържете се с мрежа, за да гледате поточно, или пуснете изтеглено заглавие."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tens connexió. Connecta’t a una xarxa per fer streaming o reprodueix un títol baixat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jste offline. Pro streamování se připojte k síti, nebo přehrajte stažený titul."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er offline. Opret forbindelse til et netværk for at streame, eller afspil en downloadet titel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Verbinde dich mit einem Netzwerk, um zu streamen, oder spiele einen heruntergeladenen Titel ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είστε εκτός σύνδεσης. Συνδεθείτε σε ένα δίκτυο για αναπαραγωγή μέσω ροής ή αναπαράγετε ένα στοιχείο που έχετε λάβει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're offline. Connect to a network to stream, or play a downloaded title."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes conexión. Conéctate a una red para transmitir o reproduce un título descargado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teil pole võrguühendust. Voogedastamiseks looge ühendus võrguga või esitage allalaaditud pealkiri."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet offline-tilassa. Muodosta verkkoyhteys suoratoistaaksesi tai toista ladattu kohde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne. Connectez-vous à un réseau pour lancer le streaming, ou lisez un titre téléchargé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין חיבור לאינטרנט. יש להתחבר לרשת כדי להזרים, או להפעיל פריט שהורד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप ऑफ़लाइन हैं। स्ट्रीम करने के लिए किसी नेटवर्क से कनेक्ट करें, या कोई डाउनलोड किया गया टाइटल चलाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niste povezani s mrežom. Povežite se s mrežom da biste streamali ili reproducirajte preuzeti naslov."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs hálózati kapcsolat. A streameléshez csatlakozzon egy hálózathoz, vagy játsszon le egy letöltött elemet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sedang offline. Hubungkan ke jaringan untuk streaming, atau putar judul yang sudah diunduh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei offline. Connettiti a una rete per lo streaming o riproduci un titolo scaricato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインです。ストリーミングするにはネットワークに接続するか、ダウンロード済みのタイトルを再生してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 상태예요. 스트리밍하려면 네트워크에 연결하거나 다운로드한 항목을 재생하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esate neprisijungę prie tinklo. Prisijunkite prie tinklo, kad galėtumėte transliuoti, arba leiskite atsisiųstą elementą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūs esat bezsaistē. Izveidojiet savienojumu ar tīklu, lai straumētu, vai atskaņojiet lejupielādētu vienumu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda di luar talian. Sambung ke rangkaian untuk menstrim atau mainkan tajuk yang dimuat turun."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er frakoblet. Koble til et nettverk for å strømme, eller spill av en nedlastet tittel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent offline. Maak verbinding met een netwerk om te streamen, of speel een gedownloade titel af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak połączenia z siecią. Połącz się z siecią, aby korzystać ze streamingu, lub odtwórz pobrany tytuł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está off-line. Conecte-se a uma rede para fazer streaming ou reproduza um título baixado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está offline. Ligue-se a uma rede para fazer streaming ou reproduza um título transferido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunteți offline. Conectați-vă la o rețea pentru streaming sau redați un titlu descărcat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет подключения к интернету. Подключитесь к сети, чтобы смотреть онлайн, или воспроизведите скачанный контент."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ste offline. Ak chcete streamovať, pripojte sa k sieti, alebo prehrajte stiahnutý titul."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimate povezave. Za pretakanje se povežite z omrežjem ali predvajajte prenesen naslov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är offline. Anslut till ett nätverk för att streama, eller spela upp en nedladdad titel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณออฟไลน์อยู่ เชื่อมต่อเครือข่ายเพื่อสตรีม หรือเล่นรายการที่ดาวน์โหลดไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimdışısınız. Akış yapmak için bir ağa bağlanın veya indirilmiş bir içeriği oynatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви офлайн. Під’єднайтеся до мережі, щоб транслювати, або відтворіть завантажений вміст."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đang ngoại tuyến. Kết nối với mạng để phát trực tuyến hoặc phát nội dung đã tải xuống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已离线。请连接网络以串流播放，或播放已下载的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你目前處於離線狀態。請連線至網路以進行串流，或播放已下載的作品。"
          }
        }
      }
    },
    "detail.unreachable.serverDown" : {
      "comment" : "Apple iOS: message of the Can't Reach Server dialog when the device is online but the server doesn't answer.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب البث اتصالًا بالخادم، وهو لا يستجيب حاليًا. لا يزال بإمكانك تشغيل العناوين التي تم تنزيلها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточното предаване изисква връзка с вашия сървър, който в момента не отговаря. Изтеглените заглавия все още могат да се възпроизвеждат."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El streaming necessita una connexió al teu servidor, que ara mateix no respon. Encara pots reproduir els títols baixats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamování vyžaduje připojení k vašemu serveru, který teď neodpovídá. Stažené tituly lze přehrát i nadále."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming kræver forbindelse til din server, som ikke svarer lige nu. Downloadede titler kan stadig afspilles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming erfordert eine Verbindung zu deinem Server, der gerade nicht antwortet. Heruntergeladene Titel können weiterhin abgespielt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναπαραγωγή μέσω ροής απαιτεί σύνδεση στον διακομιστή σας, ο οποίος δεν αποκρίνεται αυτήν τη στιγμή. Μπορείτε ακόμη να αναπαράγετε τα στοιχεία που έχετε λάβει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming needs a connection to your server, which isn't responding right now. Downloaded titles can still be played."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transmisión necesita conexión con tu servidor, que no responde en este momento. Los títulos descargados se pueden seguir reproduciendo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voogedastuseks on vaja ühendust teie serveriga, mis praegu ei vasta. Allalaaditud pealkirju saab endiselt esitada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suoratoisto vaatii yhteyden palvelimeesi, joka ei vastaa juuri nyt. Ladattuja kohteita voi silti toistaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le streaming nécessite une connexion à votre serveur, qui ne répond pas pour le moment. Les titres téléchargés restent lisibles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזרמה דורשת חיבור לשרת שלך, והוא לא מגיב כרגע. עדיין אפשר להפעיל פריטים שהורדו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्ट्रीमिंग के लिए आपके सर्वर से कनेक्शन ज़रूरी है, जो अभी जवाब नहीं दे रहा है। डाउनलोड किए गए टाइटल अब भी चलाए जा सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za streaming je potrebna veza s vašim poslužiteljem, koji trenutačno ne odgovara. Preuzete naslove i dalje možete reproducirati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A streameléshez kapcsolat szükséges a szerverrel, amely most nem válaszol. A letöltött elemek továbbra is lejátszhatók."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming memerlukan koneksi ke server Anda, yang saat ini tidak merespons. Judul yang sudah diunduh tetap dapat diputar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo streaming richiede una connessione al tuo server, che al momento non risponde. Puoi comunque riprodurre i titoli scaricati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストリーミングにはサーバーへの接続が必要ですが、現在サーバーが応答していません。ダウンロード済みのタイトルは引き続き再生できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트리밍하려면 서버에 연결해야 하는데, 지금 서버가 응답하지 않아요. 다운로드한 항목은 계속 재생할 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transliuoti galima tik prisijungus prie jūsų serverio, kuris šiuo metu neatsako. Atsisiųstus elementus vis tiek galima leisti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straumēšanai nepieciešams savienojums ar jūsu serveri, kas pašlaik nereaģē. Lejupielādētos vienumus joprojām var atskaņot."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penstriman memerlukan sambungan ke pelayan anda, yang tidak bertindak balas sekarang. Tajuk yang dimuat turun masih boleh dimainkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømming krever tilkobling til serveren din, som ikke svarer akkurat nå. Nedlastede titler kan fortsatt spilles av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor streaming is een verbinding met je server nodig, maar die reageert nu niet. Gedownloade titels kun je nog steeds afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming wymaga połączenia z twoim serwerem, który w tej chwili nie odpowiada. Pobrane tytuły nadal można odtwarzać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O streaming precisa de uma conexão com seu servidor, que não está respondendo no momento. Os títulos baixados ainda podem ser reproduzidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O streaming precisa de uma ligação ao seu servidor, que não está a responder neste momento. Os títulos transferidos continuam a poder ser reproduzidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamingul necesită o conexiune la serverul dvs., care nu răspunde momentan. Titlurile descărcate pot fi redate în continuare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для стриминга нужно подключение к вашему серверу, но сейчас он не отвечает. Скачанный контент можно воспроизвести."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamovanie vyžaduje pripojenie k vášmu serveru, ktorý momentálne neodpovedá. Stiahnuté tituly sa dajú prehrať aj naďalej."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za pretakanje je potrebna povezava z vašim strežnikom, ki se trenutno ne odziva. Prenesene naslove lahko še vedno predvajate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming kräver en anslutning till din server, som inte svarar just nu. Nedladdade titlar kan fortfarande spelas upp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสตรีมต้องเชื่อมต่อกับเซิร์ฟเวอร์ของคุณ ซึ่งขณะนี้ไม่ตอบสนอง ยังเล่นรายการที่ดาวน์โหลดไว้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akış için sunucunuza bağlantı gerekiyor, ancak sunucu şu anda yanıt vermiyor. İndirilmiş içerikler yine de oynatılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для потокового відтворення потрібне з’єднання з вашим сервером, але він зараз не відповідає. Завантажений вміст і далі можна відтворювати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phát trực tuyến cần kết nối với máy chủ của bạn, nhưng máy chủ hiện không phản hồi. Bạn vẫn có thể phát nội dung đã tải xuống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "串流需要连接到你的服务器，但服务器目前没有响应。已下载的内容仍可播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "串流需要連線至你的伺服器，但伺服器目前沒有回應。你仍可播放已下載的作品。"
          }
        }
      }
    },
