    "account.signOut.leaves" : {
      "comment" : "Apple TV: message of the sign-out confirmation when other accounts still use the server. {device}: the device's product name (Apple TV).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال الملفات الشخصية والإعدادات الخاصة بهذا الحساب من جهاز %1$@ هذا. يبقى الخادم محفوظًا، لذا يمكنك تسجيل الدخول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Profile und Einstellungen dieses Kontos werden von diesem %1$@ entfernt. Der Server bleibt gespeichert, sodass du dich erneut anmelden kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account's profiles and settings leave this %1$@. The server stays saved, so you can sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles y la configuración de esta cuenta se quitarán de este %1$@. El servidor seguirá guardado para que puedas volver a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils et paramètres de ce compte seront retirés de votre %1$@. Le serveur reste enregistré : vous pourrez vous reconnecter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントのプロフィールと設定はこの%1$@から削除されます。サーバーは保存されたままなので、もう一度サインインできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis e as configurações desta conta serão removidos deste %1$@. O servidor continua salvo, então você pode entrar novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账户的个人资料和设置将从此%1$@移除。服务器仍会保存，你可以重新登录。"
          }
        }
      }
    },
    "account.signOut.leavesRemovingServer" : {
      "comment" : "Apple TV: message of the sign-out confirmation when this is the server's only account, so the server goes too. {device}: the device's product name (Apple TV); {server}: the server's display name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال الملفات الشخصية والإعدادات الخاصة بهذا الحساب من جهاز %1$@ هذا، وسيُزال %2$@ منه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
