    "downloads.offline.error.manifestMissing" : {
      "comment" : "Apple iOS/macOS: player error when opening a download offline: its playback data is missing.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيانات التشغيل دون اتصال لهذا التنزيل مفقودة. احذفه ونزّله مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данните за офлайн възпроизвеждане на това изтегляне липсват. Изтрийте го и го изтеглете отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falten les dades de reproducció sense connexió d’aquesta baixada. Elimina-la i torna-la a baixar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chybí data pro offline přehrávání tohoto stažení. Smažte ho a stáhněte znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene til offlineafspilning af denne download mangler. Slet den, og download den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Offline-Wiedergabedaten dieses Downloads fehlen. Lösche ihn und lade ihn erneut herunter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λείπουν τα δεδομένα αναπαραγωγής εκτός σύνδεσης για αυτή τη λήψη. Διαγράψτε τη λήψη και κάντε την ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The offline playback data for this download is missing. Delete and re-download it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltan los datos de reproducción sin conexión de esta descarga. Elimínala y vuelve a descargarla."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle allalaadimise võrguühenduseta esituse andmed puuduvad. Kustutage see ja laadige uuesti alla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän latauksen offline-toistotiedot puuttuvat. Poista se ja lataa uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de lecture hors connexion de ce téléchargement sont introuvables. Supprimez-le, puis téléchargez-le à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נתוני ההפעלה אופליין של ההורדה הזו חסרים. יש למחוק אותה ולהוריד אותה מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डाउनलोड का ऑफ़लाइन प्लेबैक डेटा नहीं मिल रहा है। इसे मिटाएँ और फिर से डाउनलोड करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedostaju podaci za izvanmrežnu reprodukciju ovog preuzimanja. Izbrišite ga i ponovno preuzmite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiányoznak a letöltés offline lejátszási adatai. Törölje, majd töltse le újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
