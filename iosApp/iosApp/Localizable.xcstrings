    "servers.remove.failedToast" : {
      "comment" : "Toast on Android TV (and error on Apple TV) shown when removing a saved server did not finish. On Android TV it appears when removing from Settings → Accounts or Sign Out & Remove Server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo إزالة الخادم المحفوظ. حاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložený server se nepodařilo odebrat. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke fjerne den gemte server. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte den gespeicherten Server nicht entfernen. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn't remove the saved server. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo quitar el servidor guardado. Vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei voinut poistaa tallennettua palvelinta. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a pas pu retirer le serveur enregistré. Réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nije uspio ukloniti spremljeni poslužitelj. Pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile rimuovere il server salvato. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloは保存済みのサーバーを削除できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo에서 저장된 서버를 제거하지 못했어요. 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke fjerne den lagrede serveren. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kan de opgeslagen server niet verwijderen. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Silo nie mogła usunąć zapisanego serwera. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo não conseguiu remover o servidor salvo. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не удалось удалить сохранённый сервер. Повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunde inte ta bort den sparade servern. Försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kayıtlı sunucuyu kaldıramadı. Lütfen tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не вдалося вилучити збережений сервер. Спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo无法移除已保存的服务器。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo 無法移除已儲存的伺服器。請再試一次。"
          }
        }
      }
    },
