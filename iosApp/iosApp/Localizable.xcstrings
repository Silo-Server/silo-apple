    "settings.accounts.page.signOutFooter" : {
      "comment" : "Apple Settings > Accounts > an account's page (iPhone, iPad, Mac): note under the Sign out button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي تسجيل الخروج إلى حذف تنزيلات هذا الحساب من هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Излизането изтрива изтеглените файлове на този акаунт от това устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tancar la sessió, s’eliminen d’aquest dispositiu les baixades d’aquest compte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odhlášením smažete stažené položky tohoto účtu z tohoto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du logger ud, slettes denne kontos downloads fra denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Abmelden werden die Downloads dieses Kontos von diesem Gerät gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αποσύνδεση διαγράφει τις λήψεις αυτού του λογαριασμού από αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing out deletes this account's downloads from this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cerrar sesión, se eliminan de este dispositivo las descargas de esta cuenta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väljalogimine kustutab selle konto allalaadimised sellest seadmest."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloskirjautuminen poistaa tämän tilin lataukset tästä laitteesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La déconnexion supprime les téléchargements de ce compte sur cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התנתקות מוחקת את ההורדות של החשבון הזה מהמכשיר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन आउट करने पर इस खाते के डाउनलोड इस डिवाइस से मिट जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odjava briše preuzimanja ovog računa s ovog uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kijelentkezés törli a fiók letöltéseit erről az eszközről."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluar akan menghapus unduhan akun ini dari perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esci, i download di questo account vengono eliminati da questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインアウトすると、このアカウントのダウンロードがこのデバイスから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그아웃하면 이 기기에서 이 계정의 다운로드가 삭제돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atsijungus iš šio įrenginio ištrinami šios paskyros atsisiuntimai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izrakstoties no šīs ierīces tiks izdzēstas šī konta lejupielādes."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log keluar akan memadam muat turun akaun ini dari peranti ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du logger ut, slettes nedlastingene til denne kontoen fra denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je uitlogt, worden de downloads van dit account van dit apparaat verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wylogowanie usuwa pobrane pliki tego konta z tego urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sair exclui os downloads desta conta deste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminar sessão elimina deste dispositivo as transferências desta conta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deconectarea șterge descărcările acestui cont de pe acest dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При выходе загрузки этого аккаунта будут удалены с этого устройства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odhlásením sa z tohto zariadenia vymažú stiahnuté položky tohto účtu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z odjavo izbrišete prenose tega računa s te naprave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du loggar ut raderas kontots nedladdningar från den här enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การออกจากระบบจะลบรายการดาวน์โหลดของบัญชีนี้ออกจากอุปกรณ์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumu kapatmak, bu hesabın indirmelerini bu cihazdan siler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після виходу завантаження цього облікового запису буде видалено з цього пристрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng xuất sẽ xóa các nội dung tải xuống của tài khoản này khỏi thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出登录会从此设备上删除该账户的下载内容。"
