    "diagnostics.notice.tooLarge" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: the destination refused the report as too large.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التقرير أكبر من أن يُرسل، ولن تُعاد محاولة إرساله."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчетът е твърде голям за изпращане и няма да бъде изпратен отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’informe és massa gran per enviar-lo i no es tornarà a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpráva je příliš velká k odeslání a pokus se nebude opakovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporten er for stor til at blive sendt og forsøges ikke igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bericht ist zu groß zum Senden; es gibt keinen weiteren Versuch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναφορά είναι πολύ μεγάλη για αποστολή και δεν θα γίνει νέα προσπάθεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Report is too large to send and won't be retried."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El informe es demasiado grande para enviarse y no se volverá a intentar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aruanne on saatmiseks liiga suur ja seda uuesti ei proovita."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportti on liian suuri lähetettäväksi, eikä sitä yritetä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rapport est trop volumineux pour être envoyé et ne sera pas renvoyé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדוח גדול מדי לשליחה, ולא יתבצע ניסיון נוסף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिपोर्ट भेजने के लिए बहुत बड़ी है और इसे फिर से भेजने की कोशिश नहीं की जाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvješće je preveliko za slanje i neće se ponovno slati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelentés túl nagy a küldéshez, és a Silo nem próbálja újra elküldeni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan terlalu besar untuk dikirim dan tidak akan dicoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il report è troppo grande per essere inviato e non verrà ritentato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レポートが大きすぎるため送信できません。再試行は行われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보고서가 너무 커서 보낼 수 없고 다시 시도하지 않아요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pranešimas per didelis, kad būtų išsiųstas, ir nebus siunčiamas dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārskats ir pārāk liels, lai to nosūtītu, un atkārtoti netiks sūtīts."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan terlalu besar untuk dihantar dan tidak akan dicuba semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporten er for stor til å sendes og prøves ikke på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het rapport is te groot om te verzenden en wordt niet opnieuw geprobeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raport jest za duży do wysłania; nie będzie ponownych prób."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relatório é grande demais para ser enviado e não será reenviado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relatório é demasiado grande para ser enviado e não vai haver nova tentativa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportul este prea mare pentru a fi trimis și nu va fi reîncercat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчёт слишком большой для отправки; повторных попыток не будет."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlásenie je príliš veľké na odoslanie a znova sa neodošle."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poročilo je preveliko za pošiljanje in ne bo poslano znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporten är för stor för att skickas och skickas inte igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายงานมีขนาดใหญ่เกินกว่าจะส่งได้และจะไม่ลองอีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapor gönderilemeyecek kadar büyük ve yeniden denenmeyecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звіт завеликий для надсилання, і спробу не буде повторено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo quá lớn để gửi và sẽ không được thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报告过大，无法发送，也不会重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "報告太大，無法傳送，且不會重試。"
          }
        }
      }
    },
