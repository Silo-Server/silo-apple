    "home.recipe.ffDefault.description" : {
      "comment" : "One-line description of the Forgotten Favorites preset in the Add row gallery (shared key `home.recipe.ffDefault.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بتقييم 7.0+ على TMDB و100 صوت أو أكثر، ولم تُشاهد خلال العام الماضي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnocení 7,0+ na TMDB se 100+ hlasy, nesledováno v posledním roce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedømt 7,0+ på TMDB med 100+ stemmer og ikke set det seneste år."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf TMDB mit 7.0+ bewertet, mit 100+ Stimmen und im letzten Jahr nicht geschaut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rated 7.0+ on TMDB with 100+ votes, and not watched in the past year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calificación de 7.0+ en TMDB y más de 100 votos, sin ver en el último año."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TMDB-arvio 7.0+ ja vähintään 100 ääntä, eikä katsottu viimeisen vuoden aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note d’au moins 7,0 sur TMDB avec au moins 100 votes, et non regardés depuis un an."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocjena 7,0+ na TMDB-u uz 100+ glasova, a niste ih gledali u posljednjih godinu dana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valutazione 7.0+ su TMDB con 100+ voti, non guardati nell’ultimo anno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TMDBで評価7.0以上、投票数100以上で、過去1年間視聴していない作品。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TMDB 평점 7.0 이상, 투표 100개 이상, 지난 1년간 시청하지 않은 작품."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vurdert til 7.0+ på TMDB med 100+ stemmer, og ikke sett det siste året."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Score 7.0+ op TMDB met 100+ stemmen, en het afgelopen jaar niet bekeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocena 7.0+ w TMDB, 100+ głosów, nieoglądane od roku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaliados com 7.0+ no TMDB e 100+ votos, e não assistidos no último ano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка от 7,0 на TMDB и от 100 голосов, без просмотров за последний год."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betyg 7,0+ på TMDB med 100+ röster och inte sedda det senaste året."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TMDB’de 7.0+ puanlı, 100+ oylu ve son bir yılda izlenmemiş."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оцінка 7.0+ на TMDB, 100+ голосів і без переглядів за останній рік."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TMDB评分7.0+，投票数100+，且过去一年内未观看。"
