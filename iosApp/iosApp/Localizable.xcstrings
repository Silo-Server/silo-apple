            "value" : "%1$@-undertekster passer allerede til lyden"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel (%1$@) passen bereits zum Ton"
          }
        },
        "el" : {
