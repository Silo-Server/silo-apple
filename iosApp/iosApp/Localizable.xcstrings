    "downloads.monitorList.emptyBody" : {
      "comment" : "Apple iOS/macOS: Monitored screen (series this device downloads automatically), opened from the Downloads tab; empty-state text. {device}: the device model name from the system, such as iPhone, iPad or Mac.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح مسلسلًا، واضغط على «تنزيل»، واختر «مراقبة» للحصول على الحلقات الجديدة على جهاز %1$@ هذا تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne eine Serie, tippe auf „Download“ und wähle „Beobachten“, um neue Folgen automatisch auf diesem %1$@ zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a series, tap Download, and choose Monitor to get new episodes on this %1$@ automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre una serie, toca Descargar y elige Supervisar para recibir episodios nuevos en este %1$@ automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez une série, touchez Télécharger, puis choisissez Surveiller pour recevoir automatiquement les nouveaux épisodes sur votre %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シリーズを開いて「ダウンロード」をタップし、「監視」を選択すると、この%1$@に新しいエピソードが自動でダウンロードされます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra uma série, toque em Baixar e escolha Monitorar para receber novos episódios neste %1$@ automaticamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开剧集，轻点“下载”，然后选择“监控”，即可在此%1$@上自动获取新集。"
          }
        }
      }
    },
