        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लंबित लोकल रिपोर्टें मिटा दी जाएँगी। Silo Diagnostics को पहले ही मिल चुकी रिपोर्टें भी मिटाने के लिए कतार में डाल दी जाएँगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalna izvješća na čekanju bit će izbrisana. Izvješća koja je Silo Diagnostics već primio također će biti stavljena u red čekanja za brisanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A függőben lévő helyi jelentések törlődnek. A Silo Diagnostics szolgáltatáshoz már beérkezett jelentések is törlési várólistára kerülnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan lokal yang tertunda akan dihapus. Laporan yang sudah diterima Silo Diagnostics juga akan dimasukkan ke antrean penghapusan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I report locali in attesa verranno eliminati. Anche i report già ricevuti da Silo Diagnostics verranno messi in coda per l’eliminazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信待ちのローカルレポートは削除されます。Silo Diagnosticsが受信済みのレポートも削除キューに追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기 중인 로컬 보고서가 삭제돼요. Silo Diagnostics에서 이미 받은 보고서도 삭제 대기열에 추가돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laukiančios vietinės ataskaitos bus ištrintos. Ataskaitos, kurias jau gavo „Silo Diagnostics“, taip pat bus įtrauktos į ištrynimo eilę."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaidošie lokālie ziņojumi tiks izdzēsti. Ziņojumi, ko Silo Diagnostics jau saņēma, arī tiks ievietoti dzēšanas rindā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan setempat yang tertunda akan dipadam. Laporan yang sudah diterima oleh Silo Diagnostics juga akan dimasukkan ke dalam baris gilir untuk dipadam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventende lokale rapporter blir slettet. Rapporter som Silo Diagnostics allerede har mottatt, settes også i kø for sletting."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Openstaande lokale rapporten worden verwijderd. Rapporten die Silo Diagnostics al heeft ontvangen, worden ook in de wachtrij gezet voor verwijdering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczekujące raporty lokalne zostaną usunięte. Raporty już odebrane przez Silo Diagnostics również zostaną dodane do kolejki do usunięcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os relatórios locais pendentes serão excluídos. Os relatórios já recebidos pelo Silo Diagnostics também entrarão na fila de exclusão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os relatórios locais pendentes serão eliminados. Os relatórios já recebidos pelo Silo Diagnostics também serão colocados na fila de eliminação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapoartele locale în așteptare vor fi șterse. Rapoartele deja primite de Silo Diagnostics vor fi, de asemenea, puse în coadă pentru ștergere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидающие отчёты на этом устройстве будут удалены. Отчёты, уже полученные Silo Diagnostics, также будут поставлены в очередь на удаление."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čakajúce lokálne hlásenia sa odstránia. Hlásenia, ktoré už prijala služba Silo Diagnostics, sa tiež zaradia do frontu na odstránenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čakajoča lokalna poročila bodo izbrisana. Poročila, ki jih je storitev Silo Diagnostics že prejela, bodo prav tako uvrščena v čakalno vrsto za brisanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väntande lokala rapporter raderas. Rapporter som Silo Diagnostics redan har tagit emot ställs också i kö för radering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบบจะลบรายงานในเครื่องที่รอดำเนินการ และจะจัดคิวลบรายงานที่ Silo Diagnostics ได้รับแล้วด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekleyen yerel raporlar silinecek. Silo Diagnostics tarafından zaten alınmış raporlar da silinmek üzere kuyruğa eklenecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локальні звіти в черзі буде видалено. Звіти, які вже отримала служба Silo Diagnostics, також буде поставлено в чергу на видалення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các báo cáo cục bộ đang chờ sẽ được xóa. Các báo cáo Silo Diagnostics đã nhận cũng sẽ được đưa vào hàng đợi xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地待发送的报告将被删除。Silo Diagnostics已收到的报告也将加入删除队列。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待處理的本機報告將會刪除。Silo Diagnostics 已收到的報告也會排入刪除佇列。"
          }
        }
      }
    },
    "diagnostics.turnOff.selfHostedMessage" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) > Crash Reports: message of the Never confirmation when reports go to the user's own server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف التقارير المعلّقة الخاصة بحساب الخادم هذا. سيستمر السجل الأساسي في الذاكرة في العمل، ولا يُرسل أبدًا دون إجراء صريح منك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чакащите отчети за този акаунт в сървъра ще бъдат изтрити. Основният дневник в паметта ще продължи да работи и никога не се изпраща без изрично действие."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’eliminaran els informes pendents d’aquest compte del servidor. El registre bàsic en memòria continuarà actiu i mai no s’envia sense una acció explícita."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čekající hlášení pro tento účet na serveru budou smazána. Základní protokol v paměti poběží dál a bez vašeho výslovného pokynu se nikdy neodešle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventende rapporter for denne serverkonto bliver slettet. Den grundlæggende log i hukommelsen kører fortsat og sendes aldrig, medmindre du udtrykkeligt vælger det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausstehende Berichte für dieses Serverkonto werden gelöscht. Das einfache Protokoll im Arbeitsspeicher läuft weiter und wird nie ohne ausdrückliche Aktion gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εκκρεμείς αναφορές για αυτόν τον λογαριασμό διακομιστή θα διαγραφούν. Το βασικό αρχείο καταγραφής στη μνήμη θα συνεχίσει να λειτουργεί και δεν αποστέλλεται ποτέ χωρίς ρητή ενέργειά σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pending reports for this server account will be deleted. The in-memory basic log will continue running and is never sent without an explicit action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán los informes pendientes de esta cuenta del servidor. El registro básico en memoria seguirá activo y nunca se envía sin una acción explícita."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle serverikonto ootel aruanded kustutatakse. Mälus hoitav põhilogi jätkab tööd ja seda ei saadeta kunagi ilma teie selgesõnalise toiminguta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän palvelintilin odottavat raportit poistetaan. Muistissa oleva peruslokitus jatkuu, eikä sitä koskaan lähetetä ilman erillistä toimintoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rapports en attente pour ce compte de serveur seront supprimés. Le journal de base en mémoire continuera de fonctionner et n’est jamais envoyé sans action explicite de votre part."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דוחות ממתינים של חשבון השרת הזה יימחקו. היומן הבסיסי שבזיכרון ימשיך לפעול ואף פעם לא יישלח בלי פעולה מפורשת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सर्वर खाते की लंबित रिपोर्टें मिटा दी जाएँगी। इन-मेमोरी बेसिक लॉग चलता रहेगा और साफ़ तौर पर कोई कार्रवाई किए बिना उसे कभी नहीं भेजा जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvješća na čekanju za ovaj račun na poslužitelju bit će izbrisana. Osnovni zapisnik u memoriji nastavlja se voditi i nikada se ne šalje bez vaše izričite radnje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ehhez a szerverfiókhoz tartozó függőben lévő jelentések törlődnek. A memóriában futó alapszintű napló továbbra is működik, és kifejezett művelet nélkül soha nem kerül elküldésre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan tertunda untuk akun server ini akan dihapus. Log dasar di memori akan tetap berjalan dan tidak pernah dikirim tanpa tindakan eksplisit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I report in attesa per questo account del server verranno eliminati. Il log di base in memoria continuerà a funzionare e non verrà mai inviato senza un’azione esplicita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーアカウントの送信待ちのレポートは削除されます。メモリ内の基本ログは引き続き記録されますが、明示的に操作しない限り送信されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버 계정의 대기 중인 보고서가 삭제돼요. 메모리 내 기본 로그는 계속 기록되며, 직접 보내지 않는 한 전송되지 않아요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laukiančios šios serverio paskyros ataskaitos bus ištrintos. Pagrindinis žurnalas atmintyje bus vedamas toliau ir niekada nesiunčiamas be aiškaus jūsų veiksmo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī servera konta gaidošie ziņojumi tiks izdzēsti. Atmiņā glabātais pamata žurnāls turpinās darboties, un tas nekad netiek nosūtīts bez jūsu tiešas darbības."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan tertunda untuk akaun pelayan ini akan dipadam. Log asas dalam memori akan terus berjalan dan tidak sekali-kali dihantar tanpa tindakan yang jelas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventende rapporter for denne serverkontoen blir slettet. Den grunnleggende loggen i minnet fortsetter å kjøre og sendes aldri uten at du selv ber om det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Openstaande rapporten voor dit serveraccount worden verwijderd. Het basislog in het geheugen blijft actief en wordt nooit verzonden zonder dat je daar zelf voor kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczekujące raporty dla tego konta na serwerze zostaną usunięte. Podstawowy log w pamięci będzie nadal działać i nigdy nie zostanie wysłany bez twojego wyraźnego działania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os relatórios pendentes desta conta do servidor serão excluídos. O log básico em memória continuará em execução e nunca será enviado sem uma ação explícita."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os relatórios pendentes desta conta do servidor serão eliminados. O registo básico em memória continuará ativo e nunca é enviado sem uma ação explícita."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapoartele în așteptare pentru acest cont de server vor fi șterse. Jurnalul de bază din memorie va continua să ruleze și nu este trimis niciodată fără o acțiune explicită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидающие отчёты для этого аккаунта на сервере будут удалены. Базовый лог в памяти продолжит вестись и никогда не отправляется без вашего явного действия."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čakajúce hlásenia pre tento účet na serveri sa odstránia. Základný denník v pamäti bude naďalej bežať a nikdy sa neodošle bez výslovnej akcie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čakajoča poročila za ta račun na strežniku bodo izbrisana. Osnovni dnevnik v pomnilniku bo še naprej deloval in se nikoli ne pošlje brez izrecnega dejanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väntande rapporter för det här serverkontot raderas. Den grundläggande loggen i minnet fortsätter att köras och skickas aldrig utan att du uttryckligen väljer det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบบจะลบรายงานที่รอดำเนินการสำหรับบัญชีเซิร์ฟเวอร์นี้ ล็อกพื้นฐานในหน่วยความจำจะยังทำงานต่อไป และระบบจะไม่ส่งล็อกนี้โดยที่คุณไม่ได้สั่งเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucu hesabına ait bekleyen raporlar silinecek. Bellekteki temel günlük çalışmaya devam eder ve siz açıkça bir işlem yapmadan asla gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звіти в черзі для цього облікового запису сервера буде видалено. Базовий журнал у пам’яті й надалі вестиметься і ніколи не надсилається без вашої явної дії."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các báo cáo đang chờ của tài khoản máy chủ này sẽ được xóa. Nhật ký cơ bản trong bộ nhớ vẫn tiếp tục chạy và không bao giờ được gửi nếu bạn không chủ động thực hiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器账户的待发送报告将被删除。内存中的基本日志会继续运行，未经你明确操作绝不会发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個伺服器帳號的待處理報告將會刪除。記憶體中的基本記錄會繼續執行，且未經你明確操作絕不會傳送。"
          }
        }
      }
    },
