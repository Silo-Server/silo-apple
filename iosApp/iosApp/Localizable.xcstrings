    "errors.apple.accountStore.ownerChanged" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error after signing in when the user switched server before the account was stored.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر الخادم النشط قبل حفظ تسجيل الدخول."
