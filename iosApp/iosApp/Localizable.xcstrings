    "upNext.stopShuffling" : {
      "comment" : "Option that turns shuffle off so playback continues normally, on Roku, Android phone and TV, and the web player's Playing Next screen. On Apple iOS and tvOS it is a button on the player's Up Next screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف التشغيل العشوائي"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спиране на разбъркването"
