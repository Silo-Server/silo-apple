        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko pasiekti serverio %1$@, kad būtų patvirtintas prisijungimas. Patikrinkite šio „%2$@“ įrenginio ryšį ir bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
