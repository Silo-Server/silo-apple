            "value" : "Huidige server. Servernamen worden beheerd door de serverbeheerder"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bieżący serwer. Nazwami serwerów zarządza administrator serwera"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidor atual. Os nomes dos servidores são gerenciados pela administração do servidor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущий сервер. Названиями серверов управляет администратор сервера"
          }
        },
