    "cast.replace.profileWatching" : {
      "comment" : "Android phone: Remote Control \"Replace what's playing?\" dialog; message when another profile's title is on the TV. {profile}: that profile's name; {title}: the title, such as Season 1 · Oak Street; {tv}: the TV's name. Apple iOS: Remote Control \"Replace What's Playing?\" alert message.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشاهد %1$@ «%2$@» على %3$@. هل تريد تشغيل اختيارك بدلًا منه؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профилът %1$@ гледа %2$@ на телевизора %3$@. Да се пусне ли вашето заглавие вместо това?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ està veient %2$@ a %3$@. Vols reproduir el teu contingut en el seu lloc?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil %1$@ sleduje %2$@ na televizi %3$@. Přehrát místo toho váš obsah?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ser %2$@ på %3$@. Vil du afspille dit i stedet?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ schaut gerade %2$@ auf %3$@. Stattdessen deins abspielen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το προφίλ %1$@ παρακολουθεί τον τίτλο «%2$@» στην τηλεόραση %3$@. Αναπαραγωγή του δικού σας στη θέση του;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is watching %2$@ on %3$@. Play yours instead?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está viendo %2$@ en %3$@. ¿Quieres reproducir lo tuyo?"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vaatab teleris %3$@ pealkirja %2$@. Kas esitada selle asemel teie oma?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ katsoo kohdetta %2$@ laitteessa %3$@. Toistetaanko omasi sen sijaan?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ regarde %2$@ sur %3$@. Lire le vôtre à la place ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפרופיל %1$@ צופה בפריט %2$@ בטלוויזיה %3$@. להפעיל את שלך במקום?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ पर प्रोफ़ाइल %1$@ में टाइटल %2$@ चल रहा है। इसके बजाय अपना चलाएँ?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gleda %2$@ na uređaju %3$@. Želite li umjesto toga reproducirati svoj sadržaj?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ éppen ezt nézi a(z) %3$@ eszközön: %2$@. Lejátssza helyette a sajátját?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sedang menonton %2$@ di %3$@. Putar milik Anda saja?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sta guardando %2$@ su %3$@. Vuoi riprodurre il tuo titolo al suo posto?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が%3$@で%2$@を視聴中です。代わりに再生しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
