          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serier du har sett, med en helt ny sesong i biblioteket ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series die je hebt gekeken met een gloednieuw seizoen in je bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oglądane przez ciebie seriale z zupełnie nowym sezonem w twojej bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séries que você assistiu e que têm uma temporada nova na sua biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сериалы, которые вы смотрели, с новым сезоном в вашей медиатеке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serier du har sett som har en helt ny säsong i ditt bibliotek."
          }
        },
        "tr" : {
          "stringUnit" : {
