    "downloads.settings.removeOtherTitle" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; title of the alert confirming removal of one Other Download Data row. {name}: the row's title (server name, server address, or Unrecognized data).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد إزالة بيانات التنزيل الخاصة بـ %1$@؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebrat data stahování: %1$@?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern downloaddata for %1$@?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download-Daten für %1$@ entfernen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove download data for %1$@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quitar los datos de descarga de %1$@?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistetaanko lataustiedot: %1$@?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer les données de téléchargement de %1$@ ?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukloniti podatke preuzimanja za %1$@?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere i dati di download di %1$@?"
