        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez egy másik eszközön módosult. Az aktuális verzió megtekintéséhez válassza az Újratöltés lehetőséget; a módosításai megmaradnak."
