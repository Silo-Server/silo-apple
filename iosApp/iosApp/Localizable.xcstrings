        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstitykset, joissa on sisäänrakennettu muotoilu, noudattavat kunkin laitteen tekstitysvaihtoehdon ”Video ohittaa tyylin” -valintaa."
