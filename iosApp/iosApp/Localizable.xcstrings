    "signIn.provider.serverIdentityUnavailable" : {
      "comment" : "Apple (iPhone, iPad, Mac): error before a provider sign-in when the app couldn't verify the saved server's identity.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التأكد من هوية هذا الخادم. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можа да се потвърди кой е този сървър. Проверете връзката и опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut confirmar quin servidor és aquest. Comprova la connexió i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se ověřit, o jaký server jde. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
