    "settingsManifest.ui.theme_music_loop.description" : {
      "comment" : "Help text under the ui.theme_music_loop setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكرار موسيقى الشارة ما دامت صفحة التفاصيل مفتوحة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opakovat znělku, dokud je stránka s podrobnostmi otevřená."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentag temamusikken, så længe detaljesiden er åben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titelmusik wiederholen, solange die Detailseite geöffnet bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat theme music while the detail page stays open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite la música temática mientras la página de detalles siga abierta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toista tunnusmusiikkia uudelleen niin kauan kuin tietosivu on auki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répéter la musique de générique tant que la page de détails reste ouverte."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponavlja tematsku glazbu dok je stranica s detaljima otvorena."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripeti la sigla finché la pagina di dettaglio resta aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細ページを開いている間、テーマ音楽を繰り返し再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상세 페이지가 열려 있는 동안 테마 음악을 반복 재생해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenta temamusikken så lenge detaljsiden er åpen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhaal de themamuziek zolang de detailpagina open blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powtarza muzykę tematyczną, dopóki strona szczegółów jest otwarta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repete a música-tema enquanto a página de detalhes estiver aberta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторять музыкальную тему, пока страница открыта."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upprepa temamusiken så länge detaljsidan är öppen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıntı sayfası açık kaldığı sürece tema müziğini tekrarlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторювати музичну тему, поки сторінка з подробицями відкрита."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "详情页保持打开时循环播放主题音乐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細資料頁面保持開啟時，重複播放主題音樂。"
          }
        }
      }
