    "newProfile.unconfirmed.body" : {
      "comment" : "Body of the Roku dialog shown when the create-profile request got no server reply; advises checking the profile list before retrying. Apple (iPhone, iPad, Mac, Apple TV): same alert body on the New Profile form.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتلقَّ Silo ردًا من الخادم. تحقق من قائمة الملفات الشخصية قبل المحاولة مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Silo nedostala odpověď ze serveru. Než to zkusíte znovu, zkontrolujte seznam profilů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo fik ikke svar fra serveren. Tjek profillisten, før du prøver igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo hat keine Antwort vom Server erhalten. Prüfe die Profilliste, bevor du es erneut versuchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo didn't get an answer from the server. Check the profile list before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no recibió respuesta del servidor. Revisa la lista de perfiles antes de volver a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei saanut vastausta palvelimelta. Tarkista profiililuettelo ennen kuin yrität uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a reçu aucune réponse du serveur. Vérifiez la liste des profils avant de réessayer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nije dobio odgovor od poslužitelja. Provjerite popis profila prije ponovnog pokušaja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo non ha ricevuto risposta dal server. Controlla l’elenco dei profili prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloはサーバーから応答を受け取れませんでした。もう一度お試しになる前に、プロフィールの一覧を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo가 서버에서 응답을 받지 못했어요. 다시 시도하기 전에 프로필 목록을 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo fikk ikke svar fra serveren. Sjekk profillisten før du prøver igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo heeft geen antwoord van de server gekregen. Controleer de profiellijst voordat je het opnieuw probeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Silo nie otrzymała odpowiedzi od serwera. Sprawdź listę profili, zanim spróbujesz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo não recebeu resposta do servidor. Confira a lista de perfis antes de tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение Silo не получило ответа от сервера. Проверьте список профилей, прежде чем повторять попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo fick inget svar från servern. Kontrollera profillistan innan du försöker igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo sunucudan yanıt alamadı. Tekrar denemeden önce profil listesini kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосунок Silo не отримав відповіді від сервера. Перш ніж спробувати ще раз, перевірте список профілів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo未收到服务器的响应。请先检查个人资料列表再重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo 沒有收到伺服器的回應。請先檢查個人檔案清單，再重新嘗試。"
          }
        }
      }
    },
    "newProfile.unconfirmed.ownerChanged" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): body of the Profile May Have Been Created alert when the server or signed-in account changed before the create finished; the form closes so the user can check the list.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر الخادم أو الحساب أثناء إنشاء الملف الشخصي. تحقق من قائمة الملفات الشخصية قبل المحاولة مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během vytváření profilu se změnil server nebo účet. Než to zkusíte znovu, zkontrolujte seznam profilů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren eller kontoen blev ændret, mens profilen blev oprettet. Tjek profillisten, før du prøver igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server oder das Konto hat sich beim Erstellen des Profils geändert. Prüfe die Profilliste, bevor du es erneut versuchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server or account changed while creating the profile. Check the profile list before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor o la cuenta cambiaron mientras se creaba el perfil. Revisa la lista de perfiles antes de volver a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin tai tili vaihtui profiilin luomisen aikana. Tarkista profiililuettelo ennen kuin yrität uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur ou le compte a changé pendant la création du profil. Vérifiez la liste des profils avant de réessayer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj ili račun promijenio se tijekom izrade profila. Provjerite popis profila prije ponovnog pokušaja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server o l’account è cambiato durante la creazione del profilo. Controlla l’elenco dei profili prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールの作成中にサーバーまたはアカウントが変更されました。もう一度お試しになる前に、プロフィールの一覧を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필을 만드는 중에 서버 또는 계정이 변경됐어요. 다시 시도하기 전에 프로필 목록을 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren eller kontoen ble endret mens profilen ble opprettet. Sjekk profillisten før du prøver igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server of het account is gewijzigd tijdens het aanmaken van het profiel. Controleer de profiellijst voordat je het opnieuw probeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer lub konto zmieniły się podczas tworzenia profilu. Sprawdź listę profili, zanim spróbujesz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor ou a conta mudou durante a criação do perfil. Confira a lista de perfis antes de tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время создания профиля сменился сервер или аккаунт. Проверьте список профилей, прежде чем повторять попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern eller kontot ändrades medan profilen skapades. Kontrollera profillistan innan du försöker igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil oluşturulurken sunucu veya hesap değişti. Tekrar denemeden önce profil listesini kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час створення профілю змінився сервер або обліковий запис. Перш ніж спробувати ще раз, перевірте список профілів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建个人资料时服务器或账户发生了变化。请先检查个人资料列表再重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立個人檔案時，伺服器或帳號已變更。請先檢查個人檔案清單，再重新嘗試。"
          }
        }
      }
    },
