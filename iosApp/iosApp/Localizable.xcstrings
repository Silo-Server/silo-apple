    "servers.row.hintCurrent" : {
      "comment" : "Apple TV Manage Servers: VoiceOver hint on the server in use. Explains that its name comes from the server's administrator. No final full stop in English.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخادم الحالي. يدير مسؤول الخادم أسماء الخوادم"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuální server. Názvy serverů spravuje správce serveru"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuel server. Servernavne administreres af serveradministratoren"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktueller Server. Servernamen werden von der Serveradministration verwaltet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Current server. Server names are managed by the server administrator"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidor actual. El administrador del servidor gestiona los nombres de los servidores"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyinen palvelin. Palvelinten nimiä hallitsee palvelimen ylläpitäjä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveur actuel. Les noms des serveurs sont gérés par la personne qui administre le serveur"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenutačni poslužitelj. Nazivima poslužitelja upravlja administrator poslužitelja"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server in uso. I nomi dei server sono gestiti dall’amministratore del server"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用中のサーバーです。サーバー名はサーバーの管理者が管理しています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
