    "filters.preserveHint" : {
      "comment" : "Apple iOS: explanation under the Preserve sort & filters switch in the library filter sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعادة فتح هذه المكتبة تمامًا كما تركتها"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази библиотека ще се отваря точно както сте я оставили"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna a obrir aquesta biblioteca tal com la vas deixar"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knihovna se znovu otevře přesně ve stejném stavu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genåbn dette bibliotek præcis, som du forlod det"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mediathek öffnet sich genau so, wie du sie verlassen hast"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η βιβλιοθήκη ανοίγει ξανά ακριβώς όπως την αφήσατε"
          }
        },
        "en" : {
          "stringUnit" : {
