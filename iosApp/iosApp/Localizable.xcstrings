    "diagnostics.preparing" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: progress label while Send Diagnostics Now builds and sends a report.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
