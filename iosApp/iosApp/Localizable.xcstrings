    "settings.about.openSourceFooter" : {
      "comment" : "Apple Settings > About > Acknowledgements (iPhone, iPad, Mac): explanation under the Open Source Licenses row.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترخيص Silo، وتراخيص الشيفرة المضمّنة فيه ومراجعاتها المصدرية الدقيقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лицензът на Silo, както и лицензите и точните версии на изходния код, вграден в него."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La llicència de Silo, i les llicències i les revisions exactes del codi font que s’hi inclou."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licence Silo a licence a přesné revize zdrojového kódu, který je jeho součástí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silos licens samt licenserne og de præcise kilderevisioner for den kode, der er indbygget i den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lizenz von Silo sowie die Lizenzen und genauen Quellrevisionen des darin enthaltenen Codes."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η άδεια του Silo, καθώς και οι άδειες και οι ακριβείς αναθεωρήσεις πηγαίου κώδικα του κώδικα που ενσωματώνει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo's license, and the licenses and exact source revisions of the code built into it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licencia de Silo y las licencias y revisiones exactas del código fuente que incorpora."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo litsents ning sellesse sisse ehitatud koodi litsentsid ja täpsed lähtekoodi versioonid."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silon lisenssi sekä siihen sisältyvän koodin lisenssit ja tarkat lähdekoodiversiot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licence de Silo, ainsi que les licences et les révisions exactes des sources du code qui y est intégré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרישיון של Silo, והרישיונות והגרסאות המדויקות של קוד המקור שמשולב בו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo का लाइसेंस, और इसमें शामिल कोड के लाइसेंस और सटीक सोर्स रिविज़न।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licenca aplikacije Silo te licence i točne revizije izvornog koda ugrađenog u nju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo licence, valamint a beépített kód licencei és pontos forrásrevíziói."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisensi Silo, serta lisensi dan revisi sumber yang persis dari kode yang dibangun di dalamnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licenza di Silo, e le licenze e le revisioni esatte del codice sorgente incluso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloのライセンスと、Siloに組み込まれたコードのライセンスおよび正確なソースリビジョン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo의 라이선스와, Silo에 포함된 코드의 라이선스 및 정확한 소스 리비전."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Silo“ licencija, taip pat į programą įtraukto kodo licencijos ir tikslios šaltinio kodo revizijos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo licence, kā arī tajā iebūvētā koda licences un precīzas pirmkoda revīzijas."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lesen Silo, serta lesen dan semakan sumber yang tepat bagi kod yang dibina ke dalamnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silos lisens, og lisensene og de nøyaktige kilderevisjonene for koden som er bygget inn i den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De licentie van Silo, en de licenties en exacte bronrevisies van de code die erin is ingebouwd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licencja Silo oraz licencje i dokładne rewizje źródeł kodu wbudowanego w aplikację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A licença do Silo e as licenças e revisões exatas do código-fonte incorporado a ele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A licença do Silo, bem como as licenças e as revisões exatas do código-fonte nele incorporado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licența aplicației Silo, precum și licențele și reviziile exacte ale surselor codului inclus în aceasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лицензия Silo, а также лицензии и точные ревизии исходного кода встроенных в него компонентов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licencia aplikácie Silo a licencie a presné revízie zdrojového kódu, ktorý je do nej zabudovaný."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licenca aplikacije Silo ter licence in natančne revizije izvorne kode, vgrajene vanjo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silos licens samt licenserna och de exakta källkodsrevisionerna för koden som ingår i appen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัญญาอนุญาตของ Silo รวมถึงสัญญาอนุญาตและเวอร์ชันซอร์สที่แน่นอนของโค้ดที่รวมอยู่ใน Silo"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo’nun lisansı ile içine yerleştirilmiş kodun lisansları ve tam kaynak sürümleri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ліцензія Silo, а також ліцензії та точні ревізії вихідного коду, вбудованого в нього."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giấy phép của Silo, cùng giấy phép và phiên bản mã nguồn chính xác của mã được tích hợp trong Silo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo的许可证，以及其中内置代码的许可证和确切源代码版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo 的授權，以及內建程式碼的授權與確切原始碼版本。"
          }
        }
      }
