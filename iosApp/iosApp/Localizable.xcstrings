    "watchParty.invite.scan" : {
      "comment" : "Roku, Android phone and TV: line beside a QR code on the invite dialog, which opens the invitation on a phone. Apple (iPhone, iPad, Apple TV): same hint under the invitation code.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أو امسح الرمز لفتح الدعوة على الهاتف."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или сканирайте, за да отворите поканата на телефон."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escaneja per obrir la invitació en un telèfon."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebo naskenujte kód a otevřete pozvánku v telefonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller scan for at åbne invitationen på en telefon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder scanne den Code, um die Einladung auf einem Smartphone zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ή σαρώστε για να ανοίξετε την πρόσκληση σε τηλέφωνο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or scan to open the invitation on a phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escanea para abrir la invitación en un teléfono."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Või skannige, et avada kutse telefonis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai avaa kutsu puhelimella skannaamalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou scannez pour ouvrir l’invitation sur un téléphone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר גם לסרוק כדי לפתוח את ההזמנה בטלפון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या फ़ोन पर आमंत्रण खोलने के लिए स्कैन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ili skenirajte kako biste otvorili pozivnicu na telefonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vagy olvassa be a kódot, és nyissa meg a meghívót telefonon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atau pindai untuk membuka undangan di ponsel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure scansiona per aprire l’invito su un telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "または、スキャンしてスマートフォンで招待を開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또는 스캔해서 휴대폰에서 초대를 여세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arba nuskenuokite, kad atidarytumėte kvietimą telefone."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
