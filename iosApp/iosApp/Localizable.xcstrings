    "player.error.incompatiblePlan" : {
      "comment" : "Apple iOS/tvOS/macOS: player error when the server's playback plan can't be used by this app version. Used by the audiobook player. Keep \"V3\" as is.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعاد الخادم خطة تشغيل غير متوافقة بالبروتوكول V3."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърът върна несъвместим план за възпроизвеждане по протокол V3."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha retornat un pla de reproducció del protocol V3 incompatible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server vrátil nekompatibilní plán přehrávání protokolu V3."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren returnerede en inkompatibel afspilningsplan til protokol V3."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat einen inkompatiblen Wiedergabeplan für Protokoll V3 zurückgegeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής επέστρεψε μη συμβατό σχέδιο αναπαραγωγής πρωτοκόλλου V3."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server returned an incompatible protocol V3 playback plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor devolvió un plan de reproducción del protocolo V3 incompatible."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server tagastas ühildumatu protokolli V3 esitusplaani."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
