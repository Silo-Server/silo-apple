    "upNext.lookupFailed" : {
      "comment" : "Error message on the Roku Up Next panel when the next episode could not be loaded; the On Deck row below offers alternatives, or the user can go back. Apple tvOS: message on the player's Up Next screen above On Deck.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل الحلقة التالية. اختر شيئًا من «قيد المشاهدة» أو ارجع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se načíst další díl. Vyberte něco v sekci Rozkoukané, nebo se vraťte zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke indlæse næste afsnit. Vælg noget fra I gang, eller gå tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nächste Folge konnte nicht geladen werden. Wähle etwas aus „Laufend“ oder gehe zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load the next episode. Pick something from On Deck, or go back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar el siguiente episodio. Elige algo de En curso o vuelve atrás."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraavan jakson lataaminen epäonnistui. Valitse jotain Kesken-riviltä tai palaa takaisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger l’épisode suivant. Choisissez un titre dans En cours ou revenez en arrière."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće učitati sljedeću epizodu. Odaberite nešto iz retka U tijeku ili se vratite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare il prossimo episodio. Scegli qualcosa dalla riga In corso o torna indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のエピソードを読み込めませんでした。視聴中から選ぶか、戻ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 에피소드를 불러올 수 없어요. 시청 중에서 선택하거나 뒤로 돌아가세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke laste inn neste episode. Velg noe fra Pågående, eller gå tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de volgende aflevering niet laden. Kies iets uit Bezig of ga terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wczytać następnego odcinka. Wybierz coś z sekcji W toku lub wróć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar o próximo episódio. Escolha algo em Em andamento ou volte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить следующую серию. Выберите что-нибудь в разделе «В процессе» или вернитесь назад."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att läsa in nästa avsnitt. Välj något från Pågående eller gå tillbaka."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonraki bölüm yüklenemedi. Devam edenler satırından bir şey seçin veya geri dönün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося завантажити наступний епізод. Виберіть щось із розділу «Розпочате» або поверніться назад."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载下一集。请从进行中选择内容，或返回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法載入下一集。請從進行中挑選其他內容，或返回。"
          }
        }
      }
    },
