    "player.notice.recoveryFailedTitle" : {
      "comment" : "Apple iOS/tvOS/macOS: title of the video player notice when restarting playback after a failure did not work; the reason follows below.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشلت استعادة التشغيل"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неуспешно възстановяване на възпроизвеждането"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha fallat la recuperació de la reproducció"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovení přehrávání selhalo"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendannelse af afspilning mislykkedes"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederherstellung der Wiedergabe fehlgeschlagen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποτυχία επαναφοράς αναπαραγωγής"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback recovery failed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
