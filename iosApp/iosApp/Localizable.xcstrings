    "diagnostics.availability.offlineDetail" : {
      "comment" : "Footer under the Diagnostics settings Feature State section when the server is offline. Shown on Android phone and Apple (iPhone, iPad).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم عرض آخر حالة معروفة للتشخيص. تبقى التقارير على هذا الجهاز ما دام الخادم غير متصل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
