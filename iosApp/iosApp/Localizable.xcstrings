    "home.recipe.seAuto.details" : {
      "comment" : "Longer description of the Seasonal Picks preset in the Add row gallery (shared key `home.recipe.seAuto.details`, sent as description_long_key). Shown when a client opens the preset.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قسم واحد يعرض اختيارات منسقة للعطلات وفق التقويم. اختر العطلات وأجواء لكل منها، وأضف عطلاتك الخاصة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Един раздел, който показва подбрани празнични заглавия според календара. Изберете празниците и настроение за всеки от тях и добавете свои празници."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una secció que mostra seleccions de festes triades a mà segons el calendari. Tria les festes i un estil per a cadascuna, i afegeix les teves pròpies festes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna sekce, která podle kalendáře zobrazuje vybrané sváteční tipy. Zvolte svátky a náladu pro každý z nich a přidejte vlastní svátky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én sektion, der skifter til udvalgte højtidsfilm ud fra kalenderen. Vælg højtiderne og en stemning for hver, og tilføj dine egne højtider."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bereich, der je nach Kalender kuratierte Empfehlungen zu Feiertagen einblendet. Wähle die Feiertage und für jeden eine Stimmung, und füge eigene Feiertage hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια ενότητα που εναλλάσσει επιλεγμένους εορταστικούς τίτλους βάσει του ημερολογίου. Επιλέξτε τις γιορτές και ένα ύφος για καθεμία και προσθέστε τις δικές σας γιορτές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One section that swaps in curated holiday picks based on the calendar. Choose the holidays, a vibe for each, and add your own holidays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sola sección que muestra selecciones festivas según el calendario. Elige las festividades y un ambiente para cada una, y añade tus propias festividades."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üks jaotis, mis toob kalendri põhjal esile valitud pühadeteemalised pealkirjad. Valige pühad ja igaühele meeleolu ning lisage oma pühi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi osio, joka vaihtaa esiin kalenterin mukaan valikoituja juhlapyhien elokuvia. Valitse juhlapyhät ja kullekin tunnelma, ja lisää omia juhlapyhiäsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une seule section qui affiche des sélections de fêtes selon le calendrier. Choisissez les fêtes et une ambiance pour chacune, et ajoutez vos propres fêtes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אזור אחד שמתחלף לבחירות חגים נבחרות לפי לוח השנה. אפשר לבחור את החגים ואווירה לכל אחד מהם, ולהוסיף חגים משלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक सेक्शन, जो कैलेंडर के हिसाब से त्योहारों के लिए चुने गए टाइटल दिखाता है। त्योहार चुनें, हर त्योहार के लिए एक मूड चुनें और अपने त्योहार जोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedan odjeljak koji prema kalendaru prikazuje odabrane blagdanske prijedloge. Odaberite blagdane i ugođaj za svaki te dodajte vlastite blagdane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyetlen szakasz, amely a naptár alapján válogatott ünnepi ajánlatokra vált. Válassza ki az ünnepeket és mindegyikhez egy hangulatot, és adja hozzá a saját ünnepeit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu bagian yang menampilkan pilihan hari raya hasil kurasi berdasarkan kalender. Pilih hari raya, suasana untuk masing-masing, dan tambahkan hari raya Anda sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sezione che propone selezioni festive in base al calendario. Scegli le festività, un’atmosfera per ciascuna e aggiungi le tue festività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーに合わせて、厳選された祝日のおすすめに切り替わるセクションです。祝日とそれぞれの雰囲気を選び、独自の祝日を追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "달력에 맞춰 엄선한 기념일 추천작으로 바뀌는 섹션이에요. 기념일과 각 기념일의 분위기를 선택하고, 원하는 기념일을 직접 추가할 수도 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viena skiltis, kurioje pagal kalendorių rodomi atrinkti šventiniai pasiūlymai. Pasirinkite šventes, kiekvienos nuotaiką ir pridėkite savų švenčių."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viena sadaļa, kas atkarībā no kalendāra rāda atlasītus svētku ieteikumus. Izvēlieties svētkus un katram noskaņu, kā arī pievienojiet savus svētkus."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu bahagian yang memaparkan pilihan perayaan terpilih mengikut kalendar. Pilih perayaan, suasana bagi setiap satu, dan tambah perayaan anda sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én seksjon som bytter inn utvalgte høytidstitler etter kalenderen. Velg høytidene og en stemning for hver, og legg til dine egne høytider."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén sectie die op basis van de kalender wisselt naar geselecteerde feestdagtitels. Kies de feestdagen en per feestdag een sfeer, en voeg je eigen feestdagen toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna sekcja, która zależnie od kalendarza wyświetla wybrane świąteczne propozycje. Wybierz święta i klimat dla każdego z nich, a także dodaj własne święta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma seção que alterna sugestões de datas comemorativas com curadoria conforme o calendário. Escolha as datas, um clima para cada uma e adicione suas próprias datas comemorativas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma secção que apresenta seleções para datas festivas com base no calendário. Escolha as datas festivas e um estilo para cada uma, e adicione as suas próprias datas festivas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O singură secțiune care afișează selecții de sărbători în funcție de calendar. Alegeți sărbătorile și o atmosferă pentru fiecare și adăugați propriile sărbători."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один раздел, в котором праздничные подборки меняются по календарю. Выберите праздники и настроение для каждого из них или добавьте свои праздники."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna sekcia, ktorá podľa kalendára zobrazuje vybrané sviatočné tipy. Vyberte sviatky, náladu pre každý z nich a pridajte vlastné sviatky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En razdelek, ki glede na koledar prikaže izbrane praznične predloge. Izberite praznike in vzdušje za vsakega ter dodajte svoje praznike."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sektion som byter till utvalda högtidstitlar utifrån kalendern. Välj högtider och en stämning för var och en, och lägg till egna högtider."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่วนเดียวที่สลับเป็นรายการคัดสรรสำหรับเทศกาลตามปฏิทิน เลือกเทศกาลและบรรยากาศของแต่ละเทศกาล และเพิ่มเทศกาลของคุณเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takvime göre özenle seçilmiş özel gün önerilerine geçen tek bir kısım. Özel günleri ve her biri için bir tarz seçin, kendi özel günlerinizi de ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один розділ, у якому з’являються святкові добірки залежно від календаря. Виберіть свята, настрій для кожного з них і додайте власні свята."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một phần tự động đổi sang các lựa chọn tuyển chọn cho ngày lễ theo lịch. Chọn ngày lễ, phong cách cho từng ngày lễ và thêm ngày lễ của riêng bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个根据日历自动切换精选节日内容的版块。选择节日，为每个节日设定氛围，还可以添加你自己的节日。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個區塊，會依日曆換上精選的節日推薦。選擇節日和每個節日的風格，也可以新增你自己的節日。"
          }
        }
      }
    },
    "home.recipe.seFamilyMovieNight.description" : {
      "comment" : "One-line description of the Family Movie Night preset in the Add row gallery (shared key `home.recipe.seFamilyMovieNight.description`, sent as description_short_key). Shown under or beside the preset's name.",
