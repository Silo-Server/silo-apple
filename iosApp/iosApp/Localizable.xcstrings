    "player.progress.toggleTimeHint" : {
      "comment" : "Apple iOS: screen reader hint of the time at the right end of the iPhone and iPad player seek bar; tapping it switches what it shows.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدّل بين الوقت المتبقي والمدة الإجمالية"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превключва между оставащо време и обща продължителност"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterna entre el temps restant i la durada total"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepíná mezi zbývajícím časem a celkovou délkou"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skifter mellem resterende tid og samlet varighed"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselt zwischen Restzeit und Gesamtdauer"
          }
        },
        "el" : {
