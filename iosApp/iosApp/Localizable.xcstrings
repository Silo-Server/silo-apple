    "signIn.provider.serverIdentityUnavailable" : {
      "comment" : "Apple (iPhone, iPad, Mac): error before a provider sign-in when the app couldn't verify the saved server's identity.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التأكد من هوية هذا الخادم. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se ověřit, o jaký server jde. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke bekræfte, hvilken server dette er. Tjek forbindelsen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Identität dieses Servers konnte nicht bestätigt werden. Prüfe die Verbindung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't confirm which server this is. Check the connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo confirmar qué servidor es este. Comprueba la conexión y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimen tunnistaminen epäonnistui. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer l’identité de ce serveur. Vérifiez la connexion et réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće potvrditi o kojem je poslužitelju riječ. Provjerite vezu i pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile confermare l’identità del server. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーを確認できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 서버인지 확인할 수 없어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke bekrefte hvilken server dette er. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan niet bevestigen welke server dit is. Controleer de verbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się potwierdzić tożsamości serwera. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar qual é este servidor. Verifique a conexão e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось проверить, что это за сервер. Проверьте подключение и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att bekräfta vilken server det här är. Kontrollera anslutningen och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun hangi sunucu olduğu doğrulanamadı. Bağlantıyı kontrol edip tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося підтвердити, що це за сервер. Перевірте з’єднання й спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认这是哪台服务器。请检查连接，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法確認這是哪一台伺服器。請檢查連線，然後再試一次。"
          }
        }
      }
    },
