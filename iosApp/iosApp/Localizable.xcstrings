          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos votam. Você inicia o mais votado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосуют все, а вы запускаете лидирующий вариант."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
