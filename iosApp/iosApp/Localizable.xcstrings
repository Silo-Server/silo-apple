    "watchParty.page.body" : {
      "comment" : "Roku, Android phone and TV: short intro paragraph on the Watch Party start page explaining that playback stays in sync for everyone. Apple (iPhone, iPad, Apple TV): same line on the Watch Party hub.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر عنوانًا، وشارك الرمز، ويبقى التشغيل متزامنًا لدى الجميع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Titel, teile den Code, und die Wiedergabe bleibt bei allen synchron."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a title, share the code, and everyone's playback stays in step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un título, comparte el código y la reproducción de todos se mantiene sincronizada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un titre, partagez le code, et la lecture reste synchronisée pour tout le monde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作品を選んでコードを共有すると、全員の再生が同期されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um título, compartilhe o código e a reprodução fica sincronizada para todos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一部作品，分享代码，所有人的播放都会保持同步。"
          }
        }
      }
    },
