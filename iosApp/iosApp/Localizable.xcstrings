            "value" : "這台 Apple TV 是透過所在網路連上 %1$@，而該網路知道這台裝置屬於誰。"
          }
        }
      }
    },
    "tvSignIn.appleTv.qrLabel" : {
      "comment" : "Apple TV sign-in screen: VoiceOver label of the QR code. {url}: the activation address with each slash spoken as a word (for example media.example.com slash activate); {code}: the sign-in code's characters separated by spaces, read one by one.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رمز QR لتسجيل الدخول. أو انتقل إلى %1$@ وأدخل %2$@"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR код за вход. Или отидете на %1$@ и въведете %2$@"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codi QR d’inici de sessió. O ves a %1$@ i introdueix %2$@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlašovací QR kód. Nebo přejděte na %1$@ a zadejte %2$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-kode til login. Eller gå til %1$@, og indtast %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-Code zum Anmelden. Oder öffne %1$@ und gib %2$@ ein"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κωδικός QR σύνδεσης. Ή μεταβείτε στη διεύθυνση %1$@ και πληκτρολογήστε τον κωδικό %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign-in QR code. Or go to %1$@ and enter %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Código QR de inicio de sesión. O ve a %1$@ y escribe %2$@"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisselogimise QR-kood. Või avage aadress %1$@ ja sisestage kood %2$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjautumisen QR-koodi. Tai siirry osoitteeseen %1$@ ja syötä %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR code de connexion. Ou accédez à %1$@ et saisissez %2$@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קוד QR להתחברות. אפשר גם לעבור לכתובת %1$@ ולהזין את הקוד %2$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन इन QR कोड। या %1$@ पर जाएँ और %2$@ डालें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR kôd za prijavu. Ili otvorite %1$@ i unesite %2$@"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bejelentkezési QR-kód. Vagy nyissa meg ezt a címet: %1$@, és adja meg ezt a kódot: %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kode QR untuk masuk. Atau buka %1$@ dan masukkan %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codice QR di accesso. Oppure vai su %1$@ e inserisci %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン用QRコード。または%1$@にアクセスして%2$@を入力してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 QR 코드. 또는 %1$@에 접속해 다음 코드를 입력하세요: %2$@"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisijungimo QR kodas. Arba eikite į %1$@ ir įveskite %2$@"
          }
        },
        "lv" : {
