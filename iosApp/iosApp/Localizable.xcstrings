        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on muuttunut sen jälkeen, kun avasit sen. Päivitä ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet élément a changé depuis son chargement. Rechargez et réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo se promijenilo otkad ste ga učitali. Ponovno učitajte i pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa è cambiato dopo il caricamento. Ricarica e riprova."
