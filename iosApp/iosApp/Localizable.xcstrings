          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンまたはタブレットから送信された%1$@のアドレスは、別のサーバーとして応答しました。スマートフォンまたはタブレットでサーバーを確認するか、サーバーを手動で追加してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
