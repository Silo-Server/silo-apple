    "remote.error.pairingRefused" : {
      "comment" : "Apple iOS: Remote Control error when a paired Roku refuses the phone's pairing key. Keep \"Connect a Phone\" as the Roku's menu item is named.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يقبل التلفزيون إقران جهاز iPhone هذا. على التلفزيون، افتح «توصيل هاتف» في Silo وامسح رمزه مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телевизорът не прие сдвояването с този iPhone. На телевизора отворете „Свързване на телефон“ в Silo и сканирайте кода му отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV no ha acceptat la vinculació d’aquest iPhone. A la TV, obre Connecta un telèfon a Silo i torna a escanejar-ne el codi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Televize nepřijala spárování tohoto iPhonu. Na televizi otevřete v aplikaci Silo položku Připojit telefon a znovu naskenujte její kód."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tv’et accepterede ikke denne iPhones parring. Åbn Forbind telefon i Silo på tv’et, og scan koden igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher hat die Kopplung dieses iPhones nicht akzeptiert. Öffne auf dem Fernseher in Silo „Smartphone verbinden“ und scanne den Code erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τηλεόραση δεν αποδέχτηκε τη σύζευξη αυτού του iPhone. Στην τηλεόραση, ανοίξτε τη «Σύνδεση τηλεφώνου» στο Silo και σαρώστε ξανά τον κωδικό της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The TV didn't accept this iPhone's pairing. On the TV, open Connect a Phone in Silo and scan its code again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV no aceptó la vinculación de este iPhone. En la TV, abre Conectar un teléfono en Silo y vuelve a escanear su código."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teler ei aktsepteerinud selle iPhone’i sidumist. Avage teleris Silos „Ühenda telefon“ ja skannige selle kood uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tv ei hyväksynyt tämän iPhonen laiteparia. Avaa tv:n Silossa Yhdistä puhelin ja skannaa sen koodi uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV n’a pas accepté l’association de cet iPhone. Sur la TV, ouvrez Connecter un téléphone dans Silo et scannez de nouveau son code."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הטלוויזיה לא אישרה את הצימוד של ה-iPhone הזה. בטלוויזיה, יש לפתוח את ”חיבור טלפון” ב-Silo ולסרוק שוב את הקוד שלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टीवी ने इस iPhone की पेयरिंग स्वीकार नहीं की। टीवी पर Silo में “फ़ोन कनेक्ट करें” खोलें और उसका कोड फिर से स्कैन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV nije prihvatio uparivanje ovog iPhonea. Na TV-u u aplikaciji Silo otvorite „Poveži telefon“ i ponovno skenirajte kod."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV nem fogadta el ennek az iPhone-nak a párosítását. A TV-n nyissa meg a Silóban a „Telefon csatlakoztatása” menüpontot, és olvassa be újra a kódját."
