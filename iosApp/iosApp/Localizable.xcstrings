    "settings.learnedLimit.resetFailed" : {
      "comment" : "Android error shown when clearing the learned speed limit failed. Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: error when Reset failed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت إعادة تعيين الحد. حاول مرة أخرى."
