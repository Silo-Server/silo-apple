        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server %1$@. Dvojitým klepnutím změníte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, server. Tryk to gange for at ændre."
          }
        },
