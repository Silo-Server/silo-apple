    "settingsManifest.playback.show_marker_source.description" : {
      "comment" : "Help text under the playback.show_marker_source setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض مصدر التخطي فوق زر «تخطي المقدمة»: اكتشاف Silo الخاص، أو شخص، أو المزود الذي قدّم العلامة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показва над бутона „Прескачане на въведението“ откъде идва прескачането: собственото разпознаване на Silo, човек или доставчикът на маркера."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra d’on prové l’omissió a sobre del botó Omet la introducció: la detecció pròpia de Silo, una persona o el proveïdor que ha subministrat el marcador."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nad tlačítkem Přeskočit úvod zobrazí, odkud přeskočení pochází: z vlastní detekce Silo, od člověka, nebo od poskytovatele, který značku dodal."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis over knappen Spring intro over, hvor overspringet kommer fra: Silos egen genkendelse, en person eller den udbyder, der leverede markøren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt über der Schaltfläche „Intro überspringen“ an, woher das Überspringen stammt: von Silos eigener Erkennung, von einer Person oder vom Anbieter, der die Markierung geliefert hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση της προέλευσης της παράλειψης πάνω από το κουμπί «Παράλειψη εισαγωγής»: ο εντοπισμός του ίδιου του Silo, ένα άτομο ή ο πάροχος που παρείχε τον δείκτη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show where the skip came from above the Skip Intro button: Silo's own detection, a person, or the provider that supplied the marker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra sobre el botón Omitir introducción de dónde viene la omisión: la detección propia de Silo, una persona o el proveedor que aportó el marcador."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näitab nupu „Jäta intro vahele“ kohal, kust vahelejätmine pärineb: Silo enda tuvastus, inimene või märgendi esitanud teenusepakkuja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä Ohita alkutunnus -painikkeen yläpuolella, mistä ohitus on peräisin: Silon oma tunnistus, henkilö tai merkinnän toimittanut palvelu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche au-dessus du bouton « Passer l’intro » l’origine du passage : la détection de Silo, une personne ou le fournisseur du marqueur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת מקור הדילוג מעל הכפתור ”דילוג על הפתיח”: הזיהוי של Silo עצמו, אדם, או הספק שסיפק את הסימון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“इंट्रो छोड़ें” बटन के ऊपर दिखाएँ कि स्किप कहाँ से आया: Silo की अपनी पहचान, कोई व्यक्ति, या मार्कर देने वाला प्रोवाइडर।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iznad gumba Preskoči uvod prikazuje odakle dolazi preskakanje: Silovo vlastito prepoznavanje, osoba ili pružatelj koji je dostavio oznaku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annak megjelenítése a Bevezető átugrása gomb felett, honnan származik az átugrás: a Silo saját felismeréséből, egy személytől vagy a jelölőt biztosító szolgáltatótól."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan asal opsi lewati di atas tombol Lewati intro: deteksi Silo sendiri, seseorang, atau penyedia yang menyediakan penanda itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra sopra il pulsante Salta intro da dove proviene il salto: il rilevamento di Silo, una persona o il provider che ha fornito il marcatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「イントロをスキップ」ボタンの上にスキップの出所を表示します。Silo独自の検出、人による指定、またはマーカーを提供したプロバイダーのいずれかです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인트로 건너뛰기 버튼 위에 건너뛰기 정보의 출처를 표시해요. Silo의 자체 감지, 사람, 또는 마커를 제공한 제공자 중 하나예요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virš mygtuko „Praleisti įžangą“ rodyti, iš kur gautas praleidimas: paties „Silo“ aptikimas, žmogus ar žymą pateikęs teikėjas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virs pogas „Izlaist ievadu” rāda, no kurienes ir izlaišana: Silo noteikšana, cilvēks vai nodrošinātājs, kas sniedza marķieri."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan asal langkauan di atas butang Langkau intro: pengesanan Silo sendiri, seseorang, atau pembekal yang menyediakan penanda itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis hvor hoppet kom fra, over knappen «Hopp over intro»: Silos egen gjenkjenning, en person eller leverandøren som leverte markøren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon boven de knop Intro overslaan waar het overslaan vandaan komt: Silo’s eigen detectie, een persoon of de provider die de markering leverde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj nad przyciskiem Pomiń czołówkę, skąd pochodzi pominięcie: z wykrywania w Silo, od osoby lub od dostawcy, który dostarczył znacznik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra acima do botão Pular abertura a origem do salto: a detecção do próprio Silo, uma pessoa ou o provedor que forneceu o marcador."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar a origem do salto por cima do botão Saltar introdução: a deteção do próprio Silo, uma pessoa ou o fornecedor do marcador."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează deasupra butonului Omiteți introducerea de unde provine omiterea: detectarea făcută de Silo, o persoană sau furnizorul care a oferit marcajul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать над кнопкой «Пропустить вступление», откуда взят пропуск: собственное распознавание Silo, человек или провайдер, предоставивший метку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nad tlačidlom Preskočiť úvod zobrazí, odkiaľ preskočenie pochádza: z vlastného rozpoznávania aplikácie Silo, od človeka alebo od poskytovateľa, ktorý značku dodal."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nad gumbom „Preskoči uvod“ prikaži, od kod je preskok: lastno zaznavanje aplikacije Silo, oseba ali ponudnik, ki je posredoval oznako."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa var överhoppningen kommer ifrån ovanför knappen ”Hoppa över intro”: Silos egen identifiering, en person eller leverantören som tillhandahöll markören."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงที่มาของการข้ามเหนือปุ่ม “ข้ามอินโทร”: การตรวจจับของ Silo เอง บุคคล หรือผู้ให้บริการที่ให้มาร์กเกอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atlamanın nereden geldiğini Girişi Atla düğmesinin üzerinde gösterir: Silo’nun kendi algılaması, bir kişi veya işaretçiyi sağlayan sağlayıcı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати над кнопкою «Пропустити заставку», звідки взято пропуск: власне розпізнавання Silo, людина або постачальник, який надав мітку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị nguồn gốc của lần bỏ qua phía trên nút Bỏ qua đoạn mở đầu: tính năng phát hiện của Silo, một người, hoặc nhà cung cấp đã cung cấp mốc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“跳过片头”按钮上方显示跳过标记的来源：Silo自身检测、人工标记，或提供该标记的提供商。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「略過片頭」按鈕上方顯示略過標記的來源：Silo 自己的偵測、人工標記，或提供標記的提供者。"
          }
        }
      }
    },
