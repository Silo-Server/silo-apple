    "downloads.seriesSheet.oneTimeHint" : {
      "comment" : "Apple iOS/macOS: series Download sheet, opened from a series page; note under the segments when One Time is chosen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التنزيل الآن. لن يُنزَّل أي شيء آخر لاحقًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изтегляне сега. По-късно няма да се изтегля нищо друго."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa-ho ara. Després no es baixarà res més."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stáhnout nyní. Později se už nic dalšího stahovat nebude."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download nu. Intet andet downloades senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt herunterladen. Später wird nichts weiter heruntergeladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λήψη τώρα. Τίποτα άλλο δεν θα ληφθεί αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download now. Nothing else downloads later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga ahora. No se descargará nada más después."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laaditakse alla kohe. Hiljem midagi muud ei laadita."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataa nyt. Myöhemmin ei ladata mitään muuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargement immédiat. Rien d’autre n’est téléchargé ensuite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההורדה מתבצעת עכשיו, בלי הורדות נוספות בהמשך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी डाउनलोड करें। बाद में और कुछ डाउनलोड नहीं होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzmite sada. Kasnije se ništa drugo ne preuzima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letöltés most. Később semmi más nem töltődik le."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduh sekarang. Tidak ada yang diunduh lagi nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica ora. In seguito non verrà scaricato altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐダウンロードします。後から追加でダウンロードされることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 다운로드해요. 이후에는 아무것도 다운로드하지 않아요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atsisiunčiama dabar. Vėliau daugiau nieko nebus atsisiųsta."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejupielāde notiek tagad. Vēlāk nekas netiek lejupielādēts."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
