    "player.subtitleSync.forbiddenOwner" : {
      "comment" : "Apple iOS/tvOS/macOS: replaces the timing actions after an older server refused them for this profile. Shown under the selected subtitle's timing actions in the player: the iOS Audio & Subtitles sheet, the macOS player options panel and the tvOS info panel's Subtitles tab.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تغيير توقيت هذه الترجمة إلا لمن أضافها أو للمسؤول."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Само потребителят, който добави тези субтитри, или администратор може да промени времето им."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només qui ha afegit aquests subtítols o un administrador en pot canviar la sincronització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časování těchto titulků může změnit jen ten, kdo je přidal, nebo správce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun den person, der tilføjede underteksten, eller en administrator kan ændre dens timing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Person, die diese Untertitel hinzugefügt hat, oder ein Admin kann das Timing ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο όποιος πρόσθεσε αυτούς τους υπότιτλους ή ένας διαχειριστής μπορεί να αλλάξει τον χρονισμό τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the person who added this subtitle or an admin can change its timing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo quien añadió este subtítulo o un administrador puede cambiar sus tiempos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
