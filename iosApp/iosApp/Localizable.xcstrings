    "tvPairing.connectedDetailServersAppleTv" : {
      "comment" : "Apple TV pairing screen (shown while a nearby phone sets up or signs in this Apple TV): instruction under the headline once a phone connected for setup.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على هاتفك أو جهازك اللوحي، اختر الخوادم التي سيسجّل جهاز Apple TV هذا الدخول إليها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На телефона или таблета си изберете в кои сървъри да влезе това Apple TV."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al telèfon o la tauleta, tria en quins servidors ha d’iniciar la sessió aquest Apple TV."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V telefonu nebo tabletu vyberte servery, ke kterým se má toto Apple TV přihlásit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg på din telefon eller tablet, hvilke servere dette Apple TV skal logge ind på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle auf deinem Smartphone oder Tablet, bei welchen Servern dieses Apple TV angemeldet werden soll."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο τηλέφωνο ή το tablet σας, επιλέξτε σε ποιους διακομιστές θα συνδεθεί αυτό το Apple TV."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your phone or tablet, choose which servers this Apple TV should sign in to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu teléfono o tableta, elige en qué servidores debe iniciar sesión este Apple TV."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valige oma telefonis või tahvelarvutis, millistesse serveritesse see Apple TV peaks sisse logima."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse puhelimessasi tai tabletissasi palvelimet, joille tämä Apple TV kirjautuu sisään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre téléphone ou votre tablette, choisissez les serveurs auxquels cette Apple TV doit se connecter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבחור בטלפון או בטאבלט שלך לאילו שרתים ה-Apple TV הזה יתחבר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने फ़ोन या टैबलेट पर चुनें कि यह Apple TV किन सर्वरों में साइन इन करे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na telefonu ili tabletu odaberite na koje se poslužitelje ovaj Apple TV treba prijaviti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A telefonján vagy táblagépén válassza ki, mely szerverekre jelentkezzen be ez az Apple TV."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di ponsel atau tablet Anda, pilih server yang akan dimasuki Apple TV ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul telefono o tablet, scegli i server a cui questa Apple TV deve accedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンまたはタブレットで、このApple TVでサインインするサーバーを選択してください。"
