    "tvPairing.confirmDetail" : {
      "comment" : "Android TV instruction under the code: confirm that the phone or tablet shows the same code, then approve there. Apple TV: same instruction on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من أن هاتفك أو جهازك اللوحي يعرض هذا الرمز، ثم وافق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверете дали телефонът или таблетът ви показва този код, след което одобрете."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprova que el telèfon o la tauleta mostrin aquest codi i, després, aprova-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte, že telefon nebo tablet zobrazuje tento kód, a pak přihlášení schvalte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollér, at din telefon eller tablet viser denne kode, og godkend derefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob dein Smartphone oder Tablet diesen Code anzeigt, und bestätige dann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βεβαιωθείτε ότι το τηλέφωνο ή το tablet σας εμφανίζει αυτόν τον κωδικό και, στη συνέχεια, εγκρίνετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that your phone or tablet shows this code, then approve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que tu teléfono o tableta muestre este código y luego apruébalo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollige, et teie telefon või tahvelarvuti näitaks seda koodi, ja kinnitage seejärel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista, että puhelimessasi tai tabletissasi näkyy tämä koodi, ja hyväksy sitten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que votre téléphone ou votre tablette affiche ce code, puis approuvez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לוודא שהקוד הזה מוצג בטלפון או בטאבלט שלך, ואז לאשר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देखें कि आपके फ़ोन या टैबलेट पर यही कोड दिख रहा है, फिर मंज़ूरी दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjerite prikazuje li vaš telefon ili tablet ovaj kôd, a zatim odobrite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
