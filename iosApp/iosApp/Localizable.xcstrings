    "library.emptyNamedBody" : {
      "comment" : "Roku and Apple tvOS library screen: supporting line under the named empty-state heading, telling the user media must be added on the server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف وسائط إلى هذه المكتبة على الخادم لتظهر هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge auf dem Server Medien zu dieser Mediathek hinzu, damit sie hier erscheinen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add media to this library on the server to see it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade contenido a esta biblioteca en el servidor para verlo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des médias à cette bibliothèque sur le serveur pour les voir ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここに表示するには、サーバーでこのライブラリにメディアを追加してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione mídia a esta biblioteca no servidor para vê-la aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在服务器上向此媒体库添加媒体后，即可在这里看到。"
          }
        }
      }
    },
    "library.error.someShelves" : {
      "comment" : "Notice above a library's Recommended rows when some rows only partly loaded for a Movies or Series view (Android phone and Apple iOS). Library is the name of the tab with every title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل بعض الرفوف بالكامل. أعد المحاولة أو افتح المكتبة لتصفح كل العناوين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Reihen konnten nicht vollständig geladen werden. Versuche es erneut oder öffne Mediathek, um alle Titel zu durchsuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some shelves could not be fully loaded. Retry or open Library to browse all titles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas filas no se pudieron cargar por completo. Vuelve a intentarlo o abre Biblioteca para explorar todos los títulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines rangées n’ont pas pu être entièrement chargées. Réessayez ou ouvrez Bibliothèque pour parcourir tous les titres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の行を完全に読み込めませんでした。再試行するか、ライブラリを開いてすべてのタイトルを表示してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas fileiras não puderam ser totalmente carregadas. Tente novamente ou abra Biblioteca para ver todos os títulos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分行无法完整加载。请重试，或打开媒体库浏览所有作品。"
          }
        }
      }
    },
    "library.error.someShelvesOpenBrowse" : {
