        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kijkt naar %2$@ op %3$@. Wil je in plaats daarvan jouw titel afspelen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil %1$@ ogląda tytuł %2$@ na telewizorze %3$@. Odtworzyć zamiast tego twój?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está assistindo a %2$@ em %3$@. Reproduzir o seu no lugar?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está a ver %2$@ em %3$@. Reproduzir o seu título em vez disso?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vizionează titlul %2$@ pe televizorul %3$@. Redați conținutul dvs. în schimb?"
