    "downloads.error.monitoringUncertain" : {
      "comment" : "Apple iOS/macOS: error message in the series download sheet when the connection dropped while saving monitoring.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo تأكيد تغيير المراقبة. تحقّق من هذا المسلسل مرة أخرى عند عودتك إلى الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не можа да потвърди промяната в наблюдението. Проверете този сериал отново, когато сте пак онлайн."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no ha pogut confirmar el canvi de supervisió. Torna a comprovar aquesta sèrie quan tornis a estar en línia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikaci Silo se nepodařilo potvrdit změnu sledování. Až budete znovu online, zkontrolujte tento seriál."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke bekræfte ændringen af overvågningen. Tjek serien igen, når du er online igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte die Änderung der Überwachung nicht bestätigen. Prüfe diese Serie erneut, sobald du wieder online bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Silo δεν μπόρεσε να επιβεβαιώσει την αλλαγή παρακολούθησης. Ελέγξτε ξανά αυτή τη σειρά μόλις συνδεθείτε ξανά στο διαδίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn't confirm the monitoring change. Check this series again once you're back online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo confirmar el cambio de supervisión. Vuelve a revisar esta serie cuando tengas conexión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei saanud jälgimise muudatust kinnitada. Kontrollige seda sarja uuesti, kui olete taas võrgus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei voinut vahvistaa seurannan muutosta. Tarkista tämä sarja uudelleen, kun olet taas verkossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a pas pu confirmer la modification du suivi. Vérifiez à nouveau cette série une fois de retour en ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ל-Silo לא הייתה אפשרות לאשר את השינוי במעקב. יש לבדוק שוב את הסדרה הזו כשהחיבור לאינטרנט יחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo मॉनिटरिंग में हुए बदलाव की पुष्टि नहीं कर सका। ऑनलाइन वापस आने पर इस सीरीज़ को फिर से जाँचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nije mogao potvrditi promjenu praćenja. Ponovno provjerite ovu seriju kada se vratite na mrežu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo nem tudta megerősíteni a figyelés módosítását. Ellenőrizze újra ezt a sorozatot, ha ismét online lesz."
