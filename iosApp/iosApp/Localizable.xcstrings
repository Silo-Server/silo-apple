    "settings.subtitles.scopeDeviceOnly" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac): footer while Only on This Device is on.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ على هذا الجهاز فقط. تستخدم الأجهزة الأخرى إعدادات الملف الشخصي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазено само на това устройство. Другите устройства използват настройките на профила."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desat només en aquest dispositiu. Els altres dispositius utilitzen la configuració del perfil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloženo jen na tomto zařízení. Ostatní zařízení používají nastavení profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun gemt på denne enhed. Andre enheder bruger profilens indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur auf diesem Gerät gespeichert. Andere Geräte verwenden die Einstellungen des Profils."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύεται μόνο σε αυτή τη συσκευή. Οι άλλες συσκευές χρησιμοποιούν τις ρυθμίσεις του προφίλ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved only on this device. Other devices use the profile's settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado solo en este dispositivo. Los demás dispositivos usan la configuración del perfil."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvestatud ainult selles seadmes. Teised seadmed kasutavad profiili seadeid."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennettu vain tähän laitteeseen. Muut laitteet käyttävät profiilin asetuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré sur cet appareil uniquement. Les autres appareils utilisent les paramètres du profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נשמר רק במכשיר הזה. מכשירים אחרים משתמשים בהגדרות הפרופיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ इस डिवाइस पर सेव किया गया। दूसरे डिवाइस प्रोफ़ाइल की सेटिंग इस्तेमाल करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremljeno samo na ovom uređaju. Ostali uređaji koriste postavke profila."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak ezen az eszközön van mentve. A többi eszköz a profil beállításait használja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya disimpan di perangkat ini. Perangkat lain menggunakan pengaturan profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato solo su questo dispositivo. Gli altri dispositivi usano le impostazioni del profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスにのみ保存されます。ほかのデバイスはプロフィールの設定を使用します。"
