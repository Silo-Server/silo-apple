    "pairing.error.alreadyDecided" : {
      "comment" : "Phone and tablet: nearby-TV setup card, when the TV's request was already answered. 1: the TV's name. Apple (iPhone, iPad): same error on the nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت الموافقة على طلب تسجيل الدخول هذا أو رفضه من قبل. ابدأ من جديد على %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anmeldeanfrage wurde bereits genehmigt oder abgelehnt. Beginne auf %1$@ erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sign-in request was already approved or declined. Start again on %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud de inicio de sesión ya se aprobó o se rechazó. Vuelve a empezar en %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette demande de connexion a déjà été approuvée ou refusée. Recommencez sur %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサインインのリクエストはすでに承認または拒否されています。%1$@でもう一度やり直してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitação de login já foi aprovada ou recusada. Comece novamente em %1$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此登录请求已被批准或拒绝。请在%1$@上重新开始。"
          }
        }
      }
    },
    "pairing.error.approveRefused" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: error when the server refused the approval for an unexpected reason. {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على %1$@ الموافقة على تسجيل الدخول. حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ konnte die Anmeldung nicht genehmigen. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ couldn’t approve the sign-in. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no pudo aprobar el inicio de sesión. Vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n’a pas pu approuver la connexion. Réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@でサインインを承認できませんでした。もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não conseguiu aprovar o login. Tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@无法批准此登录。请重试。"
          }
        }
      }
    },
    "pairing.error.codeExpired" : {
      "comment" : "Phone and tablet: nearby-TV setup card, when the TV's request expired. 1: the TV's name. Apple (iPhone, iPad): same error on the nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية الرمز قبل الموافقة عليه. ابدأ من جديد على %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code ist abgelaufen, bevor er genehmigt wurde. Beginne auf %1$@ erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code expired before it was approved. Start again on %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código caducó antes de aprobarse. Vuelve a empezar en %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code a expiré avant d’être approuvé. Recommencez sur %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認される前にコードの有効期限が切れました。%1$@でもう一度やり直してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O código expirou antes de ser aprovado. Comece novamente em %1$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代码在获批前已过期。请在%1$@上重新开始。"
          }
        }
      }
    },
    "pairing.error.codesDifferSetup" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: error after the person said the first code doesn't match the TV during setup.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تتطابق الرموز، لذا أُلغي الإعداد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Codes stimmten nicht überein, daher wurde die Einrichtung abgebrochen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The codes didn’t match, so setup was cancelled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los códigos no coincidían, así que se canceló la configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les codes ne correspondaient pas, la configuration a donc été annulée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードが一致しなかったため、セットアップはキャンセルされました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os códigos não correspondem, então a configuração foi cancelada."
          }
        },
        "zh-Hans" : {
