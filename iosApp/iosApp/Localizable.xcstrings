    "personal.watchlist.emptyBody" : {
      "comment" : "Explanation on an empty Watchlist screen (Roku) or empty Watchlist tab (Apple iOS) on how to add titles.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف عناوين من صفحة التفاصيل وستظهر هنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte tituly na stránce s podrobnostmi a zobrazí se zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj titler fra en detaljeside, så vises de her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Titel auf einer Detailseite hinzu, dann erscheinen sie hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add titles from a detail page and they will appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade títulos desde una página de detalles y aparecerán aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kohteita tietosivulta, niin ne näkyvät täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des titres depuis une page de détails et ils apparaîtront ici."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte naslove sa stranice s detaljima i pojavit će se ovdje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi titoli da una pagina dei dettagli e compariranno qui."
          }
        },
        "ja" : {
