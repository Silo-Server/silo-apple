          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi logotip kao naslov kada je dostupan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logógrafika használata címként, ha elérhető."
          }
        },
        "id" : {
