        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilmedi. Tekrar deneyin veya değişikliği aşağıdan atın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не збережено. Повторіть спробу або скасуйте зміну нижче."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa lưu. Thử lại hoặc hủy thay đổi bên dưới."
