    "buffering.promptMessage" : {
      "comment" : "Roku player: message in the buffering prompt suggesting a lower video quality so playback can continue. Apple iOS/tvOS/macOS: second line of the buffering pill over the player.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جرّب جودة أقل لمواصلة المشاهدة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine niedrigere Qualität, um weiterzuschauen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try a lower quality to keep watching"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba una calidad más baja para seguir viendo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez une qualité inférieure pour continuer à regarder"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴を続けるには画質を下げてください"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente uma qualidade menor para continuar assistindo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试试降低画质以继续观看"
          }
        }
      }
    },
    "buffering.undoCaption" : {
      "comment" : "Roku player: caption of the pill shown after quality was lowered automatically, next to a button to undo it. Apple iOS/tvOS/macOS: caption of the undo pill over the player, next to Restore quality.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم خفض الجودة لإيقاف التخزين المؤقت"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualität gesenkt, um das Puffern zu stoppen"
          }
