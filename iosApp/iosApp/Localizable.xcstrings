    "settings.connection.skippedCellular" : {
      "comment" : "Footnote in Android connection settings explaining speed tests are not run on mobile data, where the Cellular Quality settings apply instead. Apple Settings > Playback (iPhone, iPad, Mac) (iPhone, iPad): replaces the connection speed on cellular.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُجرى اختبارات السرعة على شبكة الهاتف المحمول، وتُطبَّق إعدادات جودة شبكة الهاتف المحمول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über Mobilfunk werden keine Geschwindigkeitstests ausgeführt; es gelten die Einstellungen unter „Mobilfunkqualität“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speed tests are skipped on cellular, and the Cellular Quality settings apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pruebas de velocidad no se hacen con datos móviles, y se aplica la configuración de Calidad con datos móviles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tests de vitesse ne sont pas effectués sur réseau mobile, et les paramètres Qualité sur réseau mobile s’appliquent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モバイルデータ通信では速度テストは行われず、モバイル通信の画質の設定が適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os testes de velocidade não são feitos em dados móveis, e as configurações de Qualidade em dados móveis se aplicam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用蜂窝网络时不进行测速，将应用蜂窝网络画质设置。"
          }
        }
      }
    },
    "settings.connection.skippedMetered" : {
      "comment" : "Footnote in Android and Android TV connection settings explaining speed tests are not run on metered networks (limited data plans). Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: replaces the connection speed on a metered network.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُجرى اختبارات السرعة على الشبكات محدودة البيانات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In getakteten Netzwerken werden keine Geschwindigkeitstests ausgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speed tests are skipped on metered networks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pruebas de velocidad no se hacen en redes de uso medido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tests de vitesse ne sont pas effectués sur les réseaux à données limitées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
