    "boxSets.unavailableMessage" : {
      "comment" : "Android TV: message on the box set page when the box set cannot be shown, giving possible reasons.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سلسلة الأفلام هذه غير متاحة. قد تكون سلاسل الأفلام معطّلة لهذه المكتبة، أو أن عدد أفلامها الموجودة هنا قليل جدًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази филмова поредица не е налична. Филмовите поредици може да са изключени за тази библиотека или тук има твърде малко от филмите в нея."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta saga no està disponible. Pot ser que les sagues estiguin desactivades per a aquesta biblioteca o que aquí hi hagi massa poques de les seves pel·lícules."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato filmová série není dostupná. V této knihovně mohou být filmové série vypnuté, nebo je zde příliš málo filmů z této série."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne filmserie er ikke tilgængelig. Filmserier kan være slået fra for dette bibliotek, eller der er for få af filmene her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Filmreihe ist nicht verfügbar. Filmreihen sind für diese Mediathek möglicherweise deaktiviert, oder zu wenige ihrer Filme sind vorhanden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η σειρά ταινιών δεν είναι διαθέσιμη. Οι σειρές ταινιών μπορεί να είναι απενεργοποιημένες για αυτή τη βιβλιοθήκη ή να υπάρχουν εδώ πολύ λίγες από τις ταινίες της σειράς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This box set isn't available. Box sets may be turned off for this library, or too few of its movies are here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta saga no está disponible. Puede que las sagas estén desactivadas en esta biblioteca o que haya muy pocas de sus películas aquí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See filmisari pole saadaval. Filmisarjad võivad selle meediakogu jaoks olla välja lülitatud või on siin liiga vähe sellesse kuuluvaid filme."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä elokuvasarja ei ole saatavilla. Elokuvasarjat voivat olla poissa käytöstä tässä kirjastossa, tai kirjastossa on liian vähän sarjan elokuvia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette saga n’est pas disponible. Les sagas sont peut-être désactivées pour cette bibliothèque, ou trop peu de ses films sont présents."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סדרת הסרטים הזו לא זמינה. ייתכן שסדרות הסרטים כבויות בספרייה הזו, או שמעט מדי מהסרטים בסדרה נמצאים בה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह फ़िल्म सीरीज़ उपलब्ध नहीं है। हो सकता है इस लाइब्रेरी के लिए फ़िल्म सीरीज़ बंद हों, या इसकी बहुत कम फ़िल्में यहाँ हों।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj filmski serijal nije dostupan. Filmski serijali možda su isključeni za ovu medijateku ili ovdje ima premalo filmova iz serijala."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a filmsorozat nem érhető el. Lehet, hogy a filmsorozatok ki vannak kapcsolva ebben a könyvtárban, vagy a filmjei közül túl kevés van meg itt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seri film ini tidak tersedia. Seri film mungkin dinonaktifkan untuk perpustakaan ini, atau film dari seri ini yang ada di sini terlalu sedikit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa saga non è disponibile. Le saghe potrebbero essere disattivate per questa libreria, oppure qui ci sono troppo pochi film della saga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このボックスセットは利用できません。このライブラリでボックスセットがオフになっているか、ボックスセットの映画がライブラリに十分にありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 박스 세트를 사용할 수 없어요. 이 라이브러리에서 박스 세트가 꺼져 있거나 라이브러리에 있는 영화가 너무 적을 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ši filmų serija nepasiekiama. Filmų serijos šioje bibliotekoje gali būti išjungtos arba čia yra per mažai šios serijos filmų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī filmu sērija nav pieejama. Iespējams, filmu sērijas šajā bibliotēkā ir izslēgtas vai arī šeit ir pārāk maz tās filmu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri filem ini tidak tersedia. Siri filem mungkin dimatikan untuk pustaka ini, atau terlalu sedikit filem dalam siri ini ada di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne filmserien er ikke tilgjengelig. Filmserier kan være slått av for dette biblioteket, eller så finnes for få av filmene her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze filmreeks is niet beschikbaar. Filmreeksen staan misschien uit voor deze bibliotheek, of er zijn te weinig films uit deze reeks aanwezig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta seria filmów jest niedostępna. Serie filmów mogą być wyłączone w tej bibliotece lub jest w niej za mało filmów z tej serii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta coletânea não está disponível. As coletâneas podem estar desativadas para esta biblioteca, ou há poucos filmes dela aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta saga não está disponível. As sagas podem estar desativadas para esta biblioteca ou não há filmes suficientes da saga aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această serie de filme nu este disponibilă. Este posibil ca seriile de filme să fie dezactivate pentru această bibliotecă sau ca prea puține dintre filmele seriei să se afle aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта серия фильмов недоступна. Возможно, серии фильмов выключены для этой медиатеки или в ней слишком мало фильмов из этой серии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto filmová séria nie je dostupná. Filmové série môžu byť pre túto knižnicu vypnuté alebo je tu príliš málo filmov z tejto série."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta filmska serija ni na voljo. Filmske serije so morda izklopljene za to knjižnico ali pa je tukaj premalo njenih filmov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här filmserien är inte tillgänglig. Filmserier kan vara avstängda för det här biblioteket, eller så finns för få av filmerna här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชุดภาพยนตร์นี้ไม่พร้อมใช้งาน ชุดภาพยนตร์อาจปิดอยู่สำหรับคลังนี้ หรือมีภาพยนตร์ของชุดนี้อยู่ที่นี่น้อยเกินไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu film serisi kullanılamıyor. Film serileri bu kitaplık için kapatılmış olabilir ya da serinin bu kitaplıkta çok az filmi var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця франшиза недоступна. Можливо, франшизи вимкнено для цієї бібліотеки або тут замало її фільмів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loạt phim này không khả dụng. Có thể loạt phim đã được tắt cho thư viện này, hoặc thư viện có quá ít phim thuộc loạt này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此系列电影不可用。此媒体库可能已关闭系列电影，或其中的电影数量太少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法顯示此系列電影。此媒體庫可能已關閉系列電影，或其中的電影數量太少。"
          }
        }
      }
    },
    "boxSets.watchedFact" : {
