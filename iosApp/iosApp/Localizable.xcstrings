    "signIn.network.connectIdentityRequired" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV) Settings › Sign-in: error when connecting a network sign-in provider (such as Tailscale) while the app reaches the server at another address. {provider}: the provider's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح هذا الخادم على عنوان %1$@ الخاص به لربطه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отворете този сървър на адреса му в %1$@, за да свържете доставчика."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per connectar-lo, obre aquest servidor amb l’adreça que proporciona %1$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li připojit poskytovatele %1$@, otevřete tento server na adrese, kterou mu poskytovatel přidělil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn denne server på dens %1$@-adresse for at forbinde den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne diesen Server über seine %1$@-Adresse, um ihn zu verbinden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε αυτόν τον διακομιστή μέσω της διεύθυνσής του στον πάροχο %1$@ για να τον συνδέσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open this server at its %1$@ address to connect it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre este servidor en su dirección de %1$@ para conectarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidumiseks avage see server teenuse %1$@ aadressil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistä avaamalla tämä palvelin palvelun %1$@ osoitteesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez ce serveur à son adresse %1$@ pour le relier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לחבר את השרת הזה, יש לפתוח אותו בכתובת שלו ב-%1$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे कनेक्ट करने के लिए यह सर्वर उसके %1$@ पते पर खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite ovaj poslužitelj na njegovoj adresi za %1$@ da biste ga povezali."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A csatlakoztatáshoz nyissa meg ezt a szervert a(z) %1$@ szolgáltatóhoz tartozó címén."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka server ini melalui alamat %1$@ untuk menghubungkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri questo server al suo indirizzo %1$@ per collegarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続するには、このサーバーを%1$@のアドレスで開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결하려면 %1$@ 주소로 이 서버를 여세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atidarykite šį serverį jo „%1$@“ adresu, kad jį susietumėte."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lai savienotu, atveriet šo serveri, izmantojot tā %1$@ adresi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka pelayan ini melalui alamat %1$@ untuk menyambungkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne denne serveren på %1$@-adressen for å koble den til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open deze server via het %1$@-adres om hem te koppelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby połączyć usługę %1$@, otwórz ten serwer pod jego adresem %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
