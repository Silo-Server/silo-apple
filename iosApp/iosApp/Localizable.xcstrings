          "stringUnit" : {
            "state" : "translated",
            "value" : "Færdig. Din enhed logger ind."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertig. Dein Gerät wird angemeldet."
          }
        },
