        }
      }
    },
    "settings.interface.loopThemeMusicSubtitle" : {
      "comment" : "Apple Settings > Interface > Theme Music and Apple TV Settings > General > Theme Music: description of the Loop Theme Music switch (VoiceOver hint on iPhone, iPad and Apple TV; shown under the switch on Mac).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كرّر الموسيقى الرئيسية ما دامت الصفحة مفتوحة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повтаря темата, докато страницата е отворена."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeteix la sintonia mentre la pàgina continua oberta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opakovat melodii, dokud je stránka otevřená."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentag temaet, så længe siden er åben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederholt die Titelmusik, solange die Seite geöffnet bleibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επανάληψη του θέματος όσο η σελίδα παραμένει ανοιχτή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat the theme while the page stays open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite el tema mientras la página siga abierta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kordab tunnuslugu, kuni leht on avatud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistaa tunnusmusiikkia uudelleen niin kauan kuin sivu on auki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répète le thème tant que la page reste ouverte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חזרה על שיר הנושא כל עוד הדף פתוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेज खुला रहने तक थीम दोहराएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponavlja temu dok je stranica otvorena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A főcímzene ismétlése, amíg az oldal nyitva van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulangi lagu tema selama halaman tetap terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripeti la sigla finché la pagina resta aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページを開いている間、テーマ曲を繰り返し再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
