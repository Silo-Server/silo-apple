          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallback language Silo prefers for titles, descriptions, and artwork."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idioma alternativo que Silo prefiere para títulos, descripciones e imágenes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varakieli, jota Silo suosii nimissä, kuvauksissa ja kuvituksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langue de repli que Silo privilégie pour les titres, les descriptions et les visuels."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamjenski jezik koji Silo preferira za naslove, opise i slike."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingua di riserva che Silo preferisce per titoli, descrizioni e immagini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloがタイトル、説明、アートワークに優先して使う代替の言語です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
