        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解除連結"
          }
        }
      }
    },
    "settings.signIn.disconnectConfirm.title" : {
      "comment" : "Title of the confirmation before unlinking a sign-in provider on Settings → Sign-in, on Android phone and Apple (iPhone, iPad, Mac). {provider}: the sign-in provider's name, such as Google or Tailscale; on Android also the words of settings.signIn.thisSignIn.",
