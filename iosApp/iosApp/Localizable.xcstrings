          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaktualizuj aplikację Silo, aby dalej korzystać z tego serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize o Silo para continuar usando este servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
