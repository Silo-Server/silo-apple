          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many attempts. Wait a moment, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados intentos. Espera un momento y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de tentatives. Patientez un instant, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試行回数が多すぎます。しばらく待ってから、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitas tentativas. Aguarde um momento e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尝试次数过多。请稍等片刻，然后重试。"
          }
        }
      }
    },
    "tvSignIn.error.serverChanged" : {
      "comment" : "Apple TV sign-in screen: status when the active server changed while a sign-in code was being fetched or approved.",
      "extractionState" : "manual",
