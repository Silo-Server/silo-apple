    "personal.favorites.emptyTapHint" : {
      "comment" : "Supporting line on the empty Favorites list, telling the user how to add favorites (Android phone, Apple iOS and tvOS).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على أيقونة القلب في أي عنصر لإضافته إلى المفضلة"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докоснете иконата със сърце на който и да е елемент, за да го добавите тук"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la icona del cor de qualsevol element per afegir-lo aquí"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na ikonu srdce u libovolné položky ji přidáte sem"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på hjerteikonet på et element for at tilføje det her"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe bei einem beliebigen Eintrag auf das Herzsymbol, um ihn hier hinzuzufügen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε το εικονίδιο της καρδιάς σε οποιοδήποτε στοιχείο για να το προσθέσετε εδώ"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the heart icon on any item to add it here"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el icono de corazón en cualquier elemento para añadirlo aquí"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puudutage mis tahes üksuse südameikooni, et see siia lisada"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kohde tänne napauttamalla sen sydänkuvaketta"
