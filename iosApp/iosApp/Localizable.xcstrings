    "settingsManifest.player.audio_sync_ms.description" : {
      "comment" : "Help text under the player.audio_sync_ms setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقديم الصوت أو تأخيره لتصحيح تزامن الشفاه على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt den Ton nach vorn oder hinten, um die Lippensynchronität auf diesem Gerät zu korrigieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shift audio earlier or later to correct lip sync on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adelanta o retrasa el audio para corregir la sincronización labial en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avance ou retarde le son pour corriger la synchronisation labiale sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスで音声を早めたり遅らせたりして、口の動きとのずれを補正します。"
