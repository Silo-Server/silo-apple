            "state" : "translated",
            "value" : "レポートを保持しました。Siloが再試行します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatório mantido; o Silo tentará novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报告已保留，Silo将重试。"
          }
        }
      }
    },
    "diagnostics.notice.keptServerRejected" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: the user's Silo server refused the report; it stays on the device.",
