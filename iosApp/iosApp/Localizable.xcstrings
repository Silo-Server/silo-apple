            "state" : "translated",
            "value" : "Uuden profiilin luomiseen tarvittavaa ensisijaista profiilia ei löytynyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de trouver le profil principal nécessaire pour créer un autre profil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
