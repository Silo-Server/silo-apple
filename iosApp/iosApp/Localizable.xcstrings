            "state" : "translated",
            "value" : "Zhlédněte nebo ohodnoťte několik titulů a vytvoříme vám osobní doporučení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eller bedøm nogle få titler for at opbygge dine personlige anbefalinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir ein paar Titel an oder bewerte sie, damit persönliche Empfehlungen entstehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρακολουθήστε ή βαθμολογήστε μερικούς τίτλους για να δημιουργηθούν οι εξατομικευμένες προτάσεις σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch or rate a few titles to build your personalised recommendations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira o califica algunos títulos para crear tus recomendaciones personalizadas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isikupärastatud soovituste saamiseks vaadake või hinnake mõnda pealkirja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katso tai arvioi muutama nimike, niin saat henkilökohtaisia suosituksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez ou notez quelques titres pour créer vos recommandations personnalisées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לצפות בכמה פריטים או לדרג אותם כדי לקבל המלצות מותאמות אישית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी पर्सनलाइज़्ड सिफ़ारिशें बनाने के लिए कुछ टाइटल देखें या उन्हें रेटिंग दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogledajte ili ocijenite nekoliko naslova kako biste dobili osobne preporuke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
