      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا شُغّل الصوت المحيطي كصوت ستيريو، فعطّل «صوت متعدد القنوات بلا فقدان»."
          }
        },
        "de" : {
