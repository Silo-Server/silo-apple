    "settings.interface.titleArtAllOff" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac) > Title Pages: note while Apply to All Devices is on and Show Title Art is off. Title art is logo artwork used as a title's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شعار العنوان معطّل على كل جهاز مسجّل الدخول إلى هذا الملف الشخصي. تغييره هنا يغيّره في كل مكان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Titelgrafik ist auf allen Geräten aus, die mit diesem Profil angemeldet sind. Eine Änderung hier gilt überall."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Title art is off on every device signed into this profile. Changing it here changes it everywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El arte del título está desactivado en todos los dispositivos con sesión iniciada en este perfil. Si lo cambias aquí, cambia en todas partes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les logos de titre sont désactivés sur tous les appareils connectés à ce profil. Les modifier ici les modifie partout."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールでサインインしているすべてのデバイスで、タイトルロゴはオフです。ここで変更すると、すべてのデバイスで変更されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A arte do título está desativada em todos os dispositivos conectados a este perfil. Alterar aqui altera em todos eles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录此个人资料的所有设备都已关闭标题图。在此更改会同步到所有设备。"
          }
        }
      }
    },
    "settings.interface.titleArtAllOn" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac) > Title Pages: note while Apply to All Devices and Show Title Art are both on. Title art is logo artwork used as a title's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
