    "downloads.seriesSheet.oneTimeHint" : {
      "comment" : "Apple iOS/macOS: series Download sheet, opened from a series page; note under the segments when One Time is chosen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التنزيل الآن. لن يُنزَّل أي شيء آخر لاحقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stáhnout nyní. Později se už nic dalšího stahovat nebude."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download nu. Intet andet downloades senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt herunterladen. Später wird nichts weiter heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download now. Nothing else downloads later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga ahora. No se descargará nada más después."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataa nyt. Myöhemmin ei ladata mitään muuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargement immédiat. Rien d’autre n’est téléchargé ensuite."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzmite sada. Kasnije se ništa drugo ne preuzima."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica ora. In seguito non verrà scaricato altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐダウンロードします。後から追加でダウンロードされることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 다운로드해요. 이후에는 아무것도 다운로드하지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last ned nå. Ingenting mer lastes ned senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu downloaden. Later wordt er niets meer gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobierz teraz. Później nic więcej nie zostanie pobrane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe agora. Nada mais será baixado depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачать сейчас. Позже ничего не будет скачиваться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladda ned nu. Inget mer laddas ned senare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi indirin. Daha sonra başka bir şey indirilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантаження зараз. Згодом нічого не завантажуватиметься."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即下载，之后不会自动下载其他内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即下載，之後不會再自動下載。"
          }
        }
      }
    },
    "downloads.seriesSheet.ruleAll" : {
      "comment" : "Apple iOS/macOS: series Download sheet, opened from a series page; detail of the Monitor option that downloads all episodes.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنزيل كل الحلقات الآن، ثم الجديدة فور عرضها"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stáhnout všechny díly nyní a pak nové po odvysílání"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download alle afsnit nu og derefter nye, efterhånden som de sendes"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt alle Folgen herunterladen, danach neue nach Ausstrahlung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download every episode now, then new ones as they air"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargar todos los episodios ahora y los nuevos a medida que se estrenen"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataa kaikki jaksot nyt ja uudet sitä mukaa kuin ne julkaistaan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharger tous les épisodes maintenant, puis les nouveaux dès leur diffusion"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzmi sve epizode sada, a zatim nove čim se emitiraju"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica ora tutti gli episodi, poi i nuovi appena vanno in onda"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのエピソードを今すぐダウンロードし、新しいエピソードも配信時にダウンロード"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 모든 에피소드를 다운로드하고, 이후 새 에피소드도 방영되면 다운로드"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last ned alle episoder nå, og nye etter hvert som de sendes"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu alle afleveringen downloaden, daarna nieuwe zodra ze verschijnen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobierz teraz wszystkie odcinki, a potem nowe w miarę emisji"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixar todos os episódios agora e os novos conforme forem ao ar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачать все серии сейчас, а затем новые по мере выхода"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladda ned alla avsnitt nu och sedan nya när de sänds"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm bölümleri şimdi, yenilerini yayınlandıkça indir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажити всі епізоди зараз, а потім нові в міру виходу"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即下载所有集，之后新集播出时自动下载"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即下載所有集數，之後播出的新集數也會下載"
          }
        }
      }
    },
