    "tvPair.approval.unconfirmedDetail" : {
      "comment" : "Apple (iPhone, iPad) Sign in a TV approval card: detail under \"Couldn't confirm the approval yet.\"; the card keeps checking. {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من التلفزيون. سيتم التحديث عندما يؤكد %1$@ ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte televizi. Stav se aktualizuje, až to server %1$@ potvrdí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek tv’et. Dette opdateres, når %1$@ bekræfter det."
