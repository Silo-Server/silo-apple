    "settingsManifest.catalog.hide_unwatched_episode_images.description" : {
      "comment" : "Help text under the catalog.hide_unwatched_episode_images setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمويه الصورة المصغّرة للحلقة حتى تبدأ مشاهدتها، كي لا تكشف الصورة أحداث القصة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Миниатюрата на епизода се размазва, докато не започнете да го гледате, за да не издава изображението сюжета."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difumina la miniatura d’un episodi fins que el comencis a veure, perquè la imatge no reveli la història."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmaže náhled dílu, dokud ho nezačnete sledovat, aby obrázek neprozradil děj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slør et afsnits miniature, indtil du begynder at se det, så billedet ikke afslører handlingen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet das Vorschaubild einer Folge weich, bis du sie zu schauen beginnst, damit das Bild nichts von der Handlung verrät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θόλωση της μικρογραφίας ενός επεισοδίου μέχρι να αρχίσετε να το παρακολουθείτε, ώστε η εικόνα να μην αποκαλύπτει την πλοκή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blur an episode's thumbnail until you start watching it, so the image does not give away the story."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difumina la miniatura de un episodio hasta que empieces a verlo, para que la imagen no revele la historia."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hägustab osa pisipildi, kuni hakkate seda vaatama, et pilt sisu ette ära ei reedaks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumenna jakson pikkukuva, kunnes aloitat sen katselun, jotta kuva ei paljasta juonta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floute la miniature d’un épisode jusqu’à ce que vous commenciez à le regarder, pour que l’image ne dévoile pas l’intrigue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טשטוש התמונה הממוזערת של פרק עד שמתחילים לצפות בו, כדי שהתמונה לא תחשוף את העלילה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एपिसोड देखना शुरू करने तक उसका थंबनेल धुंधला रखें, ताकि तस्वीर से कहानी का पता न चले।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamućuje sličicu epizode dok je ne počnete gledati kako slika ne bi otkrila radnju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az epizód bélyegképe elhomályosítva jelenik meg, amíg el nem kezdi nézni, így a kép nem árulja el a történetet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buramkan thumbnail episode hingga Anda mulai menontonnya, agar gambarnya tidak membocorkan cerita."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfoca la miniatura di un episodio finché non inizi a guardarlo, così l’immagine non rivela la trama."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エピソードのサムネイルを視聴を始めるまでぼかし、画像からストーリーがわからないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에피소드를 보기 시작할 때까지 썸네일을 흐리게 표시해 이미지로 줄거리가 드러나지 않게 해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulieti epizodo miniatiūrą, kol pradėsite jį žiūrėti, kad vaizdas neatskleistų siužeto."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izpludina epizodes sīktēlu, līdz sākat to skatīties, lai attēls neatklātu sižetu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaburkan imej kecil episod sehingga anda mula menontonnya, supaya imej itu tidak mendedahkan jalan cerita."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør miniatyrbildet av en episode uskarpt til du begynner å se den, så bildet ikke røper handlingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervaag de miniatuur van een aflevering tot je begint met kijken, zodat de afbeelding het verhaal niet verklapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmywaj miniaturę odcinka, dopóki nie zaczniesz go oglądać, aby obraz nie zdradzał fabuły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfoca a miniatura de um episódio até você começar a assistir, para que a imagem não revele a história."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfocar a miniatura de um episódio até começar a vê-lo, para que a imagem não revele a história."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miniatura unui episod este estompată până când începeți să-l vizionați, ca imaginea să nu dezvăluie povestea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размывать миниатюру серии, пока вы не начнёте её смотреть, чтобы изображение не раскрывало сюжет."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmaže miniatúru epizódy, kým ju nezačnete pozerať, aby obrázok neprezradil dej."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamegli sličico epizode, dokler je ne začnete gledati, da slika ne izda zgodbe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör ett avsnitts miniatyrbild suddig tills du börjar titta på det, så att bilden inte avslöjar handlingen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เบลอภาพขนาดย่อของตอนจนกว่าคุณจะเริ่มดู เพื่อไม่ให้ภาพเปิดเผยเนื้อเรื่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlemeye başlayana kadar bölümün küçük resmini bulanıklaştırır; böylece görsel hikâyeyi ele vermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розмивати мініатюру епізоду, доки ви не почнете його дивитися, щоб зображення не розкривало сюжет."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm mờ hình thu nhỏ của tập cho đến khi bạn bắt đầu xem, để hình ảnh không tiết lộ nội dung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你开始观看前模糊显示该集的缩略图，以免图片剧透。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你開始觀看前模糊處理該集的縮圖，以免畫面洩漏劇情。"
          }
        }
      }
    },
    "settingsManifest.catalog.hide_unwatched_episode_images.label" : {
      "comment" : "Label of the catalog.hide_unwatched_episode_images setting in settings screens. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمويه صور الحلقات غير المشاهَدة"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размазване на изображенията на негледани епизоди"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difumina les imatges dels episodis no vistos"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmazat obrázky nezhlédnutých dílů"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slør billeder af usete afsnit"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder ungesehener Folgen weichzeichnen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
