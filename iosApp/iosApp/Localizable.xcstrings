    "newProfile.pinHint" : {
      "comment" : "Helper line under the PIN field on the Roku new-profile screen explaining that a PIN must be four digits or left empty. Apple (iPhone, iPad, Mac, Apple TV): same helper line under the PIN field of the New Profile form.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل الأرقام الأربعة كلها، أو امسح الحقل لعدم استخدام PIN."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Въведете и 4-те цифри или изчистете полето, ако не искате PIN."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdueix els 4 dígits o esborra el camp per no tenir PIN."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte všechny 4 číslice, nebo pole vymažte, pokud PIN nechcete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast alle 4 cifre, eller ryd feltet, hvis du ikke vil bruge en PIN-kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib alle 4 Ziffern ein oder leere das Feld, um keine PIN zu verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε και τα 4 ψηφία ή αδειάστε το πεδίο για να μην υπάρχει PIN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter all 4 digits, or clear the field for no PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe los 4 dígitos o vacía el campo para no usar PIN."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisestage kõik 4 numbrit või tühjendage väli, kui te PIN-i ei soovi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna kaikki 4 numeroa tai tyhjennä kenttä, jos et halua PIN-koodia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez les 4 chiffres, ou videz le champ pour ne pas utiliser de PIN."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להזין את כל 4 הספרות, או לנקות את השדה כדי לא להגדיר PIN."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी 4 अंक डालें, या PIN न रखने के लिए फ़ील्ड खाली करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unesite sve 4 znamenke ili ispraznite polje ako ne želite PIN."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adja meg mind a 4 számjegyet, vagy törölje a mező tartalmát, ha nem kér PIN-kódot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan keempat digit, atau kosongkan kolom ini jika tanpa PIN."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci tutte e 4 le cifre o svuota il campo per non usare un PIN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4桁すべてを入力するか、PINを設定しない場合は欄をクリアしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4자리를 모두 입력하거나, PIN을 사용하지 않으려면 입력란을 비우세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įveskite visus 4 skaitmenis arba išvalykite lauką, jei PIN nereikia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ievadiet visus 4 ciparus vai notīriet lauku, ja PIN nav vajadzīgs."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan kesemua 4 digit, atau kosongkan medan untuk tanpa PIN."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn alle 4 sifrene, eller tøm feltet for ingen PIN."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer alle 4 cijfers in, of maak het veld leeg als je geen PIN wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz wszystkie 4 cyfry lub wyczyść pole, aby nie ustawiać kodu PIN."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite os 4 dígitos ou limpe o campo para não usar PIN."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduza os 4 dígitos ou limpe o campo para não ter PIN."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduceți toate cele 4 cifre sau goliți câmpul pentru a nu folosi un cod PIN."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите все 4 цифры или очистите поле, чтобы не задавать PIN."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadajte všetky 4 číslice alebo pole vymažte, ak PIN nechcete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vnesite vse 4 števke ali počistite polje, če PIN-a ne želite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange alla 4 siffror, eller töm fältet om du inte vill ha någon PIN-kod."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป้อน PIN ให้ครบ 4 หลัก หรือล้างช่องนี้หากไม่ต้องการใช้ PIN"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 hanenin tamamını girin ya da PIN istemiyorsanız alanı temizleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть усі 4 цифри або очистьте поле, щоб не використовувати PIN."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập đủ 4 chữ số, hoặc xóa trống ô này nếu không dùng PIN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入完整的4位数字，或清空此栏以不设PIN。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入完整的 4 位數，或清除欄位以不設定 PIN。"
          }
        }
      }
    },
