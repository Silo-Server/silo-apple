    "newProfile.unconfirmed.body" : {
      "comment" : "Body of the Roku dialog shown when the create-profile request got no server reply; advises checking the profile list before retrying. Apple (iPhone, iPad, Mac, Apple TV): same alert body on the New Profile form.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتلقَّ Silo ردًا من الخادم. تحقق من قائمة الملفات الشخصية قبل المحاولة مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не получи отговор от сървъра. Проверете списъка с профили, преди да опитате отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no ha rebut resposta del servidor. Comprova la llista de perfils abans de tornar-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Silo nedostala odpověď ze serveru. Než to zkusíte znovu, zkontrolujte seznam profilů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo fik ikke svar fra serveren. Tjek profillisten, før du prøver igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo hat keine Antwort vom Server erhalten. Prüfe die Profilliste, bevor du es erneut versuchst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Silo δεν έλαβε απάντηση από τον διακομιστή. Ελέγξτε τη λίστα προφίλ πριν δοκιμάσετε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo didn't get an answer from the server. Check the profile list before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no recibió respuesta del servidor. Revisa la lista de perfiles antes de volver a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei saanud serverilt vastust. Enne uuesti proovimist kontrollige profiilide loendit."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei saanut vastausta palvelimelta. Tarkista profiililuettelo ennen kuin yrität uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a reçu aucune réponse du serveur. Vérifiez la liste des profils avant de réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה Silo לא קיבלה תשובה מהשרת. יש לבדוק את רשימת הפרופילים לפני ניסיון נוסף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo को सर्वर से कोई जवाब नहीं मिला। फिर से कोशिश करने से पहले प्रोफ़ाइल की सूची देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nije dobio odgovor od poslužitelja. Provjerite popis profila prije ponovnog pokušaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo nem kapott választ a szervertől. Mielőtt újra próbálkozna, ellenőrizze a profillistát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo tidak mendapat jawaban dari server. Periksa daftar profil sebelum mencoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo non ha ricevuto risposta dal server. Controlla l’elenco dei profili prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloはサーバーから応答を受け取れませんでした。もう一度お試しになる前に、プロフィールの一覧を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
