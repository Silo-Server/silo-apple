    "signIn.phoneHintSso" : {
      "comment" : "Hint on the Roku password sign-in screen for accounts that use single sign-on, when no provider name is known. Apple TV: same hint under the password form when the server lists several sign-in providers.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كنت تسجل الدخول عبر الدخول الموحد، فاستخدم هاتفك بدلًا من ذلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако влизате с единен вход (SSO), използвайте телефона си вместо това."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si utilitzes l’inici de sessió únic, inicia la sessió des del telèfon."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud se přihlašujete pomocí jednotného přihlášení, použijte místo toho telefon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du logger ind med single sign-on, skal du bruge din telefon i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dich per Single Sign-On anmeldest, verwende stattdessen dein Smartphone."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν συνδέεστε με ενιαία σύνδεση (SSO), χρησιμοποιήστε καλύτερα το τηλέφωνό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you sign in with single sign-on, use your phone instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si inicias sesión con inicio de sesión único, usa tu teléfono."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui logite sisse ühekordse sisselogimisega, kasutage selle asemel oma telefoni."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos kirjaudut sisään kertakirjautumisella, käytä sen sijaan puhelintasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous vous connectez avec l’authentification unique, utilisez plutôt votre téléphone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בהתחברות דרך כניסה יחידה (SSO), יש להשתמש בטלפון במקום זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंगल साइन-ऑन से साइन इन करने के लिए इसके बजाय अपना फ़ोन इस्तेमाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako se prijavljujete jedinstvenom prijavom (SSO), upotrijebite telefon."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha egyszeri bejelentkezéssel lép be, inkább a telefonját használja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda masuk dengan single sign-on, gunakan ponsel Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se accedi con il single sign-on, usa il telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シングルサインオンでサインインする場合は、代わりにスマートフォンを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통합 로그인(SSO)으로 로그인한다면 휴대폰을 사용하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jei naudojate vieningąjį prisijungimą (SSO), verčiau naudokite telefoną."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja pierakstāties ar vienoto pierakstīšanos, tā vietā izmantojiet tālruni."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika anda log masuk dengan log masuk tunggal, gunakan telefon anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du logger på med enkel pålogging (SSO), bruk telefonen i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je inlogt met single sign-on, gebruik dan je telefoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli używasz logowania jednokrotnego (SSO), użyj zamiast tego telefonu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você usa login único (SSO) para entrar, use o celular."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se iniciar sessão com início de sessão único, use antes o seu telemóvel."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă vă conectați prin autentificare unică (SSO), folosiți în schimb telefonul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы используете единый вход (SSO), войдите с телефона."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak sa prihlásite pomocou jednotného prihlásenia, použite radšej telefón."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če se prijavljate z enotno prijavo, raje uporabite telefon."
          }
        },
        "sv" : {
