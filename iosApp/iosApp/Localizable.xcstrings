          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui soovite valida ainult selle iPadi jaoks, lülitage välja „Rakenda kõigile seadmetele“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista ”Kaikille laitteille” käytöstä, jos haluat valita vain tälle iPadille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez Appliquer à tous les appareils pour choisir uniquement pour cet iPad."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לבחור רק עבור ה-iPad הזה, יש לכבות את ”החלה על כל המכשירים”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ इस iPad के लिए चुनने के लिए “सभी डिवाइसों पर लागू करें” बंद करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isključite Primijeni na sve uređaje da biste odabrali samo za ovaj iPad."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha csak erre az iPadre szeretné beállítani, kapcsolja ki az Alkalmazás minden eszközre lehetőséget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonaktifkan Terapkan ke semua perangkat untuk memilih hanya untuk iPad ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva “Applica a tutti i dispositivi” per scegliere solo per questo iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPadだけで選ぶには、「すべてのデバイスに適用」をオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPad에만 적용하려면 모든 기기에 적용을 끄세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išjunkite „Taikyti visiems įrenginiams“, kad galėtumėte pasirinkti tik šiam „iPad“ įrenginiui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izslēdziet opciju „Lietot visās ierīcēs”, lai izvēlētos tikai šai iPad ierīcei."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matikan “Guna pada semua peranti” untuk memilih bagi iPad ini sahaja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå av Bruk på alle enheter for å velge bare for denne iPaden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet “Op alle apparaten toepassen” uit om alleen voor deze iPad te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz opcję „Zastosuj na wszystkich urządzeniach”, aby wybrać tylko dla tego tabletu iPad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative “Aplicar a todos os dispositivos” para escolher só para este iPad."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative Aplicar a todos os dispositivos para escolher só para este iPad."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivați Aplicare pe toate dispozitivele pentru a alege doar pentru acest iPad."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы выбрать только для этого iPad, выключите «Применить ко всем устройствам»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete vybrať len pre tento iPad, vypnite možnosť Použiť na všetky zariadenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izklopite „Uporabi za vse naprave“, da izberete samo za ta iPad."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng av Tillämpa på alla enheter om du vill välja bara för denna iPad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิด “ใช้กับอุปกรณ์ทั้งหมด” เพื่อเลือกสำหรับ iPad เครื่องนี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu iPad için seçmek üzere “Tüm cihazlara uygula” seçeneğini kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкніть «Застосувати до всіх пристроїв», щоб вибрати лише для цього iPad."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt Áp dụng cho mọi thiết bị để chọn riêng cho iPad này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭“应用到所有设备”即可仅为这台iPad单独选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉「套用至所有裝置」即可只為這台 iPad 設定。"
          }
        }
      }
    },
