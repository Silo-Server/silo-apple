    "settingsManifest.playback.auto_skip_intro.description" : {
      "comment" : "Help text under the playback.auto_skip_intro setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجاوز المقدمات تلقائيًا عندما يتمكن Silo من اكتشافها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично прескачане на въведенията, когато Silo може да ги открие."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta automàticament les introduccions quan Silo les pot detectar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky přeskočit úvody, pokud je Silo dokáže rozpoznat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring automatisk over introer, når Silo kan genkende dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt Intros automatisch, wenn Silo sie erkennen kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτόματη παράλειψη των εισαγωγών όταν το Silo μπορεί να τις εντοπίσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jump past intros automatically when Silo can detect them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta las introducciones automáticamente cuando Silo pueda detectarlas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hüppab introdest automaatselt üle, kui Silo suudab need tuvastada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohita alkutunnukset automaattisesti, kun Silo tunnistaa ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe automatiquement les intros quand Silo peut les détecter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דילוג אוטומטי על פתיחים כש-Silo מזהה אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब Silo इंट्रो पहचान सके, तब उन्हें अपने-आप छोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatski preskače uvode kada ih Silo može prepoznati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
