          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกรหัสผ่านใหม่แล้ว แต่การลงชื่อเข้าใช้ยังไม่เสร็จสมบูรณ์"
