          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinding met %1$@ verbroken. Open Silo op je Roku."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utracono połączenie z urządzeniem %1$@. Otwórz Silo na urządzeniu Roku."
