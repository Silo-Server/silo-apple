    "collections.noneBody" : {
      "comment" : "Apple iOS and tvOS: supporting line under the empty-state heading on the Collections screen when you have no collections.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ مجموعة لتنظيم الوسائط"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създайте колекция, за да организирате медиите си"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una col·lecció per organitzar el teu contingut multimèdia"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte kolekci a uspořádejte svá média"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en samling for at organisere dine medier"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle eine Sammlung, um deine Medien zu organisieren"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε μια συλλογή για να οργανώσετε τα πολυμέσα σας"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a collection to organize your media"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una colección para organizar tu contenido"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looge kollektsioon, et oma meediat korraldada"
          }
