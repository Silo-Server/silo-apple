    "tvPairing.card.noAnswerNoteAppleTv" : {
      "comment" : "Apple TV pairing screen (shown while a nearby phone sets up or signs in this Apple TV): side card note when the address the phone sent didn't answer.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على جهاز Apple TV هذا الوصول إلى العنوان الذي أرسله هاتفك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това Apple TV не можа да се свърже с адреса, изпратен от телефона ви."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest Apple TV no ha pogut accedir a l’adreça que ha enviat el telèfon."
