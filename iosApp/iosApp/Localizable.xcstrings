    "watchParty.page.body" : {
      "comment" : "Roku, Android phone and TV: short intro paragraph on the Watch Party start page explaining that playback stays in sync for everyone. Apple (iPhone, iPad, Apple TV): same line on the Watch Party hub.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر عنوانًا، وشارك الرمز، ويبقى التشغيل متزامنًا لدى الجميع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете заглавие, споделете кода и възпроизвеждането остава синхронизирано за всички."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria un títol, comparteix el codi i la reproducció de tothom anirà sincronitzada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte titul, sdílejte kód a přehrávání zůstane u všech synchronizované."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en titel, del koden, og alles afspilning holdes i takt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Titel, teile den Code, und die Wiedergabe bleibt bei allen synchron."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε έναν τίτλο, μοιραστείτε τον κωδικό και η αναπαραγωγή όλων μένει συγχρονισμένη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a title, share the code, and everyone's playback stays in step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un título, comparte el código y la reproducción de todos se mantiene sincronizada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valige pealkiri, jagage koodi ja kõigi esitus püsib sünkroonis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse kohde ja jaa koodi, niin kaikkien toisto pysyy tahdissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un titre, partagez le code, et la lecture reste synchronisée pour tout le monde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בוחרים פריט, משתפים את הקוד, וההפעלה של כולם נשארת מסונכרנת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई टाइटल चुनें, कोड शेयर करें, और सभी का प्लेबैक साथ-साथ चलता रहेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite naslov, podijelite kod i reprodukcija ostaje usklađena za sve."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válasszon egy címet, ossza meg a kódot, és mindenki lejátszása szinkronban marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih judul, bagikan kode, dan pemutaran semua orang tetap selaras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un titolo, condividi il codice e la riproduzione resta sincronizzata per tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作品を選んでコードを共有すると、全員の再生が同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작품을 고르고 코드를 공유하면 모두의 재생이 맞춰져요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkite, ką žiūrėti, pasidalykite kodu, ir visų atkūrimas vyks sinchroniškai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvēlieties nosaukumu, kopīgojiet kodu, un visu atskaņošana notiks sinhroni."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tajuk, kongsi kod dan main balik semua orang kekal seiring."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en tittel, del koden, så holdes avspillingen i takt for alle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een titel, deel de code en iedereen kijkt precies gelijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz tytuł, udostępnij kod, a odtwarzanie u wszystkich pozostanie zsynchronizowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um título, compartilhe o código e a reprodução fica sincronizada para todos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um título, partilhe o código e a reprodução fica sincronizada para todos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți un titlu, distribuiți codul și redarea rămâne sincronizată pentru toți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, что посмотреть, поделитесь кодом — и воспроизведение у всех будет синхронным."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte titul, zdieľajte kód a prehrávanie zostane u všetkých zosynchronizované."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izberite naslov, delite kodo in predvajanje bo pri vseh usklajeno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en titel och dela koden, så hålls uppspelningen i takt för alla."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกเรื่อง แชร์รหัส แล้วการเล่นของทุกคนจะตรงกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir içerik seçin, kodu paylaşın; herkesin oynatması eş zamanlı ilerler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть назву, поділіться кодом – і відтворення буде синхронним у всіх."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn một nội dung, chia sẻ mã và mọi người sẽ xem đồng bộ với nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一部作品，分享代码，所有人的播放都会保持同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選一部作品、分享代碼，所有人的播放進度都會保持同步。"
          }
        }
      }
    },
