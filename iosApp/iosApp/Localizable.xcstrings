    "player.notice.downloadEndsEarly" : {
      "comment" : "Apple iOS/tvOS/macOS: video player notice text under Download incomplete, shown with the Up Next panel.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينتهي ملف الفيديو الذي تم تنزيله قبل أوانه. احذفه وأعد تنزيله."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изтегленият видеофайл свършва преждевременно. Изтрийте го и го изтеглете отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fitxer de vídeo baixat s’acaba abans d’hora. Elimina’l i torna’l a baixar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stažený videosoubor končí předčasně. Smažte ho a stáhněte znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den downloadede videofil slutter for tidligt. Slet den, og download den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heruntergeladene Videodatei endet zu früh. Lösche sie und lade sie erneut herunter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αρχείο βίντεο της λήψης τελειώνει πρόωρα. Διαγράψτε το και πραγματοποιήστε ξανά λήψη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The downloaded video file ends early. Delete and re-download it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de video descargado termina antes de tiempo. Elimínalo y vuelve a descargarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allalaaditud videofail lõpeb enneaegselt. Kustutage see ja laadige uuesti alla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladattu videotiedosto päättyy kesken. Poista se ja lataa uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier vidéo téléchargé se termine prématurément. Supprimez-le et téléchargez-le à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קובץ הווידאו שהורד מסתיים מוקדם מדי. יש למחוק אותו ולהוריד אותו מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड की गई वीडियो फ़ाइल बीच में ही खत्म हो जाती है। इसे मिटाकर फिर से डाउनलोड करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzeta videodatoteka završava prerano. Izbrišite je i ponovno preuzmite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A letöltött videófájl idő előtt véget ér. Törölje, és töltse le újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File video yang diunduh berakhir terlalu cepat. Hapus dan unduh ulang file ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file video scaricato termina prima del previsto. Eliminalo e scaricalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたビデオファイルが途中で終わっています。削除してもう一度ダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 동영상 파일이 중간에 끝나요. 삭제하고 다시 다운로드하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atsisiųstas vaizdo failas baigiasi per anksti. Ištrinkite jį ir atsisiųskite iš naujo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejupielādētais video fails beidzas pārāk agri. Izdzēsiet to un lejupielādējiet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fail video yang dimuat turun berakhir awal. Padam dan muat turun semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den nedlastede videofilen slutter for tidlig. Slett den og last den ned på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gedownloade videobestand houdt te vroeg op. Verwijder het en download het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobrany plik wideo kończy się za wcześnie. Usuń go i pobierz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo de vídeo baixado termina antes do fim. Exclua e baixe novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ficheiro de vídeo transferido termina antes do tempo. Elimine-o e transfira-o novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișierul video descărcat se termină prea devreme. Ștergeți-l și descărcați-l din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачанный видеофайл обрывается раньше времени. Удалите его и скачайте заново."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiahnutý video súbor končí predčasne. Odstráňte ho a stiahnite znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
