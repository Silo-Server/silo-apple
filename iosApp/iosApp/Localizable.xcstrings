    "settings.general.titleArtThisAppleTv" : {
      "comment" : "Apple TV Settings > General > Title Pages: note while Apply to All Devices is off.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم صورة الشعار عنوانًا عند توفرها. يؤثر في هذا Apple TV فقط. تحتفظ أجهزتك الأخرى بإعدادها الخاص."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je k dispozici, zobrazí se místo názvu logo. Platí jen pro toto zařízení Apple TV. Vaše ostatní zařízení si ponechají vlastní nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug logografik som titel, når den findes. Gælder kun dette Apple TV. Dine andre enheder beholder deres egen indstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet, wenn verfügbar, ein Logo als Titel. Gilt nur für dieses Apple TV. Deine anderen Geräte behalten ihre eigene Einstellung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use logo artwork as the title when available. Only affects this Apple TV. Your other devices keep their own setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el logotipo como título cuando esté disponible. Solo afecta a este Apple TV. Tus otros dispositivos mantienen su propia configuración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttää logokuvaa nimenä, kun se on saatavilla. Koskee vain tätä Apple TV:tä. Muut laitteesi säilyttävät oman asetuksensa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le logo comme titre lorsqu’il est disponible. S’applique uniquement à cette Apple TV. Vos autres appareils conservent leur propre paramètre."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi logotip kao naslov kada je dostupan. Utječe samo na ovaj Apple TV. Vaši ostali uređaji zadržavaju vlastitu postavku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il logo come titolo quando disponibile. Vale solo per questa Apple TV. Gli altri tuoi dispositivi mantengono la propria impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用できる場合は、ロゴのアートワークをタイトルとして使用します。このApple TVにのみ適用されます。ほかのデバイスはそれぞれの設定を保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가능한 경우 로고 아트워크를 제목으로 사용해요. 이 Apple TV에만 적용돼요. 다른 기기는 각자의 설정을 유지해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk logografikk som tittel når det finnes. Gjelder bare denne Apple TV-en. De andre enhetene dine beholder sin egen innstilling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik het logo als titel wanneer dat beschikbaar is. Geldt alleen voor deze Apple TV. Je andere apparaten houden hun eigen instelling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa logo jako tytułu, gdy jest dostępne. Dotyczy tylko tego Apple TV. Pozostałe urządzenia zachowują własne ustawienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o logotipo como título quando disponível. Afeta só esta Apple TV. Seus outros dispositivos mantêm a própria configuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать логотип вместо названия, если он есть. Действует только на этом Apple TV. На других ваших устройствах сохраняются их собственные настройки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd logotypgrafik som titel när den finns. Gäller bara denna Apple TV. Dina andra enheter behåller sin egen inställning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut olduğunda başlık olarak logo görselini kullanır. Yalnızca bu Apple TV’yi etkiler. Diğer cihazlarınız kendi ayarlarını korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовувати логотип як назву, якщо він доступний. Діє лише на цьому Apple TV. Ваші інші пристрої зберігають власне налаштування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有标志图时用其作为标题。仅影响这台Apple TV，你的其他设备保留各自的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
