          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä voi kestää jopa puoli minuuttia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela peut prendre jusqu’à une demi-minute."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To može potrajati do pola minute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può richiedere fino a mezzo minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30秒ほどかかる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 30초 정도 걸릴 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette kan ta opptil et halvt minutt."
          }
