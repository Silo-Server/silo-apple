    "signIn.provider.reason.passwordExpired" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error when a directory (LDAP) sign-in provider reports that the account's password expired.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية كلمة مرور الدليل. غيّرها لدى مؤسستك ثم حاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паролата ви в директорията е изтекла. Сменете я чрез вашата организация и опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contrasenya del directori ha caducat. Canvia-la a través de la teva organització i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platnost vašeho adresářového hesla vypršela. Změňte ho u své organizace a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din adgangskode til mappetjenesten er udløbet. Skift den via din organisation, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Verzeichnispasswort ist abgelaufen. Ändere es bei deiner Organisation und versuche es dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός πρόσβασης καταλόγου σας έχει λήξει. Αλλάξτε τον μέσω του οργανισμού σας και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your directory password has expired. Change it with your organization, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña del directorio ha expirado. Cámbiala con tu organización y vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie kataloogi parool on aegunud. Muutke seda oma organisatsiooni kaudu ja proovige siis uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakemistopalvelun salasanasi on vanhentunut. Vaihda se organisaatiosi kautta ja yritä sitten uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe de votre annuaire a expiré. Modifiez-le auprès de votre organisation, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פג תוקף סיסמת המדריך הארגוני שלך. יש לשנות אותה מול הארגון ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके डायरेक्टरी पासवर्ड की अवधि खत्म हो गई है। इसे अपने संगठन के ज़रिए बदलें, फिर दोबारा कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša lozinka imenika je istekla. Promijenite je putem svoje organizacije, a zatim pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A címtárjelszava lejárt. Módosítsa a szervezeténél, majd próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata sandi direktori Anda sudah kedaluwarsa. Ubah melalui organisasi Anda, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password della directory è scaduta. Cambiala tramite la tua organizzazione, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディレクトリのパスワードの有効期限が切れています。組織でパスワードを変更してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디렉터리 비밀번호가 만료됐어요. 소속 조직에서 비밀번호를 변경한 다음 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsų katalogo slaptažodžio galiojimas baigėsi. Pakeiskite jį savo organizacijoje ir bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu direktorija paroles derīguma termiņš ir beidzies. Nomainiet paroli savā organizācijā un mēģiniet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata laluan direktori anda telah tamat tempoh. Tukar kata laluan itu melalui organisasi anda, kemudian cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katalogpassordet ditt har utløpt. Endre det via organisasjonen din, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je directorywachtwoord is verlopen. Wijzig het via je organisatie en probeer het daarna opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasło w katalogu wygasło. Zmień je w swojej organizacji i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua senha do diretório expirou. Altere-a junto à sua organização e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A palavra-passe do seu diretório expirou. Altere-a junto da sua organização e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola dvs. de director a expirat. Schimbați-o prin organizația dvs., apoi încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок действия вашего пароля в каталоге истёк. Смените его через свою организацию и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platnosť vášho adresárového hesla vypršala. Zmeňte ho vo svojej organizácii a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše geslo v imeniku je poteklo. Spremenite ga v svoji organizaciji in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt kataloglösenord har gått ut. Byt det via din organisation och försök sedan igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รหัสผ่านไดเรกทอรีของคุณหมดอายุแล้ว โปรดเปลี่ยนรหัสผ่านกับองค์กรของคุณแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dizin parolanızın süresi doldu. Parolanızı kuruluşunuz aracılığıyla değiştirip tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Строк дії вашого пароля каталогу минув. Змініть його через свою організацію й спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu thư mục của bạn đã hết hạn. Hãy đổi mật khẩu qua tổ chức của bạn rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
