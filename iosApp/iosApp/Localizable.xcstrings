    "downloads.settings.otherDataFooter" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; footer of the Other Download Data section.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظة لخوادم أخرى أو ملفات شخصية أخرى أو بواسطة إصدارات أخرى من Silo. لا تظهر في «التنزيلات» لهذا الملف الشخصي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазени за други сървъри, други профили или от други версии на Silo. Не се показват в „Изтеглени“ за този профил."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desades per a altres servidors, per a altres perfils o per altres versions de Silo. No apareixen a Baixades per a aquest perfil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data uložená pro jiné servery, jiné profily nebo jinými verzemi aplikace Silo. Ve Stahování pro tento profil se nezobrazují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemt for andre servere, andre profiler eller af andre versioner af Silo. De vises ikke i Downloads for denne profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für andere Server, für andere Profile oder von anderen Silo-Versionen gespeichert. Diese Daten erscheinen für dieses Profil nicht unter „Downloads“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύτηκαν για άλλους διακομιστές, για άλλα προφίλ ή από άλλες εκδόσεις του Silo. Δεν εμφανίζονται στις Λήψεις για αυτό το προφίλ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved for other servers, other profiles, or by other versions of Silo. It doesn't appear in Downloads for this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardados para otros servidores, otros perfiles o por otras versiones de Silo. No aparecen en Descargas para este perfil."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvestatud teiste serverite või teiste profiilide jaoks või Silo muude versioonidega. Neid ei kuvata selle profiili jaotises „Allalaadimised“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennettu muita palvelimia tai profiileja varten tai Silon muilla versioilla. Ei näy tämän profiilin Latauksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrées pour d’autres serveurs, d’autres profils ou par d’autres versions de Silo. Elles n’apparaissent pas dans Téléchargements pour ce profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נתונים שנשמרו עבור שרתים אחרים, פרופילים אחרים או על ידי גרסאות אחרות של Silo. הם לא מופיעים בהורדות של הפרופיל הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अन्य सर्वरों या अन्य प्रोफ़ाइलों के लिए, या Silo के अन्य वर्शन द्वारा सेव किया गया। यह इस प्रोफ़ाइल के डाउनलोड में नहीं दिखता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremljeno za druge poslužitelje, druge profile ili iz drugih verzija aplikacije Silo. Ne prikazuje se u Preuzimanjima za ovaj profil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más szerverekhez vagy más profilokhoz, illetve a Silo más verzióival mentve. Ennél a profilnál nem jelenik meg a Letöltések között."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disimpan untuk server lain, profil lain, atau oleh versi Silo lain. Data ini tidak muncul di Unduhan untuk profil ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvati per altri server, altri profili o da altre versioni di Silo. Non compaiono in Download per questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のサーバーや他のプロフィール用に、またはSiloの他のバージョンによって保存されたデータです。このプロフィールのダウンロードには表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
