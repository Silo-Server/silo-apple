    "home.recipe.returningShowsDefault.description" : {
      "comment" : "One-line description of the Returning Shows preset in the Add row gallery (shared key `home.recipe.returningShowsDefault.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسلسلات شاهدتها ولها موسم جديد في مكتبتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гледани от вас сериали с изцяло нов сезон във вашата библиотека."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sèries que has vist amb una temporada nova a la teva biblioteca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledované seriály, které mají ve vaší knihovně zcela novou řadu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serier, du har set, med en helt ny sæson i dit bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serien, die du geschaut hast, mit einer brandneuen Staffel in deiner Mediathek."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σειρές που έχετε παρακολουθήσει και έχουν ολοκαίνουργια σεζόν στη βιβλιοθήκη σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows you've watched with a brand-new season in your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series que viste y que tienen una temporada nueva en tu biblioteca."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarjad, mida olete vaadanud ja millelt on teie meediakogus uus hooaeg."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katsomasi sarjat, joiden upouusi kausi on kirjastossasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séries déjà regardées dont une toute nouvelle saison est arrivée dans votre bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סדרות שצפית בהן ושנוספה להן עונה חדשה לגמרי בספרייה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी देखी हुई सीरीज़, जिनका बिल्कुल नया सीज़न आपकी लाइब्रेरी में आया है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serije koje ste gledali, a imaju potpuno novu sezonu u vašoj medijateci."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megnézett sorozatok, amelyeknek vadonatúj évada van a könyvtárban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serial yang pernah Anda tonton dan kini punya musim baru di perpustakaan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
