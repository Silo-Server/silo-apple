    "accounts.badge.signInAgain" : {
      "comment" : "Apple: status shown on an account whose sign-in expired, so it must sign in again before use. Shown as the line under the account in Settings > Accounts and Change Account (iPhone, iPad, Mac), as the row value in Apple TV Settings > Accounts, and as a badge (in capitals) on Apple TV Change Account. A status, not a button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
