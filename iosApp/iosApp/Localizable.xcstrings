    "settings.privacyPolicy.scanPrompt" : {
      "comment" : "Apple TV Settings: text beside the QR code that opens Silo's privacy policy (Apple TV has no web browser).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح هذا الرمز بهاتفك أو جهازك اللوحي لقراءة سياسة خصوصية Silo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne diesen Code mit deinem Smartphone oder Tablet, um die Datenschutzerklärung von Silo zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan this code with your phone or tablet to read Silo's privacy policy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea este código con tu teléfono o tableta para leer la política de privacidad de Silo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez ce code avec votre téléphone ou votre tablette pour lire la politique de confidentialité de Silo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
