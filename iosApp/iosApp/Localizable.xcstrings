    "settingsManifest.playback.intro_skip_mode.description" : {
      "comment" : "Help text under the playback.intro_skip_mode setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يفعله Silo عند بدء المقدمة: تركها، أو عرض زر «تخطي المقدمة»، أو تخطيها مع إتاحة التراجع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Какво прави Silo, когато започне въведение: нищо, предлага бутона „Прескачане на въведението“ или го прескача и предлага отмяна."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Què fa Silo quan comença una introducció: no fer res, oferir el botó Omet la introducció o ometre-la i oferir l’opció de desfer-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co Silo udělá, když začne úvod: nechá ho běžet, nabídne tlačítko Přeskočit úvod, nebo ho přeskočí a nabídne vrácení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad Silo gør, når en intro starter: lader den være, viser knappen Spring intro over eller springer den over og tilbyder at fortryde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was Silo tut, wenn ein Intro beginnt: nichts, die Schaltfläche „Intro überspringen“ anbieten oder es überspringen und Rückgängigmachen anbieten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τι κάνει το Silo όταν ξεκινά μια εισαγωγή: την αφήνει, εμφανίζει το κουμπί «Παράλειψη εισαγωγής» ή την παραλείπει και προσφέρει αναίρεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What Silo does when an intro starts: leave it alone, offer a Skip Intro button, or skip it and offer an undo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué hace Silo cuando empieza una introducción: dejarla, ofrecer un botón Omitir introducción u omitirla y ofrecer la opción de deshacer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mida Silo teeb, kui intro algab: ei tee midagi, pakub nuppu „Jäta intro vahele“ või jätab intro vahele ja pakub võimalust see tagasi võtta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä Silo tekee alkutunnuksen alkaessa: ei tee mitään, tarjoaa Ohita alkutunnus -painikkeen tai ohittaa sen ja tarjoaa kumoamisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que fait Silo au début d’une intro : ne rien faire, proposer un bouton « Passer l’intro », ou la passer et proposer d’annuler."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מה Silo עושה כשפתיח מתחיל: שום דבר, הצגת הכפתור ”דילוג על הפתיח”, או דילוג עליו עם אפשרות לביטול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंट्रो शुरू होने पर Silo क्या करे: कुछ न करे, “इंट्रो छोड़ें” बटन दिखाए, या इंट्रो छोड़कर उसे पहले जैसा करने का विकल्प दे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Što Silo radi kada uvod počne: ne radi ništa, nudi gumb Preskoči uvod ili ga preskače i nudi poništavanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit tegyen a Silo, amikor elkezdődik egy bevezető: hagyja, felajánlja a Bevezető átugrása gombot, vagy átugorja, és felajánlja a visszavonást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan Silo saat intro dimulai: membiarkannya, menawarkan tombol Lewati intro, atau melewatinya dan menawarkan opsi urungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa fa Silo quando inizia una intro: la lascia, mostra un pulsante Salta intro oppure la salta e offre la possibilità di annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イントロが始まったときのSiloの動作です。何もしない、「イントロをスキップ」ボタンを表示する、またはスキップして元に戻す操作を表示する、から選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인트로가 시작될 때 Silo가 할 동작이에요. 그대로 두거나, 인트로 건너뛰기 버튼을 표시하거나, 건너뛴 뒤 실행 취소를 제공해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ką „Silo“ daro, kai prasideda įžanga: nieko nedaro, pasiūlo mygtuką „Praleisti įžangą“ arba ją praleidžia ir pasiūlo atšaukti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko Silo dara, kad sākas ievads: neko nedara, piedāvā pogu „Izlaist ievadu” vai izlaiž to un piedāvā atsaukšanu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan Silo apabila intro bermula: biarkan sahaja, tawarkan butang Langkau intro, atau langkau intro dan tawarkan pilihan buat asal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva Silo gjør når en intro starter: lar den være, viser knappen «Hopp over intro» eller hopper over den og tilbyr å angre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat Silo doet als een intro begint: niets, een knop Intro overslaan aanbieden, of de intro overslaan en ongedaan maken aanbieden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co Silo robi, gdy zaczyna się czołówka: nic, pokazuje przycisk Pomiń czołówkę albo pomija ją i pozwala cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o Silo faz quando uma abertura começa: não fazer nada, oferecer o botão Pular abertura ou pular e oferecer a opção de desfazer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o Silo faz quando começa uma introdução: não fazer nada, mostrar um botão Saltar introdução ou saltá-la e oferecer a opção de anular."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce face Silo când începe o introducere: o lasă să ruleze, afișează butonul Omiteți introducerea sau o omite și oferă posibilitatea de anulare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что делает Silo в начале вступления: ничего не делает, предлагает кнопку «Пропустить вступление» или пропускает его с возможностью отмены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čo Silo urobí, keď začne úvod: nechá ho tak, ponúkne tlačidlo Preskočiť úvod alebo ho preskočí a ponúkne možnosť vrátenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaj Silo naredi, ko se začne uvod: ga pusti, ponudi gumb „Preskoči uvod“ ali ga preskoči in ponudi razveljavitev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad Silo gör när ett intro börjar: låter det vara, visar knappen ”Hoppa över intro” eller hoppar över det och erbjuder att ångra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่ Silo ทำเมื่ออินโทรเริ่ม: ปล่อยไว้ตามเดิม แสดงปุ่ม “ข้ามอินโทร” หรือข้ามให้และให้เลิกทำได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir giriş başladığında Silo’nun ne yapacağı: dokunmamak, Girişi Atla düğmesi sunmak veya girişi atlayıp geri alma seçeneği sunmak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що робить Silo, коли починається заставка: нічого не робить, пропонує кнопку «Пропустити заставку» або пропускає її з можливістю скасувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc Silo làm khi đoạn mở đầu bắt đầu: để nguyên, hiển thị nút Bỏ qua đoạn mở đầu, hoặc bỏ qua và cho phép hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片头开始时Silo的处理方式：不做处理、显示“跳过片头”按钮，或直接跳过并提供撤销选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片頭開始時 Silo 要怎麼處理：不處理、顯示「略過片頭」按鈕，或自動略過並提供復原選項。"
          }
        }
      }
    },
