    "settings.interface.applyToAllDevicesSubtitle" : {
      "comment" : "Apple Settings > Interface > Title Pages and Apple TV Settings > General: description of the Apply to All Devices switch (VoiceOver hint on iPhone, iPad and Apple TV; shown under the switch on Mac).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم هذا الاختيار في كل مكان على هذا الملف الشخصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Auswahl überall in diesem Profil verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this choice everywhere on this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa esta opción en todas partes en este perfil."
