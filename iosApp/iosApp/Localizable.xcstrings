    "settings.subtitles.authoredStyle" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac) and Apple TV Settings > Subtitles: footer sentence about subtitles that carry their own styling.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ الترجمات ذات التنسيق المدمج بمظهرها الأصلي؛ وتحتفظ الترجمات المعتمدة على الصور بخطوطها وألوانها الأصلية لكنها تتبع إعدادات الحجم والموضع والخلفية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel mit eigener eingebetteter Formatierung behalten ihr ursprüngliches Aussehen; bildbasierte Untertitel behalten ihre vorgegebenen Schriften und Farben, folgen aber den Einstellungen für Größe, Position und Hintergrund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitles with their own built-in styling keep their original appearance; image-based subtitles keep their authored fonts and colors but follow the size, position, and background settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos con estilo propio integrado conservan su apariencia original; los subtítulos basados en imágenes conservan sus fuentes y colores originales, pero siguen la configuración de tamaño, posición y fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres dotés de leur propre style conservent leur apparence d’origine ; les sous-titres en image conservent leurs polices et couleurs d’origine, mais suivent les paramètres de taille, de position et d’arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独自のスタイルを持つ字幕は元の外観のまま表示されます。画像ベースの字幕は作成時のフォントと色を保持しますが、サイズ、位置、背景の設定には従います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legendas com estilo próprio incorporado mantêm a aparência original; legendas baseadas em imagem mantêm as fontes e cores originais, mas seguem as configurações de tamanho, posição e fundo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自带样式的字幕会保留原有外观；图形字幕会保留原有字体和颜色，但遵循大小、位置和背景设置。"
          }
        }
      }
    },
    "settings.subtitles.authoredStyleSystem" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac) and Apple TV Settings > Subtitles: footer sentence while Use Device Settings is on. Video Overrides Style is an option name in Apple's caption settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع الترجمات ذات التنسيق المدمج خيار «يتجاوز الفيديو النمط» في كل خيار من خيارات التسميات التوضيحية للجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel mit eingebetteter Formatierung folgen der Auswahl „Video überschreibt Stil“ der jeweiligen Untertiteloption des Geräts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitles with built-in styling follow each device caption option's Video Overrides Style choice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos con estilo integrado siguen el ajuste “El video anula el estilo” de cada opción de subtítulos del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres dotés de leur propre style suivent le choix « La vidéo remplace le style » de chaque option de sous-titres de l’appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独自のスタイルを持つ字幕は、デバイスの各字幕オプションの「ビデオでスタイルを上書き」の設定に従います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legendas com estilo incorporado seguem a opção Vídeo Substitui Estilo de cada opção de legenda do dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自带样式的字幕遵循设备各字幕选项中的“视频覆盖样式”设置。"
          }
        }
      }
    },
