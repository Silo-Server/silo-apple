    "signIn.forgot.sentLead" : {
      "comment" : "Apple (iPhone, iPad, Mac): line under Check your email after a reset link was requested. {login}: the username or email the person typed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا تطابق %1$@ مع حساب له عنوان بريد إلكتروني، فقد أرسلنا إلى ذلك العنوان رابطًا لاختيار كلمة مرور جديدة. بعد اختيارها، سجّل الدخول هنا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако %1$@ съвпада с акаунт с имейл адрес, изпратихме на този адрес връзка за избор на нова парола. След като я изберете, влезте оттук."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %1$@ correspon a un compte amb adreça electrònica, hem enviat a aquesta adreça un enllaç per triar una contrasenya nova. Quan l’hagis triada, inicia la sessió aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud %1$@ odpovídá účtu s e-mailovou adresou, poslali jsme na tuto adresu odkaz pro nastavení nového hesla. Po jeho nastavení se můžete přihlásit zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis %1$@ matcher en konto med en e-mailadresse, har vi sendt et link til den adresse, så du kan vælge en ny adgangskode. Når du har valgt den, kan du logge ind her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn %1$@ zu einem Konto mit E-Mail-Adresse passt, haben wir an diese Adresse einen Link gesendet, mit dem du ein neues Passwort wählen kannst. Sobald du es gewählt hast, melde dich hier an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν υπάρχει λογαριασμός που αντιστοιχεί σε «%1$@» και έχει διεύθυνση email, στείλαμε σε αυτήν τη διεύθυνση έναν σύνδεσμο για να επιλέξετε νέο κωδικό πρόσβασης. Αφού τον επιλέξετε, συνδεθείτε εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If %1$@ matches an account with an email address, we sent that address a link to choose a new password. Once you've chosen it, sign in here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %1$@ coincide con una cuenta que tiene correo electrónico, enviamos a esa dirección un enlace para elegir una contraseña nueva. Cuando la hayas elegido, inicia sesión aquí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui %1$@ vastab e-posti aadressiga kontole, saatsime sellele aadressile lingi uue parooli valimiseks. Kui olete selle valinud, logige siin sisse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos %1$@ vastaa tiliä, jolla on sähköpostiosoite, lähetimme siihen osoitteeseen linkin uuden salasanan valitsemiseksi. Kun olet valinnut sen, kirjaudu sisään täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %1$@ correspond à un compte doté d’une adresse e-mail, nous avons envoyé à cette adresse un lien pour choisir un nouveau mot de passe. Une fois celui-ci choisi, connectez-vous ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם שם המשתמש או האימייל %1$@ תואמים לחשבון עם כתובת אימייל, שלחנו לכתובת הזו קישור לבחירת סיסמה חדשה. אחרי שבחרת סיסמה, אפשר להתחבר כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर %1$@ किसी ईमेल पते वाले खाते से मेल खाता है, तो हमने उस पते पर नया पासवर्ड चुनने का लिंक भेजा है। पासवर्ड चुनने के बाद यहाँ साइन इन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako %1$@ odgovara računu s e-adresom, na tu smo adresu poslali poveznicu za odabir nove lozinke. Kada je odaberete, prijavite se ovdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a megadott adat (%1$@) egy e-mail-címmel rendelkező fiókhoz tartozik, elküldtünk arra a címre egy linket, amellyel új jelszót választhat. Ha kiválasztotta, jelentkezzen be itt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika %1$@ cocok dengan akun yang memiliki alamat email, kami telah mengirimkan tautan ke alamat tersebut untuk memilih kata sandi baru. Setelah memilihnya, masuk di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se %1$@ corrisponde a un account con un indirizzo email, abbiamo inviato a quell’indirizzo un link per scegliere una nuova password. Dopo averla scelta, accedi qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@がメールアドレスを登録したアカウントと一致する場合、そのアドレスに新しいパスワードを設定するためのリンクを送信しました。設定が済んだら、ここでサインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일 주소가 등록된 계정 중 %1$@에 해당하는 계정이 있으면 그 주소로 새 비밀번호를 설정할 수 있는 링크를 보냈어요. 새 비밀번호를 설정한 후 여기에서 로그인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jei %1$@ atitinka paskyrą su el. pašto adresu, tuo adresu išsiuntėme nuorodą naujam slaptažodžiui pasirinkti. Kai jį pasirinksite, prisijunkite čia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja %1$@ atbilst kontam ar e-pasta adresi, mēs uz šo adresi nosūtījām saiti jaunas paroles izvēlei. Kad jaunā parole būs izvēlēta, pierakstieties šeit."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika %1$@ sepadan dengan akaun yang mempunyai alamat e-mel, kami telah menghantar pautan ke alamat itu untuk memilih kata laluan baharu. Selepas memilihnya, log masuk di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis %1$@ samsvarer med en konto med en e-postadresse, har vi sendt en lenke til den adressen for å velge et nytt passord. Når du har valgt det, logger du på her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als %1$@ bij een account met een e-mailadres hoort, hebben we naar dat adres een link gestuurd om een nieuw wachtwoord te kiezen. Zodra je het hebt gekozen, kun je hier inloggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli %1$@ pasuje do konta z adresem e-mail, wysłaliśmy na ten adres link do ustawienia nowego hasła. Gdy je ustawisz, zaloguj się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se %1$@ corresponder a uma conta com endereço de e-mail, enviamos a esse endereço um link para escolher uma nova senha. Depois de escolhê-la, entre aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se %1$@ corresponder a uma conta com endereço de email, enviámos para esse endereço um link para escolher uma nova palavra-passe. Depois de a escolher, inicie sessão aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă %1$@ corespunde unui cont cu adresă de e-mail, am trimis la acea adresă un link pentru a alege o parolă nouă. După ce ați ales-o, conectați-vă aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если %1$@ соответствует аккаунту с адресом эл. почты, мы отправили на этот адрес ссылку для выбора нового пароля. Когда зададите пароль, войдите здесь."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak údaj %1$@ zodpovedá účtu s e-mailovou adresou, poslali sme na ňu odkaz na výber nového hesla. Keď si ho vyberiete, prihláste sa tu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če se %1$@ ujema z računom z e-poštnim naslovom, smo na ta naslov poslali povezavo za izbiro novega gesla. Ko ga izberete, se prijavite tukaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om %1$@ matchar ett konto med en e-postadress har vi skickat en länk dit där du kan välja ett nytt lösenord. När du har valt det loggar du in här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หาก %1$@ ตรงกับบัญชีที่มีอีเมล เราได้ส่งลิงก์สำหรับตั้งรหัสผ่านใหม่ไปยังอีเมลนั้นแล้ว เมื่อตั้งรหัสผ่านแล้ว ให้ลงชื่อเข้าใช้ที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bilgisi e-posta adresi olan bir hesapla eşleşiyorsa o adrese, yeni bir parola seçmeniz için bir bağlantı gönderdik. Parolanızı seçtikten sonra burada oturum açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо %1$@ збігається з обліковим записом, у якого є електронна адреса, ми надіслали на неї посилання для вибору нового пароля. Вибравши пароль, увійдіть тут."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu %1$@ khớp với một tài khoản có địa chỉ email, chúng tôi đã gửi đến địa chỉ đó một liên kết để chọn mật khẩu mới. Sau khi chọn xong, hãy đăng nhập tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果%1$@与某个设有电子邮件地址的账户匹配，我们已向该地址发送了设置新密码的链接。设置完成后，请在此处登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 %1$@ 與某個設有電子郵件地址的帳號相符，我們已寄送連結至該地址，讓你設定新密碼。設定完成後，請在這裡登入。"
          }
        }
      }
    },
    "signIn.forgot.sentNote" : {
      "comment" : "Apple (iPhone, iPad, Mac): small note under Check your email after a reset link was requested.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يصلك شيء بعد بضع دقائق؟ تحقق من مجلد الرسائل غير المرغوب فيها، ثم حاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нищо след няколко минути? Проверете папката за спам, след което опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No has rebut res al cap d’uns minuts? Comprova la carpeta de correu brossa i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nepřišlo ani po několika minutách? Zkontrolujte složku se spamem a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet efter et par minutter? Tjek din spammappe, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach ein paar Minuten noch nichts angekommen? Sieh in deinem Spam-Ordner nach und versuche es dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν λάβατε τίποτα μετά από μερικά λεπτά; Ελέγξτε τον φάκελο ανεπιθύμητης αλληλογραφίας και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing after a few minutes? Check your spam folder, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿No llegó nada tras unos minutos? Revisa la carpeta de spam y vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mõne minuti pärast pole midagi saabunud? Kontrollige rämpsposti kausta ja proovige siis uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eikö mitään tullut muutamassa minuutissa? Tarkista roskapostikansio ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien reçu après quelques minutes ? Vérifiez votre dossier de spam, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא הגיע כלום אחרי כמה דקות? יש לבדוק את תיקיית הספאם ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ मिनट बाद भी कुछ नहीं आया? अपना स्पैम फ़ोल्डर देखें, फिर दोबारा कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ništa nakon nekoliko minuta? Provjerite mapu neželjene pošte pa pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Néhány perc után sem érkezett semmi? Nézze meg a levélszemét mappát, majd próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada apa pun setelah beberapa menit? Periksa folder spam Anda, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è arrivato nulla dopo qualche minuto? Controlla la cartella spam, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数分経っても届きませんか？迷惑メールフォルダを確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 분이 지나도 받지 못했나요? 스팸 폴더를 확인한 후 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po kelių minučių nieko negavote? Patikrinkite šlamšto aplanką, tada bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pēc dažām minūtēm nekas nav saņemts? Pārbaudiet surogātpasta mapi un mēģiniet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada apa-apa selepas beberapa minit? Semak folder spam anda, kemudian cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting etter noen minutter? Sjekk søppelpostmappen, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na een paar minuten nog niets? Controleer je spammap en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nie przyszło po kilku minutach? Sprawdź folder spamu, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada depois de alguns minutos? Verifique sua pasta de spam e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não recebeu nada após alguns minutos? Verifique a pasta de spam e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu ați primit nimic după câteva minute? Verificați dosarul de spam, apoi încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Письмо не пришло через несколько минут? Проверьте папку «Спам» и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po niekoľkých minútach nič neprišlo? Skontrolujte priečinok so spamom a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po nekaj minutah še nič? Preverite mapo z neželeno pošto, nato poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget efter några minuter? Kontrollera skräppostmappen och försök sedan igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผ่านไปสองสามนาทีแล้วยังไม่ได้รับใช่ไหม ตรวจสอบโฟลเดอร์สแปม แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birkaç dakika geçti ve hâlâ bir şey gelmedi mi? İstenmeyen e-posta klasörünüzü kontrol edip tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нічого не надійшло за кілька хвилин? Перевірте папку зі спамом, а потім спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẫn chưa nhận được sau vài phút? Kiểm tra thư mục thư rác, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "几分钟后仍未收到？请检查垃圾邮件文件夹，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過了幾分鐘仍沒收到？請檢查垃圾郵件資料夾，然後再試一次。"
          }
        }
      }
    },
