    "settingsManifest.playback.show_forced_subtitles.description" : {
      "comment" : "Help text under the playback.show_forced_subtitles setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض الترجمة للحوارات بلغة أجنبية حتى عند إيقاف الترجمة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показване на субтитри за реплики на чужд език дори когато субтитрите са изключени."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra els subtítols dels diàlegs en una altra llengua fins i tot quan els subtítols estan desactivats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit titulky pro dialogy v cizím jazyce, i když jsou titulky vypnuté."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis undertekster til dialog på fremmedsprog, selv når undertekster er slået fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Untertitel für fremdsprachige Dialoge an, auch wenn Untertitel aus sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση υποτίτλων για διαλόγους σε ξένη γλώσσα ακόμη και όταν οι υπότιτλοι είναι απενεργοποιημένοι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show subtitles for foreign-language dialogue even when subtitles are off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra subtítulos para los diálogos en otro idioma aunque los subtítulos estén desactivados."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näitab võõrkeelse dialoogi subtiitreid ka siis, kui subtiitrid on välja lülitatud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä tekstitys vieraskieliselle dialogille, vaikka tekstitys olisi pois päältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les sous-titres des dialogues en langue étrangère même quand les sous-titres sont désactivés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת כתוביות לדיאלוג בשפה זרה גם כשהכתוביות כבויות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विदेशी भाषा के संवादों के लिए सबटाइटल दिखाएँ, भले ही सबटाइटल बंद हों।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje titlove za dijaloge na stranom jeziku čak i kada su titlovi isključeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feliratok megjelenítése az idegen nyelvű párbeszédekhez akkor is, ha a feliratok ki vannak kapcsolva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan subtitel untuk dialog berbahasa asing meskipun subtitel nonaktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra i sottotitoli per i dialoghi in lingua straniera anche quando i sottotitoli sono disattivati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕がオフのときでも、外国語のセリフの字幕を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자막이 꺼져 있어도 외국어 대사에는 자막을 표시해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodyti subtitrus užsienio kalba vykstantiems dialogams, net kai subtitrai išjungti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rāda subtitrus svešvalodas dialogiem arī tad, ja subtitri ir izslēgti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan sari kata untuk dialog dalam bahasa asing walaupun sari kata dimatikan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis undertekster for dialog på fremmedspråk selv når undertekster er av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon ondertitels voor dialogen in een vreemde taal, ook als ondertitels uit staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj napisy do dialogów w języku obcym, nawet gdy napisy są wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra legendas para diálogos em língua estrangeira mesmo com as legendas desativadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar legendas para diálogos em língua estrangeira, mesmo com as legendas desativadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează subtitrări pentru dialogurile în limbi străine chiar și când subtitrările sunt dezactivate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать субтитры для реплик на иностранном языке, даже когда субтитры выключены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí titulky pre dialógy v cudzom jazyku, aj keď sú titulky vypnuté."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži podnapise za dialoge v tujem jeziku, tudi ko so podnapisi izklopljeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa undertexter för dialog på främmande språk även när undertexter är avstängda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงคำบรรยายสำหรับบทพูดภาษาต่างประเทศแม้ปิดคำบรรยายอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altyazılar kapalıyken bile yabancı dildeki diyaloglar için altyazı gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати субтитри для діалогів іноземною мовою, навіть коли субтитри вимкнено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị phụ đề cho lời thoại bằng tiếng nước ngoài ngay cả khi phụ đề đang tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使字幕已关闭，也为外语对白显示字幕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使字幕已關閉，仍顯示外語對白的字幕。"
          }
        }
      }
    },
