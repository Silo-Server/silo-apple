        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локалният отчет е изтрит. Отдалеченото изтриване е в опашката и ще бъде опитано отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
