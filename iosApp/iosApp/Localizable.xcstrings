    "settingsManifest.playback.auto_play_next_preview.description" : {
      "comment" : "Help text under the playback.auto_play_next_preview setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض معاينة للحلقة التالية أثناء تشغيل شارة النهاية."
          }
