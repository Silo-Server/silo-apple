    "settingsManifest.player.passout_threshold.description" : {
      "comment" : "Help text under the player.passout_threshold setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الحلقات التي تُشغَّل تلقائيًا قبل أن يسألك Silo إن كنت ما زلت تشاهد. القيمة 0 تعني عدم السؤال أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Folgen automatisch abgespielt werden, bevor Silo fragt, ob du noch schaust. Bei 0 wird nie gefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many episodes auto-play before Silo asks whether you are still watching. 0 never asks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántos episodios se reproducen automáticamente antes de que Silo te pregunte si sigues viendo. Con 0 nunca pregunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre d’épisodes lus automatiquement avant que Silo vous demande si vous regardez toujours. Avec 0, Silo ne demande jamais."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloが視聴を続けているか確認するまでに自動再生するエピソード数です。0にすると確認しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantos episódios são reproduzidos automaticamente antes de o Silo perguntar se você ainda está assistindo. Com 0, nunca pergunta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
