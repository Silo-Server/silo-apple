    "watchParty.banner.hostAway" : {
      "comment" : "Roku: warning banner in the lobby when the host's connection dropped. {host}: the host's display name. Apple (iPhone, iPad, Apple TV): same warning banner in the lobby for guests. Android phone and TV Watch Party lobby: same banner for a guest. 1: the host's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع اتصال %1$@. تنتظر Watch Party لمدة دقيقتين ريثما يعود."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat die Verbindung verloren. Die Watch Party wartet zwei Minuten auf die Rückkehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ lost connection. The party holds for two minutes while they come back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ perdió la conexión. La Watch Party espera dos minutos a que vuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a perdu la connexion. La Watch Party est maintenue deux minutes pour lui laisser le temps de revenir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@さんの接続が切れました。戻るまでWatch Partyは2分間待機します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ perdeu a conexão. A Watch Party aguarda dois minutos pelo retorno."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@已断开连接。Watch Party会保留两分钟，等待其重新连接。"
          }
        }
      }
    },
    "watchParty.banner.reconnecting" : {
      "comment" : "Roku, Android phone and TV: banner or notice in the lobby while this device is reconnecting to the party. Apple (iPhone, iPad, Apple TV): same notice banner in the lobby.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ إعادة الاتصال بـ Watch Party…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung zur Watch Party wird wiederhergestellt…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnecting to the party…"
          }
        },
        "es" : {
          "stringUnit" : {
