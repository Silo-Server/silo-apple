    "settingsManifest.player.video_skip_forward_seconds.description" : {
      "comment" : "Help text under the player.video_skip_forward_seconds setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الثواني للتقديم أثناء تشغيل الفيديو. ينطبق على الأزرار واختصارات لوحة المفاتيح والإيماءات وعناصر التحكم في الوسائط المدعومة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секунди за прескачане напред при възпроизвеждане на видео. Важи за бутоните, клавишните комбинации, жестовете и поддържаните контроли за медия."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segons que s’avança en la reproducció de vídeo. S’aplica als botons, les dreceres de teclat, els gestos i els controls multimèdia compatibles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet sekund, o které se při přehrávání videa přeskočí vpřed. Platí pro tlačítka, klávesové zkratky, gesta a podporované ovládání médií."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal sekunder, der springes frem ved afspilning af video. Gælder knapper, tastaturgenveje, bevægelser og understøttede mediekontroller."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekunden, um die bei der Videowiedergabe vorgespult wird. Gilt für Schaltflächen, Tastenkürzel, Gesten und unterstützte Mediensteuerungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δευτερόλεπτα γρήγορης προώθησης κατά την αναπαραγωγή βίντεο. Ισχύει για κουμπιά, συντομεύσεις πληκτρολογίου, χειρονομίες και υποστηριζόμενα χειριστήρια πολυμέσων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seconds to skip forward in video playback. Applies to buttons, keyboard shortcuts, gestures, and supported media controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos que se avanzan en la reproducción de video. Se aplica a botones, atajos de teclado, gestos y controles multimedia compatibles."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitu sekundit videoesitusel edasi kerida. Kehtib nuppude, kiirklahvide, žestide ja toetatud meediajuhtnuppude kohta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka monta sekuntia videon toistossa hypätään eteenpäin. Koskee painikkeita, pikanäppäimiä, eleitä ja tuettuja mediasäätimiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de secondes d’avance rapide lors de la lecture vidéo. S’applique aux boutons, aux raccourcis clavier, aux gestes et aux commandes multimédias prises en charge."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מספר השניות לדילוג קדימה בהפעלת וידאו. חל על כפתורים, קיצורי מקלדת, מחוות ופקדי מדיה נתמכים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वीडियो प्लेबैक में कितने सेकंड आगे जाना है। यह बटन, कीबोर्ड शॉर्टकट, जेस्चर और सपोर्ट किए जाने वाले मीडिया कंट्रोल पर लागू होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broj sekundi za preskakanje unaprijed pri reprodukciji videozapisa. Primjenjuje se na gumbe, tipkovničke prečace, geste i podržane kontrole medija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennyi másodpercet ugrik előre a videó lejátszása. A gombokra, a billentyűparancsokra, a kézmozdulatokra és a támogatott médiavezérlőkre vonatkozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah detik untuk melompat maju saat memutar video. Berlaku untuk tombol, pintasan keyboard, gestur, dan kontrol media yang didukung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secondi da saltare in avanti durante la riproduzione video. Vale per pulsanti, scorciatoie da tastiera, gesti e controlli multimediali supportati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画再生時に早送りする秒数です。ボタン、キーボードショートカット、ジェスチャー、対応するメディアコントロールに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상 재생 중 앞으로 건너뛸 시간(초)이에요. 버튼, 키보드 단축키, 제스처, 지원되는 미디어 컨트롤에 적용돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiek sekundžių persukti į priekį leidžiant vaizdo įrašą. Taikoma mygtukams, sparčiųjų klavišų deriniams, gestams ir palaikomiems medijos valdikliams."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekundes, par kurām pārtīt uz priekšu video atskaņošanā. Attiecas uz pogām, īsinājumtaustiņiem, žestiem un atbalstītajām multivides vadīklām."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilangan saat untuk melangkau ke hadapan semasa main balik video. Digunakan pada butang, pintasan papan kekunci, gerak isyarat dan kawalan media yang disokong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antall sekunder å hoppe fremover ved avspilling av video. Gjelder knapper, hurtigtaster, bevegelser og støttede mediekontroller."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aantal seconden dat je vooruitspringt bij het afspelen van video. Geldt voor knoppen, sneltoetsen, gebaren en ondersteunde mediabediening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba sekund przewijania do przodu podczas odtwarzania wideo. Dotyczy przycisków, skrótów klawiszowych, gestów i obsługiwanych elementów sterowania multimediami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos para avançar na reprodução de vídeo. Vale para botões, atalhos de teclado, gestos e controles de mídia compatíveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos a avançar na reprodução de vídeo. Aplica-se a botões, atalhos de teclado, gestos e controlos multimédia suportados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secundele cu care se derulează înainte la redarea video. Se aplică butoanelor, comenzilor rapide de la tastatură, gesturilor și comenzilor media acceptate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На сколько секунд перематывать вперёд при воспроизведении видео. Действует для кнопок, сочетаний клавиш, жестов и поддерживаемых элементов управления воспроизведением."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet sekúnd na posun dopredu pri prehrávaní videa. Platí pre tlačidlá, klávesové skratky, gestá a podporované ovládače médií."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Število sekund za preskok naprej pri predvajanju videa. Velja za gumbe, bližnjice na tipkovnici, kretnje in podprte kontrolnike predstavnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal sekunder att hoppa framåt vid videouppspelning. Gäller knappar, kortkommandon, gester och mediekontroller som stöds."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำนวนวินาทีที่จะข้ามไปข้างหน้าเมื่อเล่นวิดีโอ ใช้กับปุ่ม แป้นพิมพ์ลัด ท่าทาง และตัวควบคุมสื่อที่รองรับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video oynatırken ileri atlanacak saniye. Düğmeler, klavye kısayolları, hareketler ve desteklenen medya kontrolleri için geçerlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кількість секунд для перемотування вперед під час відтворення відео. Діє для кнопок, комбінацій клавіш, жестів і підтримуваних елементів керування медіа."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số giây tua tới khi phát video. Áp dụng cho các nút, phím tắt, cử chỉ và các điều khiển phương tiện được hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频播放时快进的秒数。适用于按钮、键盘快捷键、手势和受支持的媒体控件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片播放時要快轉的秒數。適用於按鈕、鍵盤快速鍵、手勢及支援的媒體控制項。"
          }
        }
      }
    },
