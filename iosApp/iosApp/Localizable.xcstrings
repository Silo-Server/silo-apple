          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión no puede cambiar la contraseña. Inicia sesión con tu propia cuenta y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä istunnossa ei voi vaihtaa salasanaa. Kirjaudu sisään omalla tililläsi ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette session ne permet pas de modifier le mot de passe. Connectez-vous avec votre propre compte et réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova sesija ne može promijeniti lozinku. Prijavite se vlastitim računom i pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa sessione non può cambiare la password. Accedi con il tuo account e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションではパスワードを変更できません。ご自身のアカウントでサインインして、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세션에서는 비밀번호를 변경할 수 없어요. 본인 계정으로 로그인한 후 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne økten kan ikke endre passordet. Logg på med din egen konto, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
