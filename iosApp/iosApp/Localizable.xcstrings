    "newProfile.librariesEmpty" : {
      "comment" : "Roku, phone and TV: note on the profile form (create, and edit on phone and TV) shown when the server has no libraries that can be assigned to the profile. Apple (iPhone, iPad, Mac, Apple TV): same note on the New Profile form.",
