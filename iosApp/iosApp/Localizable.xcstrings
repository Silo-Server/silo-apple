    "shell.error.notFound" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error message under the Not found heading (HTTP 404).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر العثور على ما تبحث عنه. ربما تمت إزالته أو نقله."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hledanou položku se nepodařilo najít. Mohla být odstraněna nebo přesunuta."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke finde det, du ledte efter. Det er muligvis blevet fjernet eller flyttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten nicht finden, wonach du gesucht hast. Es wurde möglicherweise entfernt oder verschoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't find what you were looking for. It may have been removed or moved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encontramos lo que buscabas. Es posible que se haya eliminado o movido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsimääsi ei löytynyt. Se on ehkä poistettu tai siirretty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de trouver ce que vous cherchiez. Ce contenu a peut-être été supprimé ou déplacé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nismo pronašli ono što tražite. Možda je uklonjeno ili premješteno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non abbiamo trovato quello che cercavi. Potrebbe essere stato rimosso o spostato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お探しのものが見つかりませんでした。削除または移動された可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "찾으려는 항목을 찾을 수 없어요. 삭제되었거나 이동되었을 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi fant ikke det du lette etter. Det kan ha blitt fjernet eller flyttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We kunnen niet vinden wat je zocht. Het is misschien verwijderd of verplaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się znaleźć tego, czego szukasz. Mogło zostać usunięte lub przeniesione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível encontrar o que você procurava. Talvez tenha sido removido ou movido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось найти то, что вы искали. Возможно, это было удалено или перемещено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunde inte hitta det du letade efter. Det kan ha tagits bort eller flyttats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aradığınız içerik bulunamadı. Kaldırılmış veya taşınmış olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося знайти те, що ви шукали. Можливо, його видалено або переміщено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到你要查找的内容。它可能已被移除或移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到你要的內容。它可能已被移除或移動。"
          }
        }
      }
    },
