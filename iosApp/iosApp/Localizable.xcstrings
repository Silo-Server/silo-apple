    "companion.offerSigninBody" : {
      "comment" : "Phone/tablet body text of the offer to sign in a nearby TV that is on its sign-in screen. {device}: the TV name, as claimed by the TV. Apple (iPhone, iPad): same body on the nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقول تلفزيون قريب يُدعى «%1$@» إنه على شاشة تسجيل الدخول. ستتحقق من رمزه قبل الموافقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телевизор наблизо с име „%1$@“ съобщава, че е на екрана си за вход. Ще проверите кода му, преди да одобрите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una TV propera anomenada «%1$@» diu que és a la pantalla d’inici de sessió. Comprovaràs el seu codi abans d’aprovar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Televize poblíž s názvem „%1$@“ hlásí, že je na přihlašovací obrazovce. Před schválením zkontrolujete její kód."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et tv i nærheden med navnet ”%1$@” siger, at det er på sin loginskærm. Du tjekker dets kode, før du godkender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fernseher in der Nähe namens „%1$@“ meldet, dass er auf seinem Anmeldebildschirm ist. Du prüfst seinen Code, bevor du bestätigst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια κοντινή τηλεόραση με το όνομα «%1$@» αναφέρει ότι βρίσκεται στην οθόνη σύνδεσης. Θα ελέγξετε τον κωδικό της πριν από την έγκριση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV nearby named “%1$@” says it's on its sign-in screen. You'll check its code before approving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una TV cercana llamada “%1$@” indica que está en su pantalla de inicio de sesión. Comprobarás su código antes de aprobar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
