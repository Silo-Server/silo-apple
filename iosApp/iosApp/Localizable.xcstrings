    "watchParty.hero.pickCaption" : {
      "comment" : "Roku: caption under the host's 'pick something' headline in the lobby. Tells the host friends can already join with the code. Apple (iPhone, iPad, Apple TV): same caption in the lobby. Android phone and TV Watch Party lobby: same line under the host's heading.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للأصدقاء الانضمام الآن بالرمز. سيرون اختيارك فور أن تختار."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приятелите ви вече могат да се присъединят с кода. Ще видят избора ви веднага щом изберете."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els amics ja poden unir-se amb el codi. Veuran la teva tria tan bon punt triïs."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přátelé se už mohou připojit pomocí kódu. Váš výběr uvidí hned, jak ho provedete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venner kan deltage nu med koden. De ser dit valg, i samme øjeblik du vælger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freunde können jetzt mit dem Code beitreten. Sie sehen deine Wahl, sobald du dich entscheidest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φίλοι σας μπορούν να συμμετάσχουν ήδη με τον κωδικό. Θα δουν την επιλογή σας μόλις την κάνετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Friends can join now with the code. They'll see your pick the moment you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quienes tengan el código ya pueden unirse. Verán tu elección en cuanto la hagas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sõbrad saavad koodiga juba liituda. Nad näevad teie valikut kohe, kui selle teete."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ystävät voivat liittyä jo nyt koodilla. He näkevät valintasi heti, kun teet sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos amis peuvent rejoindre dès maintenant avec le code. Ils verront votre choix dès que vous l’aurez fait."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חברים יכולים להצטרף כבר עכשיו עם הקוד. הבחירה שלך תוצג להם ברגע שהיא תתבצע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोस्त अभी कोड से शामिल हो सकते हैं। आपके चुनते ही उन्हें आपकी पसंद दिख जाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijatelji se već sad mogu pridružiti pomoću koda. Vaš će odabir vidjeti čim ga napravite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ismerősök már most csatlakozhatnak a kóddal. Amint választ, ők is azonnal látják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teman bisa bergabung sekarang dengan kode. Mereka akan melihat pilihan Anda begitu Anda memilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi ha il codice può già partecipare. Vedrà la tua scelta non appena la farai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友だちはコードを使って今すぐ参加できます。選択するとすぐに、友だちにも表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구들이 지금 코드로 참여할 수 있어요. 선택하는 즉시 친구들에게 표시돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draugai jau gali prisijungti su kodu. Jūsų pasirinkimą jie pamatys tą pačią akimirką."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draugi jau tagad var pievienoties ar kodu. Viņi redzēs jūsu izvēli, tiklīdz to izdarīsiet."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakan boleh menyertai sekarang dengan kod. Mereka akan melihat pilihan anda sebaik sahaja anda memilih."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venner kan bli med nå med koden. De ser valget ditt så snart du velger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrienden kunnen nu al deelnemen met de code. Ze zien je keuze zodra je kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajomi mogą już dołączyć za pomocą kodu. Zobaczą twój wybór od razu, gdy go dokonasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus amigos já podem entrar com o código. Eles verão sua escolha assim que você decidir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os amigos já podem entrar com o código. Vão ver a sua escolha assim que a fizer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prietenii se pot alătura acum cu codul. Vor vedea alegerea dvs. imediat ce o faceți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Друзья уже могут присоединиться по коду. Они увидят ваш выбор сразу, как только вы его сделаете."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priatelia sa môžu pomocou kódu pripojiť už teraz. Váš výber uvidia hneď, ako vyberiete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijatelji se lahko s kodo pridružijo že zdaj. Vašo izbiro bodo videli takoj, ko se odločite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vänner kan gå med redan nu med koden. De ser ditt val så fort du väljer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อน ๆ เข้าร่วมด้วยรหัสได้แล้วตอนนี้ และจะเห็นเรื่องที่คุณเลือกทันทีที่คุณเลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkadaşlarınız kodla şimdi katılabilir. Seçim yaptığınız anda seçiminizi görecekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Друзі вже можуть приєднатися за кодом. Вони побачать ваш вибір, щойно ви його зробите."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn bè có thể tham gia ngay bằng mã. Họ sẽ thấy lựa chọn của bạn ngay khi bạn chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友现在就可以用代码加入。你一选好，他们就能看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友現在就能用代碼加入。你一選好，大家就會立即看到。"
          }
        }
      }
    },
    "watchParty.hero.voteCaption.guest" : {
      "comment" : "Roku: caption in the voting lobby shown to guests. {host}: the host's display name. Apple (iPhone, iPad, Apple TV): same caption in the voting lobby. Android phone and TV Watch Party lobby: same line under the voting heading for a guest. 1: the host's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على عنوان للتصويت. سيبدأ %1$@ العنوان الفائز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете заглавие, за да гласувате. %1$@ пуска победителя."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un títol per votar. %1$@ inicia el guanyador."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte titul a hlasujte. Vítěze spustí hostitel %1$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en titel for at stemme. %1$@ starter vinderen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Titel, um abzustimmen. %1$@ startet den Gewinner."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε έναν τίτλο για να ψηφίσετε. Ο οικοδεσπότης %1$@ ξεκινά τον τίτλο που κερδίζει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a title to vote. %1$@ starts the winner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un título para votar. %1$@ inicia el más votado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hääletamiseks puudutage pealkirja. %1$@ käivitab võitja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänestä napauttamalla nimikettä. %1$@ aloittaa voittajan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un titre pour voter. %1$@ lance le titre gagnant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להקיש על פריט כדי להצביע. המארח %1$@ יפעיל את הזוכה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वोट करने के लिए कोई टाइटल चुनें। जीतने वाला टाइटल %1$@ की ओर से शुरू होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
