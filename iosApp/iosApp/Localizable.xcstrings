    "remote.error.pairingRefused" : {
      "comment" : "Apple iOS: Remote Control error when a paired Roku refuses the phone's pairing key. Keep \"Connect a Phone\" as the Roku's menu item is named.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يقبل التلفزيون إقران جهاز iPhone هذا. على التلفزيون، افتح «توصيل هاتف» في Silo وامسح رمزه مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Televize nepřijala spárování tohoto iPhonu. Na televizi otevřete v aplikaci Silo položku Připojit telefon a znovu naskenujte její kód."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tv’et accepterede ikke denne iPhones parring. Åbn Forbind telefon i Silo på tv’et, og scan koden igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher hat die Kopplung dieses iPhones nicht akzeptiert. Öffne auf dem Fernseher in Silo „Smartphone verbinden“ und scanne den Code erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The TV didn't accept this iPhone's pairing. On the TV, open Connect a Phone in Silo and scan its code again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV no aceptó la vinculación de este iPhone. En la TV, abre Conectar un teléfono en Silo y vuelve a escanear su código."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tv ei hyväksynyt tämän iPhonen laiteparia. Avaa tv:n Silossa Yhdistä puhelin ja skannaa sen koodi uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV n’a pas accepté l’association de cet iPhone. Sur la TV, ouvrez Connecter un téléphone dans Silo et scannez de nouveau son code."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV nije prihvatio uparivanje ovog iPhonea. Na TV-u u aplikaciji Silo otvorite „Poveži telefon“ i ponovno skenirajte kod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV non ha accettato l’abbinamento di questo iPhone. Sulla TV, apri “Collega un telefono” in Silo e scansiona di nuovo il codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テレビがこのiPhoneのペアリングを受け付けませんでした。テレビのSiloで「スマートフォンを接続」を開き、コードをもう一度スキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV가 이 iPhone의 페어링을 수락하지 않았어요. TV의 Silo에서 휴대폰 연결을 열고 코드를 다시 스캔하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV-en godtok ikke sammenkoblingen med denne iPhonen. Åpne Koble til telefon i Silo på TV-en, og skann koden på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tv heeft de koppeling met deze iPhone niet geaccepteerd. Open op de tv Telefoon verbinden in Silo en scan de code opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telewizor odrzucił parowanie z tym iPhone’em. Na telewizorze otwórz „Połącz telefon” w aplikacji Silo i ponownie zeskanuj wyświetlony kod."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV não aceitou o pareamento deste iPhone. Na TV, abra Conectar um celular no Silo e escaneie o código novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телевизор не принял привязку этого iPhone. На телевизоре откройте «Подключить телефон» в Silo и снова отсканируйте код."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tv:n godkände inte parkopplingen med den här iPhonen. Öppna Anslut en telefon i Silo på tv:n och skanna koden igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV bu iPhone’un eşlemesini kabul etmedi. TV’de Silo’da Telefon bağla’yı açın ve kodu yeniden tarayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телевізор не прийняв прив’язку цього iPhone. На телевізорі відкрийте «Під’єднати телефон» у Silo і знову відскануйте код."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电视未接受此iPhone的配对。请在电视上打开Silo中的“连接手机”，然后重新扫描其代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電視未接受這支 iPhone 的配對。請在電視上的 Silo 中開啟「連接手機」，然後再次掃描代碼。"
          }
        }
      }
    },
