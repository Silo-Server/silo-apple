          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu içerik profilinizde kullanılamıyor. Herkesin izleyebilmesi için başka bir şey seçin."
          }
        },
        "uk" : {
