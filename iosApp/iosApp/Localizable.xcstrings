        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la tua password di Silo per confermare. Così colleghi l’account %1$@ a cui appartiene questo dispositivo. Potrai poi accedere con %1$@ o con la password. L’accesso con %1$@ funziona solo quando apri questo server al suo indirizzo %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
