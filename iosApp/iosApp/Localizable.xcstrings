    "settings.quality.footerOriginal" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: footer under Resolution when it is set to Auto. Android phone and TV Settings > Playback: the same footer, under the Resolution and Maximum Bitrate pickers.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُشغّل الملف الأصلي متى استطاع جهازك واتصالك التعامل معه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
