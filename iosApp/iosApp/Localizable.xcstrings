          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы подключить провайдера %1$@, откройте этот сервер по его адресу в сети %1$@."
          }
        },
        "sk" : {
          "stringUnit" : {
