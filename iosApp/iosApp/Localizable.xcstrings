            "state" : "translated",
            "value" : "%1$@ Puteți adăuga serverul și manual, folosind adresa sa publică."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Вы также можете добавить сервер вручную по его публичному адресу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Server môžete pridať aj manuálne pomocou jeho verejnej adresy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Strežnik lahko dodate tudi ročno z njegovim javnim naslovom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Du kan också lägga till servern manuellt med dess offentliga adress."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ คุณยังเพิ่มเซิร์ฟเวอร์ด้วยตนเองโดยใช้ที่อยู่สาธารณะได้ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Sunucuyu genel adresiyle elle de ekleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Також можна додати сервер вручну за його публічною адресою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Bạn cũng có thể thêm máy chủ theo cách thủ công bằng địa chỉ công khai của máy chủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@你也可以使用服务器的公网地址手动添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@你也可以用伺服器的公開位址手動新增伺服器。"
          }
        }
      }
    },
