    "detail.facts.author" : {
      "comment" : "Apple iOS and tvOS: row label in an audiobook page's Details section for its author or authors. {count}: how many authors are listed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
