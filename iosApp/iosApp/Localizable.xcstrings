    "library.error.someShelves" : {
      "comment" : "Notice above a library's Recommended rows when some rows only partly loaded for a Movies or Series view (Android phone and Apple iOS). Library is the name of the tab with every title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل بعض الرفوف بالكامل. أعد المحاولة أو افتح المكتبة لتصفح كل العناوين."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé řádky se nepodařilo načíst celé. Zkuste to znovu nebo otevřete kartu Knihovna a procházejte všechny tituly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle hylder kunne ikke indlæses helt. Prøv igen, eller åbn Bibliotek for at gennemse alle titler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Reihen konnten nicht vollständig geladen werden. Versuche es erneut oder öffne Mediathek, um alle Titel zu durchsuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some shelves could not be fully loaded. Retry or open Library to browse all titles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas filas no se pudieron cargar por completo. Vuelve a intentarlo o abre Biblioteca para explorar todos los títulos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joitakin hyllyjä ei voitu ladata kokonaan. Yritä uudelleen tai selaa kaikkia nimikkeitä avaamalla Kirjasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines rangées n’ont pas pu être entièrement chargées. Réessayez ou ouvrez Bibliothèque pour parcourir tous les titres."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neki retci nisu se mogli potpuno učitati. Pokušajte ponovno ili otvorite Medijateka za pregled svih naslova."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune righe non sono state caricate del tutto. Riprova o apri Libreria per sfogliare tutti i titoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の行を完全に読み込めませんでした。再試行するか、ライブラリを開いてすべてのタイトルを表示してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 행을 모두 불러오지 못했어요. 다시 시도하거나 라이브러리 탭을 열어 모든 작품을 둘러보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen hyller kunne ikke lastes helt inn. Prøv igjen, eller åpne Bibliotek for å bla gjennom alle titler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige rijen konden niet volledig worden geladen. Probeer het opnieuw of open Bibliotheek om alle titels te bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się w pełni wczytać niektórych półek. Ponów lub otwórz kartę Biblioteka, aby przeglądać wszystkie tytuły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas fileiras não puderam ser totalmente carregadas. Tente novamente ou abra Biblioteca para ver todos os títulos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые подборки загружены не полностью. Повторите попытку или откройте вкладку «Медиатека», чтобы просмотреть все названия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa hyllor kunde inte läsas in helt. Försök igen eller öppna Bibliotek för att bläddra bland alla titlar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı raflar tam olarak yüklenemedi. Tekrar deneyin veya tüm içeriklere göz atmak için Kitaplık sekmesini açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі ряди не вдалося завантажити повністю. Повторіть спробу або відкрийте «Бібліотека», щоб переглянути всі назви."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分行无法完整加载。请重试，或打开媒体库浏览所有作品。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些列無法完整載入。請重試，或開啟媒體庫分頁瀏覽所有作品。"
          }
        }
      }
    },
