          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดเซิร์ฟเวอร์นี้ที่ที่อยู่ %1$@ เพื่อเชื่อมต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlamak için bu sunucuyu %1$@ adresinden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте цей сервер за його адресою %1$@, щоб під’єднати його."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở máy chủ này qua địa chỉ %1$@ của máy chủ để kết nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
