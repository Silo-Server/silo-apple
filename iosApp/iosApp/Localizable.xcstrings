    "newProfile.unconfirmed.ownerChanged" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): body of the Profile May Have Been Created alert when the server or signed-in account changed before the create finished; the form closes so the user can check the list.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر الخادم أو الحساب أثناء إنشاء الملف الشخصي. تحقق من قائمة الملفات الشخصية قبل المحاولة مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърът или акаунтът се смени, докато се създаваше профилът. Проверете списъка с профили, преди да опитате отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor o el compte han canviat mentre es creava el perfil. Comprova la llista de perfils abans de tornar-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během vytváření profilu se změnil server nebo účet. Než to zkusíte znovu, zkontrolujte seznam profilů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren eller kontoen blev ændret, mens profilen blev oprettet. Tjek profillisten, før du prøver igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server oder das Konto hat sich beim Erstellen des Profils geändert. Prüfe die Profilliste, bevor du es erneut versuchst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής ή ο λογαριασμός άλλαξε κατά τη δημιουργία του προφίλ. Ελέγξτε τη λίστα προφίλ πριν δοκιμάσετε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
