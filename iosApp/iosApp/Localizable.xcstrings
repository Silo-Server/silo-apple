    "settingsManifest.nav.primary_menu.description" : {
      "comment" : "Help text under the nav.primary_menu setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوجهات الظاهرة المرتّبة التي تتشاركها التطبيقات المتشابهة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видимите елементи на менюто в зададения ред, общи за клиентите от един и същ тип."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les destinacions visibles i ordenades que comparteixen els clients del mateix tipus."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seřazené viditelné cíle sdílené klienty stejného typu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synlige destinationer i rækkefølge, som deles af klienter af samme type."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die sichtbaren Ziele in ihrer Reihenfolge, gemeinsam für gleichartige Clients."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ορατοί προορισμοί με τη σειρά τους, κοινοί για τις εφαρμογές του ίδιου τύπου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ordered visible destinations shared by like clients."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los destinos visibles, en orden, compartidos por clientes del mismo tipo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nähtavad sihtkohad kindlas järjekorras, ühised sama tüüpi klientrakendustele."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näkyvät kohteet järjestyksessä, jaettuna samantyyppisten sovellusten kesken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les destinations visibles, dans leur ordre, partagées par les clients du même type."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היעדים הגלויים, לפי הסדר, המשותפים לאפליקציות מאותו סוג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ही तरह के क्लाइंट में दिखने वाले डेस्टिनेशन और उनका क्रम।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poredana vidljiva odredišta koja dijele klijenti iste vrste."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A látható célhelyek sorrendje, amelyen a hasonló kliensek osztoznak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urutan tujuan yang terlihat, dibagikan oleh klien sejenis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le destinazioni visibili, in ordine, condivise dai client dello stesso tipo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ種類のクライアントで共有される、表示する移動先とその順序です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 종류의 클라이언트가 공유하는, 순서가 정해진 표시 메뉴 항목이에요."
