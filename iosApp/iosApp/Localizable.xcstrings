    "calendar.empty.everythingBody" : {
      "comment" : "Calendar screen: empty-state hint for the All filter.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا إصدارات أفلام أو عروض حلقات هذا الأسبوع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento týden nevychází žádný film ani díl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen filmudgivelser eller nye afsnit i denne uge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Woche erscheinen keine Filme und laufen keine Folgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No movie releases or episode airings in this week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay estrenos de películas ni emisiones de episodios esta semana."
