    "settings.profileSettings.resetFooter" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac): footer under the Use Profile Settings button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إزالة الإعدادات التي تم تغييرها على هذا الجهاز، ليعود إلى استخدام إعدادات ملفك الشخصي."
