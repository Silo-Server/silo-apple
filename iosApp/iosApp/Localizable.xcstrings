          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Title art is on on every device signed into this profile. Changing it here changes it everywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El arte del título está activado en todos los dispositivos con sesión iniciada en este perfil. Si lo cambias aquí, cambia en todas partes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
