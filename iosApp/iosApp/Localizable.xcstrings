          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe una cuenta con este correo electrónico. Pide a un administrador que la conecte con el proveedor de inicio de sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compte avec cette adresse e-mail existe déjà. Demandez à un administrateur de le relier au fournisseur de connexion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このメールアドレスのアカウントはすでに存在します。管理者にサインインプロバイダーとの接続を依頼してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe uma conta com este e-mail. Peça a um administrador para conectá-la ao provedor de login."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此电子邮件的账户已存在。请让管理员将其关联到登录提供商。"
          }
        }
      }
    },
