    "settings.subtitles.followsDevicePrefs" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac): footer under the profile's subtitle options while Use Device Settings is on. CC/SDH are caption types.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع اللغة وسلوك العرض والترجمة الإجبارية وتفضيل CC/SDH إعدادات «تسهيلات الاستخدام» على هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Езикът, поведението при показване, задължителните субтитри и предпочитанието за CC/SDH следват настройките за достъпност на това устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’idioma, el comportament de visualització, els subtítols forçats i la preferència de CC/SDH segueixen la configuració d’accessibilitat d’aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazyk, chování zobrazení, vynucené titulky a předvolba CC/SDH se řídí nastavením Zpřístupnění tohoto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprog, visningsadfærd, tvungne undertekster og CC/SDH-præference følger denne enheds indstillinger for Tilgængelighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache, Anzeigeverhalten, erzwungene Untertitel und die CC/SDH-Präferenz folgen den Bedienungshilfen dieses Geräts."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η γλώσσα, η συμπεριφορά εμφάνισης, οι αναγκαστικοί υπότιτλοι και η προτίμηση CC/SDH ακολουθούν τις ρυθμίσεις προσβασιμότητας αυτής της συσκευής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Language, display behavior, forced captions, and CC/SDH preference follow this device's Accessibility settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma, el modo de visualización, los subtítulos forzados y la preferencia de CC/SDH siguen la configuración de Accesibilidad de este dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keel, kuvamise käitumine, sunnitud subtiitrid ja CC/SDH eelistus järgivad selle seadme jaotise „Accessibility“ seadeid."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kieli, näyttötapa, pakotetut tekstitykset ja CC/SDH-valinta noudattavat tämän laitteen Käyttöapu-asetuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue, le comportement d’affichage, les sous-titres forcés et la préférence CC/SDH suivent les paramètres d’accessibilité de cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השפה, אופן ההצגה, הכתוביות הכפויות והעדפת CC/SDH נקבעים לפי הגדרות הנגישות של המכשיר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भाषा, दिखाने का तरीका, फ़ोर्स्ड कैप्शन और CC/SDH की पसंद इस डिवाइस की ऐक्सेसिबिलिटी सेटिंग के अनुसार तय होती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jezik, način prikaza, prisilni titlovi i preferencija CC/SDH slijede postavke pristupačnosti ovog uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nyelv, a megjelenítési mód, a kényszerített feliratok és a CC/SDH-beállítás ennek az eszköznek a Kisegítő lehetőségek beállításait követi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa, perilaku tampilan, teks paksa, dan preferensi CC/SDH mengikuti pengaturan Aksesibilitas perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingua, comportamento di visualizzazione, sottotitoli forzati e preferenza CC/SDH seguono le impostazioni di accessibilità di questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語、表示方法、強制字幕、CC/SDHの設定は、このデバイスのアクセシビリティ設定に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언어, 표시 방식, 강제 자막, CC/SDH 환경설정은 이 기기의 손쉬운 사용 설정을 따라요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalbai, rodymo elgsenai, priverstiniams subtitrams ir CC/SDH nuostatai taikomi šio įrenginio pritaikymo neįgaliesiems nustatymai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valoda, rādīšanas darbība, piespiedu paraksti un CC/SDH preference atbilst šīs ierīces pieejamības iestatījumiem."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa, kelakuan paparan, kapsyen paksa dan keutamaan CC/SDH mengikut tetapan Kebolehcapaian peranti ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Språk, visningsatferd, tvungne undertekster og CC/SDH-preferanse følger tilgjengelighetsinnstillingene på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taal, weergavegedrag, geforceerde ondertitels en CC/SDH-voorkeur volgen de instellingen voor Toegankelijkheid van dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Język, sposób wyświetlania, napisy wymuszone i preferencja CC/SDH są zgodne z ustawieniami w sekcji Dostępność na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O idioma, o comportamento de exibição, as legendas forçadas e a preferência por CC/SDH seguem as configurações de Acessibilidade deste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O idioma, o comportamento de apresentação, as legendas forçadas e a preferência por CC/SDH seguem as definições de Acessibilidade deste dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limba, comportamentul de afișare, subtitrările forțate și preferința CC/SDH urmează setările Accesibilitate ale acestui dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Язык, режим показа, принудительные субтитры и предпочтение CC/SDH определяются настройками универсального доступа этого устройства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazyk, správanie zobrazenia, vynútené titulky a predvoľba CC/SDH sa riadia nastaveniami prístupnosti tohto zariadenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jezik, način prikaza, vsiljeni podnapisi in nastavitev CC/SDH sledijo nastavitvam dostopnosti te naprave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Språk, visningsbeteende, tvingade undertexter och CC/SDH-inställning följer enhetens hjälpmedelsinställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
