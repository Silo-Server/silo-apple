    "settings.subtitles.resetMessageAppleTv" : {
      "comment" : "Apple TV Settings > Subtitles: message of the Reset Appearance dialog while Only on This Apple TV is on.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى استعادة مظهر الترجمة على هذا Apple TV إلى الإعدادات الافتراضية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обликът на субтитрите на това Apple TV ще бъде върнат към стойностите по подразбиране."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això restableix els valors per defecte de l’aparença dels subtítols d’aquest Apple TV."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzhled titulků na tomto Apple TV se vrátí na výchozí hodnoty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette gendanner dette Apple TV’s undertekstudseende til standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die Untertiteldarstellung dieses Apple TV auf die Standardwerte zurückgesetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα γίνει επαναφορά της εμφάνισης υποτίτλων αυτού του Apple TV στις προεπιλογές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This restores this Apple TV's subtitle appearance to the defaults."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto restaura la apariencia de los subtítulos de este Apple TV a los valores predeterminados."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See taastab selle Apple TV subtiitrite välimuse vaikeväärtused."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä palauttaa tämän Apple TV:n tekstityksen ulkoasun oletuksiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action restaure l’apparence par défaut des sous-titres sur cette Apple TV."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו מחזירה את מראה הכתוביות ב-Apple TV הזה לברירת המחדל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे इस Apple TV पर सबटाइटल की दिखावट डिफ़ॉल्ट पर वापस आ जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time se izgled titlova na ovom Apple TV-u vraća na zadane vrijednosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez visszaállítja ennek az Apple TV-nek a feliratmegjelenését az alapértelmezettre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini mengembalikan tampilan subtitel Apple TV ini ke default."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina l’aspetto predefinito dei sottotitoli su questa Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVの字幕の外観をデフォルトに戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple TV의 자막 모양을 기본값으로 복원해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šio „Apple TV“ įrenginio subtitrų išvaizdai bus grąžinti numatytieji nustatymai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tādējādi šīs Apple TV ierīces subtitru izskatam tiks atjaunoti noklusējuma iestatījumi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini memulihkan penampilan sari kata Apple TV ini kepada tetapan lalai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette tilbakestiller undertekstutseendet på denne Apple TV-en til standard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee wordt de ondertitelweergave van deze Apple TV teruggezet naar de standaardwaarden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to przywrócenie domyślnego wyglądu napisów na tym urządzeniu Apple TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso restaura o padrão da aparência das legendas desta Apple TV."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto restaura o aspeto das legendas desta Apple TV para os valores predefinidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se va restabili aspectul implicit al subtitrărilor pe acest Apple TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внешний вид субтитров на этом Apple TV будет сброшен до значений по умолчанию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzhľad titulkov v tomto Apple TV sa vráti na predvolené hodnoty."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem videz podnapisov v tej napravi Apple TV ponastavite na privzete vrednosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta återställer undertexternas utseende på den här Apple TV-enheten till standard."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะคืนค่ารูปลักษณ์คำบรรยายของ Apple TV เครื่องนี้เป็นค่าเริ่มต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, bu Apple TV’nin altyazı görünümünü varsayılanlara geri yükler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вигляд субтитрів на цьому Apple TV буде відновлено до типового."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ đưa giao diện phụ đề của Apple TV này về mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
