            "value" : "Els subtítols amb estil integrat segueixen l’opció El vídeo substitueix l’estil de cada opció de subtítols del dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titulky s vestavěným stylem se řídí volbou „Video přepisuje styl“ u jednotlivých možností titulků zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undertekster med indbygget formatering følger valget Video tilsidesætter stil for hver af enhedens undertekstmuligheder."
