    "tvPairing.consentNote" : {
      "comment" : "Android TV warning on the setup request: allow only if the user started setup on their own device. Apple TV: same warning on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تسمح بذلك إلا إذا بدأت الإعداد على هاتفك أو جهازك اللوحي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass es nur zu, wenn du die Einrichtung auf deinem eigenen Smartphone oder Tablet gestartet hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only allow it if you started setup on your own phone or tablet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permítelo solo si iniciaste la configuración en tu propio teléfono o tableta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’autorisez cette opération que si vous avez lancé la configuration sur votre propre téléphone ou tablette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご自身のスマートフォンまたはタブレットで設定を開始した場合のみ許可してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só permita se você iniciou a configuração no seu próprio celular ou tablet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当你在自己的手机或平板电脑上开始设置时才允许。"
          }
        }
      }
    },
