    "settings.signIn.connectFooter.network" : {
      "comment" : "Apple Settings > Sign-in > Connect (iPhone, iPad, Mac): note under the Silo password when connecting a network provider such as Tailscale, owner unknown; the password stops working afterwards. {provider}: the provider's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل كلمة مرور Silo للتأكيد. يربط هذا حساب %1$@ الذي ينتمي إليه هذا الجهاز. بعد الربط، ستسجّل الدخول باستخدام %1$@ بدلًا من كلمة المرور، وفقط عند فتح هذا الخادم عبر عنوانه في %1$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro potvrzení zadejte heslo k Silo. Tím připojíte účet %1$@, ke kterému toto zařízení patří. Po připojení se budete místo hesla přihlašovat přes %1$@, a to jen tehdy, když tento server otevřete na jeho adrese %1$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast din Silo-adgangskode for at bekræfte. Dette tilknytter den %1$@-konto, som denne enhed hører til. Efter tilknytningen logger du ind med %1$@ i stedet for din adgangskode og kun, når du åbner serveren på dens %1$@-adresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib zur Bestätigung dein Silo-Passwort ein. Dadurch wird das %1$@-Konto verbunden, zu dem dieses Gerät gehört. Nach dem Verbinden meldest du dich mit %1$@ statt mit deinem Passwort an, und zwar nur, wenn du diesen Server über seine %1$@-Adresse öffnest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Silo password to confirm. This connects the %1$@ account this device belongs to. After connecting, you sign in with %1$@ instead of your password, and only when you open this server at its %1$@ address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe tu contraseña de Silo para confirmar. Esto conecta la cuenta de %1$@ a la que pertenece este dispositivo. Después de conectarla, inicias sesión con %1$@ en lugar de tu contraseña, y solo cuando abres este servidor en su dirección de %1$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahvista antamalla Silo-salasanasi. Tämä yhdistää palvelun %1$@ tilin, johon tämä laite kuuluu. Yhdistämisen jälkeen kirjaudut sisään palvelun %1$@ kautta salasanan sijaan ja vain, kun avaat tämän palvelimen sen palvelun %1$@ osoitteessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez votre mot de passe Silo pour confirmer. Cela connecte le compte %1$@ auquel appartient cet appareil. Une fois la liaison effectuée, vous vous connectez avec %1$@ au lieu de votre mot de passe, et uniquement lorsque vous ouvrez ce serveur à son adresse %1$@."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unesite lozinku za Silo radi potvrde. Time se povezuje račun %1$@ kojem pripada ovaj uređaj. Nakon povezivanja prijavljujete se putem usluge %1$@ umjesto lozinkom, i to samo kada ovaj poslužitelj otvorite na njegovoj adresi %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la tua password di Silo per confermare. Così colleghi l’account %1$@ a cui appartiene questo dispositivo. Dopo il collegamento, accedi con %1$@ invece che con la password, e solo quando apri questo server al suo indirizzo %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認のため、Siloのパスワードを入力してください。このデバイスが属する%1$@アカウントを連携します。連携後は、パスワードの代わりに%1$@でサインインします。ただし、サインインできるのはこのサーバーを%1$@のアドレスで開いた場合のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인을 위해 Silo 비밀번호를 입력하세요. 이 기기가 속한 %1$@ 계정이 연결돼요. 연결하면 비밀번호 대신 %1$@(으)로 로그인하며, 이 서버를 %1$@ 주소로 열 때만 로그인할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn Silo-passordet ditt for å bekrefte. Dette kobler til %1$@-kontoen som denne enheten tilhører. Etter tilkoblingen logger du på med %1$@ i stedet for passordet ditt, og bare når du åpner denne serveren på %1$@-adressen dens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer je Silo-wachtwoord in om te bevestigen. Hiermee koppel je het %1$@-account waartoe dit apparaat behoort. Na het koppelen log je in met %1$@ in plaats van met je wachtwoord, en alleen wanneer je deze server opent via het %1$@-adres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz hasło Silo, aby potwierdzić. Spowoduje to połączenie konta %1$@, do którego należy to urządzenie. Po połączeniu będziesz logować się przez %1$@ zamiast hasła i tylko wtedy, gdy otworzysz ten serwer pod adresem %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite sua senha do Silo para confirmar. Isso conecta a conta de %1$@ à qual este dispositivo pertence. Depois de conectar, você entra com %1$@ em vez da sua senha, e somente quando abrir este servidor pelo endereço de %1$@ dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для подтверждения введите пароль Silo. Будет подключён аккаунт %1$@, к которому относится это устройство. После подключения вы будете входить через %1$@, а не по паролю, и только если открываете этот сервер по его адресу %1$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange ditt Silo-lösenord för att bekräfta. Detta ansluter kontot hos %1$@ som den här enheten tillhör. När du har anslutit loggar du in med %1$@ i stället för ditt lösenord, och bara när du öppnar den här servern via dess adress i %1$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğrulamak için Silo parolanızı girin. Bu işlem, bu cihazın ait olduğu %1$@ hesabını bağlar. Bağlandıktan sonra parolanız yerine %1$@ ile oturum açarsınız; bu yalnızca bu sunucuyu %1$@ adresinden açtığınızda çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть пароль Silo для підтвердження. Буде під’єднано обліковий запис %1$@, до якого належить цей пристрій. Після під’єднання ви входитимете через %1$@ замість пароля, і лише тоді, коли відкриваєте цей сервер за його адресою %1$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入你的Silo密码以确认。这将关联此设备所属的%1$@账户。关联后，你将使用%1$@登录，而不是使用密码，且仅在通过%1$@地址打开此服务器时可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入你的 Silo 密碼以確認。這會連結此裝置所屬的 %1$@ 帳號。連結後，你會改用 %1$@ 登入，而不是使用密碼，而且只有在透過 %1$@ 位址開啟此伺服器時才能登入。"
          }
        }
      }
    },
    "settings.signIn.connectFooter.networkKeepsPassword" : {
      "comment" : "Apple Settings > Sign-in > Connect (iPhone, iPad, Mac): note under the Silo password when connecting a network provider such as Tailscale, owner unknown, on a server that keeps the password. {provider}: the provider's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل كلمة مرور Silo للتأكيد. يربط هذا حساب %1$@ الذي ينتمي إليه هذا الجهاز. يمكنك بعد ذلك تسجيل الدخول باستخدام %1$@ أو كلمة المرور. لا يعمل تسجيل الدخول عبر %1$@ إلا عند فتح هذا الخادم عبر عنوانه في %1$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro potvrzení zadejte heslo k Silo. Tím připojíte účet %1$@, ke kterému toto zařízení patří. Poté se můžete přihlašovat přes %1$@ nebo heslem. Přihlášení přes %1$@ funguje jen tehdy, když tento server otevřete na jeho adrese %1$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast din Silo-adgangskode for at bekræfte. Dette tilknytter den %1$@-konto, som denne enhed hører til. Derefter kan du logge ind med %1$@ eller din adgangskode. Login med %1$@ virker kun, når du åbner serveren på dens %1$@-adresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib zur Bestätigung dein Silo-Passwort ein. Dadurch wird das %1$@-Konto verbunden, zu dem dieses Gerät gehört. Danach kannst du dich mit %1$@ oder deinem Passwort anmelden. Die Anmeldung mit %1$@ funktioniert nur, wenn du diesen Server über seine %1$@-Adresse öffnest."
          }
