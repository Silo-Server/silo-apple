    "settings.interface.onlyThisDeviceFooterAppleTv" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac) > Title Pages on Apple TV: footer while Apply to All Devices is off. Apple TV is the product name; keep it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤثر في هذا Apple TV فقط. تحتفظ أجهزتك الأخرى بإعدادها الخاص."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Засяга само това Apple TV. Другите ви устройства запазват своята настройка."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només afecta aquest Apple TV. Els altres dispositius mantenen la seva pròpia opció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí jen pro toto zařízení Apple TV. Vaše ostatní zařízení si ponechají vlastní nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder kun dette Apple TV. Dine andre enheder beholder deres egen indstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt nur für dieses Apple TV. Deine anderen Geräte behalten ihre eigene Einstellung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επηρεάζει μόνο αυτό το Apple TV. Οι άλλες συσκευές σας διατηρούν τη δική τους ρύθμιση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only affects this Apple TV. Your other devices keep their own setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo afecta a este Apple TV. Tus otros dispositivos mantienen su propia configuración."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mõjutab ainult seda Apple TV-d. Teie teised seadmed säilitavad oma seadistuse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koskee vain tätä Apple TV:tä. Muut laitteesi säilyttävät oman asetuksensa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique uniquement à cette Apple TV. Vos autres appareils conservent leur propre paramètre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חל רק על ה-Apple TV הזה. במכשירים האחרים שלך נשמרת ההגדרה שלהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसका असर सिर्फ़ इस Apple TV पर पड़ता है। आपके दूसरे डिवाइस अपनी सेटिंग बनाए रखते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utječe samo na ovaj Apple TV. Vaši ostali uređaji zadržavaju vlastitu postavku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak erre az Apple TV-re vonatkozik. A többi eszköz megtartja a saját beállítását."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya berlaku untuk Apple TV ini. Perangkat Anda yang lain tetap memakai pengaturannya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale solo per questa Apple TV. Gli altri tuoi dispositivi mantengono la propria impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVにのみ適用されます。ほかのデバイスはそれぞれの設定を保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple TV에만 적용돼요. 다른 기기는 각자의 설정을 유지해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taikoma tik šiam „Apple TV“ įrenginiui. Kiti jūsų įrenginiai išlaiko savo nustatymą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiecas tikai uz šo Apple TV ierīci. Citām jūsu ierīcēm ir savs iestatījums."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya mempengaruhi Apple TV ini. Peranti anda yang lain mengekalkan tetapan masing-masing."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjelder bare denne Apple TV-en. De andre enhetene dine beholder sin egen innstilling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt alleen voor deze Apple TV. Je andere apparaten houden hun eigen instelling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy tylko tego Apple TV. Pozostałe urządzenia zachowują własne ustawienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afeta só esta Apple TV. Seus outros dispositivos mantêm a própria configuração."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só afeta esta Apple TV. Os seus outros dispositivos mantêm a sua própria definição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afectează doar acest Apple TV. Celelalte dispozitive ale dvs. își păstrează propria setare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует только на этом Apple TV. На других ваших устройствах сохраняются их собственные настройки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí len pre toto zariadenie Apple TV. Vaše ostatné zariadenia si ponechajú vlastné nastavenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vpliva samo na ta Apple TV. Druge vaše naprave ohranijo svojo nastavitev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller bara denna Apple TV. Dina andra enheter behåller sin egen inställning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีผลกับ Apple TV เครื่องนี้เท่านั้น อุปกรณ์อื่นของคุณจะใช้การตั้งค่าของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu Apple TV’yi etkiler. Diğer cihazlarınız kendi ayarlarını korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Діє лише на цьому Apple TV. Ваші інші пристрої зберігають власне налаштування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ ảnh hưởng đến Apple TV này. Các thiết bị khác của bạn giữ cài đặt riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅影响这台Apple TV。你的其他设备保留各自的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會影響這台 Apple TV。你的其他裝置會保留各自的設定。"
          }
        }
      }
    },
