    "signIn.error.networkEmailInUse" : {
      "comment" : "Android phone sign-in screen: error after Continue as … when an account with the same email already exists but isn't connected to the network provider. 1: the network provider's name, such as Tailscale. Settings → Sign-in names the app's own Settings screens. Apple (iPhone, iPad, Mac, Apple TV): same network sign-in error.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد حساب ببريدك الإلكتروني بالفعل. سجّل الدخول بكلمة المرور، ثم اربط %1$@ من الإعدادات ← تسجيل الدخول."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вече има акаунт с вашия имейл. Влезте с паролата си, след което свържете доставчика %1$@ в Настройки → Вход."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja existeix un compte amb el teu correu electrònic. Inicia la sessió amb la contrasenya i després connecta %1$@ a Configuració → Inici de sessió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účet s vaším e-mailem už existuje. Přihlaste se heslem a pak připojte poskytovatele %1$@ v Nastavení → Přihlášení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der findes allerede en konto med din e-mail. Log ind med din adgangskode, og forbind derefter %1$@ under Indstillinger → Login."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt bereits ein Konto mit deiner E-Mail-Adresse. Melde dich mit deinem Passwort an und verbinde dann %1$@ unter Einstellungen → Anmeldung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπάρχει ήδη λογαριασμός με το email σας. Συνδεθείτε με τον κωδικό πρόσβασής σας και, στη συνέχεια, συνδέστε τον πάροχο %1$@ στις Ρυθμίσεις → Μέθοδοι σύνδεσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An account with your email already exists. Sign in with your password, then connect %1$@ in Settings → Sign-in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe una cuenta con tu correo electrónico. Inicia sesión con tu contraseña y luego conecta %1$@ en Configuración → Inicio de sesión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie e-posti aadressiga konto on juba olemas. Logige sisse parooliga ja siduge seejärel teenus %1$@ jaotises „Seaded → Sisselogimine“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sähköpostiosoitteellasi on jo tili. Kirjaudu sisään salasanalla ja yhdistä sitten %1$@ kohdassa Asetukset → Kirjautuminen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compte avec votre adresse e-mail existe déjà. Connectez-vous avec votre mot de passe, puis reliez %1$@ dans Paramètres → Connexion."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבר קיים חשבון עם כתובת האימייל שלך. יש להתחבר עם הסיסמה ואז לחבר את %1$@ בהגדרות ← התחברות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके ईमेल वाला खाता पहले से मौजूद है। अपने पासवर्ड से साइन इन करें, फिर सेटिंग → साइन-इन में %1$@ कनेक्ट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Račun s vašom e-adresom već postoji. Prijavite se lozinkom, a zatim povežite %1$@ u odjeljku Postavke → Prijava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Már létezik fiók az Ön e-mail-címével. Jelentkezzen be a jelszavával, majd a Beállítások → Bejelentkezés menüpontban kapcsolja hozzá a(z) %1$@ szolgáltatót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun dengan email Anda sudah ada. Masuk dengan kata sandi Anda, lalu hubungkan %1$@ di Pengaturan → Masuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già un account con la tua email. Accedi con la password, poi collega %1$@ in Impostazioni → Accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じメールアドレスのアカウントがすでに存在します。パスワードでサインインしてから、設定 → サインインで%1$@を接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 이메일을 사용하는 계정이 이미 있어요. 비밀번호로 로그인한 다음 설정 → 로그인에서 %1$@ 제공자를 연결하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paskyra su jūsų el. pašto adresu jau yra. Prisijunkite su slaptažodžiu, tada skiltyje „Nustatymai“ → „Prisijungimas“ susiekite „%1$@“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konts ar jūsu e-pasta adresi jau pastāv. Pierakstieties ar paroli un pēc tam pievienojiet %1$@ sadaļā „Iestatījumi → Pierakstīšanās”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akaun dengan e-mel anda sudah wujud. Log masuk dengan kata laluan anda, kemudian sambungkan %1$@ dalam Tetapan → Log masuk."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes allerede en konto med e-postadressen din. Logg på med passordet ditt, og koble deretter til %1$@ i Innstillinger → Pålogging."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bestaat al een account met je e-mailadres. Log in met je wachtwoord en koppel daarna %1$@ in Instellingen → Inloggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto z twoim adresem e-mail już istnieje. Zaloguj się hasłem, a potem połącz usługę %1$@ w sekcji Ustawienia → Logowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe uma conta com seu e-mail. Entre com sua senha e depois conecte %1$@ em Configurações → Login."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe uma conta com o seu email. Inicie sessão com a sua palavra-passe e depois ligue %1$@ em Definições → Início de sessão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Există deja un cont cu adresa dvs. de e-mail. Conectați-vă cu parola, apoi conectați %1$@ din Setări → Conectare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт с вашим адресом эл. почты уже существует. Войдите с паролем, затем подключите %1$@ в разделе «Настройки» → «Вход»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účet s vaším e-mailom už existuje. Prihláste sa heslom a potom pripojte poskytovateľa %1$@ v časti Nastavenia → Prihlásenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Račun z vašim e-poštnim naslovom že obstaja. Prijavite se z geslom, nato povežite ponudnika %1$@ v razdelku Nastavitve → Prijava."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns redan ett konto med din e-postadress. Logga in med ditt lösenord och koppla sedan %1$@ under Inställningar → Inloggning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีบัญชีที่ใช้อีเมลของคุณอยู่แล้ว ลงชื่อเข้าใช้ด้วยรหัสผ่าน แล้วเชื่อมต่อ %1$@ ในการตั้งค่า → การลงชื่อเข้าใช้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-posta adresinizle kayıtlı bir hesap zaten var. Parolanızla oturum açın, ardından Ayarlar → Oturum açma ekranında %1$@ sağlayıcısını bağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обліковий запис із вашою електронною адресою вже існує. Увійдіть за допомогою пароля, а потім під’єднайте %1$@ у розділі «Налаштування → Вхід»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã có tài khoản dùng email của bạn. Đăng nhập bằng mật khẩu, rồi kết nối %1$@ trong Cài đặt → Đăng nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你的电子邮件的账户已存在。请使用密码登录，然后在“设置→登录”中关联%1$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有帳號使用你的電子郵件。請使用密碼登入，然後在「設定 → 登入」中連結 %1$@。"
          }
        }
      }
    },
    "signIn.error.noUsableMethod" : {
      "comment" : "Android phone sign-in screen: error when the server lists no password sign-in and no provider this app supports. Apple (iPhone, iPad, Mac): same error on the sign-in screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوفّر هذا الخادم طريقة تسجيل دخول يمكن لهذا التطبيق استخدامها. سجّل الدخول عبر الويب، أو اسأل مسؤول الخادم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този сървър не предлага начин за вход, който това приложение може да използва. Влезте през уеб или попитайте администратора на сървъра."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest servidor no ofereix cap mètode d’inici de sessió que aquesta aplicació pugui utilitzar. Inicia la sessió al web o consulta l’administrador del servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server nenabízí způsob přihlášení, který by tato aplikace mohla použít. Přihlaste se na webu nebo se obraťte na správce serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne server tilbyder ingen loginmetode, som denne app kan bruge. Log ind på webbet, eller spørg serverens administrator."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server bietet keine Anmeldung an, die diese App verwenden kann. Melde dich im Web an oder wende dich an den Admin des Servers."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο διακομιστής δεν προσφέρει μέθοδο σύνδεσης που να μπορεί να χρησιμοποιήσει αυτή η εφαρμογή. Συνδεθείτε μέσω του προγράμματος περιήγησης ή ρωτήστε τον διαχειριστή του διακομιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server doesn't offer a sign-in this app can use. Sign in on the web, or ask the server's admin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no ofrece ningún inicio de sesión que esta app pueda usar. Inicia sesión en la web o pregunta al administrador del servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See server ei paku sisselogimisviisi, mida see rakendus saaks kasutada. Logige sisse veebis või pöörduge serveri administraatori poole."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä palvelin ei tarjoa kirjautumistapaa, jota tämä sovellus voi käyttää. Kirjaudu sisään verkossa tai kysy palvelimen ylläpitäjältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
