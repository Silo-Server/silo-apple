    "detail.trailerFetch.cooldown" : {
      "comment" : "Apple iOS and tvOS: status on a title page after Find Trailers when the server already looked for this title's trailers recently and won't look again yet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم البحث عن الإعلانات الترويجية مؤخرًا"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трейлърите са проверени наскоро"
          }
