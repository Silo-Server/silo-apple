    "diagnostics.send.debugOffFooterTv" : {
      "comment" : "Note under Send Diagnostics Now in Diagnostics settings when Debug Logging is off. Shown as a footer in the Diagnostics settings pane on Android TV, and on Apple (iPhone, iPad, Apple TV).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجل تصحيح الأخطاء معطّل. يحتوي هذا التقرير على آخر بضع دقائق من السجلات الأساسية فقط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опцията „Дневник за отстраняване на грешки“ е изключена. Този отчет съдържа само основните записи от последните няколко минути."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registre de depuració està desactivat. Aquest informe només conté els registres bàsics dels últims minuts."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladicí protokolování je vypnuto. Toto hlášení obsahuje jen základní protokoly z posledních několika minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fejlfindingslogning er slået fra. Denne rapport indeholder kun grundlæggende logs fra de seneste få minutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Debug-Protokollierung ist aus. Dieser Bericht enthält nur die einfachen Protokolle der letzten paar Minuten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η καταγραφή εντοπισμού σφαλμάτων είναι απενεργοποιημένη. Αυτή η αναφορά περιέχει μόνο τα βασικά αρχεία καταγραφής των τελευταίων λίγων λεπτών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug logging is off. This report contains only the last few minutes of basic logs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de depuración está desactivado. Este informe solo contiene los últimos minutos de registros básicos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silumislogimine on väljas. See aruanne sisaldab ainult viimase paari minuti põhilogisid."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vianetsintälokit ovat pois päältä. Tämä raportti sisältää vain muutaman viime minuutin peruslokit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La journalisation de débogage est désactivée. Ce rapport ne contient que les dernières minutes des journaux de base."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרישום לניפוי באגים כבוי. הדוח הזה כולל רק את הדקות האחרונות של היומנים הבסיסיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डीबग लॉगिंग बंद है। इस रिपोर्ट में सिर्फ़ पिछले कुछ मिनटों के बेसिक लॉग हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisivanje za otklanjanje pogrešaka je isključeno. Ovo izvješće sadrži samo osnovne zapisnike iz posljednjih nekoliko minuta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hibakeresési naplózás ki van kapcsolva. Ez a jelentés csak az utolsó néhány perc alapszintű naplóit tartalmazza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log debug nonaktif. Laporan ini hanya berisi log dasar dari beberapa menit terakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il log di debug è disattivato. Questo report contiene solo gli ultimi minuti dei log di base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバッグログはオフです。このレポートには直近数分間の基本ログのみが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디버그 로깅이 꺼져 있어요. 이 보고서에는 최근 몇 분간의 기본 로그만 포함돼요."
          }
        },
