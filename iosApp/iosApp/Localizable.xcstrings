        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录%1$@时出错。请在你的手机或平板电脑上重试，或手动添加你的服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
