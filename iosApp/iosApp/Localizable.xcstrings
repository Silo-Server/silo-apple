    "setup.advanced.hint" : {
      "comment" : "Android phone server setup screen (first screen with no server): note under Advanced options explaining the Auto protocol and port. Keep 8090 as is. Apple (iPhone, iPad, Mac): same hint under Advanced options.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجرّب الخيار «تلقائي» HTTPS أولًا، ثم HTTP، ثم المنفذ 8090 الخاص بـ Silo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto versucht zuerst HTTPS, dann HTTP, dann den Silo-Port 8090."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto tries HTTPS first, then HTTP, then Silo's port 8090."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Automático prueba primero HTTPS, luego HTTP y, por último, el puerto 8090 de Silo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Auto essaie d’abord HTTPS, puis HTTP, puis le port 8090 de Silo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動では、HTTPS、HTTP、Siloのポート8090の順に試します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Auto tenta primeiro HTTPS, depois HTTP e depois a porta 8090 do Silo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动模式会先尝试HTTPS，然后尝试HTTP，最后尝试Silo的端口8090。"
          }
        }
      }
    },
