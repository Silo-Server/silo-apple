    "companion.confirmCheck" : {
      "comment" : "Phone/tablet prompt above a verification code, asking the user to compare it with the TV. {device}: the TV or Roku name. Apple (iPhone, iPad): same prompt on the nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من أن %1$@ يعرض"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверете дали устройството %1$@ показва"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprova que el dispositiu %1$@ mostri"
          }
