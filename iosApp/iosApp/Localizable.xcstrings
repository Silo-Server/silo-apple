    "settings.playback.atmosFooter" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: sentence in the Streaming footer about the TrueHD Atmos and DTS:X switch. TrueHD Atmos and DTS:X are audio format names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تفعيل TrueHD Atmos وDTS:X، تحتفظ هذه المسارات بقنوات الارتفاع لكنها تُشغَّل كصوت مضغوط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn TrueHD Atmos und DTS:X eingeschaltet ist, behalten diese Spuren ihre Höhenkanäle, werden aber als komprimierter Ton wiedergegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With TrueHD Atmos and DTS:X on, those tracks keep their height channels but play as compressed audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con TrueHD Atmos y DTS:X activado, esas pistas conservan sus canales de altura, pero se reproducen como audio comprimido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec TrueHD Atmos et DTS:X activé, ces pistes conservent leurs canaux de hauteur mais sont lues en audio compressé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TrueHD AtmosとDTS:Xをオンにすると、これらのトラックはハイトチャンネルを保持したまま、圧縮オーディオとして再生されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com TrueHD Atmos e DTS:X ativado, essas faixas mantêm os canais de altura, mas são reproduzidas como áudio compactado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
