        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noudattaa tämän laitteen tekstityskieltä, näyttötapaa, CC/SDH-valintaa, fonttia, värejä, peittävyyttä, reunoja, kokoa ja tekstitysikkunaa kohdasta Käyttöapu → Tekstitys ja kuvatekstit."
