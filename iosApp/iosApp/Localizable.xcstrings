            "value" : "Dotyczy tylko tego komputera Mac. Pozostałe urządzenia zachowują własne ustawienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afeta só este Mac. Seus outros dispositivos mantêm a própria configuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует только на этом Mac. На других ваших устройствах сохраняются их собственные настройки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller bara denna Mac. Dina andra enheter behåller sin egen inställning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu Mac’i etkiler. Diğer cihazlarınız kendi ayarlarını korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Діє лише на цьому Mac. Ваші інші пристрої зберігають власне налаштування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅影响这台Mac。你的其他设备保留各自的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會影響這台 Mac。你的其他裝置會保留各自的設定。"
          }
        }
      }
    },
    "settings.interface.playThemeMusicSubtitle" : {
      "comment" : "Apple Settings > Interface > Theme Music and Apple TV Settings > General > Theme Music: description of the Play Theme Music switch (VoiceOver hint on iPhone, iPad and Apple TV; shown under the switch on Mac).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل الأغنية الرئيسية للعنوان من مكتبتك أثناء فتح صفحته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrávat ústřední melodii titulu z vaší knihovny, dokud je otevřená jeho stránka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil en titels temasang fra dit bibliotek, mens dens side er åben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt die Titelmusik eines Titels aus deiner Mediathek, solange seine Seite geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play a title's theme song from your library while its page is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce el tema musical de un título desde tu biblioteca mientras su página está abierta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistaa kohteen tunnusmusiikin kirjastostasi, kun sen sivu on auki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit le thème musical d’un titre depuis votre bibliothèque tant que sa page est ouverte."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducira tematsku pjesmu naslova iz vaše medijateke dok je njegova stranica otvorena."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduci la sigla di un titolo dalla tua libreria mentre la sua pagina è aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作品のページを開いている間、ライブラリにあるテーマ曲を再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작품 페이지가 열려 있는 동안 라이브러리에 있는 테마 음악을 재생해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spill av temasangen til en tittel fra biblioteket ditt mens siden er åpen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel het themanummer van een titel uit je bibliotheek af zolang de pagina open is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarza motyw muzyczny tytułu z twojej biblioteki, gdy jego strona jest otwarta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca a música tema de um título da sua biblioteca enquanto a página dele estiver aberta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводить музыкальную тему из вашей медиатеки, пока открыта страница фильма или сериала."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela en titels ledmotiv från ditt bibliotek medan dess sida är öppen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayfası açıkken bir içeriğin tema müziğini kitaplığınızdan çalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відтворювати музичну тему твору з вашої бібліотеки, поки відкрита його сторінка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开作品页面时，播放媒体库中该作品的主题曲。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟作品頁面時，從你的媒體庫播放該作品的主題曲。"
          }
        }
      }
    },
    "settings.interface.posterSizeSyncsDesktop" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac): explanation under Cards & Posters on computers (Mac): the poster size is shared with the profile's other devices of the same kind.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم مزامنة حجم الملصقات مع أجهزة الكمبيوتر المماثلة الأخرى على هذا الملف الشخصي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velikost plakátů se synchronizuje s ostatními počítači v tomto profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plakatstørrelsen synkroniseres med andre computere på denne profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Postergröße wird mit anderen Desktop-Geräten in diesem Profil synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poster size syncs with other desktop-like devices on this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tamaño de los pósteres se sincroniza con otros dispositivos de escritorio de este perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Julisteiden koko synkronoidaan tämän profiilin muiden tietokoneen kaltaisten laitteiden kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La taille des affiches est synchronisée avec les autres ordinateurs de ce profil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veličina postera sinkronizira se s ostalim računalima na ovom profilu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dimensione dei poster si sincronizza con gli altri dispositivi di tipo desktop in questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポスターのサイズは、このプロフィールのほかのデスクトップ系デバイスと同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포스터 크기는 이 프로필의 다른 컴퓨터와 동기화돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plakatstørrelsen synkroniseres med andre datamaskinlignende enheter på denne profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De postergrootte wordt gesynchroniseerd met andere desktopachtige apparaten op dit profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmiar plakatów synchronizuje się z innymi urządzeniami typu komputer w tym profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tamanho do pôster é sincronizado com outros dispositivos do tipo computador neste perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размер постеров синхронизируется с другими компьютерами в этом профиле."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affischstorleken synkroniseras med andra datorliknande enheter på den här profilen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poster boyutu, bu profildeki diğer masaüstü türü cihazlarla eşitlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розмір постерів синхронізується з іншими настільними пристроями в цьому профілі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海报尺寸会与此个人资料中的其他桌面类设备同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海報大小會與此個人檔案上的其他電腦類裝置同步。"
          }
        }
      }
    },
