    "settings.interface.deviceOverride" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac): notice when this device still has its own card settings from an older version, which win over the settings synced across devices of its kind.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لدى هذا الجهاز إعدادات واجهة قديمة خاصة به تتجاوز مزامنة فئة الأجهزة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zařízení má starší vlastní nastavení rozhraní, které má přednost před synchronizací mezi zařízeními stejného typu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed har ældre enhedsspecifikke indstillinger for brugerfladen, der tilsidesætter synkroniseringen mellem enheder af samme type."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat ältere gerätespezifische Oberflächeneinstellungen, die die Synchronisierung der Gerätefamilie überschreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device has older device-specific interface settings that override family sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tiene una configuración de interfaz propia más antigua que prevalece sobre la sincronización con dispositivos similares."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä laitteella on vanhempia laitekohtaisia käyttöliittymäasetuksia, jotka ohittavat laiteryhmän synkronoinnin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil possède d’anciens paramètres d’interface qui lui sont propres et qui prévalent sur la synchronisation entre appareils du même type."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj uređaj ima starije postavke sučelja specifične za uređaj koje nadjačavaju sinkronizaciju među sličnim uređajima."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo ha impostazioni dell’interfaccia specifiche meno recenti che prevalgono sulla sincronizzazione tra dispositivi dello stesso tipo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスには、同じ種類のデバイス間の同期より優先される、以前のデバイス固有のインターフェース設定があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에는 같은 종류 기기 간 동기화보다 우선하는 이전 기기별 인터페이스 설정이 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enheten har eldre enhetsspesifikke grensesnittinnstillinger som overstyrer synkroniseringen for enhetstypen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat heeft oudere apparaatspecifieke interface-instellingen die voorrang hebben op de synchronisatie met vergelijkbare apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie ma starsze, własne ustawienia interfejsu, które mają pierwszeństwo przed synchronizacją w obrębie rodziny urządzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tem configurações de interface antigas, específicas dele, que se sobrepõem à sincronização da família de dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве остались старые настройки интерфейса, заданные только для него. Они переопределяют синхронизацию между устройствами этого типа."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten har äldre enhetsspecifika gränssnittsinställningar som går före synkroniseringen mellan liknande enheter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazda, aynı türdeki cihazlarla eşitlemeyi geçersiz kılan eski, cihaza özel arayüz ayarları var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На цьому пристрої є старіші власні налаштування інтерфейсу, які мають пріоритет над синхронізацією для пристроїв цього типу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备有旧版的设备专属界面设置，会覆盖同类设备的同步设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置有舊版的裝置專屬介面設定，會覆蓋同類裝置的同步設定。"
          }
        }
      }
    },
    "settings.interface.deviceOverrideFooter" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac): explanation under the button that drops this device's older own card settings. Like-family devices are devices of the same kind (phones, tablets or computers).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسح تجاوز الجهاز يجعل عناصر التحكم أدناه تنطبق على جميع الأجهزة من الفئة نفسها على هذا الملف الشخصي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po vymazání vlastního nastavení zařízení budou ovládací prvky níže platit pro všechna zařízení stejného typu v tomto profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når enhedens egne indstillinger ryddes, gælder indstillingerne nedenfor for alle enheder af samme type på denne profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du die Geräteeinstellungen entfernst, gelten die Optionen unten für alle Geräte derselben Art in diesem Profil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clearing the device override makes the controls below apply to all like-family devices on this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al quitar la configuración propia del dispositivo, los controles de abajo se aplican a todos los dispositivos similares de este perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun laitekohtainen ohitus poistetaan, alla olevat asetukset koskevat kaikkia tämän profiilin samantyyppisiä laitteita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacer les paramètres propres à cet appareil applique les options ci-dessous à tous les appareils du même type sur ce profil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanjanjem postavki uređaja kontrole u nastavku primjenjuju se na sve uređaje iste vrste na ovom profilu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovendo le impostazioni specifiche del dispositivo, i controlli qui sotto si applicano a tutti i dispositivi dello stesso tipo in questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス固有の設定をクリアすると、以下の設定がこのプロフィールの同じ種類のすべてのデバイスに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기별 설정을 지우면 아래 옵션이 이 프로필에서 같은 종류의 모든 기기에 적용돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du fjerner enhetsoverstyringen, gjelder kontrollene nedenfor for alle enheter av samme type på denne profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de apparaatspecifieke instellingen wist, gelden de opties hieronder voor alle vergelijkbare apparaten op dit profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po usunięciu ustawień tego urządzenia poniższe opcje będą obowiązywać na wszystkich urządzeniach tego samego typu w tym profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpar a substituição deste dispositivo faz os controles abaixo se aplicarem a todos os dispositivos da mesma família neste perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если сбросить настройки этого устройства, параметры ниже будут применяться ко всем устройствам этого типа в профиле."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du rensar enhetens egna inställningar gäller reglagen nedan för alla liknande enheter på den här profilen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihaza özel ayarları temizlerseniz aşağıdaki denetimler bu profildeki aynı türdeki tüm cihazlara uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо очистити власні налаштування цього пристрою, наведені нижче параметри застосовуватимуться до всіх пристроїв такого ж типу в цьому профілі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除设备覆盖后，下方的设置将应用到此个人资料中的所有同类设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除裝置專屬設定後，下方的控制項會套用至此個人檔案上所有同類裝置。"
          }
        }
      }
    },
    "settings.interface.loopThemeMusicSubtitle" : {
      "comment" : "Apple Settings > Interface > Theme Music and Apple TV Settings > General > Theme Music: description of the Loop Theme Music switch (VoiceOver hint on iPhone, iPad and Apple TV; shown under the switch on Mac).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كرّر الموسيقى الرئيسية ما دامت الصفحة مفتوحة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opakovat melodii, dokud je stránka otevřená."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentag temaet, så længe siden er åben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederholt die Titelmusik, solange die Seite geöffnet bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat the theme while the page stays open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite el tema mientras la página siga abierta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistaa tunnusmusiikkia uudelleen niin kauan kuin sivu on auki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répète le thème tant que la page reste ouverte."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponavlja temu dok je stranica otvorena."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripeti la sigla finché la pagina resta aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページを開いている間、テーマ曲を繰り返し再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페이지가 열려 있는 동안 테마 음악을 반복해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenta temaet mens siden er åpen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhaal het themanummer zolang de pagina open blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powtarza motyw, dopóki strona jest otwarta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repete a música tema enquanto a página estiver aberta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторять музыкальную тему, пока страница открыта."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upprepa ledmotivet medan sidan är öppen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayfa açık kaldığı sürece tema müziğini tekrarlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторювати тему, поки сторінка відкрита."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "页面保持打开时循环播放主题曲。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頁面開啟期間重複播放主題曲。"
          }
        }
      }
    },
    "settings.interface.onlyThisDeviceFooterAppleTv" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac) > Title Pages on Apple TV: footer while Apply to All Devices is off. Apple TV is the product name; keep it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤثر في هذا Apple TV فقط. تحتفظ أجهزتك الأخرى بإعدادها الخاص."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí jen pro toto zařízení Apple TV. Vaše ostatní zařízení si ponechají vlastní nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder kun dette Apple TV. Dine andre enheder beholder deres egen indstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt nur für dieses Apple TV. Deine anderen Geräte behalten ihre eigene Einstellung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only affects this Apple TV. Your other devices keep their own setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo afecta a este Apple TV. Tus otros dispositivos mantienen su propia configuración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koskee vain tätä Apple TV:tä. Muut laitteesi säilyttävät oman asetuksensa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique uniquement à cette Apple TV. Vos autres appareils conservent leur propre paramètre."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utječe samo na ovaj Apple TV. Vaši ostali uređaji zadržavaju vlastitu postavku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale solo per questa Apple TV. Gli altri tuoi dispositivi mantengono la propria impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVにのみ適用されます。ほかのデバイスはそれぞれの設定を保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple TV에만 적용돼요. 다른 기기는 각자의 설정을 유지해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjelder bare denne Apple TV-en. De andre enhetene dine beholder sin egen innstilling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt alleen voor deze Apple TV. Je andere apparaten houden hun eigen instelling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy tylko tego Apple TV. Pozostałe urządzenia zachowują własne ustawienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afeta só esta Apple TV. Seus outros dispositivos mantêm a própria configuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует только на этом Apple TV. На других ваших устройствах сохраняются их собственные настройки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller bara denna Apple TV. Dina andra enheter behåller sin egen inställning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu Apple TV’yi etkiler. Diğer cihazlarınız kendi ayarlarını korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Діє лише на цьому Apple TV. Ваші інші пристрої зберігають власне налаштування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅影响这台Apple TV。你的其他设备保留各自的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會影響這台 Apple TV。你的其他裝置會保留各自的設定。"
          }
        }
      }
    },
