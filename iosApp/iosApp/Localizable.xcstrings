    "player.notice.qualityChangeBusy" : {
      "comment" : "Apple iOS/tvOS/macOS: error under the quality choices in the player settings when the player could not start the quality change.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تغيير الجودة الآن. حاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В момента не можа да се смени качеството. Опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ara mateix no s’ha pogut canviar la qualitat. Torna-ho a provar."
