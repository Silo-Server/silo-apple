    "settings.connection.notSaved" : {
      "comment" : "Roku error shown when a speed test ran but the server did not store the result. Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: shown when the test measured but the server didn't store the result.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
