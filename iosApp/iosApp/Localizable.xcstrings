        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu cihazda kaydedildi. Diğer cihazlar profilin ayarlarını kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережено лише на цьому пристрої. Інші пристрої використовують налаштування профілю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ lưu trên thiết bị này. Các thiết bị khác dùng cài đặt của hồ sơ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅保存在此设备上。其他设备使用个人资料的设置。"
