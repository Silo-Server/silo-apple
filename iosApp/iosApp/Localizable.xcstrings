    "player.notice.subtitleRefused" : {
      "comment" : "Apple iOS/tvOS/macOS: video player notice text under This subtitle can't be shown; the previous subtitle choice stays.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع الخادم توفير هذا المسار، لذا لم تتغير الترجمة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърът не може да предаде тази писта, затова субтитрите ви не са променени."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no pot proporcionar aquesta pista, així que els subtítols no han canviat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server tuto stopu nemůže doručit, takže se vaše titulky nezměnily."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren kan ikke levere dette spor, så dine undertekster er ikke ændret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server kann diese Spur nicht bereitstellen, daher bleiben deine Untertitel unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής δεν μπορεί να παραδώσει αυτό το κομμάτι, οπότε οι υπότιτλοί σας δεν άλλαξαν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server can't deliver this track, so your subtitles haven't changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no puede entregar esta pista, así que tus subtítulos no han cambiado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server ei saa seda rada edastada, seega teie subtiitrid ei muutunud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin ei voi toimittaa tätä raitaa, joten tekstityksesi ei muuttunut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur ne peut pas fournir cette piste, vos sous-titres n’ont donc pas changé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת לא יכול להעביר את הרצועה הזו, ולכן הכתוביות שלך לא השתנו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर यह ट्रैक नहीं भेज सकता, इसलिए आपके सबटाइटल नहीं बदले गए हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj ne može isporučiti ovaj zapis pa se vaši titlovi nisu promijenili."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver nem tudja továbbítani ezt a sávot, ezért a felirat nem változott."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server tidak dapat mengirimkan trek ini, jadi subtitel Anda tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non può fornire questa traccia, quindi i sottotitoli non sono cambiati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーがこのトラックを配信できないため、字幕は変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에서 이 트랙을 제공할 수 없어 자막이 변경되지 않았어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveris negali pateikti šio takelio, todėl jūsų subtitrai nepakeisti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
