    "downloads.settings.qualityOriginal" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; first sentence of the footer under the quality picker. The footer's sentences are joined with a space.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفضّل خيار «الأصلية» جودة المصدر وقد يجهّز ملفًا متوافقًا إذا احتاج هذا الجهاز إليه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Оригинално“ предпочита качеството на източника и може да подготви файл за съвместимост, ако това устройство има нужда от такъв."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’opció Original prioritza la qualitat de l’origen i pot preparar un fitxer de compatibilitat si aquest dispositiu en necessita un."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvalita Původní upřednostňuje kvalitu zdroje a může připravit soubor pro kompatibilitu, pokud ho toto zařízení potřebuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original foretrækker kildekvaliteten og kan forberede en kompatibilitetsfil, hvis denne enhed har brug for en."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original bevorzugt die Qualität der Quelle und bereitet eventuell eine kompatible Datei vor, falls dieses Gerät eine benötigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιλογή «Αρχική» προτιμά την ποιότητα της πηγής και μπορεί να προετοιμάσει αρχείο συμβατότητας, αν το χρειάζεται αυτή η συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original prefers source quality and may prepare a compatibility file if this device needs one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original prioriza la calidad de origen y puede preparar un archivo compatible si este dispositivo lo necesita."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valik „Originaal“ eelistab allika kvaliteeti ja võib valmistada ette ühilduvusfaili, kui see seade seda vajab."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkuperäinen suosii lähteen laatua ja voi valmistella yhteensopivuustiedoston, jos tämä laite tarvitsee sellaisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’option Original privilégie la qualité de la source et peut préparer un fichier de compatibilité si cet appareil en a besoin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפשרות ”מקורית” מעדיפה את איכות המקור ועשויה להכין קובץ תאימות אם המכשיר הזה צריך אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ओरिजिनल” सोर्स क्वालिटी को प्राथमिकता देता है और अगर इस डिवाइस को ज़रूरत हो, तो कम्पैटिबिलिटी फ़ाइल तैयार कर सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcija Izvorno daje prednost kvaliteti izvora i može pripremiti datoteku za kompatibilnost ako je ovom uređaju potrebna."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Eredeti beállítás a forrásminőséget részesíti előnyben, és kompatibilitási fájlt készíthet elő, ha erre az eszköznek szüksége van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asli mengutamakan kualitas sumber dan mungkin menyiapkan file kompatibilitas jika perangkat ini memerlukannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La qualità Originale privilegia la qualità della sorgente e può preparare un file di compatibilità se questo dispositivo ne ha bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「オリジナル」はソースの画質を優先し、このデバイスで必要な場合は互換ファイルを準備することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본은 소스 화질을 우선하며, 이 기기에 필요하면 호환 파일을 준비할 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parinktis „Originali“ teikia pirmenybę šaltinio kokybei ir gali paruošti suderinamumo failą, jei jo reikia šiam įrenginiui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcija „Oriģināls” dod priekšroku avota kvalitātei un var sagatavot saderības failu, ja tas nepieciešams šai ierīcei."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asal mengutamakan kualiti sumber dan mungkin menyediakan fail keserasian jika peranti ini memerlukannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original foretrekker kildekvalitet og kan forberede en kompatibilitetsfil hvis denne enheten trenger det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Origineel geeft de voorkeur aan bronkwaliteit en kan een compatibel bestand voorbereiden als dit apparaat dat nodig heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcja Oryginał preferuje jakość źródła i może przygotować zgodny plik, jeśli to urządzenie go potrzebuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Original prefere a qualidade da origem e pode preparar um arquivo de compatibilidade se este dispositivo precisar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Original privilegia a qualidade de origem e pode preparar um ficheiro de compatibilidade se este dispositivo precisar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opțiunea Originală folosește de preferință calitatea sursei și poate pregăti un fișier compatibil dacă acest dispozitiv are nevoie de unul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вариант «Оригинал» использует качество источника и может подготовить совместимый файл, если он нужен этому устройству."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možnosť Originál uprednostňuje kvalitu zdroja a môže pripraviť kompatibilný súbor, ak ho toto zariadenie potrebuje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
