    "upNext.lookupFailed" : {
      "comment" : "Error message on the Roku Up Next panel when the next episode could not be loaded; the On Deck row below offers alternatives, or the user can go back. Apple tvOS: message on the player's Up Next screen above On Deck.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل الحلقة التالية. اختر شيئًا من «قيد المشاهدة» أو ارجع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nächste Folge konnte nicht geladen werden. Wähle etwas aus „Laufend“ oder gehe zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load the next episode. Pick something from On Deck, or go back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar el siguiente episodio. Elige algo de En curso o vuelve atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger l’épisode suivant. Choisissez un titre dans En cours ou revenez en arrière."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のエピソードを読み込めませんでした。視聴中から選ぶか、戻ってください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar o próximo episódio. Escolha algo em Em andamento ou volte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载下一集。请从进行中选择内容，或返回。"
          }
        }
      }
    },
