    "settingsManifest.playback.preferred_quality.description" : {
      "comment" : "Help text under the playback.preferred_quality setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الجودة التي يفضّلها Silo."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете качеството, което Silo да предпочита."
