    "shell.remotePlayback.downloadsPlayHere" : {
      "comment" : "Apple (iPhone): message of the A TV is connected prompt, explaining why a download can't be sent to the TV as is.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُشغَّل التنزيلات على هذا الجهاز فقط. يمكن للتلفزيون بث العنوان نفسه من الخادم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изтеглените заглавия се възпроизвеждат само на това устройство. Телевизорът може да предава поточно същото заглавие от вашия сървър."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les baixades només es reprodueixen en aquest dispositiu. La TV pot reproduir el mateix títol en streaming des del teu servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stažené položky lze přehrát jen v tomto zařízení. Televize může stejný titul streamovat z vašeho serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads kan kun afspilles på denne enhed. Tv’et kan streame den samme titel fra din server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads werden nur auf diesem Gerät abgespielt. Der Fernseher kann denselben Titel von deinem Server streamen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι λήψεις αναπαράγονται μόνο σε αυτήν τη συσκευή. Η τηλεόραση μπορεί να αναπαράγει τον ίδιο τίτλο μέσω ροής από τον διακομιστή σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads only play on this device. The TV can stream the same title from your server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las descargas solo se reproducen en este dispositivo. La TV puede transmitir el mismo título desde tu servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allalaaditud pealkirju saab esitada ainult selles seadmes. Teler saab sama pealkirja voogedastada teie serverist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladatut kohteet toistetaan vain tällä laitteella. Tv voi suoratoistaa saman kohteen palvelimeltasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les téléchargements ne se lisent que sur cet appareil. La TV peut lire le même titre en streaming depuis votre serveur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להפעיל הורדות רק במכשיר הזה. הטלוויזיה יכולה להזרים את אותו פריט מהשרת שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड सिर्फ़ इसी डिवाइस पर चलते हैं। टीवी यही टाइटल आपके सर्वर से स्ट्रीम कर सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzimanja se reproduciraju samo na ovom uređaju. TV može streamati isti naslov s vašeg poslužitelja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A letöltések csak ezen az eszközön játszhatók le. A TV ugyanezt a címet a szerverről streamelheti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduhan hanya dapat diputar di perangkat ini. TV dapat melakukan streaming judul yang sama dari server Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I download si riproducono solo su questo dispositivo. La TV può riprodurre in streaming lo stesso titolo dal tuo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードはこのデバイスでのみ再生できます。テレビでは同じタイトルをサーバーからストリーミングできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 항목은 이 기기에서만 재생돼요. TV에서는 같은 항목을 서버에서 스트리밍할 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atsisiuntimus galima leisti tik šiame įrenginyje. Televizorius gali transliuoti tą patį turinį iš jūsų serverio."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejupielādes var atskaņot tikai šajā ierīcē. Televizors var straumēt to pašu vienumu no jūsu servera."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muat turun hanya dimainkan pada peranti ini. TV boleh menstrim tajuk yang sama daripada pelayan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedlastinger kan bare spilles av på denne enheten. TV-en kan strømme den samme tittelen fra serveren din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads worden alleen op dit apparaat afgespeeld. De tv kan dezelfde titel vanaf je server streamen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobrane pliki można odtwarzać tylko na tym urządzeniu. Telewizor może strumieniować ten sam tytuł z twojego serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os downloads só são reproduzidos neste dispositivo. A TV pode transmitir o mesmo título a partir do seu servidor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As transferências só são reproduzidas neste dispositivo. A TV pode fazer streaming do mesmo título a partir do seu servidor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descărcările se redau doar pe acest dispozitiv. Televizorul poate reda în streaming același titlu de pe serverul dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузки воспроизводятся только на этом устройстве. Телевизор может воспроизвести то же самое с вашего сервера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiahnuté položky sa prehrávajú iba v tomto zariadení. Televízor môže rovnaký titul streamovať z vášho servera."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenosi se predvajajo samo v tej napravi. Televizor lahko isti naslov pretaka z vašega strežnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedladdningar spelas bara upp på den här enheten. Tv:n kan streama samma titel från din server."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการที่ดาวน์โหลดเล่นได้ในอุปกรณ์นี้เท่านั้น ทีวีสามารถสตรีมเรื่องเดียวกันจากเซิร์ฟเวอร์ของคุณได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilenler yalnızca bu cihazda oynatılır. TV aynı içeriği sunucunuzdan akış yaparak oynatabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантаження відтворюються лише на цьому пристрої. Телевізор може транслювати цю саму назву з вашого сервера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung tải xuống chỉ phát trên thiết bị này. TV có thể phát trực tuyến cùng nội dung đó từ máy chủ của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载内容只能在此设备上播放。电视可以从你的服务器串流同一作品。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載的內容只能在此裝置上播放。電視可以從你的伺服器串流相同的項目。"
          }
        }
      }
    },
