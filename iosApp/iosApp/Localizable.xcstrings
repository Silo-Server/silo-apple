    "account.signOut.leaves" : {
      "comment" : "Apple TV: message of the sign-out confirmation when other accounts still use the server. {device}: the device's product name (Apple TV).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال الملفات الشخصية والإعدادات الخاصة بهذا الحساب من جهاز %1$@ هذا. يبقى الخادم محفوظًا، لذا يمكنك تسجيل الدخول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profily a nastavení tohoto účtu budou z tohoto zařízení %1$@ odebrány. Server zůstane uložený, takže se můžete znovu přihlásit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne kontos profiler og indstillinger fjernes fra dette %1$@. Serveren forbliver gemt, så du kan logge ind igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Profile und Einstellungen dieses Kontos werden von diesem %1$@ entfernt. Der Server bleibt gespeichert, sodass du dich erneut anmelden kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account's profiles and settings leave this %1$@. The server stays saved, so you can sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles y la configuración de esta cuenta se quitarán de este %1$@. El servidor seguirá guardado para que puedas volver a iniciar sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän tilin profiilit ja asetukset poistetaan laitteelta %1$@. Palvelin pysyy tallennettuna, joten voit kirjautua uudelleen sisään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils et paramètres de ce compte seront retirés de votre %1$@. Le serveur reste enregistré : vous pourrez vous reconnecter."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profili i postavke ovog računa uklanjaju se s ovog uređaja %1$@. Poslužitelj ostaje spremljen pa se možete ponovno prijaviti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili e le impostazioni di questo account verranno rimossi da %1$@. Il server resta salvato, quindi puoi accedere di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントのプロフィールと設定はこの%1$@から削除されます。サーバーは保存されたままなので、もう一度サインインできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정의 프로필과 설정이 이 %1$@에서 삭제돼요. 서버는 저장된 상태로 유지되므로 다시 로그인할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilene og innstillingene for denne kontoen fjernes fra denne %1$@. Serveren forblir lagret, så du kan logge på igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De profielen en instellingen van dit account worden van deze %1$@ verwijderd. De server blijft opgeslagen, zodat je opnieuw kunt inloggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile i ustawienia tego konta zostaną usunięte z urządzenia %1$@. Serwer pozostanie zapisany, więc możesz zalogować się ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis e as configurações desta conta serão removidos deste %1$@. O servidor continua salvo, então você pode entrar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профили и настройки этого аккаунта будут удалены с этого устройства %1$@. Сервер останется сохранённым, и вы сможете войти снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här kontots profiler och inställningar tas bort från den här enheten (%1$@). Servern förblir sparad, så du kan logga in igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hesabın profilleri ve ayarları bu %1$@ cihazından kaldırılır. Sunucu kayıtlı kalır, böylece yeniden oturum açabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профілі й налаштування цього облікового запису буде вилучено з цього %1$@. Сервер залишиться збереженим, тож ви зможете ввійти знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账户的个人资料和设置将从此%1$@移除。服务器仍会保存，你可以重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個帳號的個人檔案和設定會從這部 %1$@ 移除。伺服器仍會保留，你可以再次登入。"
          }
        }
      }
    },
    "account.signOut.leavesRemovingServer" : {
      "comment" : "Apple TV: message of the sign-out confirmation when this is the server's only account, so the server goes too. {device}: the device's product name (Apple TV); {server}: the server's display name.",
