          }
        }
      }
    },
    "diagnostics.notice.localDeletedRemoteQueued" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: notice after deleting a pending report whose copy at the destination couldn't be deleted yet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُذف التقرير المحلي. الحذف البعيد في قائمة الانتظار وستُعاد محاولته."
