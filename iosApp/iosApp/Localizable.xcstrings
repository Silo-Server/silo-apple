    "errors.apple.subtitles.jobOutcomeUnknown" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error on the AI subtitle creation screen when the server's answer to starting a subtitle job was lost or unusable.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo تأكيد بدء عملية الترجمة. إذا كانت قد بدأت، فستظهر الترجمة في قائمة الترجمات عند انتهائها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не можа да потвърди, че заданието за субтитри е стартирано. Ако е стартирано, субтитрите ще се появят в списъка със субтитри, когато приключи."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no ha pogut confirmar que s’hagi iniciat el treball de subtítols. Si s’ha iniciat, els subtítols apareixeran a la llista de subtítols quan acabi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikaci Silo se nepodařilo ověřit, že se úloha titulků spustila. Pokud ano, titulky se po jejím dokončení zobrazí v seznamu titulků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke bekræfte, at undertekstjobbet blev startet. Hvis det gjorde, vises underteksterne på undertekstlisten, når det er færdigt."
          }
        },
        "de" : {
          "stringUnit" : {
