    "player.error.replanLoop" : {
      "comment" : "Apple iOS/tvOS/macOS: video player error screen when recovery kept getting a plan that had already failed on the current output.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعاد الخادم خطة بالبروتوكول V3 سبق أن فشلت على مسار الإخراج هذا."
          }
        },
        "de" : {
          "stringUnit" : {
