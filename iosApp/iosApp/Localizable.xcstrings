    "watchParty.hint.notReady.moreNames" : {
      "comment" : "Roku: hint line shown to the host when three or more members are not ready. {first}: name of one such member; {second}: name of another; 'and others' covers the rest. Apple (iPhone, iPad, Apple TV): same hint under the lobby's buttons. Android phone and TV Watch Party lobby: same line under the host's buttons. 1 and 2: the first two guests' names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعلن %1$@ و%2$@ وآخرون جاهزيتهم. لا يزال بإمكانك البدء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ und weitere sind noch nicht bereit. Du kannst trotzdem starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ and %2$@ and others haven't marked ready. You can still start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ y otras personas todavía no han marcado “Listo”. Aun así puedes iniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ et d’autres n’ont pas signalé leur disponibilité. Vous pouvez quand même lancer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、%2$@ほか数名が準備完了にしていません。このまま開始することもできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ e outras pessoas ainda não marcaram “Pronto”. Mesmo assim, você pode iniciar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、%2$@等人尚未标记为准备就绪。你仍可以开始。"
          }
        }
      }
    },
