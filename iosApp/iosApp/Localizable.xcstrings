          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte n’a pas de mot de passe Silo permettant de confirmer. Demandez à un administrateur de connecter le fournisseur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントには確認に使うSiloのパスワードがありません。管理者にプロバイダーとの連携を依頼してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta não tem uma senha do Silo para confirmar. Peça a um administrador para conectar o provedor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的账户没有可用于确认的Silo密码。请让管理员关联该提供商。"
          }
        }
      }
    },
    "settings.signIn.noProviders" : {
