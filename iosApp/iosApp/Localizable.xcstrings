        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käsitsi loodud aruanne sisaldab seadme võimekuse üksikasju, hiljutiste esitusseansside identifikaatoreid ja selle serveri hiljutisi diagnostikalogisid."
          }
        },
        "fi" : {
          "stringUnit" : {
