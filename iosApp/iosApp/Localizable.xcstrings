    "tvSignIn.status.tooMany" : {
      "comment" : "Android TV status when too many requests were made. The TV retries automatically. Apple TV: same status under the code.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محاولات تسجيل دخول كثيرة جدًا. ستتم إعادة المحاولة قريبًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš mnoho pokusů o přihlášení. Za chvíli proběhne další pokus."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange loginforsøg. Prøver igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Anmeldeversuche. Gleich wird es erneut versucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many sign-in attempts. Trying again shortly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados intentos de inicio de sesión. Se volverá a intentar en breve."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian monta kirjautumisyritystä. Yritetään pian uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de tentatives de connexion. Nouvel essai dans un instant."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previše pokušaja prijave. Uskoro slijedi novi pokušaj."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppi tentativi di accesso. Nuovo tentativo a breve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインの試行回数が多すぎます。まもなく再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 시도 횟수가 너무 많아요. 잠시 후 다시 시도할게요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange påloggingsforsøk. Prøver igjen om litt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te veel inlogpogingen. Zo meteen wordt het opnieuw geprobeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
