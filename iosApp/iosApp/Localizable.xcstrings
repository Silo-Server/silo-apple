    "requests.search.availableSubtitle" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): line under the Available to request heading in library Search. The dot separates the two parts.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير موجود في المكتبة بعد · اضغط للطلب"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Още не е в библиотеката · докоснете, за да заявите"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no és a la biblioteca · toca per sol·licitar-lo"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím není v knihovně · klepnutím si ho vyžádáte"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke i biblioteket endnu · tryk for at anmode"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht in der Mediathek · zum Anfragen tippen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει ακόμα στη βιβλιοθήκη · πατήστε για να το ζητήσετε"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not in the library yet · tap to request"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no está en la biblioteca · toca para solicitarlo"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pole veel meediakogus · puudutage taotlemiseks"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vielä kirjastossa · pyydä napauttamalla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore dans la bibliothèque · touchez pour demander"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין לא בספרייה · אפשר להקיש כדי לבקש"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
