    "tvSignIn.appleTv.typeOnPhoneBody" : {
      "comment" : "Apple TV: card text beside the password and server address forms explaining that nearby iPhones and iPads offer a keyboard.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند اختيار حقل، يظهر إشعار لوحة المفاتيح على أجهزة iPhone وiPad القريبة. اكتب هناك بدلًا من جهاز التحكم عن بُعد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du ein Feld auswählst, erscheint auf iPhones und iPads in der Nähe eine Tastaturmitteilung. Tippe dort statt mit der Fernbedienung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you select a field, a keyboard notification appears on nearby iPhones and iPads. Type there instead of with the remote."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al seleccionar un campo, aparece una notificación de teclado en los iPhone y iPad cercanos. Escribe ahí en lugar de usar el control remoto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous sélectionnez un champ, une notification de clavier apparaît sur les iPhone et iPad à proximité. Saisissez le texte sur l’un d’eux plutôt qu’avec la télécommande."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィールドを選択すると、近くのiPhoneやiPadにキーボードの通知が表示されます。リモコンの代わりにそちらで入力してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao selecionar um campo, uma notificação de teclado aparece nos iPhones e iPads próximos. Digite neles em vez de usar o controle remoto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择字段时，附近的iPhone和iPad上会出现键盘通知。可以在那里输入，而不必使用遥控器。"
          }
        }
      }
    },
