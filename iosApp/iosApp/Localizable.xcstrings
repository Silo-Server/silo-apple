        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un report manuale include i dettagli sulle funzionalità del dispositivo, gli identificatori delle sessioni di riproduzione recenti e i log di diagnostica recenti per questo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動レポートには、デバイスの機能の詳細、最近の再生セッションの識別子、このサーバーの最近の診断ログが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수동 보고서에는 기기 기능 세부정보, 최근 재생 세션 식별자, 이 서버의 최근 진단 로그가 포함돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rankiniu būdu sukurtame pranešime pateikiama įrenginio galimybių informacija, naujausi atkūrimo seansų identifikatoriai ir naujausi šio serverio diagnostikos žurnalai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuālajā pārskatā ir iekļauta informācija par ierīces iespējām, neseno atskaņošanas sesiju identifikatori un nesenie šī servera diagnostikas žurnāli."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan manual merangkumi butiran keupayaan peranti, pengecam sesi main balik terbaharu dan log diagnostik terbaharu untuk pelayan ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En manuell rapport inneholder detaljer om enhetens funksjoner, nylige identifikatorer for avspillingsøkter og nylige diagnostikklogger for denne serveren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een handmatig rapport bevat gegevens over de mogelijkheden van het apparaat, recente afspeelsessie-ID’s en recente diagnostische logs voor deze server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raport ręczny zawiera informacje o możliwościach urządzenia, identyfikatory ostatnich sesji odtwarzania i najnowsze logi diagnostyczne dla tego serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um relatório manual inclui detalhes dos recursos do dispositivo, identificadores recentes de sessão de reprodução e logs de diagnóstico recentes deste servidor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um relatório manual inclui detalhes das capacidades do dispositivo, identificadores de sessões de reprodução recentes e registos de diagnóstico recentes deste servidor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un raport manual include detalii despre capacitățile dispozitivului, identificatorii recenți ai sesiunilor de redare și jurnalele de diagnosticare recente pentru acest server."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчёт, отправленный вручную, содержит сведения о возможностях устройства, идентификаторы недавних сеансов воспроизведения и недавние диагностические логи для этого сервера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuálne hlásenie obsahuje údaje o možnostiach zariadenia, nedávne identifikátory relácií prehrávania a nedávne diagnostické denníky pre tento server."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ročno poročilo vključuje podrobnosti o zmogljivostih naprave, nedavne identifikatorje sej predvajanja in nedavne diagnostične dnevnike za ta strežnik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En manuell rapport innehåller information om enhetens funktioner, identifierare för de senaste uppspelningssessionerna och de senaste diagnostikloggarna för den här servern."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายงานที่สร้างเองประกอบด้วยรายละเอียดความสามารถของอุปกรณ์ ตัวระบุเซสชันการเล่นล่าสุด และล็อกการวินิจฉัยล่าสุดของเซิร์ฟเวอร์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuel rapor; cihaz özelliği ayrıntılarını, son oynatma oturumu tanımlayıcılarını ve bu sunucuya ait son tanılama günlüklerini içerir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звіт, надісланий вручну, містить відомості про можливості пристрою, ідентифікатори останніх сеансів відтворення й останні діагностичні логи для цього сервера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo thủ công bao gồm chi tiết về khả năng của thiết bị, mã định danh phiên phát gần đây và nhật ký chẩn đoán gần đây cho máy chủ này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动报告包含设备功能详情、近期的播放会话标识符以及此服务器的近期诊断日志。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動報告包含裝置功能詳細資料、近期的播放工作階段識別碼，以及此伺服器近期的診斷記錄。"
          }
        }
      }
    },
    "diagnostics.notice.consentReset" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: the destination's consent notice changed, so the Crash Reports setting went back to Ask. Crash Reports and Ask are the setting's and choice's names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت الموافقة؛ أُعيد ضبط «تقارير الأعطال» إلى «السؤال»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съгласието е променено; настройката „Отчети за сривове“ е върната на „Питане“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El consentiment ha canviat: l’opció Informes d’error ha tornat a Pregunta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souhlas se změnil; nastavení Zprávy o pádech se vrátilo na možnost Zeptat se."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtykket er ændret; Nedbrudsrapporter blev nulstillet til Spørg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einwilligung geändert; „Absturzberichte“ wurde auf „Fragen“ zurückgesetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συγκατάθεση άλλαξε. Η ρύθμιση «Αναφορές κατάρρευσης» επανήλθε σε «Ερώτηση»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consent changed; Crash Reports was reset to Ask."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El consentimiento cambió; Informes de fallos se restableció a Preguntar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nõusolek muutus; seadistus „Kokkujooksmise aruanded“ lähtestati valikule „Küsi“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suostumus muuttui, joten Kaatumisraportit-asetukseksi palautettiin Kysy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le consentement a changé ; l’option « Rapports de plantage » est revenue à « Demander »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההסכמה השתנתה; ההגדרה ”דוחות קריסה” חזרה לאפשרות ”לשאול”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहमति बदल गई; “क्रैश रिपोर्ट” को फिर से “पूछें” पर सेट किया गया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristanak se promijenio; „Izvješća o rušenju“ vraćena su na „Pitaj“."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hozzájárulás feltételei módosultak; az Összeomlási jelentések beállítás visszaállt a Rákérdezés értékre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persetujuan berubah; Laporan crash diatur ulang ke Tanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il consenso è cambiato; “Report arresti anomali” è stato reimpostato su “Chiedi”."
          }
