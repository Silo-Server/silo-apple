    "account.error.removeServerFailed" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message in the Account Update alert when removing a saved server, with its accounts, failed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo إزالة الخادم المحفوظ. حاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не можа да премахне запазения сървър. Опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no ha pogut eliminar el servidor desat. Torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nemohlo odebrat uložený server. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke fjerne den gemte server. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte den gespeicherten Server nicht entfernen. Versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Silo δεν μπόρεσε να αφαιρέσει τον αποθηκευμένο διακομιστή. Δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn't remove the saved server. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo quitar el servidor guardado. Vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei saanud salvestatud serverit eemaldada. Proovige uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei voinut poistaa tallennettua palvelinta. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de retirer le serveur enregistré. Réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה להסיר את השרת השמור. אפשר לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo सेव किया गया सर्वर नहीं हटा सका। कृपया फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
