    "personal.watchlist.emptyTapHint" : {
      "comment" : "Supporting line on the empty Watchlist, telling the user how to add titles (Android phone, Apple iOS and tvOS).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على أيقونة الإشارة المرجعية في أي عنصر لإضافته إلى قائمة المشاهدة"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докоснете иконата с отметка на който и да е елемент, за да го добавите тук"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la icona del marcador de qualsevol element per afegir-lo aquí"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na ikonu záložky u libovolné položky ji přidáte sem"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på bogmærkeikonet på et element for at tilføje det her"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe bei einem beliebigen Eintrag auf das Lesezeichensymbol, um ihn hier hinzuzufügen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε το εικονίδιο σελιδοδείκτη σε οποιοδήποτε στοιχείο για να το προσθέσετε εδώ"
