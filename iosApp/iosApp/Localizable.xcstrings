          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez quoi\nregarder"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "観るものを\n選んでください"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
