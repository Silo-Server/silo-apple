    "settings.accounts.footerAppleTv" : {
      "comment" : "Apple TV Settings > Accounts: note at the bottom of the pane about what signing out removes.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي تسجيل الخروج من حساب إلى إزالته وإزالة إعداداته من جهاز Apple TV هذا. ويؤدي تسجيل الخروج من الحساب الوحيد على خادم إلى إزالة الخادم أيضًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Излизането от акаунт го премахва заедно с настройките му от това устройство Apple TV. Излизането от единствения акаунт на сървър премахва и сървъра."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tancar la sessió d’un compte, s’eliminen el compte i la seva configuració d’aquest Apple TV. En tancar la sessió de l’únic compte d’un servidor, també s’elimina el servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odhlášením z účtu odeberete z tohoto Apple TV účet i jeho nastavení. Odhlášením z jediného účtu serveru odeberete i server."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du logger ud af en konto, fjernes den og dens indstillinger fra dette Apple TV. Hvis du logger ud af en servers eneste konto, fjernes serveren også."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dich von einem Konto abmeldest, werden das Konto und seine Einstellungen von diesem Apple TV entfernt. Beim Abmelden vom einzigen Konto eines Servers wird auch der Server entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αποσύνδεση από έναν λογαριασμό τον αφαιρεί μαζί με τις ρυθμίσεις του από αυτό το Apple TV. Η αποσύνδεση από τον μοναδικό λογαριασμό ενός διακομιστή αφαιρεί και τον διακομιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing out of an account removes it and its settings from this Apple TV. Signing out of a server's only account removes the server too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cerrar sesión en una cuenta, se quitan la cuenta y su configuración de este Apple TV. Al cerrar sesión en la única cuenta de un servidor, también se quita el servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontost väljalogimine eemaldab selle konto ja selle seaded sellest Apple TV-st. Serveri ainsast kontost väljalogimine eemaldab ka serveri."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tililtä uloskirjautuminen poistaa tilin ja sen asetukset tästä Apple TV:stä. Palvelimen ainoalta tililtä uloskirjautuminen poistaa myös palvelimen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se déconnecter d’un compte le retire de cette Apple TV, avec ses paramètres. Se déconnecter du seul compte d’un serveur retire aussi le serveur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התנתקות מחשבון מסירה אותו ואת ההגדרות שלו מה-Apple TV הזה. התנתקות מהחשבון היחיד של שרת מסירה גם את השרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी खाते से साइन आउट करने पर वह खाता और उसकी सेटिंग इस Apple TV से हट जाते हैं। किसी सर्वर के इकलौते खाते से साइन आउट करने पर वह सर्वर भी हट जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odjava s računa uklanja račun i njegove postavke s ovog Apple TV-a. Odjava s jedinog računa na poslužitelju uklanja i poslužitelj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha kijelentkezik egy fiókból, a fiók és a beállításai törlődnek erről az Apple TV-ről. Ha egy szerver egyetlen fiókjából jelentkezik ki, a szerver is törlődik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluar dari akun akan menghapus akun itu beserta pengaturannya dari Apple TV ini. Keluar dari satu-satunya akun suatu server juga akan menghapus server tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esci da un account, l’account e le sue impostazioni vengono rimossi da questa Apple TV. Se esci dall’unico account di un server, viene rimosso anche il server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントからサインアウトすると、そのアカウントと設定がこのApple TVから削除されます。サーバーの唯一のアカウントからサインアウトすると、サーバーも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정에서 로그아웃하면 이 Apple TV에서 해당 계정과 설정이 제거돼요. 서버의 유일한 계정에서 로그아웃하면 서버도 제거돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atsijungus nuo paskyros, ji ir jos nustatymai pašalinami iš šio „Apple TV“ įrenginio. Atsijungus nuo vienintelės serverio paskyros, pašalinamas ir serveris."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izrakstoties no konta, tas un tā iestatījumi tiek noņemti no šīs Apple TV ierīces. Izrakstoties no servera vienīgā konta, tiek noņemts arī serveris."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log keluar daripada akaun akan mengalih keluar akaun itu dan tetapannya dari Apple TV ini. Log keluar daripada satu-satunya akaun sesebuah pelayan akan turut mengalih keluar pelayan itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du logger ut av en konto, fjernes den og innstillingene dens fra denne Apple TV-en. Når du logger ut av den eneste kontoen på en server, fjernes også serveren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je uitlogt bij een account, worden het account en de instellingen ervan van deze Apple TV verwijderd. Als je uitlogt bij het enige account van een server, wordt ook de server verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wylogowanie z konta usuwa je i jego ustawienia z tego urządzenia Apple TV. Wylogowanie z jedynego konta serwera usuwa także serwer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sair de uma conta remove ela e as configurações dela desta Apple TV. Sair da única conta de um servidor também remove o servidor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminar sessão numa conta remove-a desta Apple TV, juntamente com as respetivas definições. Terminar sessão na única conta de um servidor também remove o servidor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deconectarea de la un cont îl elimină, împreună cu setările sale, de pe acest Apple TV. Deconectarea de la singurul cont al unui server elimină și serverul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При выходе из аккаунта он и его настройки удаляются с этого Apple TV. При выходе из единственного аккаунта сервера удаляется и сам сервер."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odhlásením z účtu sa účet a jeho nastavenia odstránia z tohto Apple TV. Odhlásením z jediného účtu servera sa odstráni aj server."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z odjavo iz računa odstranite ta račun in njegove nastavitve s te naprave Apple TV. Z odjavo iz edinega računa strežnika odstranite tudi strežnik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du loggar ut från ett konto tas kontot och dess inställningar bort från den här Apple TV-enheten. Om du loggar ut från en servers enda konto tas även servern bort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การออกจากระบบบัญชีจะนำบัญชีและการตั้งค่าของบัญชีนั้นออกจาก Apple TV เครื่องนี้ การออกจากระบบบัญชีเดียวของเซิร์ฟเวอร์จะนำเซิร์ฟเวอร์ออกด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir hesabın oturumunu kapatmak, hesabı ve ayarlarını bu Apple TV’den kaldırır. Bir sunucunun tek hesabının oturumunu kapatmak sunucuyu da kaldırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вихід з облікового запису вилучає його та його налаштування з цього Apple TV. Вихід з єдиного облікового запису сервера вилучає й сам сервер."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng xuất khỏi một tài khoản sẽ xóa tài khoản đó và các cài đặt của tài khoản khỏi Apple TV này. Đăng xuất khỏi tài khoản duy nhất của một máy chủ cũng sẽ xóa máy chủ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出某个账户的登录会从这台Apple TV上移除该账户及其设置。退出服务器唯一账户的登录也会移除该服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登出帳號會從這台 Apple TV 移除該帳號及其設定。登出伺服器唯一的帳號也會移除該伺服器。"
          }
        }
      }
    },
