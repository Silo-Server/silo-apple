    "remote.reconnect.rokuHint" : {
      "comment" : "Apple iOS: Remote Control remote; hint under \"Reconnecting to …\" when the TV is a Roku.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من أن Silo مفتوح على جهاز Roku وأنه متصل بالشبكة نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle sicher, dass Silo auf dem Roku geöffnet ist und er sich im selben Netzwerk befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure Silo is open on the Roku and it's on the same network."
          }
        },
        "es" : {
