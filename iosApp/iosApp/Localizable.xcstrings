    "settingsManifest.catalog.show_advisory_age.description" : {
      "comment" : "Help text under the catalog.show_advisory_age setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض الحد الأدنى الموصى به لعمر المشاهد من خدمة استشارية، مثل Common Sense Media، في صفحة تفاصيل العنصر."
          }
        },
        "de" : {
          "stringUnit" : {
