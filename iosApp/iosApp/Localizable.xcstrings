    "settingsManifest.ui.remember_library_page_state.description" : {
      "comment" : "Help text under the ui.remember_library_page_state setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العودة إلى حيث توقفت عند إعادة فتح مكتبة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Връщане там, докъдето сте стигнали, при повторно отваряне на библиотека."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna on ho havies deixat en tornar a obrir una biblioteca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po opětovném otevření knihovny se vrátit tam, kde jste skončili."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vend tilbage til, hvor du slap, når du åbner et bibliotek igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehre beim erneuten Öffnen einer Mediathek dorthin zurück, wo du aufgehört hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιστροφή στο σημείο όπου σταματήσατε όταν ανοίγετε ξανά μια βιβλιοθήκη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Return to where you left off when reopening a library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a donde lo dejaste al abrir de nuevo una biblioteca."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meediakogu uuesti avamisel jätkatakse sealt, kus pooleli jäite."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palaa kohtaan, johon jäit, kun avaat kirjaston uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprendre là où vous vous étiez arrêté en rouvrant une bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חזרה למקום שבו הפסקת בפתיחה מחדש של ספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइब्रेरी फिर से खोलने पर वहीं लौटें जहाँ आपने छोड़ा था।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri ponovnom otvaranju medijateke nastavite ondje gdje ste stali."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy könyvtár újbóli megnyitásakor ott folytathatja, ahol abbahagyta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kembali ke posisi terakhir saat membuka perpustakaan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprendi da dove avevi lasciato quando riapri una libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリを再度開いたときに、前回の位置に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리를 다시 열 때 마지막으로 보던 위치로 돌아가요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vėl atidarius biblioteką, grįžti ten, kur baigėte."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atkārtoti atverot bibliotēku, atgriezties vietā, kur pārtraucāt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kembali ke tempat anda berhenti apabila membuka semula pustaka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå tilbake til der du slapp når du åpner et bibliotek på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga verder waar je gebleven was wanneer je een bibliotheek opnieuw opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po ponownym otwarciu biblioteki wraca do miejsca, w którym przerwano przeglądanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volta para onde você parou ao reabrir uma biblioteca."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voltar ao ponto onde ficou ao reabrir uma biblioteca."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveniți unde ați rămas când redeschideți o bibliotecă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При повторном открытии медиатеки возвращаться к месту, где вы остановились."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po opätovnom otvorení knižnice sa vrátite tam, kde ste skončili."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob ponovnem odprtju knjižnice nadaljujte tam, kjer ste končali."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsätt där du slutade när du öppnar ett bibliotek igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลับไปยังตำแหน่งเดิมเมื่อเปิดคลังอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kitaplığı yeniden açtığınızda kaldığınız yere döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повертатися туди, де ви зупинилися, коли знову відкриваєте бібліотеку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quay lại chỗ bạn đã dừng khi mở lại thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新打开媒体库时回到你上次离开的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新開啟媒體庫時，回到你上次離開的位置。"
          }
        }
      }
    },
