    "diagnostics.destination.hostedDefaultDescription" : {
      "comment" : "Apple TV Settings > Diagnostics > Send Reports To: explanation above the destination choices. Silo Diagnostics is a product name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics هو الخيار الافتراضي ولا يتطلب تخزين بيانات التشخيص على خادمك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics е опцията по подразбиране и не изисква хранилище за диагностика на вашия собствен сървър."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics és l’opció predeterminada i no requereix emmagatzematge de diagnòstics al teu servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics je výchozí volba a nevyžaduje úložiště diagnostiky na vašem vlastním serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics er standard og kræver ikke lager til diagnosticering på din egen server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics ist die Standardeinstellung und benötigt keinen Diagnosespeicher auf deinem eigenen Server."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Silo Diagnostics είναι η προεπιλογή και δεν απαιτεί χώρο αποθήκευσης διαγνωστικών στον δικό σας διακομιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics is the default and does not require diagnostics storage on your own server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics es la opción predeterminada y no requiere almacenamiento de diagnósticos en tu propio servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics on vaikevalik ega nõua teie enda serveris diagnostika salvestusruumi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics on oletus, eikä se vaadi diagnostiikan tallennustilaa omalla palvelimellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics est la destination par défaut et ne nécessite aucun stockage de diagnostics sur votre propre serveur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ברירת המחדל היא Silo Diagnostics, שלא דורש אחסון לנתוני אבחון בשרת שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics डिफ़ॉल्ट है और इसके लिए आपके अपने सर्वर पर डायग्नोस्टिक्स स्टोरेज की ज़रूरत नहीं होती।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics zadana je opcija i ne zahtijeva pohranu dijagnostike na vašem vlastitom poslužitelju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo Diagnostics az alapértelmezett, és nem igényel diagnosztikai tárhelyet a saját szerverén."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
