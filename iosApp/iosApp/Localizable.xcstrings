            "value" : "يوجد حساب بهذا البريد الإلكتروني بالفعل. اطلب من المسؤول ربطه بمزود تسجيل الدخول."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účet s tímto e-mailem už existuje. Požádejte správce, aby ho propojil s poskytovatelem přihlášení."
