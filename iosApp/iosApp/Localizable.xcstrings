    },
    "settings.interface.onlyThisDeviceFooterAppleTv" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac) > Title Pages on Apple TV: footer while Apply to All Devices is off. Apple TV is the product name; keep it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
