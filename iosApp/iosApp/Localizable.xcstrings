    "settings.signIn.onlySignInMethodAdministrator" : {
      "comment" : "Apple Settings > Sign-in (iPhone, iPad, Mac): note under the linked providers, and the error after a refused disconnect, when the provider is the account's only way to sign in.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه طريقتك الوحيدة لتسجيل الدخول، لذا لا يمكن إلغاء ربطها. اطلب من المسؤول تعيين كلمة مرور لحسابك أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist deine einzige Anmeldemethode, daher kann sie nicht getrennt werden. Bitte einen Administrator, zuerst ein Passwort für dein Konto festzulegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is your only way to sign in, so it can't be disconnected. Ask an administrator to set a password for your account first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es tu única forma de iniciar sesión, así que no se puede desconectar. Pide a un administrador que configure primero una contraseña para tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’agit de votre seul moyen de connexion : la déconnexion est donc impossible. Demandez d’abord à un administrateur de définir un mot de passe pour votre compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは唯一のサインイン方法のため、連携を解除できません。先に管理者にアカウントのパスワードを設定してもらってください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é sua única forma de entrar, então não pode ser desconectada. Peça a um administrador para definir uma senha para sua conta primeiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是你唯一的登录方式，因此无法取消关联。请先让管理员为你的账户设置密码。"
          }
        }
      }
    },
