    "downloads.settings.heldProgressFooter" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; footer of Offline Progress. {count}: how many; {count_text}: the same number as written by the app (a count that can pass 999 goes in as text).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "few" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "قد لا تكون %2$@ مواضع مشاهدة دون اتصال قد وصلت إلى الخادم. لن يرسلها Silo مرة أخرى. يؤدي تشغيل التنزيل مرة أخرى إلى استبدالها."
                    }
                  },
                  "many" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "قد لا يكون %2$@ موضعًا للمشاهدة دون اتصال قد وصل إلى الخادم. لن يرسلها Silo مرة أخرى. يؤدي تشغيل التنزيل مرة أخرى إلى استبدالها."
                    }
                  },
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "قد لا يكون موضع مشاهدة واحد دون اتصال قد وصل إلى الخادم. لن يرسله Silo مرة أخرى. يؤدي تشغيل التنزيل مرة أخرى إلى استبداله."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "قد لا يكون %2$@ موضع مشاهدة دون اتصال قد وصل إلى الخادم. لن يرسلها Silo مرة أخرى. يؤدي تشغيل التنزيل مرة أخرى إلى استبدالها."
                    }
                  },
                  "two" : {
