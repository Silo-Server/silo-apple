          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo تأكيد هذا التغيير. أعد التحميل للتحقق مما إذا كان قد حُفظ قبل المحاولة مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikaci Silo se nepodařilo tuto změnu potvrdit. Než to zkusíte znovu, načtěte data znovu a ověřte, zda byla uložena."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke bekræfte denne ændring. Genindlæs for at tjekke, om den blev gemt, før du prøver igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte diese Änderung nicht bestätigen. Lade neu, um zu prüfen, ob sie gespeichert wurde, bevor du es erneut versuchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn't confirm this change. Reload to check whether it was saved before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo confirmar este cambio. Recarga para comprobar si se guardó antes de volver a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei voinut vahvistaa tätä muutosta. Valitse Lataa uudelleen ja tarkista, tallentuiko muutos, ennen kuin yrität uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a pas pu confirmer cette modification. Rechargez pour vérifier si elle a été enregistrée avant de réessayer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nije mogao potvrditi ovu promjenu. Ponovno učitajte kako biste provjerili je li spremljena prije ponovnog pokušaja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo non è riuscito a confermare questa modifica. Ricarica per verificare se è stata salvata prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
