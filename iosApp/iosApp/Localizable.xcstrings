    "servers.remove.failedToast" : {
      "comment" : "Toast on Android TV (and error on Apple TV) shown when removing a saved server did not finish. On Android TV it appears when removing from Settings → Accounts or Sign Out & Remove Server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo إزالة الخادم المحفوظ. حاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не можа да премахне запазения сървър. Опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no ha pogut treure el servidor desat. Torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
