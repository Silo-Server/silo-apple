    },
    "settings.quality.footerUpTo" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: footer under Resolution when a maximum resolution is chosen. {resolution}: the chosen resolution's label, such as 1080p. Android phone and TV Settings > Playback: the same footer, under the Resolution and Maximum Bitrate pickers.",
