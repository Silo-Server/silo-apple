    "settings.profileSettings.deviceOnlyDefaults" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: sentence added to the Use Profile Settings confirmation message. Dolby Vision and Buffer Ahead are setting names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود الإعدادات الخاصة بهذا الجهاز فقط، مثل Dolby Vision و«التحميل المسبق»، إلى قيمها الافتراضية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройките, които важат само за това устройство, като Dolby Vision и „Предварително буфериране“, се връщат към стандартните си стойности."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les opcions que només s’apliquen a aquest dispositiu, com ara Dolby Vision i Memòria intermèdia anticipada, tornen als valors predeterminats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení, která platí jen pro toto zařízení, například Dolby Vision a Načítání dopředu, se vrátí na výchozí hodnoty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillinger, der kun gælder denne enhed, f.eks. Dolby Vision og Buffer på forhånd, går tilbage til deres standardværdier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen, die nur für dieses Gerät gelten, wie Dolby Vision und Vorpuffern, werden auf ihre Standardwerte zurückgesetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ρυθμίσεις που ισχύουν μόνο για αυτή τη συσκευή, όπως οι «Dolby Vision» και «Προφόρτωση», επανέρχονται στις προεπιλογές τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings that only apply to this device, like Dolby Vision and Buffer Ahead, go back to their defaults."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración que solo se aplica a este dispositivo, como Dolby Vision y Búfer anticipado, vuelve a sus valores predeterminados."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainult selles seadmes kehtivad seadistused, nagu Dolby Vision ja „Ettepuhverdus“, lähevad tagasi vaikeväärtustele."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain tätä laitetta koskevat asetukset, kuten Dolby Vision ja Ennakkopuskurointi, palautuvat oletuksiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paramètres propres à cet appareil, comme Dolby Vision et Préchargement, reprennent leurs valeurs par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדרות שחלות רק על המכשיר הזה, כמו ”טעינה מראש” ו-Dolby Vision, יחזרו לברירות המחדל שלהן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो सेटिंग सिर्फ़ इस डिवाइस पर लागू होती हैं, जैसे Dolby Vision और आगे का बफ़र, वे अपने डिफ़ॉल्ट पर लौट जाएँगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavke koje vrijede samo za ovaj uređaj, poput Dolby Visiona i Međuspremnika unaprijed, vraćaju se na zadane vrijednosti."
