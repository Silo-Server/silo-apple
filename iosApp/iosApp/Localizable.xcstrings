            "value" : "Naprava %1$@ zahteva seznanitev. Na napravi Roku v meniju profila aplikacije Silo odprite Poveži telefon in prikazano kodo skenirajte s kamero tega iPhona."
          }
        },
        "sv" : {
          "stringUnit" : {
