    "setup.recovery.leadNeedsSetup" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV) saved-server recovery screen: text under the headline when the server still needs administrator setup.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من مسؤول الخادم إكمال الإعداد، ثم حاول مرة أخرى. لم تُحذف معلومات تسجيل الدخول المحفوظة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помолете администратора на сървъра да завърши настройката и опитайте отново. Запазените ви данни за вход не са премахнати."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demana a l’administrador del servidor que acabi la configuració i torna-ho a provar. La informació d’inici de sessió desada no s’ha eliminat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádejte správce serveru o dokončení nastavení a pak to zkuste znovu. Uložené přihlašovací údaje nebyly odebrány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed serveradministratoren om at gøre konfigurationen færdig, og prøv så igen. Dine gemte loginoplysninger er ikke blevet fjernet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte die Person, die den Server verwaltet, die Einrichtung abzuschließen, und versuche es dann erneut. Deine gespeicherten Anmeldedaten wurden nicht entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήστε από τον διαχειριστή του διακομιστή να ολοκληρώσει τη ρύθμιση και δοκιμάστε ξανά. Τα αποθηκευμένα στοιχεία σύνδεσης δεν έχουν αφαιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the server administrator to finish setup, then try again. Your saved sign-in information has not been removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide al administrador del servidor que termine la configuración y vuelve a intentarlo. Tu información de inicio de sesión guardada no se ha eliminado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paluge serveri administraatoril seadistamine lõpetada ja proovige seejärel uuesti. Teie salvestatud sisselogimisandmeid pole eemaldatud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydä palvelimen ylläpitäjää viimeistelemään käyttöönotto ja yritä sitten uudelleen. Tallennettuja kirjautumistietojasi ei ole poistettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à la personne qui administre le serveur de terminer la configuration, puis réessayez. Vos informations de connexion enregistrées n’ont pas été supprimées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבקש ממנהל השרת להשלים את ההגדרה, ואז לנסות שוב. פרטי ההתחברות השמורים שלך לא הוסרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर एडमिनिस्ट्रेटर से सेटअप पूरा करने को कहें, फिर से कोशिश करें। साइन-इन की आपकी सेव की गई जानकारी हटाई नहीं गई है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamolite administratora poslužitelja da dovrši postavljanje, a zatim pokušajte ponovno. Vaši spremljeni podaci za prijavu nisu uklonjeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérje meg a szerver rendszergazdáját, hogy fejezze be a beállítást, majd próbálja újra. A mentett bejelentkezési adatok nem törlődtek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta administrator server untuk menyelesaikan penyiapan, lalu coba lagi. Informasi masuk Anda yang tersimpan tidak dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi a chi amministra il server di completare la configurazione, poi riprova. Le informazioni di accesso salvate non sono state rimosse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの管理者にセットアップの完了を依頼してから、もう一度お試しください。保存済みのサインイン情報は削除されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 관리자에게 설정을 완료해 달라고 요청한 다음 다시 시도해 주세요. 저장된 로그인 정보는 삭제되지 않았어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paprašykite serverio administratoriaus užbaigti sąranką, tada bandykite dar kartą. Išsaugoti prisijungimo duomenys nepašalinti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lūdziet servera administratoram pabeigt iestatīšanu un pēc tam mēģiniet vēlreiz. Jūsu saglabātā pierakstīšanās informācija nav noņemta."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta pentadbir pelayan menyelesaikan persediaan, kemudian cuba lagi. Maklumat log masuk anda yang tersimpan tidak dialih keluar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be serveradministratoren om å fullføre konfigureringen, og prøv igjen. Den lagrede påloggingsinformasjonen din er ikke fjernet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag de serverbeheerder om het instellen af te ronden en probeer het daarna opnieuw. Je opgeslagen inloggegevens zijn niet verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś administratora serwera o dokończenie konfiguracji, a potem spróbuj ponownie. Zapisane dane logowania nie zostały usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao administrador do servidor para concluir a configuração e tente novamente. Suas informações de login salvas não foram removidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao administrador do servidor para concluir a configuração e tente novamente. As suas informações de início de sessão guardadas não foram removidas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cereți administratorului serverului să finalizeze configurarea, apoi încercați din nou. Informațiile de conectare salvate nu au fost eliminate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите администратора сервера завершить настройку, затем повторите попытку. Сохранённые данные для входа не удалены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požiadajte správcu servera, aby dokončil nastavenie, a potom to skúste znova. Vaše uložené prihlasovacie údaje neboli odstránené."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosite skrbnika strežnika, naj dokonča nastavitev, nato poskusite znova. Vaši shranjeni podatki za prijavo niso bili odstranjeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be serverns administratör att slutföra konfigurationen och försök sedan igen. Dina sparade inloggningsuppgifter har inte tagits bort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรดขอให้ผู้ดูแลเซิร์ฟเวอร์ตั้งค่าให้เสร็จ แล้วลองอีกครั้ง ข้อมูลการลงชื่อเข้าใช้ที่บันทึกไว้ยังไม่ได้ลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu yöneticisinden kurulumu tamamlamasını isteyin, ardından tekrar deneyin. Kayıtlı oturum açma bilgileriniz kaldırılmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросіть адміністратора сервера завершити налаштування, а потім спробуйте ще раз. Збережені дані для входу не видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy nhờ quản trị viên máy chủ hoàn tất thiết lập, rồi thử lại. Thông tin đăng nhập đã lưu của bạn chưa bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请让服务器管理员完成设置，然后重试。你已保存的登录信息未被移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請要求伺服器管理員完成設定，然後再試一次。你已儲存的登入資訊並未移除。"
          }
        }
      }
    },
    "setup.recovery.leadNotRecognized" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV) saved-server recovery screen: text under the headline when the address no longer answers as the saved Silo server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما نُقل الخادم أو أُعيد ضبطه، أو ربما لم يعد هذا العنوان يشير إلى Silo. لم تُحذف معلومات تسجيل الدخول المحفوظة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърът може да е преместен или нулиран, или този адрес вече не води към Silo. Запазените ви данни за вход не са премахнати."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pot ser que el servidor s’hagi traslladat o restablert, o que aquesta adreça ja no apunti a Silo. La informació d’inici de sessió desada no s’ha eliminat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server se mohl přesunout nebo byl obnoven, případně tato adresa už nevede na Silo. Uložené přihlašovací údaje nebyly odebrány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren er måske flyttet eller nulstillet, eller også peger denne adresse ikke længere på Silo. Dine gemte loginoplysninger er ikke blevet fjernet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server wurde möglicherweise verschoben oder zurückgesetzt, oder diese Adresse verweist nicht mehr auf Silo. Deine gespeicherten Anmeldedaten wurden nicht entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής μπορεί να έχει μετακινηθεί ή να έχει γίνει επαναφορά του, ή αυτή η διεύθυνση μπορεί να μην οδηγεί πλέον στο Silo. Τα αποθηκευμένα στοιχεία σύνδεσης δεν έχουν αφαιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server may have moved, been reset, or this address may no longer point to Silo. Your saved sign-in information has not been removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que el servidor se haya trasladado o restablecido, o que esta dirección ya no apunte a Silo. Tu información de inicio de sesión guardada no se ha eliminado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server võib olla teisaldatud või lähtestatud või ei pruugi see aadress enam Silole viidata. Teie salvestatud sisselogimisandmeid pole eemaldatud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin on ehkä siirretty tai palautettu, tai tämä osoite ei ehkä enää osoita Siloon. Tallennettuja kirjautumistietojasi ei ole poistettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a peut-être été déplacé ou réinitialisé, ou cette adresse ne pointe peut-être plus vers Silo. Vos informations de connexion enregistrées n’ont pas été supprimées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייתכן שהשרת הועבר או אופס, או שהכתובת הזו כבר לא מפנה ל-Silo. פרטי ההתחברות השמורים שלך לא הוסרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हो सकता है सर्वर की जगह बदल गई हो, उसे रीसेट कर दिया गया हो, या यह पता अब Silo पर न ले जाता हो। साइन-इन की आपकी सेव की गई जानकारी हटाई नहीं गई है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj je možda premješten ili vraćen na početne postavke, ili ova adresa možda više ne vodi na Silo. Vaši spremljeni podaci za prijavu nisu uklonjeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehet, hogy a szerver máshová került vagy alaphelyzetbe állt, vagy ez a cím már nem a Silóra mutat. A mentett bejelentkezési adatok nem törlődtek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server mungkin telah dipindahkan atau direset, atau alamat ini mungkin tidak lagi mengarah ke Silo. Informasi masuk Anda yang tersimpan tidak dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server potrebbe essere stato spostato o reimpostato, oppure questo indirizzo potrebbe non puntare più a Silo. Le informazioni di accesso salvate non sono state rimosse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーが移動またはリセットされたか、このアドレスがSiloを指していない可能性があります。保存済みのサインイン情報は削除されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 이동했거나 초기화되었거나, 이 주소가 더 이상 Silo를 가리키지 않을 수 있어요. 저장된 로그인 정보는 삭제되지 않았어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveris galėjo būti perkeltas ar nustatytas iš naujo, arba šis adresas nebenukreipia į „Silo“. Išsaugoti prisijungimo duomenys nepašalinti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iespējams, serveris ir pārvietots vai atiestatīts, vai arī šī adrese vairs nenorāda uz Silo. Jūsu saglabātā pierakstīšanās informācija nav noņemta."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelayan mungkin telah dipindahkan atau ditetapkan semula, atau alamat ini mungkin tidak lagi menghala ke Silo. Maklumat log masuk anda yang tersimpan tidak dialih keluar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren kan ha blitt flyttet eller tilbakestilt, eller så peker denne adressen ikke lenger til Silo. Den lagrede påloggingsinformasjonen din er ikke fjernet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server is misschien verplaatst of gereset, of dit adres verwijst niet meer naar Silo. Je opgeslagen inloggegevens zijn niet verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer mógł zostać przeniesiony lub zresetowany albo ten adres nie prowadzi już do serwera Silo. Zapisane dane logowania nie zostały usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor pode ter mudado de lugar ou sido redefinido, ou este endereço pode não apontar mais para o Silo. Suas informações de login salvas não foram removidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor pode ter mudado de sítio ou sido reposto, ou este endereço pode já não apontar para o Silo. As suas informações de início de sessão guardadas não foram removidas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este posibil ca serverul să fi fost mutat sau resetat ori ca această adresă să nu mai indice către Silo. Informațiile de conectare salvate nu au fost eliminate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, сервер перенесён или сброшен, либо этот адрес больше не ведёт к Silo. Сохранённые данные для входа не удалены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server mohol byť presunutý alebo resetovaný, prípadne táto adresa už nemusí smerovať na Silo. Vaše uložené prihlasovacie údaje neboli odstránené."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežnik je bil morda premaknjen ali ponastavljen ali pa ta naslov ne kaže več na strežnik Silo. Vaši shranjeni podatki za prijavo niso bili odstranjeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern kan ha flyttats eller återställts, eller så pekar adressen inte längre på Silo. Dina sparade inloggningsuppgifter har inte tagits bort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซิร์ฟเวอร์อาจย้ายหรือรีเซ็ตไปแล้ว หรือที่อยู่นี้อาจไม่ได้ชี้ไปยัง Silo อีกต่อไป ข้อมูลการลงชื่อเข้าใช้ที่บันทึกไว้ยังไม่ได้ลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu taşınmış ya da sıfırlanmış olabilir veya bu adres artık Silo’yu göstermiyor olabilir. Kayıtlı oturum açma bilgileriniz kaldırılmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, сервер перенесено чи скинуто, або ця адреса більше не вказує на Silo. Збережені дані для входу не видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ có thể đã chuyển đi, đã được đặt lại, hoặc địa chỉ này có thể không còn trỏ đến Silo. Thông tin đăng nhập đã lưu của bạn chưa bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器可能已迁移或被重置，或者此地址可能不再指向Silo。你已保存的登录信息未被移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器可能已移動或重設，或此位址可能已不再指向 Silo。你已儲存的登入資訊並未移除。"
          }
        }
      }
    },
