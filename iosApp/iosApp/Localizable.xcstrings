    "downloads.manager.emptyHint" : {
      "comment" : "Apple iOS/macOS: Downloads tab (page on macOS); empty-state text when nothing is downloaded; may be followed by a sentence about monitoring, joined with a space.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا الأفلام والحلقات المنزّلة للمشاهدة دون اتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изтеглените филми и епизоди се показват тук за гледане офлайн."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pel·lícules i els episodis baixats apareixen aquí per veure’ls sense connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde se zobrazí stažené filmy a díly ke sledování offline."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloadede film og afsnit vises her, så du kan se dem offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heruntergeladene Filme und Folgen erscheinen hier und lassen sich offline ansehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ταινίες και τα επεισόδια από τις λήψεις σας εμφανίζονται εδώ για προβολή εκτός σύνδεσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloaded movies and episodes appear here for offline viewing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las películas y los episodios descargados aparecen aquí para verlos sin conexión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allalaaditud filmid ja osad kuvatakse siin võrguühenduseta vaatamiseks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladatut elokuvat ja jaksot näkyvät täällä offline-katselua varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les films et épisodes téléchargés s’affichent ici pour être regardés hors connexion."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סרטים ופרקים שהורדו מופיעים כאן לצפייה אופליין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड की गई फ़िल्में और एपिसोड ऑफ़लाइन देखने के लिए यहाँ दिखते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzeti filmovi i epizode prikazuju se ovdje za gledanje izvan mreže."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A letöltött filmek és epizódok itt jelennek meg offline megtekintéshez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
