    "player.seekInterval.serverUpgrade" : {
      "comment" : "Apple iOS/tvOS/macOS: skip interval settings (video and audiobook skip back/forward); status when the server is too old for the setting.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّث خادم Silo هذا لاختيار فواصل التخطي. يستخدم التشغيل الفواصل المدمجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere diesen Silo-Server, um Sprungintervalle zu wählen. Die Wiedergabe nutzt die integrierten Intervalle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update this Silo server to choose skip intervals. Playback uses the built-in intervals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza este servidor de Silo para elegir los intervalos de salto. La reproducción usa los intervalos predeterminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour ce serveur Silo pour choisir les intervalles de saut. La lecture utilise les intervalles par défaut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキップ間隔を選択するには、このSiloサーバーをアップデートしてください。再生には標準の間隔が使用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize este servidor Silo para escolher os intervalos de salto. A reprodução usa os intervalos padrão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请更新此Silo服务器以选择跳转间隔。播放时将使用内置间隔。"
          }
        }
      }
    },
    "player.seekInterval.unreachable" : {
