          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne izliyoruz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що дивимося?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
