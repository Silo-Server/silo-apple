    "signIn.error.cantSignIn" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV) password sign-in: error when the server refuses this account (HTTP 403).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
