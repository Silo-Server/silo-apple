    "signIn.error.cantSignIn" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV) password sign-in: error when the server refuses this account (HTTP 403).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لهذا الحساب تسجيل الدخول. تواصل مع مسؤول الخادم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този акаунт не може да влезе. Свържете се с администратора на сървъра."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest compte no pot iniciar la sessió. Contacta amb l’administrador del servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento účet se nemůže přihlásit. Obraťte se na správce serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne konto kan ikke logge ind. Kontakt din serveradministrator."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto kann sich nicht anmelden. Wende dich an deinen Server-Administrator."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο λογαριασμός δεν μπορεί να συνδεθεί. Επικοινωνήστε με τον διαχειριστή του διακομιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account can't sign in. Contact your server administrator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta no puede iniciar sesión. Contacta con el administrador del servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle kontoga ei saa sisse logida. Võtke ühendust serveri administraatoriga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä tilillä ei voi kirjautua sisään. Ota yhteyttä palvelimen ylläpitäjään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte ne peut pas se connecter. Contactez l’administrateur de votre serveur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן להתחבר עם החשבון הזה. יש לפנות למנהל השרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस खाते से साइन इन नहीं किया जा सकता। अपने सर्वर एडमिनिस्ट्रेटर से संपर्क करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj se račun ne može prijaviti. Obratite se administratoru poslužitelja."
          }
        },
        "hu" : {
          "stringUnit" : {
