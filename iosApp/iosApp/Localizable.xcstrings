          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レポートを保持しました。サーバーがすでに受信している可能性があるため、再送信はしません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
