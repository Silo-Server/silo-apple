    "newProfile.unconfirmed.body" : {
      "comment" : "Body of the Roku dialog shown when the create-profile request got no server reply; advises checking the profile list before retrying. Apple (iPhone, iPad, Mac, Apple TV): same alert body on the New Profile form.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتلقَّ Silo ردًا من الخادم. تحقق من قائمة الملفات الشخصية قبل المحاولة مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo hat keine Antwort vom Server erhalten. Prüfe die Profilliste, bevor du es erneut versuchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo didn't get an answer from the server. Check the profile list before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no recibió respuesta del servidor. Revisa la lista de perfiles antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a reçu aucune réponse du serveur. Vérifiez la liste des profils avant de réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloはサーバーから応答を受け取れませんでした。もう一度お試しになる前に、プロフィールの一覧を確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo não recebeu resposta do servidor. Confira a lista de perfis antes de tentar novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo未收到服务器的响应。请先检查个人资料列表再重试。"
          }
        }
      }
    },
    "newProfile.unconfirmed.ownerChanged" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): body of the Profile May Have Been Created alert when the server or signed-in account changed before the create finished; the form closes so the user can check the list.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر الخادم أو الحساب أثناء إنشاء الملف الشخصي. تحقق من قائمة الملفات الشخصية قبل المحاولة مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server oder das Konto hat sich beim Erstellen des Profils geändert. Prüfe die Profilliste, bevor du es erneut versuchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server or account changed while creating the profile. Check the profile list before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor o la cuenta cambiaron mientras se creaba el perfil. Revisa la lista de perfiles antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur ou le compte a changé pendant la création du profil. Vérifiez la liste des profils avant de réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールの作成中にサーバーまたはアカウントが変更されました。もう一度お試しになる前に、プロフィールの一覧を確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor ou a conta mudou durante a criação do perfil. Confira a lista de perfis antes de tentar novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建个人资料时服务器或账户发生了变化。请先检查个人资料列表再重试。"
          }
        }
      }
    },
