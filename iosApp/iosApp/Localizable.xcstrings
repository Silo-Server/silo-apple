    "notReady.body" : {
      "comment" : "Body of the Roku not-ready message, asking the user to have the administrator finish setup and then check again. Apple TV: same text on the server needs setup screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من مسؤول الخادم إكمال الإعداد. عندما يصبح جاهزًا، تحقّق مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помолете администратора на сървъра да завърши настройката. Когато сървърът е готов, проверете отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demana a l’administrador del servidor que acabi la configuració. Quan estigui a punt, torna-ho a comprovar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádejte správce serveru o dokončení nastavení. Až bude server připraven, zkontrolujte to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed serveradministratoren om at gøre opsætningen færdig. Tjek igen, når serveren er klar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte die Serveradministration, die Einrichtung abzuschließen. Sobald sie fertig ist, prüfe erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήστε από τον διαχειριστή του διακομιστή να ολοκληρώσει τη ρύθμιση. Όταν είναι έτοιμος, ελέγξτε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the server administrator to finish setup. When it is ready, check again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide a quien administra el servidor que termine la configuración. Cuando esté listo, vuelve a comprobarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paluge serveri administraatoril seadistamine lõpetada. Kui server on valmis, kontrollige uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydä palvelimen ylläpitäjää viimeistelemään määritys. Kun palvelin on valmis, tarkista uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à l’administrateur du serveur de terminer la configuration. Quand le serveur est prêt, vérifiez à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבקש ממנהל השרת להשלים את ההגדרה. כשהשרת יהיה מוכן, אפשר לבדוק שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर एडमिनिस्ट्रेटर से सेटअप पूरा करने के लिए कहें। सर्वर तैयार होने पर फिर से जाँचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamolite administratora poslužitelja da dovrši postavljanje. Kad poslužitelj bude spreman, provjerite ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérje meg a szerver rendszergazdáját, hogy fejezze be a beállítást. Ha elkészült, ellenőrizze újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta administrator server menyelesaikan penyiapan. Jika sudah siap, periksa lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi all’amministratore del server di completare la configurazione. Quando è pronto, controlla di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバー管理者にセットアップの完了を依頼してください。準備ができたら、もう一度確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 관리자에게 설정을 완료해 달라고 요청하세요. 준비되면 다시 확인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paprašykite serverio administratoriaus užbaigti sąranką. Kai serveris bus paruoštas, patikrinkite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lūdziet servera administratoram pabeigt iestatīšanu. Kad serveris būs gatavs, pārbaudiet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta pentadbir pelayan menyelesaikan persediaan. Apabila pelayan sudah sedia, semak lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be serveradministratoren om å fullføre oppsettet. Sjekk igjen når serveren er klar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag de serverbeheerder om de configuratie af te ronden. Controleer het opnieuw zodra de server klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś administratora serwera o dokończenie konfiguracji. Gdy serwer będzie gotowy, sprawdź ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça a quem administra o servidor para concluir a configuração. Quando estiver pronto, verifique novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao administrador do servidor para concluir a configuração. Quando estiver pronto, verifique novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cereți administratorului serverului să finalizeze configurarea. Când serverul este pregătit, verificați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите администратора сервера завершить настройку. Когда всё будет готово, проверьте снова."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požiadajte správcu servera, aby dokončil nastavenie. Keď bude server pripravený, skontrolujte to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosite skrbnika strežnika, naj dokonča nastavitev. Ko bo strežnik pripravljen, preverite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be serverns administratör att slutföra konfigurationen. Kontrollera igen när den är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรดขอให้ผู้ดูแลเซิร์ฟเวอร์ตั้งค่าให้เสร็จ เมื่อพร้อมแล้วให้ตรวจสอบอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu yöneticisinden kurulumu tamamlamasını isteyin. Hazır olduğunda tekrar kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросіть адміністратора сервера завершити налаштування. Коли сервер буде готовий, перевірте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu quản trị viên máy chủ hoàn tất thiết lập. Khi máy chủ sẵn sàng, hãy kiểm tra lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请让服务器管理员完成设置。准备就绪后，再检查一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請伺服器管理員完成設定。設定完成後，請再檢查一次。"
          }
        }
      }
    },
