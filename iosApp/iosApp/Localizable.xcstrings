    "newProfile.error.requestsSupport" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): body of the Couldn't Create Profile alert when the app could not ask the server whether profiles can be blocked from requesting.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى الخادم للتحقق من إعدادات الطلبات لهذا الملف الشخصي. حاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можа да се осъществи връзка със сървъра, за да се проверят настройките за заявки на този профил. Опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut connectar amb el servidor per comprovar les opcions de sol·licituds d’aquest perfil. Torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se spojit se serverem a ověřit nastavení žádostí tohoto profilu. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke kontakte serveren for at tjekke profilens indstillinger for anmodninger. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server war nicht erreichbar, um die Anfrage-Einstellungen dieses Profils zu prüfen. Versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η επικοινωνία με τον διακομιστή για τον έλεγχο των ρυθμίσεων αιτημάτων αυτού του προφίλ. Δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach the server to check this profile's request settings. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con el servidor para comprobar la configuración de solicitudes de este perfil. Vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveriga ei õnnestunud ühendust saada, et kontrollida selle profiili taotluste seadeid. Proovige uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimeen ei saatu yhteyttä tämän profiilin pyyntöasetusten tarkistamiseksi. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le serveur pour vérifier les paramètres de demande de ce profil. Réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה להתחבר לשרת כדי לבדוק את הגדרות הבקשות של הפרופיל הזה. אפשר לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस प्रोफ़ाइल की अनुरोध सेटिंग जाँचने के लिए सर्वर से संपर्क नहीं हो सका। फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće povezati se s poslužiteljem radi provjere postavki zahtjeva za ovaj profil. Pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült elérni a szervert a profil kérési beállításainak ellenőrzéséhez. Próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menjangkau server untuk memeriksa pengaturan permintaan profil ini. Coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere il server per verificare le impostazioni delle richieste di questo profilo. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールのリクエスト設定を確認するためにサーバーに接続できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필의 요청 설정을 확인하기 위해 서버에 연결할 수 없어요. 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko pasiekti serverio, kad būtų patikrinti šio profilio užklausų nustatymai. Bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās sazināties ar serveri, lai pārbaudītu šī profila pieprasījumu iestatījumus. Mēģiniet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menghubungi pelayan untuk menyemak tetapan permintaan profil ini. Cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke nå serveren for å sjekke forespørselsinnstillingene for denne profilen. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de server niet bereiken om de aanvraaginstellingen van dit profiel te controleren. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z serwerem, aby sprawdzić ustawienie „Zezwalaj na prośby” dla tego profilu. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o servidor para verificar as configurações de solicitação deste perfil. Tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível contactar o servidor para verificar as definições de pedidos deste perfil. Tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a putut contacta serverul pentru a verifica setările de cereri ale acestui profil. Încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось связаться с сервером, чтобы проверить настройки запросов для этого профиля. Повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa spojiť so serverom a overiť nastavenia žiadostí tohto profilu. Skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni bilo mogoče vzpostaviti povezave s strežnikom, da bi preverili nastavitve zahtev za ta profil. Poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att nå servern för att kontrollera profilens inställningar för förfrågningar. Försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดต่อเซิร์ฟเวอร์เพื่อตรวจสอบการตั้งค่าคำขอของโปรไฟล์นี้ไม่ได้ โปรดลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu profilin istek ayarlarını denetlemek için sunucuya ulaşılamadı. Tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося зв’язатися із сервером, щоб перевірити налаштування запитів цього профілю. Спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kết nối với máy chủ để kiểm tra cài đặt yêu cầu của hồ sơ này. Vui lòng thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接服务器以检查此个人资料的请求设置。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線至伺服器以檢查這個個人檔案的請求設定。請再試一次。"
          }
        }
      }
    },
