    "notReady.body" : {
      "comment" : "Body of the Roku not-ready message, asking the user to have the administrator finish setup and then check again. Apple TV: same text on the server needs setup screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من مسؤول الخادم إكمال الإعداد. عندما يصبح جاهزًا، تحقّق مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte die Serveradministration, die Einrichtung abzuschließen. Sobald sie fertig ist, prüfe erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the server administrator to finish setup. When it is ready, check again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide a quien administra el servidor que termine la configuración. Cuando esté listo, vuelve a comprobarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à l’administrateur du serveur de terminer la configuration. Quand le serveur est prêt, vérifiez à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバー管理者にセットアップの完了を依頼してください。準備ができたら、もう一度確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça a quem administra o servidor para concluir a configuração. Quando estiver pronto, verifique novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请让服务器管理员完成设置。准备就绪后，再检查一次。"
          }
        }
      }
    },
    "notReady.check" : {
