    "collections.error.changedElsewhere" : {
      "comment" : "Apple iOS and tvOS: error in a collection or group sheet when the item changed elsewhere since the sheet opened. Reload is the button below it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر هذا على جهاز آخر. أعد التحميل لرؤية الإصدار الحالي؛ ستُحفظ تعديلاتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato položka se změnila na jiném zařízení. Načtěte ji znovu a zobrazte aktuální verzi; vaše úpravy zůstanou zachovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette blev ændret på en anden enhed. Genindlæs for at se den aktuelle version. Dine ændringer bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies wurde auf einem anderen Gerät geändert. Wähle „Neu laden“, um die aktuelle Version anzuzeigen; deine Änderungen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This changed on another device. Reload to see the current version; your edits are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto cambió en otro dispositivo. Recarga para ver la versión actual; tus cambios se conservan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä muutettiin toisella laitteella. Näet nykyisen version valitsemalla Lataa uudelleen. Muokkauksesi säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet élément a été modifié sur un autre appareil. Rechargez pour voir la version actuelle ; vos modifications sont conservées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo je promijenjeno na drugom uređaju. Ponovno učitajte kako biste vidjeli trenutačnu verziju; vaše se izmjene zadržavaju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elemento è stato modificato su un altro dispositivo. Ricarica per vedere la versione attuale; le tue modifiche vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のデバイスで変更されました。再読み込みして最新の状態を確認してください。編集内容は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에서 변경됐어요. 새로고침해서 최신 버전을 확인하세요. 편집한 내용은 유지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette ble endret på en annen enhet. Last inn på nytt for å se gjeldende versjon. Endringene dine beholdes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is op een ander apparaat gewijzigd. Laad opnieuw om de huidige versie te zien; je wijzigingen blijven bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten element zmieniono na innym urządzeniu. Wczytaj ponownie, aby zobaczyć aktualną wersję; twoje zmiany zostaną zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso foi alterado em outro dispositivo. Recarregue para ver a versão atual; suas edições serão mantidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные изменены на другом устройстве. Обновите их, чтобы увидеть текущую версию; ваши правки сохранятся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här har ändrats på en annan enhet. Läs in igen för att se den aktuella versionen. Dina ändringar finns kvar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu öğe başka bir cihazda değiştirildi. Güncel sürümü görmek için yeniden yükleyin; düzenlemeleriniz korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це змінено на іншому пристрої. Перезавантажте, щоб побачити поточну версію; ваші зміни збережено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此内容已在其他设备上更改。重新加载以查看当前版本；你的编辑会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此項目已在其他裝置上變更。請重新載入以查看目前版本；你的編輯內容會保留。"
          }
        }
      }
    },
