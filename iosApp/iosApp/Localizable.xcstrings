      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إعداد التشغيل بالمسار الصوتي المحدد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiedergabe konnte mit der ausgewählten Audiospur nicht eingerichtet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback could not be set up with the selected audio track."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo configurar la reproducción con la pista de audio seleccionada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de configurer la lecture avec la piste audio sélectionnée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した音声トラックで再生を準備できませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível configurar a reprodução com a faixa de áudio selecionada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法使用所选音轨设置播放。"
          }
        }
      }
    },
    "player.error.connectionLost" : {
      "comment" : "Apple iOS/tvOS/macOS: video player error screen after reconnecting to the server failed; the first line is a heading, the second the explanation, shown above a Try again button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الاتصال\nتعذّر على Silo إعادة الاتصال بالخادم. تحقق من اتصالك، ثم حاول مرة أخرى لمتابعة المشاهدة من حيث توقفت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung verloren\nSilo konnte keine neue Verbindung zum Server herstellen. Prüfe deine Verbindung und versuche es dann erneut, um dort weiterzuschauen, wo du aufgehört hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connection lost\nSilo couldn't reconnect to the server. Check your connection, then try again to continue where you left off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexión perdida\nSilo no pudo volver a conectarse al servidor. Revisa tu conexión y vuelve a intentarlo para continuar donde lo dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion perdue\nSilo n’a pas pu se reconnecter au serveur. Vérifiez votre connexion, puis réessayez pour reprendre là où vous vous étiez arrêté."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続が切断されました\nSiloはサーバーに再接続できませんでした。接続を確認してから、もう一度お試しください。中断したところから再開します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexão perdida\nNão foi possível reconectar o Silo ao servidor. Verifique sua conexão e tente novamente para continuar de onde parou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接已断开\nSilo无法重新连接到服务器。请检查你的网络连接，然后重试，从上次离开的位置继续播放。"
          }
        }
      }
    },
    "player.error.incompatiblePlan" : {
      "comment" : "Apple iOS/tvOS/macOS: player error when the server's playback plan can't be used by this app version. Used by the audiobook player. Keep \"V3\" as is.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعاد الخادم خطة تشغيل غير متوافقة بالبروتوكول V3."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat einen inkompatiblen Wiedergabeplan für Protokoll V3 zurückgegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server returned an incompatible protocol V3 playback plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor devolvió un plan de reproducción del protocolo V3 incompatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a renvoyé un plan de lecture du protocole V3 incompatible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーから互換性のないプロトコルV3再生プランが返されました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor retornou um plano de reprodução incompatível do protocolo V3."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器返回了不兼容的协议V3播放方案。"
          }
        }
      }
    },
    "player.error.incompatibleReplacementPlan" : {
