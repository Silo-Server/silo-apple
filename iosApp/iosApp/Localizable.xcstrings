          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local report was deleted. Remote deletion is queued and will retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminó el informe local. La eliminación remota está en cola y se volverá a intentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rapport local a été supprimé. La suppression à distance est en file d’attente et sera retentée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルのレポートを削除しました。リモートでの削除はキューに追加され、再試行されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
