    "notReady.unreachable" : {
      "comment" : "Message on Roku after rechecking when the server could not be reached. Apple (iPhone, iPad, Mac, Apple TV): same message after Check again on the server needs setup screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى الخادم. تأكد من أنه قيد التشغيل وحاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можа да се установи връзка със сървъра. Проверете дали работи и опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut connectar amb el servidor. Comprova que estigui en funcionament i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K serveru se nepodařilo připojit. Ověřte, že běží, a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke få forbindelse til serveren. Tjek, at den kører, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server konnte nicht erreicht werden. Prüfe, ob er läuft, und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η σύνδεση με τον διακομιστή. Βεβαιωθείτε ότι λειτουργεί και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach the server. Check it's running and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con el servidor. Comprueba que esté en funcionamiento y vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveriga ei õnnestunud ühendust luua. Kontrollige, kas server töötab, ja proovige uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimeen ei saatu yhteyttä. Varmista, että se on käynnissä, ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le serveur. Vérifiez qu’il est en cours d’exécution et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה להתחבר לשרת. יש לוודא שהשרת פועל ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर से कनेक्ट नहीं हो सका। देखें कि सर्वर चल रहा है, फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće povezati se s poslužiteljem. Provjerite radi li i pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült elérni a szervert. Ellenőrizze, hogy fut-e, majd próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menjangkau server. Pastikan server berjalan, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere il server. Verifica che sia in esecuzione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーに接続できませんでした。サーバーが実行中か確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 연결할 수 없어요. 서버가 실행 중인지 확인하고 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko pasiekti serverio. Patikrinkite, ar jis veikia, ir bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās sasniegt serveri. Pārbaudiet, vai tas darbojas, un mēģiniet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat mencapai pelayan. Pastikan pelayan sedang berjalan dan cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke nå serveren. Sjekk at den kjører, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de server niet bereiken. Controleer of de server draait en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z serwerem. Sprawdź, czy działa, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o servidor. Verifique se ele está em execução e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível contactar o servidor. Verifique se está em execução e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a putut accesa serverul. Verificați dacă rulează și încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к серверу. Убедитесь, что он запущен, и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa pripojiť k serveru. Skontrolujte, či je spustený, a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežnika ni bilo mogoče doseči. Preverite, ali deluje, in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att nå servern. Kontrollera att den körs och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อกับเซิร์ฟเวอร์ไม่ได้ โปรดตรวจสอบว่าเซิร์ฟเวอร์ทำงานอยู่แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucuya ulaşılamadı. Çalıştığından emin olun ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося з’єднатися із сервером. Переконайтеся, що він працює, і спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kết nối với máy chủ. Kiểm tra xem máy chủ có đang chạy không rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到服务器。请确认它正在运行，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線至伺服器。請確認伺服器正在執行，然後再試一次。"
          }
        }
      }
    },
