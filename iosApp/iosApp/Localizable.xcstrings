    "player.aiTranslate.quotaExhaustedNote" : {
      "comment" : "Apple iOS and tvOS: note under the AI subtitles quota line when no audio transcriptions are left.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدمت كل رصيد النسخ لهذه الفترة. لا تزال ترجمة مسار ترجمة موجود متاحة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kredity na přepis pro toto období jsou vyčerpány. Překlad existující stopy titulků stále funguje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har brugt alle dine transskriptionskreditter for denne periode. Du kan stadig oversætte et eksisterende undertekstspor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dein gesamtes Transkriptionskontingent für diesen Zeitraum aufgebraucht. Das Übersetzen einer vorhandenen Untertitelspur funktioniert weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've used all your transcription credits for this period. Translating an existing subtitle track still works."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has usado todos tus créditos de transcripción de este periodo. Aún puedes traducir una pista de subtítulos existente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet käyttänyt kaikki tämän jakson litterointikertasi. Olemassa olevan tekstitysraidan kääntäminen toimii edelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez utilisé tous vos crédits de transcription pour cette période. La traduction d’une piste de sous-titres existante reste possible."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskoristili ste sve transkripcije za ovo razdoblje. Prevođenje postojećih titlova i dalje radi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai usato tutti i crediti di trascrizione per questo periodo. Puoi comunque tradurre una traccia di sottotitoli esistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この期間の文字起こしクレジットをすべて使用しました。既存の字幕トラックの翻訳は引き続き利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기간의 음성 인식 한도를 모두 사용했어요. 기존 자막 트랙 번역은 계속 사용할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har brukt alle transkriberingskredittene dine for denne perioden. Du kan fortsatt oversette et eksisterende undertekstspor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt al je transcriptietegoed voor deze periode gebruikt. Een bestaand ondertitelspoor vertalen werkt nog steeds."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykorzystano wszystkie kredyty transkrypcji w tym okresie. Tłumaczenie istniejących ścieżek napisów nadal działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você usou todos os seus créditos de transcrição deste período. Ainda é possível traduzir uma faixa de legendas existente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы использовали весь лимит транскрибации на этот период. Перевод имеющихся дорожек субтитров по-прежнему доступен."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har använt alla dina transkriberingskrediter för den här perioden. Det går fortfarande att översätta ett befintligt undertextspår."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dönem için tüm transkripsiyon haklarınızı kullandınız. Mevcut bir altyazı parçasını çevirmek yine de mümkün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви використали всі транскрипції на цей період. Переклад наявних субтитрів і далі доступний."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已用完本周期的全部转录额度。翻译现有字幕轨道仍可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已用完此期間的所有轉錄額度。仍可翻譯現有的字幕軌。"
          }
        }
      }
    },
