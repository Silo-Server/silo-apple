    "settings.connection.skippedCellular" : {
      "comment" : "Footnote in Android connection settings explaining speed tests are not run on mobile data, where the Cellular Quality settings apply instead. Apple Settings > Playback (iPhone, iPad, Mac) (iPhone, iPad): replaces the connection speed on cellular.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُجرى اختبارات السرعة على شبكة الهاتف المحمول، وتُطبَّق إعدادات جودة شبكة الهاتف المحمول."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тестовете за скорост не се изпълняват при мобилни данни и се прилагат настройките „Качество при мобилни данни“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les proves de velocitat no es fan amb dades mòbils, i s’apliquen les opcions de Qualitat amb dades mòbils."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na mobilních datech se test rychlosti neprovádí a platí nastavení kvality pro mobilní data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hastighedstests springes over på mobilnetværk, og indstillingerne for Mobilkvalitet gælder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über Mobilfunk werden keine Geschwindigkeitstests ausgeführt; es gelten die Einstellungen unter „Mobilfunkqualität“."
