    "diagnostics.consent.chooseDescription" : {
      "comment" : "Apple TV Settings > Diagnostics > Crash Reports: explanation above the Ask, Always and Never choices.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما يجب أن يفعله Silo عند توفر تقرير عن عطل أو تجمّد أو إيقاف غير سليم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете какво да прави Silo, когато е наличен отчет за срив, блокиране или неправилно затваряне."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria què ha de fer Silo quan hi hagi disponible un informe d’error, de bloqueig o d’aturada incorrecta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, co má Silo udělat, když je k dispozici zpráva o pádu, zamrznutí nebo neočekávaném ukončení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvad Silo skal gøre, når en rapport om et nedbrud, en hængning eller en ukorrekt nedlukning er tilgængelig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, was Silo tun soll, wenn ein Bericht zu einem Absturz, einem Hänger oder einem unerwarteten Beenden verfügbar ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε τι θα κάνει το Silo όταν υπάρχει διαθέσιμη αναφορά κατάρρευσης, μη απόκρισης ή μη ομαλού τερματισμού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what Silo should do when a crash, hang, or unclean shutdown report is available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué debe hacer Silo cuando haya disponible un informe de fallo, bloqueo o cierre anómalo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valige, mida Silo peaks tegema, kui saadaval on kokkujooksmise, hangumise või ebakorrektse sulgumise aruanne."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, mitä Silon pitää tehdä, kun kaatumisesta, jumiutumisesta tai virheellisestä sammumisesta on saatavilla raportti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ce que Silo doit faire lorsqu’un rapport de plantage, de blocage ou d’arrêt inattendu est disponible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבחור מה Silo יעשה כשיש דוח על קריסה, תקיעה או כיבוי לא תקין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्रैश, हैंग या अचानक बंद होने की रिपोर्ट उपलब्ध होने पर Silo को क्या करना चाहिए, यह चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite što Silo treba učiniti kad je dostupno izvješće o rušenju, zastoju ili nepravilnom gašenju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki, mit tegyen a Silo, ha összeomlásról, lefagyásról vagy váratlan leállásról szóló jelentés áll rendelkezésre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tindakan Silo saat laporan crash, macet, atau penutupan tidak normal tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli cosa deve fare Silo quando è disponibile un report su un arresto anomalo, un blocco o una chiusura non corretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュ、ハング、または異常終了のレポートがあるときのSiloの動作を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충돌, 응답 없음 또는 비정상 종료 보고서가 있을 때 Silo에서 할 작업을 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkite, ką „Silo“ turėtų daryti, kai yra pranešimas apie strigtį, nereagavimą ar netikėtą išsijungimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvēlieties, kā Silo lietotnei rīkoties, kad ir pieejams pārskats par avāriju, sastingšanu vai nekorektu izslēgšanos."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tindakan Silo apabila laporan ranap, tergantung atau penutupan tidak bersih tersedia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hva Silo skal gjøre når en rapport om krasj, heng eller unormal avslutning er tilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies wat Silo moet doen als er een rapport over een crash, vastloper of onjuiste afsluiting beschikbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, co aplikacja Silo ma zrobić, gdy dostępny jest raport o awarii, zawieszeniu lub nieprawidłowym zamknięciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o que o Silo deve fazer quando houver um relatório de falha, travamento ou encerramento inesperado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o que o Silo deve fazer quando estiver disponível um relatório de falha, bloqueio ou encerramento incorreto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți ce ar trebui să facă Silo când este disponibil un raport de blocare, de lipsă de răspuns sau de închidere incorectă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, что должно делать приложение Silo, когда доступен отчёт о сбое, зависании или некорректном завершении работы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, čo má Silo urobiť, keď je k dispozícii hlásenie o zlyhaní, zamrznutí alebo nečakanom vypnutí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izberite, kaj naj Silo naredi, ko je na voljo poročilo o zrušitvi, zamrznitvi ali nepravilni zaustavitvi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj vad Silo ska göra när det finns en rapport om en krasch, en frysning eller en oväntad avstängning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกสิ่งที่ Silo ควรทำเมื่อมีรายงานข้อขัดข้อง การค้าง หรือการปิดแอปผิดปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
