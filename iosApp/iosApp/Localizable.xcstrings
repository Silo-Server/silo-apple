          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешайте, только если вы сами начали вход на своём телефоне или планшете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt bara detta om du startade det på din egen telefon eller surfplatta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bunu kendi telefonunuzda veya tabletinizde başlattıysanız izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяйте, лише якщо ви самі почали це на своєму телефоні або планшеті."
          }
        },
        "zh-Hans" : {
