    "home.forYou.savedFallback" : {
      "comment" : "Caption on the For You tab when the server has no recommendations and the tab shows the Watchlist or Favorites instead (Android phone and TV, Apple iOS and macOS).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
