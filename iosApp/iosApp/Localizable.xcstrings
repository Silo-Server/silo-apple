    "collections.group.deleteBody" : {
      "comment" : "Apple iOS and tvOS: explanation in the sheet that confirms deleting a collection group. Ungrouped is the section for collections without a group.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستنتقل المجموعات في هذه الفئة إلى «بدون فئة». لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колекциите в тази група ще бъдат преместени в „Без група“. Това не може да се отмени."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les col·leccions d’aquest grup passaran a Sense grup. Aquesta acció no es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolekce v této skupině se přesunou do sekce Bez skupiny. Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samlinger i denne gruppe flyttes til Uden gruppe. Dette kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammlungen in dieser Gruppe werden nach „Ohne Gruppe“ verschoben. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συλλογές αυτής της ομάδας θα μετακινηθούν στην ενότητα «Χωρίς ομάδα». Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collections in this group will move to Ungrouped. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las colecciones de este grupo pasarán a Sin grupo. Esta acción no se puede deshacer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle grupi kollektsioonid teisaldatakse jaotisse „Grupeerimata“. Seda ei saa tagasi võtta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän ryhmän kokoelmat siirtyvät kohtaan Ryhmittelemättömät. Tätä ei voi kumota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les collections de ce groupe seront déplacées dans Sans groupe. Cette action est irréversible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האוספים בקבוצה הזו יועברו אל ”ללא קבוצה”. אי אפשר לבטל את הפעולה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ग्रुप के कलेक्शन बिना ग्रुप सेक्शन में चले जाएँगे। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolekcije iz ove grupe premjestit će se u odjeljak Bez grupe. Ovo se ne može poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A csoport gyűjteményei a Csoportosítatlan szakaszba kerülnek. Ez nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koleksi dalam grup ini akan dipindahkan ke Tanpa grup. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccolte di questo gruppo verranno spostate in Senza gruppo. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグループのコレクションは「グループなし」に移動します。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 그룹의 컬렉션은 “그룹 없음”으로 이동해요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šios grupės kolekcijos bus perkeltos į skiltį „Be grupės“. Šio veiksmo anuliuoti negalima."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šīs grupas kolekcijas tiks pārvietotas uz sadaļu „Bez grupas”. Šo darbību nevar atsaukt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koleksi dalam kumpulan ini akan dipindahkan ke Tanpa kumpulan. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samlinger i denne gruppen flyttes til Uten gruppe. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collecties in deze groep gaan naar Niet gegroepeerd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolekcje z tej grupy zostaną przeniesione do sekcji Bez grupy. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As coleções deste grupo serão movidas para Sem grupo. Não é possível desfazer esta ação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As coleções deste grupo vão passar para Sem grupo. Esta ação não pode ser anulada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colecțiile din acest grup vor fi mutate în Fără grup. Această acțiune nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коллекции из этой группы переместятся в раздел «Без группы». Это действие нельзя отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolekcie v tejto skupine sa presunú do sekcie Bez skupiny. Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbirke v tej skupini bodo premaknjene v razdelek Brez skupine. Tega ni mogoče razveljaviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samlingar i den här gruppen flyttas till Ogrupperade. Det här går inte att ångra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คอลเลกชันในกลุ่มนี้จะย้ายไปที่ “ไม่ได้จัดกลุ่ม” การดำเนินการนี้เลิกทำไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu gruptaki koleksiyonlar Gruplanmamış kısmına taşınır. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колекції з цієї групи буде переміщено до розділу «Без групи». Цю дію неможливо скасувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bộ sưu tập trong nhóm này sẽ được chuyển sang Chưa phân nhóm. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此分组中的合集将移至未分组。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個群組中的合輯會移至「未分組」。此動作無法復原。"
          }
        }
      }
    },
