    "detail.episodes.loadMoreFailed" : {
      "comment" : "Apple tvOS: message under the episode rail on a series page when the next or previous season's episodes failed to load. Moving focus away and back retries.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل المزيد من الحلقات. انتقل بعيدًا ثم عُد لإعادة المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere Folgen konnten nicht geladen werden. Wechsle den Fokus und kehre zurück, um es erneut zu versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load more episodes. Move away and back to retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar más episodios. Mueve el foco fuera y vuelve para reintentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger d’autres épisodes. Déplacez la sélection puis revenez pour réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エピソードをさらに読み込めませんでした。フォーカスを移動して戻すと再試行します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar mais episódios. Saia e volte para tentar novamente."
