    "settings.signIn.noLocalPasswordAdministrator" : {
      "comment" : "Apple Settings > Sign-in > Connect (iPhone, iPad, Mac): error when the account has no Silo password, so it can't confirm a new link.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد لحسابك كلمة مرور Silo للتأكيد بها. اطلب من المسؤول ربط المزود."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto hat kein Silo-Passwort zur Bestätigung. Bitte einen Administrator, den Anbieter zu verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account has no Silo password to confirm with. Ask an administrator to connect the provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
