    "pairing.summary.unreachable" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: result line when the TV couldn't reach the server address the phone sent. {server}: the server's name, followed by \" — \" and the account name when there is one (for example Home — sam).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: تعذّر على التلفزيون الوصول إلى هذا العنوان. اتبع الخطوات على التلفزيون، أو أعدّ التلفزيون باستخدام العنوان العام للخادم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: телевизорът няма връзка с този адрес. Следвайте стъпките на телевизора или го настройте с публичния адрес на сървъра."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: la TV no ha pogut connectar amb aquesta adreça. Segueix els passos de la TV o configura la TV amb l’adreça pública del servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: televize se nemohla spojit s touto adresou. Postupujte podle pokynů na televizi nebo televizi nastavte s veřejnou adresou serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: tv’et kunne ikke nå denne adresse. Følg trinnene på tv’et, eller konfigurer tv’et med serverens offentlige adresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Der Fernseher konnte diese Adresse nicht erreichen. Folge den Schritten auf dem Fernseher oder richte den Fernseher mit der öffentlichen Adresse des Servers ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: η τηλεόραση δεν μπόρεσε να επικοινωνήσει με αυτή τη διεύθυνση. Ακολουθήστε τα βήματα στην τηλεόραση ή ρυθμίστε την τηλεόραση με τη δημόσια διεύθυνση του διακομιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: the TV couldn't reach this address. Follow the steps on the TV, or set the TV up with the server's public address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: la TV no pudo contactar con esta dirección. Sigue los pasos en la TV o configura la TV con la dirección pública del servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: teler ei saanud selle aadressiga ühendust. Järgige teleris kuvatavaid juhiseid või seadistage teler serveri avaliku aadressiga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: tv ei saanut yhteyttä tähän osoitteeseen. Noudata tv:n ohjeita tai määritä tv palvelimen julkisella osoitteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : la TV n’a pas pu joindre cette adresse. Suivez les étapes sur la TV ou configurez la TV avec l’adresse publique du serveur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: הטלוויזיה לא הצליחה ליצור קשר עם הכתובת הזו. יש לבצע את השלבים שבטלוויזיה, או להגדיר את הטלוויזיה עם הכתובת הציבורית של השרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: टीवी इस पते तक नहीं पहुँच सका। टीवी पर दिए गए चरणों का पालन करें, या सर्वर के सार्वजनिक पते से टीवी सेट अप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: TV ne može pristupiti ovoj adresi. Slijedite korake na TV-u ili postavite TV s javnom adresom poslužitelja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: a TV nem érte el ezt a címet. Kövesse a TV-n látható lépéseket, vagy állítsa be a TV-t a szerver nyilvános címével."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: TV tidak dapat menjangkau alamat ini. Ikuti langkah-langkah di TV, atau siapkan TV dengan alamat publik server."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: la TV non è riuscita a raggiungere questo indirizzo. Segui i passaggi sulla TV o configura la TV con l’indirizzo pubblico del server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：テレビからこのアドレスに接続できませんでした。テレビの手順に従うか、サーバーの公開アドレスを使ってテレビをセットアップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: TV에서 이 주소에 연결할 수 없어요. TV에 표시된 단계를 따르거나 서버의 공개 주소로 TV를 설정하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: televizoriui nepavyko pasiekti šio adreso. Atlikite televizoriuje nurodytus veiksmus arba nustatykite televizorių naudodami viešąjį serverio adresą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: televizors nevarēja sasniegt šo adresi. Izpildiet televizorā redzamās darbības vai iestatiet televizoru, izmantojot servera publisko adresi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: TV tidak dapat menghubungi alamat ini. Ikut langkah pada TV, atau sediakan TV dengan alamat awam pelayan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: TV-en kunne ikke nå denne adressen. Følg trinnene på TV-en, eller konfigurer TV-en med den offentlige adressen til serveren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: de tv kan dit adres niet bereiken. Volg de stappen op de tv of stel de tv in met het openbare adres van de server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: telewizor nie mógł połączyć się z tym adresem. Wykonaj kroki wyświetlone na telewizorze lub skonfiguruj telewizor z publicznym adresem serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: a TV não conseguiu acessar este endereço. Siga as etapas na TV ou configure a TV com o endereço público do servidor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: a TV não conseguiu contactar este endereço. Siga os passos na TV ou configure a TV com o endereço público do servidor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: televizorul nu a putut accesa această adresă. Urmați pașii de pe televizor sau configurați televizorul cu adresa publică a serverului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: телевизору не удалось подключиться по этому адресу. Следуйте инструкциям на телевизоре или настройте телевизор с публичным адресом сервера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: televízor sa nemohol spojiť s touto adresou. Postupujte podľa krokov v televízore alebo televízor nastavte s verejnou adresou servera."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: televizor ni mogel doseči tega naslova. Sledite korakom na televizorju ali televizor nastavite z javnim naslovom strežnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: tv:n kunde inte nå den här adressen. Följ stegen på tv:n eller konfigurera tv:n med serverns offentliga adress."
          }
        },
        "th" : {
          "stringUnit" : {
