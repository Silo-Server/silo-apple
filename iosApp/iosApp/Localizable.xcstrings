    "remote.error.reconnectFailed" : {
      "comment" : "Apple iOS: Remote Control error shown on the remote when playing from the phone could not reconnect to the last TV. 1: the TV's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت إعادة الاتصال بـ %1$@. اختر تلفزيونًا لمواصلة التشغيل عليه، أو أوقف وضع التحكم للتشغيل هنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se znovu připojit k televizi %1$@. Vyberte televizi, chcete-li na ní pokračovat v přehrávání, nebo vypněte režim ovládání a přehrávejte zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke genoprette forbindelsen til %1$@. Vælg et tv for at fortsætte afspilningen der, eller slå styringstilstand fra for at afspille her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zu %1$@ konnte nicht wiederhergestellt werden. Wähle einen Fernseher, um dort weiterzuschauen, oder schalte den Steuerungsmodus aus, um hier abzuspielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reconnect to %1$@. Choose a TV to keep playing there, or turn off control mode to play here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo volver a conectar con %1$@. Elige una TV para seguir reproduciendo allí o desactiva el modo de control para reproducir aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteyden palauttaminen laitteeseen %1$@ epäonnistui. Valitse tv, jos haluat jatkaa toistoa siellä, tai poista ohjaustila käytöstä toistaaksesi täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de se reconnecter à %1$@. Choisissez une TV pour y poursuivre la lecture, ou désactivez le mode de contrôle pour lire ici."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponovno povezivanje s uređajem %1$@ nije uspjelo. Odaberite TV za nastavak reprodukcije na njemu ili isključite način upravljanja za reprodukciju ovdje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile ricollegarsi a %1$@. Scegli una TV per continuare a guardare lì, oppure disattiva la modalità controllo per riprodurre qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に再接続できませんでした。そのテレビで再生を続けるにはテレビを選択し、このデバイスで再生するには操作モードをオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에 다시 연결할 수 없어요. TV에서 계속 재생하려면 TV를 선택하고, 여기에서 재생하려면 제어 모드를 끄세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke koble til %1$@ igjen. Velg en TV for å fortsette avspillingen der, eller slå av kontrollmodus for å spille av her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan niet opnieuw verbinden met %1$@. Kies een tv om daar verder te kijken, of zet de bedieningsmodus uit om hier af te spelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się ponownie połączyć z telewizorem %1$@. Wybierz telewizor, aby oglądać na nim dalej, lub wyłącz tryb sterowania, aby odtwarzać tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível reconectar a %1$@. Escolha uma TV para continuar assistindo nela ou desative o modo de controle para reproduzir aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось повторно подключиться к телевизору «%1$@». Выберите телевизор, чтобы продолжить воспроизведение на нём, или выключите режим управления, чтобы смотреть здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att återansluta till %1$@. Välj en tv för att fortsätta spela upp där, eller stäng av styrningsläget för att spela upp här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ cihazına yeniden bağlanılamadı. Orada oynatmaya devam etmek için bir TV seçin veya burada oynatmak için kontrol modunu kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося повторно під’єднатися до %1$@. Виберіть телевізор, щоб продовжити відтворення на ньому, або вимкніть режим керування, щоб відтворювати тут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法重新连接到%1$@。选择一台电视以继续在电视上播放，或关闭控制模式以在此处播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法重新連線至 %1$@。選擇電視以繼續在該處播放，或關閉控制模式以在這裡播放。"
          }
        }
      }
    },
