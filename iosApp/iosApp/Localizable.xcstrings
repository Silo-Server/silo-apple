    "downloads.reclaim.finishedCount" : {
      "comment" : "Apple iOS/macOS: Free Up Space sheet, opened from the Downloads tab; line above the list. {count}: how many; {count_text}: the same number as written by the app (a count that can pass 999 goes in as text).",
