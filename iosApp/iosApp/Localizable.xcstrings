    "watchParty.invite.body" : {
      "comment" : "Roku, Android phone and TV: explanation on the invite dialog saying who can use the code. Apple (iPhone, iPad, Apple TV): same line on the invitation page.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
