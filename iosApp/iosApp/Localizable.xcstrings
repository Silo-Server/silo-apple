    "settings.interface.deviceOverride" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac): notice when this device still has its own card settings from an older version, which win over the settings synced across devices of its kind.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لدى هذا الجهاز إعدادات واجهة قديمة خاصة به تتجاوز مزامنة فئة الأجهزة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това устройство има по-стари собствени настройки на интерфейса, които имат предимство пред синхронизацията за този вид устройства."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest dispositiu té una configuració d’interfície pròpia més antiga que té prioritat sobre la sincronització de la família de dispositius."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zařízení má starší vlastní nastavení rozhraní, které má přednost před synchronizací mezi zařízeními stejného typu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed har ældre enhedsspecifikke indstillinger for brugerfladen, der tilsidesætter synkroniseringen mellem enheder af samme type."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat ältere gerätespezifische Oberflächeneinstellungen, die die Synchronisierung der Gerätefamilie überschreiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή έχει παλαιότερες ρυθμίσεις διεπαφής ειδικά για τη συσκευή, που υπερισχύουν του συγχρονισμού μεταξύ συσκευών του ίδιου τύπου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device has older device-specific interface settings that override family sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tiene una configuración de interfaz propia más antigua que prevalece sobre la sincronización con dispositivos similares."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selles seadmes on vanemad seadmepõhised liidese seaded, mis alistavad seadmeperekonna sünkroonimise."
          }
        },
        "fi" : {
          "stringUnit" : {
