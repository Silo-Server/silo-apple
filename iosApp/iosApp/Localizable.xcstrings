    "home.recipe.anniversariesDefault.description" : {
      "comment" : "One-line description of the Anniversaries preset in the Add row gallery (shared key `home.recipe.anniversariesDefault.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عناوين تحتفل هذا الشهر بذكرى بارزة لإصدارها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заглавия, които този месец празнуват кръгла годишнина от излизането си."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Títols que aquest mes celebren un aniversari destacat de l’estrena."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tituly, které tento měsíc slaví významné výročí vydání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titler, der fejrer et rundt udgivelsesjubilæum i denne måned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titel, deren Veröffentlichung diesen Monat ein rundes Jubiläum feiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τίτλοι που γιορτάζουν μια σημαντική επέτειο κυκλοφορίας αυτόν τον μήνα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titles celebrating a milestone release anniversary this month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Títulos que celebran este mes un aniversario redondo de su estreno."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pealkirjad, mille ilmumisest möödub sel kuul tähtis aastapäev."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimikkeet, joiden julkaisusta tulee tässä kuussa merkkivuosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titres qui fêtent un anniversaire de sortie marquant ce mois-ci."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פריטים שמציינים החודש יום שנה עגול ליציאתם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसे टाइटल जिनकी रिलीज़ की खास सालगिरह इस महीने है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naslovi koji ovog mjeseca slave značajnu godišnjicu izlaska."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerek megjelenési évfordulót ünneplő címek ebben a hónapban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judul yang merayakan hari jadi rilis penting bulan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titoli che questo mese festeggiano un anniversario importante dall’uscita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今月、公開から節目の周年を迎える作品。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 달에 뜻깊은 개봉 기념일을 맞은 작품."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūriniai, kurių išleidimo jubiliejus minimas šį mėnesį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
