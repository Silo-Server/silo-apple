        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna indietro di questo intervallo quando riprendi un titolo visto in parte, per ritrovare il filo. Con 0 è disattivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "途中まで視聴した項目を再開するとき、内容を思い出せるようにこの秒数だけ巻き戻します。0にするとオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 시청한 항목을 이어서 재생할 때 흐름을 다시 파악할 수 있도록 이만큼 뒤로 돌아가요. 0으로 설정하면 꺼져요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tęsiant iš dalies peržiūrėtą elementą, persukti tiek atgal, kad prisimintumėte kontekstą. Nustačius 0, funkcija išjungiama."
