    "signIn.passwordChange.lead" : {
      "comment" : "Apple (iPhone, iPad, Mac) and Android phone Choose a new password screen: line under the headline. {account}: the account's username.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عيّن المسؤول كلمة مرور مؤقتة للحساب %1$@. اختر كلمة مرور خاصة بك للمتابعة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Администратор зададе временна парола за акаунта %1$@. Изберете своя, за да продължите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un administrador ha definit una contrasenya temporal per al compte %1$@. Tria’n una de pròpia per continuar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Správce nastavil pro účet %1$@ dočasné heslo. Zvolte si vlastní a pokračujte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En administrator har angivet en midlertidig adgangskode for %1$@. Vælg din egen for at fortsætte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Admin hat ein temporäres Passwort für %1$@ festgelegt. Wähle ein eigenes, um fortzufahren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας διαχειριστής όρισε προσωρινό κωδικό πρόσβασης για τον λογαριασμό %1$@. Επιλέξτε τον δικό σας για να συνεχίσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An admin set a temporary password for %1$@. Choose your own to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un administrador estableció una contraseña temporal para %1$@. Elige la tuya para continuar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administraator määras kontole %1$@ ajutise parooli. Jätkamiseks valige oma parool."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ylläpitäjä asetti väliaikaisen salasanan tilille %1$@. Jatka valitsemalla oma salasana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un administrateur a défini un mot de passe temporaire pour %1$@. Choisissez le vôtre pour continuer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מנהל הגדיר סיסמה זמנית לחשבון %1$@. יש לבחור סיסמה משלך כדי להמשיך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक एडमिन ने %1$@ के लिए अस्थायी पासवर्ड सेट किया है। जारी रखने के लिए अपना पासवर्ड चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrator je za račun %1$@ postavio privremenu lozinku. Odaberite vlastitu za nastavak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy rendszergazda ideiglenes jelszót állított be a következő fiókhoz: %1$@. A folytatáshoz válasszon saját jelszót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admin menetapkan kata sandi sementara untuk akun %1$@. Pilih kata sandi Anda sendiri untuk melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
