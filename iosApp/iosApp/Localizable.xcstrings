            "value" : "Этот провайдер входа больше недоступен на этом сервере."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggningsleverantören är inte längre tillgänglig på den här servern."
          }
        },
        "tr" : {
