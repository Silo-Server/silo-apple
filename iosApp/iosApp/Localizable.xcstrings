    "diagnostics.destination.hostedDefaultDescription" : {
      "comment" : "Apple TV Settings > Diagnostics > Send Reports To: explanation above the destination choices. Silo Diagnostics is a product name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics هو الخيار الافتراضي ولا يتطلب تخزين بيانات التشخيص على خادمك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics je výchozí volba a nevyžaduje úložiště diagnostiky na vašem vlastním serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics er standard og kræver ikke lager til diagnosticering på din egen server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics ist die Standardeinstellung und benötigt keinen Diagnosespeicher auf deinem eigenen Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics is the default and does not require diagnostics storage on your own server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics es la opción predeterminada y no requiere almacenamiento de diagnósticos en tu propio servidor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics on oletus, eikä se vaadi diagnostiikan tallennustilaa omalla palvelimellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics est la destination par défaut et ne nécessite aucun stockage de diagnostics sur votre propre serveur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics zadana je opcija i ne zahtijeva pohranu dijagnostike na vašem vlastitom poslužitelju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics è la destinazione predefinita e non richiede spazio per la diagnostica sul tuo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnosticsがデフォルトです。自分のサーバーに診断用のストレージを用意する必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics가 기본값이며 자체 서버에 진단 저장 공간이 필요하지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics er standard og krever ikke diagnostikklagring på din egen server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics is de standaard en vereist geen diagnostiekopslag op je eigen server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics to opcja domyślna, która nie wymaga miejsca na dane diagnostyczne na twoim serwerze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo Diagnostics é o padrão e não exige armazenamento de diagnóstico no seu próprio servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics используется по умолчанию и не требует хранилища диагностики на вашем собственном сервере."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics är standard och kräver ingen diagnostiklagring på din egen server."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics varsayılan seçenektir ve kendi sunucunuzda tanılama depolaması gerektirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics використовується за замовчуванням і не потребує сховища діагностики на вашому власному сервері."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics是默认选项，无需在你自己的服务器上配置诊断存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics 為預設選項，不需要在你自己的伺服器上提供診斷儲存空間。"
          }
        }
      }
    },
