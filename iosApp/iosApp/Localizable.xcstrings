            "value" : "Silo Diagnostics varsayılan seçenektir ve kendi sunucunuzda tanılama depolaması gerektirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics використовується за замовчуванням і не потребує сховища діагностики на вашому власному сервері."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics là tùy chọn mặc định và không yêu cầu bộ nhớ chẩn đoán trên máy chủ của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics是默认选项，无需在你自己的服务器上配置诊断存储。"
