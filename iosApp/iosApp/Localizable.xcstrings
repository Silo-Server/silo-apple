        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir ayrıntı sayfasından favori ekleyin, burada görünürler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте вміст до обраного на будь-якій сторінці з подробицями, і він з’явиться тут."
