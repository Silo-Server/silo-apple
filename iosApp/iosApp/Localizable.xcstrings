    "diagnostics.hostedDisclosure" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics, and the diagnostics prompt: privacy note shown when reports go to Silo Diagnostics, the Silo project's hosted service. {days}: how many days the service keeps a report (30 today).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تستخدم التقارير المستضافة بيانات اعتماد تثبيت مستعارة غير مرتبطة بحسابك في Silo. وتستبعد معرّفات الحساب والملف الشخصي وعنوان الخادم وجلسة التشغيل، ويُحتفظ بها لمدة تصل إلى %1$lld أيام، ولا تُرسل تلقائيًا أبدًا."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تستخدم التقارير المستضافة بيانات اعتماد تثبيت مستعارة غير مرتبطة بحسابك في Silo. وتستبعد معرّفات الحساب والملف الشخصي وعنوان الخادم وجلسة التشغيل، ويُحتفظ بها لمدة تصل إلى %1$lld يومًا، ولا تُرسل تلقائيًا أبدًا."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تستخدم التقارير المستضافة بيانات اعتماد تثبيت مستعارة غير مرتبطة بحسابك في Silo. وتستبعد معرّفات الحساب والملف الشخصي وعنوان الخادم وجلسة التشغيل، ويُحتفظ بها لمدة تصل إلى يوم واحد، ولا تُرسل تلقائيًا أبدًا."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تستخدم التقارير المستضافة بيانات اعتماد تثبيت مستعارة غير مرتبطة بحسابك في Silo. وتستبعد معرّفات الحساب والملف الشخصي وعنوان الخادم وجلسة التشغيل، ويُحتفظ بها لمدة تصل إلى %1$lld يوم، ولا تُرسل تلقائيًا أبدًا."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تستخدم التقارير المستضافة بيانات اعتماد تثبيت مستعارة غير مرتبطة بحسابك في Silo. وتستبعد معرّفات الحساب والملف الشخصي وعنوان الخادم وجلسة التشغيل، ويُحتفظ بها لمدة تصل إلى يومين، ولا تُرسل تلقائيًا أبدًا."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تستخدم التقارير المستضافة بيانات اعتماد تثبيت مستعارة غير مرتبطة بحسابك في Silo. وتستبعد معرّفات الحساب والملف الشخصي وعنوان الخادم وجلسة التشغيل، ويُحتفظ بها لمدة تصل إلى %1$lld يوم، ولا تُرسل تلقائيًا أبدًا."
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Gehostete Berichte verwenden eine pseudonyme Installationskennung, die nicht mit deinem Silo-Konto verknüpft ist. Sie enthalten keine Konto-, Profil-, Serveradressen- oder Wiedergabe-Sitzungskennungen, werden bis zu %1$lld Tag aufbewahrt und nie automatisch gesendet."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Gehostete Berichte verwenden eine pseudonyme Installationskennung, die nicht mit deinem Silo-Konto verknüpft ist. Sie enthalten keine Konto-, Profil-, Serveradressen- oder Wiedergabe-Sitzungskennungen, werden bis zu %1$lld Tage aufbewahrt und nie automatisch gesendet."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Hosted reports use a pseudonymous installation credential that is not linked to your Silo account. They omit account, profile, server address, and playback session identifiers, are retained for up to %1$lld day, and are never sent automatically."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Hosted reports use a pseudonymous installation credential that is not linked to your Silo account. They omit account, profile, server address, and playback session identifiers, are retained for up to %1$lld days, and are never sent automatically."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Los informes alojados usan una credencial de instalación seudónima que no está vinculada a tu cuenta de Silo. Omiten los identificadores de cuenta, perfil, dirección del servidor y sesión de reproducción, se conservan hasta %1$lld de días y nunca se envían automáticamente."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Los informes alojados usan una credencial de instalación seudónima que no está vinculada a tu cuenta de Silo. Omiten los identificadores de cuenta, perfil, dirección del servidor y sesión de reproducción, se conservan hasta %1$lld día y nunca se envían automáticamente."
                }
