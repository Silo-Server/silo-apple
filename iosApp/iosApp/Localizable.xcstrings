    "diagnostics.consent.chooseDescription" : {
      "comment" : "Apple TV Settings > Diagnostics > Crash Reports: explanation above the Ask, Always and Never choices.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما يجب أن يفعله Silo عند توفر تقرير عن عطل أو تجمّد أو إيقاف غير سليم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, was Silo tun soll, wenn ein Bericht zu einem Absturz, einem Hänger oder einem unerwarteten Beenden verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what Silo should do when a crash, hang, or unclean shutdown report is available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué debe hacer Silo cuando haya disponible un informe de fallo, bloqueo o cierre anómalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
