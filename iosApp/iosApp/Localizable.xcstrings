    "player.notice.pipFailed" : {
      "comment" : "Apple iOS: video player notice text under Picture in Picture failed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على iOS بدء وضع صورة داخل صورة لهذا الفيديو."
          }
        },
        "bg" : {
          "stringUnit" : {
