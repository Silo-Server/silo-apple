    "watchParty.error.alreadyInParty" : {
      "comment" : "Roku: error shown when joining while already in another party. Apple (iPhone, iPad, Apple TV): same error on the Watch Party hub.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
