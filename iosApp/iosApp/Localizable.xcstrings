    "watchParty.rejoin.takeOver" : {
      "comment" : "Roku: warning under the rejoin button. Rejoining on this device kicks the same profile off the party on its other device. Apple (iPhone, iPad, Apple TV): same line on the Watch Party hub.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانضمام مجددًا هنا يفصل الجهاز الآخر لهذا الملف الشخصي عن Watch Party."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако се присъедините отново тук, другото устройство на този профил ще бъде изключено от Watch Party."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si hi tornes aquí, l’altre dispositiu d’aquest perfil es desconnectarà de la Watch Party."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opětovným připojením zde se druhé zařízení tohoto profilu od Watch Party odpojí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du deltager igen her, afbrydes denne profils anden enhed fra festen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du hier wieder beitrittst, wird das andere Gerät dieses Profils von der Party getrennt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν συνδεθείτε ξανά εδώ, η άλλη συσκευή αυτού του προφίλ θα αποσυνδεθεί από το Watch Party."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoining here disconnects this profile's other device from the party."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vuelves a unirte aquí, el otro dispositivo de este perfil se desconectará de la Watch Party."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siin uuesti liitumine katkestab selle profiili teise seadme ühenduse Watch Partyga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudelleen liittyminen tässä katkaisee tämän profiilin toisen laitteen yhteyden Watch Partyyn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoindre ici déconnecte de la Watch Party l’autre appareil de ce profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצטרפות מחדש כאן תנתק מה-Watch Party את המכשיר האחר של הפרופיל הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ फिर से शामिल होने पर इस प्रोफ़ाइल का दूसरा डिवाइस पार्टी से डिस्कनेक्ट हो जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponovnim pridruživanjem ovdje drugi uređaj ovog profila odspaja se s partyja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az itteni visszacsatlakozás leválasztja a Watch Partyról a profil másik eszközét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergabung kembali di sini akan memutus perangkat lain profil ini dari Watch Party."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rientri qui, l’altro dispositivo di questo profilo verrà disconnesso dal Watch Party."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで再参加すると、このプロフィールの別のデバイスはWatch Partyから切断されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 다시 참여하면 이 프로필의 다른 기기는 Watch Party에서 연결이 끊어져요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vėl prisijungus čia, kitas šio profilio įrenginys bus atjungtas nuo „Watch Party“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja pievienosieties šeit, šī profila otra ierīce tiks atvienota no Watch Party."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyertai semula di sini akan memutuskan sambungan peranti lain profil ini daripada Watch Party."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du blir med igjen her, kobles denne profilens andre enhet fra Watch Party."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je hier opnieuw deelneemt, wordt het andere apparaat van dit profiel losgekoppeld van de party."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponowne dołączenie tutaj odłączy od Watch Party inne urządzenie tego profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voltar por aqui desconecta da Watch Party o outro dispositivo deste perfil."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voltar a entrar aqui desliga da Watch Party o outro dispositivo deste perfil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă reveniți aici, celălalt dispozitiv al acestui profil va fi deconectat de la Watch Party."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вернуться здесь, другое устройство этого профиля отключится от Watch Party."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opätovným pripojením tu sa druhé zariadenie tohto profilu odpojí od Watch Party."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če se znova pridružite tukaj, bo druga naprava tega profila odklopljena od Watch Party."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du går med igen här kopplas profilens andra enhet bort från Watch Partyn."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเข้าร่วมอีกครั้งที่นี่จะตัดการเชื่อมต่ออุปกรณ์อื่นของโปรไฟล์นี้ออกจากปาร์ตี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada tekrar katılırsanız bu profilin diğer cihazının partiyle bağlantısı kesilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо приєднатися тут, цей профіль буде від’єднано від Watch Party на іншому пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tham gia lại tại đây sẽ ngắt kết nối thiết bị khác của hồ sơ này khỏi Watch Party."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此重新加入会使此个人资料的另一台设备断开与Party的连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這裡重新加入後，此個人檔案的另一部裝置將與 Watch Party 中斷連線。"
          }
        }
      }
    },
