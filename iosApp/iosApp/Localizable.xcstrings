    "tvPairing.unreachablePublicAppleTv" : {
      "comment" : "Apple TV pairing screen (shown while a nearby phone sets up or signs in this Apple TV): body of the Can't reach screen. {server}: the server's name; {address}: the address the phone sent.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لجهاز Apple TV هذا الوصول إلى %1$@ على %2$@. تحقق من اتصاله بالشبكة وحاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto Apple TV se nemůže připojit k serveru %1$@ na adrese %2$@. Zkontrolujte připojení k síti a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette Apple TV kan ikke nå %1$@ på %2$@. Kontrollér netværksforbindelsen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Apple TV kann %1$@ unter %2$@ nicht erreichen. Prüfe die Netzwerkverbindung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Apple TV can't reach %1$@ at %2$@. Check its network connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Apple TV no puede conectarse a %1$@ en %2$@. Revisa su conexión de red y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä Apple TV ei saa yhteyttä palvelimeen %1$@ osoitteessa %2$@. Tarkista sen verkkoyhteys ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette Apple TV ne parvient pas à joindre %1$@ à l’adresse %2$@. Vérifiez sa connexion réseau et réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj Apple TV ne može se povezati s poslužiteljem %1$@ na adresi %2$@. Provjerite mrežnu vezu i pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa Apple TV non riesce a raggiungere %1$@ all’indirizzo %2$@. Controlla la connessione di rete e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVは%2$@の%1$@に接続できません。ネットワーク接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple TV에서 %2$@ 주소로 %1$@ 서버에 연결할 수 없어요. 네트워크 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Apple TV-en når ikke %1$@ på %2$@. Kontroller nettverkstilkoblingen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Apple TV kan %1$@ niet bereiken op %2$@. Controleer de netwerkverbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie Apple TV nie może połączyć się z serwerem %1$@ pod adresem %2$@. Sprawdź połączenie sieciowe i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta Apple TV não consegue acessar %1$@ em %2$@. Verifique a conexão de rede dela e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этому Apple TV не удаётся подключиться к серверу %1$@ по адресу %2$@. Проверьте подключение к сети и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här Apple TV:n kan inte nå %1$@ på %2$@. Kontrollera nätverksanslutningen och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Apple TV, %2$@ adresindeki %1$@ sunucusuna ulaşamıyor. Ağ bağlantısını kontrol edin ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей Apple TV не може зв’язатися з %1$@ за адресою %2$@. Перевірте його мережеве з’єднання і спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台Apple TV无法通过%2$@连接到%1$@。请检查其网络连接，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台 Apple TV 無法透過 %2$@ 連線至 %1$@。請檢查網路連線，然後再試一次。"
          }
        }
      }
    },
