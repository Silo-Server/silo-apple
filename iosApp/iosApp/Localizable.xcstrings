    "setup.recovery.error.forgetFailed" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV) saved-server recovery screen: error when removing the saved server failed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
