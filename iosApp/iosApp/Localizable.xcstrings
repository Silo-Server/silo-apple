    "requests.remove.body" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message of the Remove this request? dialog. {title}: the movie or series title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف طلبك الفاشل لـ«%1$@». يمكنك طلب العنوان مرة أخرى لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
