    "settings.playback.atmosFooter" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: sentence in the Streaming footer about the TrueHD Atmos and DTS:X switch. TrueHD Atmos and DTS:X are audio format names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تفعيل TrueHD Atmos وDTS:X، تحتفظ هذه المسارات بقنوات الارتفاع لكنها تُشغَّل كصوت مضغوط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При включена опция „TrueHD Atmos и DTS:X“ тези аудиописти запазват каналите си за височина, но се възпроизвеждат като компресирано аудио."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb TrueHD Atmos i DTS:X activat, aquestes pistes conserven els canals d’altura però es reprodueixen com a àudio comprimit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je zapnuto TrueHD Atmos a DTS:X, tyto stopy si zachovají výškové kanály, ale přehrají se jako komprimovaný zvuk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med TrueHD Atmos og DTS:X slået til beholder disse spor deres højdekanaler, men afspilles som komprimeret lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn TrueHD Atmos und DTS:X eingeschaltet ist, behalten diese Spuren ihre Höhenkanäle, werden aber als komprimierter Ton wiedergegeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με ενεργή την επιλογή «TrueHD Atmos και DTS:X», αυτά τα κομμάτια διατηρούν τα κανάλια ύψους, αλλά αναπαράγονται ως συμπιεσμένος ήχος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With TrueHD Atmos and DTS:X on, those tracks keep their height channels but play as compressed audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con TrueHD Atmos y DTS:X activado, esas pistas conservan sus canales de altura, pero se reproducen como audio comprimido."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui TrueHD Atmos ja DTS:X on sees, säilivad nende radade kõrguskanalid, kuid need esitatakse tihendatud helina."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun TrueHD Atmos ja DTS:X on päällä, näiden raitojen korkeuskanavat säilyvät, mutta ne toistetaan pakattuna äänenä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec TrueHD Atmos et DTS:X activé, ces pistes conservent leurs canaux de hauteur mais sont lues en audio compressé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהאפשרות ”TrueHD Atmos ו-DTS:X” מופעלת, הרצועות האלה שומרות על ערוצי הגובה שלהן, אבל מושמעות כשמע דחוס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TrueHD Atmos और DTS:X चालू होने पर, उन ट्रैक के हाइट चैनल बने रहते हैं, लेकिन वे कंप्रेस्ड ऑडियो के रूप में चलते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je TrueHD Atmos i DTS:X uključeno, ti zapisi zadržavaju visinske kanale, ali se reproduciraju kao komprimirani zvuk."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a TrueHD Atmos és DTS:X be van kapcsolva, ezek a sávok megtartják a magassági csatornáikat, de tömörített hangként szólnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika TrueHD Atmos dan DTS:X aktif, trek tersebut tetap mempertahankan kanal ketinggian, tetapi diputar sebagai audio terkompresi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con TrueHD Atmos e DTS:X attivo, queste tracce mantengono i canali di altezza ma vengono riprodotte come audio compresso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TrueHD AtmosとDTS:Xをオンにすると、これらのトラックはハイトチャンネルを保持したまま、圧縮オーディオとして再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TrueHD Atmos 및 DTS:X를 켜면 해당 트랙은 높이 채널을 유지하지만 압축 오디오로 재생돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įjungus TrueHD Atmos ir DTS:X, šie takeliai išlaiko aukščio kanalus, bet leidžiami kaip suglaudintas garsas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja TrueHD Atmos un DTS:X ir ieslēgts, šie celiņi saglabā augstuma kanālus, bet tiek atskaņoti kā saspiests audio."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan TrueHD Atmos dan DTS:X dihidupkan, trek tersebut mengekalkan saluran ketinggiannya tetapi dimainkan sebagai audio termampat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med TrueHD Atmos og DTS:X på beholder disse sporene høydekanalene, men spilles av som komprimert lyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met TrueHD Atmos en DTS:X aan behouden die sporen hun hoogtekanalen, maar worden ze als gecomprimeerde audio afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy opcja TrueHD Atmos i DTS:X jest włączona, te ścieżki zachowują kanały wysokości, ale są odtwarzane jako dźwięk skompresowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com TrueHD Atmos e DTS:X ativado, essas faixas mantêm os canais de altura, mas são reproduzidas como áudio compactado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com TrueHD Atmos e DTS:X ativado, essas faixas mantêm os canais de altura, mas são reproduzidas como áudio comprimido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când opțiunea TrueHD Atmos și DTS:X este activată, aceste piste își păstrează canalele de înălțime, dar se redau ca audio comprimat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если параметр «TrueHD Atmos и DTS:X» включён, такие дорожки сохраняют каналы высоты, но воспроизводятся как сжатый звук."
