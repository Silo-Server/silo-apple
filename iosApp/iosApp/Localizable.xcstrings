    "settings.signIn.disconnectFailedGeneric" : {
      "comment" : "Apple Settings > Sign-in (iPhone, iPad, Mac): error when unlinking a provider failed for another reason.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إلغاء ربط مزود تسجيل الدخول. حاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можа да се прекъсне връзката с доставчика на вход. Опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut desconnectar el proveïdor d’inici de sessió. Torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskytovatele přihlášení se nepodařilo odpojit. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke fjerne tilknytningen til loginudbyderen. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung mit dem Anmeldeanbieter konnte nicht getrennt werden. Versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η αποσύνδεση από τον πάροχο σύνδεσης. Δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't disconnect the sign-in provider. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo desconectar el proveedor de inicio de sesión. Vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisselogimise teenusepakkuja ühenduse katkestamine ebaõnnestus. Proovige uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjautumispalvelun yhteyden katkaiseminen epäonnistui. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de déconnecter le fournisseur de connexion. Réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לנתק את ספק ההתחברות. אפשר לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन-इन प्रोवाइडर को डिस्कनेक्ट नहीं किया जा सका। फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće prekinuti vezu s pružateljem prijave. Pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült leválasztani a bejelentkezési szolgáltatót. Próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat memutuskan penyedia masuk. Coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile scollegare il provider di accesso. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインプロバイダーの連携を解除できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 제공자 연결을 해제하지 못했어요. 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko atjungti prisijungimo teikėjo. Bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās atvienot pierakstīšanās nodrošinātāju. Mēģiniet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat memutuskan sambungan pembekal log masuk. Sila cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke koble fra påloggingsleverandøren. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de inlogprovider niet ontkoppelen. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odłączyć dostawcy logowania. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível desconectar o provedor de login. Tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível desligar o fornecedor de início de sessão. Tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a putut deconecta furnizorul de conectare. Încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось отключить провайдер входа. Повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa odpojiť poskytovateľa prihlásenia. Skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni bilo mogoče prekiniti povezave s ponudnikom prijave. Poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att koppla från inloggningsleverantören. Försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยกเลิกการเชื่อมต่อผู้ให้บริการลงชื่อเข้าใช้ไม่ได้ โปรดลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum açma sağlayıcısının bağlantısı kesilemedi. Tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося від’єднати постачальника входу. Спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể ngắt kết nối nhà cung cấp đăng nhập. Vui lòng thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法取消关联登录提供商。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法解除連結登入提供者。請再試一次。"
          }
        }
      }
    },
    "settings.signIn.disconnectMessage" : {
      "comment" : "Apple Settings > Sign-in (iPhone, iPad, Mac): message of the confirmation before unlinking a sign-in provider, when the server doesn't say whether the account can disconnect it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تتمكن بعد الآن من تسجيل الدخول باستخدام حساب المزود هذا. يبقى حسابك في Silo وملفاته الشخصية. إذا كانت هذه طريقتك الوحيدة لتسجيل الدخول، فسيبقى الربط قائمًا حتى يعيّن مسؤول كلمة مرور لحسابك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вече няма да можете да влизате с този акаунт при доставчика. Акаунтът ви в Silo и профилите му остават. Ако това е единственият ви начин за вход, връзката остава, докато администратор не зададе парола за акаунта ви."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja no podràs iniciar la sessió amb aquest compte del proveïdor. El teu compte de Silo i els seus perfils es mantenen. Si aquesta és l’única manera d’iniciar la sessió, continuarà connectat fins que un administrador estableixi una contrasenya per al teu compte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přes tento účet poskytovatele se už nebudete moci přihlásit. Váš účet Silo a jeho profily zůstanou. Pokud je to váš jediný způsob přihlášení, zůstane připojený, dokud správce nenastaví heslo k vašemu účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke længere logge ind med denne udbyderkonto. Din Silo-konto og dens profiler bevares. Hvis dette er din eneste måde at logge ind på, forbliver den tilknyttet, indtil en administrator angiver en adgangskode til din konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst dich dann nicht mehr mit diesem Anbieterkonto anmelden. Dein Silo-Konto und seine Profile bleiben erhalten. Wenn dies deine einzige Anmeldemethode ist, bleibt die Verbindung bestehen, bis ein Administrator ein Passwort für dein Konto festlegt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν θα μπορείτε πλέον να συνδέεστε με αυτόν τον λογαριασμό παρόχου. Ο λογαριασμός σας στο Silo και τα προφίλ του παραμένουν. Αν αυτός είναι ο μόνος τρόπος σύνδεσής σας, θα παραμείνει συνδεδεμένος μέχρι ένας διαχειριστής να ορίσει κωδικό πρόσβασης για τον λογαριασμό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll no longer be able to sign in with this provider account. Your Silo account and its profiles stay. If this is your only way to sign in, it stays connected until an administrator sets a password for your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no podrás iniciar sesión con esta cuenta del proveedor. Tu cuenta de Silo y sus perfiles se conservan. Si es tu única forma de iniciar sesión, seguirá conectada hasta que un administrador configure una contraseña para tu cuenta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ei saa enam selle teenusepakkuja kontoga sisse logida. Teie Silo konto ja selle profiilid jäävad alles. Kui see on teie ainus sisselogimisviis, jääb see ühendatuks, kuni administraator määrab teie kontole parooli."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et voi enää kirjautua sisään tällä palvelun tilillä. Silo-tilisi ja sen profiilit säilyvät. Jos tämä on ainoa kirjautumistapasi, se pysyy yhdistettynä, kunnes ylläpitäjä asettaa tilillesi salasanan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pourrez plus vous connecter avec ce compte du fournisseur. Votre compte Silo et ses profils sont conservés. S’il s’agit de votre seul moyen de connexion, il reste connecté jusqu’à ce qu’un administrateur définisse un mot de passe pour votre compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא תהיה יותר אפשרות להתחבר באמצעות החשבון הזה אצל הספק. חשבון ה-Silo שלך והפרופילים שלו יישארו. אם זו הדרך היחידה שלך להתחבר, היא תישאר מחוברת עד שמנהל מערכת יגדיר סיסמה לחשבון שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस प्रोवाइडर खाते से अब साइन इन नहीं किया जा सकेगा। आपका Silo खाता और उसकी प्रोफ़ाइलें बनी रहेंगी। अगर साइन इन करने का यही आपका इकलौता तरीका है, तो यह तब तक कनेक्ट रहेगा जब तक कोई एडमिनिस्ट्रेटर आपके खाते के लिए पासवर्ड सेट नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više se nećete moći prijaviti ovim računom pružatelja. Vaš račun za Silo i njegovi profili ostaju. Ako vam je to jedini način prijave, ostaje povezan dok administrator ne postavi lozinku za vaš račun."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezzel a szolgáltatói fiókkal többé nem tud bejelentkezni. A Silo-fiókja és annak profiljai megmaradnak. Ha ez az egyetlen bejelentkezési módja, csatlakoztatva marad, amíg egy rendszergazda jelszót nem állít be a fiókjához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak akan dapat lagi masuk dengan akun penyedia ini. Akun Silo Anda dan profilnya tetap ada. Jika ini satu-satunya cara Anda masuk, penyedia ini tetap terhubung sampai administrator menetapkan kata sandi untuk akun Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non potrai più accedere con questo account del provider. Il tuo account Silo e i suoi profili restano. Se questo è il tuo unico modo per accedere, resta collegato finché un amministratore non imposta una password per il tuo account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロバイダーのアカウントでサインインできなくなります。Siloのアカウントとそのプロフィールは残ります。これが唯一のサインイン方法の場合は、管理者がアカウントにパスワードを設定するまで連携は解除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 이상 이 제공자 계정으로 로그인할 수 없어요. Silo 계정과 프로필은 그대로 유지돼요. 이 방법이 유일한 로그인 방법이면 관리자가 계정 비밀번호를 설정할 때까지 연결된 상태로 유지돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebegalėsite prisijungti per šio teikėjo paskyrą. Jūsų „Silo“ paskyra ir jos profiliai lieka. Jei tai vienintelis jūsų prisijungimo būdas, jis liks prijungtas, kol administratorius nustatys jūsų paskyros slaptažodį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūs vairs nevarēsiet pierakstīties ar šo nodrošinātāja kontu. Jūsu Silo konts un tā profili saglabāsies. Ja šis ir jūsu vienīgais pierakstīšanās veids, tas paliks pievienots, līdz administrators iestatīs jūsu kontam paroli."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak lagi dapat log masuk dengan akaun pembekal ini. Akaun Silo anda dan profilnya kekal. Jika ini satu-satunya cara anda log masuk, ia kekal disambungkan sehingga pentadbir menetapkan kata laluan untuk akaun anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke lenger logge på med denne leverandørkontoen. Silo-kontoen din og profilene på den blir værende. Hvis dette er din eneste måte å logge på, forblir den tilkoblet til en administrator angir et passord for kontoen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt niet meer inloggen met dit provideraccount. Je Silo-account en de profielen ervan blijven behouden. Als dit je enige inlogmethode is, blijft het gekoppeld totdat een beheerder een wachtwoord voor je account instelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie będzie już można logować się za pomocą tego konta dostawcy. Twoje konto Silo i jego profile pozostaną. Jeśli to twój jedyny sposób logowania, połączenie pozostanie aktywne, dopóki administrator nie ustawi hasła dla twojego konta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não vai mais conseguir entrar com esta conta do provedor. Sua conta do Silo e os perfis dela continuam. Se esta for sua única forma de entrar, ela continua conectada até um administrador definir uma senha para sua conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixará de poder iniciar sessão com esta conta do fornecedor. A sua conta Silo e os respetivos perfis mantêm-se. Se esta for a sua única forma de iniciar sessão, a ligação mantém-se até um administrador definir uma palavra-passe para a sua conta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu vă veți mai putea conecta cu contul acestui furnizor. Contul Silo și profilurile sale rămân. Dacă aceasta este singura dvs. modalitate de conectare, conexiunea rămâne activă până când un administrator setează o parolă pentru contul dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы больше не сможете входить с этим аккаунтом провайдера. Ваш аккаунт Silo и его профили сохранятся. Если это ваш единственный способ входа, он останется подключённым, пока администратор не задаст пароль для вашего аккаунта."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomocou tohto účtu poskytovateľa sa už nebudete môcť prihlásiť. Váš účet Silo a jeho profily zostanú. Ak je to váš jediný spôsob prihlásenia, zostane pripojený, kým správca nenastaví heslo pre váš účet."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem računom ponudnika se ne boste več mogli prijaviti. Vaš račun Silo in njegovi profili ostanejo. Če je to vaš edini način prijave, ostane povezan, dokler skrbnik ne nastavi gesla za vaš račun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kommer inte längre att kunna logga in med det här leverantörskontot. Ditt Silo-konto och dess profiler finns kvar. Om detta är ditt enda sätt att logga in förblir det anslutet tills en administratör anger ett lösenord för ditt konto."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะลงชื่อเข้าใช้ด้วยบัญชีผู้ให้บริการนี้ไม่ได้อีก บัญชี Silo และโปรไฟล์ของบัญชีจะยังอยู่ หากนี่เป็นวิธีเดียวที่คุณใช้ลงชื่อเข้าใช้ได้ การเชื่อมต่อจะยังคงอยู่จนกว่าผู้ดูแลระบบจะตั้งรหัสผ่านให้บัญชีของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artık bu sağlayıcı hesabıyla oturum açamayacaksınız. Silo hesabınız ve profilleri kalır. Bu, tek oturum açma yolunuzsa bir yönetici hesabınız için parola belirleyene kadar bağlı kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви більше не зможете входити через цей обліковий запис постачальника. Ваш обліковий запис Silo і його профілі залишаться. Якщо це ваш єдиний спосіб входу, він залишатиметься під’єднаним, доки адміністратор не встановить пароль для вашого облікового запису."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ không thể đăng nhập bằng tài khoản nhà cung cấp này nữa. Tài khoản Silo và các hồ sơ của tài khoản vẫn được giữ. Nếu đây là cách đăng nhập duy nhất của bạn, kết nối này sẽ được giữ cho đến khi quản trị viên đặt mật khẩu cho tài khoản của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将无法再使用此提供商账户登录。你的Silo账户及其个人资料会保留。如果这是你唯一的登录方式，在管理员为你的账户设置密码之前，它将保持关联。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將無法再使用此提供者帳號登入。你的 Silo 帳號及其個人檔案會保留。如果這是你唯一的登入方式，在管理員為你的帳號設定密碼之前，它會保持連結。"
          }
        }
      }
    },
    "settings.signIn.disconnectMessageAllowed" : {
      "comment" : "Apple Settings > Sign-in (iPhone, iPad, Mac): message of the confirmation before unlinking a sign-in provider, when the server says the account can disconnect it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تتمكن بعد الآن من تسجيل الدخول باستخدام حساب المزود هذا. يبقى حسابك في Silo وملفاته الشخصية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вече няма да можете да влизате с този акаунт при доставчика. Акаунтът ви в Silo и профилите му остават."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja no podràs iniciar la sessió amb aquest compte del proveïdor. El teu compte de Silo i els seus perfils es mantenen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přes tento účet poskytovatele se už nebudete moci přihlásit. Váš účet Silo a jeho profily zůstanou."
