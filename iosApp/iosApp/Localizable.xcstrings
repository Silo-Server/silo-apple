            "value" : "Tampilkan “Siapa yang menonton” jika Anda tidak membuka Silo selama 12 jam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra “Chi guarda?” quando sei lontano da Silo da 12 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloから12時間離れると、プロフィール選択画面を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo를 12시간 동안 사용하지 않으면 “누가 보고 있나요?” 화면을 표시해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodyti ekraną „Kas žiūri?“, jei „Silo“ nenaudojote 12 valandų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rādīt ekrānu „Kas skatās?”, ja kopš pēdējās Silo izmantošanas pagājušas 12 stundas."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan Siapa yang menonton apabila anda meninggalkan Silo selama 12 jam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis «Hvem ser på» når du har vært borte fra Silo i 12 timer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon “Wie kijkt er?” als je 12 uur niet in Silo bent geweest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj ekran „Kto ogląda”, gdy od ostatniego korzystania z aplikacji Silo minie 12 godzin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar Quem está assistindo quando você ficar 12 horas fora do Silo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar Quem está a ver? quando tiver estado fora do Silo durante 12 horas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se afișează ecranul „Cine vizionează?” când nu ați mai folosit Silo timp de 12 ore."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать экран «Кто смотрит?», если вы не открывали Silo в течение 12 часов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť obrazovku Kto pozerá po 12 hodinách mimo aplikácie Silo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži zaslon „Kdo gleda“, ko ste bili 12 ur odsotni iz aplikacije Silo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa ”Vem tittar?” när du har varit borta från Silo i 12 timmar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงหน้า “ใครกำลังดู” เมื่อคุณไม่ได้ใช้ Silo เป็นเวลา 12 ชั่วโมง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo’dan 12 saat uzak kaldığınızda “Kim izliyor?” ekranı gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати «Хто дивиться», якщо вас не було в Silo 12 годин."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị “Ai đang xem” khi bạn rời Silo được 12 giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开Silo 12小时后显示“谁在观看”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開 Silo 12 小時後，顯示「誰在觀看」。"
          }
        }
      }
    },
