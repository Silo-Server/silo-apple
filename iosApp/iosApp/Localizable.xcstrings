    "downloads.offline.error.manifestMissing" : {
      "comment" : "Apple iOS/macOS: player error when opening a download offline: its playback data is missing.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيانات التشغيل دون اتصال لهذا التنزيل مفقودة. احذفه ونزّله مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Offline-Wiedergabedaten dieses Downloads fehlen. Lösche ihn und lade ihn erneut herunter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The offline playback data for this download is missing. Delete and re-download it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltan los datos de reproducción sin conexión de esta descarga. Elimínala y vuelve a descargarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de lecture hors connexion de ce téléchargement sont introuvables. Supprimez-le, puis téléchargez-le à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このダウンロードのオフライン再生データが見つかりません。削除してから再ダウンロードしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados de reprodução offline deste download estão ausentes. Exclua e baixe novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此下载的离线播放数据丢失。请删除后重新下载。"
          }
        }
      }
    },
    "downloads.offline.error.mediaMissing" : {
      "comment" : "Apple iOS/macOS: player error when opening a download offline: its video file is missing.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
