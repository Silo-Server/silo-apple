            "value" : "Pomocí vyhledávání najděte film nebo seriál, o který chcete požádat"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug Søg til at finde en film eller serie, du kan anmode om"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde über die Suche einen Film oder eine Serie zum Anfragen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Search to find a movie or series to request"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Buscar para encontrar una película o serie que solicitar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsi pyydettävä elokuva tai sarja Haun avulla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Rechercher pour trouver un film ou une série à demander"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomoću pretraživanja pronađite film ili seriju koju želite zatražiti"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Cerca per trovare un film o una serie da richiedere"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索で、リクエストする映画やシリーズを見つけてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색에서 요청할 영화나 시리즈를 찾으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk Søk for å finne en film eller serie å be om"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik Zoeken om een film of serie te vinden die je wilt aanvragen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj wyszukiwania, aby znaleźć film lub serial, o który chcesz poprosić"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a Busca para encontrar um filme ou uma série para solicitar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдите фильм или сериал через «Поиск», чтобы запросить его"
          }
        },
        "sv" : {
          "stringUnit" : {
