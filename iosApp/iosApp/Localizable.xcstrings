    "errors.apple.subtitles.jobOutcomeUnknown" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error on the AI subtitle creation screen when the server's answer to starting a subtitle job was lost or unusable.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo تأكيد بدء عملية الترجمة. إذا كانت قد بدأت، فستظهر الترجمة في قائمة الترجمات عند انتهائها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikaci Silo se nepodařilo ověřit, že se úloha titulků spustila. Pokud ano, titulky se po jejím dokončení zobrazí v seznamu titulků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke bekræfte, at undertekstjobbet blev startet. Hvis det gjorde, vises underteksterne på undertekstlisten, når det er færdigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte nicht bestätigen, dass der Untertitel-Auftrag gestartet wurde. Falls doch, erscheinen die Untertitel nach Abschluss in der Untertitelliste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn't confirm that the subtitle job started. If it did, the subtitles will appear in the subtitle list when it finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo confirmar que el trabajo de subtítulos se iniciara. Si se inició, los subtítulos aparecerán en la lista de subtítulos cuando termine."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei voinut vahvistaa, että tekstitystyö alkoi. Jos se alkoi, tekstitykset näkyvät tekstitysluettelossa, kun työ on valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a pas pu confirmer le démarrage du travail de sous-titres. S’il a démarré, les sous-titres apparaîtront dans la liste des sous-titres une fois le travail terminé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nije mogao potvrditi da je posao izrade titlova pokrenut. Ako jest, titlovi će se pojaviti na popisu titlova kad posao završi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo non è riuscito a confermare l’avvio del processo dei sottotitoli. Se è partito, i sottotitoli compariranno nell’elenco dei sottotitoli al termine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloは字幕ジョブの開始を確認できませんでした。開始されていれば、完了後に字幕の一覧に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo에서 자막 작업이 시작됐는지 확인할 수 없어요. 작업이 시작됐다면 완료 후 자막 목록에 자막이 표시돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke bekrefte at undertekstjobben startet. Hvis den gjorde det, vises undertekstene i undertekstlisten når den er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kan niet bevestigen dat de ondertitelopdracht is gestart. Als dat wel zo is, verschijnen de ondertitels in de ondertitellijst zodra de opdracht klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacji Silo nie udało się potwierdzić rozpoczęcia zlecenia napisów. Jeśli się rozpoczęło, napisy pojawią się na liście napisów po jego zakończeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo não conseguiu confirmar que o trabalho de legendas foi iniciado. Se tiver sido, as legendas aparecerão na lista de legendas quando ele terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не удалось подтвердить запуск задания на создание субтитров. Если оно запустилось, субтитры появятся в списке субтитров после его завершения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunde inte bekräfta att undertextjobbet startade. Om det gjorde det visas undertexterna i undertextlistan när jobbet är klart."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo, altyazı işinin başladığını doğrulayamadı. Başladıysa, iş bittiğinde altyazılar altyazı listesinde görünecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не вдалося підтвердити, що операцію створення субтитрів розпочато. Якщо її розпочато, субтитри з’являться у списку субтитрів після її завершення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo无法确认字幕作业是否已开始。如果已开始，字幕将在作业完成后显示在字幕列表中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo 無法確認字幕作業是否已開始。若已開始，作業完成後字幕會出現在字幕清單中。"
          }
        }
      }
    },
    "errors.apple.subtitles.jobUnresolved" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error on the AI subtitle creation screen when an identical earlier request has no confirmed result, so the new one was held.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يكون طلب سابق لهذه الترجمة لا يزال قيد التنفيذ، لذلك لم يُرسله Silo مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dřívější požadavek na tyto titulky možná stále běží, proto ho aplikace Silo znovu neodeslala."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tidligere anmodning om disse undertekster kører muligvis stadig, så Silo sendte den ikke igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine frühere Anfrage für diese Untertitel läuft möglicherweise noch, daher hat Silo sie nicht erneut gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An earlier request for these subtitles may still be running, so Silo didn't send it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que una solicitud anterior de estos subtítulos siga en curso, así que Silo no la volvió a enviar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiempi pyyntö näille tekstityksille voi olla yhä käynnissä, joten Silo ei lähettänyt sitä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une demande précédente pour ces sous-titres est peut-être encore en cours, Silo ne l’a donc pas renvoyée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raniji zahtjev za ove titlove možda je još u tijeku pa ga Silo nije ponovno poslao."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una richiesta precedente per questi sottotitoli potrebbe essere ancora in corso, quindi Silo non l’ha inviata di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この字幕の以前のリクエストがまだ実行中の可能性があるため、Siloは再送信しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 자막에 대한 이전 요청이 아직 실행 중일 수 있어서 Silo에서 다시 보내지 않았어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tidligere forespørsel om disse undertekstene kan fortsatt pågå, så Silo sendte den ikke på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een eerder verzoek voor deze ondertitels loopt mogelijk nog, dus Silo heeft het niet opnieuw verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wcześniejsze żądanie tych napisów może nadal trwać, więc aplikacja Silo nie wysłała go ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma solicitação anterior para estas legendas ainda pode estar em andamento, então o Silo não a enviou novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предыдущий запрос на эти субтитры, возможно, ещё выполняется, поэтому повторный запрос не отправлен."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tidigare förfrågan om de här undertexterna kan fortfarande pågå, så Silo skickade den inte igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu altyazılar için önceki bir istek hâlâ sürüyor olabilir, bu nedenle Silo isteği yeniden göndermedi."
