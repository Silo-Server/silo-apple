    "settingsManifest.playback.cellular_max_bitrate_kbps.description" : {
      "comment" : "Help text under the playback.cellular_max_bitrate_kbps setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحديد مقدار البيانات الذي يمكن أن يستخدمه التشغيل على بيانات الجوال أو أي اتصال محدود آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenzt, wie viele Daten die Wiedergabe über mobile Daten oder eine andere getaktete Verbindung nutzen darf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap how much data playback may use on mobile data or another metered connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita cuántos datos puede usar la reproducción con datos móviles u otra conexión medida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite la quantité de données que la lecture peut utiliser en données mobiles ou sur une autre connexion limitée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モバイルデータ通信などの従量制接続で再生に使うデータ量を制限します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita quantos dados a reprodução pode usar em dados móveis ou outra conexão limitada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制在移动数据或其他按流量计费的连接上播放时可使用的数据量。"
          }
        }
      }
    },
