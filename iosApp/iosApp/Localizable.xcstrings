    "pairing.summary.unreachable" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: result line when the TV couldn't reach the server address the phone sent. {server}: the server's name, followed by \" — \" and the account name when there is one (for example Home — sam).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: تعذّر على التلفزيون الوصول إلى هذا العنوان. اتبع الخطوات على التلفزيون، أو أعدّ التلفزيون باستخدام العنوان العام للخادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Der Fernseher konnte diese Adresse nicht erreichen. Folge den Schritten auf dem Fernseher oder richte den Fernseher mit der öffentlichen Adresse des Servers ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: the TV couldn't reach this address. Follow the steps on the TV, or set the TV up with the server's public address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: la TV no pudo contactar con esta dirección. Sigue los pasos en la TV o configura la TV con la dirección pública del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : la TV n’a pas pu joindre cette adresse. Suivez les étapes sur la TV ou configurez la TV avec l’adresse publique du serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：テレビからこのアドレスに接続できませんでした。テレビの手順に従うか、サーバーの公開アドレスを使ってテレビをセットアップしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: a TV não conseguiu acessar este endereço. Siga as etapas na TV ou configure a TV com o endereço público do servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：电视无法连接到此地址。请按照电视上的步骤操作，或使用服务器的公网地址设置电视。"
          }
        }
      }
    },
