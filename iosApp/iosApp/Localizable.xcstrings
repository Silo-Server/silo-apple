          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pornește de la valoarea implicită globală pentru descărcări. Modificarea de aici se aplică doar acestei descărcări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изначально используется качество по умолчанию из общих настроек загрузок. Изменение здесь действует только для этой загрузки."
          }
        },
        "sk" : {
          "stringUnit" : {
