    "settings.signIn.sessionCannotChange" : {
      "comment" : "Apple Settings > Sign-in (iPhone, iPad, Mac): error when the server refuses this session changes to the account's sign-in (for example, an administrator acting for someone).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لهذه الجلسة تغيير طريقة تسجيل الدخول إلى الحساب. سجّل الدخول بحسابك الخاص وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
