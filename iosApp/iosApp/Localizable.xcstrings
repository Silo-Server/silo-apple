        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disimpan hanya pada peranti ini. Peranti lain menggunakan tetapan profil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagret bare på denne enheten. Andre enheter bruker profilens innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen op dit apparaat opgeslagen. Andere apparaten gebruiken de instellingen van het profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisano tylko na tym urządzeniu. Inne urządzenia używają ustawień profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo somente neste dispositivo. Os outros dispositivos usam as configurações do perfil."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado apenas neste dispositivo. Os outros dispositivos usam as definições do perfil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se salvează doar pe acest dispozitiv. Celelalte dispozitive folosesc setările profilului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняется только на этом устройстве. Другие устройства используют настройки профиля."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené iba v tomto zariadení. Ostatné zariadenia používajú nastavenia profilu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shranjeno samo v tej napravi. Druge naprave uporabljajo nastavitve profila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparas endast på den här enheten. Andra enheter använder profilens inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกในอุปกรณ์นี้เท่านั้น อุปกรณ์อื่นจะใช้การตั้งค่าของโปรไฟล์"
