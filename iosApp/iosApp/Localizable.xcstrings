    "home.recipe.hiddenGemsDefault.description" : {
      "comment" : "One-line description of the Hidden Gems preset in the Add row gallery (shared key `home.recipe.hiddenGemsDefault.description`, sent as description_short_key). Shown under or beside the preset's name.",
