    "watchParty.whoSeen.error" : {
      "comment" : "Roku: error text in the who's-seen-it list when history failed to load. {error}: the error detail from the server, sometimes empty. Apple (iPhone, iPad, Apple TV): same error banner on the picker's confirmation page.",
