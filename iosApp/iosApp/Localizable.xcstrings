    "tvPairing.failedSaveAppleTv" : {
      "comment" : "Apple TV pairing screen (shown while a nearby phone sets up or signs in this Apple TV): failure body when the Apple TV couldn't save the session it received. {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وافق %1$@ على تسجيل الدخول، لكن تعذّر على جهاز Apple TV هذا حفظه. حاول مرة أخرى من هاتفك أو جهازك اللوحي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърът %1$@ одобри входа, но това Apple TV не можа да го запази. Опитайте отново от телефона или таблета си."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha aprovat l’inici de sessió, però aquest Apple TV no l’ha pogut desar. Torna-ho a provar des del telèfon o la tauleta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server %1$@ přihlášení schválil, ale toto Apple TV ho nemohlo uložit. Zkuste to znovu z telefonu nebo tabletu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ godkendte login, men dette Apple TV kunne ikke gemme det. Prøv igen fra din telefon eller tablet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat die Anmeldung bestätigt, aber dieses Apple TV konnte sie nicht speichern. Versuche es erneut über dein Smartphone oder Tablet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής %1$@ ενέκρινε τη σύνδεση, αλλά αυτό το Apple TV δεν μπόρεσε να την αποθηκεύσει. Δοκιμάστε ξανά από το τηλέφωνο ή το tablet σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ approved the sign-in, but this Apple TV couldn't save it. Try again from your phone or tablet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ aprobó el inicio de sesión, pero este Apple TV no pudo guardarlo. Vuelve a intentarlo desde tu teléfono o tableta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server %1$@ kinnitas sisselogimise, kuid see Apple TV ei saanud seda salvestada. Proovige uuesti oma telefonist või tahvelarvutist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin %1$@ hyväksyi kirjautumisen, mutta tämä Apple TV ei voinut tallentaa sitä. Yritä uudelleen puhelimesta tai tabletista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a approuvé la connexion, mais cette Apple TV n’a pas pu l’enregistrer. Réessayez depuis votre téléphone ou votre tablette."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת %1$@ אישר את ההתחברות, אבל ה-Apple TV הזה לא הצליח לשמור אותה. אפשר לנסות שוב מהטלפון או מהטאבלט שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर %1$@ ने साइन इन को मंज़ूरी दे दी, लेकिन यह Apple TV इसे सेव नहीं कर सका। अपने फ़ोन या टैबलेट से फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj %1$@ odobrio je prijavu, ali je ovaj Apple TV nije mogao spremiti. Pokušajte ponovno s telefona ili tableta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %1$@ szerver jóváhagyta a bejelentkezést, de ez az Apple TV nem tudta menteni. Próbálja újra a telefonjáról vagy táblagépéről."
          }
        },
        "id" : {
          "stringUnit" : {
