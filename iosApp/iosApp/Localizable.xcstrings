    "signInTv.profilesNote" : {
      "comment" : "Phone note on the TV approval screen about privacy: profiles are visible to anyone using that TV, and PIN-protected profiles stay locked. Apple (iPhone, iPad): same note on the Sign in a TV approval card and the nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لأي شخص يستخدم هذا التلفزيون الاختيار من ملفاتك الشخصية. تبقى الملفات الشخصية المحمية برمز PIN مقفلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle, die diesen Fernseher nutzen, können aus deinen Profilen wählen. Profile mit PIN bleiben gesperrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone using this TV can pick from your profiles. Profiles with a PIN stay locked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier persona que use esta TV podrá elegir entre tus perfiles. Los perfiles con PIN seguirán bloqueados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne utilisant cette TV peut choisir parmi vos profils. Les profils protégés par un PIN restent verrouillés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このテレビを使う人は誰でもプロフィールを選択できます。PINが設定されたプロフィールはロックされたままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa usando esta TV pode escolher entre seus perfis. Perfis com PIN continuam bloqueados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用这台电视的任何人都可以从你的个人资料中选择。设有PIN的个人资料将保持锁定。"
          }
        }
      }
