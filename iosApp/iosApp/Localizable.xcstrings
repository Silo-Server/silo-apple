            "state" : "translated",
            "value" : "Súhlas sa zmenil; možnosť Hlásenia o zlyhaní sa obnovila na hodnotu Pýtať sa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soglasje se je spremenilo; nastavitev Poročila o zrušitvah je bila ponastavljena na Vprašaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtycket har ändrats. Kraschrapporter har återställts till Fråga."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความยินยอมเปลี่ยนแปลง รายงานข้อขัดข้องจึงกลับเป็น “ถามก่อน”"
          }
        },
        "tr" : {
