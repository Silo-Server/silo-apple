          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a recommended minimum viewer age from an advisory service, such as Common Sense Media, on item detail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra en los detalles del elemento una edad mínima recomendada de un servicio de orientación, como Common Sense Media."
          }
