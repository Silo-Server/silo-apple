    "diagnostics.capture.selfHostedFooter" : {
      "comment" : "Footer under the Diagnostics settings Capture section when reports go to the user's own server. Shown on Android phone and Apple (iPhone, iPad).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتبط الموافقة على تقارير الأعطال بحساب الخادم هذا. تسجيل التصحيح إعداد خاص بهذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съгласието за отчети за сривове е обвързано с този акаунт на сървъра. Дневникът за отстраняване на грешки е настройка за това устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El consentiment dels informes d’error està vinculat a aquest compte del servidor. El registre de depuració és una opció d’aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souhlas se zprávami o pádech je vázán na tento účet na serveru. Protokolování ladění je nastavení tohoto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtykke til nedbrudsrapporter er knyttet til denne serverkonto. Fejlfindingslogning er en indstilling for denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einwilligung zu Absturzberichten gilt für dieses Serverkonto. Debug-Protokollierung ist eine Einstellung für dieses Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συγκατάθεση για τις αναφορές κατάρρευσης συνδέεται με αυτόν τον λογαριασμό διακομιστή. Η καταγραφή εντοπισμού σφαλμάτων είναι ρύθμιση αυτής της συσκευής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crash report consent is tied to this server account. Debug logging is a setting for this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El consentimiento de los informes de fallos está vinculado a esta cuenta del servidor. El registro de depuración es un ajuste de este dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokkujooksmise aruannete nõusolek on seotud selle serverikontoga. Silumislogimine on selle seadme seadistus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaatumisraporttien suostumus on sidottu tähän palvelintiliin. Virheenkorjauslokit ovat tämän laitteen asetus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le consentement aux rapports de plantage est lié à ce compte serveur. La journalisation de débogage est un paramètre propre à cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההסכמה לדוחות קריסה קשורה לחשבון השרת הזה. רישום ניפוי באגים הוא הגדרה של המכשיר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्रैश रिपोर्ट की सहमति इस सर्वर खाते से जुड़ी है। डीबग लॉगिंग इस डिवाइस की सेटिंग है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristanak za izvješća o rušenju vezan je uz ovaj račun na poslužitelju. Zapisivanje za otklanjanje pogrešaka postavka je za ovaj uređaj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az összeomlási jelentésekhez adott hozzájárulás ehhez a szerverfiókhoz kötődik. A hibakeresési naplózás ennek az eszköznek a beállítása."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persetujuan laporan crash terikat pada akun server ini. Pencatatan debug adalah pengaturan untuk perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il consenso ai report sugli arresti anomali è legato a questo account del server. Il logging di debug è un’impostazione di questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュレポートの同意はこのサーバーアカウントに紐付けられます。デバッグログはこのデバイスの設定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충돌 보고서 동의는 이 서버 계정에 연결돼요. 디버그 로깅은 이 기기의 설정이에요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
