    "requests.notice.unconfirmedCancel" : {
      "comment" : "Toast on Roku when the app could not confirm a request was cancelled. My Requests is the screen listing the user's requests. Apple (iPhone, iPad, Mac, Apple TV): same message on the request detail page and My Requests.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تأكيد الإلغاء. أعد فتح «طلباتي» للتحقق منه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten den Abbruch nicht bestätigen. Öffne „Meine Anfragen“ erneut, um es zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't confirm the cancellation. Reopen My Requests to check it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos confirmar la cancelación. Vuelve a abrir Mis solicitudes para comprobarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer l’annulation. Rouvrez Mes demandes pour vérifier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセルを確認できませんでした。マイリクエストを開き直して確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar o cancelamento. Abra Minhas solicitações novamente para verificar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们无法确认取消是否成功。请重新打开我的请求查看。"
          }
        }
      }
    },
    "requests.notice.unconfirmedCreate" : {
      "comment" : "Toast on Roku when the app could not confirm a new request went through. My Requests is the screen listing the user's requests. Apple (iPhone, iPad, Mac, Apple TV): same message on the request detail page. Android phone and TV request screens: same message under the detail page button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تأكيد الطلب. تحقق من «طلباتي» قبل المحاولة مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten die Anfrage nicht bestätigen. Prüfe „Meine Anfragen“, bevor du es erneut versuchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't confirm the request. Check My Requests before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos confirmar la solicitud. Revisa Mis solicitudes antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer la demande. Consultez Mes demandes avant de réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストを確認できませんでした。もう一度お試しになる前に、マイリクエストを確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar a solicitação. Verifique Minhas solicitações antes de tentar novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们无法确认请求是否成功。重试前请先查看我的请求。"
          }
        }
      }
    },
    "requests.notice.unconfirmedRemove" : {
