    "tvSignIn.nearbyHint" : {
      "comment" : "Android TV hint on the sign-in screen saying nearby phones with Silo on the same Wi-Fi can sign in this TV. Apple TV: same hint on the sign-in screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل لديك Silo على هاتفك؟ افتحه على شبكة Wi‑Fi نفسها لتسجيل دخول هذا التلفزيون."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имате Silo на телефона си? Отворете приложението в същата Wi‑Fi мрежа, за да влезете в този телевизор."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens Silo al telèfon? Obre’l a la mateixa Wi‑Fi per iniciar la sessió en aquesta TV."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máte Silo v telefonu? Otevřete ho ve stejné síti Wi‑Fi a přihlaste tuto televizi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du Silo på din telefon? Åbn appen på samme Wi‑Fi for at logge dette tv ind."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du Silo auf deinem Smartphone? Öffne die App im selben WLAN, um diesen Fernseher anzumelden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχετε το Silo στο τηλέφωνό σας; Ανοίξτε το στο ίδιο Wi‑Fi για να συνδέσετε αυτή την τηλεόραση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have Silo on your phone? Open it on the same Wi‑Fi to sign in this TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes Silo en tu teléfono? Ábrelo en la misma red Wi‑Fi para iniciar sesión en esta TV."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas teie telefonis on Silo? Selle teleri sisselogimiseks avage see samas Wi‑Fi-võrgus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onko puhelimessasi Silo? Avaa se samassa Wi‑Fi-verkossa, niin tämä tv kirjautuu sisään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez Silo sur votre téléphone ? Ouvrez-le sur le même Wi‑Fi pour connecter cette TV."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לך Silo בטלפון? אפשר לפתוח את האפליקציה באותה רשת Wi‑Fi כדי לחבר את הטלוויזיה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आपके फ़ोन पर Silo है? इस टीवी में साइन इन करने के लिए उसे इसी Wi‑Fi पर खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imate Silo na telefonu? Otvorite ga na istoj Wi‑Fi mreži da biste prijavili ovaj TV."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van Silo a telefonján? Nyissa meg ugyanazon a Wi‑Fi-hálózaton, és bejelentkeztetheti vele ezt a TV-t."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punya Silo di ponsel Anda? Buka aplikasinya di Wi‑Fi yang sama untuk memasukkan TV ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai Silo sul telefono? Aprilo sulla stessa rete Wi‑Fi per far accedere questa TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンにSiloがありますか？同じWi‑Fiで開くと、このテレビにサインインできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰에 Silo가 있나요? 같은 Wi‑Fi에서 Silo를 열면 이 TV에 로그인할 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefone turite „Silo“? Atidarykite programą tame pačiame Wi‑Fi tinkle, kad prijungtumėte šį televizorių."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai jūsu tālrunī ir Silo? Atveriet to tajā pašā Wi‑Fi tīklā, lai pierakstītu šo televizoru."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada Silo pada telefon anda? Buka Silo pada Wi‑Fi yang sama untuk log masuk ke TV ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du Silo på telefonen? Åpne appen på samme Wi‑Fi for å logge på denne TV-en."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb je Silo op je telefoon? Open de app op hetzelfde wifi-netwerk voor het inloggen op deze tv."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz aplikację Silo na telefonie? Otwórz ją w tej samej sieci Wi‑Fi, aby zalogować ten telewizor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem o Silo no celular? Abra o app na mesma rede Wi‑Fi para conectar esta TV."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem o Silo no telemóvel? Abra-o na mesma rede Wi‑Fi para iniciar sessão nesta TV."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aveți Silo pe telefon? Deschideți aplicația în aceeași rețea Wi‑Fi pentru a conecta acest televizor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас есть Silo на телефоне? Откройте приложение в той же сети Wi‑Fi, чтобы войти на этом телевизоре."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máte v telefóne aplikáciu Silo? Otvorte ju v rovnakej sieti Wi‑Fi a prihláste tento televízor."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imate Silo na telefonu? Odprite aplikacijo v istem omrežju Wi‑Fi, da prijavite ta televizor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du Silo på telefonen? Öppna appen på samma Wi‑Fi för att logga in den här tv:n."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มี Silo ในโทรศัพท์ไหม เปิดแอปบน Wi‑Fi เดียวกันเพื่อลงชื่อเข้าใช้ทีวีเครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonunuzda Silo var mı? Bu TV’de oturum açmak için uygulamayı aynı Wi‑Fi ağında açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маєте Silo на телефоні? Відкрийте застосунок у тій самій мережі Wi‑Fi, щоб увійти на цьому телевізорі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có Silo trên điện thoại? Mở ứng dụng trên cùng mạng Wi‑Fi để đăng nhập TV này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机上有Silo？在同一Wi‑Fi下打开它，即可登录这台电视。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手機上有 Silo 嗎？在同一個 Wi‑Fi 下開啟 App，即可登入這台電視。"
          }
        }
      }
    },
