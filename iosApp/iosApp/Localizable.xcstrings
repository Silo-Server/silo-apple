    "requests.search.availableSubtitle" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): line under the Available to request heading in library Search. The dot separates the two parts.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير موجود في المكتبة بعد · اضغط للطلب"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím není v knihovně · klepnutím si ho vyžádáte"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke i biblioteket endnu · tryk for at anmode"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht in der Mediathek · zum Anfragen tippen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not in the library yet · tap to request"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no está en la biblioteca · toca para solicitarlo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vielä kirjastossa · pyydä napauttamalla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore dans la bibliothèque · touchez pour demander"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još nije u medijateci · dodirnite da biste zatražili"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ancora in libreria · tocca per richiederlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだライブラリにありません · タップしてリクエスト"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 라이브러리에 없음 · 탭하여 요청"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke i biblioteket ennå · trykk for å be om den"
          }
        },
        "nl" : {
