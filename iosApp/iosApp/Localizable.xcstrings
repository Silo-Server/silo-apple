    "tvPairing.completedNamed" : {
      "comment" : "Android TV message after pairing succeeded, before the profile screen appears. {servers}: the server name or comma-separated names. Apple TV: same message on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تسجيل الدخول إلى %1$@. جارٍ نقلك إلى ملفاتك الشخصية…"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Успешен вход в: %1$@. Отварят се профилите ви…"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ha iniciat la sessió a %1$@. S’estan obrint els perfils…"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlášení k serveru %1$@ proběhlo. Přecházíte k profilům…"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logget ind på %1$@. Du sendes videre til dine profiler…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei %1$@ angemeldet. Du wirst zu deinen Profilen weitergeleitet…"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σύνδεση ολοκληρώθηκε: %1$@. Μετάβαση στα προφίλ σας…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signed in to %1$@. Taking you to your profiles…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesión iniciada en %1$@. Te llevamos a tus perfiles…"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisse logitud: %1$@. Suuname teid profiilide juurde…"
