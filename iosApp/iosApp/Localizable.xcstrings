    "settings.profilePrefs.overrideDevice" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac, Apple TV): note when this device's own setting for the profile wins over the profile's.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لهذا الجهاز، ضمن هذا الملف الشخصي، إعداد ترجمة أكثر تحديدًا. تُحدّث التغييرات هنا الإعداد الافتراضي للملف الشخصي، لكن إعداد الجهاز يظل مطبّقًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това устройство има по-конкретна настройка на субтитрите за този профил. Промените тук обновяват стандартната настройка на профила, но настройката за устройството продължава да важи."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest dispositiu té, per a aquest perfil, una opció de subtítols més específica. Els canvis que facis aquí actualitzen el valor predeterminat del perfil, però l’excepció del dispositiu continua aplicant-se."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zařízení má pro tento profil konkrétnější nastavení titulků. Změny zde upraví výchozí nastavení profilu, ale nastavení zařízení bude dál platit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed har en mere specifik undertekstindstilling for denne profil. Ændringer her opdaterer profilens standard, men enhedens tilsidesættelse gælder stadig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat für dieses Profil eine spezifischere Untertitel-Einstellung. Änderungen hier aktualisieren den Profilstandard, die Einstellung des Geräts gilt aber weiterhin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή έχει, για αυτό το προφίλ, πιο συγκεκριμένη ρύθμιση υποτίτλων. Οι αλλαγές εδώ ενημερώνουν την προεπιλογή του προφίλ, αλλά η παράκαμψη της συσκευής εξακολουθεί να ισχύει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device, for this profile, has a more specific subtitle setting. Changes here update the profile default, but the device override still applies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tiene, para este perfil, una configuración de subtítulos más específica. Los cambios aquí actualizan la configuración predeterminada del perfil, pero la del dispositivo sigue aplicándose."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selles seadmes on selle profiili jaoks täpsem subtiitrite seadistus. Siin tehtud muudatused värskendavad profiili vaikeväärtust, kuid seadme alistus kehtib endiselt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä laitteella on tälle profiilille tarkempi tekstitysasetus. Täällä tehdyt muutokset päivittävät profiilin oletuksen, mutta laitekohtainen ohitus on edelleen voimassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil a, pour ce profil, un paramètre de sous-titres plus spécifique. Les modifications effectuées ici mettent à jour la valeur par défaut du profil, mais le paramètre propre à l’appareil s’applique toujours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למכשיר הזה יש, בפרופיל הזה, הגדרת כתוביות ספציפית יותר. שינויים כאן מעדכנים את ברירת המחדל של הפרופיל, אבל ההגדרה של המכשיר עדיין חלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस प्रोफ़ाइल के लिए इस डिवाइस पर ज़्यादा खास सबटाइटल सेटिंग है। यहाँ किए गए बदलाव प्रोफ़ाइल का डिफ़ॉल्ट अपडेट करते हैं, लेकिन डिवाइस की ओवरराइड सेटिंग फिर भी लागू रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj uređaj ima specifičniju postavku titlova za ovaj profil. Promjene ovdje ažuriraju zadanu postavku profila, ali i dalje vrijedi postavka uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek az eszköznek ehhez a profilhoz pontosabb feliratbeállítása van. Az itt végzett módosítások a profil alapértelmezését frissítik, de az eszközre vonatkozó felülbírálás továbbra is érvényes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini memiliki pengaturan subtitel yang lebih spesifik untuk profil ini. Perubahan di sini memperbarui default profil, tetapi pengaturan khusus perangkat tetap berlaku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo ha un’impostazione dei sottotitoli più specifica per questo profilo. Le modifiche qui aggiornano il valore predefinito del profilo, ma l’impostazione del dispositivo resta valida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールには、このデバイス専用の字幕設定があります。ここでの変更はプロフィールのデフォルトを更新しますが、デバイスの設定が引き続き優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 이 프로필용으로 더 구체적인 자막 설정이 있어요. 여기서 변경하면 프로필 기본값이 업데이트되지만, 기기별 설정이 계속 적용돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis įrenginys šiam profiliui turi konkretesnį subtitrų nustatymą. Čia atlikti pakeitimai atnaujina profilio numatytąjį nustatymą, bet įrenginio nustatymas vis tiek taikomas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šai ierīcei šajā profilā ir specifiskāks subtitru iestatījums. Izmaiņas šeit atjaunina profila noklusējumu, taču ierīces iestatījums joprojām ir noteicošais."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peranti ini mempunyai tetapan sari kata yang lebih khusus untuk profil ini. Perubahan di sini mengemas kini lalai profil, tetapi tetapan peranti itu masih digunakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enheten har en mer spesifikk undertekstinnstilling for denne profilen. Endringer her oppdaterer profilens standard, men enhetsoverstyringen gjelder fortsatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat heeft voor dit profiel een specifiekere ondertitelinstelling. Wijzigingen hier passen de standaard van het profiel aan, maar de apparaatinstelling blijft gelden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie ma dla tego profilu bardziej szczegółowe ustawienie napisów. Zmiany tutaj aktualizują domyślne ustawienie profilu, ale nadal obowiązuje ustawienie urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tem, para este perfil, uma configuração de legendas mais específica. As alterações aqui atualizam o padrão do perfil, mas a configuração do dispositivo continua valendo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tem, para este perfil, uma definição de legendas mais específica. As alterações aqui atualizam a predefinição do perfil, mas a substituição do dispositivo continua a aplicar-se."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru acest profil, acest dispozitiv are o setare de subtitrări mai specifică. Modificările de aici actualizează setarea implicită a profilului, dar setarea dispozitivului se aplică în continuare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этого профиля на этом устройстве задана более конкретная настройка субтитров. Изменения здесь обновят настройку профиля по умолчанию, но настройка устройства продолжит действовать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zariadenie má pre tento profil konkrétnejšie nastavenie titulkov. Zmeny tu aktualizujú predvolené nastavenie profilu, ale prepísanie pre zariadenie naďalej platí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta naprava ima za ta profil bolj specifično nastavitev podnapisov. Spremembe tukaj posodobijo privzeto nastavitev profila, preglasitev za napravo pa še vedno velja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten har en mer specifik undertextinställning för den här profilen. Ändringar här uppdaterar profilens standardinställning, men enhetens åsidosättning gäller fortfarande."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อุปกรณ์นี้มีการตั้งค่าคำบรรยายสำหรับโปรไฟล์นี้ที่เจาะจงกว่า การเปลี่ยนแปลงที่นี่จะอัปเดตค่าเริ่มต้นของโปรไฟล์ แต่การตั้งค่าเฉพาะอุปกรณ์ยังคงมีผล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazda, bu profil için daha özel bir altyazı ayarı var. Buradaki değişiklikler profil varsayılanını günceller, ancak cihaz için geçersiz kılma uygulanmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для цього профілю на цьому пристрої є конкретніше налаштування субтитрів. Зміни тут оновлюють типове значення профілю, але перевизначення для пристрою й далі діє."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị này có cài đặt phụ đề riêng hơn cho hồ sơ này. Thay đổi ở đây sẽ cập nhật mặc định của hồ sơ, nhưng cài đặt riêng của thiết bị vẫn được áp dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备针对此个人资料有更具体的字幕设置。此处的更改会更新个人资料默认值，但设备覆盖设置仍然生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置針對此個人檔案有更具體的字幕設定。在這裡所做的變更會更新個人檔案預設值，但裝置的覆寫設定仍會套用。"
          }
        }
      }
    },
    "settings.profilePrefs.overrideFamily" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac, Apple TV): note when a setting for this kind of device (phones, tablets, computers or TVs) wins over the profile's.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لفئة الأجهزة هذه إعداد ترجمة أكثر تحديدًا. تُحدّث التغييرات هنا الإعداد الافتراضي للملف الشخصي، لكن إعداد الفئة يظل مطبّقًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този тип устройства има по-конкретна настройка на субтитрите. Промените тук обновяват стандартната настройка на профила, но настройката за типа устройства продължава да важи."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest tipus de dispositiu té una opció de subtítols més específica. Els canvis que facis aquí actualitzen el valor predeterminat del perfil, però l’excepció del tipus de dispositiu continua aplicant-se."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento typ zařízení má konkrétnější nastavení titulků. Změny zde upraví výchozí nastavení profilu, ale nastavení pro typ zařízení bude dál platit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhedstype har en mere specifik undertekstindstilling. Ændringer her opdaterer profilens standard, men enhedstypens tilsidesættelse gælder stadig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Geräteart gibt es eine spezifischere Untertitel-Einstellung. Änderungen hier aktualisieren den Profilstandard, die Einstellung der Geräteart gilt aber weiterhin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η κατηγορία συσκευών έχει πιο συγκεκριμένη ρύθμιση υποτίτλων. Οι αλλαγές εδώ ενημερώνουν την προεπιλογή του προφίλ, αλλά η παράκαμψη της κατηγορίας εξακολουθεί να ισχύει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device family has a more specific subtitle setting. Changes here update the profile default, but the family override still applies."
          }
        },
        "es" : {
          "stringUnit" : {
