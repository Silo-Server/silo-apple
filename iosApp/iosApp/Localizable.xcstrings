    "pairing.summary.saveFailed" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: result line when the TV couldn't save the session it got. {server}: the server's name, followed by \" — \" and the account name when there is one (for example Home — sam).",
