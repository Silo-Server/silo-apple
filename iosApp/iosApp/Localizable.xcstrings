          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consimțământul s-a modificat; opțiunea Rapoarte de blocare a fost resetată la Întrebați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
