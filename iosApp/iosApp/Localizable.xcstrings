    "update.serverRequired" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error shown on sign-in, pairing, playback, settings and other screens when the connected Silo server is too old for this version of the app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب تحديث هذا الخادم قبل أن يتمكن هذا الإصدار من Silo من استخدامه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този сървър трябва да се актуализира, преди тази версия на Silo да може да го използва."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cal actualitzar aquest servidor perquè aquesta versió de Silo el pugui utilitzar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server je nutné aktualizovat, aby ho tato verze Silo mohla používat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne server skal opdateres, før denne version af Silo kan bruge den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server muss aktualisiert werden, bevor diese Silo-Version ihn nutzen kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο διακομιστής πρέπει να ενημερωθεί για να μπορεί να τον χρησιμοποιήσει αυτή η έκδοση του Silo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server needs to be updated before this version of Silo can use it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay que actualizar este servidor para que esta versión de Silo pueda usarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seda serverit tuleb värskendada, enne kui see Silo versioon saab seda kasutada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä palvelin on päivitettävä, ennen kuin tämä Silo-versio voi käyttää sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur doit être mis à jour pour que cette version de Silo puisse l’utiliser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לעדכן את השרת הזה כדי שהגרסה הזו של Silo תוכל להשתמש בו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
