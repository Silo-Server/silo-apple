    "settings.general.topMenuFooterTv" : {
      "comment" : "Apple TV Settings > General > Top Menu: explanation under the Show Audiobooks switch. Audiobooks is the tab's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف علامة تبويب «الكتب الصوتية» عند توفر مكتبة كتب صوتية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавя раздела „Аудиокниги“, когато има налична библиотека с аудиокниги."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix una pestanya Audiollibres quan hi ha una biblioteca d’audiollibres disponible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidá kartu Audioknihy, pokud je k dispozici knihovna audioknih."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjer fanen Lydbøger, når et lydbogsbibliotek er tilgængeligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
