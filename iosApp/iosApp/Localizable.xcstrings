    "player.notice.sourceRateLimited" : {
      "comment" : "Apple iOS/tvOS/macOS: video player notice text under Playback delayed when the media source is throttling requests.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدّ مصدر الوسائط من معدل الطلبات. حاول مرة أخرى بعد لحظات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Източникът на медия ограничава честотата на заявките. Опитайте отново след малко."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La font del contingut està limitant les sol·licituds. Torna-ho a provar d’aquí a un moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdroj médií omezuje počet požadavků. Zkuste to za chvíli znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediekilden begrænser antallet af forespørgsler. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Medienquelle begrenzt die Anfragen. Versuche es gleich erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πηγή πολυμέσων περιορίζει τον ρυθμό των αιτημάτων. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The media source is rate limiting requests. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El origen multimedia está limitando la frecuencia de las solicitudes. Vuelve a intentarlo en un momento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meediaallikas piirab päringute sagedust. Proovige hetke pärast uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medialähde rajoittaa pyyntöjen määrää. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source multimédia limite le nombre de demandes. Réessayez dans un instant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקור המדיה מגביל את קצב הבקשות. אפשר לנסות שוב בעוד רגע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मीडिया सोर्स अनुरोधों की संख्या सीमित कर रहा है। थोड़ी देर में फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvor medija ograničava broj zahtjeva. Pokušajte ponovno za trenutak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A médiaforrás korlátozza a kérések számát. Próbálja újra egy pillanat múlva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumber media sedang membatasi laju permintaan. Coba lagi sebentar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sorgente multimediale sta limitando le richieste. Riprova tra un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディアソースがリクエストを制限しています。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미디어 소스에서 요청 수를 제한하고 있어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medijos šaltinis riboja užklausų dažnį. Netrukus bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multivides avots ierobežo pieprasījumu biežumu. Mēģiniet vēlreiz pēc brīža."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumber media sedang mengehadkan kadar permintaan. Cuba lagi sebentar nanti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediekilden begrenser antall forespørsler. Prøv igjen om et øyeblikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De mediabron beperkt het aantal verzoeken. Probeer het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Źródło multimediów ogranicza liczbę żądań. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A origem da mídia está limitando as solicitações. Tente novamente em instantes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A origem multimédia está a limitar a taxa de pedidos. Tente novamente daqui a pouco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sursa media limitează rata cererilor. Încercați din nou în câteva momente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источник медиа ограничивает частоту запросов. Повторите попытку чуть позже."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdroj médií obmedzuje počet požiadaviek. Skúste to o chvíľu znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vir predstavnosti omejuje število zahtev. Poskusite znova čez trenutek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediekällan begränsar antalet förfrågningar. Försök igen om en stund."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แหล่งที่มาของสื่อกำลังจำกัดอัตราคำขอ โปรดลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medya kaynağı istekleri sınırlıyor. Birazdan tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Джерело медіа обмежує частоту запитів. Спробуйте ще раз за мить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nguồn nội dung đang giới hạn tần suất yêu cầu. Vui lòng thử lại sau giây lát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒体来源正在限制请求频率。请稍后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒體來源正在限制請求頻率。請稍後再試一次。"
          }
        }
