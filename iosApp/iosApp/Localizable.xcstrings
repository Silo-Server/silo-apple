        }
      }
    },
    "pairing.error.codeExpired" : {
      "comment" : "Phone and tablet: nearby-TV setup card, when the TV's request expired. 1: the TV's name. Apple (iPhone, iPad): same error on the nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية الرمز قبل الموافقة عليه. ابدأ من جديد على %1$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platnost kódu vypršela dřív, než byl schválen. Začněte znovu na televizi %1$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koden udløb, før den blev godkendt. Start forfra på %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code ist abgelaufen, bevor er genehmigt wurde. Beginne auf %1$@ erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code expired before it was approved. Start again on %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código caducó antes de aprobarse. Vuelve a empezar en %1$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koodi vanheni ennen hyväksyntää. Aloita uudelleen tv:ssä %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code a expiré avant d’être approuvé. Recommencez sur %1$@."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod je istekao prije odobrenja. Počnite ponovno na uređaju %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il codice è scaduto prima dell’approvazione. Ricomincia su %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認される前にコードの有効期限が切れました。%1$@でもう一度やり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인되기 전에 코드가 만료됐어요. %1$@에서 다시 시작하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koden utløp før den ble godkjent. Start på nytt på %1$@."
          }
        },
        "nl" : {
