    "pairing.error.unreachableApprove" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: error when the phone couldn't contact the server to approve. {server}: the server's name; {model}: the device model the person is holding, as the system names it (iPhone or iPad; not translated).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى %1$@ للموافقة على تسجيل الدخول. تحقق من اتصال جهاز %2$@ هذا وحاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма връзка със сървъра %1$@ за одобряване на входа. Проверете връзката на устройството %2$@ и опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut connectar amb %1$@ per aprovar l’inici de sessió. Comprova la connexió d’aquest %2$@ i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se spojit se serverem %1$@ a schválit přihlášení. Zkontrolujte připojení zařízení %2$@ a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke nå %1$@ for at godkende login. Tjek forbindelsen på denne %2$@, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ konnte zum Genehmigen der Anmeldung nicht erreicht werden. Prüfe die Verbindung auf diesem %2$@ und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η επικοινωνία με τον διακομιστή %1$@ για την έγκριση της σύνδεσης. Ελέγξτε τη σύνδεση αυτής της συσκευής %2$@ και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t reach %1$@ to approve the sign-in. Check this %2$@’s connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con %1$@ para aprobar el inicio de sesión. Comprueba la conexión de este %2$@ y vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisselogimise kinnitamiseks ei õnnestunud serveriga %1$@ ühendust saada. Kontrollige selle seadme (%2$@) ühendust ja proovige uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimeen %1$@ ei saatu yhteyttä kirjautumisen hyväksymiseksi. Tarkista tämän laitteen (%2$@) yhteys ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre %1$@ pour approuver la connexion. Vérifiez la connexion réseau de cet %2$@ et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה ליצור קשר עם השרת %1$@ כדי לאשר את ההתחברות. יש לבדוק את החיבור של המכשיר %2$@ הזה ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन इन स्वीकार करने के लिए सर्वर %1$@ तक नहीं पहुँचा जा सका। इस %2$@ का कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj %1$@ nije dostupan za odobrenje prijave. Provjerite vezu uređaja %2$@ i pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült elérni a(z) %1$@ szervert a bejelentkezés jóváhagyásához. Ellenőrizze a kapcsolatot ezen a(z) %2$@ eszközön, és próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
