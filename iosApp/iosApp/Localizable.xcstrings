    "settingsManifest.subtitle.matches_device.description" : {
      "comment" : "Help text under the subtitle.matches_device setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام نمط التسميات التوضيحية في نظام التشغيل بدلًا من نمط Silo."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използване на стила на субтитрите от операционната система вместо този на Silo."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza l’estil de subtítols del sistema operatiu en lloc del de Silo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použít styl titulků operačního systému místo stylu Silo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug styresystemets undertekststil i stedet for Silos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Untertitelstil des Betriebssystems statt dem von Silo verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρήση του στυλ υποτίτλων του λειτουργικού συστήματος αντί για εκείνο του Silo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the operating system's caption style instead of Silo's."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el estilo de subtítulos del sistema operativo en lugar del de Silo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasutab Silo subtiitrite stiili asemel operatsioonisüsteemi oma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä käyttöjärjestelmän tekstitystyyliä Silon tyylin sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le style de sous-titres du système d’exploitation au lieu de celui de Silo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שימוש בסגנון הכתוביות של מערכת ההפעלה במקום הסגנון של Silo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo की कैप्शन स्टाइल के बजाय ऑपरेटिंग सिस्टम की कैप्शन स्टाइल इस्तेमाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi stil titlova operacijskog sustava umjesto stila aplikacije Silo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az operációs rendszer feliratstílusának használata a Silo stílusa helyett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan gaya teks sistem operasi, bukan gaya Silo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa lo stile dei sottotitoli del sistema operativo invece di quello di Silo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloの字幕スタイルの代わりにOSの字幕スタイルを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo의 자막 스타일 대신 운영체제의 자막 스타일을 사용해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naudoti operacinės sistemos subtitrų stilių vietoj „Silo“ stiliaus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izmantot operētājsistēmas parakstu stilu, nevis Silo stilu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan gaya kapsyen sistem pengendalian dan bukannya gaya Silo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk operativsystemets undertekststil i stedet for Silos."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de ondertitelstijl van het besturingssysteem in plaats van die van Silo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa stylu napisów systemu operacyjnego zamiast stylu Silo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o estilo de legendas do sistema operacional em vez do estilo do Silo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o estilo de legendas do sistema operativo em vez do estilo do Silo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosiți stilul subtitrărilor din sistemul de operare în locul celui din Silo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать стиль субтитров операционной системы вместо стиля Silo."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použije štýl titulkov operačného systému namiesto štýlu aplikácie Silo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporabi slog podnapisov operacijskega sistema namesto sloga aplikacije Silo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd operativsystemets undertextstil i stället för Silos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้รูปแบบคำบรรยายของระบบปฏิบัติการแทนรูปแบบของ Silo"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo’nun altyazı stili yerine işletim sisteminin altyazı stilini kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовувати стиль субтитрів операційної системи замість стилю Silo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng kiểu phụ đề của hệ điều hành thay vì của Silo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用操作系统的字幕样式，而不是Silo的样式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用作業系統的字幕樣式，而非 Silo 的樣式。"
          }
        }
      }
