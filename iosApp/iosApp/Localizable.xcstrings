    "diagnostics.prompt.crashedHosted" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad, Apple TV), shown after a problem report is captured: message when one report is waiting. Reports go to Silo Diagnostics, the Silo project's hosted service; Silo Diagnostics is a product name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعطّل Silo مؤخرًا. يمكن أن يساعد إرسال تقرير تشخيص فريق Silo Diagnostics على فهم ما حدث."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Silo nedávno spadla. Odesláním diagnostické zprávy můžete týmu Silo Diagnostics pomoci zjistit, co se stalo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo gik ned for nylig. Hvis du sender en diagnosticeringsrapport, kan det hjælpe Silo Diagnostics-teamet med at forstå, hvad der skete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ist kürzlich abgestürzt. Ein Diagnosebericht kann dem Silo Diagnostics-Team helfen zu verstehen, was passiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo crashed recently. Sending a diagnostics report can help the Silo Diagnostics team understand what happened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo falló recientemente. Enviar un informe de diagnóstico puede ayudar al equipo de Silo Diagnostics a entender qué pasó."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kaatui äskettäin. Diagnostiikkaraportin lähettäminen voi auttaa Silo Diagnostics -tiimiä selvittämään, mitä tapahtui."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo a planté récemment. L’envoi d’un rapport de diagnostic peut aider l’équipe Silo Diagnostics à comprendre ce qui s’est passé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo se nedavno srušio. Slanje dijagnostičkog izvješća može pomoći timu Silo Diagnostics da shvati što se dogodilo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di recente Silo si è chiuso in modo anomalo. L’invio di un report di diagnostica può aiutare il team di Silo Diagnostics a capire cosa è successo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloが最近クラッシュしました。診断レポートを送信すると、Silo Diagnosticsチームが原因を把握するのに役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근에 Silo가 충돌했어요. 진단 보고서를 보내면 Silo Diagnostics 팀이 원인을 파악하는 데 도움이 돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo krasjet nylig. En diagnostikkrapport kan hjelpe Silo Diagnostics-teamet med å forstå hva som skjedde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo is onlangs gecrasht. Met een diagnostisch rapport kan het Silo Diagnostics-team begrijpen wat er is gebeurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Silo niedawno uległa awarii. Wysłanie raportu diagnostycznego może pomóc zespołowi Silo Diagnostics ustalić, co się stało."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo falhou recentemente. Enviar um relatório de diagnóstico pode ajudar a equipe do Silo Diagnostics a entender o que aconteceu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавно в Silo произошёл сбой. Отправка диагностического отчёта поможет команде Silo Diagnostics понять, что случилось."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kraschade nyligen. En diagnostikrapport kan hjälpa Silo Diagnostics-teamet att förstå vad som hände."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo yakın zamanda kilitlendi. Tanılama raporu göndermek, Silo Diagnostics ekibinin ne olduğunu anlamasına yardımcı olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нещодавно стався збій Silo. Надсилання діагностичного звіту допоможе команді Silo Diagnostics зрозуміти, що сталося."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo最近发生了崩溃。发送诊断报告可以帮助Silo Diagnostics团队了解发生了什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo 最近發生當機。傳送診斷報告可協助 Silo Diagnostics 團隊瞭解發生了什麼事。"
          }
        }
      }
    },
