        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungan ke pelayan terputus sebelum episod selesai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistet tilkoblingen til serveren før episoden var ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding met de server is verbroken voordat de aflevering afgelopen was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utracono połączenie z serwerem przed końcem odcinka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
