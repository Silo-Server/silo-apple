    "player.notice.audioChangeFailed" : {
      "comment" : "Apple iOS/tvOS/macOS: video player notice text when the player could not start switching to the chosen audio track.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تبديل المسار الصوتي. حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
