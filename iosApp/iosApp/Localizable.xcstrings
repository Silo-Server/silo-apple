    "requests.detail.hint" : {
      "comment" : "Phone: hint under the Request button on a request detail page, for a title the user can request. Apple (iPhone, iPad, Mac): same hint under the Request button on a request detail page.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس في مكتبتك بعد. يراجع مسؤول الخادم الطلبات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Още не е във вашата библиотека. Администраторът на сървъра преглежда заявките."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no és a la teva biblioteca. L’administrador del servidor revisa les sol·licituds."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím není ve vaší knihovně. Žádosti posuzuje správce serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke i dit bibliotek endnu. Din serveradministrator gennemgår anmodninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht in deiner Mediathek. Wer den Server verwaltet, prüft Anfragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει ακόμα στη βιβλιοθήκη σας. Ο διαχειριστής του διακομιστή σας εξετάζει τα αιτήματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not in your library yet. Your server admin reviews requests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no está en tu biblioteca. Quien administra tu servidor revisa las solicitudes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pole veel teie meediakogus. Taotlused vaatab üle teie serveri administraator."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vielä kirjastossasi. Palvelimen ylläpitäjä käsittelee pyynnöt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore dans votre bibliothèque. L’administrateur de votre serveur examine les demandes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין לא בספרייה שלך. מנהל השרת בודק את הבקשות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी आपकी लाइब्रेरी में नहीं है। आपके सर्वर एडमिन अनुरोधों की समीक्षा करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još nije u vašoj medijateci. Administrator poslužitelja pregledava zahtjeve."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincs a könyvtárban. A kéréseket a szerver adminisztrátora bírálja el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada di perpustakaan Anda. Admin server Anda meninjau permintaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è ancora nella tua libreria. L’amministratore del server esamina le richieste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだライブラリにありません。リクエストはサーバー管理者が確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 라이브러리에 없어요. 서버 관리자가 요청을 검토해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar nėra jūsų bibliotekoje. Užklausas peržiūri serverio administratorius."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vēl nav jūsu bibliotēkā. Pieprasījumus izskata jūsu servera administrators."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada dalam pustaka anda. Pentadbir pelayan anda menyemak permintaan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke i biblioteket ditt ennå. Serveradministratoren går gjennom forespørsler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niet in je bibliotheek. De beheerder van je server beoordeelt aanvragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze nie ma tego w twojej bibliotece. Prośby rozpatruje administrator serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não está na sua biblioteca. O administrador do servidor analisa as solicitações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não está na sua biblioteca. O administrador do servidor analisa os pedidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu este încă în biblioteca dvs. Administratorul serverului analizează cererile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этого пока нет в вашей медиатеке. Запросы рассматривает администратор сервера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatiaľ nie je vo vašej knižnici. Žiadosti posudzuje správca servera."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Še ni v vaši knjižnici. Zahteve pregleda skrbnik strežnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finns inte i ditt bibliotek än. Serverns administratör granskar förfrågningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีในคลัง ผู้ดูแลเซิร์ฟเวอร์จะตรวจสอบคำขอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz kitaplığınızda yok. İstekleri sunucu yöneticiniz inceler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цього ще немає у вашій бібліотеці. Запити розглядає адміністратор сервера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có trong thư viện của bạn. Quản trị viên máy chủ sẽ xem xét các yêu cầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未加入你的媒体库。请求由你的服务器管理员审核。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未加入你的媒體庫。伺服器管理員會審核請求。"
          }
        }
      }
    },
