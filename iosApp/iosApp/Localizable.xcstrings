    "requests.emptyBody" : {
      "comment" : "Body text of the empty state on the Requests screen (Roku, Android TV). Tells the user to use the Search screen to find a title to request. Apple TV: same empty-state body on the Requests page.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم البحث للعثور على فيلم أو مسلسل لطلبه"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвайте екрана „Търсене“, за да намерите филм или сериал за заявяване"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza Cerca per trobar una pel·lícula o una sèrie per sol·licitar"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomocí vyhledávání najděte film nebo seriál, o který chcete požádat"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug Søg til at finde en film eller serie, du kan anmode om"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde über die Suche einen Film oder eine Serie zum Anfragen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε την Αναζήτηση για να βρείτε μια ταινία ή σειρά που θέλετε να ζητήσετε"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
