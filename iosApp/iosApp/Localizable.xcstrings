        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upplösningen som används vid uppspelning via mobildata eller en annan anslutning med datapriser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความละเอียดที่ใช้เล่นเมื่อใช้ข้อมูลมือถือหรือการเชื่อมต่ออื่นที่คิดค่าบริการตามปริมาณ"
