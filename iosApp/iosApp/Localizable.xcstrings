        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripojenie k serveru sa prerušilo pred koncom epizódy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezava s strežnikom je bila prekinjena pred koncem epizode."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslutningen till servern bröts innan avsnittet var slut."
