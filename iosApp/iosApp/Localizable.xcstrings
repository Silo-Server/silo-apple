    "error.upload_limit_reached" : {
      "comment" : "Error message shown when the server answers with the v2 problem type `upload_limit_reached` (server title: \"Upload limit reached\"). Clients show it instead of the server's English detail in a translated interface, so it must make sense on its own, without the request's specifics.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هناك عمليات رفع كثيرة جارية. حاول مرة أخرى عند انتهاء إحداها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probíhá příliš mnoho nahrávání. Zkuste to znovu, až některé skončí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange uploads er i gang. Prøv igen, når en af dem er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es laufen zu viele Uploads. Versuche es erneut, wenn einer abgeschlossen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many uploads are in progress. Try again when one finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay demasiadas subidas en curso. Vuelve a intentarlo cuando termine una."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian monta lähetystä on käynnissä. Yritä uudelleen, kun jokin niistä valmistuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop d’envois sont en cours. Réessayez quand l’un d’eux sera terminé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U tijeku je previše prijenosa. Pokušajte ponovno kad neki završi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppi caricamenti in corso. Riprova quando uno è terminato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行中のアップロードが多すぎます。いずれかが完了してからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 중인 업로드가 너무 많아요. 업로드가 하나 끝나면 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange opplastinger pågår. Prøv igjen når én er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er lopen te veel uploads. Probeer het opnieuw zodra er een klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwa zbyt wiele przesyłań. Spróbuj ponownie, gdy któreś się zakończy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há envios demais em andamento. Tente novamente quando um terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполняется слишком много загрузок. Повторите попытку, когда одна из них завершится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För många uppladdningar pågår. Försök igen när någon är klar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam eden çok fazla yükleme var. Biri bittiğinde tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Триває забагато завантажень. Спробуйте ще раз, коли одне з них завершиться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在进行的上传过多。请在其中一项完成后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行中的上傳太多。請在其中一項完成後再試一次。"
          }
        }
      }
    },
