    "signIn.error.tooManyAttempts" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV) sign-in: error when the server rate-limits sign-in attempts.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محاولات تسجيل دخول كثيرة جدًا. انتظر قليلًا، ثم حاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
