    "settingsManifest.player.dv_profile7_hdr10_fallback.description" : {
      "comment" : "Help text under the player.dv_profile7_hdr10_fallback setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل مصادر ملف التعريف 7 بتنسيق HDR10 عندما يتعذّر على هذا الجهاز فك ترميزها أصليًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Възпроизвежда източници с Profile 7 като HDR10, когато това устройство не може да ги декодира директно."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodueix les fonts de perfil 7 com a HDR10 quan aquest dispositiu no les pot descodificar de manera nativa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrávat zdroje s profilem 7 jako HDR10, pokud je toto zařízení nedokáže nativně dekódovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil profil 7-kilder som HDR10, når denne enhed ikke selv kan afkode dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen mit Profil 7 als HDR10 abspielen, wenn dieses Gerät sie nicht nativ decodieren kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπαραγωγή πηγών προφίλ 7 ως HDR10 όταν αυτή η συσκευή δεν μπορεί να τις αποκωδικοποιήσει εγγενώς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play Profile 7 sources as HDR10 when this device cannot decode them natively."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce los orígenes con Profile 7 como HDR10 cuando este dispositivo no pueda decodificarlos de forma nativa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esitab profiili 7 allikad HDR10-na, kui see seade ei suuda neid otse dekodeerida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toista Dolby Vision -profiilin 7 lähteet HDR10-muodossa, kun tämä laite ei pysty purkamaan niitä suoraan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire les sources au profil 7 en HDR10 lorsque cet appareil ne peut pas les décoder nativement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעלת מקורות בפרופיל 7 בתור HDR10 כשהמכשיר הזה לא יכול לפענח אותם באופן מקורי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब यह डिवाइस प्रोफ़ाइल 7 सोर्स को सीधे डिकोड नहीं कर सकता, तब उन्हें HDR10 के रूप में चलाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducira izvore s profilom 7 kao HDR10 kada ih ovaj uređaj ne može izvorno dekodirati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 7-es profilú források lejátszása HDR10-ként, ha ez az eszköz nem tudja natívan dekódolni őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar sumber Profile 7 sebagai HDR10 jika perangkat ini tidak dapat mendekodenya secara native."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduci le sorgenti Profile 7 come HDR10 quando questo dispositivo non può decodificarle in modo nativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスがProfile 7のソースをネイティブにデコードできない場合、HDR10として再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 Profile 7 소스를 직접 디코딩할 수 없으면 HDR10으로 재생해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leisti 7 profilio šaltinius kaip HDR10, kai šis įrenginys negali jų iškoduoti tiesiogiai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atskaņot 7. profila avotus kā HDR10, ja šī ierīce nevar tos atkodēt vietēji."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mainkan sumber Profile 7 sebagai HDR10 apabila peranti ini tidak dapat menyahkodnya secara asli."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
