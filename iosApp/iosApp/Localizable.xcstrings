    "downloads.legacy.removedNotice" : {
      "comment" : "Apple iOS/macOS: alert shown once after an update removed downloads saved by an earlier version of the app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُزيلت التنزيلات من الإصدارات السابقة. نزّلها مرة أخرى لمشاهدتها دون اتصال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stažené soubory ze starších verzí byly odebrány. Pokud je chcete sledovat offline, stáhněte je znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads fra tidligere versioner er blevet fjernet. Download dem igen for at se dem offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads aus früheren Versionen wurden entfernt. Lade sie erneut herunter, um sie offline anzusehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads from earlier versions were removed. Download them again to watch offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminaron las descargas de versiones anteriores. Vuelve a descargarlas para verlas sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiempien versioiden lataukset poistettiin. Lataa ne uudelleen, jotta voit katsoa niitä offline-tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les téléchargements des versions précédentes ont été supprimés. Téléchargez-les à nouveau pour les regarder hors connexion."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzimanja iz ranijih verzija uklonjena su. Ponovno ih preuzmite kako biste ih gledali izvanmrežno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I download delle versioni precedenti sono stati rimossi. Scaricali di nuovo per guardarli offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のバージョンのダウンロードは削除されました。オフラインで視聴するには、もう一度ダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 버전의 다운로드 항목이 제거됐어요. 오프라인으로 보려면 다시 다운로드하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedlastinger fra tidligere versjoner ble fjernet. Last dem ned på nytt for å se dem uten nett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads van eerdere versies zijn verwijderd. Download ze opnieuw om offline te kijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięto pobrane pliki z wcześniejszych wersji. Pobierz je ponownie, aby oglądać offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os downloads de versões anteriores foram removidos. Baixe-os novamente para assistir offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузки из предыдущих версий удалены. Скачайте их снова, чтобы смотреть без сети."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedladdningar från tidigare versioner har tagits bort. Ladda ned dem igen för att titta offline."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceki sürümlerden kalan indirmeler kaldırıldı. Çevrimdışı izlemek için bunları yeniden indirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантаження з попередніх версій вилучено. Завантажте їх знову, щоб дивитися офлайн."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧版本中的下载已被移除。请重新下载以离线观看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舊版的下載項目已移除。請重新下載以離線觀看。"
          }
        }
      }
    },
    "downloads.manager.backgroundFootnote" : {
      "comment" : "Apple iOS/macOS: Downloads tab (page on macOS); iPhone/iPad note under the downloads in progress.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستمر التنزيلات عند مغادرة Silo أو قفل هاتفك. يؤدي إغلاق Silo من مبدّل التطبيقات إلى إيقافها مؤقتًا حتى تفتحه مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stahování pokračuje, i když Silo opustíte nebo zamknete telefon. Zavřením aplikace Silo v přepínači aplikací se stahování pozastaví, dokud ji znovu neotevřete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads fortsætter, når du forlader Silo eller låser din telefon. Hvis du lukker Silo fra appskifteren, sættes de på pause, indtil du åbner appen igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads laufen weiter, wenn du Silo verlässt oder dein Smartphone sperrst. Wenn du Silo im App-Umschalter schließt, werden sie pausiert, bis du die App wieder öffnest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads keep going when you leave Silo or lock your phone. Closing Silo from the app switcher pauses them until you open it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las descargas continúan cuando sales de Silo o bloqueas el teléfono. Si cierras Silo desde el selector de apps, se pausan hasta que vuelvas a abrirlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataukset jatkuvat, kun poistut Silosta tai lukitset puhelimen. Jos suljet Silon sovellusvaihtajasta, lataukset keskeytyvät, kunnes avaat sen uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les téléchargements continuent lorsque vous quittez Silo ou verrouillez votre téléphone. Fermer Silo depuis le sélecteur d’apps les met en pause jusqu’à sa prochaine ouverture."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzimanja se nastavljaju kada napustite Silo ili zaključate telefon. Zatvaranje aplikacije Silo u prebacivaču aplikacija pauzira ih dok je ponovno ne otvorite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I download continuano quando esci da Silo o blocchi il telefono. Se chiudi Silo dal selettore app, vengono messi in pausa finché non lo riapri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloを離れたりスマートフォンをロックしたりしても、ダウンロードは続行されます。アプリスイッチャーでSiloを終了すると、次に開くまでダウンロードは一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo를 나가거나 휴대폰을 잠가도 다운로드는 계속돼요. 앱 전환기에서 Silo를 닫으면 다시 열 때까지 다운로드가 일시정지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedlastinger fortsetter når du forlater Silo eller låser telefonen. Hvis du lukker Silo fra appveksleren, settes de på pause til du åpner appen igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads gaan door als je Silo verlaat of je telefoon vergrendelt. Als je Silo sluit via de appkiezer, worden ze gepauzeerd tot je de app weer opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobieranie trwa dalej, gdy opuścisz Silo lub zablokujesz telefon. Zamknięcie Silo w przełączniku aplikacji wstrzymuje je do ponownego otwarcia aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os downloads continuam quando você sai do Silo ou bloqueia o celular. Fechar o Silo no seletor de apps os pausa até você abri-lo novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузки продолжаются, когда вы выходите из Silo или блокируете телефон. Если закрыть Silo в переключателе приложений, они будут приостановлены, пока вы снова не откроете приложение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedladdningar fortsätter när du lämnar Silo eller låser telefonen. Om du stänger Silo i appväxlaren pausas de tills du öppnar appen igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo’dan çıktığınızda veya telefonunuzu kilitlediğinizde indirmeler devam eder. Silo’yu uygulama değiştiriciden kapatırsanız indirmeler, uygulamayı yeniden açana kadar duraklatılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантаження тривають, коли ви виходите із Silo або блокуєте телефон. Якщо закрити Silo в перемикачі застосунків, їх буде призупинено, доки ви знову його не відкриєте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开Silo或锁定手机后，下载会继续进行。从App切换器中关闭Silo会暂停下载，直到你再次打开它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開 Silo 或鎖定手機後，下載仍會繼續。從 App 切換器關閉 Silo 會暫停下載，直到你再次開啟。"
          }
        }
      }
    },
