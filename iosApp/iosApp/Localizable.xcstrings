    },
    "settings.connection.skippedMeteredCellularQuality" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) (iPhone, iPad): replaces the connection speed on a metered network such as a hotspot, where the Cellular Quality setting applies.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُجرى اختبارات السرعة على الشبكات محدودة البيانات، وتُطبَّق إعدادات جودة شبكة الهاتف المحمول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In getakteten Netzwerken werden keine Geschwindigkeitstests ausgeführt; es gelten die Einstellungen unter „Mobilfunkqualität“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speed tests are skipped on metered networks, and the Cellular Quality settings apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pruebas de velocidad no se hacen en redes de uso medido, y se aplica la configuración de Calidad con datos móviles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tests de vitesse ne sont pas effectués sur les réseaux à données limitées, et les paramètres Qualité sur réseau mobile s’appliquent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "従量制ネットワークでは速度テストは行われず、モバイル通信の画質の設定が適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os testes de velocidade não são feitos em redes limitadas, e as configurações de Qualidade em dados móveis se aplicam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用按流量计费的网络时不进行测速，将应用蜂窝网络画质设置。"
          }
        }
      }
    },
