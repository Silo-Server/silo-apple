    "settings.accounts.expiredTitleAppleTv" : {
      "comment" : "Apple TV Settings > Accounts: title of the dialog for an account whose sign-in expired, offering Sign in again or Sign Out. {account}: the account's username, or the word Account when it isn't known.",
