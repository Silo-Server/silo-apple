    "settings.general.themeMusicFooterTv" : {
      "comment" : "Apple TV Settings > General > Theme Music: explanation under the switches.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل الأغنية الرئيسية للعنوان من مكتبتك أثناء فتح صفحته. يؤثر في هذا Apple TV فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt die Titelmusik eines Titels aus deiner Mediathek, solange seine Seite geöffnet ist. Gilt nur für dieses Apple TV."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play a title's theme song from your library while its page is open. Only affects this Apple TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce el tema musical de un título desde tu biblioteca mientras su página está abierta. Solo afecta a este Apple TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit le thème musical d’un titre depuis votre bibliothèque tant que sa page est ouverte. S’applique uniquement à cette Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作品のページを開いている間、ライブラリにあるテーマ曲を再生します。このApple TVにのみ適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca a música tema de um título da sua biblioteca enquanto a página dele estiver aberta. Afeta só esta Apple TV."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开作品页面时，播放媒体库中该作品的主题曲。仅影响这台Apple TV。"
          }
        }
      }
    },
    "settings.general.themeMusicHeaderTv" : {
      "comment" : "Apple TV Settings > General: uppercase heading of the theme music switches. Keep it uppercase where the script has case.",
      "extractionState" : "manual",
      "localizations" : {
