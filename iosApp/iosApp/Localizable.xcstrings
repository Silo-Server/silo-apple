    "player.subtitles.lowLegibility" : {
      "comment" : "Apple iOS: warning under the subtitle preview on the Subtitle Appearance page of the iPhone and iPad player settings sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضوح منخفض — قد تصعب قراءة النص الشديد الشفافية أو الداكن دون مربع أو حد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ниска четливост – много прозрачен или тъмен текст без фон или контур може да се чете трудно."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegibilitat baixa: el text molt transparent o fosc sense requadre ni contorn pot ser difícil de llegir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nízká čitelnost – velmi průhledný nebo tmavý text bez podkladu či obrysu může být špatně čitelný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lav læsbarhed – meget gennemsigtig eller mørk tekst uden boks eller kontur kan være svær at læse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlechte Lesbarkeit – sehr transparenter oder dunkler Text ohne Kasten oder Umriss ist eventuell schwer zu lesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χαμηλή αναγνωσιμότητα – πολύ διαφανές ή σκούρο κείμενο χωρίς πλαίσιο ή περίγραμμα μπορεί να διαβάζεται δύσκολα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low legibility — very transparent or dark text without a box or outline can be hard to read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legibilidad baja: el texto muy transparente u oscuro sin recuadro ni contorno puede ser difícil de leer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halb loetavus – väga läbipaistvat või tumedat teksti ilma kasti või kontuurita võib olla raske lugeda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heikko luettavuus – hyvin läpinäkyvää tai tummaa tekstiä ilman laatikkoa tai ääriviivaa voi olla vaikea lukea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisibilité faible : un texte très transparent ou sombre sans encadré ni contour peut être difficile à lire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קריאוּת נמוכה – טקסט שקוף מאוד או כהה ללא תיבה או קו מתאר עלול להיות קשה לקריאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पढ़ने में मुश्किल — बिना बॉक्स या आउटलाइन के बहुत पारदर्शी या गहरा टेक्स्ट पढ़ना मुश्किल हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaba čitljivost — vrlo proziran ili taman tekst bez okvira ili obruba može biti teško čitljiv."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyenge olvashatóság – a nagyon átlátszó vagy sötét szöveg doboz vagy körvonal nélkül nehezen olvasható."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keterbacaan rendah — teks yang sangat transparan atau gelap tanpa kotak atau garis tepi bisa sulit dibaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggibilità scarsa: un testo molto trasparente o scuro senza riquadro o contorno può essere difficile da leggere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読みにくい表示です。透明度が高い文字や暗い文字は、ボックスや縁取りがないと読みにくい場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가독성 낮음: 상자나 윤곽선 없이 매우 투명하거나 어두운 텍스트는 읽기 어려울 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prastas įskaitomumas – labai permatomą arba tamsų tekstą be stačiakampio ar kontūro gali būti sunku perskaityti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zema salasāmība – ļoti caurspīdīgu vai tumšu tekstu bez lodziņa vai kontūras var būt grūti izlasīt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebolehbacaan rendah — teks yang sangat lut sinar atau gelap tanpa kotak atau garis luar mungkin sukar dibaca."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dårlig lesbarhet – svært gjennomsiktig eller mørk tekst uten boks eller kontur kan være vanskelig å lese."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slecht leesbaar — zeer transparante of donkere tekst zonder vlak of contour kan moeilijk te lezen zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niska czytelność — bardzo przezroczysty lub ciemny tekst bez pola lub konturu może być trudny do odczytania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa legibilidade — texto muito transparente ou escuro sem caixa ou contorno pode ser difícil de ler."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legibilidade reduzida — texto muito transparente ou escuro sem caixa nem contorno pode ser difícil de ler."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lizibilitate redusă — textul foarte transparent sau întunecat, fără casetă sau contur, poate fi greu de citit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плохая читаемость — очень прозрачный или тёмный текст без подложки или контура может быть трудно прочитать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nízka čitateľnosť – veľmi priehľadný alebo tmavý text bez rámčeka či obrysu môže byť ťažko čitateľný."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaba berljivost – zelo prosojno ali temno besedilo brez polja ali obrobe je lahko težko berljivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låg läsbarhet – mycket genomskinlig eller mörk text utan ruta eller kontur kan vara svår att läsa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านยาก ข้อความที่โปร่งใสมากหรือสีเข้มโดยไม่มีกล่องหรือเส้นขอบอาจอ่านได้ยาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşük okunabilirlik: kutu veya dış çizgi olmadan çok saydam ya da koyu metin zor okunabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Погана розбірливість – дуже прозорий або темний текст без підкладки чи контуру може бути важко читати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khó đọc — chữ quá trong suốt hoặc quá tối mà không có khung nền hay viền có thể khó đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可读性低：非常透明或较暗的文字在没有方框或描边时可能难以阅读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可讀性低：文字過於透明或過暗，且沒有方框或外框時，可能不易閱讀。"
          }
        }
      }
    },
