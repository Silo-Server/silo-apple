    "player.subtitles.lowLegibility" : {
      "comment" : "Apple iOS: warning under the subtitle preview on the Subtitle Appearance page of the iPhone and iPad player settings sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضوح منخفض — قد تصعب قراءة النص الشديد الشفافية أو الداكن دون مربع أو حد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlechte Lesbarkeit – sehr transparenter oder dunkler Text ohne Kasten oder Umriss ist eventuell schwer zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low legibility — very transparent or dark text without a box or outline can be hard to read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legibilidad baja: el texto muy transparente u oscuro sin recuadro ni contorno puede ser difícil de leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisibilité faible : un texte très transparent ou sombre sans encadré ni contour peut être difficile à lire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読みにくい表示です。透明度が高い文字や暗い文字は、ボックスや縁取りがないと読みにくい場合があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa legibilidade — texto muito transparente ou escuro sem caixa ou contorno pode ser difícil de ler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可读性低：非常透明或较暗的文字在没有方框或描边时可能难以阅读。"
          }
        }
      }
    },
