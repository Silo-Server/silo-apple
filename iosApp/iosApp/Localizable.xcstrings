        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неудавшийся запрос «%1$@» будет удалён. Позже вы сможете запросить его снова."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša neúspešná žiadosť o titul „%1$@“ sa odstráni. Titul si môžete neskôr vyžiadať znova."
          }
        },
        "sl" : {
