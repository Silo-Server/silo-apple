          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osad, mida server ei saa sellesse kvaliteeti teisendada, jäetakse vahele."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaksot, joita palvelin ei voi muuntaa tähän laatuun, ohitetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes que le serveur ne peut pas convertir dans cette qualité sont ignorés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרקים שהשרת לא יכול להמיר לאיכות הזו לא יורדו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन एपिसोड को सर्वर इस क्वालिटी में नहीं बदल सकता, उन्हें छोड़ दिया जाता है।"
