        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil %1$@ na televizorju %3$@ gleda vsebino %2$@. Želite namesto tega predvajati svojo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tittar på %2$@ på %3$@. Vill du spela upp ditt i stället?"
