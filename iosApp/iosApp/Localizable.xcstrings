          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoen eller profilen blev ændret. Afspilningen blev ikke forsøgt igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
