    "account.replace.message" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message of the replace-account confirmation. {server}: the server's display name; {new_account}: username of the account now signed in; {old_account}: username of the account Replace would sign out.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجلت الدخول الآن إلى %1$@ باسم %2$@. يؤدي الاستبدال إلى تسجيل الخروج من %3$@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вече сте влезли в %1$@ като %2$@. При замяната ще излезете от %3$@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ara has iniciat la sessió a %1$@ com a %2$@. En substituir-lo, es tancarà la sessió iniciada amb %3$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyní jste přihlášeni jako %2$@ (%1$@). Nahrazením se odhlásí %3$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er nu logget ind på %1$@ som %2$@. Hvis du erstatter, logges der ud af %3$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist jetzt bei %1$@ als %2$@ angemeldet. Beim Ersetzen wird %3$@ abgemeldet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθήκατε τώρα σε %1$@ ως %2$@. Με την αντικατάσταση θα αποσυνδεθείτε από %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're now signed in to %1$@ as %2$@. Replacing signs out of %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes la sesión iniciada en %1$@ como %2$@. Al reemplazar, se cerrará la sesión de %3$@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olete nüüd serverisse %1$@ sisse logitud kasutajana %2$@. Asendamisel logitakse välja %3$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet nyt kirjautunut palvelimelle %1$@ käyttäjänä %2$@. Korvaaminen kirjaa ulos tilin: %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à %1$@ utilise maintenant %2$@. Le remplacement déconnecte %3$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחברת עכשיו לשרת %1$@ בתור %2$@. ההחלפה תבצע התנתקות מ-%3$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अब आपने %1$@ पर %2$@ के रूप में साइन इन किया है। बदलने पर %3$@ से साइन आउट हो जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sada ste prijavljeni na %1$@ kao %2$@. Zamjenom se odjavljuje %3$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most %2$@ néven van bejelentkezve a(z) %1$@ szerveren. A cserével kijelentkezik innen: %3$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda kini masuk ke %1$@ sebagai %2$@. Mengganti akan keluar dari %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora hai effettuato l’accesso a %1$@ come %2$@. Con la sostituzione esci da %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に%2$@としてサインインしました。置き換えると%3$@からサインアウトします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 %1$@에 %2$@(으)로 로그인되어 있어요. 대체하면 %3$@에서 로그아웃돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisijungėte prie serverio %1$@ kaip %2$@. Pakeitus bus atsijungta nuo paskyros %3$@."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūs pierakstījāties serverī %1$@ ar kontu %2$@. Aizstājot tiks veikta izrakstīšanās no konta %3$@."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda kini log masuk ke %1$@ sebagai %2$@. Penggantian akan log keluar daripada %3$@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er nå logget på %1$@ som %2$@. Hvis du erstatter, logges du ut av %3$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent nu bij %1$@ ingelogd als %2$@. Bij vervangen log je uit bij %3$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalogowano jako %2$@ (serwer: %1$@). Zastąpienie wyloguje %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entrou em %1$@ como %2$@. Ao substituir, você sai de %3$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem agora sessão iniciada no servidor %1$@ como %2$@. Ao substituir, termina a sessão de %3$@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V-ați conectat acum la %1$@ ca %2$@. Prin înlocuire vă deconectați de la %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы вошли на сервер %1$@ под именем %2$@. При замене будет выполнен выход из аккаунта %3$@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na serveri %1$@ je teraz prihlásený účet %2$@. Nahradením sa odhlási %3$@."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdaj ste na strežniku %1$@ prijavljeni kot %2$@. Z zamenjavo se odjavite iz računa %3$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är nu inloggad på %1$@ som %2$@. Om du ersätter loggar du ut från %3$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้คุณลงชื่อเข้าใช้ %1$@ ในชื่อ %2$@ แล้ว การแทนที่จะออกจากระบบ %3$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ üzerinde artık %2$@ olarak oturum açtınız. Değiştirme işlemi şu hesabın oturumunu kapatır: %3$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тепер ви ввійшли на %1$@ як %2$@. Під час заміни буде виконано вихід, і %3$@ буде вилучено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hiện đã đăng nhập vào %1$@ với tên %2$@. Thay thế sẽ đăng xuất khỏi %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你现在已以%2$@的身份登录%1$@。替换将退出%3$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你現在已用 %2$@ 登入 %1$@。取代後會登出 %3$@。"
          }
        }
      }
    },
    "account.replace.title" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): title of the confirmation shown after Sign in again on a saved account landed on a different account. {old_account}: username of the account that was signed in again; {new_account}: username of the account now signed in.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
