                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Báo cáo gửi đến dịch vụ lưu trữ dùng thông tin xác thực bí danh của bản cài đặt, không liên kết với tài khoản Silo của bạn. Báo cáo lược bỏ mã định danh tài khoản, hồ sơ, địa chỉ máy chủ và phiên phát, được lưu giữ tối đa %1$lld ngày và không bao giờ được gửi tự động."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Báo cáo gửi đến dịch vụ lưu trữ dùng thông tin xác thực bí danh của bản cài đặt, không liên kết với tài khoản Silo của bạn. Báo cáo lược bỏ mã định danh tài khoản, hồ sơ, địa chỉ máy chủ và phiên phát, được lưu giữ tối đa %1$lld ngày và không bao giờ được gửi tự động."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "托管报告使用不与你的Silo账户关联的假名化安装凭据。报告不包含账户、个人资料、服务器地址和播放会话标识符，最多保留%1$lld天，且绝不会自动发送。"
                }
              }
            }
          }
        },
        "zh-Hant" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "託管報告使用不會連結至你 Silo 帳號的假名化安裝憑證。報告不含帳號、個人檔案、伺服器位址和播放工作階段識別碼，最多保留 %1$lld 天，且絕不會自動傳送。"
                }
              }
            }
          }
        }
      }
    },
    "diagnostics.manual.hostedFooter" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad): footer under Send Diagnostics Now when reports go to Silo Diagnostics, the hosted service.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتضمن التقرير المستضاف تفاصيل قدرات الجهاز وسجلات التشخيص الحديثة بعد تنقيحها. ويستبعد معرّفات الحساب والملف الشخصي وعنوان الخادم وجلسة التشغيل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчетът към хостваната услуга съдържа данни за възможностите на устройството и скорошни диагностични дневници със скрити чувствителни данни. Не съдържа идентификатори на акаунта, профила, адреса на сървъра и сесиите за възпроизвеждане."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un informe allotjat inclou detalls de les capacitats del dispositiu i registres de diagnòstic recents amb dades ocultades. Omet els identificadors del compte, del perfil, de l’adreça del servidor i de la sessió de reproducció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostovaná zpráva obsahuje podrobnosti o schopnostech zařízení a nedávné diagnostické protokoly s odstraněnými citlivými údaji. Neobsahuje identifikátory účtu, profilu, adresy serveru ani relací přehrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hostet rapport indeholder oplysninger om enhedens funktioner og nylige maskerede diagnostiske logs. Den udelader id’er for konto, profil, serveradresse og afspilningssession."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gehosteter Bericht enthält Angaben zu den Gerätefähigkeiten und aktuelle, geschwärzte Diagnoseprotokolle. Konto-, Profil-, Serveradressen- und Wiedergabe-Sitzungskennungen sind nicht enthalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια αναφορά προς τη φιλοξενούμενη υπηρεσία περιλαμβάνει λεπτομέρειες για τις δυνατότητες της συσκευής και πρόσφατα αρχεία καταγραφής διαγνωστικών με απαλειμμένα ευαίσθητα στοιχεία. Παραλείπει τα αναγνωριστικά λογαριασμού, προφίλ, διεύθυνσης διακομιστή και συνεδρίας αναπαραγωγής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hosted report includes device capability details and recent redacted diagnostic logs. It omits account, profile, server address, and playback session identifiers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un informe alojado incluye detalles de las capacidades del dispositivo y registros de diagnóstico recientes con los datos sensibles ocultos. Omite los identificadores de cuenta, perfil, dirección del servidor y sesión de reproducción."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostitud aruanne sisaldab seadme võimekuse üksikasju ja hiljutisi maskeeritud diagnostikalogisid. See ei sisalda konto, profiili, serveri aadressi ega esitusseansi identifikaatoreid."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics -palveluun lähetettävä raportti sisältää laitteen ominaisuustiedot ja viimeaikaiset suodatetut diagnostiikkalokit. Siitä jätetään pois tilin, profiilin, palvelimen osoitteen ja toistoistuntojen tunnisteet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rapport hébergé inclut les capacités de l’appareil et les journaux de diagnostic récents expurgés. Il omet les identifiants de compte, de profil, d’adresse du serveur et de session de lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דוח שנשלח לשירות המתארח כולל פרטים על יכולות המכשיר ויומני אבחון אחרונים לאחר השחרת מידע רגיש. הוא לא כולל מזהי חשבון, פרופיל, כתובת שרת וסשן הפעלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होस्ट की गई रिपोर्ट में डिवाइस की क्षमताओं की जानकारी और संवेदनशील जानकारी हटाए गए हाल के डायग्नोस्टिक लॉग शामिल होते हैं। इसमें खाता, प्रोफ़ाइल, सर्वर पता और प्लेबैक सेशन पहचानकर्ता शामिल नहीं होते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvješće za hostirani servis sadrži pojedinosti o mogućnostima uređaja i nedavne redigirane dijagnostičke zapisnike. Ne sadrži identifikatore računa, profila, adrese poslužitelja ni sesije reprodukcije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo Diagnostics szolgáltatásnak küldött jelentés tartalmazza az eszköz képességeinek adatait és a legutóbbi, kitakart diagnosztikai naplókat. Nem tartalmaz fiók-, profil-, szervercím- és lejátszási munkamenet-azonosítókat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan yang di-hosting mencakup detail kemampuan perangkat dan log diagnostik terbaru yang telah disamarkan. Laporan ini tidak menyertakan pengidentifikasi akun, profil, alamat server, dan sesi pemutaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un report ospitato include i dettagli sulle funzionalità del dispositivo e i log di diagnostica recenti con i dati sensibili oscurati. Omette gli identificatori di account, profilo, indirizzo del server e sessione di riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト型のレポートには、デバイスの機能の詳細と、個人情報を除去した最近の診断ログが含まれます。アカウント、プロフィール、サーバーアドレス、再生セッションの識別子は含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스팅 보고서에는 기기 기능 세부정보와 민감한 정보를 가린 최근 진단 로그가 포함돼요. 계정, 프로필, 서버 주소, 재생 세션 식별자는 제외돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talpinamosios tarnybos pranešime pateikiama įrenginio galimybių informacija ir naujausi diagnostikos žurnalai su paslėptais duomenimis. Jame nepateikiami paskyros, profilio, serverio adreso ir atkūrimo seanso identifikatoriai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitinātajā pārskatā ir iekļauta informācija par ierīces iespējām un nesenie diagnostikas žurnāli ar aizklātiem datiem. Tajā nav konta, profila, servera adreses un atskaņošanas sesijas identifikatoru."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan yang dihoskan merangkumi butiran keupayaan peranti dan log diagnostik terbaharu yang telah disunting. Laporan ini tidak menyertakan pengecam akaun, profil, alamat pelayan dan sesi main balik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hostet rapport inneholder detaljer om enhetens funksjoner og nylige sladdede diagnostikklogger. Den utelater identifikatorer for konto, profil, serveradresse og avspillingsøkt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gehost rapport bevat gegevens over de mogelijkheden van het apparaat en recente, opgeschoonde diagnostische logs. Identificatiegegevens van account, profiel, serveradres en afspeelsessie worden weggelaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raport wysyłany do usługi hostowanej zawiera informacje o możliwościach urządzenia i najnowsze logi diagnostyczne oczyszczone z danych wrażliwych. Nie zawiera identyfikatorów konta, profilu, adresu serwera ani sesji odtwarzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um relatório hospedado inclui detalhes dos recursos do dispositivo e logs de diagnóstico recentes com dados ocultados. Ele omite identificadores de conta, perfil, endereço do servidor e sessão de reprodução."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um relatório alojado inclui detalhes das capacidades do dispositivo e registos de diagnóstico recentes com dados ocultados. Omite os identificadores de conta, perfil, endereço do servidor e sessão de reprodução."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un raport găzduit include detalii despre capacitățile dispozitivului și jurnale de diagnosticare recente anonimizate. Omite identificatorii de cont, profil, adresă a serverului și sesiune de redare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчёт для Silo Diagnostics содержит сведения о возможностях устройства и недавние обезличенные диагностические логи. В него не входят идентификаторы аккаунта, профиля, адреса сервера и сеансов воспроизведения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlásenie do hostovanej služby obsahuje údaje o možnostiach zariadenia a nedávne diagnostické denníky s odstránenými citlivými údajmi. Neobsahuje identifikátory účtu, profilu, adresy servera ani relácie prehrávania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostovano poročilo vključuje podrobnosti o zmogljivostih naprave in nedavne zakrite diagnostične dnevnike. Ne vsebuje identifikatorjev računa, profila, naslova strežnika in seje predvajanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rapport till den värdbaserade tjänsten innehåller information om enhetens funktioner och de senaste diagnostikloggarna i maskerad form. Den innehåller inga identifierare för konto, profil, serveradress eller uppspelningssession."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายงานที่โฮสต์ประกอบด้วยรายละเอียดความสามารถของอุปกรณ์และล็อกการวินิจฉัยล่าสุดที่ปกปิดข้อมูลแล้ว โดยไม่รวมตัวระบุบัญชี โปรไฟล์ ที่อยู่เซิร์ฟเวอร์ และเซสชันการเล่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barındırılan rapor, cihaz özelliği ayrıntılarını ve hassas bilgileri ayıklanmış son tanılama günlüklerini içerir. Hesap, profil, sunucu adresi ve oynatma oturumu tanımlayıcılarını içermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звіт для Silo Diagnostics містить відомості про можливості пристрою й останні діагностичні логи з вилученими особистими даними. До нього не входять ідентифікатори облікового запису, профілю, адреси сервера й сеансів відтворення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo gửi đến dịch vụ lưu trữ bao gồm chi tiết về khả năng của thiết bị và nhật ký chẩn đoán gần đây đã được ẩn thông tin nhạy cảm. Báo cáo lược bỏ mã định danh tài khoản, hồ sơ, địa chỉ máy chủ và phiên phát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "托管报告包含设备功能详情和近期经过脱敏的诊断日志，不包含账户、个人资料、服务器地址和播放会话标识符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "託管報告包含裝置功能詳細資料和近期經過遮蔽處理的診斷記錄。報告不含帳號、個人檔案、伺服器位址和播放工作階段識別碼。"
          }
        }
      }
    },
    "diagnostics.manual.selfHostedFooter" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad): footer under Send Diagnostics Now when reports go to the user's own server.",
      "extractionState" : "manual",
      "localizations" : {
