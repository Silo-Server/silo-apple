        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere Anfrage mit derselben ID wurde bereits gesendet. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A different request with the same ID was already sent. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya se envió otra solicitud con el mismo ID. Vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eri pyyntö samalla tunnuksella on jo lähetetty. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre demande avec le même identifiant a déjà été envoyée. Réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drugačiji zahtjev s istim ID-om već je poslan. Pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È già stata inviata una richiesta diversa con lo stesso ID. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じIDの別のリクエストがすでに送信されています。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
