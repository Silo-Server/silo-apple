    "errors.apple.request.ownerChangedBeforeStart" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error shown where a server request failed because the user switched server or profile before it was sent. Nothing was sent.",
      "extractionState" : "manual",
      "localizations" : {
