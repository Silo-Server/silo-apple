    "watchParty.banner.unavailable.guest" : {
      "comment" : "Roku: warning banner in the lobby shown to guests when the chosen title is not available to their profile. {host}: the host's display name. Apple (iPhone, iPad, Apple TV): same warning banner in the lobby for guests. Android phone and TV Watch Party lobby: same banner for a guest. 1: the host's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا العنوان غير متاح لملفك الشخصي. سيتعيّن على %1$@ اختيار عنوان آخر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento titul není pro váš profil dostupný. Hostitel %1$@ bude muset vybrat něco jiného."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne titel er ikke tilgængelig for din profil. %1$@ skal vælge noget andet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Titel ist für dein Profil nicht verfügbar. %1$@ muss etwas anderes auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This title isn't available to your profile. %1$@ will need to pick something else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este título no está disponible para tu perfil. %1$@ tendrá que elegir otra cosa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä nimike ei ole saatavilla profiilillesi. Järjestäjän %1$@ täytyy valita jotain muuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce titre n’est pas disponible pour votre profil. %1$@ devra choisir autre chose."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj naslov nije dostupan vašem profilu. %1$@ će morati odabrati nešto drugo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo titolo non è disponibile per il tuo profilo. %1$@ dovrà scegliere qualcos’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタイトルはこのプロフィールでは視聴できません。%1$@さんが別のタイトルを選ぶ必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작품은 내 프로필에서 볼 수 없어요. %1$@님이 다른 작품을 선택해야 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne tittelen er ikke tilgjengelig for profilen din. %1$@ må velge noe annet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze titel is niet beschikbaar voor je profiel. %1$@ moet iets anders kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten tytuł nie jest dostępny dla twojego profilu. Osoba prowadząca %1$@ musi wybrać coś innego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este título não está disponível para seu perfil. %1$@ precisará escolher outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это недоступно для вашего профиля. Организатору %1$@ нужно будет выбрать что-то другое."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här titeln är inte tillgänglig för din profil. %1$@ behöver välja något annat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu içerik profilinizde kullanılamıyor. %1$@ başka bir şey seçmeli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця назва недоступна для вашого профілю. %1$@ має вибрати щось інше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的个人资料无法观看此影片。%1$@需要另选一部。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的個人檔案無法觀看這部作品。%1$@ 需要選擇其他作品。"
          }
        }
      }
    },
    "watchParty.banner.unavailable.manager" : {
      "comment" : "Roku: warning banner in the lobby shown to the host when the chosen title is not available to this profile. Apple (iPhone, iPad, Apple TV): same warning banner in the lobby for the host. Android phone and TV Watch Party lobby: same banner for the host.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا العنوان غير متاح لملفك الشخصي. اختر عنوانًا آخر ليتمكن الجميع من المشاهدة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento titul není pro váš profil dostupný. Vyberte něco jiného, aby se mohli dívat všichni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne titel er ikke tilgængelig for din profil. Vælg noget andet, så alle kan se med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Titel ist für dein Profil nicht verfügbar. Wähle etwas anderes, damit alle schauen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This title isn't available to your profile. Choose something else so everyone can watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este título no está disponible para tu perfil. Elige otra cosa para que todos puedan verla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä nimike ei ole saatavilla profiilillesi. Valitse jotain muuta, jotta kaikki voivat katsoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce titre n’est pas disponible pour votre profil. Choisissez autre chose pour que tout le monde puisse regarder."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj naslov nije dostupan vašem profilu. Odaberite nešto drugo kako bi svi mogli gledati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo titolo non è disponibile per il tuo profilo. Scegli qualcos’altro così tutti possono guardare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタイトルはこのプロフィールでは視聴できません。全員が視聴できるよう、別のタイトルを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작품은 내 프로필에서 볼 수 없어요. 모두 함께 볼 수 있도록 다른 작품을 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne tittelen er ikke tilgjengelig for profilen din. Velg noe annet, så alle kan se."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze titel is niet beschikbaar voor je profiel. Kies iets anders zodat iedereen kan kijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten tytuł nie jest dostępny dla twojego profilu. Wybierz coś innego, aby wszyscy mogli oglądać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este título não está disponível para seu perfil. Escolha outro para que todo mundo possa assistir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это недоступно для вашего профиля. Выберите что-нибудь другое, чтобы смотреть могли все."
          }
        },
        "sv" : {
          "stringUnit" : {
