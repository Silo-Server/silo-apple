    "buffering.promptMessage" : {
      "comment" : "Roku player: message in the buffering prompt suggesting a lower video quality so playback can continue. Apple iOS/tvOS/macOS: second line of the buffering pill over the player.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جرّب جودة أقل لمواصلة المشاهدة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkuste nižší kvalitu a pokračujte ve sledování"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv en lavere kvalitet for at se videre"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine niedrigere Qualität, um weiterzuschauen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try a lower quality to keep watching"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba una calidad más baja para seguir viendo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatka katselua kokeilemalla alempaa laatua"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez une qualité inférieure pour continuer à regarder"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smanjite kvalitetu da biste nastavili gledati"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova una qualità inferiore per continuare a guardare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴を続けるには画質を下げてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속 시청하려면 더 낮은 화질을 사용해 보세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv en lavere kvalitet for å se videre"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een lagere kwaliteit om verder te kijken"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obniż jakość, aby oglądać dalej"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente uma qualidade menor para continuar assistindo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите качество пониже, чтобы продолжить просмотр"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova en lägre kvalitet för att fortsätta titta"
          }
        },
        "tr" : {
