    "detail.offlineChoice.body" : {
      "comment" : "Apple iOS: message of the dialog shown on Play when the title is also downloaded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل النسخة المحفوظة على هذا الجهاز، أو ابدأ البث من الخادم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Възпроизведете копието, запазено на това устройство, или предавайте поточно от сървъра."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodueix la còpia desada en aquest dispositiu o fes streaming des del servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrajte kopii uloženou v tomto zařízení, nebo streamujte ze serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil kopien, der er gemt på denne enhed, eller stream fra serveren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele die auf diesem Gerät gespeicherte Kopie ab oder streame vom Server."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπαραγάγετε το αντίγραφο που είναι αποθηκευμένο σε αυτή τη συσκευή ή αναπαραγάγετε μέσω ροής από τον διακομιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play the copy saved on this device, or stream from the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce la copia guardada en este dispositivo o transmítela desde el servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esitage selles seadmes salvestatud koopia või voogedastage serverist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toista tälle laitteelle tallennettu kopio tai suoratoista palvelimelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez la copie enregistrée sur cet appareil ou lancez le streaming depuis le serveur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
