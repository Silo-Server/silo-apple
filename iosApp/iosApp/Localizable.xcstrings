        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the bookmark icon on any item to add it here"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el icono de marcador en cualquier elemento para añadirlo aquí"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puudutage mis tahes üksuse järjehoidjaikooni, et see siia lisada"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
