    "settingsManifest.home.hide_watched_items.description" : {
      "comment" : "Help text under the home.hide_watched_items setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إزالة العناصر المشاهَدة من أقسام الرئيسية العادية مع إبقاء قسم المميز وأقسام سجل المشاهدة دون تغيير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt Gesehenes aus den normalen Bereichen der Startseite; „Empfohlen“ und Bereiche mit dem Verlauf bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove watched items from ordinary Home sections while keeping Featured and watch-history sections unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita los elementos vistos de las secciones normales de Inicio, sin cambiar Destacados ni las secciones del historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire les éléments vus des sections ordinaires de l’Accueil, sans modifier les sections À la une et d’historique de visionnage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常のホームのセクションから視聴済みのアイテムを外します。注目と視聴履歴のセクションは変わりません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove os itens assistidos das seções comuns do Início, sem alterar as seções Destaques e de histórico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从首页的普通版块中移除已观看的条目，精选和观看历史版块保持不变。"
          }
        }
      }
    },
