          }
        }
      }
    },
    "tvPairing.failedUnreachableHelp" : {
      "comment" : "Apple TV pairing screen (shown while a nearby phone sets up or signs in this Apple TV): failure body when the Apple TV couldn't reach the server and a specific reason is known. {help}: the reason and recovery steps, full sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ يمكنك أيضًا إضافة الخادم يدويًا باستخدام عنوانه العام."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Server můžete také přidat ručně pomocí jeho veřejné adresy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Du kan også tilføje serveren manuelt med dens offentlige adresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Du kannst den Server auch manuell mit seiner öffentlichen Adresse hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ You can also add the server manually with its public address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ También puedes añadir el servidor manualmente con su dirección pública."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Voit myös lisätä palvelimen manuaalisesti sen julkisella osoitteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Vous pouvez aussi ajouter le serveur manuellement avec son adresse publique."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Poslužitelj možete dodati i ručno pomoću njegove javne adrese."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Puoi anche aggiungere il server manualmente con il suo indirizzo pubblico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@公開アドレスを使ってサーバーを手動で追加することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 공개 주소로 서버를 직접 추가할 수도 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Du kan også legge til serveren manuelt med den offentlige adressen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Je kunt de server ook handmatig toevoegen met het openbare adres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Możesz też dodać serwer ręcznie, podając jego adres publiczny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Você também pode adicionar o servidor manualmente com o endereço público dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Вы также можете добавить сервер вручную по его публичному адресу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Du kan också lägga till servern manuellt med dess offentliga adress."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Sunucuyu genel adresiyle elle de ekleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Також можна додати сервер вручну за його публічною адресою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@你也可以使用服务器的公网地址手动添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@你也可以用伺服器的公開位址手動新增伺服器。"
          }
        }
      }
    },
