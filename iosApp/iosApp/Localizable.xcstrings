    "forYou.emptyBody" : {
      "comment" : "Roku For You screen: hint under the empty title explaining how recommendations are built.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد بعض العناوين أو قيّمها لبناء توصياتك المخصصة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhlédněte nebo ohodnoťte několik titulů a vytvoříme vám osobní doporučení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eller bedøm nogle få titler for at opbygge dine personlige anbefalinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir ein paar Titel an oder bewerte sie, damit persönliche Empfehlungen entstehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch or rate a few titles to build your personalised recommendations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira o califica algunos títulos para crear tus recomendaciones personalizadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katso tai arvioi muutama nimike, niin saat henkilökohtaisia suosituksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez ou notez quelques titres pour créer vos recommandations personnalisées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogledajte ili ocijenite nekoliko naslova kako biste dobili osobne preporuke."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda o valuta alcuni titoli per creare i tuoi consigli personalizzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつかの作品を視聴または評価すると、あなたへのおすすめが作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 개의 작품을 시청하거나 평가하면 맞춤 추천이 만들어져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eller vurder noen titler for å bygge opp dine personlige anbefalinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk of beoordeel een paar titels voor persoonlijke aanbevelingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obejrzyj lub oceń kilka tytułów, aby otrzymać spersonalizowane rekomendacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assista ou avalie alguns títulos para criar suas recomendações personalizadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посмотрите или оцените несколько фильмов и сериалов, чтобы получить персональные рекомендации."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titta på eller betygsätt några titlar för att bygga upp dina personliga rekommendationer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Size özel önerilerin oluşması için birkaç içerik izleyin veya puanlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перегляньте або оцініть кілька фільмів чи серіалів, щоб отримати персональні рекомендації."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "观看或评分几部作品，即可生成你的个性化推荐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
