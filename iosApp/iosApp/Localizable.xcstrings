          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 중인 항목을 바꿀까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstatte det som spilles av?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat er nu speelt vervangen?"
          }
        },
        "pl" : {
