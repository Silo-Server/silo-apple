    "calendar.empty.followingBody" : {
      "comment" : "Calendar screen: empty-state hint for the Following filter; lists what counts as followed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا إصدارات قادمة هذا الأسبوع من المسلسلات التي تشاهدها أو تفضّلها أو أضفتها إلى قائمة المشاهدة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма предстоящи премиери тази седмица от сериали, които гледате, сте добавили в любими или в списъка за гледане."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta setmana no hi ha estrenes de sèries que mires, que tens com a preferides o a la llista per veure."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento týden nevychází nic nového ze seriálů, které sledujete, máte v oblíbených nebo v seznamu ke zhlédnutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen kommende udgivelser i denne uge fra serier, du ser, har som favorit eller har på din huskeliste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Woche erscheint nichts von Serien, die du schaust, favorisiert oder auf deiner Merkliste hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν επερχόμενες κυκλοφορίες αυτή την εβδομάδα από σειρές που παρακολουθείτε, έχετε στα αγαπημένα ή στη λίστα παρακολούθησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No upcoming releases this week from shows you watch, favorite, or watchlist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay estrenos esta semana de las series que ves, marcas como favoritas o tienes en tu lista para ver."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sel nädalal ei ilmu midagi uut sarjadest, mida vaatate, olete lemmikuks märkinud või vaatamisloendisse lisanud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei tulevia julkaisuja tällä viikolla sarjoista, joita katsot, jotka ovat suosikkejasi tai jotka ovat katselulistallasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune sortie prévue cette semaine pour les séries que vous regardez, mettez en favori ou ajoutez à votre liste à voir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין השבוע יציאות קרובות מסדרות שצפית בהן, שסימנת כמועדפות או שהוספת לרשימת הצפייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी देखी जा रही, पसंदीदा या वॉचलिस्ट वाली सीरीज़ से इस हफ़्ते कोई आने वाली रिलीज़ नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj tjedan nema nadolazećih izdanja serija koje gledate, imate u favoritima ili na popisu za gledanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen a héten nincs közelgő megjelenés azokból a sorozatokból, amelyeket néz, kedvencnek jelölt vagy a figyelőlistájára tett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada rilis mendatang minggu ini dari serial yang Anda tonton, favoritkan, atau tambahkan ke daftar tonton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna uscita in arrivo questa settimana dalle serie che guardi, che hai tra i preferiti o in Da guardare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴中、お気に入り、ウォッチリストのシリーズに今週の新着予定はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시청 중이거나 즐겨찾기 또는 보고 싶은 목록에 추가한 시리즈 중 이번 주 공개 예정인 콘텐츠가 없어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šią savaitę nėra artėjančių išleidimų iš serialų, kuriuos žiūrite, pažymėjote kaip mėgstamus arba įtraukėte į žiūrėjimo sąrašą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šonedēļ nav gaidāmu izlaidumu no seriāliem, kurus skatāties vai kuri ir jūsu izlasē vai skatīšanās sarakstā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada keluaran akan datang minggu ini daripada siri yang anda tonton, gemari atau tambah ke senarai tontonan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen kommende utgivelser denne uken fra serier du ser på, har som favoritt eller har på huskelisten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze week geen nieuwe releases van series die je kijkt, als favoriet hebt of op je kijklijst hebt staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak nadchodzących premier w tym tygodniu z seriali oglądanych, ulubionych lub dodanych do listy do obejrzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum lançamento nesta semana das séries que você assiste, marcou como favoritas ou adicionou à lista para assistir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem estreias previstas esta semana das séries que vê, marca como favoritas ou adiciona à sua lista para ver."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu există lansări viitoare săptămâna aceasta din serialele pe care le vizionați, le aveți la favorite sau în lista de vizionare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этой неделе нет новинок из сериалов, которые вы смотрите, добавили в избранное или в список просмотра."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento týždeň nevychádza nič nové zo seriálov, ktoré pozeráte, máte v obľúbených alebo v zozname na pozretie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
