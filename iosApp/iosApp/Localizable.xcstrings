        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para itens individuais, as predefinições de taxa de bits são preparadas no servidor quando o original é maior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于单个项目，当原始文件较大时，服务器会准备码率预设版本。"
          }
        }
      }
    },
