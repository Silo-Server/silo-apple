    "settingsManifest.nav.shortcuts.description" : {
      "comment" : "Help text under the nav.shortcuts setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المكتبات والأقسام والمجموعات المثبّتة للاستخدام في واجهات التنقل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knihovny, sekce a kolekce připnuté pro použití napříč navigací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteker, sektioner og samlinger, der er fastgjort til brug på tværs af navigationen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediatheken, Bereiche und Sammlungen, die für die gesamte Navigation angeheftet sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libraries, sections, and collections pinned for use across navigation surfaces."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliotecas, secciones y colecciones fijadas para usarlas en toda la navegación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjastot, osiot ja kokoelmat, jotka on kiinnitetty käytettäviksi kaikissa navigointinäkymissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliothèques, sections et collections épinglées pour être utilisées dans toute la navigation."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medijateke, odjeljci i kolekcije prikvačeni za upotrebu na svim navigacijskim površinama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Librerie, sezioni e raccolte fissate per l’uso nelle varie aree di navigazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナビゲーション全体で使えるようにピン留めしたライブラリ、セクション、コレクションです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 탐색 화면에서 사용할 수 있도록 고정한 라이브러리, 섹션, 컬렉션이에요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteker, seksjoner og samlinger som er festet for bruk i hele navigasjonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliotheken, secties en collecties die vastgezet zijn voor gebruik in de navigatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteki, sekcje i kolekcje przypięte do użytku w różnych miejscach nawigacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliotecas, seções e coleções fixadas para uso nas áreas de navegação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медиатеки, разделы и коллекции, закреплённые для быстрого доступа во всех элементах навигации."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliotek, sektioner och samlingar som är fästa för användning i hela navigeringen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezinme alanlarında kullanılmak üzere sabitlenen kitaplıklar, kısımlar ve koleksiyonlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бібліотеки, розділи й колекції, закріплені для використання в усіх елементах навігації."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定在各导航区域中使用的媒体库、版块和合集。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "釘選的媒體庫、區塊和合輯，可在各個導覽位置使用。"
          }
        }
      }
    },
