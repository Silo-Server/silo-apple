    "player.notice.serverRestarting" : {
      "comment" : "Apple iOS/tvOS/macOS: default video player notice text under Server restarting.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد ينتهي التشغيل قريبًا أثناء إعادة تشغيل الخادم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Възпроизвеждането може скоро да спре, докато сървърът се рестартира."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "És possible que la reproducció s’aturi aviat mentre el servidor es reinicia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během restartu serveru může přehrávání brzy skončit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspilningen stopper muligvis snart, mens serveren genstarter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiedergabe kann in Kürze enden, da der Server neu startet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναπαραγωγή μπορεί να διακοπεί σύντομα κατά την επανεκκίνηση του διακομιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback may end shortly while the server restarts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reproducción puede terminar en breve mientras se reinicia el servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esitus võib serveri taaskäivitumise tõttu peagi lõppeda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toisto voi päättyä pian, kun palvelin käynnistyy uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lecture peut s’interrompre sous peu pendant le redémarrage du serveur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייתכן שההפעלה תסתיים בקרוב בזמן שהשרת מופעל מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर के रीस्टार्ट होने के दौरान प्लेबैक जल्द ही बंद हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodukcija bi se uskoro mogla prekinuti dok se poslužitelj ponovno pokreće."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lejátszás hamarosan leállhat, mert a szerver újraindul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemutaran mungkin segera berhenti selagi server dimulai ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riproduzione potrebbe interrompersi a breve durante il riavvio del server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの再起動に伴い、まもなく再生が終了する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 다시 시작되는 동안 재생이 곧 종료될 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atkūrimas netrukus gali baigtis, nes serveris paleidžiamas iš naujo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atskaņošana drīz var beigties, jo serveris tiek restartēts."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Main balik mungkin berakhir sebentar lagi semasa pelayan dimulakan semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avspillingen kan snart stoppe mens serveren starter på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het afspelen kan binnenkort stoppen terwijl de server opnieuw opstart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarzanie może wkrótce się zakończyć z powodu ponownego uruchamiania serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reprodução pode ser encerrada em breve enquanto o servidor reinicia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reprodução pode terminar em breve enquanto o servidor reinicia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redarea se poate încheia în curând, deoarece serverul repornește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизведение может скоро прерваться из-за перезапуска сервера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počas reštartovania servera sa prehrávanie môže čoskoro skončiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predvajanje se lahko kmalu konča, ker se strežnik znova zaganja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppspelningen kan snart avbrytas medan servern startar om."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเล่นอาจสิ้นสุดในไม่ช้าขณะที่เซิร์ฟเวอร์เริ่มการทำงานใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu yeniden başlatılırken oynatma kısa süre içinde sona erebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відтворення може незабаром завершитися через перезапуск сервера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video có thể sớm dừng phát trong khi máy chủ khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器正在重启，播放可能很快结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器重新啟動期間，播放可能很快就會結束。"
          }
        }
      }
    },
