          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Želite li koristiti postavke svojeg profila na ovom uređaju?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usare le impostazioni del tuo profilo su questo dispositivo?"
