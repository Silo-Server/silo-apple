            "state" : "translated",
            "value" : "Qualität der Quelle, bei Bedarf mit kompatibler Alternative"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Source quality, with compatibility fallback if needed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calidad de origen, con alternativa compatible si es necesario"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähteen laatu, tarvittaessa yhteensopiva vaihtoehto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualité de la source, avec repli pour la compatibilité si nécessaire"
