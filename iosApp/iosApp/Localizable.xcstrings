    "error.field.invalid_entity_tag" : {
      "comment" : "Error shown next to or about one request field when the server reports the field-error code `invalid_entity_tag`, for an If-Match or If-None-Match header that is not \"*\" or a list of quoted entity-tags. Clients show it instead of the server's English detail in a translated interface. \"*\" is the literal asterisk character.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن تكون القيمة «*» أو قائمة من وسوم الكيانات بين علامات اقتباس ومفصولة بفواصل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очаква се „*“ или списък от entity-tag стойности в кавички, разделени със запетаи."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’esperava «*» o una llista d’etiquetes d’entitat entre cometes i separades per comes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Očekává se „*“ nebo čárkami oddělený seznam entity-tagů v uvozovkách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forventede ”*” eller en kommasepareret liste over entity-tags i anførselstegn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erwartet wird „*“ oder eine kommagetrennte Liste von Entity-Tags in Anführungszeichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναμενόταν «*» ή λίστα με entity-tag σε εισαγωγικά, χωρισμένα με κόμματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expected \"*\" or a comma-separated list of quoted entity-tags."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esperaba “*” o una lista de etiquetas de entidad entre comillas separadas por comas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oodati väärtust „*“ või komadega eraldatud loendit jutumärkidesse pandud olemisiltidest (entity-tag)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odotettiin arvoa ”*” tai pilkuin eroteltua luetteloa lainausmerkeissä olevista entiteettitunnisteista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeur attendue : \"*\" ou une liste de balises d’entité (ETag) entre guillemets, séparées par des virgules."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צפוי ”*” או רשימה של entity-tags במירכאות, מופרדים בפסיקים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“*” या उद्धरण चिह्नों में लिखे एंटिटी टैग की कॉमा से अलग की गई सूची अपेक्षित है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Očekuje se „*“ ili zarezima odvojen popis entity-tagova u navodnicima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„*” vagy idézőjelek közé tett entitáscímkék vesszővel elválasztott listája szükséges."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harus berupa “*” atau daftar entity-tag dalam tanda kutip yang dipisahkan koma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previsto “*” o un elenco di entity-tag tra virgolette, separati da virgole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「*」、または引用符で囲んだエンティティタグのカンマ区切りリストを指定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"*\" 또는 따옴표로 묶은 엔티티 태그를 쉼표로 구분한 목록이어야 해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tikėtasi „*“ arba kableliais atskirto objekto žymų (entity-tag) kabutėse sąrašo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
