        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sluttet å svare under fullføringen av påloggingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ reageerde niet meer tijdens het voltooien van de aanmelding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telewizor %1$@ przestał odpowiadać podczas kończenia logowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ parou de responder ao concluir o login."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
