          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner innstillingene som er endret på denne Apple TV-en, slik at den bruker profilens innstillinger igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert de instellingen die op deze Apple TV zijn gewijzigd, zodat je profielinstellingen weer worden gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa ustawienia zmienione na tym urządzeniu Apple TV, aby znów używało ustawień twojego profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove as configurações alteradas nesta Apple TV para que ela volte a usar as configurações do seu perfil."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
