    "pairing.summary.limitReached" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: result line when the TV has no room for another account. {server}: the server's name, followed by \" — \" and the account name when there is one (for example Home — sam).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
