    "watchParty.invite.body" : {
      "comment" : "Roku, Android phone and TV: explanation on the invite dialog saying who can use the code. Apple (iPhone, iPad, Apple TV): same line on the invitation page.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لأي شخص لديه ملف شخصي على خادم Silo هذا إدخاله من Watch Party."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всеки с профил на този сървър Silo може да въведе кода от Watch Party."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsevol persona amb un perfil en aquest servidor de Silo el pot introduir des de Watch Party."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdokoli s profilem na tomto serveru Silo ho může zadat ve Watch Party."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle med en profil på denne Silo-server kan indtaste den fra Watch Party."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle mit einem Profil auf diesem Silo-Server können ihn in Watch Party eingeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος έχει προφίλ σε αυτόν τον διακομιστή Silo μπορεί να εισαγάγει τον κωδικό στο Watch Party."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone with a profile on this Silo server can enter it from Watch Party."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier persona con un perfil en este servidor de Silo puede escribirlo en Watch Party."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik, kellel on selles Silo serveris profiil, saavad selle Watch Party vaates sisestada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuka tahansa, jolla on profiili tällä Silo-palvelimella, voi syöttää sen Watch Partyssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne ayant un profil sur ce serveur Silo peut le saisir depuis Watch Party."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל מי שיש לו פרופיל בשרת Silo הזה יכול להזין את הקוד ב-Watch Party."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Silo सर्वर पर प्रोफ़ाइल वाला कोई भी व्यक्ति इसे Watch Party में दर्ज कर सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svatko s profilom na ovom Silo poslužitelju može ga unijeti u odjeljku Watch Party."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bárki, akinek profilja van ezen a Silo szerveren, megadhatja a Watch Party képernyőn."
          }
        },
        "id" : {
          "stringUnit" : {
