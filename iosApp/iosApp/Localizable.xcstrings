    "tvPair.approval.needsSignInDetail" : {
      "comment" : "Apple (iPhone, iPad) Sign in a TV approval card: detail under \"Sign in to {server} again\". {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهى تسجيل الدخول لهذا الجهاز إلى %1$@. سجّل الدخول إليه مرة أخرى، ثم وافق على التلفزيون."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platnost přihlášení tohoto zařízení k serveru %1$@ skončila. Znovu se k němu přihlaste a pak televizi schvalte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enheds login på %1$@ er udløbet. Log ind igen, og godkend derefter tv’et."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung dieses Geräts bei %1$@ ist abgelaufen. Melde dich erneut an und genehmige dann den Fernseher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device's sign-in for %1$@ has ended. Sign in to it again, then approve the TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión de este dispositivo en %1$@ terminó. Vuelve a iniciar sesión y luego aprueba la TV."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän laitteen kirjautuminen palvelimelle %1$@ on päättynyt. Kirjaudu uudelleen ja hyväksy sitten tv."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion de cet appareil à %1$@ a pris fin. Reconnectez-vous, puis approuvez la TV."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijava ovog uređaja na poslužitelj %1$@ je istekla. Ponovno se prijavite, a zatim odobrite TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione di questo dispositivo sul server %1$@ è terminata. Accedi di nuovo, poi approva la TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの%1$@へのサインインが終了しました。もう一度サインインしてから、テレビを承認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 %1$@ 서버 로그인이 만료됐어요. 다시 로그인한 다음 TV를 승인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhetens pålogging for %1$@ er avsluttet. Logg på igjen, og godkjenn deretter TV-en."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De inlogsessie van dit apparaat bij %1$@ is beëindigd. Log opnieuw in en keur daarna de tv goed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logowanie tego urządzenia na serwerze %1$@ wygasło. Zaloguj się ponownie, a potem zatwierdź telewizor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login deste dispositivo em %1$@ terminou. Entre novamente e depois aprove a TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс этого устройства на сервере %1$@ завершён. Войдите снова, затем подтвердите вход на телевизоре."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enhetens inloggning på %1$@ har upphört. Logga in igen och godkänn sedan tv:n."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazın %1$@ sunucusundaki oturumu sona erdi. Sunucuda tekrar oturum açın, ardından TV’yi onaylayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс входу цього пристрою в %1$@ завершився. Увійдіть знову, а потім схваліть телевізор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备在%1$@上的登录已结束。请重新登录，然后批准电视。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置在 %1$@ 的登入已結束。請重新登入，然後核准電視。"
          }
        }
      }
    },
