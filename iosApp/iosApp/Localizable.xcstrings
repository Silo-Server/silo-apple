        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke skifte kvalitet lige nu. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Qualität konnte gerade nicht geändert werden. Versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η αλλαγή ποιότητας αυτήν τη στιγμή. Δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
