    "player.error.audioTrackSetupFailed" : {
      "comment" : "Apple iOS/tvOS/macOS: video player error screen when the video could not start with the audio track the viewer picked.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إعداد التشغيل بالمسار الصوتي المحدد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrávání s vybranou zvukovou stopou se nepodařilo nastavit."
