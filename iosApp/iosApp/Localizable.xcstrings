    "settings.appLanguage.unshippedFooter" : {
      "comment" : "Apple Settings > General: explanation under the App Language picker when the profile chose a language this app version doesn't include. {language}: that language's own name, such as Italiano.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo غير متوفر باللغة %1$@ بعد، لذا يستخدم لغة الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложението Silo все още не е налично на езика %1$@, затова използва езика на устройството."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo encara no està disponible en %1$@, així que utilitza l’idioma del dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo zatím není k dispozici v jazyce %1$@, proto používá jazyk zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo findes ikke på %1$@ endnu, så appen bruger enhedens sprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ist noch nicht auf %1$@ verfügbar, daher wird die Gerätesprache verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Silo δεν είναι ακόμα διαθέσιμο στη γλώσσα %1$@, οπότε χρησιμοποιεί τη γλώσσα της συσκευής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo isn’t available in %1$@ yet, so it uses the device language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo aún no está disponible en %1$@, así que usa el idioma del dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo pole veel saadaval keeles %1$@, seega kasutatakse seadme keelt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei ole vielä saatavilla kielellä %1$@, joten se käyttää laitteen kieltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’est pas encore disponible en %1$@, il utilise donc la langue de l’appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה Silo עדיין לא זמינה בשפה %1$@, ולכן היא משתמשת בשפת המכשיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo अभी %1$@ में उपलब्ध नहीं है, इसलिए यह डिवाइस की भाषा इस्तेमाल करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo još nije dostupan na jeziku %1$@, pa koristi jezik uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo még nem érhető el ezen a nyelven: %1$@, ezért az eszköz nyelvét használja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo belum tersedia dalam bahasa %1$@, jadi Silo menggunakan bahasa perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo non è ancora disponibile in %1$@, quindi usa la lingua del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloはまだ%1$@に対応していないため、デバイスの言語を使用しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 Silo에서 %1$@ 언어를 지원하지 않아 기기 언어를 사용해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalba %1$@ „Silo“ dar nepasiekiama, todėl naudojama įrenginio kalba."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo lietotne vēl nav pieejama valodā %1$@, tāpēc tiek izmantota ierīces valoda."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo belum tersedia dalam bahasa %1$@, jadi bahasa peranti digunakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo er ikke tilgjengelig på %1$@ ennå, så enhetens språk brukes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo is nog niet beschikbaar in %1$@, dus de apparaattaal wordt gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Silo nie jest jeszcze dostępna w języku %1$@, więc używa języka urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo ainda não está disponível em %1$@, então usa o idioma do dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo ainda não está disponível em %1$@, por isso usa o idioma do dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația Silo nu este încă disponibilă în limba %1$@, așa că folosește limba dispozitivului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo пока не поддерживает язык %1$@, поэтому используется язык устройства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikácia Silo zatiaľ nie je dostupná v jazyku %1$@, preto používa jazyk zariadenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija Silo še ni na voljo v jeziku %1$@, zato uporablja jezik naprave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo finns inte på %1$@ än, så enhetens språk används."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ยังไม่มีภาษา %1$@ จึงใช้ภาษาของอุปกรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo henüz şu dilde kullanılamıyor: %1$@. Bu nedenle cihaz dili kullanılıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ще не доступний мовою %1$@, тому використовується мова пристрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo chưa hỗ trợ %1$@, nên đang dùng ngôn ngữ của thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo尚未提供%1$@版本，因此使用设备语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo 尚未提供 %1$@ 版本，因此會使用裝置語言。"
          }
        }
      }
    },
    "settings.blurb.diagnostics" : {
      "comment" : "One-line summary under the Diagnostics pane's heading in Settings, describing what the pane holds. Shown on Android TV and Apple TV.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
