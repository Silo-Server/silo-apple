          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的工作階段已過期。請重新登入以繼續。"
          }
        }
      }
    },
    "shell.error.temporaryPassword" : {
      "comment" : "Apple (iPhone, iPad, Mac): error message when the server refuses a request because the account still has a temporary password set by an admin. Android phone and TV: the same error on any screen whose request the server refused for that reason.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عيّن أحد المسؤولين كلمة مرور مؤقتة لهذا الحساب. سجّل الخروج، ثم سجّل الدخول مرة أخرى لاختيار كلمة مرورك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За този акаунт е зададена временна парола от администратор. Излезте и влезте отново, за да изберете своя парола."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un administrador ha definit una contrasenya temporal per a aquest compte. Tanca la sessió i torna a iniciar la sessió per triar-ne una de pròpia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Správce nastavil pro tento účet dočasné heslo. Odhlaste se a znovu se přihlaste. Pak si zvolíte vlastní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En administrator har angivet en midlertidig adgangskode til denne konto. Log ud, og log derefter ind igen for at vælge din egen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Admin hat für dieses Konto ein temporäres Passwort festgelegt. Melde dich ab und dann erneut an, um ein eigenes zu wählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για αυτόν τον λογαριασμό έχει οριστεί προσωρινός κωδικός πρόσβασης από διαχειριστή. Αποσυνδεθείτε και, στη συνέχεια, συνδεθείτε ξανά για να επιλέξετε τον δικό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An admin set a temporary password for this account. Sign out, then sign in again to choose your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un administrador estableció una contraseña temporal para esta cuenta. Cierra sesión y vuelve a iniciar sesión para elegir la tuya."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administraator määras sellele kontole ajutise parooli. Logige välja ja seejärel uuesti sisse, et valida oma parool."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ylläpitäjä asetti tälle tilille väliaikaisen salasanan. Kirjaudu ulos ja kirjaudu sitten uudelleen sisään valitaksesi oman salasanan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mot de passe temporaire a été défini par l’administration pour ce compte. Déconnectez-vous, puis reconnectez-vous pour choisir le vôtre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מנהל הגדיר סיסמה זמנית לחשבון הזה. יש להתנתק ולהתחבר שוב כדי לבחור סיסמה משלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक एडमिन ने इस खाते के लिए अस्थायी पासवर्ड सेट किया है। साइन आउट करें, फिर अपना पासवर्ड चुनने के लिए दोबारा साइन इन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
