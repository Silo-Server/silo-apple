    "diagnostics.prompt.crashedHosted" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad, Apple TV), shown after a problem report is captured: message when one report is waiting. Reports go to Silo Diagnostics, the Silo project's hosted service; Silo Diagnostics is a product name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعطّل Silo مؤخرًا. يمكن أن يساعد إرسال تقرير تشخيص فريق Silo Diagnostics على فهم ما حدث."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo се срина наскоро. Изпращането на диагностичен отчет може да помогне на екипа на Silo Diagnostics да разбере какво се е случило."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ha fallat recentment. Enviar un informe de diagnòstic pot ajudar l’equip de Silo Diagnostics a entendre què ha passat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Silo nedávno spadla. Odesláním diagnostické zprávy můžete týmu Silo Diagnostics pomoci zjistit, co se stalo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo gik ned for nylig. Hvis du sender en diagnosticeringsrapport, kan det hjælpe Silo Diagnostics-teamet med at forstå, hvad der skete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ist kürzlich abgestürzt. Ein Diagnosebericht kann dem Silo Diagnostics-Team helfen zu verstehen, was passiert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Silo παρουσίασε πρόσφατα κατάρρευση. Η αποστολή μιας αναφοράς διαγνωστικών μπορεί να βοηθήσει την ομάδα του Silo Diagnostics να καταλάβει τι συνέβη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo crashed recently. Sending a diagnostics report can help the Silo Diagnostics team understand what happened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo falló recientemente. Enviar un informe de diagnóstico puede ayudar al equipo de Silo Diagnostics a entender qué pasó."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo jooksis hiljuti kokku. Diagnostikaaruande saatmine aitab Silo Diagnosticsi meeskonnal juhtunut mõista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kaatui äskettäin. Diagnostiikkaraportin lähettäminen voi auttaa Silo Diagnostics -tiimiä selvittämään, mitä tapahtui."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo a planté récemment. L’envoi d’un rapport de diagnostic peut aider l’équipe Silo Diagnostics à comprendre ce qui s’est passé."
          }
        },
        "he" : {
          "stringUnit" : {
