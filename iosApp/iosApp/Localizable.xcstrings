          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg på telefonen eller nettbrettet hvilke servere denne Apple TV-en skal logges på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies op je telefoon of tablet bij welke servers deze Apple TV moet inloggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na telefonie lub tablecie wybierz serwery, do których to urządzenie Apple TV ma się zalogować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
