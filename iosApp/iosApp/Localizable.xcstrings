          }
        }
      }
    },
    "tvPairing.consentNoteSignin" : {
      "comment" : "Android TV warning on the sign-in request: allow only if the user started the sign-in on their own device. Apple TV: same warning on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تسمح بذلك إلا إذا بدأت هذه العملية على هاتفك أو جهازك اللوحي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte to, jen pokud jste to spustili ve svém vlastním telefonu nebo tabletu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad det kun, hvis du har startet dette på din egen telefon eller tablet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass es nur zu, wenn du das auf deinem eigenen Smartphone oder Tablet gestartet hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only allow it if you started this on your own phone or tablet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permítelo solo si lo iniciaste en tu propio teléfono o tableta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli vain, jos aloitit tämän omalla puhelimellasi tai tabletillasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’autorisez cette opération que si vous l’avez lancée sur votre propre téléphone ou tablette."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
