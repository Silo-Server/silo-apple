    "settings.general.showAdvisoryAgeFooter" : {
      "comment" : "Apple Settings > General (iPhone, iPad, Mac): explanation under the Show Advisory Age switch. Common Sense Media is an organization's name; keep it as is.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض الحد الأدنى المقترح لعمر المشاهد، مثل تصنيف Common Sense Media، في تفاصيل الأفلام والمسلسلات. لا يغيّر هذا ما يُسمح للملف الشخصي بمشاهدته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt bei Film- und Seriendetails ein empfohlenes Mindestalter an, etwa von Common Sense Media. Das ändert nicht, was im Profil geschaut werden darf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a suggested minimum viewer age, such as Common Sense Media’s, on movie and show details. This does not change what the profile may watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una edad mínima recomendada, como la de Common Sense Media, en los detalles de películas y series. Esto no cambia lo que el perfil puede ver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche un âge minimum conseillé, comme celui de Common Sense Media, sur les fiches des films et des séries. Cela ne modifie pas ce que le profil peut regarder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Common Sense Mediaなどによる推奨視聴年齢を、映画やシリーズの詳細に表示します。プロフィールで視聴できる内容は変わりません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra uma idade mínima sugerida, como a da Common Sense Media, nos detalhes de filmes e séries. Isso não muda o que o perfil pode assistir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在电影和剧集详情中显示建议的最低观看年龄，例如Common Sense Media给出的年龄。这不会改变此个人资料可观看的内容。"
          }
        }
      }
    },
