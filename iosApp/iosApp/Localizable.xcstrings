    "person.bioLess" : {
      "comment" : "Apple iOS: button under an expanded biography on a person (actor or crew) page; shortens it again.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقل"
          }
        },
