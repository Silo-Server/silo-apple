    "settingsManifest.requests.watchlist_auto_request.description" : {
      "comment" : "Help text under the requests.watchlist_auto_request setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند إضافة عنوان غير موجود في المكتبة إلى قائمة المشاهدة، يتم طلبه أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Titel, der nicht in der Mediathek ist, zu deiner Merkliste hinzufügst, wird er auch angefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you add a title that is not in the library to your watchlist, also request it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando añadas a tu lista para ver un título que no está en la biblioteca, también se solicitará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous ajoutez à votre liste à voir un titre absent de la bibliothèque, le demander également."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリにないタイトルをウォッチリストに追加したとき、そのタイトルをリクエストもします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você adiciona à sua lista para assistir um título que não está na biblioteca, ele também é solicitado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将媒体库中没有的影片添加到待看清单时，同时请求该影片。"
          }
        }
      }
    },
    "settingsManifest.requests.watchlist_auto_request.label" : {
      "comment" : "Label of the requests.watchlist_auto_request setting in settings screens. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلب العناوين التي أضيفها إلى قائمة المشاهدة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titel anfragen, die ich zur Merkliste hinzufüge"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Request titles I add to my watchlist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitar los títulos que añada a mi lista para ver"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demander les titres ajoutés à ma liste à voir"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォッチリストに追加したタイトルをリクエスト"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitar títulos que adiciono à minha lista para assistir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
