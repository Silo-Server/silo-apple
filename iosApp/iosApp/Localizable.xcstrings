    "home.recipe.esStudio.description" : {
      "comment" : "One-line description of the Studio Spotlight preset in the Add row gallery (shared key `home.recipe.esStudio.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسليط الضوء أسبوعيًا على استوديو في مكتبتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Седмичен акцент върху студио от вашата библиотека."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada setmana destaquem un estudi de la teva biblioteca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý týden představí studio z vaší knihovny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugentligt fokus på et studie i dit bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Woche steht ein Studio aus deiner Mediathek im Fokus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε εβδομάδα στο επίκεντρο ένα στούντιο της βιβλιοθήκης σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weekly spotlight on a studio in your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada semana destaca un estudio de tu biblioteca."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga nädal üks stuudio teie meediakogust fookuses."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joka viikko esittelyssä studio kirjastostasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque semaine, un studio de votre bibliothèque à l’honneur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זרקור שבועי על אולפן מהספרייה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर हफ़्ते आपकी लाइब्रेरी के किसी स्टूडियो पर खास नज़र।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki tjedan u fokusu je studio iz vaše medijateke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetente egy stúdió a könyvtárából reflektorfényben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
