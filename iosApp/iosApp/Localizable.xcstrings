    "pairing.error.alreadyDecided" : {
      "comment" : "Phone and tablet: nearby-TV setup card, when the TV's request was already answered. 1: the TV's name. Apple (iPhone, iPad): same error on the nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت الموافقة على طلب تسجيل الدخول هذا أو رفضه من قبل. ابدأ من جديد على %1$@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази заявка за вход вече е одобрена или отхвърлена. Започнете отначало на телевизора %1$@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta sol·licitud d’inici de sessió ja s’ha aprovat o rebutjat. Torna a començar al televisor %1$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato žádost o přihlášení už byla schválena nebo zamítnuta. Začněte znovu na televizi %1$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne loginanmodning er allerede godkendt eller afvist. Start forfra på %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anmeldeanfrage wurde bereits genehmigt oder abgelehnt. Beginne auf %1$@ erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αίτημα σύνδεσης έχει ήδη εγκριθεί ή απορριφθεί. Ξεκινήστε ξανά στην τηλεόραση %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sign-in request was already approved or declined. Start again on %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud de inicio de sesión ya se aprobó o se rechazó. Vuelve a empezar en %1$@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See sisselogimise taotlus on juba kinnitatud või tagasi lükatud. Alustage uuesti teleris %1$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä kirjautumispyyntö on jo hyväksytty tai hylätty. Aloita uudelleen tv:ssä %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette demande de connexion a déjà été approuvée ou refusée. Recommencez sur %1$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בקשת ההתחברות הזו כבר אושרה או נדחתה. יש להתחיל מחדש בטלוויזיה %1$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन इन का यह अनुरोध पहले ही स्वीकार या अस्वीकार किया जा चुका है। %1$@ पर फिर से शुरू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj zahtjev za prijavu već je odobren ili odbijen. Počnite ponovno na uređaju %1$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt a bejelentkezési kérést már jóváhagyták vagy elutasították. Kezdje újra a(z) %1$@ TV-n."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan masuk ini sudah disetujui atau ditolak. Mulai lagi di %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa richiesta di accesso è già stata approvata o rifiutata. Ricomincia su %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサインインのリクエストはすでに承認または拒否されています。%1$@でもう一度やり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 승인 또는 거절된 로그인 요청이에요. %1$@에서 다시 시작하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ši prisijungimo užklausa jau patvirtinta arba atmesta. Pradėkite iš naujo televizoriuje „%1$@“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis pierakstīšanās pieprasījums jau ir apstiprināts vai noraidīts. Sāciet vēlreiz televizorā „%1$@”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan log masuk ini sudah diluluskan atau ditolak. Mulakan semula di %1$@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne påloggingsforespørselen er allerede godkjent eller avvist. Start på nytt på %1$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit inlogverzoek is al goedgekeurd of afgewezen. Begin opnieuw op %1$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta prośba o zalogowanie została już zatwierdzona lub odrzucona. Zacznij ponownie na telewizorze %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitação de login já foi aprovada ou recusada. Comece novamente em %1$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este pedido de início de sessão já foi aprovado ou recusado. Comece novamente na TV %1$@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această cerere de conectare a fost deja aprobată sau respinsă. Începeți din nou pe televizorul %1$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот запрос на вход уже одобрен или отклонён. Начните заново на телевизоре «%1$@»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto žiadosť o prihlásenie už bola schválená alebo zamietnutá. Začnite znova v televízore %1$@."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta zahteva za prijavo je bila že odobrena ali zavrnjena. Začnite znova na televizorju %1$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här inloggningsförfrågan har redan godkänts eller avvisats. Börja om på %1$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุมัติหรือปฏิเสธคำขอลงชื่อเข้าใช้นี้ไปแล้ว โปรดเริ่มใหม่ในทีวี %1$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oturum açma isteği zaten onaylandı veya reddedildi. %1$@ cihazında yeniden başlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей запит на вхід уже схвалено або відхилено. Почніть знову на телевізорі %1$@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
