    "tvPairing.failedDenied" : {
      "comment" : "Android TV failure message when the phone's sign-in was declined. {server}: the server name. Apple TV: same message on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم رفض تسجيل الدخول إلى %1$@. حاول مرة أخرى من هاتفك أو جهازك اللوحي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Входът в сървъра %1$@ беше отхвърлен. Опитайте отново от телефона или таблета си."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ha rebutjat l’inici de sessió a %1$@. Torna-ho a provar des del telèfon o la tauleta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlášení k serveru %1$@ bylo zamítnuto. Zkuste to znovu z telefonu nebo tabletu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Login på %1$@ blev afvist. Prøv igen fra din telefon eller tablet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung bei %1$@ wurde abgelehnt. Versuche es erneut über dein Smartphone oder Tablet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σύνδεση στον διακομιστή %1$@ απορρίφθηκε. Δοκιμάστε ξανά από το τηλέφωνο ή το tablet σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in to %1$@ was declined. Try again from your phone or tablet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rechazó el inicio de sesión en %1$@. Vuelve a intentarlo desde tu teléfono o tableta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisselogimine serverisse %1$@ lükati tagasi. Proovige uuesti oma telefonist või tahvelarvutist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjautuminen palvelimelle %1$@ hylättiin. Yritä uudelleen puhelimesta tai tabletista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à %1$@ a été refusée. Réessayez depuis votre téléphone ou votre tablette."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההתחברות לשרת %1$@ נדחתה. אפשר לנסות שוב מהטלפון או מהטאבלט שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर %1$@ में साइन इन अस्वीकार कर दिया गया। अपने फ़ोन या टैबलेट से फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijava na poslužitelj %1$@ odbijena je. Pokušajte ponovno s telefona ili tableta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %1$@ szerverre történő bejelentkezést elutasították. Próbálja újra a telefonjáról vagy táblagépéről."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proses masuk ke %1$@ ditolak. Coba lagi dari ponsel atau tablet Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso a %1$@ è stato rifiutato. Riprova dal telefono o tablet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@へのサインインが拒否されました。スマートフォンまたはタブレットからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 서버 로그인이 거절됐어요. 휴대폰이나 태블릿에서 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisijungimas prie serverio %1$@ atmestas. Bandykite dar kartą iš telefono arba planšetės."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierakstīšanās serverī %1$@ tika noraidīta. Mēģiniet vēlreiz no sava tālruņa vai planšetdatora."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log masuk ke %1$@ telah ditolak. Cuba lagi dari telefon atau tablet anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påloggingen på %1$@ ble avvist. Prøv igjen fra telefonen eller nettbrettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het inloggen bij %1$@ is geweigerd. Probeer het opnieuw vanaf je telefoon of tablet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odrzucono logowanie do serwera %1$@. Spróbuj ponownie z telefonu lub tabletu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login em %1$@ foi recusado. Tente novamente pelo seu celular ou tablet."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O início de sessão no servidor %1$@ foi recusado. Tente novamente a partir do seu telemóvel ou tablet."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectarea la serverul %1$@ a fost refuzată. Încercați din nou de pe telefon sau tabletă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход на сервер %1$@ отклонён. Повторите попытку с телефона или планшета."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prihlásenie na server %1$@ bolo zamietnuté. Skúste to znova z telefónu alebo tabletu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijava v strežnik %1$@ je bila zavrnjena. Poskusite znova s telefona ali tabličnega računalnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggningen på %1$@ avvisades. Försök igen från din telefon eller surfplatta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปฏิเสธการลงชื่อเข้าใช้เซิร์ฟเวอร์ %1$@ แล้ว โปรดลองอีกครั้งจากโทรศัพท์หรือแท็บเล็ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sunucusunda oturum açma reddedildi. Telefonunuzdan veya tabletinizden tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вхід на %1$@ відхилено. Спробуйте ще раз із телефона або планшета."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu đăng nhập vào %1$@ đã bị từ chối. Vui lòng thử lại từ điện thoại hoặc máy tính bảng của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录%1$@的请求已被拒绝。请在你的手机或平板电脑上重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入 %1$@ 的要求已被拒絕。請從你的手機或平板電腦再試一次。"
          }
        }
      }
    },
    "tvPairing.failedExpired" : {
      "comment" : "Android TV failure message when the code expired before approval. {server}: the server name. Apple TV: same message on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية رمز %1$@ قبل الموافقة عليه. حاول مرة أخرى من هاتفك أو جهازك اللوحي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кодът за сървъра %1$@ изтече, преди да бъде одобрен. Опитайте отново от телефона или таблета си."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El codi per a %1$@ ha caducat abans que s’aprovés. Torna-ho a provar des del telèfon o la tauleta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platnost kódu pro server %1$@ vypršela dřív, než byl schválen. Zkuste to znovu z telefonu nebo tabletu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koden til %1$@ udløb, før den blev godkendt. Prøv igen fra din telefon eller tablet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code für %1$@ ist abgelaufen, bevor er bestätigt wurde. Versuche es erneut über dein Smartphone oder Tablet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός για τον διακομιστή %1$@ έληξε πριν εγκριθεί. Δοκιμάστε ξανά από το τηλέφωνο ή το tablet σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code for %1$@ expired before it was approved. Try again from your phone or tablet."
