    "remote.reconnect.tvHint" : {
      "comment" : "Apple iOS: Remote Control remote; hint under \"Reconnecting to …\" for an Apple TV or other Silo TV.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من أن التلفزيون قيد التشغيل ومتصل بالشبكة نفسها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujistěte se, že je televize zapnutá a ve stejné síti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for, at tv’et er tændt og på samme netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle sicher, dass der Fernseher eingeschaltet ist und sich im selben Netzwerk befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the TV is on and on the same network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que la TV esté encendida y en la misma red."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmista, että tv on päällä ja samassa verkossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que la TV est allumée et connectée au même réseau."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjerite je li TV uključen i na istoj mreži."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che la TV sia accesa e sulla stessa rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テレビの電源が入っていて、同じネットワークに接続されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV가 켜져 있고 같은 네트워크에 연결되어 있는지 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroller at TV-en er på og koblet til samme nettverk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg dat de tv aan staat en op hetzelfde netwerk zit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upewnij się, że telewizor jest włączony i w tej samej sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se a TV está ligada e na mesma rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что телевизор включён и подключён к той же сети."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollera att tv:n är på och ansluten till samma nätverk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV’nin açık ve aynı ağda olduğundan emin olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переконайтеся, що телевізор увімкнено і він у тій самій мережі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确保电视已开机，并且连接在同一网络中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請確認電視已開啟，且位於同一個網路。"
          }
        }
      }
    },
