            "state" : "translated",
            "value" : "由主持人决定播放内容。"
          }
        }
      }
    },
    "watchParty.strip.manager" : {
      "comment" : "Caption of the suggestions strip for the host or manager, who can queue a suggestion to play next: Watch Party on Roku, Android phone and TV, beside the lobby's suggestions on Apple iPhone, iPad and Apple TV, and the web Watch Together lobby.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف اقتراحًا إلى قائمة الانتظار ليكون التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reihe einen Vorschlag ein, damit er als Nächstes läuft."
