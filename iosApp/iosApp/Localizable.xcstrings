    "settings.profileLaunch.afterOneHour.detail" : {
      "comment" : "Explanation under the After 1 Hour profile selection choice: in the Roku profile picker, on Android, and in Apple Settings > General profile selection (iPhone, iPad, Mac, Apple TV). Who's Watching is the name of the profile picker screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض «من يشاهد؟» عندما تبتعد عن Silo لمدة ساعة واحدة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Екранът „Кой гледа“ се показва, когато не сте използвали Silo в продължение на 1 час."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la pantalla Qui està mirant quan faci 1 hora que no fas servir Silo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit obrazovku „Kdo se dívá“ po 1 hodině mimo Silo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis ”Hvem ser med?”, når du har været væk fra Silo i 1 time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt „Wer schaut?“ an, wenn du Silo 1 Stunde lang nicht genutzt hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση της οθόνης «Ποιος παρακολουθεί;» όταν δεν έχετε χρησιμοποιήσει το Silo για 1 ώρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show Who's Watching when you've been away from Silo for 1 hour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra “¿Quién está viendo?” cuando hayas estado fuera de Silo durante 1 hora."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuva „Kes vaatab?“ näidatakse, kui olete olnud Silost eemal 1 tund."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä Kuka katsoo -näkymä, kun et ole käyttänyt Siloa 1 tuntiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher « Qui regarde ? » lorsque vous avez quitté Silo depuis 1 heure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת המסך ”מי צופה?” אחרי שעה בלי שימוש ב-Silo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo से 1 घंटे दूर रहने पर “कौन देख रहा है?” दिखाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži „Tko gleda?“ kad niste koristili Silo 1 sat."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megjeleníti a „Ki néz?” képernyőt, ha 1 órája nem használta a Silót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan “Siapa yang menonton” jika Anda tidak membuka Silo selama 1 jam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra “Chi guarda?” quando sei lontano da Silo da 1 ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloから1時間離れると、プロフィール選択画面を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo를 1시간 동안 사용하지 않으면 “누가 보고 있나요?” 화면을 표시해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodyti ekraną „Kas žiūri?“, jei „Silo“ nenaudojote 1 valandą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rādīt ekrānu „Kas skatās?”, ja kopš pēdējās Silo izmantošanas pagājusi 1 stunda."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan Siapa yang menonton apabila anda meninggalkan Silo selama 1 jam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis «Hvem ser på» når du har vært borte fra Silo i 1 time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon “Wie kijkt er?” als je 1 uur niet in Silo bent geweest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj ekran „Kto ogląda”, gdy od ostatniego korzystania z aplikacji Silo minie 1 godzina."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar Quem está assistindo quando você ficar 1 hora fora do Silo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar Quem está a ver? quando tiver estado fora do Silo durante 1 hora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se afișează ecranul „Cine vizionează?” când nu ați mai folosit Silo timp de 1 oră."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать экран «Кто смотрит?», если вы не открывали Silo в течение 1 часа."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť obrazovku Kto pozerá po 1 hodine mimo aplikácie Silo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži zaslon „Kdo gleda“, ko ste bili 1 uro odsotni iz aplikacije Silo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa ”Vem tittar?” när du har varit borta från Silo i 1 timme."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงหน้า “ใครกำลังดู” เมื่อคุณไม่ได้ใช้ Silo เป็นเวลา 1 ชั่วโมง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo’dan 1 saat uzak kaldığınızda “Kim izliyor?” ekranı gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати «Хто дивиться», якщо вас не було в Silo 1 годину."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị “Ai đang xem” khi bạn rời Silo được 1 giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开Silo 1小时后显示“谁在观看”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開 Silo 1 小時後，顯示「誰在觀看」。"
          }
        }
      }
    },
