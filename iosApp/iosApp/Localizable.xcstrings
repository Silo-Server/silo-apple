    "player.seekInterval.refreshFailed" : {
      "comment" : "Apple iOS/tvOS/macOS: skip interval settings (video and audiobook skip back/forward); error when a refresh failed and saved values show.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحديث فواصل التخطي. تُعرض آخر القيم المحفوظة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervaly přeskočení se nepodařilo obnovit. Zobrazují se naposledy uložené hodnoty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke opdatere springintervaller. Viser de senest gemte værdier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprungintervalle konnten nicht aktualisiert werden. Die zuletzt gespeicherten Werte werden angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't refresh skip intervals. Showing the last saved values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron actualizar los intervalos de salto. Se muestran los últimos valores guardados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohitusvälien päivittäminen epäonnistui. Näytetään viimeksi tallennetut arvot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’actualiser les intervalles de saut. Affichage des dernières valeurs enregistrées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće osvježiti intervale preskakanja. Prikazuju se posljednje spremljene vrijednosti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aggiornare gli intervalli di salto. Vengono mostrati gli ultimi valori salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキップ間隔を更新できませんでした。最後に保存された値を表示しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건너뛰기 간격을 새로고침할 수 없어요. 마지막으로 저장된 값을 표시해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke oppdatere hoppintervallene. Viser de sist lagrede verdiene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan spoelintervallen niet vernieuwen. De laatst opgeslagen waarden worden getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odświeżyć interwałów przeskoku. Wyświetlane są ostatnio zapisane wartości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
