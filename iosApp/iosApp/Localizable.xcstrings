    "tvPairing.failedIdentitySigninAppleTv" : {
      "comment" : "Apple TV pairing screen (shown while a nearby phone sets up or signs in this Apple TV): failure body on the sign-in screen when the phone offered a different server. {server}: the offered server's name.",
