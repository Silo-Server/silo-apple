          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil possède d’anciens paramètres d’interface qui lui sont propres et qui prévalent sur la synchronisation entre appareils du même type."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במכשיר הזה יש הגדרות ממשק ישנות ייעודיות למכשיר, שגוברות על הסנכרון בין מכשירים מאותו סוג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस में पुरानी, डिवाइस-विशिष्ट इंटरफ़ेस सेटिंग हैं, जो एक ही तरह के डिवाइसों के बीच होने वाले सिंक को ओवरराइड करती हैं।"
