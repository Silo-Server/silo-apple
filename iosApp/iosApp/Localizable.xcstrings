    "requests.notice.unconfirmedCancel" : {
      "comment" : "Toast on Roku when the app could not confirm a request was cancelled. My Requests is the screen listing the user's requests. Apple (iPhone, iPad, Mac, Apple TV): same message on the request detail page and My Requests.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تأكيد الإلغاء. أعد فتح «طلباتي» للتحقق منه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можахме да потвърдим отмяната. Отворете отново екрана „Моите заявки“, за да проверите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hem pogut confirmar la cancel·lació. Torna a obrir Les meves sol·licituds per comprovar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrušení se nepodařilo potvrdit. Znovu otevřete stránku Moje žádosti a zkontrolujte to."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke bekræfte annulleringen. Åbn Mine anmodninger igen for at tjekke den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten den Abbruch nicht bestätigen. Öffne „Meine Anfragen“ erneut, um es zu prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η επιβεβαίωση της ακύρωσης. Ανοίξτε ξανά τη σελίδα «Τα αιτήματά μου» για να το ελέγξετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't confirm the cancellation. Reopen My Requests to check it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos confirmar la cancelación. Vuelve a abrir Mis solicitudes para comprobarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tühistamist ei õnnestunud kinnitada. Kontrollimiseks avage uuesti leht „Minu taotlused“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peruutusta ei voitu vahvistaa. Tarkista tilanne avaamalla Omat pyynnöt uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer l’annulation. Rouvrez Mes demandes pour vérifier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לוודא את הביטול. יש לפתוח מחדש את הדף ”הבקשות שלי” כדי לבדוק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रद्द होने की पुष्टि नहीं हो सकी। जाँचने के लिए मेरे अनुरोध पेज फिर से खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nismo mogli potvrditi otkazivanje. Ponovno otvorite Moje zahtjeve da biste provjerili."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült megerősíteni a visszavonást. Az ellenőrzéshez nyissa meg újra a Kéréseim oldalt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak dapat mengonfirmasi pembatalan. Buka kembali Permintaan Saya untuk memeriksanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile confermare l’annullamento. Riapri Le mie richieste per verificare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセルを確認できませんでした。マイリクエストを開き直して確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소 여부를 확인할 수 없어요. 내 요청을 다시 열어 확인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko patvirtinti atšaukimo. Iš naujo atidarykite puslapį „Mano užklausos“ ir patikrinkite."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās pārliecināties, ka pieprasījums ir atcelts. Atkārtoti atveriet sadaļu „Mani pieprasījumi”, lai to pārbaudītu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak dapat mengesahkan pembatalan. Buka semula Permintaan saya untuk menyemaknya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke bekrefte avbrytelsen. Åpne Mine forespørsler på nytt for å sjekke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We konden de annulering niet bevestigen. Open Mijn aanvragen opnieuw om het te controleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się potwierdzić anulowania. Otwórz ponownie „Moje prośby”, aby to sprawdzić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar o cancelamento. Abra Minhas solicitações novamente para verificar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar o cancelamento. Volte a abrir Os meus pedidos para verificar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu am putut confirma anularea. Redeschideți pagina Cererile mele pentru a verifica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подтвердить отмену. Откройте «Мои запросы» снова, чтобы проверить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrušenie sa nepodarilo potvrdiť. Skontrolujte ho opätovným otvorením obrazovky Moje žiadosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preklica ni bilo mogoče potrditi. Znova odprite Moje zahteve in preverite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunde inte bekräfta avbrytandet. Öppna Mina förfrågningar igen för att kontrollera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรายืนยันการยกเลิกไม่ได้ โปรดเปิดคำขอของฉันอีกครั้งเพื่อตรวจสอบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İptal işlemi doğrulanamadı. Kontrol etmek için İsteklerim’i yeniden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося підтвердити скасування. Відкрийте «Мої запити» ще раз, щоб перевірити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác nhận việc hủy. Mở lại Yêu cầu của tôi để kiểm tra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们无法确认取消是否成功。请重新打开我的请求查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法確認是否已取消。請重新開啟「我的請求」查看。"
          }
        }
      }
    },
