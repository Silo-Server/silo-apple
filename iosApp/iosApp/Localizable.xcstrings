    "signInTv.profilesNote" : {
      "comment" : "Phone note on the approval screen about privacy: approving gives the device access to your profiles, and PIN-protected profiles stay locked. Apple (iPhone, iPad): same note on the approval card and nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمنحه هذا الوصول إلى ملفاتك الشخصية. تبقى الملفات الشخصية المحمية برمز PIN مقفلة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Така устройството получава достъп до профилите ви. Профилите с PIN остават заключени."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això li dona accés als teus perfils. Els perfils amb PIN continuen bloquejats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařízení tak získá přístup k vašim profilům. Profily s PIN zůstanou zamčené."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det giver den adgang til dine profiler. Profiler med PIN-kode forbliver låst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät erhält dadurch Zugriff auf deine Profile. Profile mit PIN bleiben gesperrt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έτσι αποκτά πρόσβαση στα προφίλ σας. Τα προφίλ με PIN παραμένουν κλειδωμένα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This gives it access to your profiles. Profiles with a PIN stay locked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto le da acceso a tus perfiles. Los perfiles con PIN siguen bloqueados."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See annab seadmele juurdepääsu teie profiilidele. PIN-koodiga profiilid jäävad lukustatuks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laite saa näin pääsyn profiileihisi. PIN-koodilla suojatut profiilit pysyvät lukittuina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela lui donne accès à vos profils. Les profils protégés par un PIN restent verrouillés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האישור נותן למכשיר גישה לפרופילים שלך. פרופילים עם PIN יישארו נעולים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे उसे आपकी प्रोफ़ाइलों का ऐक्सेस मिल जाता है। PIN वाली प्रोफ़ाइलें लॉक रहती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tako uređaj dobiva pristup vašim profilima. Profili s PIN-om ostaju zaključani."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezzel az eszköz hozzáférést kap a profiljaihoz. A PIN-kóddal védett profilok zárolva maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memberinya akses ke profil Anda. Profil dengan PIN tetap terkunci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Così il dispositivo avrà accesso ai tuoi profili. I profili con PIN restano bloccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認すると、このデバイスからプロフィールにアクセスできるようになります。PINが設定されたプロフィールはロックされたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 내 프로필에 접근할 수 있게 돼요. PIN이 설정된 프로필은 잠긴 상태로 유지돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taip jis gaus prieigą prie jūsų profilių. PIN kodu apsaugoti profiliai lieka užrakinti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tādējādi tai tiek piešķirta piekļuve jūsu profiliem. Profili ar PIN paliek bloķēti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memberikan peranti itu akses kepada profil anda. Profil dengan PIN kekal dikunci."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette gir den tilgang til profilene dine. Profiler med PIN forblir låst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het apparaat krijgt zo toegang tot je profielen. Profielen met een PIN blijven vergrendeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzięki temu urządzenie uzyska dostęp do twoich profili. Profile z kodem PIN pozostaną zablokowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso dá a ele acesso aos seus perfis. Perfis com PIN continuam bloqueados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto dá ao dispositivo acesso aos seus perfis. Os perfis com PIN continuam bloqueados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astfel, dispozitivul primește acces la profilurile dvs. Profilurile cu cod PIN rămân blocate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройство получит доступ к вашим профилям. Профили с PIN останутся заблокированными."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zariadenie tak získa prístup k vašim profilom. Profily s PIN kódom zostanú zamknuté."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem ji omogočite dostop do vaših profilov. Profili s PIN-kodo ostanejo zaklenjeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ger enheten åtkomst till dina profiler. Profiler med PIN-kod förblir låsta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การอนุมัตินี้จะทำให้อุปกรณ์เข้าถึงโปรไฟล์ของคุณได้ โปรไฟล์ที่มี PIN จะยังล็อกอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, cihaza profillerinize erişim izni verir. PIN korumalı profiller kilitli kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так пристрій отримає доступ до ваших профілів. Профілі з PIN-кодом залишаться заблокованими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này cho phép thiết bị truy cập các hồ sơ của bạn. Hồ sơ có PIN vẫn được khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会让它访问你的个人资料。设有PIN的个人资料将保持锁定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會讓該裝置存取你的個人檔案。設有 PIN 的個人檔案會保持鎖定。"
          }
        }
      }
    },
