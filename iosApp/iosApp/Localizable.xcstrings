          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobitab ajastuse heliga kõigi jaoks. Faili ennast ei muudeta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovittaa ajoituksen ääneen kaikille. Itse tiedostoa ei muuteta."
