    "settingsManifest.player.audio_sync_ms.description" : {
      "comment" : "Help text under the player.audio_sync_ms setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقديم الصوت أو تأخيره لتصحيح تزامن الشفاه على هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измества звука по-рано или по-късно, за да се коригира синхронът с устните на това устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avança o endarrereix l’àudio per corregir la sincronització labial en aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posune zvuk dříve nebo později a opraví synchronizaci rtů na tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt lyden tidligere eller senere for at rette læbesynkroniseringen på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt den Ton nach vorn oder hinten, um die Lippensynchronität auf diesem Gerät zu korrigieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακίνηση του ήχου νωρίτερα ή αργότερα για διόρθωση του συγχρονισμού χειλιών σε αυτήν τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shift audio earlier or later to correct lip sync on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adelanta o retrasa el audio para corregir la sincronización labial en este dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nihutab heli varasemaks või hilisemaks, et parandada huulte sünkroonsust selles seadmes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä ääntä aiemmaksi tai myöhemmäksi korjataksesi huulisynkronoinnin tällä laitteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avance ou retarde le son pour corriger la synchronisation labiale sur cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקדמה או השהיה של השמע כדי לתקן את סנכרון השפתיים במכשיר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर लिप सिंक ठीक करने के लिए ऑडियो को पहले या बाद में खिसकाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomaknite zvuk ranije ili kasnije kako biste ispravili sinkronizaciju usana na ovom uređaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hang korábbra vagy későbbre tolása a szájmozgással való szinkron javításához ezen az eszközön."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser audio lebih awal atau lebih lambat untuk memperbaiki sinkronisasi bibir di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anticipa o ritarda l’audio per correggere la sincronizzazione labiale su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスで音声を早めたり遅らせたりして、口の動きとのずれを補正します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 입 모양과 소리가 맞도록 오디오를 앞당기거나 늦춰요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paankstinti arba pavėlinti garsą, kad jis atitiktų lūpų judesius šiame įrenginyje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārbīda audio agrāk vai vēlāk, lai labotu lūpu sinhronizāciju šajā ierīcē."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjakkan audio lebih awal atau lewat untuk membetulkan penyegerakan bibir pada peranti ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt lyden tidligere eller senere for å rette leppesynkroniseringen på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschuif de audio naar eerder of later om de lipsynchronisatie op dit apparaat te corrigeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń dźwięk wcześniej lub później, aby skorygować synchronizację ruchu warg na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adianta ou atrasa o áudio para corrigir a sincronização labial neste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiantar ou atrasar o áudio para corrigir a sincronização labial neste dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mută sunetul mai devreme sau mai târziu pentru a corecta sincronizarea buzelor pe acest dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдвинуть звук раньше или позже, чтобы синхронизировать его с движением губ на этом устройстве."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posunie zvuk skôr alebo neskôr, aby sa na tomto zariadení opravila synchronizácia s perami."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premakni zvok prej ali pozneje, da se na tej napravi ujema z gibanjem ustnic."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytta ljudet tidigare eller senare för att korrigera läppsynken på den här enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลื่อนเสียงให้เร็วขึ้นหรือช้าลงเพื่อแก้เสียงไม่ตรงปากในอุปกรณ์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazda dudak eşitlemesini düzeltmek için sesi öne veya geriye kaydırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зсуньте звук раніше або пізніше, щоб синхронізувати його з рухом губ на цьому пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch âm thanh sớm hơn hoặc muộn hơn để khớp khẩu hình trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将音频提前或延后，以校正此设备上的口型同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將音訊提前或延後，以修正這部裝置上的口型同步。"
          }
        }
      }
    },
