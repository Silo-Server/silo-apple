    "tvSignIn.error.localLoginDisabled" : {
      "comment" : "Android TV error when the server has turned off password sign-in. Apple TV: same password sign-in error.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل الدخول بكلمة المرور معطّل على هذا الخادم. استخدم هاتفك بدلًا من ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlášení heslem je na tomto serveru vypnuté. Použijte raději telefon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Login med adgangskode er slået fra på denne server. Brug din telefon i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
