    "shell.error.sessionExpired" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error message under the Session expired heading (HTTP 401).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
