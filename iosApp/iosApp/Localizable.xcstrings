    "settings.general.deviceOverrideFooterTv" : {
      "comment" : "Apple TV Settings > General: explanation under Use Synced TV Settings. TV-family choices are the settings shared by the profile's TVs.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لدى جهاز Apple TV هذا إعدادات قديمة خاصة بالجهاز. امسحها لاستخدام خيارات أجهزة التلفزيون المشتركة في هذا الملف الشخصي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това Apple TV има по-стари настройки само за устройството. Изчистете ги, за да използвате общите за телевизорите настройки на този профил."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest Apple TV té opcions antigues específiques del dispositiu. Esborra-les per utilitzar les opcions de la família TV compartides per aquest perfil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato Apple TV má starší nastavení specifická pro zařízení. Vymažte je a použijte volby pro televize sdílené tímto profilem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette Apple TV har ældre enhedsspecifikke indstillinger. Ryd dem for at bruge de tv-valg, som denne profil deler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Apple TV hat ältere gerätespezifische Einstellungen. Lösche sie, um die Einstellungen zu verwenden, die dieses Profil mit seinen Fernsehern teilt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το Apple TV έχει παλαιότερες ρυθμίσεις ειδικά για τη συσκευή. Εκκαθαρίστε τις για να χρησιμοποιείτε τις επιλογές για τηλεοράσεις που κοινοποιεί αυτό το προφίλ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Apple TV has older device-specific settings. Clear them to use the TV-family choices shared by this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Apple TV tiene configuraciones antiguas propias del dispositivo. Bórralas para usar las opciones de TV compartidas por este perfil."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sellel Apple TV-l on vanemad seadmepõhised seadistused. Tühjendage need, et kasutada selle profiili kõigi telerite ühiseid valikuid."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä Apple TV:ssä on vanhempia laitekohtaisia asetuksia. Tyhjennä ne, niin käytössä ovat tämän profiilin tv-laitteiden yhteiset valinnat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette Apple TV a d’anciens paramètres propres à l’appareil. Effacez-les pour utiliser les choix partagés par les TV de ce profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ב-Apple TV הזה יש הגדרות ישנות שספציפיות למכשיר. יש לנקות אותן כדי להשתמש בבחירות של מכשירי הטלוויזיה שמשותפות לפרופיל הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Apple TV में डिवाइस के लिए खास पुरानी सेटिंग हैं। इस प्रोफ़ाइल के साथ शेयर किए गए टीवी-फ़ैमिली विकल्प इस्तेमाल करने के लिए उन्हें साफ़ करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj Apple TV ima starije postavke za ovaj uređaj. Očistite ih da biste koristili postavke za TV uređaje koje dijeli ovaj profil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen az Apple TV-n régebbi, eszközspecifikus beállítások vannak. Törölje őket, hogy a profil által megosztott TV-családi beállításokat használja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV ini memiliki pengaturan lama khusus perangkat. Hapus pengaturan tersebut untuk menggunakan pilihan keluarga TV yang dibagikan oleh profil ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa Apple TV ha vecchie impostazioni specifiche del dispositivo. Cancellale per usare le scelte per le TV condivise da questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVには古いデバイス固有の設定があります。クリアすると、このプロフィールのテレビ共通の設定を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple TV에 이전 기기별 설정이 있어요. 이 설정을 지우면 이 프로필의 TV 기기들이 공유하는 설정을 사용해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šiame „Apple TV“ įrenginyje yra senesnių, tik šiam įrenginiui skirtų nustatymų. Išvalykite juos, kad būtų naudojami šio profilio televizorių šeimos bendri nustatymai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šai Apple TV ierīcei ir vecāki ierīcei specifiski iestatījumi. Notīriet tos, lai izmantotu šī profila televizoru grupai kopīgās izvēles."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV ini mempunyai tetapan khusus peranti yang lebih lama. Kosongkan tetapan itu untuk menggunakan pilihan keluarga TV yang dikongsi oleh profil ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Apple TV-en har eldre enhetsspesifikke innstillinger. Tøm dem for å bruke TV-valgene som deles av denne profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Apple TV heeft oudere apparaatspecifieke instellingen. Wis ze om de tv-instellingen te gebruiken die dit profiel deelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie Apple TV ma starsze ustawienia specyficzne dla urządzenia. Wyczyść je, aby używać opcji wspólnych dla telewizorów w tym profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta Apple TV tem configurações antigas específicas do dispositivo. Limpe-as para usar as opções da família de TVs compartilhadas por este perfil."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta Apple TV tem definições antigas específicas do dispositivo. Limpe-as para usar as opções da família TV partilhadas por este perfil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest Apple TV are setări mai vechi, specifice dispozitivului. Ștergeți-le pentru a folosi opțiunile pentru televizoare partajate de acest profil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом Apple TV остались старые настройки для отдельного устройства. Очистите их, чтобы использовать общие для телевизоров настройки этого профиля."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zariadenie Apple TV má staršie nastavenia určené len preň. Vymažte ich, ak chcete používať voľby pre televízory zdieľané týmto profilom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta Apple TV ima starejše nastavitve, vezane na napravo. Počistite jih, da boste uporabljali izbire za televizorje, ki si jih deli ta profil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här Apple TV-enheten har äldre enhetsspecifika inställningar. Rensa dem för att använda de tv-inställningar som delas av den här profilen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV เครื่องนี้มีการตั้งค่าเฉพาะอุปกรณ์แบบเก่า ล้างการตั้งค่าเหล่านี้เพื่อใช้ตัวเลือกกลุ่มทีวีที่ใช้ร่วมกันในโปรไฟล์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Apple TV’de cihaza özel eski ayarlar var. Bu profilin TV ailesi cihazlarıyla paylaşılan seçenekleri kullanmak için bunları temizleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На цьому Apple TV є старіші налаштування для окремого пристрою. Очистьте їх, щоб використовувати спільні для ТБ налаштування цього профілю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV này có các cài đặt riêng cho thiết bị từ trước. Xóa các cài đặt đó để dùng lựa chọn mà các TV của hồ sơ này dùng chung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此Apple TV有旧的设备专属设置。清除这些设置即可使用此个人资料在各电视设备间共享的选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Apple TV 有較舊的裝置專屬設定。清除後即可使用此個人檔案在各電視間共用的設定。"
          }
        }
      }
    },
    "settings.general.notPaired" : {
