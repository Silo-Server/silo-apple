          }
        }
      }
    },
    "player.error.replanUnauthenticatedTransport" : {
      "comment" : "Apple iOS/tvOS/macOS: video player error screen when a mid-playback replacement plan dropped authenticated media requests; the server needs an update.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يحافظ الخادم على نقل الوسائط المصادَق عليه أثناء إعادة التخطيط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
