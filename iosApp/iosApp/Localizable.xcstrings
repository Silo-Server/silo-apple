        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará tu solicitud fallida de “%1$@”. Puedes volver a solicitar el título más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre demande échouée pour « %1$@ » sera supprimée. Vous pourrez demander ce titre à nouveau plus tard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」の失敗したリクエストを削除します。このタイトルは後でもう一度リクエストできます。"
