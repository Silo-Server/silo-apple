    "signIn.provider.differentServer" : {
      "comment" : "Android phone sign-in screen: error when a browser sign-in returned from a server other than the one it started on. Same words as the Apple apps. Apple (iPhone, iPad, Mac): same provider sign-in error.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
