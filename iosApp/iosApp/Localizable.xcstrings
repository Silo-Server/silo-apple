    "settingsManifest.playback.show_marker_source.description" : {
      "comment" : "Help text under the playback.show_marker_source setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض مصدر التخطي فوق زر «تخطي المقدمة»: اكتشاف Silo الخاص، أو شخص، أو المزود الذي قدّم العلامة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt über der Schaltfläche „Intro überspringen“ an, woher das Überspringen stammt: von Silos eigener Erkennung, von einer Person oder vom Anbieter, der die Markierung geliefert hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show where the skip came from above the Skip Intro button: Silo's own detection, a person, or the provider that supplied the marker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra sobre el botón Omitir introducción de dónde viene la omisión: la detección propia de Silo, una persona o el proveedor que aportó el marcador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche au-dessus du bouton « Passer l’intro » l’origine du passage : la détection de Silo, une personne ou le fournisseur du marqueur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「イントロをスキップ」ボタンの上にスキップの出所を表示します。Silo独自の検出、人による指定、またはマーカーを提供したプロバイダーのいずれかです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra acima do botão Pular abertura a origem do salto: a detecção do próprio Silo, uma pessoa ou o provedor que forneceu o marcador."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“跳过片头”按钮上方显示跳过标记的来源：Silo自身检测、人工标记，或提供该标记的提供商。"
          }
