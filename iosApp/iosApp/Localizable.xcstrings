    "diagnostics.notice.tooLarge" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: the destination refused the report as too large.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
