    "diagnostics.send.debugOffFooterTv" : {
      "comment" : "Note under Send Diagnostics Now in Diagnostics settings when Debug Logging is off. Shown as a footer in the Diagnostics settings pane on Android TV, and on Apple (iPhone, iPad, Apple TV).",
