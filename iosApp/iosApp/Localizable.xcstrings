    "home.recipe.seAuto.description" : {
      "comment" : "One-line description of the Seasonal Picks preset in the Add row gallery (shared key `home.recipe.seAuto.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبدّل تلقائيًا — الهالوين في أكتوبر، وعيد الميلاد في ديسمبر، وغير ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselt automatisch – Halloween im Oktober, Weihnachten im Dezember usw."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cycles automatically — Halloween in October, Christmas in December, etc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia automáticamente — Halloween en octubre, Navidad en diciembre, etc."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change automatiquement — Halloween en octobre, Noël en décembre, etc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動で切り替わります。10月はハロウィン、12月はクリスマスなど。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muda automaticamente — Halloween em outubro, Natal em dezembro etc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动轮换——10月是万圣节，12月是圣诞节，等等。"
          }
        }
      }
    },
    "home.recipe.seAuto.details" : {
      "comment" : "Longer description of the Seasonal Picks preset in the Add row gallery (shared key `home.recipe.seAuto.details`, sent as description_long_key). Shown when a client opens the preset.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قسم واحد يعرض اختيارات منسقة للعطلات وفق التقويم. اختر العطلات وأجواء لكل منها، وأضف عطلاتك الخاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bereich, der je nach Kalender kuratierte Empfehlungen zu Feiertagen einblendet. Wähle die Feiertage und für jeden eine Stimmung, und füge eigene Feiertage hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One section that swaps in curated holiday picks based on the calendar. Choose the holidays, a vibe for each, and add your own holidays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sola sección que muestra selecciones festivas según el calendario. Elige las festividades y un ambiente para cada una, y añade tus propias festividades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une seule section qui affiche des sélections de fêtes selon le calendrier. Choisissez les fêtes et une ambiance pour chacune, et ajoutez vos propres fêtes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーに合わせて、厳選された祝日のおすすめに切り替わるセクションです。祝日とそれぞれの雰囲気を選び、独自の祝日を追加できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma seção que alterna sugestões de datas comemorativas com curadoria conforme o calendário. Escolha as datas, um clima para cada uma e adicione suas próprias datas comemorativas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个根据日历自动切换精选节日内容的版块。选择节日，为每个节日设定氛围，还可以添加你自己的节日。"
          }
        }
      }
    },
