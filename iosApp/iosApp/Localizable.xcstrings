        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未儲存。請再試一次，或捨棄下方的變更。"
          }
        }
      }
    },
    "settings.subtitles.languageFooter" : {
      "comment" : "Android phone and TV. Phone: footer under the Profile group on Settings → Subtitles. TV: Settings > Subtitles > Profile: help text under the language, behavior and forced subtitle rows. Apple Settings > Subtitles (iPhone, iPad, Mac) and Apple TV Settings > Subtitles: same footer.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم لاختيار مسار مطابق عند توفره. تغطي الترجمة الإجبارية الحوار بلغة أجنبية حتى عندما تكون الترجمة معطّلة أو مضبوطة على «تلقائي»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използва се за избор на съответстващ запис, когато има такъв. Задължителните субтитри покриват диалозите на чужд език дори когато субтитрите са изключени или са на „Автоматично“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’utilitza per triar una pista coincident quan n’hi ha una de disponible. Els subtítols forçats cobreixen els diàlegs en altres idiomes fins i tot quan els subtítols estan desactivats o en mode automàtic."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slouží k výběru odpovídající stopy, pokud je k dispozici. Vynucené titulky pokrývají dialogy v cizím jazyce, i když jsou titulky vypnuté nebo nastavené na Auto."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til at vælge et matchende spor, når der findes et. Tvungne undertekster dækker dialog på fremmedsprog, selv når undertekster er slået fra eller sat til Auto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um eine passende Spur auszuwählen, wenn eine verfügbar ist. Erzwungene Untertitel übersetzen fremdsprachige Dialoge, auch wenn Untertitel aus oder auf Auto gestellt sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται για την επιλογή αντίστοιχου κομματιού όταν υπάρχει διαθέσιμο. Οι αναγκαστικοί υπότιτλοι καλύπτουν διαλόγους σε ξένη γλώσσα ακόμη και όταν οι υπότιτλοι είναι απενεργοποιημένοι ή ρυθμισμένοι σε «Αυτόματα»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to pick a matching track when one is available. Forced subtitles cover foreign-language dialogue even when subtitles are off or set to auto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para elegir una pista que coincida cuando haya una disponible. Los subtítulos forzados cubren los diálogos en otros idiomas incluso cuando los subtítulos están desactivados o en automático."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasutatakse sobiva raja valimiseks, kui see on saadaval. Sunnitud subtiitrid tõlgivad võõrkeelse dialoogi ka siis, kui subtiitrid on väljas või seatud valikule „Auto“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään vastaavan raidan valintaan, kun sellainen on saatavilla. Pakotetut tekstitykset kattavat vieraskielisen dialogin, vaikka tekstitys olisi pois tai asetettu automaattiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à choisir une piste correspondante lorsqu’elle est disponible. Les sous-titres forcés traduisent les dialogues en langue étrangère, même lorsque les sous-titres sont désactivés ou réglés sur Auto."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משמש לבחירת רצועה תואמת כשיש כזו. כתוביות כפויות מתרגמות דיאלוג בשפה זרה גם כשהכתוביות כבויות או מוגדרות למצב ”אוטומטי”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपलब्ध होने पर मेल खाता ट्रैक चुनने के लिए इस्तेमाल होता है। फ़ोर्स्ड सबटाइटल विदेशी भाषा के संवाद दिखाते हैं, तब भी जब सबटाइटल बंद हों या ऑटो पर सेट हों।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi se za odabir odgovarajućeg zapisa kada je dostupan. Prisilni titlovi prevode dijalog na stranom jeziku čak i kada su titlovi isključeni ili postavljeni na automatski."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek alapján választja ki a megfelelő sávot, ha van ilyen. A kényszerített feliratok az idegen nyelvű párbeszédeket akkor is megjelenítik, ha a feliratok ki vannak kapcsolva, vagy automatikusra vannak állítva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk memilih trek yang cocok jika tersedia. Subtitel paksa menerjemahkan dialog berbahasa asing meskipun subtitel nonaktif atau diatur ke otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usata per scegliere una traccia corrispondente quando disponibile. I sottotitoli forzati coprono i dialoghi in lingua straniera anche quando i sottotitoli sono disattivati o impostati su automatico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致するトラックがある場合に、そのトラックを選ぶために使用します。強制字幕は、字幕がオフまたは自動の場合でも外国語の会話を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일치하는 트랙이 있으면 그 트랙을 선택하는 데 사용돼요. 강제 자막은 자막이 꺼져 있거나 자동으로 설정되어 있어도 외국어 대사를 표시해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naudojama atitinkamam takeliui parinkti, kai toks yra. Priverstiniai subtitrai rodomi užsienio kalba vykstantiems dialogams, net kai subtitrai išjungti arba pasirinkta „Auto“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiek izmantota, lai izvēlētos atbilstošu celiņu, ja tāds ir pieejams. Piespiedu subtitri tulko dialogus svešvalodā arī tad, ja subtitri ir izslēgti vai iestatīti uz „Auto”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk memilih trek yang sepadan apabila tersedia. Sari kata paksa meliputi dialog bahasa asing walaupun sari kata dimatikan atau ditetapkan kepada auto."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes til å velge et samsvarende spor når det finnes. Tvungne undertekster dekker dialog på fremmedspråk selv når undertekster er av eller satt til Auto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt gebruikt om een passend spoor te kiezen als dat beschikbaar is. Geforceerde ondertitels tonen dialogen in een vreemde taal, ook als ondertitels uit staan of op automatisch staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy do wyboru pasującej ścieżki, jeśli jest dostępna. Napisy wymuszone obejmują dialogi w obcym języku nawet wtedy, gdy napisy są wyłączone lub ustawione na Auto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para escolher uma faixa correspondente quando houver uma disponível. As legendas forçadas cobrem diálogos em idioma estrangeiro mesmo quando as legendas estão desativadas ou no modo automático."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para escolher uma faixa correspondente quando existir. As legendas forçadas abrangem diálogos em língua estrangeira, mesmo quando as legendas estão desativadas ou definidas como automáticas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se folosește pentru a alege o pistă potrivită, când este disponibilă. Subtitrările forțate traduc dialogurile în limbi străine chiar și când subtitrările sunt dezactivate sau setate pe automat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для выбора подходящей дорожки, если она есть. Принудительные субтитры переводят диалоги на иностранном языке, даже если субтитры выключены или установлены на «Авто»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používa sa na výber zodpovedajúcej stopy, ak je k dispozícii. Vynútené titulky prekladajú dialógy v cudzom jazyku, aj keď sú titulky vypnuté alebo nastavené na Auto."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporablja se za izbiro ustreznega posnetka, ko je na voljo. Vsiljeni podnapisi prevajajo dialog v tujem jeziku, tudi ko so podnapisi izklopljeni ali nastavljeni na samodejno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för att välja ett matchande spår när ett sådant finns. Tvingade undertexter täcker dialog på främmande språk även när undertexter är av eller inställda på Auto."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เพื่อเลือกแทร็กที่ตรงกันเมื่อมี คำบรรยายแบบบังคับจะแสดงบทพูดภาษาต่างประเทศแม้คำบรรยายจะปิดอยู่หรือตั้งเป็น “อัตโนมัติ”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsa eşleşen bir parçayı seçmek için kullanılır. Zorunlu altyazılar, altyazılar kapalıyken veya “Otomatik” olarak ayarlıyken bile yabancı dildeki diyalogları kapsar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовується, щоб вибрати відповідну доріжку, якщо вона є. Примусові субтитри показують діалоги іноземною мовою, навіть коли субтитри вимкнено або встановлено режим «Авто»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng để chọn bản phụ đề phù hợp khi có. Phụ đề bắt buộc hiển thị lời thoại tiếng nước ngoài kể cả khi phụ đề đang tắt hoặc đặt là tự động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有匹配的轨道时将据此选择。即使字幕已关闭或设为自动，强制字幕也会显示外语对白。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有相符的字幕軌時，會用來選擇該字幕軌。即使字幕已關閉或設為自動，強制字幕仍會顯示外語對白。"
          }
        }
      }
    },
