          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप पहले से एक पार्टी में हैं। किसी दूसरी पार्टी में शामिल होने के लिए उसे छोड़ें।"
          }
        },
        "hr" : {
