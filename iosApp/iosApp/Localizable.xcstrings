    "diagnostics.erase.confirm" : {
      "comment" : "Destructive button that deletes diagnostics reports: Roku dialog for deleting sent reports; Apple swipe action on a pending report (iPhone, iPad) and confirm button for deleting one (Apple TV).",
      "extractionState" : "manual",
      "localizations" : {
