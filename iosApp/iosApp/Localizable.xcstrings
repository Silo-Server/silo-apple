        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quality lowered to stop buffering"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calidad reducida para evitar el almacenamiento en búfer"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualité baissée pour arrêter la mise en mémoire tampon"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッファリングを防ぐため画質を下げました"
