          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインを承認するために%1$@に接続できませんでした。この%2$@の接続を確認して、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
