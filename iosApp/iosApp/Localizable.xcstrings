    "tvPair.entry.noServers" : {
      "comment" : "Apple (iPhone, iPad): Sign in a TV screen: note when the phone isn't signed in to any server, so it can't approve a TV.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
