    "profiles.rememberOffer.bodyAppleTv" : {
      "comment" : "Apple TV: body of the dialog offering to open the chosen profile automatically. Settings > General > Profile Selection is a path in the Apple TV app's settings; keep it consistent with those labels.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لـ Silo تخطي «من يشاهد؟» وفتح هذا الملف الشخصي عند بدء تشغيله على جهاز Apple TV هذا. يمكنك تغيير ذلك لاحقًا في الإعدادات ← عام ← اختيار الملف الشخصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kann „Wer schaut?“ überspringen und dieses Profil öffnen, wenn die App auf diesem Apple TV startet. Du kannst das später unter Einstellungen > Allgemein > Profilauswahl ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo can skip Who's Watching and open this profile when it starts on this Apple TV. You can change this later in Settings > General > Profile Selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo puede omitir ¿Quién está viendo? y abrir este perfil al iniciarse en este Apple TV. Puedes cambiarlo más tarde en Configuración > General > Selección de perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo peut passer l’écran « Qui regarde ? » et ouvrir ce profil au démarrage sur cette Apple TV. Vous pourrez modifier ce choix plus tard dans Paramètres > Général > Sélection du profil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVでSiloを起動したときに、「誰が視聴しますか？」を省略してこのプロフィールを開くことができます。この設定は後から「設定 > 一般 > プロフィールの選択」で変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo pode pular a tela “Quem está assistindo?” e abrir este perfil ao iniciar nesta Apple TV. Você pode mudar isso depois em Configurações > Geral > Seleção de perfil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo在这台Apple TV上启动时，可以跳过“谁在观看”并直接打开此个人资料。你之后可以在设置 > 通用 > 个人资料选择中更改。"
          }
        }
      }
    },
