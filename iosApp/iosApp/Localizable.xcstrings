    "settings.profileSettings.confirmTitle" : {
      "comment" : "Android phone and TV: title of the dialog confirming Use Profile Settings in Playback settings. Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: same dialog title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد استخدام إعدادات ملفك الشخصي على هذا الجهاز؟"
          }
        },
        "cs" : {
          "stringUnit" : {
