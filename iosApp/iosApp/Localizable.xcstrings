    "settings.subtitles.heldNotice" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac): status under the profile's subtitle options when a change is held; Try Again and Discard Held Change are below.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير محفوظ. حاول مرة أخرى أو تجاهل التغيير أدناه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не е запазено. Опитайте отново или отхвърлете промяната по-долу."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha desat. Torna-ho a provar o descarta el canvi a continuació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuloženo. Zkuste to znovu nebo změnu níže zahoďte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke gemt. Prøv igen, eller kassér ændringen nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gespeichert. Versuche es erneut oder verwirf die Änderung unten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν αποθηκεύτηκε. Δοκιμάστε ξανά ή απορρίψτε την αλλαγή παρακάτω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not saved. Try again or discard the change below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se guardó. Vuelve a intentarlo o descarta el cambio a continuación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pole salvestatud. Proovige uuesti või loobuge allpool muudatusest."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei tallennettu. Yritä uudelleen tai hylkää muutos alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non enregistré. Réessayez ou annulez la modification ci-dessous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא נשמר. אפשר לנסות שוב או לבטל את השינוי שלמטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेव नहीं किया गया। फिर से कोशिश करें या नीचे बदलाव को रद्द करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije spremljeno. Pokušajte ponovno ili odbacite promjenu u nastavku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs mentve. Próbálja újra, vagy vesse el a módosítást lent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak disimpan. Coba lagi atau buang perubahan di bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non salvato. Riprova o annulla la modifica qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されていません。再試行するか、下で変更を破棄してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장되지 않았어요. 다시 시도하거나 아래에서 변경 사항을 취소하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neišsaugota. Bandykite dar kartą arba atmeskite pakeitimą toliau."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nav saglabāts. Mēģiniet vēlreiz vai atmetiet izmaiņas tālāk."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak disimpan. Cuba lagi atau buang perubahan di bawah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke lagret. Prøv igjen eller forkast endringen nedenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet opgeslagen. Probeer het opnieuw of verwerp de wijziging hieronder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zapisano. Spróbuj ponownie lub odrzuć zmianę poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não salvo. Tente novamente ou descarte a alteração abaixo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não guardado. Tente novamente ou descarte a alteração abaixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a salvat. Încercați din nou sau renunțați la modificarea de mai jos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не сохранено. Повторите попытку или отмените изменение ниже."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuložené. Skúste to znova alebo zmenu nižšie zahoďte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni shranjeno. Poskusite znova ali spodaj zavrzite spremembo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte sparat. Försök igen eller kasta ändringen nedan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่ได้บันทึก โปรดลองอีกครั้งหรือละทิ้งการเปลี่ยนแปลงด้านล่าง"
          }
