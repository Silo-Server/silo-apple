    "profiles.rememberOffer.bodyAppleTv" : {
      "comment" : "Apple TV: body of the dialog offering to open the chosen profile automatically. Settings > General > Profile Selection is a path in the Apple TV app's settings; keep it consistent with those labels.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لـ Silo تخطي «من يشاهد؟» وفتح هذا الملف الشخصي عند بدء تشغيله على جهاز Apple TV هذا. يمكنك تغيير ذلك لاحقًا في الإعدادات ← عام ← اختيار الملف الشخصي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo може да пропуска екрана „Кой гледа?“ и да отваря този профил при стартиране на това Apple TV. Можете да промените това по-късно в Настройки > Общи > Избор на профил."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo pot ometre Qui està mirant i obrir aquest perfil quan s’iniciï en aquest Apple TV. Pots canviar-ho més endavant a Configuració > General > Selecció de perfil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo může přeskočit obrazovku „Kdo se dívá?“ a při spuštění na tomto Apple TV rovnou otevřít tento profil. Později to můžete změnit v Nastavení > Obecné > Výběr profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kan springe ”Hvem ser med?” over og åbne denne profil, når appen starter på dette Apple TV. Du kan ændre det senere under Indstillinger > Generelt > Profilvalg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kann „Wer schaut?“ überspringen und dieses Profil öffnen, wenn die App auf diesem Apple TV startet. Du kannst das später unter Einstellungen > Allgemein > Profilauswahl ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Silo μπορεί να παραλείπει την οθόνη «Ποιος βλέπει;» και να ανοίγει αυτό το προφίλ κατά την εκκίνηση σε αυτό το Apple TV. Μπορείτε να το αλλάξετε αργότερα στις Ρυθμίσεις > Γενικά > Επιλογή προφίλ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo can skip Who's Watching and open this profile when it starts on this Apple TV. You can change this later in Settings > General > Profile Selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo puede omitir ¿Quién está viendo? y abrir este perfil al iniciarse en este Apple TV. Puedes cambiarlo más tarde en Configuración > General > Selección de perfil."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo saab ekraani „Kes vaatab?“ vahele jätta ja selle profiili avada, kui rakendus selles Apple TV-s käivitub. Saate seda hiljem muuta jaotises Seaded > Üldine > Profiili valik."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo voi ohittaa Kuka katsoo -näkymän ja avata tämän profiilin, kun se käynnistyy tässä Apple TV:ssä. Voit muuttaa tätä myöhemmin kohdassa Asetukset > Yleiset > Profiilin valinta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo peut passer l’écran « Qui regarde ? » et ouvrir ce profil au démarrage sur cette Apple TV. Vous pourrez modifier ce choix plus tard dans Paramètres > Général > Sélection du profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כש-Silo מופעל ב-Apple TV הזה, הוא יכול לדלג על המסך ”מי צופה?” ולפתוח את הפרופיל הזה. אפשר לשנות את זה בהמשך בהגדרות ← כללי ← בחירת פרופיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Apple TV पर शुरू होने पर Silo “कौन देख रहा है?” स्क्रीन छोड़कर सीधे यह प्रोफ़ाइल खोल सकता है। इसे बाद में सेटिंग > सामान्य > प्रोफ़ाइल चयन में बदला जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo može preskočiti zaslon „Tko gleda?“ i otvoriti ovaj profil kad se pokrene na ovom uređaju Apple TV. To možete kasnije promijeniti u izborniku Postavke > Općenito > Odabir profila."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo kihagyhatja a „Ki néz?” képernyőt, és megnyithatja ezt a profilt, amikor ezen az Apple TV-n elindul. Ezt később itt módosíthatja: Beállítások > Általános > Profilválasztás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo dapat melewati layar Siapa yang menonton dan membuka profil ini saat dimulai di Apple TV ini. Anda dapat mengubahnya nanti di Pengaturan > Umum > Pemilihan profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo può saltare la schermata “Chi sta guardando?” e aprire questo profilo all’avvio su questa Apple TV. Puoi modificare questa scelta in seguito in Impostazioni > Generali > Selezione del profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVでSiloを起動したときに、「誰が視聴しますか？」を省略してこのプロフィールを開くことができます。この設定は後から「設定 > 一般 > プロフィールの選択」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo가 이 Apple TV에서 시작할 때 “누가 보고 있나요?” 화면을 건너뛰고 이 프로필을 바로 열 수 있어요. 나중에 설정 > 일반 > 프로필 선택에서 변경할 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Silo“ gali praleisti ekraną „Kas žiūri?“ ir atidaryti šį profilį, kai programa paleidžiama šiame „Apple TV“ įrenginyje. Tai vėliau galėsite pakeisti skiltyje „Nustatymai > Bendra > Profilio pasirinkimas“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo var izlaist ekrānu „Kas skatās?” un atvērt šo profilu, kad lietotne tiek palaista šajā Apple TV ierīcē. To var mainīt vēlāk sadaļā „Iestatījumi > Vispārīgi > Profila atlase”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo boleh melangkau skrin Siapa yang menonton dan membuka profil ini apabila dimulakan pada Apple TV ini. Anda boleh menukarnya kemudian dalam Tetapan > Umum > Pemilihan profil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kan hoppe over «Hvem ser på?» og åpne denne profilen når appen starter på denne Apple TV-en. Du kan endre dette senere under Innstillinger > Generelt > Profilvalg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kan “Wie kijkt er?” overslaan en dit profiel openen wanneer de app op deze Apple TV start. Je kunt dit later wijzigen in Instellingen > Algemeen > Profielselectie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo może pomijać ekran „Kto ogląda?” i otwierać ten profil przy uruchomieniu na tym urządzeniu Apple TV. Możesz to później zmienić w sekcji Ustawienia > Ogólne > Wybór profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo pode pular a tela “Quem está assistindo?” e abrir este perfil ao iniciar nesta Apple TV. Você pode mudar isso depois em Configurações > Geral > Seleção de perfil."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo pode saltar o ecrã Quem está a ver e abrir este perfil ao iniciar nesta Apple TV. Pode alterar isto mais tarde em Definições > Geral > Seleção de perfil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo poate omite ecranul „Cine vizionează?” și poate deschide acest profil la pornirea pe acest Apple TV. Puteți modifica opțiunea mai târziu în Setări > General > Selectare profil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo может пропускать экран «Кто смотрит?» и открывать этот профиль при запуске на этом Apple TV. Изменить это можно позже в разделе «Настройки» > «Основные» > «Выбор профиля»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo môže preskočiť obrazovku Kto sa pozerá a pri spustení na tomto Apple TV otvoriť tento profil. Neskôr to môžete zmeniť v časti Nastavenia > Všeobecné > Výber profilu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo lahko preskoči zaslon „Kdo gleda“ in ob zagonu na tej napravi Apple TV odpre ta profil. To lahko pozneje spremenite v razdelku Nastavitve > Splošno > Izbira profila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kan hoppa över ”Vem tittar?” och öppna den här profilen när appen startar på den här Apple TV:n. Du kan ändra detta senare under Inställningar > Allmänt > Profilval."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ข้ามหน้าจอ “ใครกำลังดู” และเปิดโปรไฟล์นี้เมื่อเริ่มต้นบน Apple TV เครื่องนี้ได้ คุณเปลี่ยนได้ภายหลังในการตั้งค่า > ทั่วไป > การเลือกโปรไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo, bu Apple TV’de açıldığında “Kim izliyor?” ekranını atlayıp bu profili açabilir. Bunu daha sonra Ayarlar > Genel > Profil seçimi altından değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo може пропускати екран «Хто дивиться?» і відкривати цей профіль під час запуску на цьому Apple TV. Це можна змінити пізніше в розділі Налаштування > Загальні > Вибір профілю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo có thể bỏ qua màn hình Ai đang xem và mở hồ sơ này khi khởi động trên Apple TV này. Bạn có thể thay đổi tùy chọn này sau trong Cài đặt > Chung > Chọn hồ sơ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo在这台Apple TV上启动时，可以跳过“谁在观看”并直接打开此个人资料。你之后可以在设置 > 通用 > 个人资料选择中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo 在這台 Apple TV 上啟動時，可以略過「誰在觀看」並直接開啟這個個人檔案。你之後可以在「設定 > 一般 > 個人檔案選擇」中變更。"
          }
        }
      }
    },
    "profiles.rememberOffer.titleUnnamed" : {
      "comment" : "Apple TV: title of the dialog offering to skip the profile picker next time, used when the profile has no name to show (launch.offer.title otherwise).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد فتح هذا الملف الشخصي تلقائيًا؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да се отваря ли този профил автоматично?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols obrir aquest perfil automàticament?"
          }
        },
