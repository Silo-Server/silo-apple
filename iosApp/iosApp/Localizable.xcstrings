          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezoluția de redare pe datele mobile sau pe altă conexiune contorizată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешение воспроизведения через мобильный интернет или другое лимитное подключение."
