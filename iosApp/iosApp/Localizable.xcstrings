    "servers.remove.bodyAppleTv" : {
      "comment" : "Apple TV Manage Servers: message of the confirmation before a saved server is removed. {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى تسجيل الخروج من كل حساب على %1$@ على جهاز Apple TV هذا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще излезете от всички акаунти в сървъра %1$@ на това Apple TV."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això tanca la sessió de tots els comptes del servidor %1$@ en aquest Apple TV."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto se na této Apple TV odhlásíte ze všech účtů na serveru %1$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette logger ud af alle konti på %1$@ på dette Apple TV."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden auf diesem Apple TV alle Konten auf %1$@ abgemeldet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έτσι θα αποσυνδεθούν όλοι οι λογαριασμοί στον διακομιστή %1$@ σε αυτό το Apple TV."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This signs out of every account on %1$@ on this Apple TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará la sesión de todas las cuentas de %1$@ en este Apple TV."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See logib teid selles Apple TV-s välja kõigist serveri %1$@ kontodest."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä kirjaa ulos kaikki palvelimen %1$@ tilit tällä Apple TV:llä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela déconnecte tous les comptes de %1$@ sur cette Apple TV."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעולה הזו תנתק את כל החשבונות בשרת %1$@ ב-Apple TV הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे इस Apple TV पर सर्वर %1$@ के हर खाते से साइन आउट हो जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time se odjavljujete sa svih računa na poslužitelju %1$@ na ovom Apple TV-u."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezzel kijelentkezik a(z) %1$@ szerver összes fiókjából ezen az Apple TV-n."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini akan mengeluarkan setiap akun di server %1$@ pada Apple TV ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrà chiuso l’accesso a tutti gli account di %1$@ su questa Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVで、%1$@のすべてのアカウントからサインアウトします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple TV에서 %1$@ 서버의 모든 계정이 로그아웃돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taip šiame „Apple TV“ įrenginyje bus atsijungta nuo visų serverio %1$@ paskyrų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šajā Apple TV ierīcē notiks izrakstīšanās no visiem servera %1$@ kontiem."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini melog keluar setiap akaun pada pelayan %1$@ di Apple TV ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette logger ut alle kontoer på %1$@ på denne Apple TV-en."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee log je op deze Apple TV uit bij elk account op %1$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to wylogowanie ze wszystkich kont na serwerze %1$@ na tym Apple TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso encerra a sessão de todas as contas em %1$@ nesta Apple TV."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação termina a sessão em todas as contas do servidor %1$@ nesta Apple TV."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate conturile de pe serverul %1$@ vor fi deconectate pe acest Apple TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет выполнен выход из всех аккаунтов на сервере «%1$@» на этом Apple TV."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týmto sa v tomto zariadení Apple TV odhlásite zo všetkých účtov na serveri %1$@."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem se na tej napravi Apple TV odjavite iz vseh računov na strežniku %1$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta loggar ut alla konton på servern %1$@ på den här Apple TV:n."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะออกจากระบบทุกบัญชีในเซิร์ฟเวอร์ %1$@ บน Apple TV เครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, bu Apple TV’de %1$@ sunucusundaki tüm hesapların oturumunu kapatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буде виконано вихід з усіх облікових записів на %1$@ на цьому Apple TV."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ đăng xuất mọi tài khoản trên %1$@ trên Apple TV này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将在此Apple TV上退出%1$@上的所有账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會在這台 Apple TV 上登出 %1$@ 上的所有帳號。"
          }
        }
      }
    },
