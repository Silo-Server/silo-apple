    "errors.apple.accountStore.ownerChanged" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error after signing in when the user switched server before the account was stored.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر الخادم النشط قبل حفظ تسجيل الدخول."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivní server se změnil dříve, než bylo možné přihlášení uložit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den aktive server blev ændret, før login kunne gemmes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aktive Server wurde geändert, bevor die Anmeldung gespeichert werden konnte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The active server changed before sign-in could be saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor activo cambió antes de que se pudiera guardar el inicio de sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiivinen palvelin vaihtui ennen kuin kirjautumista ehdittiin tallentaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur actif a changé avant l’enregistrement de la connexion."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivni poslužitelj promijenio se prije nego što je prijava mogla biti spremljena."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server attivo è cambiato prima che l’accesso potesse essere salvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン情報を保存する前に、使用中のサーバーが変更されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 정보를 저장하기 전에 활성 서버가 바뀌었어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den aktive serveren ble endret før påloggingen kunne lagres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De actieve server is gewijzigd voordat de aanmelding kon worden opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywny serwer zmienił się, zanim udało się zapisać logowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor ativo mudou antes que o login pudesse ser salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активный сервер изменился до сохранения данных входа."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den aktiva servern ändrades innan inloggningen kunde sparas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum açma bilgileri kaydedilmeden önce etkin sunucu değişti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активний сервер змінився до того, як вдалося зберегти дані входу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存登录信息前，当前服务器已更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存登入資訊前，使用中的伺服器已變更。"
          }
        }
      }
    },
    "errors.apple.accountStore.unreadable" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error when the account stored on the device is damaged or from an unknown version, so the user must sign in again.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة بيانات تسجيل الدخول المحفوظة على هذا الجهاز. سجّل الدخول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlášení uložené v tomto zařízení nelze přečíst. Přihlaste se znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det login, der er gemt på denne enhed, kan ikke læses. Log ind igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die auf diesem Gerät gespeicherte Anmeldung ist nicht lesbar. Melde dich erneut an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in saved on this device is unreadable. Sign in again."
          }
        },
        "es" : {
