    "shell.marquee.serverChip" : {
      "comment" : "Android phone: screen reader label of the server chip in the top bar of the sign-in and setup screens; double-tapping opens a menu to change the server. 1: the server's display name. Apple (iPhone, iPad, Mac): same VoiceOver label of the sign-in screen's server chip.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@، الخادم. انقر نقرًا مزدوجًا للتغيير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, сървър. Докоснете двукратно за промяна."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, servidor. Toca dues vegades per canviar-lo."
