    "shell.remotePlayback.replaceMessage" : {
      "comment" : "Apple (iPhone): message under Replace what's playing?, asked before starting a title on a TV that is already playing something. {target}: the TV's name, or the words the TV; {title}: the title playing there now.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُشغّل %1$@ الآن %2$@. سيؤدي تشغيل هذا إلى إيقافه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На %1$@ се възпроизвежда %2$@. Ако пуснете това, то ще спре."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’està reproduint %2$@ a %1$@. Si reprodueixes aquest títol, s’aturarà."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařízení %1$@ přehrává %2$@. Spuštěním tohoto titulu se přehrávání zastaví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der afspilles %2$@ på %1$@. Hvis du afspiller dette, stoppes det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %1$@ läuft gerade %2$@. Wenn du diesen Titel abspielst, wird die Wiedergabe dort beendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στη συσκευή %1$@ αναπαράγεται το στοιχείο %2$@. Αν ξεκινήσετε αυτό, η τρέχουσα αναπαραγωγή θα διακοπεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is playing %2$@. Playing this will stop it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está reproduciendo %2$@. Si reproduces esto, se detendrá."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seadmes %1$@ esitatakse praegu pealkirja %2$@. Selle esitamine peatab praeguse esituse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ toistaa kohdetta %2$@. Tämän toistaminen pysäyttää sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture de %2$@ en cours sur %1$@. Lancer ce titre l’arrêtera."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בהפעלה כעת במכשיר %1$@: %2$@. הפעלת הפריט הזה תעצור את ההפעלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ पर अभी टाइटल %2$@ चल रहा है। इसे चलाने पर वह प्लेबैक रुक जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ reproducira „%2$@“. Ako pokrenete ovo, ta će se reprodukcija zaustaviti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ megy itt: %1$@. Ha ezt elindítja, az leáll."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sedang memutar %2$@. Memutar judul ini akan menghentikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su %1$@ è in riproduzione %2$@. Se avvii questo titolo, la riproduzione verrà interrotta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@で%2$@を再生中です。これを再生すると停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 %2$@을(를) 재생하고 있어요. 이 항목을 재생하면 기존 재생이 중지돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įrenginyje %1$@ leidžiama „%2$@“. Paleidus šį pavadinimą, dabartinis atkūrimas bus sustabdytas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ atskaņo „%2$@”. Ja atskaņosiet šo vienumu, tā atskaņošana tiks apturēta."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sedang memainkan %2$@. Memainkan tajuk ini akan menghentikannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ spiller av %2$@. Hvis du spiller av dette, stoppes det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ speelt %2$@ af. Als je dit afspeelt, stopt dat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecnie odtwarzane na: %1$@ – %2$@. Włączenie tego tytułu zatrzyma odtwarzanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ está em reprodução em %1$@. Reproduzir este título vai interromper essa reprodução."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo %1$@ está a reproduzir %2$@. Reproduzir este título vai interrompê-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ redă %2$@. Dacă redați acest titlu, redarea curentă se va opri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: сейчас воспроизводится «%2$@». Если начать воспроизведение, оно будет остановлено."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zariadenie %1$@ prehráva titul %2$@. Ak spustíte tento titul, prehrávanie sa zastaví."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na napravi %1$@ se predvaja %2$@. Če začnete to predvajanje, se bo ustavilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ spelar upp %2$@. Om du spelar upp det här stoppas det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ กำลังเล่น %2$@ อยู่ การเล่นเรื่องนี้จะหยุดการเล่นนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ cihazında %2$@ oynatılıyor. Bunu oynatırsanız mevcut oynatma durur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ відтворює %2$@. Нове відтворення зупинить його."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đang phát %2$@. Phát nội dung này sẽ dừng nội dung đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@正在播放%2$@。播放此内容将停止当前播放。"
