    "settingsManifest.player.sleep_timer_default_minutes.description" : {
      "comment" : "Help text under the player.sleep_timer_default_minutes setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
