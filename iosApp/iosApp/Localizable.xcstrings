        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra una previsualització de l’episodi següent mentre es reprodueixen els crèdits."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během závěrečných titulků zobrazit náhled dalšího dílu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
