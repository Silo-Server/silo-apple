    "settings.search.iosTerms.about" : {
      "comment" : "Apple Settings overview (iPhone, iPad): comma-separated search keywords that make Settings search show the About group. Keep the commas between terms; matching ignores case and finds any term containing the typed text. Translate each term as people would search for it in your language. These add to the English keywords, which always match too; never shown on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حول, الإصدار, الخصوصية, السياسة, المعلومات, مفتوح المصدر, التراخيص, شكر وتقدير, الشيفرة المصدرية, AGPL, الإسهامات, الإسناد, TMDB"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "o aplikaci, verze, soukromí, zásady, informace, open source, licence, poděkování, zdrojový kód, AGPL, zdroje a licence, autorství, TMDB"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "om, version, privatliv, politik, information, oplysninger, open source, licenser, anerkendelser, kildekode, AGPL, kreditering, tilskrivning, TMDB"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "über, info, version, datenschutz, richtlinie, informationen, open source, lizenzen, danksagungen, quellcode, AGPL, mitwirkende, namensnennung, TMDB"
          }
        },
        "en" : {
          "stringUnit" : {
