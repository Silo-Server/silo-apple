    "settings.interface.playThemeMusicSubtitle" : {
      "comment" : "Apple Settings > Interface > Theme Music and Apple TV Settings > General > Theme Music: description of the Play Theme Music switch (VoiceOver hint on iPhone, iPad and Apple TV; shown under the switch on Mac).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل الأغنية الرئيسية للعنوان من مكتبتك أثناء فتح صفحته."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Възпроизвежда музикалната тема на заглавието от вашата библиотека, докато страницата му е отворена."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodueix la sintonia d’un títol de la teva biblioteca mentre la seva pàgina està oberta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrávat ústřední melodii titulu z vaší knihovny, dokud je otevřená jeho stránka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil en titels temasang fra dit bibliotek, mens dens side er åben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt die Titelmusik eines Titels aus deiner Mediathek, solange seine Seite geöffnet ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπαραγωγή του μουσικού θέματος ενός τίτλου από τη βιβλιοθήκη σας όσο η σελίδα του είναι ανοιχτή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play a title's theme song from your library while its page is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce el tema musical de un título desde tu biblioteca mientras su página está abierta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esitab teie meediakogust pealkirja tunnusloo, kui selle leht on avatud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistaa kohteen tunnusmusiikin kirjastostasi, kun sen sivu on auki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
