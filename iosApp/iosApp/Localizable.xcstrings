        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una configuración de subtítulos específica de la serie prevalece sobre esta configuración predeterminada del perfil. Los cambios aquí se guardan para el perfil, pero la de la serie sigue aplicándose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paramètre de sous-titres propre à une série remplace cette valeur par défaut du profil. Les modifications effectuées ici sont enregistrées pour le profil, mais le paramètre de la série s’applique toujours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シリーズ専用の字幕設定が、このプロフィールのデフォルトより優先されます。ここでの変更はプロフィールに保存されますが、シリーズの設定が引き続き優先されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma configuração de legendas específica da série substitui este padrão do perfil. As alterações aqui são salvas no perfil, mas a configuração da série continua valendo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剧集专属的字幕设置会覆盖此个人资料默认值。此处的更改会保存到个人资料，但剧集覆盖设置仍然生效。"
          }
        }
      }
    },
    "settings.profilePrefs.overrideSeveral" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac, Apple TV): note when several narrower subtitle settings (for a device, library or series) win over the profile's.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتجاوز إعدادات ترجمة أكثر تحديدًا للجهاز أو المكتبة أو المسلسل هذا الإعداد الافتراضي للملف الشخصي. تُحفظ التغييرات هنا للملف الشخصي، لكن تلك الإعدادات تظل مطبّقة حيثما ضُبطت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spezifischere Untertitel-Einstellungen für Geräte, Mediatheken oder Serien haben Vorrang vor diesem Profilstandard. Änderungen hier werden für das Profil gespeichert, diese Einstellungen gelten aber weiterhin, wo sie festgelegt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More specific device, library, or series subtitle settings override this profile default. Changes here are saved for the profile, but those overrides still apply where configured."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay configuraciones de subtítulos más específicas de dispositivo, biblioteca o serie que prevalecen sobre esta configuración predeterminada del perfil. Los cambios aquí se guardan para el perfil, pero esas configuraciones siguen aplicándose donde estén definidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des paramètres de sous-titres plus spécifiques à un appareil, une bibliothèque ou une série remplacent cette valeur par défaut du profil. Les modifications effectuées ici sont enregistrées pour le profil, mais ces paramètres s’appliquent toujours là où ils sont configurés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス、ライブラリ、シリーズ専用の字幕設定が、このプロフィールのデフォルトより優先されます。ここでの変更はプロフィールに保存されますが、設定されている箇所ではそれらが引き続き優先されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurações de legendas mais específicas de dispositivo, biblioteca ou série substituem este padrão do perfil. As alterações aqui são salvas no perfil, mas essas configurações continuam valendo onde estiverem definidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更具体的设备、媒体库或剧集字幕设置会覆盖此个人资料默认值。此处的更改会保存到个人资料，但这些覆盖设置在已配置的地方仍然生效。"
          }
        }
      }
    },
    "settings.profilePrefs.profileChanged" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac, Apple TV): error when another profile became active while the change was being saved.",
