    "diagnostics.prompt.notRespondingHosted" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad, Apple TV), shown after a problem report is captured: message when one report is waiting. Reports go to Silo Diagnostics, the Silo project's hosted service; Silo Diagnostics is a product name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف Silo عن الاستجابة مؤخرًا. يمكن أن يساعد إرسال تقرير تشخيص فريق Silo Diagnostics على فهم ما حدث."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo спря да отговаря наскоро. Изпращането на диагностичен отчет може да помогне на екипа на Silo Diagnostics да разбере какво се е случило."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ha deixat de respondre recentment. Enviar un informe de diagnòstic pot ajudar l’equip de Silo Diagnostics a entendre què ha passat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Silo nedávno nereagovala. Odesláním diagnostické zprávy můžete týmu Silo Diagnostics pomoci zjistit, co se stalo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo svarede ikke for nylig. Hvis du sender en diagnosticeringsrapport, kan det hjælpe Silo Diagnostics-teamet med at forstå, hvad der skete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo hat kürzlich nicht reagiert. Ein Diagnosebericht kann dem Silo Diagnostics-Team helfen zu verstehen, was passiert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Silo δεν αποκρινόταν πρόσφατα. Η αποστολή μιας αναφοράς διαγνωστικών μπορεί να βοηθήσει την ομάδα του Silo Diagnostics να καταλάβει τι συνέβη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo was not responding recently. Sending a diagnostics report can help the Silo Diagnostics team understand what happened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo dejó de responder recientemente. Enviar un informe de diagnóstico puede ayudar al equipo de Silo Diagnostics a entender qué pasó."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo lakkas hiljuti reageerimast. Diagnostikaaruande saatmine aitab Silo Diagnosticsi meeskonnal juhtunut mõista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo lakkasi äskettäin vastaamasta. Diagnostiikkaraportin lähettäminen voi auttaa Silo Diagnostics -tiimiä selvittämään, mitä tapahtui."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo a récemment cessé de répondre. L’envoi d’un rapport de diagnostic peut aider l’équipe Silo Diagnostics à comprendre ce qui s’est passé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה Silo לא הגיבה לאחרונה. שליחת דוח אבחון יכולה לעזור לצוות Silo Diagnostics להבין מה קרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo हाल ही में जवाब नहीं दे रहा था। डायग्नोस्टिक्स रिपोर्ट भेजने से Silo Diagnostics टीम को यह समझने में मदद मिल सकती है कि क्या हुआ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nedavno nije reagirao. Slanje dijagnostičkog izvješća može pomoći timu Silo Diagnostics da shvati što se dogodilo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo nemrég nem válaszolt. Egy diagnosztikai jelentés elküldésével segíthet a Silo Diagnostics csapatának megérteni, mi történt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo baru saja tidak merespons. Mengirim laporan diagnostik dapat membantu tim Silo Diagnostics memahami apa yang terjadi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di recente Silo ha smesso di rispondere. L’invio di un report di diagnostica può aiutare il team di Silo Diagnostics a capire cosa è successo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloが最近応答しなくなりました。診断レポートを送信すると、Silo Diagnosticsチームが原因を把握するのに役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근에 Silo가 응답하지 않았어요. 진단 보고서를 보내면 Silo Diagnostics 팀이 원인을 파악하는 데 도움이 돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Silo“ neseniai nereagavo. Išsiuntę diagnostikos pranešimą, galite padėti „Silo Diagnostics“ komandai suprasti, kas nutiko."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo lietotne nesen nereaģēja. Diagnostikas pārskata nosūtīšana var palīdzēt Silo Diagnostics komandai saprast, kas notika."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo tidak bertindak balas baru-baru ini. Menghantar laporan diagnostik boleh membantu pasukan Silo Diagnostics memahami perkara yang berlaku."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo sluttet nylig å svare. En diagnostikkrapport kan hjelpe Silo Diagnostics-teamet med å forstå hva som skjedde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo reageerde onlangs niet. Met een diagnostisch rapport kan het Silo Diagnostics-team begrijpen wat er is gebeurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Silo niedawno przestała odpowiadać. Wysłanie raportu diagnostycznego może pomóc zespołowi Silo Diagnostics ustalić, co się stało."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo parou de responder recentemente. Enviar um relatório de diagnóstico pode ajudar a equipe do Silo Diagnostics a entender o que aconteceu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo deixou de responder recentemente. Enviar um relatório de diagnóstico pode ajudar a equipa do Silo Diagnostics a perceber o que aconteceu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nu a răspuns recent. Trimiterea unui raport de diagnosticare poate ajuta echipa Silo Diagnostics să înțeleagă ce s-a întâmplat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавно приложение Silo не отвечало. Отправка диагностического отчёта поможет команде Silo Diagnostics понять, что случилось."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nedávno nereagovalo. Odoslanie diagnostického hlásenia môže tímu Silo Diagnostics pomôcť zistiť, čo sa stalo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija Silo se pred kratkim ni odzivala. Pošiljanje diagnostičnega poročila lahko ekipi Silo Diagnostics pomaga razumeti, kaj se je zgodilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo slutade svara nyligen. En diagnostikrapport kan hjälpa Silo Diagnostics-teamet att förstå vad som hände."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ไม่ตอบสนองเมื่อเร็ว ๆ นี้ การส่งรายงานการวินิจฉัยช่วยให้ทีม Silo Diagnostics เข้าใจสิ่งที่เกิดขึ้นได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo yakın zamanda yanıt vermedi. Tanılama raporu göndermek, Silo Diagnostics ekibinin ne olduğunu anlamasına yardımcı olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нещодавно застосунок Silo не відповідав. Надсилання діагностичного звіту допоможе команді Silo Diagnostics зрозуміти, що сталося."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo vừa không phản hồi. Gửi báo cáo chẩn đoán có thể giúp nhóm Silo Diagnostics hiểu điều gì đã xảy ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo最近出现了无响应。发送诊断报告可以帮助Silo Diagnostics团队了解发生了什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo 最近沒有回應。傳送診斷報告可協助 Silo Diagnostics 團隊瞭解發生了什麼事。"
          }
        }
      }
    },
