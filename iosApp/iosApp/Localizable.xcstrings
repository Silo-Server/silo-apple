    "downloads.options.qualityFooter" : {
      "comment" : "Apple iOS/macOS: Download Options sheet; footer under the quality choices.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ هذه القيمة من الإعداد الافتراضي العام للتنزيلات. تغييرها هنا يسري على هذا التنزيل فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voreingestellt ist dein allgemeiner Standard aus den Download-Einstellungen. Eine Änderung hier gilt nur für diesen Download."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts from your global Downloads default. Changing it here applies only to this download."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte de tu configuración predeterminada global de descargas. Si la cambias aquí, solo se aplica a esta descarga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette valeur reprend votre paramètre par défaut des téléchargements. La modifier ici ne s’applique qu’à ce téléchargement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全体のダウンロード設定のデフォルトが初期値になります。ここで変更した内容は、このダウンロードにのみ適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começa pelo seu padrão global de Downloads. Alterar aqui vale apenas para este download."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初始值来自你的全局下载默认设置。在此更改仅对本次下载生效。"
          }
        }
      }
    },
