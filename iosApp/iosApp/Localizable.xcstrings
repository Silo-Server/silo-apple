        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joka viikko eri lajityyppi, TMDB-arvio 6.0+ ja vähintään 100 ääntä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un genre différent chaque semaine, note d’au moins 6,0 sur TMDB avec au moins 100 votes."
