        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 서버에서 로그아웃됐어요. 다시 로그인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atsijungta nuo serverio %1$@. Prisijunkite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
