    "diagnostics.alwaysSend.settingsMessage" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) > Crash Reports: message of the confirmation for choosing Always.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُرسل أي تقارير معلّقة وتقارير الأعطال أو التجمّد المستقبلية لحساب الخادم هذا تلقائيًا. يمكنك تغيير ذلك في أي وقت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всички чакащи отчети и бъдещите отчети за сривове или блокирания за този акаунт на сървъра ще се изпращат автоматично. Можете да промените това по всяко време."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els informes pendents i els futurs informes d’error o de bloqueig d’aquest compte del servidor s’enviaran automàticament. Pots canviar-ho en qualsevol moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny čekající zprávy a budoucí zprávy o pádech nebo zamrznutí pro tento účet na serveru budou odesílány automaticky. Toto nastavení můžete kdykoli změnit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle ventende rapporter og fremtidige rapporter om nedbrud eller hængninger for denne serverkonto sendes automatisk. Du kan til enhver tid ændre dette."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle ausstehenden Berichte sowie künftige Berichte zu Abstürzen und Hängern für dieses Serverkonto werden automatisch gesendet. Du kannst das jederzeit ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τυχόν εκκρεμείς αναφορές και οι μελλοντικές αναφορές κατάρρευσης ή μη απόκρισης για αυτόν τον λογαριασμό διακομιστή θα αποστέλλονται αυτόματα. Μπορείτε να το αλλάξετε ανά πάσα στιγμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any pending reports and future crash or hang reports for this server account will be sent automatically. You can change this at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los informes pendientes y los futuros informes de fallos o bloqueos de esta cuenta del servidor se enviarán automáticamente. Puedes cambiar esto en cualquier momento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik ootel aruanded ning selle serverikonto edaspidised kokkujooksmise ja hangumise aruanded saadetakse automaatselt. Saate seda igal ajal muuta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki odottavat raportit sekä tämän palvelintilin tulevat kaatumis- ja jumiutumisraportit lähetetään automaattisesti. Voit muuttaa tätä milloin tahansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rapports en attente et les futurs rapports de plantage ou de blocage de ce compte serveur seront envoyés automatiquement. Vous pouvez modifier ce choix à tout moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל הדוחות הממתינים ודוחות עתידיים על קריסה או תקיעה לחשבון השרת הזה יישלחו אוטומטית. אפשר לשנות את זה בכל עת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सर्वर खाते की सभी लंबित रिपोर्टें और आगे की क्रैश या हैंग रिपोर्टें अपने-आप भेजी जाएँगी। इसे कभी भी बदला जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sva izvješća na čekanju i buduća izvješća o rušenju ili zastoju za ovaj račun na poslužitelju slat će se automatski. Ovo možete promijeniti u bilo kojem trenutku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo automatikusan elküldi az ehhez a szerverfiókhoz tartozó összes függőben lévő jelentést, valamint a jövőbeli összeomlási és lefagyási jelentéseket. Ezt bármikor módosíthatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua laporan yang tertunda serta laporan crash atau macet berikutnya untuk akun server ini akan dikirim secara otomatis. Anda dapat mengubah ini kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i report in attesa e i futuri report su arresti anomali o blocchi per questo account del server verranno inviati automaticamente. Puoi modificare questa scelta in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留中のレポートと、このサーバーアカウントの今後のクラッシュレポートおよびハングレポートは自動的に送信されます。この設定はいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기 중인 보고서와 이 서버 계정의 이후 충돌 또는 응답 없음 보고서가 자동으로 전송돼요. 언제든지 변경할 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visi laukiantys pranešimai ir būsimi pranešimai apie strigtis ar nereagavimą, susiję su šia serverio paskyra, bus siunčiami automatiškai. Tai galite pakeisti bet kada."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visi gaidošie pārskati un turpmākie avāriju vai sastingšanas pārskati šim servera kontam tiks nosūtīti automātiski. To varat mainīt jebkurā laikā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua laporan tertunda dan laporan ranap atau tergantung pada masa hadapan untuk akaun pelayan ini akan dihantar secara automatik. Anda boleh menukar tetapan ini pada bila-bila masa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventende rapporter og fremtidige rapporter om krasj eller heng for denne serverkontoen sendes automatisk. Du kan endre dette når som helst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle openstaande rapporten en toekomstige rapporten over crashes of vastlopers voor dit serveraccount worden automatisch verzonden. Je kunt dit op elk moment wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie oczekujące raporty oraz przyszłe raporty o awariach i zawieszeniach dla tego konta na serwerze będą wysyłane automatycznie. Możesz to zmienić w każdej chwili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os relatórios pendentes e os futuros relatórios de falhas ou travamentos desta conta do servidor serão enviados automaticamente. Você pode alterar isso a qualquer momento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os relatórios pendentes e os futuros relatórios de falhas ou bloqueios desta conta do servidor serão enviados automaticamente. Pode alterar isto a qualquer momento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate rapoartele în așteptare și viitoarele rapoarte de blocare sau de lipsă de răspuns pentru acest cont de server vor fi trimise automat. Puteți modifica oricând această opțiune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все ожидающие отчёты, а также будущие отчёты о сбоях и зависаниях для этого аккаунта на сервере будут отправляться автоматически. Вы можете изменить это в любой момент."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky čakajúce hlásenia a budúce hlásenia o zlyhaní alebo zamrznutí pre tento účet na serveri sa budú odosielať automaticky. Môžete to kedykoľvek zmeniť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsa čakajoča poročila ter prihodnja poročila o zrušitvah in zamrznitvah za ta račun na strežniku bodo poslana samodejno. To lahko kadar koli spremenite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väntande rapporter och framtida krasch- och frysrapporter för det här serverkontot skickas automatiskt. Du kan ändra detta när som helst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบบจะส่งรายงานที่รอดำเนินการทั้งหมดและรายงานข้อขัดข้องหรือการค้างในอนาคตสำหรับบัญชีเซิร์ฟเวอร์นี้โดยอัตโนมัติ คุณเปลี่ยนการตั้งค่านี้ได้ทุกเมื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucu hesabına ait bekleyen tüm raporlar ile gelecekteki kilitlenme ve donma raporları otomatik olarak gönderilecek. Bunu istediğiniz zaman değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі звіти в черзі та майбутні звіти про збої й зависання для цього облікового запису на сервері надсилатимуться автоматично. Ви можете будь-коли змінити це налаштування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi báo cáo đang chờ và các báo cáo sự cố hoặc treo ứng dụng sau này cho tài khoản máy chủ này sẽ được gửi tự động. Bạn có thể thay đổi tùy chọn này bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有待发送的报告以及此服务器账户今后的崩溃或无响应报告将自动发送。你可以随时更改此设置项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此伺服器帳號所有待傳送的報告，以及日後的當機或無回應報告，都會自動傳送。你可以隨時變更此設定。"
          }
        }
      }
    },
