    "tvPair.approval.anotherAccountMessage" : {
      "comment" : "Apple (iPhone, iPad) device approval card: message of the \"Approve as another account?\" dialog. {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر حساب %1$@ الذي ستوافق به. تبقى الحسابات على هذا الجهاز مسجّلة الدخول، ويبقى الرمز جاهزًا للموافقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете с кой акаунт в сървъра %1$@ да се одобри. Акаунтите на това устройство остават с активен вход, а кодът остава готов за одобрение."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria amb quin compte del servidor %1$@ vols aprovar-ho. Els comptes d’aquest dispositiu continuen amb la sessió iniciada, i el codi continua a punt per aprovar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte účet na serveru %1$@, kterým přihlášení schválíte. Účty na tomto zařízení zůstanou přihlášené a kód zůstane připravený ke schválení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvilken %1$@-konto du vil godkende med. Konti på denne enhed forbliver logget ind, og koden er stadig klar til godkendelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, mit welchem %1$@-Konto du genehmigst. Die Konten auf diesem Gerät bleiben angemeldet, und der Code kann weiterhin genehmigt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε με ποιον λογαριασμό του διακομιστή %1$@ θα γίνει η έγκριση. Οι λογαριασμοί σε αυτή τη συσκευή παραμένουν συνδεδεμένοι και ο κωδικός παραμένει έτοιμος για έγκριση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which %1$@ account to approve with. Accounts on this device stay signed in, and the code stays ready to approve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige con qué cuenta de %1$@ aprobar. Las cuentas de este dispositivo siguen con la sesión iniciada y el código sigue listo para aprobarse."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valige, millise serveri %1$@ kontoga kinnitada. Selle seadme kontod jäävad sisselogituks ja kood jääb kinnitamiseks valmis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, millä palvelimen %1$@ tilillä hyväksyt. Tämän laitteen tilit pysyvät kirjautuneina, ja koodi odottaa yhä hyväksyntää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le compte %1$@ avec lequel approuver. Les comptes de cet appareil restent connectés, et le code reste prêt à être approuvé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבחור עם איזה חשבון בשרת %1$@ לאשר. החשבונות במכשיר הזה יישארו מחוברים, והקוד יישאר זמין לאישור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि %1$@ के किस खाते से मंज़ूरी देनी है। इस डिवाइस पर मौजूद खाते साइन इन रहेंगे, और कोड मंज़ूरी के लिए तैयार रहेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite kojim ćete računom na poslužitelju %1$@ odobriti prijavu. Računi na ovom uređaju ostaju prijavljeni, a kôd ostaje spreman za odobrenje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki, melyik fiókkal hagyja jóvá a(z) %1$@ szerveren. Az ezen az eszközön lévő fiókok bejelentkezve maradnak, a kód pedig jóváhagyásra készen marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih akun %1$@ yang akan digunakan untuk menyetujui. Akun di perangkat ini tetap masuk, dan kode tetap siap untuk disetujui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli con quale account di %1$@ approvare. Gli account su questo dispositivo restano connessi e il codice resta pronto per l’approvazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認に使用する%1$@のアカウントを選択してください。このデバイスのアカウントはサインインしたままで、コードも承認できる状態のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인에 사용할 %1$@ 서버 계정을 선택하세요. 이 기기의 계정은 로그인 상태로 유지되고, 코드도 계속 승인할 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkite, kuria serverio %1$@ paskyra patvirtinti. Šiame įrenginyje esančios paskyros liks prisijungusios, o kodas liks paruoštas patvirtinti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvēlieties, ar kuru servera %1$@ kontu apstiprināt. Šīs ierīces konti paliks pierakstīti, un kods paliks gatavs apstiprināšanai."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih akaun pelayan %1$@ yang akan digunakan untuk meluluskan. Akaun pada peranti ini kekal log masuk, dan kod kekal sedia untuk diluluskan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hvilken %1$@-konto du vil godkjenne med. Kontoene på denne enheten forblir pålogget, og koden er fortsatt klar til godkjenning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies met welk %1$@-account je goedkeurt. Accounts op dit apparaat blijven ingelogd en de code blijft klaar om goed te keuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz konto na serwerze %1$@, którym chcesz zatwierdzić logowanie. Konta na tym urządzeniu pozostaną zalogowane, a kod nadal będzie czekać na zatwierdzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha com qual conta de %1$@ aprovar. As contas neste dispositivo continuam conectadas, e o código continua pronto para aprovação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha com que conta do servidor %1$@ vai aprovar. As contas neste dispositivo mantêm a sessão iniciada e o código continua pronto para aprovar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți contul de pe serverul %1$@ cu care aprobați. Conturile de pe acest dispozitiv rămân conectate, iar codul rămâne gata de aprobare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите аккаунт на сервере «%1$@» для подтверждения. Вход в аккаунты на этом устройстве сохранится, а код останется готовым к подтверждению."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte účet na serveri %1$@, ktorým chcete prihlásenie schváliť. Účty v tomto zariadení zostanú prihlásené a kód zostane pripravený na schválenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izberite račun na strežniku %1$@, s katerim boste odobrili prijavo. Računi v tej napravi ostanejo prijavljeni, koda pa ostane pripravljena za odobritev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj vilket konto på %1$@ du vill godkänna med. Konton på den här enheten förblir inloggade, och koden är fortfarande redo att godkännas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกบัญชีของเซิร์ฟเวอร์ %1$@ ที่จะใช้อนุมัติ บัญชีในอุปกรณ์นี้จะยังคงลงชื่อเข้าใช้อยู่ และรหัสจะยังพร้อมให้อนุมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hangi %1$@ hesabıyla onaylanacağını seçin. Bu cihazdaki hesapların oturumu açık kalır ve kod onaylanmaya hazır bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть обліковий запис на сервері %1$@, з яким потрібно схвалити вхід. Облікові записи на цьому пристрої залишаться в системі, а код і далі чекатиме на схвалення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn tài khoản trên máy chủ %1$@ để phê duyệt. Các tài khoản trên thiết bị này vẫn được đăng nhập và mã vẫn sẵn sàng để phê duyệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择用哪个%1$@账户批准。此设备上的账户会保持登录，代码也会继续等待批准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇要用哪個 %1$@ 帳號核准。此裝置上的帳號會保持登入，代碼也仍可供核准。"
          }
        }
      }
    },
    "tvPair.approval.anotherAccountTitle" : {
      "comment" : "Apple (iPhone, iPad) Sign in a TV approval card: title of the dialog opened by \"Not you?\", to approve the TV with a different account.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموافقة باستخدام حساب آخر؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да се одобри ли с друг акаунт?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols aprovar-ho amb un altre compte?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schválit jiným účtem?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkend som en anden konto?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem anderen Konto genehmigen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έγκριση με άλλον λογαριασμό;"
          }
        },
        "en" : {
