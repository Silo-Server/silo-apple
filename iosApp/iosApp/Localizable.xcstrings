          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code appartient à %1$@, et vous n’y êtes pas connecté ici. Connectez-vous pour approuver."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקוד הזה שייך לשרת %1$@, ואין כאן התחברות אליו. יש להתחבר כדי לאשר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह कोड सर्वर %1$@ का है, और आपने यहाँ उसमें साइन इन नहीं किया है। मंज़ूरी देने के लिए साइन इन करें।"
