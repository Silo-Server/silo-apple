          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вилучає налаштування, змінені на цьому Apple TV, щоб він знову використовував налаштування вашого профілю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa các cài đặt đã thay đổi trên Apple TV này để thiết bị dùng lại cài đặt hồ sơ của bạn."
          }
        },
        "zh-Hans" : {
