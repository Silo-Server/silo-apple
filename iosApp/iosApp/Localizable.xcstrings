    "settings.skipIntervals.footerAudiobook" : {
      "comment" : "Android phone and TV. Phone: footer under the audiobook skip intervals group on Settings → Playback. TV: Settings > Playback > Audiobooks: help text under the audiobook skip intervals. Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: footer under the audiobook skip intervals.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدمها أزرار التخطي في مشغّل الكتب الصوتية. تنطبق على كل جهاز مسجّل الدخول إلى هذا الملف الشخصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betrifft die Sprungtasten des Hörbuch-Players. Gilt für alle Geräte, die mit diesem Profil angemeldet sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used by the audiobook player's skip buttons. Applies to every device signed in to this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa con los botones de salto del reproductor de audiolibros. Se aplica a todos los dispositivos con sesión iniciada en este perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisés par les boutons de saut du lecteur de livres audio. S’appliquent à tous les appareils connectés à ce profil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオブックプレーヤーのスキップボタンで使用します。このプロフィールでサインインしているすべてのデバイスに適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usados pelos botões de salto do player de audiolivros. Valem para todos os dispositivos conectados a este perfil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于有声书播放器的跳转按钮。适用于登录此个人资料的所有设备。"
          }
        }
      }
    },
    "settings.skipIntervals.footerVideoApple" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad): footer under the Video skip intervals.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدمها أزرار التخطي على الشاشة والنقر المزدوج ومفاتيح الأسهم ونقرات جهاز التحكم عن بُعد. تنطبق على كل جهاز مسجّل الدخول إلى هذا الملف الشخصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betrifft die Sprungtasten auf dem Bildschirm, Doppeltippen, Pfeiltasten und Klicks auf der Fernbedienung. Gilt für alle Geräte, die mit diesem Profil angemeldet sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used by the on-screen skip buttons, double-tap, arrow keys, and remote clicks. Applies to every device signed in to this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa con los botones de salto en pantalla, el doble toque, las teclas de flecha y los clics del control remoto. Se aplica a todos los dispositivos con sesión iniciada en este perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisés par les boutons de saut à l’écran, le double appui, les touches fléchées et les clics de la télécommande. S’appliquent à tous les appareils connectés à ce profil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面上のスキップボタン、ダブルタップ、矢印キー、リモコンのクリックで使用します。このプロフィールでサインインしているすべてのデバイスに適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usados pelos botões de salto na tela, pelo toque duplo, pelas teclas de seta e pelos cliques do controle remoto. Valem para todos os dispositivos conectados a este perfil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于屏幕上的跳转按钮、双击、方向键和遥控器点按。适用于登录此个人资料的所有设备。"
          }
        }
      }
    },
