    "settingsManifest.ui.text_weight.description" : {
      "comment" : "Help text under the ui.text_weight setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام نص أثقل في الواجهة لتسهيل القراءة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използване на по-плътен текст в интерфейса за по-добра четливост."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza un text de la interfície més gruixut per llegir-lo millor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro lepší čitelnost použít tučnější text rozhraní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug kraftigere tekst i brugerfladen for bedre læsbarhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräftigeren Text in der Oberfläche für bessere Lesbarkeit verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρήση εντονότερου κειμένου στη διεπαφή για καλύτερη αναγνωσιμότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use heavier interface text for readability."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un texto de interfaz más grueso para facilitar la lectura."
          }
        },
        "et" : {
