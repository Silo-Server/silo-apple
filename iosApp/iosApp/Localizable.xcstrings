    "watchParty.hint.noVotes" : {
      "comment" : "Roku: hint line in the voting lobby when there are suggestions but no votes. Apple (iPhone, iPad, Apple TV): same hint under the lobby's buttons. Android phone and TV Watch Party lobby: same line under the host's buttons.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يصوّت أحد بعد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím nikdo nehlasoval."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen har stemt endnu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch hat niemand abgestimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody has voted yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie ha votado todavía."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukaan ei ole vielä äänestänyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne n’a encore voté."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još nitko nije glasao."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno ha ancora votato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ誰も投票していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 아무도 투표하지 않았어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen har stemt ennå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er heeft nog niemand gestemd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ma jeszcze głosów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém votou ainda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока никто не проголосовал."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen har röstat än."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz kimse oy vermedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосів ще немає."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有人投票。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有人投票。"
          }
        }
      }
    },
    "watchParty.hint.notReady.moreNames" : {
      "comment" : "Roku: hint line shown to the host when three or more members are not ready. {first}: name of one such member; {second}: name of another; 'and others' covers the rest. Apple (iPhone, iPad, Apple TV): same hint under the lobby's buttons. Android phone and TV Watch Party lobby: same line under the host's buttons. 1 and 2: the first two guests' names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعلن %1$@ و%2$@ وآخرون جاهزيتهم. لا يزال بإمكانك البدء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uživatelé %1$@, %2$@ a další ještě nejsou připraveni. Přesto můžete začít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ og andre har ikke meldt sig klar. Du kan stadig starte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ und weitere sind noch nicht bereit. Du kannst trotzdem starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ and %2$@ and others haven't marked ready. You can still start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ y otras personas todavía no han marcado “Listo”. Aun así puedes iniciar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ ja muut eivät ole merkinneet olevansa valmiina. Voit silti aloittaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ et d’autres n’ont pas signalé leur disponibilité. Vous pouvez quand même lancer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osobe %1$@, %2$@ i ostale još nisu označile da su spremne. Svejedno možete pokrenuti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ e altri ospiti non hanno ancora confermato. Puoi avviare comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、%2$@ほか数名が準備完了にしていません。このまま開始することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@님, %2$@님 외 여러 명이 아직 준비 완료를 표시하지 않았어요. 그래도 시작할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ og andre har ikke markert seg som klare. Du kan likevel starte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ en anderen hebben zich niet klaar gemeld. Je kunt toch starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ i inne osoby nie zgłaszają gotowości. Możesz mimo to zacząć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ e outras pessoas ainda não marcaram “Pronto”. Mesmo assim, você pode iniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не готовы: %1$@, %2$@ и другие. Вы всё равно можете начать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ och andra har inte markerat att de är redo. Du kan ändå starta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ ve diğerleri hazır olduğunu belirtmedi. Yine de başlatabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ та інші: готовність ще не позначено. Ви все одно можете почати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、%2$@等人尚未标记为准备就绪。你仍可以开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、%2$@ 和其他人尚未標記為準備就緒。你仍然可以開始。"
          }
        }
      }
    },
