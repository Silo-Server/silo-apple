    "player.seekInterval.saveConnectionAudiobookFastForward" : {
      "comment" : "Apple iOS/tvOS/macOS: skip interval settings (Playback settings and the audiobook player); error when saving failed on the network while saving the audiobook skip forward interval.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر حفظ فاصل التقديم للكتاب الصوتي. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Vorspulintervall für Hörbücher konnte nicht gespeichert werden. Prüfe die Verbindung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't save the audiobook fast-forward interval. Check the connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar el intervalo de avance rápido del audiolibro. Comprueba la conexión y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer l’intervalle d’avance rapide des livres audio. Vérifiez la connexion et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオブックの早送り間隔を保存できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar o intervalo de avanço do audiolivro. Verifique a conexão e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存有声书快进间隔。请检查网络连接，然后重试。"
          }
        }
      }
    },
