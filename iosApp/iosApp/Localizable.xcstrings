    "settings.privacyPolicy.scanPrompt" : {
      "comment" : "Apple TV Settings: text beside the QR code that opens Silo's privacy policy (Apple TV has no web browser).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح هذا الرمز بهاتفك أو جهازك اللوحي لقراءة سياسة خصوصية Silo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte tento kód telefonem nebo tabletem a přečtěte si zásady ochrany osobních údajů aplikace Silo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan denne kode med din telefon eller tablet for at læse Silos privatlivspolitik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne diesen Code mit deinem Smartphone oder Tablet, um die Datenschutzerklärung von Silo zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan this code with your phone or tablet to read Silo's privacy policy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea este código con tu teléfono o tableta para leer la política de privacidad de Silo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lue Silon tietosuojakäytäntö skannaamalla tämä koodi puhelimella tai tabletilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez ce code avec votre téléphone ou votre tablette pour lire la politique de confidentialité de Silo."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenirajte ovaj kôd telefonom ili tabletom da biste pročitali Silova pravila o privatnosti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona questo codice con il telefono o il tablet per leggere l’informativa sulla privacy di Silo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンやタブレットでこのコードをスキャンすると、Siloのプライバシーポリシーを読めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰이나 태블릿으로 이 코드를 스캔해 Silo 개인정보 처리방침을 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skann denne koden med telefonen eller nettbrettet ditt for å lese Silos personvernerklæring."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan deze code met je telefoon of tablet om het privacybeleid van Silo te lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj ten kod telefonem lub tabletem, aby przeczytać politykę prywatności Silo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia este código com seu celular ou tablet para ver a política de privacidade do Silo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте этот код телефоном или планшетом, чтобы прочитать политику конфиденциальности Silo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanna koden med din telefon eller surfplatta för att läsa Silos integritetspolicy."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo’nun gizlilik politikasını okumak için bu kodu telefonunuz veya tabletinizle tarayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відскануйте цей код телефоном або планшетом, щоб прочитати політику конфіденційності Silo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手机或平板电脑扫描此二维码，阅读Silo的隐私政策。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用你的手機或平板電腦掃描此 QR 碼，即可閱讀 Silo 的隱私權政策。"
          }
        }
      }
    },
