    "newProfile.requestsAllowed" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): switch on the New Profile form that lets the profile request titles that are not in the library.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح بالطلبات"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfragen erlauben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow requests"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir solicitudes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser les demandes"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストを許可"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir solicitações"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许请求"
          }
        }
      }
    },
    "newProfile.requestsAllowedHelp" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): help text under the Allow requests switch on the New Profile form.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لهذا الملف الشخصي تصفح العناوين غير الموجودة في المكتبة وطلبها. يقيّد التصنيف العمري هذه العناوين وفق تصنيفها الأمريكي فقط، ولا ينطبق عليها حد العمر الإرشادي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt diesem Profil, Titel zu durchsuchen, die nicht in der Mediathek sind, und sie anzufragen. Die Altersfreigabe begrenzt diese Titel nur anhand ihrer US-Freigabe, und die Altersempfehlung gilt für sie nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets this profile browse titles that are not in the library and request them. The content rating limits those titles by their US rating only, and the advisory-age limit does not apply to them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que este perfil explore títulos que no están en la biblioteca y los solicite. La clasificación por edad limita esos títulos solo según su clasificación de EE. UU., y el límite de edad recomendada no se aplica a ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à ce profil de parcourir les titres absents de la bibliothèque et de les demander. La classification par âge ne limite ces titres que selon leur classification américaine, et la limite d’âge conseillé ne s’applique pas à eux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリにないタイトルをこのプロフィールで閲覧し、リクエストできるようにします。これらのタイトルには、年齢制限は米国の年齢制限によってのみ適用され、推奨年齢による制限は適用されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que este perfil explore títulos que não estão na biblioteca e os solicite. A classificação indicativa limita esses títulos apenas pela classificação dos EUA, e o limite de idade recomendada não se aplica a eles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许此个人资料浏览不在媒体库中的作品并请求它们。年龄分级仅按美国分级限制这些作品，建议年龄限制不适用于它们。"
          }
        }
      }
    },
