          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З’єднання із сервером втрачено до завершення епізоду."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mất kết nối với máy chủ trước khi tập kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本集播放结束前与服务器的连接已断开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這一集播完前，與伺服器的連線中斷了。"
          }
        }
      }
    },
