    "companion.progressPosition" : {
      "comment" : "Phone/tablet progress suffix showing the current step in a series. {label}: the step text; {position}: the current number; {total}: the total number. Apple (iPhone, iPad): same progress line on the nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
