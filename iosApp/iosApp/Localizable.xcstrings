            "state" : "translated",
            "value" : "끄고 삭제"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išjungti ir ištrinti"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izslēgt un dzēst"
          }
        },
        "ms" : {
          "stringUnit" : {
