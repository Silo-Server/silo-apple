    "account.error.diagnosticsCleanupFailed" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message in the Account Update alert when the sign-out finished but the diagnostics saved on the device couldn't be erased. Settings > Accounts names the settings page where servers are removed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تسجيل خروجك، لكن تعذّر على Silo مسح بيانات التشخيص المحلية. أزل هذا الخادم من الإعدادات ← الحسابات لإعادة محاولة المسح."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Излязохте от акаунта, но Silo не можа да изтрие локалните диагностични данни. Премахнете този сървър в „Настройки > Акаунти“, за да опитате почистването отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has tancat la sessió, però Silo no ha pogut esborrar els diagnòstics locals. Elimina aquest servidor a Configuració > Comptes per tornar a provar la neteja."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odhlášení proběhlo, ale Silo nemohlo vymazat místní diagnostická data. Úklid zopakujete tak, že tento server odeberete v Nastavení > Účty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er logget ud, men Silo kunne ikke slette lokale diagnosticeringsdata. Fjern denne server under Indstillinger > Konti for at prøve oprydningen igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist abgemeldet, aber Silo konnte die lokalen Diagnosedaten nicht löschen. Entferne diesen Server unter Einstellungen > Konten, um die Bereinigung erneut zu versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποσυνδεθήκατε, αλλά το Silo δεν μπόρεσε να διαγράψει τα τοπικά διαγνωστικά δεδομένα. Αφαιρέστε αυτόν τον διακομιστή από τις Ρυθμίσεις > Λογαριασμοί για να επαναληφθεί η εκκαθάριση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're signed out, but Silo couldn't erase local diagnostics. Remove this server in Settings > Accounts to retry cleanup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerró tu sesión, pero Silo no pudo borrar los diagnósticos locales. Quita este servidor en Configuración > Cuentas para volver a intentar la limpieza."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olete välja logitud, kuid Silo ei saanud kohalikke diagnostikaandmeid kustutada. Puhastamise uuesti proovimiseks eemaldage see server jaotises „Seaded > Kontod“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet kirjautunut ulos, mutta Silo ei voinut poistaa paikallisia diagnostiikkatietoja. Yritä siivousta uudelleen poistamalla tämä palvelin kohdassa Asetukset > Tilit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La déconnexion a réussi, mais Silo n’a pas pu effacer les diagnostics locaux. Retirez ce serveur dans Paramètres > Comptes pour relancer le nettoyage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההתנתקות הושלמה, אבל לא ניתן היה למחוק את נתוני האבחון המקומיים. כדי לנסות שוב את הניקוי, יש להסיר את השרת הזה בהגדרות ← חשבונות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने साइन आउट कर दिया है, लेकिन Silo स्थानीय डायग्नोस्टिक्स नहीं मिटा सका। सफ़ाई फिर से करने के लिए सेटिंग > खाते में यह सर्वर हटाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odjavljeni ste, ali Silo nije mogao izbrisati lokalnu dijagnostiku. Uklonite ovaj poslužitelj u „Postavke > Računi“ da biste ponovno pokušali čišćenje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijelentkezett, de a Silo nem tudta törölni a helyi diagnosztikai adatokat. A törlés újbóli megkíséreléséhez távolítsa el ezt a szervert a Beállítások > Fiókok menüben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sudah keluar, tetapi Silo tidak dapat menghapus data diagnostik lokal. Hapus server ini di Pengaturan > Akun untuk mencoba pembersihan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnessione eseguita, ma Silo non è riuscito a cancellare i dati diagnostici locali. Rimuovi questo server in Impostazioni > Account per riprovare la pulizia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインアウトしましたが、Siloはローカルの診断データを消去できませんでした。もう一度消去するには、設定 > アカウントでこのサーバーを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그아웃했지만 Silo에서 기기에 저장된 진단 정보를 지우지 못했어요. 설정 > 계정에서 이 서버를 제거해 정리를 다시 시도하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atsijungėte, bet „Silo“ nepavyko ištrinti vietinių diagnostikos duomenų. Pašalinkite šį serverį skiltyje „Nustatymai > Paskyros“, kad bandytumėte išvalyti dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūs izrakstījāties, taču Silo neizdevās izdzēst lokālos diagnostikas datus. Lai mēģinātu notīrīt vēlreiz, noņemiet šo serveri sadaļā „Iestatījumi > Konti”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sudah log keluar, tetapi Silo tidak dapat memadamkan diagnostik setempat. Alih keluar pelayan ini dalam Tetapan > Akaun untuk mencuba pembersihan semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er logget ut, men Silo kunne ikke slette lokal diagnostikk. Fjern denne serveren i Innstillinger > Kontoer for å prøve oppryddingen på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent uitgelogd, maar Silo kan de lokale diagnostische gegevens niet wissen. Verwijder deze server in Instellingen > Accounts om het opruimen opnieuw te proberen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wylogowano, ale nie udało się usunąć lokalnych danych diagnostycznych. Usuń ten serwer w Ustawienia > Konta, aby ponowić czyszczenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você saiu da conta, mas o Silo não conseguiu apagar os diagnósticos locais. Remova este servidor em Configurações > Contas para tentar a limpeza novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão foi terminada, mas o Silo não conseguiu apagar os diagnósticos locais. Remova este servidor em Definições > Contas para tentar novamente a limpeza."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V-ați deconectat, dar Silo nu a putut șterge diagnosticele locale. Eliminați acest server din Setări > Conturi pentru a reîncerca curățarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы вышли из аккаунта, но Silo не удалось стереть локальные диагностические данные. Удалите этот сервер в разделе «Настройки > Аккаунты», чтобы повторить очистку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odhlásenie prebehlo, ale miestnu diagnostiku sa nepodarilo vymazať. Ak chcete vyčistenie zopakovať, odstráňte tento server v časti Nastavenia > Účty."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odjavljeni ste, vendar aplikacija Silo ni mogla izbrisati lokalnih diagnostičnih podatkov. Odstranite ta strežnik v razdelku Nastavitve > Računi, da znova poskusite s čiščenjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är utloggad, men Silo kunde inte radera lokal diagnostik. Ta bort servern under Inställningar > Konton för att försöka rensa igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณออกจากระบบแล้ว แต่ Silo ลบข้อมูลการวินิจฉัยในเครื่องไม่ได้ นำเซิร์ฟเวอร์นี้ออกในการตั้งค่า > บัญชี เพื่อลองล้างข้อมูลอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumunuz kapatıldı ancak Silo yerel tanılama verilerini silemedi. Temizlemeyi yeniden denemek için bu sunucuyu Ayarlar > Hesaplar’da kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви вийшли, але Silo не вдалося стерти локальну діагностику. Вилучіть цей сервер у розділі Налаштування > Облікові записи, щоб повторити очищення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã đăng xuất, nhưng Silo không thể xóa dữ liệu chẩn đoán cục bộ. Hãy gỡ máy chủ này trong Cài đặt > Tài khoản để thử dọn dẹp lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已退出登录，但Silo无法清除本地诊断数据。请在设置 > 账户中移除此服务器以重新清理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已登出，但 Silo 無法清除本機的診斷資料。請在「設定 > 帳號」中移除這部伺服器，以重新清除。"
          }
        }
      }
    },
