    "settings.general.deviceOverrideFooterTv" : {
      "comment" : "Apple TV Settings > General: explanation under Use Synced TV Settings. TV-family choices are the settings shared by the profile's TVs.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لدى جهاز Apple TV هذا إعدادات قديمة خاصة بالجهاز. امسحها لاستخدام خيارات أجهزة التلفزيون المشتركة في هذا الملف الشخصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Apple TV hat ältere gerätespezifische Einstellungen. Lösche sie, um die Einstellungen zu verwenden, die dieses Profil mit seinen Fernsehern teilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Apple TV has older device-specific settings. Clear them to use the TV-family choices shared by this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Apple TV tiene configuraciones antiguas propias del dispositivo. Bórralas para usar las opciones de TV compartidas por este perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette Apple TV a d’anciens paramètres propres à l’appareil. Effacez-les pour utiliser les choix partagés par les TV de ce profil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVには古いデバイス固有の設定があります。クリアすると、このプロフィールのテレビ共通の設定を使用します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta Apple TV tem configurações antigas específicas do dispositivo. Limpe-as para usar as opções da família de TVs compartilhadas por este perfil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此Apple TV有旧的设备专属设置。清除这些设置即可使用此个人资料在各电视设备间共享的选项。"
          }
        }
      }
    },
