        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh auf dem Fernseher nach. Diese Anzeige wird aktualisiert, sobald %1$@ es bestätigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the TV. This updates when %1$@ confirms it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa la TV. Esto se actualizará cuando %1$@ lo confirme."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista tv. Tämä päivittyy, kun palvelin %1$@ vahvistaa sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez la TV. Cet écran se met à jour dès que %1$@ confirme l’approbation."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjerite TV. Ovo će se ažurirati kada poslužitelj %1$@ potvrdi odobrenje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la TV. Questa schermata si aggiorna quando il server %1$@ conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テレビを確認してください。%1$@が確認すると、この表示が更新されます。"
