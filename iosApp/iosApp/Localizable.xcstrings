        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каталог не прийняв це ім’я користувача й пароль."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch vụ thư mục không chấp nhận tên người dùng và mật khẩu đó."
          }
        },
        "zh-Hans" : {
