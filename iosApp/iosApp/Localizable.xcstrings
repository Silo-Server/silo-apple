          "stringUnit" : {
            "state" : "translated",
            "value" : "This can take up to half a minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto puede tardar hasta medio minuto."
          }
        },
