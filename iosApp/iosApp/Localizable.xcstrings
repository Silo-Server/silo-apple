    "upNext.startFailed" : {
      "comment" : "Apple iOS: Up Next screen when the next episode failed to start.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر بدء الحلقة التالية. حاول مرة أخرى أو ارجع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можа да се пусне следващият епизод. Опитайте отново или се върнете назад."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut iniciar l’episodi següent. Torna-ho a provar o torna enrere."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se spustit další díl. Zkuste to znovu, nebo se vraťte zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke starte næste afsnit. Prøv igen, eller gå tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nächste Folge konnte nicht gestartet werden. Versuche es erneut oder gehe zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η έναρξη του επόμενου επεισοδίου. Δοκιμάστε ξανά ή επιστρέψτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't start the next episode. Try again or go back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo iniciar el siguiente episodio. Vuelve a intentarlo o vuelve atrás."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järgmise osa käivitamine ebaõnnestus. Proovige uuesti või minge tagasi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraavan jakson aloittaminen epäonnistui. Yritä uudelleen tai palaa takaisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lancer l’épisode suivant. Réessayez ou revenez en arrière."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה להפעיל את הפרק הבא. אפשר לנסות שוב או לחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगला एपिसोड शुरू नहीं किया जा सका। फिर से कोशिश करें या वापस जाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće pokrenuti sljedeću epizodu. Pokušajte ponovno ili se vratite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült elindítani a következő epizódot. Próbálja újra, vagy lépjen vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat memulai episode berikutnya. Coba lagi atau kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile avviare il prossimo episodio. Riprova o torna indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のエピソードを開始できませんでした。もう一度お試しいただくか、戻ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 에피소드를 시작할 수 없어요. 다시 시도하거나 뒤로 돌아가세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko paleisti kito epizodo. Bandykite dar kartą arba grįžkite."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās sākt nākamo epizodi. Mēģiniet vēlreiz vai atgriezieties."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat memulakan episod seterusnya. Cuba lagi atau kembali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke starte neste episode. Prøv igjen eller gå tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de volgende aflevering niet starten. Probeer het opnieuw of ga terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się uruchomić następnego odcinka. Spróbuj ponownie lub wróć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar o próximo episódio. Tente novamente ou volte."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar o episódio seguinte. Tente novamente ou volte atrás."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a putut porni episodul următor. Încercați din nou sau reveniți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось запустить следующую серию. Повторите попытку или вернитесь назад."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa spustiť ďalšiu epizódu. Skúste to znova alebo sa vráťte späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni bilo mogoče začeti predvajanja naslednje epizode. Poskusite znova ali se vrnite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att starta nästa avsnitt. Försök igen eller gå tillbaka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มเล่นตอนถัดไปไม่ได้ โปรดลองอีกครั้งหรือย้อนกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonraki bölüm başlatılamadı. Tekrar deneyin veya geri dönün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося запустити наступний епізод. Спробуйте ще раз або поверніться назад."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể bắt đầu tập tiếp theo. Vui lòng thử lại hoặc quay lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法开始播放下一集。请重试或返回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開始播放下一集。請再試一次，或返回。"
          }
        }
      }
    },
