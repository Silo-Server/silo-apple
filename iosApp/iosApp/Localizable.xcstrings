    "diagnostics.alwaysSend.settingsMessage" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) > Crash Reports: message of the confirmation for choosing Always.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُرسل أي تقارير معلّقة وتقارير الأعطال أو التجمّد المستقبلية لحساب الخادم هذا تلقائيًا. يمكنك تغيير ذلك في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle ausstehenden Berichte sowie künftige Berichte zu Abstürzen und Hängern für dieses Serverkonto werden automatisch gesendet. Du kannst das jederzeit ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any pending reports and future crash or hang reports for this server account will be sent automatically. You can change this at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los informes pendientes y los futuros informes de fallos o bloqueos de esta cuenta del servidor se enviarán automáticamente. Puedes cambiar esto en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rapports en attente et les futurs rapports de plantage ou de blocage de ce compte serveur seront envoyés automatiquement. Vous pouvez modifier ce choix à tout moment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留中のレポートと、このサーバーアカウントの今後のクラッシュレポートおよびハングレポートは自動的に送信されます。この設定はいつでも変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os relatórios pendentes e os futuros relatórios de falhas ou travamentos desta conta do servidor serão enviados automaticamente. Você pode alterar isso a qualquer momento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有待发送的报告以及此服务器账户今后的崩溃或无响应报告将自动发送。你可以随时更改此设置项。"
          }
        }
      }
    },
