        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používa sa jazyk titulkov, správanie zobrazenia, predvoľba CC/SDH, písmo, farby, nepriehľadnosť, okraje, veľkosť a okno titulkov tohto zariadenia z cesty Prístupnosť → Titulky a skryté titulky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledi jeziku napisov, načinu prikaza, nastavitvi CC/SDH, pisavi, barvam, prekrivnosti, robovom, velikosti in oknu napisov te naprave iz razdelka Dostopnost → Podnapisi in napisi."
