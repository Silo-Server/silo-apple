          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei voinut poistaa tallennettua palvelinta. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a pas pu retirer le serveur enregistré. Réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה להסיר את השרת השמור ב-Silo. אפשר לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo सेव किया गया सर्वर नहीं हटा सका। कृपया फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nije uspio ukloniti spremljeni poslužitelj. Pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
