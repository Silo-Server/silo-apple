    "upNext.shuffleContinueFailed" : {
      "comment" : "Notice shown when the app failed to continue the shuffle to the next item, on Roku, Android phone and TV, and in the web player's shuffle Playing Next screen. On Apple iOS, tvOS and macOS it appears in the Up Next panel during shuffle when the next item could not be fetched.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر متابعة التشغيل العشوائي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se pokračovat v náhodném přehrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke fortsætte den blandede afspilning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zufallswiedergabe konnte nicht fortgesetzt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't continue the shuffle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo continuar la reproducción aleatoria."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satunnaistoiston jatkaminen epäonnistui."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de poursuivre la lecture aléatoire."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće nastaviti nasumičnu reprodukciju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile continuare la riproduzione casuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シャッフルを続行できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셔플을 계속할 수 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke fortsette tilfeldig avspilling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de shuffle niet voortzetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się kontynuować odtwarzania losowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível continuar a reprodução aleatória."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось продолжить случайное воспроизведение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att fortsätta blanda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karıştırmaya devam edilemedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося продовжити перемішування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法继续随机播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法繼續隨機播放。"
          }
        }
      }
    },
    "upNext.shuffleDone" : {
      "comment" : "Message on the Roku and Android TV Up Next panels when no remaining item in the current shuffle can be played. Apple iOS/tvOS: message on the player's Up Next screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد شيء آخر قابل للتشغيل في هذا التشغيل العشوائي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tomto náhodném přehrávání už nelze nic dalšího přehrát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet andet i den blandede afspilning kan afspilles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Zufallswiedergabe kann nichts weiter abgespielt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing else in this shuffle can play."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No queda nada más que se pueda reproducir en esta reproducción aleatoria."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä satunnaistoistossa ei ole enää mitään toistettavaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus rien ne peut être lu dans cette lecture aléatoire."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U ovoj nasumičnoj reprodukciji nema više ničega što se može reproducirati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun altro titolo di questa riproduzione casuale è riproducibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このシャッフルで再生できる作品はもうありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 셔플에서 더 재생할 수 있는 항목이 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting annet i denne tilfeldige avspillingen kan spilles av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kan niets meer uit deze shuffle worden afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tym odtwarzaniu losowym nie ma już nic do odtworzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada mais nesta reprodução aleatória pode ser reproduzido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом случайном воспроизведении больше нечего показать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget mer i den slumpvisa uppspelningen kan spelas upp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu karıştırmada oynatılabilecek başka bir şey kalmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цьому перемішуванні більше нічого не можна відтворити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此次随机播放中没有其他可播放的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這次隨機播放中已沒有其他可播放的內容。"
          }
        }
      }
    },
    "upNext.shuffling" : {
      "comment" : "Badge shown during shuffle on the Up Next panel (Roku, Android phone and TV), the web player's Playing Next screen, and the Apple iOS and tvOS player's Up Next screen. {scope}: what is being shuffled, such as a show or library name.",
