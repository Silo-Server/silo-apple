        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ จะเริ่ม %2$@ เมื่อการโหวตได้ข้อสรุป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oylama netleşince %1$@, %2$@ içeriğini başlatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ запустить %2$@, коли голосування завершиться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sẽ bắt đầu %2$@ khi bình chọn kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投票结束后，%1$@将开始播放%2$@。"
