          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒体库专属的字幕设置会覆盖此个人资料默认值。此处的更改会保存到个人资料，但媒体库覆盖设置仍然生效。"
          }
        }
      }
    },
