            "state" : "translated",
            "value" : "La taille des affiches est synchronisée avec les autres tablettes de ce profil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veličina postera sinkronizira se s ostalim tabletima na ovom profilu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dimensione dei poster si sincronizza con gli altri dispositivi di tipo tablet in questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポスターのサイズは、このプロフィールのほかのタブレット系デバイスと同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포스터 크기는 이 프로필의 다른 태블릿과 동기화돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plakatstørrelsen synkroniseres med andre nettbrettlignende enheter på denne profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De postergrootte wordt gesynchroniseerd met andere tabletachtige apparaten op dit profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmiar plakatów synchronizuje się z innymi urządzeniami typu tablet w tym profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tamanho do pôster é sincronizado com outros dispositivos do tipo tablet neste perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размер постеров синхронизируется с другими планшетами в этом профиле."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affischstorleken synkroniseras med andra surfplatteliknande enheter på den här profilen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poster boyutu, bu profildeki diğer tablet türü cihazlarla eşitlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розмір постерів синхронізується з іншими пристроями на кшталт планшета в цьому профілі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海报尺寸会与此个人资料中的其他平板类设备同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
