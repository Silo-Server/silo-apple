    "settings.interface.applyToAllFooterAppleTv" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac) > Title Pages on Apple TV: footer while Apply to All Devices is on. Apple TV is the product name; keep it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عطّل «تطبيق على جميع الأجهزة» للاختيار لهذا Apple TV فقط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изключете „Прилагане за всички устройства“, за да изберете само за това Apple TV."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva Aplica a tots els dispositius per triar només per a aquest Apple TV."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li volbu nastavit jen pro toto zařízení Apple TV, vypněte možnost Použít na všech zařízeních."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå Anvend på alle enheder fra for kun at vælge for dette Apple TV."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiviere „Auf alle Geräte anwenden“, um nur für dieses Apple TV zu wählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποιήστε την επιλογή «Εφαρμογή σε όλες τις συσκευές» για να επιλέξετε μόνο για αυτό το Apple TV."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off Apply to All Devices to choose for this Apple TV only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva Aplicar a todos los dispositivos para elegir solo para este Apple TV."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui soovite valida ainult selle Apple TV jaoks, lülitage välja „Rakenda kõigile seadmetele“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista ”Kaikille laitteille” käytöstä, jos haluat valita vain tälle Apple TV:lle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez Appliquer à tous les appareils pour choisir uniquement pour cette Apple TV."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לבחור רק עבור ה-Apple TV הזה, יש לכבות את ”החלה על כל המכשירים”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ इस Apple TV के लिए चुनने के लिए “सभी डिवाइसों पर लागू करें” बंद करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isključite Primijeni na sve uređaje da biste odabrali samo za ovaj Apple TV."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha csak erre az Apple TV-re szeretné beállítani, kapcsolja ki az Alkalmazás minden eszközre lehetőséget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonaktifkan Terapkan ke semua perangkat untuk memilih hanya untuk Apple TV ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva “Applica a tutti i dispositivi” per scegliere solo per questa Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVだけで選ぶには、「すべてのデバイスに適用」をオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple TV에만 적용하려면 모든 기기에 적용을 끄세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išjunkite „Taikyti visiems įrenginiams“, kad galėtumėte pasirinkti tik šiam „Apple TV“ įrenginiui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izslēdziet opciju „Lietot visās ierīcēs”, lai izvēlētos tikai šai Apple TV ierīcei."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matikan “Guna pada semua peranti” untuk memilih bagi Apple TV ini sahaja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå av Bruk på alle enheter for å velge bare for denne Apple TV-en."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet “Op alle apparaten toepassen” uit om alleen voor deze Apple TV te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz opcję „Zastosuj na wszystkich urządzeniach”, aby wybrać tylko dla tego Apple TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative “Aplicar a todos os dispositivos” para escolher só para esta Apple TV."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative Aplicar a todos os dispositivos para escolher só para esta Apple TV."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivați Aplicare pe toate dispozitivele pentru a alege doar pentru acest Apple TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы выбрать только для этого Apple TV, выключите «Применить ко всем устройствам»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete vybrať len pre toto zariadenie Apple TV, vypnite možnosť Použiť na všetky zariadenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izklopite „Uporabi za vse naprave“, da izberete samo za ta Apple TV."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng av Tillämpa på alla enheter om du vill välja bara för denna Apple TV."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิด “ใช้กับอุปกรณ์ทั้งหมด” เพื่อเลือกสำหรับ Apple TV เครื่องนี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu Apple TV için seçmek üzere “Tüm cihazlara uygula” seçeneğini kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкніть «Застосувати до всіх пристроїв», щоб вибрати лише для цього Apple TV."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt Áp dụng cho mọi thiết bị để chọn riêng cho Apple TV này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭“应用到所有设备”即可仅为这台Apple TV单独选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉「套用至所有裝置」即可只為這台 Apple TV 設定。"
          }
        }
      }
    },
