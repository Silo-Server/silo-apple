    "settings.titleArt.title" : {
      "comment" : "Heading of the title art options on Settings → Interface (they affect title detail pages) on Android phone and Apple (iPhone, iPad, Mac). On Android TV, Settings > General: heading of the group with the title art switches for detail pages.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
