    "downloads.options.includedMediaFooter" : {
      "comment" : "Apple iOS/macOS: Download Options sheet; footer of the Included Media section.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُختار الصوت والترجمة تلقائيًا للملف المحدد. تُحفظ الترجمات المتاحة للتشغيل دون اتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аудиото и субтитрите се избират автоматично за избрания файл. Наличните субтитри се запазват за възпроизвеждане офлайн."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’àudio i els subtítols es trien automàticament per al fitxer seleccionat. Els subtítols disponibles es desen per a la reproducció sense connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvuk a titulky se pro vybraný soubor volí automaticky. Dostupné titulky se uloží pro přehrávání offline."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyd og undertekster vælges automatisk for den valgte fil. Tilgængelige undertekster gemmes til offlineafspilning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio und Untertitel werden für die gewählte Datei automatisch ausgewählt. Verfügbare Untertitel werden für die Offline-Wiedergabe gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ήχος και οι υπότιτλοι επιλέγονται αυτόματα για το επιλεγμένο αρχείο. Οι διαθέσιμοι υπότιτλοι αποθηκεύονται για αναπαραγωγή εκτός σύνδεσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio and subtitles are chosen automatically for the selected file. Available subtitles are saved for offline playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio y los subtítulos se eligen automáticamente para el archivo seleccionado. Los subtítulos disponibles se guardan para la reproducción sin conexión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heli ja subtiitrid valitakse valitud faili jaoks automaatselt. Saadaolevad subtiitrid salvestatakse võrguühenduseta esituseks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ääni ja tekstitykset valitaan automaattisesti valitulle tiedostolle. Saatavilla olevat tekstitykset tallennetaan offline-toistoa varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio et les sous-titres sont choisis automatiquement pour le fichier sélectionné. Les sous-titres disponibles sont enregistrés pour la lecture hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האודיו והכתוביות נבחרים אוטומטית לקובץ שנבחר. הכתוביות הזמינות נשמרות להפעלה במצב לא מקוון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनी गई फ़ाइल के लिए ऑडियो और सबटाइटल अपने-आप चुने जाते हैं। उपलब्ध सबटाइटल ऑफ़लाइन प्लेबैक के लिए सेव किए जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvuk i titlovi odabiru se automatski za odabranu datoteku. Dostupni titlovi spremaju se za izvanmrežnu reprodukciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazás a kiválasztott fájlhoz automatikusan választja ki a hangot és a feliratokat. Az elérhető feliratokat offline lejátszáshoz is menti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio dan subtitel dipilih secara otomatis untuk file yang dipilih. Subtitel yang tersedia disimpan untuk pemutaran offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio e sottotitoli vengono scelti automaticamente per il file selezionato. I sottotitoli disponibili vengono salvati per la riproduzione offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したファイルの音声と字幕は自動的に選択されます。利用可能な字幕はオフライン再生用に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 파일에 맞는 오디오와 자막이 자동으로 선택돼요. 사용 가능한 자막은 오프라인 재생을 위해 저장돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garso takelis ir subtitrai parenkami automatiškai pagal pasirinktą failą. Pasiekiami subtitrai išsaugomi atkūrimui be interneto ryšio."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio un subtitri atlasītajam failam tiek izvēlēti automātiski. Pieejamie subtitri tiek saglabāti atskaņošanai bezsaistē."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio dan sari kata dipilih secara automatik untuk fail yang dipilih. Sari kata yang tersedia disimpan untuk main semula luar talian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyd og undertekster velges automatisk for den valgte filen. Tilgjengelige undertekster lagres for avspilling uten nett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio en ondertitels worden automatisch gekozen voor het geselecteerde bestand. Beschikbare ondertitels worden opgeslagen om offline af te spelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dźwięk i napisy są wybierane automatycznie dla wybranego pliku. Dostępne napisy są zapisywane do odtwarzania offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O áudio e as legendas são escolhidos automaticamente para o arquivo selecionado. As legendas disponíveis são salvas para reprodução offline."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O áudio e as legendas são escolhidos automaticamente para o ficheiro selecionado. As legendas disponíveis são guardadas para reprodução offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pistele audio și subtitrările sunt alese automat pentru fișierul selectat. Subtitrările disponibile sunt salvate pentru redarea offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аудио и субтитры для выбранного файла выбираются автоматически. Доступные субтитры сохраняются для офлайн-воспроизведения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvuk a titulky sa pre vybraný súbor vyberú automaticky. Dostupné titulky sa uložia na offline prehrávanie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvok in podnapisi so za izbrano datoteko izbrani samodejno. Razpoložljivi podnapisi se shranijo za predvajanje brez povezave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljud och undertexter väljs automatiskt för den valda filen. Tillgängliga undertexter sparas för uppspelning offline."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงและคำบรรยายจะเลือกโดยอัตโนมัติสำหรับไฟล์ที่เลือก คำบรรยายที่มีอยู่จะบันทึกไว้สำหรับการเล่นแบบออฟไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses ve altyazılar, seçilen dosya için otomatik olarak seçilir. Mevcut altyazılar çevrimdışı oynatma için kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аудіо й субтитри вибираються автоматично для вибраного файлу. Доступні субтитри зберігаються для офлайн-відтворення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm thanh và phụ đề được chọn tự động cho tệp đã chọn. Các phụ đề có sẵn được lưu để phát ngoại tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统会为所选文件自动选择音频和字幕。可用字幕会一并保存，供离线播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統會為所選檔案自動選擇音訊和字幕。可用的字幕會一併儲存，供離線播放。"
          }
        }
      }
    },
