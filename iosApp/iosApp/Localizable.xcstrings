    "settingsManifest.player.audiobook_skip_back_seconds.description" : {
      "comment" : "Help text under the player.audiobook_skip_back_seconds setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الثواني للرجوع في تشغيل الكتاب الصوتي. ينطبق على الأزرار واختصارات لوحة المفاتيح والإيماءات وعناصر التحكم في الوسائط المدعومة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секунди за връщане назад при възпроизвеждане на аудиокниги. Важи за бутоните, клавишните комбинации, жестовете и поддържаните контроли за медия."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segons que retrocedeix la reproducció d’audiollibres. S’aplica als botons, les dreceres de teclat, els gestos i els controls multimèdia compatibles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet sekund, o který se při přehrávání audioknihy přeskočí zpět. Platí pro tlačítka, klávesové zkratky, gesta a podporované ovládání médií."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal sekunder, der spoles tilbage ved afspilning af lydbøger. Gælder knapper, tastaturgenveje, bevægelser og understøttede medieknapper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekunden, um die bei der Wiedergabe von Hörbüchern zurückgesprungen wird. Gilt für Schaltflächen, Tastenkürzel, Gesten und unterstützte Mediensteuerungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δευτερόλεπτα επιστροφής πίσω στην αναπαραγωγή ηχητικού βιβλίου. Ισχύει για κουμπιά, συντομεύσεις πληκτρολογίου, κινήσεις και υποστηριζόμενα στοιχεία ελέγχου πολυμέσων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seconds to skip back in audiobook playback. Applies to buttons, keyboard shortcuts, gestures, and supported media controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos que se retrocede al reproducir audiolibros. Se aplica a botones, atajos de teclado, gestos y controles multimedia compatibles."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitu sekundit audioraamatu esitusel tagasi kerida. Kehtib nuppude, kiirklahvide, žestide ja toetatud meedia juhtnuppude kohta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka monta sekuntia äänikirjan toistossa siirrytään taaksepäin. Koskee painikkeita, pikanäppäimiä, eleitä ja tuettuja mediaohjaimia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de secondes de retour en arrière lors de l’écoute d’un livre audio. S’applique aux boutons, aux raccourcis clavier, aux gestes et aux commandes multimédias compatibles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מספר השניות לדילוג אחורה בהפעלת ספר שמע. חל על כפתורים, קיצורי מקלדת, מחוות ופקדי מדיה נתמכים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑडियोबुक प्लेबैक में कितने सेकंड पीछे जाना है। यह बटन, कीबोर्ड शॉर्टकट, जेस्चर और समर्थित मीडिया कंट्रोल पर लागू होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broj sekundi za premotavanje unatrag pri reprodukciji audioknjiga. Primjenjuje se na gumbe, tipkovničke prečace, geste i podržane kontrole medija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennyi másodpercet ugrik vissza a hangoskönyv lejátszása. A gombokra, billentyűparancsokra, kézmozdulatokra és a támogatott médiavezérlőkre vonatkozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detik untuk mundur saat memutar buku audio. Berlaku untuk tombol, pintasan keyboard, gestur, dan kontrol media yang didukung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secondi da riavvolgere durante la riproduzione di un audiolibro. Vale per pulsanti, scorciatoie da tastiera, gesti e controlli multimediali supportati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオブックの再生で巻き戻す秒数です。ボタン、キーボードショートカット、ジェスチャー、対応するメディアコントロールに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오북 재생 중 뒤로 건너뛸 시간(초)이에요. 버튼, 키보드 단축키, 제스처, 지원되는 미디어 컨트롤에 적용돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiek sekundžių persukti atgal leidžiant audioknygą. Taikoma mygtukams, sparčiesiems klavišams, gestams ir palaikomiems medijos valdikliams."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekundes, par kurām pārtīt atpakaļ audiogrāmatas atskaņošanā. Attiecas uz pogām, īsinājumtaustiņiem, žestiem un atbalstītajām multivides vadīklām."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilangan saat untuk melangkau ke belakang semasa main balik buku audio. Digunakan pada butang, pintasan papan kekunci, gerak isyarat dan kawalan media yang disokong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antall sekunder å hoppe tilbake ved avspilling av lydbøker. Gjelder knapper, hurtigtaster, bevegelser og støttede mediekontroller."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aantal seconden terugspoelen bij het afspelen van een luisterboek. Geldt voor knoppen, sneltoetsen, gebaren en ondersteunde mediabediening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba sekund cofania podczas odtwarzania audiobooka. Dotyczy przycisków, skrótów klawiszowych, gestów i obsługiwanych sterowników multimediów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos para voltar na reprodução de audiolivros. Vale para botões, atalhos de teclado, gestos e controles de mídia compatíveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos a recuar na reprodução de audiolivros. Aplica-se a botões, atalhos de teclado, gestos e controlos multimédia suportados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numărul de secunde pentru derularea înapoi în redarea cărților audio. Se aplică butoanelor, comenzilor rapide de la tastatură, gesturilor și comenzilor media acceptate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На сколько секунд перематывать назад при прослушивании аудиокниги. Действует для кнопок, сочетаний клавиш, жестов и поддерживаемых элементов управления воспроизведением."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet sekúnd na pretočenie späť pri prehrávaní audioknihy. Platí pre tlačidlá, klávesové skratky, gestá a podporované ovládače médií."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko sekund se previje nazaj pri predvajanju zvočne knjige. Velja za gumbe, bližnjične tipke, kretnje in podprte kontrolnike predstavnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal sekunder att spola tillbaka vid uppspelning av ljudböcker. Gäller knappar, kortkommandon, gester och mediekontroller som stöds."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำนวนวินาทีที่ย้อนกลับเมื่อเล่นหนังสือเสียง ใช้กับปุ่ม แป้นพิมพ์ลัด ท่าทางสัมผัส และตัวควบคุมสื่อที่รองรับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli kitap oynatırken geri sarılacak saniye. Düğmeler, klavye kısayolları, hareketler ve desteklenen medya denetimleri için geçerlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скільки секунд перемотувати назад під час відтворення аудіокниг. Стосується кнопок, сполучень клавіш, жестів і підтримуваних елементів керування медіа."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số giây tua lại khi phát sách nói. Áp dụng cho nút, phím tắt, cử chỉ và các điều khiển phương tiện được hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有声书播放时后退的秒数。适用于按钮、键盘快捷键、手势和支持的媒体控件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放有聲書時倒轉的秒數。適用於按鈕、鍵盤快速鍵、手勢和支援的媒體控制項。"
          }
        }
      }
    },
