    "settings.titleArt.footer" : {
      "comment" : "Android TV Settings > General > Title Pages: help text under the Show title art switch. Apple: description of the Show Title Art switch (VoiceOver hint on iPhone, iPad and Apple TV; shown under the switch on Mac).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم صورة الشعار عنوانًا عند توفرها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li k dispozici, zobrazí se místo názvu logo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug logografik som titel, når den findes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet, wenn verfügbar, ein Logo als Titel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use logo artwork as the title when available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el logotipo como título cuando esté disponible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä logokuvaa nimenä, kun se on saatavilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le logo comme titre lorsqu’il est disponible."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi logotip kao naslov kada je dostupan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il logo come titolo, quando disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用できる場合は、ロゴのアートワークをタイトルとして使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가능한 경우 로고 아트워크를 제목으로 사용해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk logografikk som tittel når det finnes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik logoafbeeldingen als titel wanneer beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj grafiki logo jako tytułu, gdy jest dostępna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o logotipo como título quando disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать логотип вместо названия, если он есть."
          }
        },
        "sv" : {
