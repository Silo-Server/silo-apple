    "downloads.legacy.removedNotice" : {
      "comment" : "Apple iOS/macOS: alert shown once after an update removed downloads saved by an earlier version of the app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُزيلت التنزيلات من الإصدارات السابقة. نزّلها مرة أخرى لمشاهدتها دون اتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads aus früheren Versionen wurden entfernt. Lade sie erneut herunter, um sie offline anzusehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads from earlier versions were removed. Download them again to watch offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminaron las descargas de versiones anteriores. Vuelve a descargarlas para verlas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les téléchargements des versions précédentes ont été supprimés. Téléchargez-les à nouveau pour les regarder hors connexion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のバージョンのダウンロードは削除されました。オフラインで視聴するには、もう一度ダウンロードしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os downloads de versões anteriores foram removidos. Baixe-os novamente para assistir offline."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧版本中的下载已被移除。请重新下载以离线观看。"
          }
        }
      }
    },
    "downloads.manager.backgroundFootnote" : {
      "comment" : "Apple iOS/macOS: Downloads tab (page on macOS); iPhone/iPad note under the downloads in progress.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستمر التنزيلات عند مغادرة Silo أو قفل هاتفك. يؤدي إغلاق Silo من مبدّل التطبيقات إلى إيقافها مؤقتًا حتى تفتحه مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads laufen weiter, wenn du Silo verlässt oder dein Smartphone sperrst. Wenn du Silo im App-Umschalter schließt, werden sie pausiert, bis du die App wieder öffnest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads keep going when you leave Silo or lock your phone. Closing Silo from the app switcher pauses them until you open it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las descargas continúan cuando sales de Silo o bloqueas el teléfono. Si cierras Silo desde el selector de apps, se pausan hasta que vuelvas a abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les téléchargements continuent lorsque vous quittez Silo ou verrouillez votre téléphone. Fermer Silo depuis le sélecteur d’apps les met en pause jusqu’à sa prochaine ouverture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloを離れたりスマートフォンをロックしたりしても、ダウンロードは続行されます。アプリスイッチャーでSiloを終了すると、次に開くまでダウンロードは一時停止します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os downloads continuam quando você sai do Silo ou bloqueia o celular. Fechar o Silo no seletor de apps os pausa até você abri-lo novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开Silo或锁定手机后，下载会继续进行。从App切换器中关闭Silo会暂停下载，直到你再次打开它。"
          }
        }
      }
    },
