            "state" : "translated",
            "value" : "%1$@ sedang menonton %2$@ di %3$@. Mainkan kandungan anda sebagai gantinya?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ser på %2$@ på %3$@. Vil du spille av ditt i stedet?"
