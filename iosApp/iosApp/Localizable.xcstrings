          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep recently played segments buffered for faster seeking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene en búfer los segmentos reproducidos recientemente para desplazarte más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserver en mémoire tampon les segments lus récemment pour une navigation plus rapide."
