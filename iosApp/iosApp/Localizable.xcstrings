          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन इन की बहुत ज़्यादा कोशिशें हो गई हैं। थोड़ी देर रुकें, फिर दोबारा कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previše pokušaja prijave. Pričekajte trenutak pa pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
