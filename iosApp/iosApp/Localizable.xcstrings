    "settingsManifest.player.sleep_timer_default_minutes.description" : {
      "comment" : "Help text under the player.sleep_timer_default_minutes setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المدة التي يبدأ بها مؤقت النوم عند تشغيله. القيمة 0 تبقيه معطّلًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doba, na kterou se časovač vypnutí nastaví po zapnutí. Hodnota 0 jej ponechá vypnutý."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den varighed, sovetimeren starter med, når du slår den til. 0 lader den være slået fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dauer, mit der der Sleep-Timer startet, wenn du ihn einschaltest. Bei 0 bleibt er aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duration the sleep timer starts on when you turn it on. 0 leaves it off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duración con la que empieza el temporizador de apagado al activarlo. Con 0 queda desactivado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesto, jolla uniajastin käynnistyy, kun otat sen käyttöön. 0 jättää sen pois päältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée initiale de la minuterie de mise en veille lorsque vous l’activez. 0 la laisse désactivée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trajanje koje mjerač vremena za spavanje postavlja kada ga uključite. 0 ga ostavlja isključenim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durata iniziale del timer di spegnimento quando lo attivi. Con 0 resta disattivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープタイマーをオンにしたときの初期時間です。0にするとオフのままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취침 타이머를 켤 때 시작되는 시간이에요. 0으로 설정하면 꺼진 상태로 유지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varigheten søvntimeren starter med når du slår den på. 0 lar den være av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duur waarmee de slaaptimer start als je hem aanzet. Bij 0 blijft hij uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas, od którego startuje wyłącznik czasowy po włączeniu. 0 pozostawia go wyłączonym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duração inicial do temporizador de suspensão quando você o ativa. 0 o mantém desativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длительность, с которой запускается таймер сна при включении. 0 — таймер не включается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiden som insomningstimern startar med när du slår på den. 0 lämnar den avstängd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyku zamanlayıcısını açtığınızda başlayacağı süre. 0 olursa kapalı kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тривалість, з якої починається таймер сну, коли ви його вмикаєте. 0 – залишити вимкненим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启睡眠定时器时的初始时长。设为0则保持关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟睡眠計時器時的起始時間長度。設為 0 則保持關閉。"
          }
        }
      }
    },
