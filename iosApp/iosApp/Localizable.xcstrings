    "player.aiTranslate.explainer" : {
      "comment" : "Apple iOS: footer under the language list of the iPhone and iPad AI subtitles sheet. Silo is the app name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر لغة. يترجم Silo ترجمة موجودة عندما يستطيع، أو ينسخ الصوت إلى نص."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете език. Silo превежда съществуващи субтитри, когато е възможно, или транскрибира аудиото."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria un idioma. Silo tradueix uns subtítols existents quan pot o, si no, transcriu l’àudio."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte jazyk. Silo podle možností přeloží existující titulky, nebo přepíše zvuk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg et sprog. Silo oversætter en eksisterende undertekst, når det er muligt, eller transskriberer lyden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Sprache. Silo übersetzt nach Möglichkeit vorhandene Untertitel oder transkribiert den Ton."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε μια γλώσσα. Το Silo μεταφράζει έναν υπάρχοντα υπότιτλο όταν μπορεί, διαφορετικά μεταγράφει τον ήχο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a language. Silo translates an existing subtitle when it can, or transcribes the audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un idioma. Silo traduce un subtítulo existente cuando puede o transcribe el audio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valige keel. Silo tõlgib võimaluse korral olemasolevad subtiitrid, muul juhul transkribeerib heli."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse kieli. Silo kääntää olemassa olevan tekstityksen, kun se on mahdollista, tai litteroi äänen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une langue. Silo traduit un sous-titre existant lorsque c’est possible, ou transcrit l’audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבחור שפה. Silo מתרגם כתוביות קיימות כשאפשר, או מתמלל את האודיו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भाषा चुनें। जब हो सके, Silo किसी मौजूदा सबटाइटल का अनुवाद करता है, नहीं तो ऑडियो को ट्रांसक्राइब करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite jezik. Silo prevodi postojeće titlove kad je to moguće ili transkribira zvuk."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válasszon nyelvet. A Silo lefordít egy meglévő feliratot, ha lehetséges, egyébként átírja a hangot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih bahasa. Silo menerjemahkan subtitel yang ada jika memungkinkan, atau mentranskripsikan audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una lingua. Silo traduce un sottotitolo esistente quando può, altrimenti trascrive l’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語を選択してください。Siloは可能な場合は既存の字幕を翻訳し、それ以外は音声を文字起こしします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언어를 선택하세요. Silo에서 가능하면 기존 자막을 번역하고, 그렇지 않으면 오디오를 음성 인식해 자막을 만들어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkite kalbą. „Silo“ išverčia esamus subtitrus, kai tai įmanoma, arba transkribuoja garsą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvēlieties valodu. Silo pārtulko esošos subtitrus, ja iespējams, vai transkribē audio."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih bahasa. Silo menterjemah sari kata sedia ada jika boleh, atau mentranskripsikan audio."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg et språk. Silo oversetter en eksisterende undertekst når det er mulig, eller transkriberer lyden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een taal. Silo vertaalt waar mogelijk een bestaande ondertitel, of transcribeert de audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz język. Silo tłumaczy istniejące napisy, gdy to możliwe, lub transkrybuje dźwięk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um idioma. O Silo traduz uma legenda existente quando possível ou transcreve o áudio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um idioma. O Silo traduz uma legenda existente quando possível ou transcreve o áudio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți o limbă. Silo traduce o subtitrare existentă când este posibil sau transcrie pista audio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите язык. Silo переведёт имеющиеся субтитры, если это возможно, или выполнит транскрибацию аудио."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte jazyk. Silo preloží existujúce titulky, ak je to možné, alebo prepíše zvuk."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izberite jezik. Silo prevede obstoječe podnapise, kadar je to mogoče, sicer pa prepiše zvok."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj ett språk. Silo översätter en befintlig undertext när det går, eller transkriberar ljudet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกภาษา Silo จะแปลคำบรรยายที่มีอยู่หากทำได้ หรือถอดเสียงพูดเป็นข้อความ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir dil seçin. Silo mümkünse mevcut bir altyazıyı çevirir, değilse sesi metne döker."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть мову. Silo перекладе наявні субтитри, якщо це можливо, або транскрибує аудіо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn một ngôn ngữ. Silo sẽ dịch phụ đề có sẵn nếu có thể, hoặc chép lời từ âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一种语言。Silo会尽量翻译现有字幕，否则转录音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇語言。Silo 會盡可能翻譯現有字幕，否則會轉錄音訊。"
          }
        }
      }
    },
