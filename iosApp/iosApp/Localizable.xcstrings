    "settingsManifest.watch_party.guest_control_policy.description" : {
      "comment" : "Help text under the watch_party.guest_control_policy setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من يمكنه التشغيل والإيقاف المؤقت في جلسات Watch Party التي تستضيفها. يُحفظ تغيير هذا الخيار داخل Watch Party لجلستك التالية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo může přehrávat a pozastavovat ve Watch Party, kterou hostíte. Změna provedená během Watch Party se uloží i pro tu příští."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvem der kan afspille og sætte på pause i Watch Parties, du er vært for. Ændrer du det under en fest, gemmes det til den næste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer in Watch Partys, die du leitest, abspielen und pausieren darf. Eine Änderung während einer Party wird für deine nächste gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who can play and pause in Watch Parties you host. Changing it in a party saves it for your next one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién puede reproducir y pausar en las Watch Party que organizas. Si lo cambias durante una Watch Party, se guarda para la siguiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuka voi toistaa ja keskeyttää järjestämissäsi Watch Party -istunnoissa. Kun muutat asetusta istunnon aikana, se tallentuu seuraavaa kertaa varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui peut lancer et mettre en pause la lecture dans les Watch Party que vous organisez. Le modifier pendant une Watch Party l’enregistre pour la suivante."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tko može reproducirati i pauzirati u Watch Partyjima koje vodite. Promjena tijekom partyja sprema se za sljedeći."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi può avviare e mettere in pausa nei Watch Party che organizzi. Se la modifichi durante un Watch Party, l’impostazione viene salvata per il prossimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストするWatch Partyで再生と一時停止を操作できる人です。Watch Party中に変更すると、次回にも保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트하는 Watch Party에서 재생과 일시정지를 할 수 있는 사용자예요. Watch Party 중에 변경하면 다음 Watch Party에도 저장돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvem som kan spille av og sette på pause når du er vert for en Watch Party. Endrer du dette under en Watch Party, lagres det til neste gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie kan afspelen en pauzeren in Watch Parties die je host. Als je dit tijdens een party wijzigt, wordt het bewaard voor je volgende."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto może odtwarzać i wstrzymywać w prowadzonych przez ciebie Watch Party. Zmiana wprowadzona w trakcie Watch Party zostanie zapisana na następny raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem pode reproduzir e pausar nas Watch Parties que você organiza. Alterar essa opção durante uma Watch Party a salva para a próxima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто может запускать и ставить на паузу воспроизведение в Watch Party, которые вы организуете. Изменение в Watch Party сохраняется для следующей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vem som kan spela upp och pausa när du är värd för en Watch Party. Om du ändrar det under en Watch Party sparas valet till nästa gång."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev sahibi olduğunuz Watch Party oturumlarında kimlerin oynatıp duraklatabileceği. Bir partide değiştirdiğinizde bir sonraki parti için kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хто може відтворювати й призупиняти у Watch Party, яку ви організовуєте. Якщо змінити це у Watch Party, налаштування збережеться для наступної."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你主持的Watch Party中谁可以播放和暂停。在Watch Party中更改后，会保存用于你的下一场。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你主持的 Watch Party 中，誰可以播放和暫停。在 Watch Party 中變更此設定，會儲存供你下次使用。"
          }
        }
      }
    },
