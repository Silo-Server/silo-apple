    "player.notice.qualityChangeBusy" : {
      "comment" : "Apple iOS/tvOS/macOS: error under the quality choices in the player settings when the player could not start the quality change.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تغيير الجودة الآن. حاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvalitu se teď nepodařilo změnit. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke skifte kvalitet lige nu. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Qualität konnte gerade nicht geändert werden. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't change quality right now. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cambiar la calidad en este momento. Vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laatua ei voitu vaihtaa juuri nyt. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de changer la qualité pour le moment. Réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvalitetu trenutačno nije moguće promijeniti. Pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile cambiare la qualità in questo momento. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、画質を変更できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 화질을 변경할 수 없어요. 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke endre kvaliteten akkurat nå. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de kwaliteit nu niet wijzigen. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się teraz zmienić jakości. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível mudar a qualidade agora. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас не удалось сменить качество. Повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att ändra kvaliteten just nu. Försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalite şu anda değiştirilemedi. Tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наразі не вдалося змінити якість. Спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时无法更改画质。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前無法變更畫質。請再試一次。"
          }
        }
      }
    },
    "player.notice.qualityOffline" : {
      "comment" : "Apple iOS/tvOS/macOS: error under the quality choices in the player settings when the video plays from a download.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختيار الجودة غير متاح للتشغيل دون اتصال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výběr kvality není při offline přehrávání k dispozici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valg af kvalitet er ikke tilgængeligt ved offlineafspilning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Qualitätsauswahl ist bei Offline-Wiedergabe nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quality selection is unavailable for offline playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La selección de calidad no está disponible para la reproducción sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laadun valinta ei ole käytettävissä offline-toistossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection de la qualité n’est pas disponible pour la lecture hors ligne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odabir kvalitete nije dostupan za izvanmrežnu reprodukciju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La selezione della qualità non è disponibile per la riproduzione offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフライン再生では画質を選択できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 재생 중에는 화질을 선택할 수 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvalitetsvalg er ikke tilgjengelig for frakoblet avspilling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwaliteit kiezen is niet beschikbaar bij offline afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybór jakości jest niedostępny podczas odtwarzania offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seleção de qualidade não está disponível na reprodução offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбор качества недоступен при офлайн-воспроизведении."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvalitetsval är inte tillgängligt vid offlineuppspelning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
