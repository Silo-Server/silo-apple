    "requests.notice.unconfirmedCreate" : {
      "comment" : "Toast on Roku when the app could not confirm a new request went through. My Requests is the screen listing the user's requests. Apple (iPhone, iPad, Mac, Apple TV): same message on the request detail page. Android phone and TV request screens: same message under the detail page button.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تأكيد الطلب. تحقق من «طلباتي» قبل المحاولة مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádost se nepodařilo potvrdit. Než to zkusíte znovu, zkontrolujte stránku Moje žádosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke bekræfte anmodningen. Tjek Mine anmodninger, før du prøver igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten die Anfrage nicht bestätigen. Prüfe „Meine Anfragen“, bevor du es erneut versuchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't confirm the request. Check My Requests before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos confirmar la solicitud. Revisa Mis solicitudes antes de volver a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyntöä ei voitu vahvistaa. Tarkista Omat pyynnöt ennen kuin yrität uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer la demande. Consultez Mes demandes avant de réessayer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nismo mogli potvrditi zahtjev. Provjerite Moje zahtjeve prije ponovnog pokušaja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile confermare la richiesta. Controlla Le mie richieste prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストを確認できませんでした。もう一度お試しになる前に、マイリクエストを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청 여부를 확인할 수 없어요. 다시 시도하기 전에 내 요청을 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke bekrefte forespørselen. Sjekk Mine forespørsler før du prøver igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We konden de aanvraag niet bevestigen. Controleer Mijn aanvragen voordat je het opnieuw probeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się potwierdzić prośby. Zanim spróbujesz ponownie, sprawdź „Moje prośby”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar a solicitação. Verifique Minhas solicitações antes de tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подтвердить запрос. Прежде чем повторить попытку, проверьте раздел «Мои запросы»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunde inte bekräfta förfrågan. Kontrollera Mina förfrågningar innan du försöker igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstek doğrulanamadı. Tekrar denemeden önce İsteklerim’i kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося підтвердити запит. Перш ніж пробувати ще раз, перевірте «Мої запити»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们无法确认请求是否成功。重试前请先查看我的请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法確認請求是否已送出。再試一次前，請先查看「我的請求」。"
          }
        }
      }
    },
