    "settings.profileLaunch.afterOneHour.detail" : {
      "comment" : "Explanation under the After 1 Hour profile selection choice: in the Roku profile picker, on Android, and in Apple Settings > General profile selection (iPhone, iPad, Mac, Apple TV). Who's Watching is the name of the profile picker screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض «من يشاهد؟» عندما تبتعد عن Silo لمدة ساعة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt „Wer schaut?“ an, wenn du Silo 1 Stunde lang nicht genutzt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show Who's Watching when you've been away from Silo for 1 hour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra “¿Quién está viendo?” cuando hayas estado fuera de Silo durante 1 hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher « Qui regarde ? » lorsque vous avez quitté Silo depuis 1 heure."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloから1時間離れると、プロフィール選択画面を表示します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar Quem está assistindo quando você ficar 1 hora fora do Silo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开Silo 1小时后显示“谁在观看”。"
          }
        }
      }
    },
