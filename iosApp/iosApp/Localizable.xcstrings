          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Títulos que celebram este mês um aniversário de estreia marcante."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
