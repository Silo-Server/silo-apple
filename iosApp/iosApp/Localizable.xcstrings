            "value" : "Това премахва всички настройки, променени на това устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això elimina qualsevol opció canviada en aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto odeberete všechna nastavení změněná v tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner alle indstillinger, der er ændret på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle auf diesem Gerät geänderten Einstellungen entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό αφαιρεί όσες ρυθμίσεις άλλαξαν σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes any settings changed on this device."
          }
        },
        "es" : {
          "stringUnit" : {
