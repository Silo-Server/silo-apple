    "settingsManifest.nav.shortcuts.description" : {
      "comment" : "Help text under the nav.shortcuts setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المكتبات والأقسام والمجموعات المثبّتة للاستخدام في واجهات التنقل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Библиотеки, раздели и колекции, закачени за бърз достъп навсякъде в навигацията."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteques, seccions i col·leccions fixades per utilitzar-les a tots els espais de navegació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knihovny, sekce a kolekce připnuté pro použití napříč navigací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteker, sektioner og samlinger, der er fastgjort til brug på tværs af navigationen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediatheken, Bereiche und Sammlungen, die für die gesamte Navigation angeheftet sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βιβλιοθήκες, ενότητες και συλλογές που έχουν καρφιτσωθεί για χρήση σε όλα τα σημεία πλοήγησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libraries, sections, and collections pinned for use across navigation surfaces."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliotecas, secciones y colecciones fijadas para usarlas en toda la navegación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meediakogud, jaotised ja kollektsioonid, mis on kinnitatud kasutamiseks kõigis navigeerimiskohtades."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjastot, osiot ja kokoelmat, jotka on kiinnitetty käytettäviksi kaikissa navigointinäkymissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliothèques, sections et collections épinglées pour être utilisées dans toute la navigation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ספריות, אזורים ואוספים שהוצמדו לשימוש בכל ממשקי הניווט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेविगेशन में हर जगह इस्तेमाल के लिए पिन की गई लाइब्रेरी, सेक्शन और कलेक्शन।"
          }
        },
        "hr" : {
