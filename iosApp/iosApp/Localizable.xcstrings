    "watchParty.strip.guest" : {
      "comment" : "Caption of the suggestions strip for guests, who can suggest but only the host picks: Watch Party on Roku, Android phone and TV, beside the lobby's suggestions on Apple iPhone, iPad and Apple TV, and the web Watch Together lobby.",
      "extractionState" : "manual",
      "localizations" : {
