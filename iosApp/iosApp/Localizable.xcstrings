    "signIn.forgot.unavailableLead" : {
      "comment" : "Apple (iPhone, iPad, Mac) Reset password screen: line shown when the server stopped offering self-service password resets.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوفّر هذا الخادم إعادة تعيين كلمة المرور من شاشة تسجيل الدخول. اطلب من مسؤول الخادم إعادة تعيين كلمة المرور."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този сървър не предлага нулиране на паролата от екрана за вход. Помолете администратора на сървъра да нулира паролата ви."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest servidor no permet restablir la contrasenya des de la pantalla d’inici de sessió. Demana a l’administrador del servidor que te la restableixi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server nenabízí obnovení hesla z přihlašovací obrazovky. Požádejte správce serveru o obnovení hesla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne server tilbyder ikke nulstilling af adgangskoder fra loginskærmen. Bed din serveradministrator om at nulstille din adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server bietet auf dem Anmeldebildschirm kein Zurücksetzen des Passworts an. Bitte deinen Server-Admin, dein Passwort zurückzusetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο διακομιστής δεν προσφέρει επαναφορά κωδικού πρόσβασης από την οθόνη σύνδεσης. Ζητήστε από τον διαχειριστή του διακομιστή να επαναφέρει τον κωδικό πρόσβασής σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server doesn't offer password resets from the sign-in screen. Ask your server admin to reset your password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no permite restablecer la contraseña desde la pantalla de inicio de sesión. Pide al administrador del servidor que restablezca tu contraseña."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See server ei paku sisselogimiskuval parooli lähtestamist. Paluge serveri administraatoril oma parool lähtestada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä palvelin ei tarjoa salasanan palautusta kirjautumisnäytöltä. Pyydä palvelimen ylläpitäjää palauttamaan salasanasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur ne propose pas la réinitialisation du mot de passe depuis l’écran de connexion. Demandez à l’administrateur de votre serveur de réinitialiser votre mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת הזה לא מאפשר איפוס סיסמה ממסך ההתחברות. יש לבקש ממנהל השרת לאפס את הסיסמה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सर्वर साइन-इन स्क्रीन से पासवर्ड रीसेट करने की सुविधा नहीं देता। अपना पासवर्ड रीसेट करवाने के लिए अपने सर्वर एडमिन से कहें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj poslužitelj ne nudi ponovno postavljanje lozinke sa zaslona za prijavu. Zamolite administratora poslužitelja da ponovno postavi vašu lozinku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a szerver nem kínál jelszó-visszaállítást a bejelentkezési képernyőről. Kérje meg a szerver rendszergazdáját, hogy állítsa vissza a jelszavát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server ini tidak menyediakan pengaturan ulang kata sandi dari layar masuk. Minta admin server Anda untuk mengatur ulang kata sandi Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo server non consente di reimpostare la password dalla schermata di accesso. Chiedi all’amministratore del server di reimpostarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーでは、サインイン画面からパスワードをリセットできません。サーバー管理者にパスワードのリセットを依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버는 로그인 화면에서 비밀번호 재설정을 지원하지 않아요. 서버 관리자에게 비밀번호 재설정을 요청하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis serveris nesiūlo atkurti slaptažodžio prisijungimo ekrane. Paprašykite serverio administratoriaus atkurti jūsų slaptažodį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis serveris nepiedāvā paroles atiestatīšanu pierakstīšanās ekrānā. Lūdziet servera administratoram atiestatīt jūsu paroli."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelayan ini tidak menawarkan tetapan semula kata laluan dari skrin log masuk. Minta pentadbir pelayan anda menetapkan semula kata laluan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne serveren tilbyr ikke tilbakestilling av passord fra påloggingsskjermen. Be serveradministratoren om å tilbakestille passordet ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze server biedt geen wachtwoordreset vanaf het inlogscherm. Vraag je serverbeheerder om je wachtwoord te resetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten serwer nie umożliwia resetowania hasła z ekranu logowania. Poproś administratora serwera o zresetowanie hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor não oferece redefinição de senha na tela de login. Peça ao administrador do servidor para redefinir sua senha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor não permite repor a palavra-passe a partir do ecrã de início de sessão. Peça ao administrador do servidor que reponha a sua palavra-passe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest server nu oferă resetarea parolei din ecranul de conectare. Cereți administratorului serverului să vă reseteze parola."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот сервер не поддерживает сброс пароля на экране входа. Попросите администратора сервера сбросить ваш пароль."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server neponúka obnovenie hesla z prihlasovacej obrazovky. Požiadajte správcu servera, aby vám heslo obnovil."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta strežnik ne ponuja ponastavitve gesla na zaslonu za prijavo. Prosite skrbnika strežnika, da ponastavi vaše geslo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här servern erbjuder inte lösenordsåterställning från inloggningsskärmen. Be serverns administratör att återställa ditt lösenord."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซิร์ฟเวอร์นี้ไม่มีการรีเซ็ตรหัสผ่านจากหน้าจอลงชื่อเข้าใช้ โปรดขอให้ผู้ดูแลเซิร์ฟเวอร์รีเซ็ตรหัสผ่านให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucu, oturum açma ekranından parola sıfırlama sunmuyor. Parolanızı sıfırlaması için sunucu yöneticinize başvurun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей сервер не дозволяє скидати пароль з екрана входу. Попросіть адміністратора сервера скинути ваш пароль."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ này không hỗ trợ đặt lại mật khẩu từ màn hình đăng nhập. Hãy nhờ quản trị viên máy chủ đặt lại mật khẩu cho bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器不支持在登录界面重置密码。请让你的服务器管理员重置你的密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台伺服器不提供從登入畫面重設密碼。請伺服器管理員為你重設密碼。"
          }
        }
      }
    },
    "signIn.forgotPassword" : {
      "comment" : "Android phone sign-in screen: small note under the form when the server offers only password sign-in. Apple (iPhone, iPad, Mac): same note under the password form when the server doesn't email reset links.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل نسيت كلمة المرور؟ اسأل مسؤول الخادم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забравена парола? Попитайте администратора на сървъра."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has oblidat la contrasenya? Consulta l’administrador del servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapomenuté heslo? Obraťte se na správce serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glemt din adgangskode? Spørg serveradministratoren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwort vergessen? Wende dich an den Server-Admin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεχάσατε τον κωδικό πρόσβασης; Ρωτήστε τον διαχειριστή του διακομιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgot your password? Ask the server admin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Olvidaste tu contraseña? Pregunta al administrador del servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unustasite parooli? Pöörduge serveri administraatori poole."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unohditko salasanasi? Kysy palvelimen ylläpitäjältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mot de passe oublié ? Demandez à l’administrateur du serveur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שכחת את הסיסמה? יש לפנות למנהל השרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासवर्ड याद नहीं है? सर्वर एडमिन से पूछें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaboravili ste lozinku? Obratite se administratoru poslužitelja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elfelejtette a jelszavát? Forduljon a szerver rendszergazdájához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupa kata sandi? Tanyakan kepada admin server."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Password dimenticata? Chiedi all’amministratore del server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードをお忘れの場合は、サーバー管理者にお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호를 잊으셨나요? 서버 관리자에게 문의하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamiršote slaptažodį? Kreipkitės į serverio administratorių."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
