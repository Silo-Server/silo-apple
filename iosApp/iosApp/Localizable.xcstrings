          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohitusvälien lataaminen palvelimelta epäonnistui."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les intervalles de saut depuis le serveur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće učitati intervale preskakanja s poslužitelja."
          }
        },
        "it" : {
