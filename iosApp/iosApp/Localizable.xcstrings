    "update.serverRequired" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error shown on sign-in, pairing, playback, settings and other screens when the connected Silo server is too old for this version of the app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب تحديث هذا الخادم قبل أن يتمكن هذا الإصدار من Silo من استخدامه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server je nutné aktualizovat, aby ho tato verze Silo mohla používat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne server skal opdateres, før denne version af Silo kan bruge den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server muss aktualisiert werden, bevor diese Silo-Version ihn nutzen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server needs to be updated before this version of Silo can use it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay que actualizar este servidor para que esta versión de Silo pueda usarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä palvelin on päivitettävä, ennen kuin tämä Silo-versio voi käyttää sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur doit être mis à jour pour que cette version de Silo puisse l’utiliser."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj poslužitelj treba ažurirati prije nego što ga ova verzija Siloa može koristiti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo server deve essere aggiornato prima che questa versione di Silo possa usarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンのSiloで使用するには、このサーバーをアップデートする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전의 Silo에서 사용하려면 먼저 이 서버를 업데이트해야 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne serveren må oppdateres før denne versjonen av Silo kan bruke den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze server moet worden bijgewerkt voordat deze versie van Silo hem kan gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten serwer wymaga aktualizacji, zanim ta wersja aplikacji Silo będzie mogła z niego korzystać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor precisa ser atualizado antes que esta versão do Silo possa usá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот сервер нужно обновить, прежде чем эта версия Silo сможет с ним работать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här servern måste uppdateras innan den här versionen av Silo kan använda den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo’nun bu sürümünün kullanabilmesi için bu sunucunun güncellenmesi gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей сервер потрібно оновити, перш ніж ця версія Silo зможе ним користуватися."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
