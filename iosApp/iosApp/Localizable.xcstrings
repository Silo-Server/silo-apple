          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oglądaj filmy i odcinki od miejsca przerwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retome filmes e episódios de onde parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжите смотреть фильмы и серии с того места, где остановились."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsätt titta på filmer och avsnitt där du slutade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film ve bölümlere kaldığınız yerden devam edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продовжуйте дивитися фільми й епізоди з місця, де зупинилися."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从上次停下的地方继续观看电影和剧集。"
          }
        },
        "zh-Hant" : {
