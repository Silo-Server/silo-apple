    "player.notice.connectionLostBeforeEnd" : {
      "comment" : "Apple iOS/tvOS/macOS: video player notice text under Connection lost, shown with the Up Next panel.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الاتصال بالخادم قبل انتهاء الحلقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojení se serverem se přerušilo před koncem dílu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen til serveren blev afbrudt, før afsnittet var slut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zum Server ist vor dem Ende der Folge abgebrochen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lost connection to the server before the episode finished."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perdió la conexión con el servidor antes de que terminara el episodio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteys palvelimeen katkesi ennen jakson loppua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion au serveur a été perdue avant la fin de l’épisode."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza s poslužiteljem prekinuta je prije kraja epizode."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connessione al server persa prima della fine dell’episodio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エピソードの終了前にサーバーとの接続が切れました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에피소드가 끝나기 전에 서버와의 연결이 끊겼어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistet tilkoblingen til serveren før episoden var ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding met de server is verbroken voordat de aflevering afgelopen was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utracono połączenie z serwerem przed końcem odcinka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão com o servidor foi perdida antes de o episódio terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение с сервером потеряно до конца серии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslutningen till servern bröts innan avsnittet var slut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölüm bitmeden sunucu bağlantısı kesildi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З’єднання із сервером втрачено до завершення епізоду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本集播放结束前与服务器的连接已断开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這一集播完前，與伺服器的連線中斷了。"
          }
        }
      }
    },
