    "downloads.settings.qualityPresetsResolution" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; second sentence of the quality footer, when seasons and series can also be downloaded in a preset and presets show a resolution.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجهَّز إعدادات معدل البت المسبقة على الخادم عندما يكون الملف الأصلي أكبر، بدقة تصل إلى الدقة المعروضة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готовите настройки за битрейт се подготвят на сървъра, когато оригиналът е по-голям, с резолюция до показаната."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els valors predefinits de velocitat de bits es preparen al servidor quan l’original és més gran, fins a la resolució que es mostra."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předvolby datového toku se připravují na serveru, pokud je originál větší, a to až do zobrazeného rozlišení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forvalg for bitrate forberedes på serveren, når originalen er større, i op til den viste opløsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitraten-Voreinstellungen werden auf dem Server vorbereitet, wenn das Original größer ist, und zwar bis zur angezeigten Auflösung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι προκαθορισμένοι ρυθμοί bit προετοιμάζονται στον διακομιστή όταν το αρχικό αρχείο είναι μεγαλύτερο, έως την ανάλυση που εμφανίζεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitrate presets are prepared on the server when the original is larger, at up to the resolution shown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes predefinidos de tasa de bits se preparan en el servidor cuando el original es más grande, hasta la resolución indicada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitikiiruse eelseadistused valmistatakse serveris ette, kui originaal on suurem, kuni näidatud eraldusvõimeni."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bittinopeuden esiasetukset valmistellaan palvelimella, kun alkuperäinen on suurempi, enintään näytetyllä resoluutiolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les préréglages de débit sont préparés sur le serveur lorsque l’original est plus volumineux, jusqu’à la résolution indiquée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת מכין גרסאות בקצב סיביות מוגדר מראש כשהמקור גדול יותר, עד לרזולוציה המוצגת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ओरिजिनल फ़ाइल बड़ी होने पर, बिटरेट प्रीसेट सर्वर पर दिखाए गए रिज़ॉल्यूशन तक तैयार किए जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unaprijed postavljene brzine prijenosa pripremaju se na poslužitelju kada je izvornik veći, do prikazane razlučivosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bitráta-előbeállításokat a szerver készíti elő, ha az eredeti fájl nagyobb, legfeljebb a megjelenített felbontásban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preset bitrate disiapkan di server jika file asli lebih besar, hingga resolusi yang ditampilkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I preset di bitrate vengono preparati sul server quando l’originale è più grande, fino alla risoluzione indicata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オリジナルの方が大きい場合、ビットレートプリセットが表示されている解像度までの範囲でサーバーで準備されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본이 더 크면 서버에서 표시된 해상도 이하로 비트레이트 프리셋을 준비해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai originalas didesnis, bitų spartos šablonai paruošiami serveryje, ne didesnės nei rodoma raiškos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitu ātruma priekšiestatījumi tiek sagatavoti serverī, ja oriģināls ir lielāks, līdz norādītajai izšķirtspējai."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratetap kadar bit disediakan di pelayan apabila fail asal lebih besar, sehingga resolusi yang ditunjukkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhåndsinnstillinger for bithastighet forberedes på serveren når originalen er større, i opptil oppløsningen som vises."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitrate-presets worden op de server voorbereid als het origineel groter is, tot maximaal de getoonde resolutie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warianty bitrate’u są przygotowywane na serwerze, gdy oryginał jest większy, maksymalnie w pokazanej rozdzielczości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As predefinições de taxa de bits são preparadas no servidor quando o original é maior, com até a resolução mostrada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As predefinições de taxa de bits são preparadas no servidor quando o original é maior, até à resolução indicada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presetările de rată de biți sunt pregătite pe server când originalul este mai mare, la cel mult rezoluția afișată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если оригинал больше, пресеты битрейта готовятся на сервере с разрешением не выше указанного."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predvoľby dátového toku sa pripravia na serveri, keď je originál väčší, a to najviac v zobrazenom rozlíšení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prednastavitve bitne hitrosti se pripravijo na strežniku, kadar je izvirnik večji, in sicer do prikazane ločljivosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bithastighetsförval förbereds på servern när originalet är större, med upp till den upplösning som visas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซิร์ฟเวอร์จะเตรียมพรีเซ็ตบิตเรตเมื่อต้นฉบับมีขนาดใหญ่กว่า โดยมีความละเอียดสูงสุดตามที่แสดง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinal dosya daha büyükse bit hızı ön ayarları sunucuda, gösterilen çözünürlüğe kadar hazırlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо оригінал більший, пресети бітрейту готуються на сервері з роздільністю до вказаної."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mức bitrate định sẵn được chuẩn bị trên máy chủ khi bản gốc lớn hơn, với độ phân giải tối đa như hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当原始文件较大时，服务器会准备码率预设版本，最高为所示分辨率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始檔案較大時，伺服器會準備位元速率預設檔，最高為所顯示的解析度。"
          }
        }
      }
    },
    "downloads.settings.qualityScopeDownloads" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; last sentences of the quality footer, when monitored series always download in original quality.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا هو الإعداد الافتراضي لكل تنزيل؛ ويمكن تغييره من لوحة «تنزيل». تُنزَّل المسلسلات المراقَبة بالجودة الأصلية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това е стойността по подразбиране за всяко изтегляне; може да се промени в панела за изтегляне. Наблюдаваните сериали се изтеглят в оригинално качество."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest és el valor predeterminat per a totes les baixades; el full de baixada el pot canviar. Les sèries supervisades es baixen en qualitat original."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto je výchozí nastavení pro každé stahování; v okně Stáhnout ho lze změnit. Sledované seriály se stahují v původní kvalitě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er standarden for alle downloads; den kan ændres i downloadarket. Overvågede serier downloades i original kvalitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist die Standardeinstellung für jeden Download; im Download-Fenster kannst du sie ändern. Überwachte Serien werden in Originalqualität heruntergeladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή είναι η προεπιλογή για κάθε λήψη. Μπορείτε να την αλλάξετε στο φύλλο «Λήψη». Οι σειρές που παρακολουθούνται λαμβάνονται στην αρχική ποιότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the default for every download; the Download sheet can change it. Monitored series download in original quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el valor predeterminado para cada descarga; puedes cambiarlo en el panel Descargar. Las series supervisadas se descargan en calidad original."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See on kõigi allalaadimiste vaikeväärtus; lehel „Laadi alla“ saab seda muuta. Jälgitavad sarjad laaditakse alla originaalkvaliteedis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on oletus kaikille latauksille; latausikkunassa sitä voi muuttaa. Seuratut sarjat ladataan alkuperäisessä laadussa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’agit de la valeur par défaut pour chaque téléchargement ; la fenêtre Télécharger peut la modifier. Les séries suivies sont téléchargées en qualité originale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זו ברירת המחדל לכל הורדה; אפשר לשנות אותה בחלונית ”הורדה”. סדרות במעקב יורדות באיכות המקורית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह हर डाउनलोड के लिए डिफ़ॉल्ट है; डाउनलोड शीट में इसे बदला जा सकता है। मॉनिटर की गई सीरीज़ ओरिजिनल क्वालिटी में डाउनलोड होती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo je zadana vrijednost za svako preuzimanje; možete je promijeniti u prozoru za preuzimanje. Praćene serije preuzimaju se u izvornoj kvaliteti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez minden letöltés alapértelmezése; a Letöltés panelen módosítható. A figyelt sorozatok eredeti minőségben töltődnek le."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini adalah default untuk setiap unduhan; lembar Unduh dapat mengubahnya. Serial yang dipantau diunduh dalam kualitas asli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È l’impostazione predefinita per ogni download; puoi cambiarla nel pannello Download. Le serie monitorate vengono scaricate in qualità originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはすべてのダウンロードのデフォルトで、ダウンロードシートで変更できます。監視中のシリーズはオリジナル画質でダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 다운로드의 기본값이며, 다운로드 시트에서 변경할 수 있어요. 모니터링 중인 시리즈는 원본 화질로 다운로드돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai numatytasis nustatymas visiems atsisiuntimams; atsisiuntimo lange jį galima pakeisti. Stebimi serialai atsisiunčiami originalia kokybe."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas ir noklusējums visām lejupielādēm; to var mainīt lejupielādes panelī. Pārraudzītie seriāli tiek lejupielādēti oriģinālajā kvalitātē."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini ialah lalai untuk setiap muat turun; helaian Muat turun boleh mengubahnya. Siri yang dipantau dimuat turun dalam kualiti asal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er standarden for alle nedlastinger, og du kan endre den i nedlastingsarket. Overvåkede serier lastes ned i originalkvalitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is de standaard voor elke download; je kunt dit wijzigen in het downloadvenster. Gevolgde series worden in originele kwaliteit gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ustawienie domyślne dla każdego pobierania; można je zmienić w oknie pobierania. Monitorowane seriale są pobierane w oryginalnej jakości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é o padrão para todos os downloads; o painel de download pode alterá-lo. Séries monitoradas são baixadas na qualidade original."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é a predefinição para todas as transferências; o painel Transferir pode alterá-la. As séries monitorizadas são transferidas na qualidade original."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta este valoarea implicită pentru fiecare descărcare; o puteți schimba din panoul Descărcare. Serialele monitorizate se descarcă în calitatea originală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это значение по умолчанию для всех загрузок; его можно изменить в окне «Скачать». Отслеживаемые сериалы скачиваются в исходном качестве."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto je predvolená hodnota pre každé stiahnutie; v hárku Stiahnuť ju môžete zmeniť. Sledované seriály sa sťahujú v pôvodnej kvalite."
