    "settingsManifest.ui.text_weight.description" : {
      "comment" : "Help text under the ui.text_weight setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام نص أثقل في الواجهة لتسهيل القراءة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro lepší čitelnost použít tučnější text rozhraní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug kraftigere tekst i brugerfladen for bedre læsbarhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräftigeren Text in der Oberfläche für bessere Lesbarkeit verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use heavier interface text for readability."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un texto de interfaz más grueso para facilitar la lectura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä lihavampaa käyttöliittymätekstiä luettavuuden parantamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser un texte d’interface plus épais pour une meilleure lisibilité."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deblji tekst sučelja za bolju čitljivost."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un testo dell’interfaccia più marcato per una migliore leggibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読みやすくするため、インターフェースの文字を太くします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽기 쉽도록 인터페이스 텍스트를 더 굵게 표시해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk kraftigere tekst i grensesnittet for bedre lesbarhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik dikkere interfacetekst voor betere leesbaarheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogrubia tekst interfejsu dla lepszej czytelności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa um texto mais encorpado na interface para facilitar a leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать более жирный текст интерфейса для удобства чтения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd fetare text i gränssnittet för bättre läsbarhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okunabilirlik için arayüzde daha kalın metin kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовувати жирніший текст інтерфейсу для кращої читабельності."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用更粗的界面文字，便于阅读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用較粗的介面文字，以提升可讀性。"
          }
        }
      }
    },
