            "state" : "translated",
            "value" : "投票結束後，%1$@ 會開始播放勝出的作品。"
          }
        }
      }
    },
    "watchParty.hint.hostStartsWinner" : {
      "comment" : "Roku: hint line shown to guests in a voting lobby. {host}: the host's display name; {title}: the name of the leading movie or show. Apple (iPhone, iPad, Apple TV): same hint under the lobby's buttons. Android phone and TV Watch Party lobby: same line under a guest's buttons. 1: the host's name, 2: the leading title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
