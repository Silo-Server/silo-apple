            "state" : "translated",
            "value" : "בוצעה התחברות אל %1$@. מתבצע מעבר לפרופילים שלך…"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ में साइन इन हो गया। आपकी प्रोफ़ाइलों पर ले जाया जा रहा है…"
          }
        },
        "hr" : {
          "stringUnit" : {
