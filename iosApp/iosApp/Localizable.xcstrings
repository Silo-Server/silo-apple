    "player.error.incompatiblePlan" : {
      "comment" : "Apple iOS/tvOS/macOS: player error when the server's playback plan can't be used by this app version. Used by the audiobook player. Keep \"V3\" as is.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعاد الخادم خطة تشغيل غير متوافقة بالبروتوكول V3."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server vrátil nekompatibilní plán přehrávání protokolu V3."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren returnerede en inkompatibel afspilningsplan til protokol V3."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat einen inkompatiblen Wiedergabeplan für Protokoll V3 zurückgegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server returned an incompatible protocol V3 playback plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor devolvió un plan de reproducción del protocolo V3 incompatible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin palautti yhteensopimattoman V3-protokollan toistosuunnitelman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a renvoyé un plan de lecture du protocole V3 incompatible."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj je vratio nekompatibilan plan reprodukcije protokola V3."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha restituito un piano di riproduzione del protocollo V3 non compatibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーから互換性のないプロトコルV3再生プランが返されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 호환되지 않는 프로토콜 V3 재생 계획을 반환했어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren returnerte en inkompatibel avspillingsplan for protokoll V3."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server gaf een incompatibel afspeelplan voor protocol V3 terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer zwrócił niezgodny plan odtwarzania protokołu V3."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor retornou um plano de reprodução incompatível do protocolo V3."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер вернул несовместимый план воспроизведения протокола V3."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern returnerade en inkompatibel uppspelningsplan för protokoll V3."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu uyumsuz bir protokol V3 oynatma planı döndürdü."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер повернув несумісний план відтворення протоколу V3."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器返回了不兼容的协议V3播放方案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器傳回了不相容的 V3 通訊協定播放計畫。"
          }
        }
      }
    },
