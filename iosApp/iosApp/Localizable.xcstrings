    "settingsManifest.catalog.hide_unwatched_episode_images.description" : {
      "comment" : "Help text under the catalog.hide_unwatched_episode_images setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمويه الصورة المصغّرة للحلقة حتى تبدأ مشاهدتها، كي لا تكشف الصورة أحداث القصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet das Vorschaubild einer Folge weich, bis du sie zu schauen beginnst, damit das Bild nichts von der Handlung verrät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blur an episode's thumbnail until you start watching it, so the image does not give away the story."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difumina la miniatura de un episodio hasta que empieces a verlo, para que la imagen no revele la historia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floute la miniature d’un épisode jusqu’à ce que vous commenciez à le regarder, pour que l’image ne dévoile pas l’intrigue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エピソードのサムネイルを視聴を始めるまでぼかし、画像からストーリーがわからないようにします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfoca a miniatura de um episódio até você começar a assistir, para que a imagem não revele a história."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你开始观看前模糊显示该集的缩略图，以免图片剧透。"
          }
        }
      }
    },
    "settingsManifest.catalog.hide_unwatched_episode_images.label" : {
      "comment" : "Label of the catalog.hide_unwatched_episode_images setting in settings screens. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمويه صور الحلقات غير المشاهَدة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder ungesehener Folgen weichzeichnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blur unwatched episode images"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difuminar imágenes de episodios no vistos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flouter les images des épisodes non vus"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未視聴エピソードの画像をぼかす"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfocar imagens de episódios não assistidos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模糊未观看集的图片"
          }
        }
      }
    },
    "settingsManifest.catalog.hide_unwatched_episode_overviews.description" : {
      "comment" : "Help text under the catalog.hide_unwatched_episode_overviews setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
