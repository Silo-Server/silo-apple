    "settings.skipIntervals.footerAudiobook" : {
      "comment" : "Android phone and TV. Phone: footer under the audiobook skip intervals group on Settings → Playback. TV: Settings > Playback > Audiobooks: help text under the audiobook skip intervals. Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: footer under the audiobook skip intervals.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدمها أزرار التخطي في مشغّل الكتب الصوتية. تنطبق على كل جهاز مسجّل الدخول إلى هذا الملف الشخصي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използват се от бутоните за прескачане в плейъра за аудиокниги. Прилагат се за всички устройства с вход в този профил."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els fan servir els botons de salt del reproductor d’audiollibres. S’aplica a tots els dispositius amb la sessió iniciada en aquest perfil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá se pro tlačítka přeskočení v přehrávači audioknih. Platí pro všechna zařízení přihlášená k tomuto profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
