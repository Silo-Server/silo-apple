    "tvSignIn.error.accountRequired" : {
      "comment" : "Android TV and phone sign-in error when the person has no account on the server. The server admin must add them. Apple (iPhone, iPad, Mac, Apple TV): same sign-in error.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس لديك حساب على هذا الخادم بعد. اطلب من أحد المسؤولين إضافتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все още нямате акаунт в този сървър. Помолете администратор да ви добави."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no tens cap compte en aquest servidor. Demana a un administrador que t’hi afegeixi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tomto serveru zatím nemáte účet. Požádejte správce, aby vás přidal."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke en konto på denne server endnu. Bed en administrator om at tilføje dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast noch kein Konto auf diesem Server. Bitte jemanden mit Adminrechten, dich hinzuzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχετε ακόμη λογαριασμό σε αυτόν τον διακομιστή. Ζητήστε από έναν διαχειριστή να σας προσθέσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have an account on this server yet. Ask an admin to add you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no tienes una cuenta en este servidor. Pide a un administrador que te añada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teil pole veel selles serveris kontot. Paluge administraatoril teid lisada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulla ei ole vielä tiliä tällä palvelimella. Pyydä ylläpitäjää lisäämään sinut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas encore de compte sur ce serveur. Demandez à un administrateur de vous ajouter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין אין לך חשבון בשרת הזה. יש לבקש ממנהל להוסיף אותך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सर्वर पर अभी आपका कोई खाता नहीं है। आपको जोड़ने के लिए किसी एडमिन से कहें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još nemate račun na ovom poslužitelju. Zamolite administratora da vas doda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincs fiókja ezen a szerveren. Kérje meg egy rendszergazdát, hogy adja hozzá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda belum memiliki akun di server ini. Minta admin untuk menambahkan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai ancora un account su questo server. Chiedi a un amministratore di aggiungerti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーにはまだアカウントがありません。管理者に追加を依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 이 서버에 계정이 없어요. 관리자에게 추가해 달라고 요청하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šiame serveryje dar neturite paskyros. Paprašykite administratoriaus jus pridėti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jums vēl nav konta šajā serverī. Lūdziet administratoram jūs pievienot."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda belum mempunyai akaun di pelayan ini. Minta pentadbir menambah anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke en konto på denne serveren ennå. Be en administrator om å legge deg til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt nog geen account op deze server. Vraag een beheerder om je toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie masz jeszcze konta na tym serwerze. Poproś administrację serwera o dodanie cię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ainda não tem uma conta neste servidor. Peça a um administrador para adicionar você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não tem conta neste servidor. Peça a um administrador que lhe crie uma conta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu aveți încă un cont pe acest server. Cereți unui administrator să vă adauge."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас пока нет аккаунта на этом сервере. Попросите администратора добавить вас."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tomto serveri ešte nemáte účet. Požiadajte správcu, aby vás pridal."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tem strežniku še nimate računa. Prosite skrbnika, da vas doda."
