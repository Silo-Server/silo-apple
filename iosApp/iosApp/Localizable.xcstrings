    "pairing.error.codesDifferSetup" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: error after the person said the first code doesn't match the TV during setup.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تتطابق الرموز، لذا أُلغي الإعداد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кодовете не съвпаднаха, затова настройката беше отменена."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els codis no coincideixen, de manera que s’ha cancel·lat la configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kódy se neshodovaly, proto bylo nastavení zrušeno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koderne passede ikke sammen, så opsætningen blev annulleret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Codes stimmten nicht überein, daher wurde die Einrichtung abgebrochen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κωδικοί δεν ταίριαζαν, επομένως η ρύθμιση ακυρώθηκε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The codes didn’t match, so setup was cancelled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los códigos no coincidían, así que se canceló la configuración."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
