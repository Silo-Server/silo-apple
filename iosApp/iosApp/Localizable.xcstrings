    "home.recipe.bcwAuto.description" : {
      "comment" : "One-line description of the Because You Watched preset in the Add row gallery (shared key `home.recipe.bcwAuto.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختيارات بناءً على آخر ما شاهدته."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Препоръки въз основа на последното, което сте гледали."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recomanacions basades en el que has vist més recentment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipy podle vašeho posledního sledování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forslag baseret på det, du senest har set."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfehlungen basierend auf dem, was du zuletzt geschaut hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προτάσεις με βάση ό,τι παρακολουθήσατε πιο πρόσφατα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picks based on your most recent watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recomendaciones según lo último que viste."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valik teie viimati vaadatu põhjal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valintoja viimeksi katsomasi perusteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggestions d’après votre dernier visionnage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחירות לפי הצפייה האחרונה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने हाल ही में जो देखा, उसके आधार पर सुझाव।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijedlozi na temelju onoga što ste posljednje gledali."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajánlatok a legutóbb megtekintett tartalom alapján."
          }
        },
        "id" : {
