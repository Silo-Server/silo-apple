    "settingsManifest.player.subtitle_sync_ms.description" : {
      "comment" : "Help text under the player.subtitle_sync_ms setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقديم الترجمة أو تأخيرها لهذا الملف الشخصي. يمكن لكل جهاز الاحتفاظ بإزاحته الخاصة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изместване на субтитрите по-рано или по-късно за този профил. Устройството може да пази собствено отместване."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avança o endarrereix els subtítols per a aquest perfil. Un dispositiu pot mantenir el seu propi desfasament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posunout titulky dříve nebo později pro tento profil. Zařízení si může ponechat vlastní posun."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt undertekster tidligere eller senere for denne profil. En enhed kan have sin egen forskydning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel für dieses Profil früher oder später anzeigen. Ein Gerät kann seinen eigenen Versatz behalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακίνηση των υποτίτλων νωρίτερα ή αργότερα για αυτό το προφίλ. Μια συσκευή μπορεί να διατηρεί τη δική της μετατόπιση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shift subtitles earlier or later for this profile. A device can keep its own offset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adelanta o retrasa los subtítulos para este perfil. Cada dispositivo puede mantener su propio desfase."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nihutab selle profiili subtiitreid varasemaks või hilisemaks. Seadmel võib olla oma nihe."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä tekstityksiä aiemmaksi tai myöhemmäksi tässä profiilissa. Laite voi käyttää omaa siirtymäänsä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décaler les sous-titres plus tôt ou plus tard pour ce profil. Un appareil peut conserver son propre décalage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקדמה או איחור של הכתוביות בפרופיל הזה. מכשיר יכול לשמור היסט משלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस प्रोफ़ाइल के लिए सबटाइटल पहले या बाद में दिखाएँ। कोई डिवाइस अपना अलग ऑफ़सेट रख सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomiče titlove ranije ili kasnije za ovaj profil. Uređaj može zadržati vlastiti pomak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A feliratok korábbra vagy későbbre tolása ennél a profilnál. Egy eszköz saját eltolást is megtarthat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser subtitel lebih awal atau lebih lambat untuk profil ini. Perangkat dapat menyimpan offset sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anticipa o ritarda i sottotitoli per questo profilo. Un dispositivo può mantenere un proprio ritardo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールの字幕を早めたり遅らせたりします。デバイスごとに独自のオフセットを保持できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필의 자막을 더 빠르게 또는 늦게 표시해요. 기기별로 자체 오프셋을 유지할 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodyti subtitrus anksčiau arba vėliau šiam profiliui. Įrenginys gali turėti savo poslinkį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārbīdīt subtitrus agrāk vai vēlāk šim profilam. Ierīce var saglabāt savu nobīdi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anjakkan sari kata lebih awal atau lebih lewat untuk profil ini. Peranti boleh mengekalkan ofsetnya sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt undertekstene tidligere eller senere for denne profilen. En enhet kan ha sin egen forskyvning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon ondertitels eerder of later voor dit profiel. Een apparaat kan een eigen verschuiving houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwa napisy wcześniej lub później w tym profilu. Urządzenie może mieć własne przesunięcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adianta ou atrasa as legendas neste perfil. Um dispositivo pode manter seu próprio ajuste."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiantar ou atrasar as legendas para este perfil. Um dispositivo pode manter o seu próprio desfasamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișați subtitrările mai devreme sau mai târziu pentru acest profil. Un dispozitiv își poate păstra propriul decalaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдвинуть субтитры раньше или позже для этого профиля. Устройство может хранить собственное смещение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posunie titulky skôr alebo neskôr pre tento profil. Zariadenie si môže ponechať vlastný posun."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomakne podnapise naprej ali nazaj za ta profil. Naprava ima lahko svoj zamik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytta undertexter tidigare eller senare för den här profilen. En enhet kan ha en egen förskjutning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลื่อนคำบรรยายให้เร็วขึ้นหรือช้าลงสำหรับโปรไฟล์นี้ อุปกรณ์แต่ละเครื่องตั้งค่าชดเชยของตัวเองได้"
