    "newProfile.requestsAllowedHelp" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): help text under the Allow requests switch on the New Profile form.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لهذا الملف الشخصي تصفح العناوين غير الموجودة في المكتبة وطلبها. يقيّد التصنيف العمري هذه العناوين وفق تصنيفها الأمريكي فقط، ولا ينطبق عليها حد العمر الإرشادي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožní tomuto profilu procházet tituly, které nejsou v knihovně, a požádat o ně. Věkové omezení tyto tituly omezuje pouze podle jejich amerického hodnocení a omezení podle doporučeného věku se na ně nevztahuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lader denne profil gennemse titler, der ikke er i biblioteket, og anmode om dem. Aldersgrænsen begrænser kun disse titler efter deres amerikanske aldersgrænse, og den vejledende aldersgrænse gælder ikke for dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt diesem Profil, Titel zu durchsuchen, die nicht in der Mediathek sind, und sie anzufragen. Die Altersfreigabe begrenzt diese Titel nur anhand ihrer US-Freigabe, und die Altersempfehlung gilt für sie nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets this profile browse titles that are not in the library and request them. The content rating limits those titles by their US rating only, and the advisory-age limit does not apply to them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que este perfil explore títulos que no están en la biblioteca y los solicite. La clasificación por edad limita esos títulos solo según su clasificación de EE. UU., y el límite de edad recomendada no se aplica a ellos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä profiili voi selata nimikkeitä, joita ei ole kirjastossa, ja pyytää niitä. Ikäraja rajoittaa näitä nimikkeitä vain niiden yhdysvaltalaisen ikärajan perusteella, eikä suositusikärajaa sovelleta niihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à ce profil de parcourir les titres absents de la bibliothèque et de les demander. La classification par âge ne limite ces titres que selon leur classification américaine, et la limite d’âge conseillé ne s’applique pas à eux."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućuje ovom profilu pregledavanje naslova koji nisu u medijateci i slanje zahtjeva za njih. Dobna oznaka ograničava te naslove samo prema njihovoj američkoj oznaci, a dobno ograničenje iz upozorenja na njih se ne primjenjuje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permette a questo profilo di sfogliare i titoli che non sono nella libreria e di richiederli. La classificazione per età limita questi titoli solo in base alla classificazione statunitense e il limite di età consigliata non si applica a loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリにないタイトルをこのプロフィールで閲覧し、リクエストできるようにします。これらのタイトルには、年齢制限は米国の年齢制限によってのみ適用され、推奨年齢による制限は適用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필에서 라이브러리에 없는 작품을 둘러보고 요청할 수 있어요. 관람 등급 제한은 이러한 작품에 미국 관람 등급으로만 적용되며, 권장 연령 제한은 적용되지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lar denne profilen bla gjennom titler som ikke finnes i biblioteket, og be om dem. Aldersgrensen begrenser disse titlene bare etter den amerikanske aldersgrensen, og grensen for anbefalt alder gjelder ikke for dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee kan dit profiel titels bekijken die niet in de bibliotheek staan en ze aanvragen. De leeftijdsclassificatie beperkt die titels alleen op basis van hun Amerikaanse classificatie, en de adviesleeftijd geldt niet voor die titels."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala temu profilowi przeglądać tytuły, których nie ma w bibliotece, i poprosić o nie. Kategoria wiekowa ogranicza te tytuły tylko według ich amerykańskiej kategorii, a limit wieku z ostrzeżeń nie ma do nich zastosowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que este perfil explore títulos que não estão na biblioteca e os solicite. A classificação indicativa limita esses títulos apenas pela classificação dos EUA, e o limite de idade recomendada não se aplica a eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот профиль сможет находить фильмы и сериалы, которых нет в медиатеке, и запрашивать их. Для них возрастной рейтинг учитывается только по системе США, а ограничение по рекомендуемому возрасту не действует."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låter profilen bläddra bland titlar som inte finns i biblioteket och begära dem. Åldersgränsen begränsar de titlarna endast utifrån deras amerikanska klassificering, och gränsen för rekommenderad ålder gäller inte för dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu profilin kitaplıkta olmayan içeriklere göz atmasına ve bunları istemesine izin verir. Yaş sınırı bu içerikleri yalnızca ABD yaş sınırına göre kısıtlar; önerilen yaş sınırı bunlara uygulanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дає змогу цьому профілю переглядати назви, яких немає в бібліотеці, і надсилати на них запити. Віковий рейтинг обмежує ці назви лише за їхнім рейтингом у США, а обмеження за рекомендованим віком на них не поширюється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许此个人资料浏览不在媒体库中的作品并请求它们。年龄分级仅按美国分级限制这些作品，建议年龄限制不适用于它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓這個個人檔案瀏覽不在媒體庫中的作品並提出請求。內容分級僅依美國分級限制這些作品，建議年齡限制則不適用於這些作品。"
          }
        }
      }
    },
