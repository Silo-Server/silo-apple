    "signIn.passwordChange.lead" : {
      "comment" : "Apple (iPhone, iPad, Mac) and Android phone Choose a new password screen: line under the headline. {account}: the account's username.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عيّن المسؤول كلمة مرور مؤقتة للحساب %1$@. اختر كلمة مرور خاصة بك للمتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Admin hat ein temporäres Passwort für %1$@ festgelegt. Wähle ein eigenes, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An admin set a temporary password for %1$@. Choose your own to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un administrador estableció una contraseña temporal para %1$@. Elige la tuya para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un administrateur a défini un mot de passe temporaire pour %1$@. Choisissez le vôtre pour continuer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者が%1$@に一時パスワードを設定しました。続行するには、ご自身のパスワードを設定してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um administrador definiu uma senha temporária para %1$@. Escolha a sua para continuar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理员为%1$@设置了临时密码。请设置你自己的密码以继续。"
          }
        }
      }
    },
    "signIn.passwordChange.leadUnnamed" : {
