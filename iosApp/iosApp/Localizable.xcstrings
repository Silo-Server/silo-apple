          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekunden, um die bei der Wiedergabe von Hörbüchern zurückgesprungen wird. Gilt für Schaltflächen, Tastenkürzel, Gesten und unterstützte Mediensteuerungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seconds to skip back in audiobook playback. Applies to buttons, keyboard shortcuts, gestures, and supported media controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos que se retrocede al reproducir audiolibros. Se aplica a botones, atajos de teclado, gestos y controles multimedia compatibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de secondes de retour en arrière lors de l’écoute d’un livre audio. S’applique aux boutons, aux raccourcis clavier, aux gestes et aux commandes multimédias compatibles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオブックの再生で巻き戻す秒数です。ボタン、キーボードショートカット、ジェスチャー、対応するメディアコントロールに適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos para voltar na reprodução de audiolivros. Vale para botões, atalhos de teclado, gestos e controles de mídia compatíveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有声书播放时后退的秒数。适用于按钮、键盘快捷键、手势和支持的媒体控件。"
          }
        }
      }
    },
