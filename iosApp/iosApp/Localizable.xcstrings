    "diagnostics.notice.rejected" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: the hosted diagnostics collector refused the report, which stays on the device.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض المُجمِّع التقرير؛ احتُفظ بالنسخة المحلية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sběrná služba zprávu odmítla; místní kopie byla ponechána."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsamleren afviste rapporten; den lokale kopi blev beholdt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sammeldienst hat den Bericht abgelehnt; die lokale Kopie wurde aufbewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collector rejected the report; the local copy was kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El recopilador rechazó el informe; se conservó la copia local."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keräyspalvelu hylkäsi raportin; paikallinen kopio säilytettiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collecteur a refusé le rapport ; la copie locale a été conservée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakupljač je odbio izvješće; lokalna kopija je zadržana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio di raccolta ha rifiutato il report; la copia locale è stata conservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクターがレポートを拒否しました。ローカルのコピーは保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수집기에서 보고서를 거부했어요. 로컬 사본은 보관했어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innsamlingstjenesten avviste rapporten. Den lokale kopien ble beholdt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verzamelservice heeft het rapport geweigerd; de lokale kopie is bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolektor odrzucił raport; zachowano kopię lokalną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O coletor recusou o relatório; a cópia local foi mantida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сборщик отклонил отчёт; локальная копия сохранена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insamlingstjänsten avvisade rapporten. Den lokala kopian sparades."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplayıcı raporu reddetti; yerel kopya saklandı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервіс збору відхилив звіт; локальну копію збережено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收集器拒绝了此报告，本地副本已保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收集器拒絕了報告；已保留本機副本。"
          }
        }
      }
    },
