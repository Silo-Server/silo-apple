    "pairing.error.couldntReachTv" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: error when the TV didn't answer the connection. {tv}: the TV's name as it advertises itself (for example Living Room).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى %1$@. تأكد من أنه لا يزال على شاشة الإعداد أو تسجيل الدخول، ثم حاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма връзка с телевизора %1$@. Уверете се, че на него все още е отворен екранът за настройка или вход, и опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut connectar amb %1$@. Comprova que encara mostri la pantalla de configuració o d’inici de sessió i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se spojit s televizí %1$@. Ujistěte se, že je na ní stále otevřená obrazovka nastavení nebo přihlášení, a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke nå %1$@. Sørg for, at det stadig viser opsætnings- eller loginskærmen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ konnte nicht erreicht werden. Stelle sicher, dass noch der Einrichtungs- oder Anmeldebildschirm angezeigt wird, und versuche es dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η επικοινωνία με την τηλεόραση %1$@. Βεβαιωθείτε ότι βρίσκεται ακόμα στην οθόνη ρύθμισης ή σύνδεσης και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t reach %1$@. Make sure it’s still on its setup or sign-in screen, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con %1$@. Asegúrate de que siga en su pantalla de configuración o de inicio de sesión y vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teleriga %1$@ ei õnnestunud ühendust saada. Veenduge, et sellel oleks endiselt avatud seadistus- või sisselogimiskuva, ja proovige siis uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tv:hen %1$@ ei saatu yhteyttä. Varmista, että se on yhä määritys- tai kirjautumisnäkymässä, ja yritä sitten uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre %1$@. Vérifiez que %1$@ affiche toujours son écran de configuration ou de connexion, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה ליצור קשר עם הטלוויזיה %1$@. יש לוודא שהיא עדיין במסך ההגדרה או ההתחברות, ואז לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ तक नहीं पहुँचा जा सका। पक्का करें कि टीवी अब भी अपनी सेटअप या साइन इन स्क्रीन पर है, और फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uređaj %1$@ nije dostupan. Provjerite je li još na zaslonu za postavljanje ili prijavu pa pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült elérni a(z) %1$@ TV-t. Ellenőrizze, hogy még a beállítási vagy a bejelentkezési képernyőn van-e, majd próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menjangkau %1$@. Pastikan TV masih berada di layar penyiapan atau layar masuk, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere %1$@. Assicurati che sia ancora sulla schermata di configurazione o di accesso, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に接続できませんでした。セットアップ画面またはサインイン画面が表示されたままになっていることを確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에 연결할 수 없어요. TV에 아직 설정 또는 로그인 화면이 표시되어 있는지 확인하고 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko pasiekti televizoriaus „%1$@“. Įsitikinkite, kad jame vis dar atidarytas sąrankos arba prisijungimo ekranas, tada bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās sasniegt televizoru „%1$@”. Pārliecinieties, ka tajā joprojām ir atvērts iestatīšanas vai pierakstīšanās ekrāns, un mēģiniet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menghubungi %1$@. Pastikan TV itu masih pada skrin persediaan atau log masuk, kemudian cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke nå %1$@. Sørg for at den fortsatt viser oppsett- eller påloggingsskjermen, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan %1$@ niet bereiken. Zorg dat het instel- of inlogscherm nog open is en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z telewizorem %1$@. Upewnij się, że nadal wyświetla ekran konfiguracji lub logowania, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar %1$@. Verifique se ainda está na tela de configuração ou de login e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível contactar a TV %1$@. Certifique-se de que ainda está no ecrã de configuração ou de início de sessão e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a putut accesa televizorul %1$@. Asigurați-vă că este încă pe ecranul de configurare sau de conectare, apoi încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось связаться с телевизором «%1$@». Убедитесь, что на нём всё ещё открыт экран настройки или входа, и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa spojiť s televízorom %1$@. Skontrolujte, či je na ňom stále obrazovka nastavenia alebo prihlásenia, a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Televizorja %1$@ ni bilo mogoče doseči. Preverite, ali je še vedno na zaslonu za nastavitev ali prijavo, nato poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
