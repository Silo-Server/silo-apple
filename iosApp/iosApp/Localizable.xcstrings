    "remote.replace.profileWatchingTheTv" : {
      "comment" : "Apple iOS: Remote Control \"Replace What's Playing?\" alert message when the TV's name is not known. {profile}: the other profile's name, {title}: what it is watching (title, or series and episode).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشاهد %1$@ %2$@ على التلفزيون. هل تريد تشغيل ما اخترته بدلًا منه؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профилът %1$@ гледа %2$@ на телевизора. Да се пусне ли вашето вместо това?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ està veient %2$@ a la TV. Vols reproduir el teu contingut en el seu lloc?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil %1$@ na televizi sleduje %2$@. Přehrát místo toho váš výběr?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ser %2$@ på tv’et. Vil du afspille dit i stedet?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ schaut gerade %2$@ auf dem Fernseher. Stattdessen deine Auswahl abspielen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το προφίλ %1$@ παρακολουθεί το στοιχείο %2$@ στην τηλεόραση. Αναπαραγωγή του δικού σας στη θέση του;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is watching %2$@ on the TV. Play yours instead?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está viendo %2$@ en la TV. ¿Reproducir lo tuyo en su lugar?"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vaatab teleris pealkirja %2$@. Kas esitada hoopis teie oma?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ katsoo tv:ssä kohdetta %2$@. Toistetaanko omasi sen sijaan?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ regarde %2$@ sur la TV. Lire votre contenu à la place ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בפרופיל %1$@ צופים עכשיו בפריט %2$@ בטלוויזיה. להפעיל את שלך במקום זאת?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ टीवी पर %2$@ देख रहे हैं। इसकी जगह आपका टाइटल चलाएँ?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gleda %2$@ na TV-u. Želite li umjesto toga reproducirati svoje?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
