          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri offline prehrávaní nie je výber kvality dostupný."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbira kakovosti pri predvajanju brez povezave ni na voljo."
          }
        },
        "sv" : {
          "stringUnit" : {
