    "settings.subtitles.followsSystemAppearance" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac): footer while Use Device Settings is on. Accessibility → Subtitles & Captioning is the path in Apple's Settings app; use the system's own names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع لغة التسميات التوضيحية لهذا الجهاز وسلوك العرض وتفضيل CC/SDH والخط والألوان والعتامة والحواف والحجم ونافذة التسميات التوضيحية من تسهيلات الاستخدام ← الترجمة والتسميات التوضيحية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следват се езикът на надписите, поведението при показване, предпочитанието за CC/SDH, шрифтът, цветовете, непрозрачността, контурите, размерът и прозорецът на надписите на това устройство от „Достъпност → Субтитри и надписи“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se segueixen l’idioma dels subtítols, el comportament de visualització, la preferència de CC/SDH, la font, els colors, l’opacitat, les vores, la mida i la finestra dels subtítols d’aquest dispositiu definits a Accessibilitat → Subtítols i subtitulació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řídí se jazykem titulků, chováním zobrazení, předvolbou CC/SDH, písmem, barvami, neprůhledností, okraji, velikostí a oknem titulků tohoto zařízení z nastavení Zpřístupnění → Titulky a skryté titulky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følger denne enheds undertekstsprog, visningsadfærd, CC/SDH-præference, skrift, farver, opacitet, kanter, størrelse og undertekstvindue fra Tilgængelighed → Undertekster og tekstning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet Untertitelsprache, Anzeigeverhalten, CC/SDH-Präferenz, Schrift, Farben, Deckkraft, Ränder, Größe und Untertitelfenster dieses Geräts aus „Bedienungshilfen“ → „Untertitel & erweiterte UT“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακολουθούνται η γλώσσα υποτίτλων, η συμπεριφορά εμφάνισης, η προτίμηση CC/SDH, η γραμματοσειρά, τα χρώματα, η αδιαφάνεια, τα περιγράμματα, το μέγεθος και το παράθυρο υποτίτλων αυτής της συσκευής από την ενότητα Προσβασιμότητα → Υπότιτλοι και λεζάντες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Following this device's caption language, display behavior, CC/SDH preference, font, colors, opacity, edges, size, and caption window from Accessibility → Subtitles & Captioning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usan el idioma de los subtítulos, el modo de visualización, la preferencia de CC/SDH, la fuente, los colores, la opacidad, los bordes, el tamaño y la ventana de subtítulos de este dispositivo, definidos en Accesibilidad → Subtítulos y subtitulado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järgitakse selle seadme subtiitrite keelt, kuvamise käitumist, CC/SDH eelistust, fonti, värve, läbipaistmatust, servi, suurust ja subtiitriakent menüüst Accessibility → Subtitles & Captioning."
