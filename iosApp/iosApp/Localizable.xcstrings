    "newProfile.error.pin" : {
      "comment" : "Body of the Roku validation dialog shown when the PIN has fewer than four digits; the user must complete it or clear it. Apple (iPhone, iPad, Mac, Apple TV): same alert body on the New Profile form.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل الأرقام الأربعة كلها، أو اترك PIN فارغًا لعدم استخدام PIN."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Въведете и 4-те цифри или оставете полето за PIN празно, ако не искате PIN."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdueix els 4 dígits o deixa el PIN buit per no tenir PIN."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte všechny 4 číslice, nebo PIN nechte prázdný, pokud ho nechcete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast alle 4 cifre, eller lad PIN-koden være tom, hvis du ikke vil bruge en PIN-kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib alle 4 Ziffern ein oder lass die PIN leer, um keine PIN zu verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε και τα 4 ψηφία ή αφήστε το PIN κενό για να μην υπάρχει PIN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter all 4 digits, or leave the PIN empty for no PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe los 4 dígitos o deja el PIN vacío para no usar PIN."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisestage kõik 4 numbrit või jätke PIN tühjaks, kui te PIN-i ei soovi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna kaikki 4 numeroa tai jätä PIN-koodi tyhjäksi, jos et halua PIN-koodia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez les 4 chiffres, ou laissez le PIN vide pour ne pas en utiliser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להזין את כל 4 הספרות, או להשאיר את ה-PIN ריק כדי לא להגדיר PIN."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी 4 अंक डालें, या PIN न रखने के लिए PIN खाली छोड़ दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unesite sve 4 znamenke ili ostavite PIN prazan ako ne želite PIN."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adja meg mind a 4 számjegyet, vagy hagyja üresen a PIN-kódot, ha nem kér PIN-kódot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan keempat digit, atau kosongkan PIN jika tanpa PIN."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci tutte e 4 le cifre o lascia vuoto il PIN per non usarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4桁すべてを入力するか、PINを設定しない場合は空欄にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4자리를 모두 입력하거나, PIN을 사용하지 않으려면 비워 두세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įveskite visus 4 skaitmenis arba palikite PIN tuščią, jei PIN nereikia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ievadiet visus 4 ciparus vai atstājiet PIN tukšu, ja PIN nav vajadzīgs."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan kesemua 4 digit, atau biarkan PIN kosong untuk tanpa PIN."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn alle 4 sifrene, eller la PIN-feltet stå tomt for ingen PIN."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer alle 4 cijfers in, of laat de PIN leeg als je geen PIN wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz wszystkie 4 cyfry lub zostaw pole PIN puste, aby nie ustawiać kodu PIN."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite os 4 dígitos ou deixe o PIN em branco para não usar PIN."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduza os 4 dígitos ou deixe o PIN vazio para não ter PIN."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduceți toate cele 4 cifre sau lăsați câmpul PIN gol pentru a nu folosi un cod PIN."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите все 4 цифры или оставьте поле PIN пустым, чтобы не задавать PIN."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadajte všetky 4 číslice alebo nechajte PIN prázdny, ak PIN nechcete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vnesite vse 4 števke ali pustite PIN prazen, če ga ne želite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange alla 4 siffror, eller lämna PIN-fältet tomt om du inte vill ha någon PIN-kod."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป้อน PIN ให้ครบ 4 หลัก หรือเว้นว่างไว้หากไม่ต้องการใช้ PIN"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 hanenin tamamını girin ya da PIN istemiyorsanız PIN alanını boş bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть усі 4 цифри або залиште PIN-код порожнім, щоб не використовувати PIN."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập đủ 4 chữ số, hoặc để trống mã PIN nếu không dùng PIN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入完整的4位数字，或将PIN留空以不设PIN。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入完整的 4 位數，或將 PIN 留空以不設定 PIN。"
          }
        }
      }
    },
