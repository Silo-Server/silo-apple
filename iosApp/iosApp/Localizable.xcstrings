        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस शफ़ल में और कुछ नहीं चलाया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U ovoj nasumičnoj reprodukciji nema više ničega što se može reproducirati."
          }
        },
        "hu" : {
          "stringUnit" : {
