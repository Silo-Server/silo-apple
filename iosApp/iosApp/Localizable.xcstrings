          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místní zpráva byla smazána. Vzdálené smazání je ve frontě a bude se opakovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lokale rapport blev slettet. Fjernsletning er sat i kø og forsøges igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der lokale Bericht wurde gelöscht. Das Löschen am Ziel steht in der Warteschlange und wird erneut versucht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τοπική αναφορά διαγράφηκε. Η απομακρυσμένη διαγραφή βρίσκεται σε ουρά και θα επιχειρηθεί ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local report was deleted. Remote deletion is queued and will retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminó el informe local. La eliminación remota está en cola y se volverá a intentar."
          }
        },
        "et" : {
          "stringUnit" : {
