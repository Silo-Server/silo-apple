    "setup.notReady.lead" : {
      "comment" : "Apple (iPhone, iPad, Mac) server needs setup screen: line under the headline.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من مسؤول الخادم إكمال الإعداد. عندما يصبح جاهزًا، عد إلى هنا وتحقق مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte die Person, die den Server verwaltet, die Einrichtung abzuschließen. Wenn er bereit ist, kehre hierher zurück und prüfe erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the server administrator to finish setup. When it's ready, return here and check again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide al administrador del servidor que termine la configuración. Cuando esté listo, vuelve aquí y compruébalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à la personne qui administre le serveur de terminer la configuration. Quand le serveur sera prêt, revenez ici et vérifiez à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの管理者にセットアップの完了を依頼してください。準備ができたら、ここに戻ってもう一度確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao administrador do servidor para concluir a configuração. Quando estiver pronto, volte aqui e verifique novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请让服务器管理员完成设置。准备就绪后，返回此处再次检查。"
          }
        }
      }
    },
