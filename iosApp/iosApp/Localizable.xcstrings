    "tvSignIn.appleTv.lead" : {
      "comment" : "Apple TV sign-in screen: paragraph under the headline beside the QR code. {page}: the server's activation address as typed, for example media.example.com/activate.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح الرمز بكاميرا هاتفك، أو انتقل إلى %1$@ وأدخله. وافق على هاتفك وسيسجّل Apple TV هذا الدخول تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Code mit der Kamera deines Smartphones oder öffne %1$@ und gib ihn dort ein. Bestätige auf deinem Smartphone, dann meldet sich dieses Apple TV von selbst an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the code with your phone's camera, or go to %1$@ and enter it. Approve on your phone and this Apple TV signs in by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código con la cámara de tu teléfono o ve a %1$@ y escríbelo. Aprueba en tu teléfono y este Apple TV iniciará sesión solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code avec l’appareil photo de votre téléphone, ou accédez à %1$@ et saisissez-le. Approuvez sur votre téléphone et cette Apple TV se connecte d’elle-même."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンのカメラでコードをスキャンするか、%1$@にアクセスしてコードを入力してください。スマートフォンで承認すると、このApple TVが自動的にサインインします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie o código com a câmera do celular ou acesse %1$@ e digite-o. Aprove no celular e esta Apple TV entra sozinha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手机相机扫描代码，或前往%1$@输入代码。在手机上批准后，这台Apple TV会自动登录。"
          }
        }
      }
    },
    "tvSignIn.appleTv.leadNoPage" : {
      "comment" : "Apple TV sign-in screen: paragraph under the headline beside the QR code, before the server's activation address is known. Keep /activate unchanged.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح الرمز بكاميرا هاتفك، أو انتقل إلى صفحة /activate على خادمك وأدخله. وافق على هاتفك وسيسجّل Apple TV هذا الدخول تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Code mit der Kamera deines Smartphones oder öffne die Seite /activate deines Servers und gib ihn dort ein. Bestätige auf deinem Smartphone, dann meldet sich dieses Apple TV von selbst an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the code with your phone's camera, or go to your server's /activate page and enter it. Approve on your phone and this Apple TV signs in by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código con la cámara de tu teléfono o ve a la página /activate de tu servidor y escríbelo. Aprueba en tu teléfono y este Apple TV iniciará sesión solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code avec l’appareil photo de votre téléphone, ou accédez à la page /activate de votre serveur et saisissez-le. Approuvez sur votre téléphone et cette Apple TV se connecte d’elle-même."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンのカメラでコードをスキャンするか、サーバーの/activateページにアクセスしてコードを入力してください。スマートフォンで承認すると、このApple TVが自動的にサインインします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie o código com a câmera do celular ou acesse a página /activate do seu servidor e digite-o. Aprove no celular e esta Apple TV entra sozinha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手机相机扫描代码，或前往你的服务器的/activate页面输入代码。在手机上批准后，这台Apple TV会自动登录。"
          }
        }
      }
    },
    "tvSignIn.appleTv.noCodeBody" : {
      "comment" : "Apple TV sign-in screen: card text when the TV can sign in through a network sign-in provider with no code or password. {server}: the server's name; {provider}: the provider's name, such as Tailscale.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل Apple TV هذا إلى %1$@ عبر %2$@، الذي يعرف مالكه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Apple TV hat %1$@ über %2$@ erreicht, wodurch bekannt ist, wem es gehört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Apple TV reached %1$@ through %2$@, which knows who it belongs to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Apple TV se conectó a %1$@ a través de %2$@, que sabe a quién pertenece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette Apple TV a joint %1$@ via %2$@, qui sait à qui elle appartient."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVは、所有者を識別できる%2$@を経由して%1$@に接続しました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta Apple TV acessou %1$@ por meio de %2$@, que sabe a quem ela pertence."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台Apple TV通过%2$@访问%1$@，%2$@知道它属于谁。"
          }
        }
      }
    },
