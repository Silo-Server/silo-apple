    "account.error.diagnosticsCleanupFailed" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message in the Account Update alert when the sign-out finished but the diagnostics saved on the device couldn't be erased. Settings > Accounts names the settings page where servers are removed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تسجيل خروجك، لكن تعذّر على Silo مسح بيانات التشخيص المحلية. أزل هذا الخادم من الإعدادات ← الحسابات لإعادة محاولة المسح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist abgemeldet, aber Silo konnte die lokalen Diagnosedaten nicht löschen. Entferne diesen Server unter Einstellungen > Konten, um die Bereinigung erneut zu versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're signed out, but Silo couldn't erase local diagnostics. Remove this server in Settings > Accounts to retry cleanup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerró tu sesión, pero Silo no pudo borrar los diagnósticos locales. Quita este servidor en Configuración > Cuentas para volver a intentar la limpieza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La déconnexion a réussi, mais Silo n’a pas pu effacer les diagnostics locaux. Retirez ce serveur dans Paramètres > Comptes pour relancer le nettoyage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインアウトしましたが、Siloはローカルの診断データを消去できませんでした。もう一度消去するには、設定 > アカウントでこのサーバーを削除してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você saiu da conta, mas o Silo não conseguiu apagar os diagnósticos locais. Remova este servidor em Configurações > Contas para tentar a limpeza novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已退出登录，但Silo无法清除本地诊断数据。请在设置 > 账户中移除此服务器以重新清理。"
          }
        }
      }
    },
    "account.error.needsSignIn" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error when a saved account chosen in Change account or Settings › Accounts can't be opened because its sign-in is no longer valid.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج هذا الحساب إلى تسجيل الدخول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Konto musst du dich erneut anmelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That account needs to sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa cuenta tiene que volver a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte doit se reconnecter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントはもう一度サインインする必要があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É preciso entrar novamente nessa conta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该账户需要重新登录。"
          }
        }
      }
    },
    "account.error.removeServerFailed" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message in the Account Update alert when removing a saved server, with its accounts, failed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo إزالة الخادم المحفوظ. حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte den gespeicherten Server nicht entfernen. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn't remove the saved server. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo quitar el servidor guardado. Vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de retirer le serveur enregistré. Réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloは保存済みのサーバーを削除できませんでした。もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo não conseguiu remover o servidor salvo. Tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo无法移除已保存的服务器。请重试。"
          }
        }
      }
    },
    "account.error.signOutRefused" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message in the Account Update alert when signing out of an account was refused and nothing changed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo تسجيل الخروج من هذا الحساب. حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte dich nicht von diesem Konto abmelden. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn't sign out of that account. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo cerrar la sesión de esa cuenta. Vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de se déconnecter de ce compte. Réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloはこのアカウントからサインアウトできませんでした。もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo não conseguiu sair dessa conta. Tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo无法退出该账户。请重试。"
          }
        }
      }
    },
    "account.error.switchServerFailed" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message in the Account Update alert when opening a sign-in link for another saved server couldn't make that server active.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التبديل إلى هذا الخادم. حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu diesem Server konnte nicht gewechselt werden. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't switch to that server. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cambiar a ese servidor. Vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de passer à ce serveur. Réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーに切り替えられませんでした。もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível mudar para esse servidor. Tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法切换到该服务器。请重试。"
          }
        }
      }
    },
