    "upNext.shuffleDone" : {
      "comment" : "Message on the Roku and Android TV Up Next panels when no remaining item in the current shuffle can be played. Apple iOS/tvOS: message on the player's Up Next screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد شيء آخر قابل للتشغيل في هذا التشغيل العشوائي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нищо друго от това разбъркване не може да се пусне."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es pot reproduir res més d’aquesta reproducció aleatòria."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tomto náhodném přehrávání už nelze nic dalšího přehrát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet andet i den blandede afspilning kan afspilles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Zufallswiedergabe kann nichts weiter abgespielt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένα άλλο στοιχείο αυτής της τυχαίας αναπαραγωγής δεν μπορεί να αναπαραχθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing else in this shuffle can play."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No queda nada más que se pueda reproducir en esta reproducción aleatoria."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sellest juhuesitusest ei saa midagi muud esitada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä satunnaistoistossa ei ole enää mitään toistettavaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus rien ne peut être lu dans cette lecture aléatoire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין עוד פריטים בערבוב הזה שאפשר להפעיל."
