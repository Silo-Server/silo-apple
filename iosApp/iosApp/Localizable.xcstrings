    "pairing.error.alreadyDecided" : {
      "comment" : "Phone and tablet: nearby-TV setup card, when the TV's request was already answered. 1: the TV's name. Apple (iPhone, iPad): same error on the nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت الموافقة على طلب تسجيل الدخول هذا أو رفضه من قبل. ابدأ من جديد على %1$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato žádost o přihlášení už byla schválena nebo zamítnuta. Začněte znovu na televizi %1$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne loginanmodning er allerede godkendt eller afvist. Start forfra på %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anmeldeanfrage wurde bereits genehmigt oder abgelehnt. Beginne auf %1$@ erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sign-in request was already approved or declined. Start again on %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud de inicio de sesión ya se aprobó o se rechazó. Vuelve a empezar en %1$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä kirjautumispyyntö on jo hyväksytty tai hylätty. Aloita uudelleen tv:ssä %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette demande de connexion a déjà été approuvée ou refusée. Recommencez sur %1$@."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj zahtjev za prijavu već je odobren ili odbijen. Počnite ponovno na uređaju %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa richiesta di accesso è già stata approvata o rifiutata. Ricomincia su %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサインインのリクエストはすでに承認または拒否されています。%1$@でもう一度やり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 승인 또는 거절된 로그인 요청이에요. %1$@에서 다시 시작하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne påloggingsforespørselen er allerede godkjent eller avvist. Start på nytt på %1$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit inlogverzoek is al goedgekeurd of afgewezen. Begin opnieuw op %1$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta prośba o zalogowanie została już zatwierdzona lub odrzucona. Zacznij ponownie na telewizorze %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitação de login já foi aprovada ou recusada. Comece novamente em %1$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот запрос на вход уже одобрен или отклонён. Начните заново на телевизоре «%1$@»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här inloggningsförfrågan har redan godkänts eller avvisats. Börja om på %1$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oturum açma isteği zaten onaylandı veya reddedildi. %1$@ cihazında yeniden başlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей запит на вхід уже схвалено або відхилено. Почніть знову на телевізорі %1$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此登录请求已被批准或拒绝。请在%1$@上重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此登入請求已經核准或拒絕。請在 %1$@ 上重新開始。"
          }
        }
      }
    },
    "pairing.error.approveRefused" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: error when the server refused the approval for an unexpected reason. {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على %1$@ الموافقة على تسجيل الدخول. حاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveru %1$@ se nepodařilo schválit přihlášení. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kunne ikke godkende login. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ konnte die Anmeldung nicht genehmigen. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ couldn’t approve the sign-in. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no pudo aprobar el inicio de sesión. Vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin %1$@ ei voinut hyväksyä kirjautumista. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n’a pas pu approuver la connexion. Réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj %1$@ nije mogao odobriti prijavu. Pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile approvare l’accesso su %1$@. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@でサインインを承認できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 서버에서 로그인을 승인하지 못했어요. 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kunne ikke godkjenne påloggingen. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kan de aanmelding niet goedkeuren. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zatwierdzić logowania na serwerze %1$@. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não conseguiu aprovar o login. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер «%1$@» не смог одобрить вход. Повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kunde inte godkänna inloggningen. Försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sunucusu oturum açmayı onaylayamadı. Tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер %1$@ не зміг схвалити вхід. Спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@无法批准此登录。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 無法核准登入。請再試一次。"
