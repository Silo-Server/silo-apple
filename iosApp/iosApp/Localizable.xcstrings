    "settingsManifest.player.passout_threshold.description" : {
      "comment" : "Help text under the player.passout_threshold setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الحلقات التي تُشغَّل تلقائيًا قبل أن يسألك Silo إن كنت ما زلت تشاهد. القيمة 0 تعني عدم السؤال أبدًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колко епизода се пускат автоматично, преди Silo да попита дали още гледате. При 0 никога не пита."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quants episodis es reprodueixen automàticament abans que Silo et pregunti si encara mires. Amb 0 no ho pregunta mai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolik dílů se automaticky přehraje, než se Silo zeptá, zda se stále díváte. Při hodnotě 0 se nikdy nezeptá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mange afsnit der afspilles automatisk, før Silo spørger, om du stadig ser med. 0 spørger aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Folgen automatisch abgespielt werden, bevor Silo fragt, ob du noch schaust. Bei 0 wird nie gefragt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσα επεισόδια αναπαράγονται αυτόματα πριν το Silo σας ρωτήσει αν συνεχίζετε να παρακολουθείτε. Με 0 δεν ρωτά ποτέ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many episodes auto-play before Silo asks whether you are still watching. 0 never asks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántos episodios se reproducen automáticamente antes de que Silo te pregunte si sigues viendo. Con 0 nunca pregunta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitu osa esitatakse automaatselt, enne kui Silo küsib, kas te veel vaatate. Väärtusega 0 ei küsita kunagi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka monta jaksoa toistetaan automaattisesti, ennen kuin Silo kysyy, katsotko vielä. Arvolla 0 ei kysytä koskaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre d’épisodes lus automatiquement avant que Silo vous demande si vous regardez toujours. Avec 0, Silo ne demande jamais."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה פרקים יופעלו אוטומטית לפני ש-Silo ישאל אם הצפייה עדיין נמשכת. הערך 0 מבטל את השאלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo के यह पूछने से पहले कि क्या आप अभी भी देख रहे हैं, कितने एपिसोड अपने-आप चलें। 0 पर कभी नहीं पूछा जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko se epizoda automatski reproducira prije nego što vas Silo upita gledate li još. Uz 0 nikad ne pita."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hány epizód játszódjon le automatikusan, mielőtt a Silo megkérdezi, hogy még nézi-e. 0 esetén soha nem kérdez."
