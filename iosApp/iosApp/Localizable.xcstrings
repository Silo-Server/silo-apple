    "settings.signIn.noLocalPasswordAdministrator" : {
      "comment" : "Apple Settings > Sign-in > Connect (iPhone, iPad, Mac): error when the account has no Silo password, so it can't confirm a new link.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد لحسابك كلمة مرور Silo للتأكيد بها. اطلب من المسؤول ربط المزود."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš účet nemá heslo k Silo, kterým by šlo připojení potvrdit. Požádejte správce, aby poskytovatele připojil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din konto har ingen Silo-adgangskode at bekræfte med. Bed en administrator om at tilknytte udbyderen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto hat kein Silo-Passwort zur Bestätigung. Bitte einen Administrator, den Anbieter zu verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account has no Silo password to confirm with. Ask an administrator to connect the provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta no tiene contraseña de Silo con la que confirmar. Pide a un administrador que conecte el proveedor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tililläsi ei ole Silo-salasanaa vahvistusta varten. Pyydä ylläpitäjää yhdistämään palvelu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte n’a pas de mot de passe Silo permettant de confirmer. Demandez à un administrateur de connecter le fournisseur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš račun nema lozinku za Silo kojom biste potvrdili povezivanje. Zamolite administratora da poveže pružatelja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account non ha una password di Silo con cui confermare. Chiedi a un amministratore di collegare il provider."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントには確認に使うSiloのパスワードがありません。管理者にプロバイダーとの連携を依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정에 확인에 사용할 Silo 비밀번호가 없어요. 관리자에게 제공자 연결을 요청하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoen din har ikke noe Silo-passord å bekrefte med. Be en administrator om å koble til leverandøren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account heeft geen Silo-wachtwoord om mee te bevestigen. Vraag een beheerder om de provider te koppelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto nie ma hasła Silo do potwierdzenia. Poproś administratora o połączenie dostawcy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta não tem uma senha do Silo para confirmar. Peça a um administrador para conectar o provedor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вашего аккаунта нет пароля Silo для подтверждения. Попросите администратора подключить провайдер."
