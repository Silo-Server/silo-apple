          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terugvaltaal die Silo verkiest voor titels, beschrijvingen en artwork."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapasowy język, który Silo preferuje dla tytułów, opisów i grafik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idioma alternativo que o Silo prefere para títulos, descrições e artes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервный язык, который Silo предпочитает для названий, описаний и обложек."
