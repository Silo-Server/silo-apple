    "newProfile.preview" : {
      "comment" : "Roku and TV: small caption by the sample profile tile on the profile form; the tile updates live as the user types a name. Apple TV: same caption under the sample tile on the New Profile form.",
      "extractionState" : "manual",
      "localizations" : {
