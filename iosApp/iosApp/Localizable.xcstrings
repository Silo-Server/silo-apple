    "profiles.form.initialsDetail" : {
      "comment" : "TV: secondary line in the profile form's avatar section when the Initials style is chosen. Apple (iPhone, iPad, Mac, Apple TV): same line on the New Profile form when the Initials style is chosen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الأحرف الأولى من الاسم أدناه على مربعك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Първите букви от името по-долу се показват на плочката ви."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les primeres lletres del nom de sota apareixen a la teva icona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na vaší dlaždici se zobrazí počáteční písmena názvu níže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De første bogstaver i navnet nedenfor vises på dit felt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anfangsbuchstaben des Namens unten erscheinen auf deiner Kachel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα πρώτα γράμματα του παρακάτω ονόματος εμφανίζονται στο πλακίδιό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first letters of the name below appear on your tile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las primeras letras del nombre de abajo aparecen en tu mosaico."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allpool oleva nime esitähed kuvatakse teie paanil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla olevan nimen alkukirjaimet näkyvät ruudussasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les initiales du nom ci-dessous apparaissent sur votre vignette."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האותיות הראשונות של השם שלמטה יופיעו באריח שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीचे दिए गए नाम के पहले अक्षर आपकी टाइल पर दिखते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Početna slova imena u nastavku prikazuju se na vašoj pločici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alábbi név kezdőbetűi jelennek meg a csempén."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huruf pertama dari nama di bawah muncul di kotak profil Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le iniziali del nome qui sotto appaiono sul tuo riquadro."
          }
        },
        "ja" : {
          "stringUnit" : {
