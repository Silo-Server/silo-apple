    "downloads.options.includedMediaFooter" : {
      "comment" : "Apple iOS/macOS: Download Options sheet; footer of the Included Media section.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُختار الصوت والترجمة تلقائيًا للملف المحدد. تُحفظ الترجمات المتاحة للتشغيل دون اتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio und Untertitel werden für die gewählte Datei automatisch ausgewählt. Verfügbare Untertitel werden für die Offline-Wiedergabe gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio and subtitles are chosen automatically for the selected file. Available subtitles are saved for offline playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio y los subtítulos se eligen automáticamente para el archivo seleccionado. Los subtítulos disponibles se guardan para la reproducción sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio et les sous-titres sont choisis automatiquement pour le fichier sélectionné. Les sous-titres disponibles sont enregistrés pour la lecture hors ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したファイルの音声と字幕は自動的に選択されます。利用可能な字幕はオフライン再生用に保存されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O áudio e as legendas são escolhidos automaticamente para o arquivo selecionado. As legendas disponíveis são salvas para reprodução offline."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统会为所选文件自动选择音频和字幕。可用字幕会一并保存，供离线播放。"
          }
        }
      }
    },
