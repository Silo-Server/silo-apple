    "setup.recovery.stillUnreachable" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV) saved-server recovery screen: error after Try again when the server couldn't be reached.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال يتعذّر الوصول إلى هذا الخادم. لم تتغير معلومات تسجيل الدخول المحفوظة."
