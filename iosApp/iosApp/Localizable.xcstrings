    "diagnostics.prompt.uncleanShutdownHosted" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad, Apple TV), shown after a problem report is captured: message when one report is waiting. Reports go to Silo Diagnostics, the Silo project's hosted service; Silo Diagnostics is a product name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُغلق Silo بشكل سليم في المرة الأخيرة. قد يساعد إرسال تقرير تشخيص فريق Silo Diagnostics على فهم ما حدث."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последния път Silo не се изключи правилно. Изпращането на диагностичен отчет може да помогне на екипа на Silo Diagnostics да разбере какво се е случило."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no es va tancar correctament l’última vegada. Enviar un informe de diagnòstic pot ajudar l’equip de Silo Diagnostics a entendre què ha passat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
