    "downloads.settings.qualitySinglePresets" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; second sentence of the quality footer, when only single items can be downloaded in a preset and the server reports no resolutions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالنسبة إلى العناصر المفردة، تُجهَّز إعدادات معدل البت المسبقة على الخادم عندما يكون الملف الأصلي أكبر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За отделни елементи готовите настройки за битрейт се подготвят на сървъра, когато оригиналът е по-голям."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per als elements individuals, els valors predefinits de velocitat de bits es preparen al servidor quan l’original és més gran."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U jednotlivých položek se předvolby datového toku připravují na serveru, pokud je originál větší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For enkelte elementer forberedes forvalg for bitrate på serveren, når originalen er større."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einzelne Titel werden Bitraten-Voreinstellungen auf dem Server vorbereitet, wenn das Original größer ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για μεμονωμένα στοιχεία, οι προκαθορισμένοι ρυθμοί bit προετοιμάζονται στον διακομιστή όταν το αρχικό αρχείο είναι μεγαλύτερο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For single items, bitrate presets are prepared on the server when the original is larger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para elementos individuales, los ajustes predefinidos de tasa de bits se preparan en el servidor cuando el original es más grande."
