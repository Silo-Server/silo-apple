    "signIn.passwordChange.error.noSiloPassword" : {
      "comment" : "Apple (iPhone, iPad, Mac) and Android phone Choose a new password screen: error when the account signs in through a provider and has no Silo password to change.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسجّل هذا الحساب الدخول بكلمة مرور Silo. اطلب المساعدة من مسؤول الخادم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този акаунт не влиза с парола за Silo. Помолете администратора на сървъра за помощ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest compte no inicia la sessió amb una contrasenya de Silo. Demana ajuda a l’administrador del servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento účet k přihlášení nepoužívá heslo Silo. Požádejte o pomoc správce serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne konto logger ikke ind med en Silo-adgangskode. Bed din serveradministrator om hjælp."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto meldet sich nicht mit einem Silo-Passwort an. Bitte deinen Server-Admin um Hilfe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο λογαριασμός δεν συνδέεται με κωδικό πρόσβασης του Silo. Ζητήστε βοήθεια από τον διαχειριστή του διακομιστή."
          }
        },
        "en" : {
