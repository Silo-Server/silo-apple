    "settingsManifest.player.resume_rewind_seconds.description" : {
      "comment" : "Help text under the player.resume_rewind_seconds setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرجوع هذا القدر عند استئناف عنصر شوهد جزئيًا، لاستعادة السياق. القيمة 0 تعطّل هذا الخيار."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превърта назад с толкова при продължаване на частично гледан елемент, за да си припомните контекста. 0 го изключва."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrocedeix aquesta estona en reprendre un element vist parcialment, per recuperar el context. Amb 0 es desactiva."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při pokračování v částečně zhlédnuté položce se o tolik přetočí zpět, abyste se znovu zorientovali. Hodnota 0 tuto funkci vypne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spol så langt tilbage, når du genoptager noget, der er delvist set, så du kommer ind i handlingen igen. 0 slår det fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Fortsetzen eines teilweise angesehenen Titels so weit zurückspulen, um wieder in die Handlung zu finden. 0 schaltet es aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακίνηση πίσω κατά αυτό το διάστημα κατά τη συνέχιση ενός στοιχείου που έχετε δει εν μέρει, ώστε να θυμηθείτε πού είχατε μείνει. Με 0 απενεργοποιείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip back this far when resuming a partly watched item, to re-establish context. 0 turns it off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrocede esta cantidad al reanudar un elemento visto en parte, para retomar el contexto. Con 0 se desactiva."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pooleli jäänud üksuse jätkamisel kerib nii palju tagasi, et sisu meelde tuletada. 0 lülitab selle välja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelaa näin paljon taaksepäin, kun jatkat osittain katsottua kohdetta, jotta pääset taas juonesta kiinni. 0 poistaa toiminnon käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reculer d’autant lors de la reprise d’un élément partiellement regardé, pour retrouver le fil. 0 désactive cette option."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דילוג אחורה בטווח הזה בהמשך הפעלה של פריט שנצפה חלקית, כדי להיזכר בהקשר. הערך 0 מכבה את האפשרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आंशिक रूप से देखे गए टाइटल को जारी रखते समय, संदर्भ याद दिलाने के लिए इतना पीछे जाएँ। 0 पर यह बंद रहता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri nastavku djelomično pogledane stavke vraća se ovoliko unatrag kako biste se prisjetili konteksta. 0 isključuje ovu opciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy részben megnézett elem folytatásakor ennyit teker vissza, hogy újra képbe kerüljön. 0 esetén kikapcsolva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mundur sejauh ini saat melanjutkan item yang sebagian sudah ditonton, untuk mengingat kembali konteksnya. 0 menonaktifkannya."
