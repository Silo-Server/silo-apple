    "collections.error.unconfirmedChange" : {
      "comment" : "Apple iOS and tvOS: error in a collection or group sheet when the answer to an edit was lost. Reload is the button below it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo تأكيد هذا التغيير. أعد التحميل للتحقق مما إذا كان قد حُفظ قبل المحاولة مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte diese Änderung nicht bestätigen. Lade neu, um zu prüfen, ob sie gespeichert wurde, bevor du es erneut versuchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn't confirm this change. Reload to check whether it was saved before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo confirmar este cambio. Recarga para comprobar si se guardó antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a pas pu confirmer cette modification. Rechargez pour vérifier si elle a été enregistrée avant de réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloはこの変更を確認できませんでした。もう一度お試しになる前に、再読み込みして保存されたかどうかを確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo não conseguiu confirmar esta alteração. Recarregue para verificar se ela foi salva antes de tentar novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo无法确认此更改。请重新加载，检查是否已保存，然后再重试。"
          }
        }
      }
    },
