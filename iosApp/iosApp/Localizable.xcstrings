    "collections.emptyLibraryHint" : {
      "comment" : "Supporting line on a library's Collections screen when the library has no collections; says where to create them (Android phone, Apple iOS and tvOS).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ مجموعات المكتبة في تطبيق الويب لعرض رفوف منسّقة هنا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създайте колекции за библиотеката в уеб приложението, за да показвате подбрани рафтове тук."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea col·leccions de biblioteca a l’aplicació web per mostrar aquí prestatges seleccionats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte kolekce knihovny ve webové aplikaci a zobrazte zde vybrané řady titulů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret bibliotekssamlinger i webappen for at vise udvalgte hylder her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle Mediathek-Sammlungen in der Web-App, um hier kuratierte Regale anzuzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε συλλογές βιβλιοθήκης στην εφαρμογή web για να εμφανίζονται εδώ επιμελημένα ράφια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create library collections in the web app to feature curated shelves here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea colecciones de biblioteca en la aplicación web para destacar aquí estantes seleccionados."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looge meediakogu kollektsioone veebirakenduses, et siin valitud sisuga riiuleid esile tõsta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo kirjastokokoelmia verkkosovelluksessa, niin valikoidut hyllyt näkyvät täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez des collections de bibliothèque dans l’application web pour mettre en avant des sélections ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר ליצור אוספי ספרייה באפליקציית האינטרנט כדי להציג כאן מדפים נבחרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनी हुई शेल्फ़ यहाँ दिखाने के लिए वेब ऐप में लाइब्रेरी कलेक्शन बनाएँ।"
