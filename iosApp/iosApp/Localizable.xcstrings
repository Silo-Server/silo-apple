    "downloads.settings.cleanupFooter" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; footer under Keep watched downloads on iPhone and iPad.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تعطيل هذا الخيار، يقترح تبويب «التنزيلات» تحرير المساحة بإزالة العناصر التي أنهيت مشاهدتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Option aus ist, schlägt der Tab „Downloads“ vor, Speicherplatz freizugeben, indem Titel entfernt werden, die du fertig angesehen hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, the Downloads tab suggests freeing up space by removing items you've finished watching."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, la pestaña Descargas sugiere liberar espacio quitando lo que ya terminaste de ver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est désactivée, l’onglet Téléchargements suggère de libérer de l’espace en retirant les éléments que vous avez fini de regarder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、ダウンロードタブで視聴済みの項目を削除して空き容量を増やすよう提案されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando desativado, a aba Downloads sugere liberar espaço removendo os itens que você terminou de assistir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，下载标签页会建议你移除已看完的内容以释放空间。"
          }
        }
      }
    },
