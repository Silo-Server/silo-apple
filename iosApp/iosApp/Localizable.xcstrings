    "tvPairing.failedDenied" : {
      "comment" : "Android TV failure message when the phone's sign-in was declined. {server}: the server name. Apple TV: same message on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم رفض تسجيل الدخول إلى %1$@. حاول مرة أخرى من هاتفك أو جهازك اللوحي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
