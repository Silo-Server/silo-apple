    "watchParty.banner.hostAway" : {
      "comment" : "Roku: warning banner in the lobby when the host's connection dropped. {host}: the host's display name. Apple (iPhone, iPad, Apple TV): same warning banner in the lobby for guests. Android phone and TV Watch Party lobby: same banner for a guest. 1: the host's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع اتصال %1$@. تنتظر Watch Party لمدة دقيقتين ريثما يعود."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Домакинът %1$@ загуби връзка. Watch Party ще изчака две минути, докато се върне."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha perdut la connexió. La Watch Party s’espera dos minuts mentre torna."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostitel %1$@ ztratil připojení. Watch Party počká dvě minuty, než se hostitel vrátí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ mistede forbindelsen. Festen venter i to minutter på, at %1$@ kommer tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat die Verbindung verloren. Die Watch Party wartet zwei Minuten auf die Rückkehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ έχασε τη σύνδεση. Το Watch Party διατηρείται για δύο λεπτά, ώστε να επιστρέψει ο οικοδεσπότης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ lost connection. The party holds for two minutes while they come back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ perdió la conexión. La Watch Party espera dos minutos a que vuelva."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kaotas ühenduse. Watch Party ootab kaks minutit, et korraldaja saaks naasta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ menetti yhteyden. Watch Party pysyy auki kaksi minuuttia, jotta järjestäjä ehtii palata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a perdu la connexion. La Watch Party est maintenue deux minutes pour lui laisser le temps de revenir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיבור של המארח %1$@ נותק. ה-Watch Party יישמר למשך שתי דקות עד לחזרת המארח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ का कनेक्शन टूट गया। %1$@ के लौटने तक पार्टी दो मिनट रुकी रहेगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza s osobom %1$@ je prekinuta. Party čeka dvije minute da se vrati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kapcsolata megszakadt. A Watch Party két percig vár a visszatérésére."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kehilangan koneksi. Watch Party ditahan selama dua menit sambil menunggu dia kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha perso la connessione. Il party resta attivo per due minuti in attesa del rientro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@さんの接続が切れました。戻るまでWatch Partyは2分間待機します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@님의 연결이 끊어졌어요. 다시 연결될 때까지 Watch Party가 2분 동안 유지돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ prarado ryšį. „Watch Party“ palaikomas dvi minutes, kol organizatorius grįš."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ zaudēja savienojumu. Watch Party gaidīs divas minūtes, kamēr rīkotājs atgriezīsies."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ terputus sambungan. Watch Party ditahan selama dua minit sementara menunggu dia kembali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ mistet tilkoblingen. Watch Party venter i to minutter på at verten kommer tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft geen verbinding meer. De party wacht twee minuten zodat %1$@ terug kan komen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba prowadząca %1$@ straciła połączenie. Watch Party czeka dwie minuty na powrót tej osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ perdeu a conexão. A Watch Party aguarda dois minutos pelo retorno."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ perdeu a ligação. A Watch Party fica em espera durante dois minutos até que regresse."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a pierdut conexiunea. Watch Party-ul se menține două minute, cât timp gazda revine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Организатор %1$@ отключился. Watch Party подождёт две минуты, пока организатор не вернётся."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostiteľ %1$@ stratil spojenie. Watch Party počká dve minúty, kým sa vráti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostitelj %1$@ je izgubil povezavo. Watch Party počaka dve minuti, da se vrne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tappade anslutningen. Watch Partyn väntar i två minuter så att värden kan återansluta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ขาดการเชื่อมต่อ ปาร์ตี้จะรอให้ %1$@ กลับมาเป็นเวลา 2 นาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bağlantıyı kaybetti. Geri dönebilmesi için parti iki dakika bekletilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З’єднання з %1$@ втрачено. Watch Party чекатиме на повернення дві хвилини."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đã mất kết nối. Watch Party sẽ được giữ trong hai phút để chờ họ quay lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@已断开连接。Watch Party会保留两分钟，等待其重新连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已中斷連線。Watch Party 會保留兩分鐘，等待主持人重新連線。"
          }
        }
      }
    },
