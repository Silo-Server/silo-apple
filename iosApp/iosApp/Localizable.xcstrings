        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器未接受此更改（HTTP %1$@）。"
          }
        }
      }
    },
    "settings.profilePrefs.serverUpgrade" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac, Apple TV): warning when the server predates the settings this screen saves.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الخادم قديم جدًا ولا يمكنه تخزين تفضيلات التشغيل. يظل التشغيل يعمل باستخدام الإعدادات الافتراضية لهذا الجهاز. اطلب من مسؤول الخادم تحديث Silo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server ist zu alt, um Wiedergabeeinstellungen zu speichern. Die Wiedergabe funktioniert weiterhin mit den Standardwerten dieses Geräts. Bitte die Person, die deinen Server verwaltet, Silo zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server is too old to store playback preferences. Playback still works using this device's defaults. Ask your server administrator to update Silo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor es demasiado antiguo para guardar preferencias de reproducción. La reproducción sigue funcionando con la configuración predeterminada de este dispositivo. Pide a quien administra tu servidor que actualice Silo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur est trop ancien pour enregistrer les préférences de lecture. La lecture fonctionne toujours avec les valeurs par défaut de cet appareil. Demandez à l’administrateur de votre serveur de mettre à jour Silo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーは古いため、再生の設定を保存できません。再生はこのデバイスのデフォルトで引き続き利用できます。Siloを更新するようサーバー管理者に依頼してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor é antigo demais para armazenar preferências de reprodução. A reprodução continua funcionando com os padrões deste dispositivo. Peça ao administrador do servidor para atualizar o Silo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器版本过旧，无法存储播放偏好。播放仍可使用此设备的默认设置。请让你的服务器管理员更新Silo。"
          }
        }
      }
    },
