    "player.subtitles.builtInStylingNote" : {
      "comment" : "Apple iOS: note under the device settings switches on the Subtitle Appearance page of the iPhone and iPad player settings sheet while Use device settings is off.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ الترجمات ذات التنسيق المدمج بمظهرها الأصلي؛ وتحتفظ الترجمات المعتمدة على الصور بخطوطها وألوانها الأصلية لكنها تتبع إعدادات الحجم والموضع والخلفية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel mit eigener integrierter Formatierung behalten ihr ursprüngliches Aussehen; bildbasierte Untertitel behalten ihre vorgegebenen Schriftarten und Farben, folgen aber den Einstellungen für Größe, Position und Hintergrund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitles with their own built-in styling keep their original appearance; image-based subtitles keep their authored fonts and colors but follow the size, position, and background settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos con estilo propio integrado conservan su apariencia original; los subtítulos basados en imágenes conservan sus fuentes y colores originales, pero siguen la configuración de tamaño, posición y fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres dotés de leur propre style intégré conservent leur apparence d’origine ; les sous-titres en image conservent leurs polices et couleurs d’origine, mais suivent les paramètres de taille, de position et d’arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独自のスタイルが組み込まれた字幕は元の表示を維持します。画像ベースの字幕は作成時のフォントと色を維持しますが、サイズ、位置、背景の設定に従います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legendas com estilo próprio mantêm a aparência original; legendas baseadas em imagem mantêm as fontes e cores originais, mas seguem as configurações de tamanho, posição e fundo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自带内置样式的字幕会保留原有外观；图像字幕会保留原有字体和颜色，但会遵循大小、位置和背景设置。"
          }
        }
      }
    },
