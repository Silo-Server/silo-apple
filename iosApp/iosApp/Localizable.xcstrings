    "tvPairing.consentDetailAppleTv" : {
      "comment" : "Apple TV pairing screen (shown while a nearby phone sets up or signs in this Apple TV): body of the Allow screen. {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يريد هاتف أو جهاز لوحي قريب تسجيل الدخول على جهاز Apple TV هذا إلى %1$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon nebo tablet v okolí chce toto Apple TV přihlásit k serveru %1$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En telefon eller tablet i nærheden vil logge dette Apple TV ind på %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Smartphone oder Tablet in der Nähe möchte dieses Apple TV bei %1$@ anmelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nearby phone or tablet wants to sign this Apple TV in to %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un teléfono o tableta cercano quiere iniciar sesión en %1$@ desde este Apple TV."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähellä oleva puhelin tai tabletti haluaa kirjautua tällä Apple TV:llä palvelimelle %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un téléphone ou une tablette à proximité souhaite connecter cette Apple TV à %1$@."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon ili tablet u blizini želi prijaviti ovaj Apple TV na poslužitelj %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un telefono o tablet vicino vuole far accedere questa Apple TV a %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くのスマートフォンまたはタブレットが、このApple TVを%1$@にサインインしようとしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근처 휴대폰이나 태블릿에서 이 Apple TV를 %1$@ 서버에 로그인하려고 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En telefon eller et nettbrett i nærheten vil logge denne Apple TV-en på %1$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een telefoon of tablet in de buurt wil deze Apple TV laten inloggen bij %1$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon lub tablet w pobliżu chce zalogować to urządzenie Apple TV do serwera %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um celular ou tablet próximo quer conectar esta Apple TV a %1$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон или планшет поблизости запрашивает вход на сервер %1$@ на этом Apple TV."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
