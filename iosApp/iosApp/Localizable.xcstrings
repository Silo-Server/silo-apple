    "tvPair.link.addServerBody" : {
      "comment" : "Apple (iPhone, iPad) device approval from a link: body under \"Add this server?\". {host}: the server's host name (for example media.example.com).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينتمي هذا الرمز إلى %1$@، وهو غير موجود على هذا الجهاز بعد. أضفه وسجّل الدخول للموافقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този код принадлежи на сървъра %1$@, който още не е добавен на това устройство. Добавете го и влезте, за да одобрите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest codi pertany al servidor %1$@, que encara no és en aquest dispositiu. Afegeix-lo i inicia la sessió per aprovar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento kód patří k serveru %1$@, který na tomto zařízení zatím není. Chcete-li ho schválit, přidejte server a přihlaste se."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne kode hører til %1$@, som ikke er på denne enhed endnu. Tilføj den, og log ind for at godkende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Code gehört zu %1$@, der noch nicht auf diesem Gerät eingerichtet ist. Füge ihn hinzu und melde dich an, um zu genehmigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο κωδικός ανήκει στον διακομιστή %1$@, ο οποίος δεν υπάρχει ακόμη σε αυτή τη συσκευή. Προσθέστε τον και συνδεθείτε για να εγκρίνετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This code belongs to %1$@, which isn't on this device yet. Add it and sign in to approve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código pertenece a %1$@, que aún no está en este dispositivo. Añádelo e inicia sesión para aprobar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See kood kuulub hostile %1$@, mida selles seadmes veel pole. Kinnitamiseks lisage see ja logige sisse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä koodi kuuluu palvelimelle %1$@, jota ei ole vielä tässä laitteessa. Lisää se ja kirjaudu sisään, jotta voit hyväksyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code appartient à %1$@, qui n’est pas encore sur cet appareil. Ajoutez-le et connectez-vous pour approuver."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקוד הזה שייך לשרת %1$@, שעדיין לא נוסף למכשיר הזה. יש להוסיף אותו ולהתחבר כדי לאשר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह कोड सर्वर %1$@ का है, जो अभी इस डिवाइस पर नहीं है। मंज़ूरी देने के लिए इसे जोड़ें और साइन इन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj kôd pripada poslužitelju %1$@, koji još nije na ovom uređaju. Dodajte ga i prijavite se da biste odobrili prijavu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a kód ehhez a szerverhez tartozik: %1$@, amely még nincs ezen az eszközön. Adja hozzá, és jelentkezzen be a jóváhagyáshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kode ini milik %1$@, yang belum ada di perangkat ini. Tambahkan server itu dan masuk untuk menyetujui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo codice appartiene a %1$@, un server non ancora presente su questo dispositivo. Aggiungilo e accedi per approvare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコードは%1$@のものですが、このデバイスにはまだ追加されていません。追加してサインインしてから承認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 코드는 %1$@ 서버의 코드인데, 이 서버가 아직 이 기기에 없어요. 서버를 추가하고 로그인한 다음 승인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis kodas priklauso serveriui %1$@, kurio šiame įrenginyje dar nėra. Pridėkite jį ir prisijunkite, kad patvirtintumėte."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis kods pieder serverim %1$@, kas šajā ierīcē vēl nav pievienots. Pievienojiet to un pierakstieties, lai apstiprinātu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod ini milik %1$@, yang belum ada pada peranti ini. Tambah pelayan itu dan log masuk untuk meluluskan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne koden tilhører %1$@, som ikke er på denne enheten ennå. Legg den til og logg på for å godkjenne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze code hoort bij %1$@, die nog niet op dit apparaat staat. Voeg de server toe en log in om goed te keuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten kod należy do serwera %1$@, którego nie ma jeszcze na tym urządzeniu. Dodaj go i zaloguj się, aby zatwierdzić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código pertence a %1$@, que ainda não está neste dispositivo. Adicione o servidor e entre para aprovar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código pertence ao servidor %1$@, que ainda não está neste dispositivo. Adicione-o e inicie sessão para aprovar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest cod aparține serverului %1$@, care nu este încă pe acest dispozitiv. Adăugați serverul și conectați-vă pentru a aproba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот код относится к серверу %1$@, которого ещё нет на этом устройстве. Добавьте его и войдите, чтобы подтвердить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento kód patrí serveru %1$@, ktorý v tomto zariadení zatiaľ nie je. Ak ho chcete schváliť, pridajte server a prihláste sa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta koda pripada strežniku %1$@, ki ga v tej napravi še ni. Dodajte ga in se prijavite, da odobrite prijavo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koden hör till %1$@, som inte finns på den här enheten än. Lägg till servern och logga in för att godkänna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รหัสนี้เป็นของเซิร์ฟเวอร์ %1$@ ซึ่งยังไม่มีในอุปกรณ์นี้ โปรดเพิ่มเซิร์ฟเวอร์และลงชื่อเข้าใช้เพื่ออนุมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kod %1$@ sunucusuna ait ve bu sunucu henüz bu cihazda yok. Onaylamak için sunucuyu ekleyip oturum açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей код належить серверу %1$@, якого ще немає на цьому пристрої. Додайте його та ввійдіть, щоб схвалити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã này thuộc về %1$@, máy chủ chưa có trên thiết bị này. Thêm máy chủ đó và đăng nhập để phê duyệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此代码属于%1$@，但此设备上还没有该服务器。请添加并登录，然后批准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此代碼屬於 %1$@，但此裝置上尚未新增該伺服器。請新增並登入以核准。"
          }
        }
      }
    },
