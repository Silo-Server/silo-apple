    "player.aiTranslate.explainer" : {
      "comment" : "Apple iOS: footer under the language list of the iPhone and iPad AI subtitles sheet. Silo is the app name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر لغة. يترجم Silo ترجمة موجودة عندما يستطيع، أو ينسخ الصوت إلى نص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Sprache. Silo übersetzt nach Möglichkeit vorhandene Untertitel oder transkribiert den Ton."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a language. Silo translates an existing subtitle when it can, or transcribes the audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un idioma. Silo traduce un subtítulo existente cuando puede o transcribe el audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une langue. Silo traduit un sous-titre existant lorsque c’est possible, ou transcrit l’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語を選択してください。Siloは可能な場合は既存の字幕を翻訳し、それ以外は音声を文字起こしします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um idioma. O Silo traduz uma legenda existente quando possível ou transcreve o áudio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一种语言。Silo会尽量翻译现有字幕，否则转录音频。"
          }
        }
      }
    },
