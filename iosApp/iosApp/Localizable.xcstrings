    "settingsManifest.playback.next_up_prompt_seconds.description" : {
      "comment" : "Help text under the playback.next_up_prompt_seconds setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المدة قبل نهاية الحلقة التي يظهر فيها تنبيه الحلقة التالية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колко време преди края на епизода се появява подканата за следващия епизод."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quant de temps abans del final d’un episodi apareix l’avís de l’episodi següent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak dlouho před koncem dílu se zobrazí výzva „Další díl“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor længe før et afsnits slutning beskeden om næste afsnit vises."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange vor dem Ende einer Folge der Hinweis auf die nächste Folge erscheint."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσο πριν από το τέλος ενός επεισοδίου εμφανίζεται η ειδοποίηση για το επόμενο επεισόδιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long before the end of an episode the next-up prompt appears."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto tiempo antes del final de un episodio aparece el aviso del siguiente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui palju enne osa lõppu ilmub järgmise osa viip."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka kauan ennen jakson loppua seuraavan jakson kehote tulee näkyviin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien de temps avant la fin d’un épisode l’invite de l’épisode suivant apparaît."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה זמן לפני סוף הפרק תופיע ההודעה על הפרק הבא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एपिसोड खत्म होने से कितनी देर पहले अगले एपिसोड का प्रॉम्प्ट दिखे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko se prije kraja epizode pojavljuje upit za sljedeću epizodu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mennyivel az epizód vége előtt jelenjen meg a következő epizódra vonatkozó ajánlat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seberapa awal sebelum episode berakhir pemberitahuan Episode berikutnya muncul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo prima della fine di un episodio compare l’avviso del prossimo episodio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エピソードの終了の何秒前に次のエピソードの案内を表示するかを設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에피소드가 끝나기 얼마 전에 다음 에피소드 알림을 표시할지 정해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiek laiko iki epizodo pabaigos parodomas kito epizodo pasiūlymas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cik ilgi pirms epizodes beigām parādās uzvedne par nākamo epizodi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa lama sebelum episod tamat gesaan episod seterusnya dipaparkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor lenge før slutten av en episode varselet om neste episode vises."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe lang voor het einde van een aflevering de melding voor de volgende aflevering verschijnt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak długo przed końcem odcinka pojawia się podpowiedź o następnym odcinku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo antes do fim de um episódio o aviso de próximo episódio aparece."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo antes do fim de um episódio aparece o aviso do episódio seguinte."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cu cât timp înainte de finalul unui episod apare mesajul pentru episodul următor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За сколько до конца серии появляется предложение посмотреть следующую."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako dlho pred koncom epizódy sa zobrazí výzva na ďalšiu epizódu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko pred koncem epizode se prikaže poziv za naslednjo epizodo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur långt före slutet av ett avsnitt uppmaningen om nästa avsnitt visas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระยะเวลาก่อนจบตอนที่ข้อความแจ้งตอนถัดไปจะปรากฏ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıradaki bölüm isteminin, bölümün bitiminden ne kadar önce görüneceği."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За скільки до кінця епізоду з’являється підказка з наступним епізодом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lời nhắc Tập tiếp theo xuất hiện bao lâu trước khi tập kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一集结束前多久显示接下来提示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一集結束前多久顯示「接下來」提示。"
          }
        }
      }
    },
