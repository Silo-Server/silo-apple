        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте код камерой телефона или откройте страницу /activate на вашем сервере и введите его. Подтвердите вход на телефоне, и этот Apple TV войдёт автоматически."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanna koden med telefonens kamera, eller gå till sidan /activate på din server och ange den. Godkänn på telefonen så loggar den här Apple TV:n in automatiskt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodu telefonunuzun kamerasıyla tarayın veya sunucunuzun /activate sayfasına gidip kodu girin. Telefonunuzda onaylayın, bu Apple TV kendiliğinden oturum açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відскануйте код камерою телефона або перейдіть на сторінку /activate вашого сервера й введіть його. Підтвердьте вхід на телефоні, і цей Apple TV увійде автоматично."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手机相机扫描代码，或前往你的服务器的/activate页面输入代码。在手机上批准后，这台Apple TV会自动登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手機相機掃描代碼，或前往你伺服器的 /activate 頁面輸入代碼。在手機上核准後，這台 Apple TV 就會自動登入。"
          }
        }
      }
    },
    "tvSignIn.appleTv.noCodeBody" : {
      "comment" : "Apple TV sign-in screen: card text when the TV can sign in through a network sign-in provider with no code or password. {server}: the server's name; {provider}: the provider's name, such as Tailscale.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل Apple TV هذا إلى %1$@ عبر %2$@، الذي يعرف مالكه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV se k serveru %1$@ připojuje přes poskytovatele %2$@, který ví, komu patří."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette Apple TV har forbindelse til %1$@ via %2$@, som ved, hvem det tilhører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Apple TV hat %1$@ über %2$@ erreicht, wodurch bekannt ist, wem es gehört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Apple TV reached %1$@ through %2$@, which knows who it belongs to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Apple TV se conectó a %1$@ a través de %2$@, que sabe a quién pertenece."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä Apple TV yhdisti palvelimeen %1$@ palvelun %2$@ kautta. Palvelu tietää, kenen laite on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette Apple TV a joint %1$@ via %2$@, qui sait à qui elle appartient."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj Apple TV pristupio je poslužitelju %1$@ putem usluge %2$@, koja zna komu pripada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa Apple TV ha raggiunto %1$@ tramite %2$@, che sa a chi appartiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVは、所有者を識別できる%2$@を経由して%1$@に接続しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple TV는 %2$@ 네트워크를 통해 %1$@ 서버에 연결됐고, 이 네트워크가 기기의 소유자를 알고 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Apple TV-en nådde %1$@ via %2$@, som vet hvem den tilhører."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Apple TV heeft %1$@ bereikt via %2$@, die weet van wie hij is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To Apple TV połączyło się z serwerem %1$@ przez usługę %2$@, która wie, czyje jest to urządzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta Apple TV acessou %1$@ por meio de %2$@, que sabe a quem ela pertence."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Apple TV подключён к серверу %1$@ через %2$@, и провайдеру известно, кому он принадлежит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här Apple TV:n nådde %1$@ via %2$@, som vet vem den tillhör."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Apple TV, %1$@ sunucusuna %2$@ aracılığıyla ulaştı ve %2$@ cihazın kime ait olduğunu biliyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей Apple TV під’єднався до сервера %1$@ через %2$@, а цей постачальник знає, чий це пристрій."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台Apple TV通过%2$@访问%1$@，%2$@知道它属于谁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台 Apple TV 是透過 %2$@ 連上 %1$@，而 %2$@ 知道這台裝置屬於誰。"
          }
        }
      }
    },
