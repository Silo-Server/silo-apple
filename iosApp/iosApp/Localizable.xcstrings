          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premikanje telefona ne zasuka več videoposnetka. Gumb za sukanje še vedno deluje"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindrar videon från att rotera när telefonen rör sig. Rotationsknappen fungerar fortfarande"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยุดไม่ให้วิดีโอหมุนตามการเคลื่อนไหวของโทรศัพท์ ปุ่มหมุนยังใช้งานได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon hareketinin videoyu döndürmesini engeller. Döndürme düğmesi çalışmaya devam eder"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відео не повертатиметься під час руху телефона. Кнопка повороту працює й надалі"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video không xoay theo chuyển động của điện thoại. Nút xoay vẫn hoạt động"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
