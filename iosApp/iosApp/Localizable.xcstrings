    "settingsManifest.player.seek_cache_enabled.description" : {
      "comment" : "Help text under the player.seek_cache_enabled setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاحتفاظ بالمقاطع التي شُغّلت مؤخرًا في التخزين المؤقت لتنقل أسرع."
          }
        },
        "de" : {
          "stringUnit" : {
