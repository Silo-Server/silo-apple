    "account.signOut.leaves" : {
      "comment" : "Apple TV: message of the sign-out confirmation when other accounts still use the server. {device}: the device's product name (Apple TV).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال الملفات الشخصية والإعدادات الخاصة بهذا الحساب من جهاز %1$@ هذا. يبقى الخادم محفوظًا، لذا يمكنك تسجيل الدخول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профилите и настройките на този акаунт ще бъдат премахнати от това устройство %1$@. Сървърът остава запазен, така че можете да влезете отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els perfils i la configuració d’aquest compte s’eliminaran d’aquest %1$@. El servidor continuarà desat, així que podràs tornar a iniciar la sessió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profily a nastavení tohoto účtu budou z tohoto zařízení %1$@ odebrány. Server zůstane uložený, takže se můžete znovu přihlásit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne kontos profiler og indstillinger fjernes fra dette %1$@. Serveren forbliver gemt, så du kan logge ind igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Profile und Einstellungen dieses Kontos werden von diesem %1$@ entfernt. Der Server bleibt gespeichert, sodass du dich erneut anmelden kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα προφίλ και οι ρυθμίσεις αυτού του λογαριασμού θα αφαιρεθούν από αυτήν τη συσκευή %1$@. Ο διακομιστής παραμένει αποθηκευμένος, ώστε να μπορείτε να συνδεθείτε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account's profiles and settings leave this %1$@. The server stays saved, so you can sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles y la configuración de esta cuenta se quitarán de este %1$@. El servidor seguirá guardado para que puedas volver a iniciar sesión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle konto profiilid ja seaded eemaldatakse sellest seadmest %1$@. Server jääb salvestatuks, nii et saate uuesti sisse logida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän tilin profiilit ja asetukset poistetaan laitteelta %1$@. Palvelin pysyy tallennettuna, joten voit kirjautua uudelleen sisään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils et paramètres de ce compte seront retirés de votre %1$@. Le serveur reste enregistré : vous pourrez vous reconnecter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפרופילים וההגדרות של החשבון הזה יוסרו מה-%1$@ הזה. השרת יישאר שמור, כך שאפשר להתחבר שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस खाते की प्रोफ़ाइलें और सेटिंग इस %1$@ से हट जाएँगी। सर्वर सेव रहेगा, ताकि आप फिर से साइन इन कर सकें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profili i postavke ovog računa uklanjaju se s ovog uređaja %1$@. Poslužitelj ostaje spremljen pa se možete ponovno prijaviti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiók profiljai és beállításai törlődnek erről az eszközről (%1$@). A szerver mentve marad, így újra bejelentkezhet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil dan pengaturan akun ini akan dihapus dari %1$@ ini. Server tetap disimpan, jadi Anda dapat masuk lagi."
          }
        },
        "it" : {
