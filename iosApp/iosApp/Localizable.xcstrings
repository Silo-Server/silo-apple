    "settings.subtitles.followsDevicePrefs" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac): footer under the profile's subtitle options while Use Device Settings is on. CC/SDH are caption types.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع اللغة وسلوك العرض والترجمة الإجبارية وتفضيل CC/SDH إعدادات «تسهيلات الاستخدام» على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache, Anzeigeverhalten, erzwungene Untertitel und die CC/SDH-Präferenz folgen den Bedienungshilfen dieses Geräts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Language, display behavior, forced captions, and CC/SDH preference follow this device's Accessibility settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma, el modo de visualización, los subtítulos forzados y la preferencia de CC/SDH siguen la configuración de Accesibilidad de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue, le comportement d’affichage, les sous-titres forcés et la préférence CC/SDH suivent les paramètres d’accessibilité de cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語、表示方法、強制字幕、CC/SDHの設定は、このデバイスのアクセシビリティ設定に従います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O idioma, o comportamento de exibição, as legendas forçadas e a preferência por CC/SDH seguem as configurações de Acessibilidade deste dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语言、显示方式、强制字幕和CC/SDH偏好遵循此设备的辅助功能设置。"
          }
        }
      }
    },
