    "setup.notReady.lead" : {
      "comment" : "Apple (iPhone, iPad, Mac) server needs setup screen: line under the headline.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من مسؤول الخادم إكمال الإعداد. عندما يصبح جاهزًا، عد إلى هنا وتحقق مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помолете администратора на сървъра да завърши настройката. Когато е готово, върнете се тук и проверете отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demana a l’administrador del servidor que acabi la configuració. Quan estigui a punt, torna aquí i comprova-ho de nou."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádejte správce serveru o dokončení nastavení. Až bude server připraven, vraťte se sem a zkontrolujte to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed serveradministratoren om at gøre konfigurationen færdig. Når den er klar, så vend tilbage hertil, og tjek igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte die Person, die den Server verwaltet, die Einrichtung abzuschließen. Wenn er bereit ist, kehre hierher zurück und prüfe erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήστε από τον διαχειριστή του διακομιστή να ολοκληρώσει τη ρύθμιση. Όταν είναι έτοιμος, επιστρέψτε εδώ και ελέγξτε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the server administrator to finish setup. When it's ready, return here and check again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide al administrador del servidor que termine la configuración. Cuando esté listo, vuelve aquí y compruébalo de nuevo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paluge serveri administraatoril seadistamine lõpetada. Kui server on valmis, naaske siia ja kontrollige uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydä palvelimen ylläpitäjää viimeistelemään käyttöönotto. Kun palvelin on valmis, palaa tänne ja tarkista uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à la personne qui administre le serveur de terminer la configuration. Quand le serveur sera prêt, revenez ici et vérifiez à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבקש ממנהל השרת להשלים את ההגדרה. כשהשרת יהיה מוכן, אפשר לחזור לכאן ולבדוק שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर एडमिनिस्ट्रेटर से सेटअप पूरा करने को कहें। सर्वर तैयार होने पर यहाँ लौटें और फिर से जाँचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamolite administratora poslužitelja da dovrši postavljanje. Kad bude spreman, vratite se ovamo i provjerite ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérje meg a szerver rendszergazdáját, hogy fejezze be a beállítást. Ha elkészült, térjen vissza ide, és ellenőrizze újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta administrator server untuk menyelesaikan penyiapan. Setelah siap, kembali ke sini dan periksa lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi a chi amministra il server di completare la configurazione. Quando è pronto, torna qui e controlla di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの管理者にセットアップの完了を依頼してください。準備ができたら、ここに戻ってもう一度確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 관리자에게 설정을 완료해 달라고 요청하세요. 준비되면 여기로 돌아와서 다시 확인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paprašykite serverio administratoriaus užbaigti sąranką. Kai serveris bus paruoštas, grįžkite čia ir patikrinkite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lūdziet servera administratoram pabeigt iestatīšanu. Kad tas būs gatavs, atgriezieties šeit un pārbaudiet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta pentadbir pelayan menyelesaikan persediaan. Apabila sudah sedia, kembali ke sini dan semak lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be serveradministratoren om å fullføre konfigureringen. Når den er klar, kommer du tilbake hit og sjekker igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag de serverbeheerder om het instellen af te ronden. Kom terug en controleer het opnieuw zodra de server klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś administratora serwera o dokończenie konfiguracji. Gdy serwer będzie gotowy, wróć tutaj i sprawdź ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao administrador do servidor para concluir a configuração. Quando estiver pronto, volte aqui e verifique novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao administrador do servidor para concluir a configuração. Quando estiver pronto, volte aqui e verifique novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cereți administratorului serverului să finalizeze configurarea. Când serverul este gata, reveniți aici și verificați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите администратора сервера завершить настройку. Когда всё будет готово, вернитесь сюда и проверьте ещё раз."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požiadajte správcu servera, aby dokončil nastavenie. Keď bude server pripravený, vráťte sa sem a skontrolujte to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosite skrbnika strežnika, naj dokonča nastavitev. Ko bo strežnik pripravljen, se vrnite sem in preverite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be serverns administratör att slutföra konfigurationen. När servern är klar går du tillbaka hit och kontrollerar igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรดขอให้ผู้ดูแลเซิร์ฟเวอร์ตั้งค่าให้เสร็จ เมื่อพร้อมแล้วให้กลับมาที่นี่และตรวจสอบอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu yöneticisinden kurulumu tamamlamasını isteyin. Hazır olduğunda buraya dönüp tekrar kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросіть адміністратора сервера завершити налаштування. Коли все буде готово, поверніться сюди й перевірте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy nhờ quản trị viên máy chủ hoàn tất thiết lập. Khi máy chủ sẵn sàng, quay lại đây và kiểm tra lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请让服务器管理员完成设置。准备就绪后，返回此处再次检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請要求伺服器管理員完成設定。準備就緒後，再回到這裡重新檢查。"
          }
        }
      }
    },
