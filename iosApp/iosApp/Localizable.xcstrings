    "remote.reconnect.rokuHint" : {
      "comment" : "Apple iOS: Remote Control remote; hint under \"Reconnecting to …\" when the TV is a Roku.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من أن Silo مفتوح على جهاز Roku وأنه متصل بالشبكة نفسها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уверете се, че приложението Silo е отворено на Roku и че устройството е в същата мрежа."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprova que Silo estigui obert al Roku i que sigui a la mateixa xarxa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujistěte se, že je na zařízení Roku otevřená aplikace Silo a že je ve stejné síti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for, at Silo er åben på Roku’en, og at den er på samme netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle sicher, dass Silo auf dem Roku geöffnet ist und er sich im selben Netzwerk befindet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βεβαιωθείτε ότι το Silo είναι ανοιχτό στο Roku και ότι αυτό βρίσκεται στο ίδιο δίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure Silo is open on the Roku and it's on the same network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que Silo esté abierto en el Roku y de que esté en la misma red."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veenduge, et Silo on Rokus avatud ja Roku on samas võrgus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmista, että Silo on auki Rokussa ja että Roku on samassa verkossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que Silo est ouvert sur le Roku et que celui-ci est sur le même réseau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לוודא ש-Silo פתוח ב-Roku ושה-Roku מחובר לאותה רשת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पक्का करें कि Roku पर Silo खुला है और वह उसी नेटवर्क पर है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjerite je li Silo otvoren na uređaju Roku i je li uređaj na istoj mreži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Győződjön meg arról, hogy a Silo meg van nyitva a Rokun, és az ugyanazon a hálózaton van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan Silo terbuka di Roku dan Roku berada di jaringan yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che Silo sia aperto sul Roku e che il Roku sia sulla stessa rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RokuでSiloが開いていて、同じネットワークに接続されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roku에서 Silo가 열려 있고 같은 네트워크에 연결되어 있는지 확인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įsitikinkite, kad „Roku“ įrenginyje atidaryta programa „Silo“ ir įrenginys prijungtas prie to paties tinklo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārliecinieties, ka Roku ierīcē ir atvērta Silo lietotne un ierīce ir tajā pašā tīklā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan Silo dibuka pada Roku dan Roku berada pada rangkaian yang sama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroller at Silo er åpen på Roku-enheten, og at den er på samme nettverk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg dat Silo geopend is op de Roku en dat de Roku op hetzelfde netwerk zit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upewnij się, że aplikacja Silo jest otwarta na urządzeniu Roku i że jest ono w tej samej sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se o Silo está aberto no Roku e se ele está na mesma rede."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique-se de que o Silo está aberto no Roku e que este está na mesma rede."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigurați-vă că Silo este deschis pe Roku și că dispozitivul este în aceeași rețea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что на Roku открыто приложение Silo и устройство подключено к той же сети."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skontrolujte, či je na zariadení Roku otvorená aplikácia Silo a či je v rovnakej sieti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preverite, ali je aplikacija Silo odprta v napravi Roku in ali je naprava v istem omrežju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollera att Silo är öppet på Roku-enheten och att den är på samma nätverk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบว่าเปิด Silo บน Roku อยู่ และ Roku เชื่อมต่อเครือข่ายเดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roku’da Silo’nun açık olduğundan ve aynı ağda olduğundan emin olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переконайтеся, що Silo відкрито на Roku і він у тій самій мережі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đảm bảo Silo đang mở trên Roku và Roku dùng cùng mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
