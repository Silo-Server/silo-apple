    "error.break_glass_required" : {
      "comment" : "Error message shown when the server answers with the v2 problem type `break_glass_required` (server title: \"Break-glass account required\"). Clients show it instead of the server's English detail in a translated interface, so it must make sense on its own, without the request's specifics.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ مسؤولًا واحدًا على الأقل يمكنه تسجيل الدخول بكلمة المرور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens ein Administratorkonto muss sich weiterhin mit einem Passwort anmelden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep at least one administrator who can sign in with a password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén al menos un administrador que pueda iniciar sesión con contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez au moins un administrateur pouvant se connecter avec un mot de passe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードでサインインできる管理者を少なくとも1人残してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pelo menos um administrador que possa entrar com senha."
          }
        },
        "zh-Hans" : {
