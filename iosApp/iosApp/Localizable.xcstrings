    "settings.subtitles.followsSystemAppearance" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac): footer while Use Device Settings is on. Accessibility → Subtitles & Captioning is the path in Apple's Settings app; use the system's own names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع لغة التسميات التوضيحية لهذا الجهاز وسلوك العرض وتفضيل CC/SDH والخط والألوان والعتامة والحواف والحجم ونافذة التسميات التوضيحية من تسهيلات الاستخدام ← الترجمة والتسميات التوضيحية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet Untertitelsprache, Anzeigeverhalten, CC/SDH-Präferenz, Schrift, Farben, Deckkraft, Ränder, Größe und Untertitelfenster dieses Geräts aus „Bedienungshilfen“ → „Untertitel & erweiterte UT“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Following this device's caption language, display behavior, CC/SDH preference, font, colors, opacity, edges, size, and caption window from Accessibility → Subtitles & Captioning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usan el idioma de los subtítulos, el modo de visualización, la preferencia de CC/SDH, la fuente, los colores, la opacidad, los bordes, el tamaño y la ventana de subtítulos de este dispositivo, definidos en Accesibilidad → Subtítulos y subtitulado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit la langue des sous-titres, le comportement d’affichage, la préférence CC/SDH, la police, les couleurs, l’opacité, les contours, la taille et la fenêtre des sous-titres de cet appareil, définis dans Accessibilité → Sous-titres et sous-titrage codé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アクセシビリティ」→「字幕とキャプション」にある、このデバイスの字幕の言語、表示方法、CC/SDHの設定、フォント、色、不透明度、縁取り、サイズ、字幕ウインドウに従っています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguindo o idioma das legendas, o comportamento de exibição, a preferência por CC/SDH, a fonte, as cores, a opacidade, as bordas, o tamanho e a janela de legendas deste dispositivo definidos em Acessibilidade → Legendas e Legendas Ocultas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在使用此设备在“辅助功能 → 字幕与隐藏式字幕”中的字幕语言、显示方式、CC/SDH偏好、字体、颜色、不透明度、边缘、大小和字幕窗口设置。"
          }
        }
      }
    },
