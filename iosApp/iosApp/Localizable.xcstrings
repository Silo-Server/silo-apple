    "diagnostics.turnOff.confirm" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics > Crash Reports: destructive button that sets Crash Reports to Never and deletes pending reports.",
