          }
        }
      }
    },
    "player.seekInterval.saveConnectionAudiobookFastForward" : {
      "comment" : "Apple iOS/tvOS/macOS: skip interval settings (Playback settings and the audiobook player); error when saving failed on the network while saving the audiobook skip forward interval.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر حفظ فاصل التقديم للكتاب الصوتي. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interval přetáčení vpřed u audioknih se nepodařilo uložit. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke gemme intervallet for spol frem i lydbøger. Tjek forbindelsen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Vorspulintervall für Hörbücher konnte nicht gespeichert werden. Prüfe die Verbindung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't save the audiobook fast-forward interval. Check the connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar el intervalo de avance rápido del audiolibro. Comprueba la conexión y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänikirjan eteenpäinkelauksen välin tallentaminen epäonnistui. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer l’intervalle d’avance rapide des livres audio. Vérifiez la connexion et réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće spremiti interval premotavanja unaprijed za audioknjige. Provjerite vezu i pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare l’intervallo di avanzamento rapido degli audiolibri. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオブックの早送り間隔を保存できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오북 빨리 감기 간격을 저장할 수 없어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke lagre intervallet for spoling fremover i lydbøker. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan het vooruitspoelinterval voor luisterboeken niet opslaan. Controleer de verbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać interwału przewijania audiobooka do przodu. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar o intervalo de avanço do audiolivro. Verifique a conexão e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить интервал перемотки вперёд для аудиокниг. Проверьте подключение и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att spara intervallet för att spola framåt i ljudböcker. Kontrollera anslutningen och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli kitap ileri sarma aralığı kaydedilemedi. Bağlantıyı denetleyip tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося зберегти інтервал перемотування вперед для аудіокниг. Перевірте з’єднання й спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存有声书快进间隔。请检查网络连接，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法儲存有聲書快轉間隔。請檢查連線，然後再試一次。"
          }
        }
      }
    },
