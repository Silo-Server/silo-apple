          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto plays videos up to %1$@ without converting them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La calidad Auto reproduce videos de hasta %1$@ sin convertirlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laatu Auto toistaa videoita muuntamatta niitä nopeuteen %1$@ asti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La qualité Auto lit les vidéos jusqu’à %1$@ sans les convertir."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvaliteta Auto reproducira videozapise do %1$@ bez konverzije."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La qualità Auto riproduce i video fino a %1$@ senza convertirli."
