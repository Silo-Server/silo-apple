        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je privzeta nastavitev za vse prenose; spremenite jo lahko v podoknu Prenos. Spremljane serije se prenesejo v izvirni kakovosti."
          }
        },
        "sv" : {
          "stringUnit" : {
