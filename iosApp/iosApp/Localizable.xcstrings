    "tvSignIn.passwordOnly" : {
      "comment" : "Android TV note that the server offers only password sign-in, not code or phone approval. Apple TV: same status under the code and note on the password form.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدعم هذا الخادم تسجيل الدخول بكلمة المرور فقط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този сървър поддържа само вход с парола."
          }
