            "value" : "V Iskanju poiščite film ali serijo, ki jo želite zahtevati"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd Sök för att hitta en film eller serie att begära"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้การค้นหาเพื่อหาภาพยนตร์หรือซีรีส์ที่จะขอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstek göndermek için Ara ekranından bir film veya dizi bulun"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скористайтеся пошуком, щоб знайти фільм або серіал і надіслати запит"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng Tìm kiếm để tìm phim hoặc phim bộ muốn yêu cầu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用搜索查找要请求的电影或剧集"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用搜尋功能尋找要請求的電影或影集"
          }
        }
      }
    },
    "requests.error.network" : {
      "comment" : "Error toast on Roku when the server cannot be reached while handling a request. Apple (iPhone, iPad, Mac, Apple TV): error message on any screen that failed to load because the server couldn't be reached.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى الخادم. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма връзка със сървъра. Проверете връзката си и опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es pot connectar amb el servidor. Comprova la connexió i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze se spojit se serverem. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke nå serveren. Tjek din forbindelse, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server ist nicht erreichbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είναι δυνατή η σύνδεση με τον διακομιστή. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach the server. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con el servidor. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveriga ei saa ühendust. Kontrollige ühendust ja proovige uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimeen ei saada yhteyttä. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le serveur. Vérifiez votre connexion et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין גישה לשרת. יש לבדוק את החיבור ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर से कनेक्ट नहीं हो सका। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj nije dostupan. Provjerite vezu i pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver nem érhető el. Ellenőrizze a kapcsolatot, és próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menjangkau server. Periksa koneksi Anda dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere il server. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーに接続できません。接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 연결할 수 없어요. 연결 상태를 확인하고 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko pasiekti serverio. Patikrinkite ryšį ir bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevar sazināties ar serveri. Pārbaudiet savienojumu un mēģiniet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat mencapai pelayan. Semak sambungan anda dan cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Får ikke kontakt med serveren. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de server niet bereiken. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można połączyć się z serwerem. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o servidor. Verifique sua conexão e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível aceder ao servidor. Verifique a sua ligação e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverul nu poate fi accesat. Verificați conexiunea și încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет связи с сервером. Проверьте подключение и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedá sa pripojiť k serveru. Skontrolujte pripojenie a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežnik ni dosegljiv. Preverite povezavo in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det går inte att nå servern. Kontrollera anslutningen och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อกับเซิร์ฟเวอร์ไม่ได้ โปรดตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucuya ulaşılamıyor. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося з’єднатися із сервером. Перевірте з’єднання та спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kết nối với máy chủ. Kiểm tra kết nối và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接服务器。请检查你的网络连接，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線至伺服器。請檢查你的連線，然後再試一次。"
          }
        }
      }
    },
    "requests.error.permission" : {
      "comment" : "Error toast on Roku when the user lacks permission for a request action. Suggests asking the server admin. Apple (iPhone, iPad, Mac, Apple TV): error message under the Not allowed heading on any screen the server refuses (HTTP 403).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس لديك إذن للقيام بذلك. اطلب من مسؤول الخادم منحك الوصول إذا كنت تحتاج إليه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нямате разрешение за това действие. Ако ви е нужен достъп, обърнете се към администратора на сървъра."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tens permís per fer això. Si necessites accés, demana-ho a l’administrador del servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K této akci nemáte oprávnění. Pokud potřebujete přístup, obraťte se na správce serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke tilladelse til at gøre dette. Spørg din serveradministrator, hvis du har brug for adgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafür hast du keine Berechtigung. Frag die Person, die den Server verwaltet, wenn du Zugriff brauchst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχετε άδεια για αυτή την ενέργεια. Αν χρειάζεστε πρόσβαση, ζητήστε την από τον διαχειριστή του διακομιστή σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have permission to do this. Ask your server admin if you need access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes permiso para hacer esto. Si necesitas acceso, pídeselo a quien administra tu servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teil pole selleks õigust. Kui vajate juurdepääsu, pöörduge oma serveri administraatori poole."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei oikeutta tähän toimintoon. Jos tarvitset käyttöoikeuden, pyydä sitä palvelimen ylläpitäjältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas l’autorisation d’effectuer cette action. Demandez l’accès à l’administrateur de votre serveur si nécessaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין לך הרשאה לפעולה הזו. אם נדרשת גישה, אפשר לפנות למנהל השרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको यह करने की अनुमति नहीं है। अगर आपको ऐक्सेस चाहिए, तो अपने सर्वर एडमिन से पूछें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemate dopuštenje za ovu radnju. Ako vam treba pristup, obratite se administratoru poslužitelja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs jogosultsága ehhez a művelethez. Ha hozzáférésre van szüksége, forduljon a szerver adminisztrátorához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak memiliki izin untuk melakukan ini. Minta akses kepada admin server Anda jika diperlukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai l’autorizzazione per farlo. Se ti serve l’accesso, chiedi all’amministratore del server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作を行う権限がありません。アクセスが必要な場合は、サーバー管理者にお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업을 할 권한이 없어요. 접근 권한이 필요하면 서버 관리자에게 문의하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neturite leidimo tai daryti. Jei reikia prieigos, kreipkitės į serverio administratorių."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jums nav atļaujas to darīt. Ja jums nepieciešama piekļuve, sazinieties ar servera administratoru."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tiada kebenaran untuk melakukan ini. Minta akses daripada pentadbir pelayan anda jika perlu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke tillatelse til å gjøre dette. Spør serveradministratoren hvis du trenger tilgang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt geen toestemming om dit te doen. Vraag de beheerder van je server als je toegang nodig hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie masz uprawnień do tej czynności. Jeśli potrzebujesz dostępu, poproś administratora serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não tem permissão para fazer isso. Peça acesso ao administrador do servidor, se precisar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tem permissão para fazer isto. Se precisar de acesso, peça-o ao administrador do servidor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu aveți permisiunea de a face acest lucru. Cereți acces administratorului serverului dacă aveți nevoie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас нет прав на это действие. Если вам нужен доступ, обратитесь к администратору сервера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na túto akciu nemáte povolenie. Ak potrebujete prístup, obráťte sa na správcu servera."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za to nimate dovoljenja. Če potrebujete dostop, se obrnite na skrbnika strežnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har inte behörighet att göra detta. Fråga serverns administratör om du behöver åtkomst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณไม่มีสิทธิ์ทำสิ่งนี้ โปรดติดต่อผู้ดูแลเซิร์ฟเวอร์หากต้องการสิทธิ์เข้าถึง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu yapma izniniz yok. Erişime ihtiyacınız varsa sunucu yöneticinize başvurun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас немає дозволу на цю дію. Якщо потрібен доступ, зверніться до адміністратора сервера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không có quyền thực hiện thao tác này. Hãy hỏi quản trị viên máy chủ nếu bạn cần quyền truy cập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你没有执行此操作的权限。如需访问权限，请联系你的服务器管理员。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你沒有執行此操作的權限。如需存取權，請洽詢伺服器管理員。"
          }
        }
      }
    },
