    "profiles.error.passwordReset" : {
      "comment" : "TV: error on the Who's watching? screen when the account has a temporary password; the TV has no form to change it. Apple TV: same message on any screen the server refuses because the account has a temporary password.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب إعادة تعيين كلمة المرور. استخدم تطبيق Silo للهاتف أو موقع الويب لتعيين كلمة مرور جديدة، ثم عُد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паролата ви трябва да бъде нулирана. Задайте нова чрез мобилното приложение или уебсайта на Silo, след което се върнете."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cal restablir la contrasenya. Utilitza l’aplicació mòbil o el lloc web de Silo per definir-ne una de nova i després torna."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše heslo je potřeba obnovit. Nastavte nové v mobilní aplikaci Silo nebo na webu a pak se vraťte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din adgangskode skal nulstilles. Brug Silo-mobilappen eller webstedet til at angive en ny, og vend derefter tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Passwort muss zurückgesetzt werden. Lege in der mobilen Silo-App oder auf der Website ein neues fest und komm dann zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρέπει να γίνει επαναφορά του κωδικού πρόσβασής σας. Χρησιμοποιήστε την εφαρμογή Silo για κινητά ή τον ιστότοπο για να ορίσετε νέο και, στη συνέχεια, επιστρέψτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your password needs to be reset. Use the Silo mobile app or website to set a new one, then come back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes que restablecer tu contraseña. Usa la app de Silo para teléfonos o el sitio web para crear una nueva y luego vuelve."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie parool tuleb lähtestada. Määrake uus parool Silo mobiilirakenduses või veebisaidil ja tulge siis tagasi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salasanasi on nollattava. Aseta uusi salasana Silon mobiilisovelluksessa tai verkkosivustolla ja palaa sitten takaisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe doit être réinitialisé. Utilisez l’app mobile ou le site web Silo pour en définir un nouveau, puis revenez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאפס את הסיסמה שלך. אפשר להגדיר סיסמה חדשה באפליקציית Silo לנייד או באתר של Silo, ואז לחזור לכאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका पासवर्ड रीसेट करना होगा। नया पासवर्ड सेट करने के लिए Silo मोबाइल ऐप या वेबसाइट इस्तेमाल करें, फिर वापस आएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vašu lozinku treba poništiti. Postavite novu u mobilnoj aplikaciji Silo ili na web-mjestu, a zatim se vratite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelszót vissza kell állítani. Adjon meg újat a Silo mobilalkalmazásban vagy webhelyen, majd térjen vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata sandi Anda perlu direset. Gunakan aplikasi seluler atau situs web Silo untuk mengatur kata sandi baru, lalu kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua password deve essere reimpostata. Usa l’app mobile o il sito web di Silo per impostarne una nuova, poi torna qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードのリセットが必要です。Siloのモバイルアプリまたはウェブサイトで新しいパスワードを設定してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호를 재설정해야 해요. Silo 모바일 앱이나 웹사이트에서 새 비밀번호를 설정한 다음 다시 돌아오세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reikia iš naujo nustatyti jūsų slaptažodį. Nustatykite naują „Silo“ mobiliojoje programoje arba svetainėje ir grįžkite."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu parole ir jāatiestata. Izmantojiet Silo mobilo lietotni vai vietni, lai iestatītu jaunu paroli, un pēc tam atgriezieties."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata laluan anda perlu ditetapkan semula. Gunakan apl mudah alih atau laman web Silo untuk menetapkan kata laluan baharu, kemudian kembali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passordet ditt må tilbakestilles. Bruk Silo-mobilappen eller nettstedet til å angi et nytt, og kom tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wachtwoord moet opnieuw worden ingesteld. Stel een nieuw wachtwoord in via de mobiele Silo-app of de website en kom dan terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje hasło trzeba zresetować. Ustaw nowe w aplikacji mobilnej lub na stronie Silo, a potem wróć tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua senha precisa ser redefinida. Use o app Silo para celular ou o site para definir uma nova e depois volte."
