    "player.subtitles.builtInStylingNote" : {
      "comment" : "Apple iOS: note under the device settings switches on the Subtitle Appearance page of the iPhone and iPad player settings sheet while Use device settings is off.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ الترجمات ذات التنسيق المدمج بمظهرها الأصلي؛ وتحتفظ الترجمات المعتمدة على الصور بخطوطها وألوانها الأصلية لكنها تتبع إعدادات الحجم والموضع والخلفية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Субтитрите със собствен вграден стил запазват оригиналния си вид; субтитрите във вид на изображения запазват авторските си шрифтове и цветове, но следват настройките за размер, позиция и фон."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els subtítols amb estil integrat propi mantenen l’aspecte original; els subtítols basats en imatges mantenen els tipus de lletra i els colors originals, però segueixen les opcions de mida, posició i fons."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titulky s vlastním vestavěným stylem si zachovají původní vzhled; obrázkové titulky si zachovají původní písma a barvy, ale řídí se nastavením velikosti, pozice a pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undertekster med deres egen indbyggede formatering beholder deres oprindelige udseende; billedbaserede undertekster beholder deres egne skrifttyper og farver, men følger indstillingerne for størrelse, placering og baggrund."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel mit eigener integrierter Formatierung behalten ihr ursprüngliches Aussehen; bildbasierte Untertitel behalten ihre vorgegebenen Schriftarten und Farben, folgen aber den Einstellungen für Größe, Position und Hintergrund."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι υπότιτλοι με δική τους ενσωματωμένη μορφοποίηση διατηρούν την αρχική τους εμφάνιση. Οι υπότιτλοι σε μορφή εικόνας διατηρούν τις αρχικές γραμματοσειρές και τα χρώματά τους, αλλά ακολουθούν τις ρυθμίσεις μεγέθους, θέσης και φόντου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitles with their own built-in styling keep their original appearance; image-based subtitles keep their authored fonts and colors but follow the size, position, and background settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos con estilo propio integrado conservan su apariencia original; los subtítulos basados en imágenes conservan sus fuentes y colores originales, pero siguen la configuración de tamaño, posición y fondo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oma sisseehitatud kujundusega subtiitrid säilitavad algse välimuse; pildipõhised subtiitrid säilitavad oma algsed fondid ja värvid, kuid järgivad suuruse, asukoha ja tausta seadeid."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstitykset, joissa on oma sisäänrakennettu muotoilu, säilyttävät alkuperäisen ulkoasunsa; kuvapohjaiset tekstitykset säilyttävät alkuperäiset fonttinsa ja värinsä mutta noudattavat koko-, sijainti- ja tausta-asetuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres dotés de leur propre style intégré conservent leur apparence d’origine ; les sous-titres en image conservent leurs polices et couleurs d’origine, mais suivent les paramètres de taille, de position et d’arrière-plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כתוביות עם עיצוב מובנה משלהן שומרות על המראה המקורי שלהן; כתוביות מבוססות תמונה שומרות על הגופנים והצבעים המקוריים שלהן, אבל פועלות לפי הגדרות הגודל, המיקום והרקע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन सबटाइटल की अपनी बिल्ट-इन स्टाइलिंग होती है, वे अपने मूल रूप में ही दिखते हैं; इमेज-आधारित सबटाइटल अपने मूल फ़ॉन्ट और रंग बनाए रखते हैं, लेकिन साइज़, पोज़िशन और बैकग्राउंड की सेटिंग का पालन करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titlovi s vlastitim ugrađenim stilom zadržavaju izvorni izgled; slikovni titlovi zadržavaju izvorne fontove i boje, ali slijede postavke veličine, položaja i pozadine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A saját beépített stílussal rendelkező feliratok megtartják eredeti megjelenésüket; a képalapú feliratok megtartják eredeti betűtípusaikat és színeiket, de a méret-, pozíció- és háttérbeállításokat követik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitel dengan gaya bawaannya sendiri tetap mempertahankan tampilan aslinya; subtitel berbasis gambar mempertahankan font dan warna aslinya, tetapi mengikuti pengaturan ukuran, posisi, dan latar belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sottotitoli con uno stile incorporato mantengono l’aspetto originale; i sottotitoli basati su immagini mantengono i caratteri e i colori originali, ma seguono le impostazioni di dimensione, posizione e sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独自のスタイルが組み込まれた字幕は元の表示を維持します。画像ベースの字幕は作成時のフォントと色を維持しますが、サイズ、位置、背景の設定に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자체 스타일이 포함된 자막은 원래 모양을 유지해요. 이미지 기반 자막은 원래 글꼴과 색상을 유지하지만 크기, 위치, 배경 설정은 따라요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitrai su savo įtaisytu stiliumi išlaiko pradinę išvaizdą; vaizdiniai subtitrai išlaiko savo šriftus ir spalvas, bet jiems taikomi dydžio, padėties ir fono nustatymai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitri ar iebūvētu stilu saglabā savu sākotnējo izskatu; attēlu subtitri saglabā savus fontus un krāsas, bet ievēro izmēra, pozīcijas un fona iestatījumus."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sari kata yang mempunyai gaya terbina dalam sendiri mengekalkan rupa asalnya; sari kata berasaskan imej mengekalkan fon dan warna asalnya tetapi mengikut tetapan saiz, kedudukan dan latar belakang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undertekster med egen innebygd stil beholder det opprinnelige utseendet. Bildebaserte undertekster beholder skrifttypene og fargene sine, men følger innstillingene for størrelse, plassering og bakgrunn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondertitels met een eigen ingebouwde opmaak behouden hun oorspronkelijke weergave; op afbeeldingen gebaseerde ondertitels behouden hun eigen lettertypen en kleuren, maar volgen de instellingen voor grootte, positie en achtergrond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisy z własnym wbudowanym stylem zachowują oryginalny wygląd; napisy graficzne zachowują swoje czcionki i kolory, ale stosują ustawienia rozmiaru, położenia i tła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legendas com estilo próprio mantêm a aparência original; legendas baseadas em imagem mantêm as fontes e cores originais, mas seguem as configurações de tamanho, posição e fundo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As legendas com estilo próprio incorporado mantêm o aspeto original; as legendas baseadas em imagens mantêm os tipos de letra e as cores originais, mas seguem as definições de tamanho, posição e fundo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitrările cu stil propriu încorporat își păstrează aspectul original; subtitrările bazate pe imagini își păstrează fonturile și culorile originale, dar respectă setările de dimensiune, poziție și fundal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Субтитры со встроенным оформлением сохраняют исходный вид; графические субтитры сохраняют свои шрифты и цвета, но учитывают настройки размера, положения и фона."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titulky s vlastným vstavaným štýlom si zachovajú pôvodný vzhľad; obrázkové titulky si zachovajú pôvodné písma a farby, ale riadia sa nastaveniami veľkosti, pozície a pozadia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podnapisi z lastnim vgrajenim slogom ohranijo izvirni videz; slikovni podnapisi ohranijo izvirne pisave in barve, upoštevajo pa nastavitve velikosti, položaja in ozadja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undertexter med egen inbyggd formatering behåller sitt ursprungliga utseende. Bildbaserade undertexter behåller sina ursprungliga typsnitt och färger men följer inställningarna för storlek, position och bakgrund."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำบรรยายที่มีรูปแบบในตัวจะคงลักษณะเดิมไว้ ส่วนคำบรรยายแบบภาพจะคงแบบอักษรและสีตามต้นฉบับ แต่ใช้การตั้งค่าขนาด ตำแหน่ง และพื้นหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi yerleşik stiline sahip altyazılar özgün görünümünü korur; görüntü tabanlı altyazılar kendi yazı tiplerini ve renklerini korur ancak boyut, konum ve arka plan ayarlarına uyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Субтитри з власним вбудованим стилем зберігають початковий вигляд; графічні субтитри зберігають авторські шрифти й кольори, але враховують параметри розміру, положення й фону."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phụ đề có kiểu định dạng riêng sẽ giữ nguyên giao diện gốc; phụ đề dạng hình ảnh giữ phông chữ và màu sắc gốc nhưng theo cài đặt cỡ chữ, vị trí và nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自带内置样式的字幕会保留原有外观；图像字幕会保留原有字体和颜色，但会遵循大小、位置和背景设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內建樣式的字幕會保留原本的外觀；圖像字幕會保留原有的字型和顏色，但會套用大小、位置和背景設定。"
          }
        }
      }
    },
