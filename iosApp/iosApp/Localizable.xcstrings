          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite Pregledaj da biste vidjeli naslove za ovu karticu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
