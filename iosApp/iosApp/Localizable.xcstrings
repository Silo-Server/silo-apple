    "companion.offerSigninBody" : {
      "comment" : "Phone/tablet body text of the offer to sign in a nearby TV that is on its sign-in screen. {device}: the TV name, as claimed by the TV. Apple (iPhone, iPad): same body on the nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقول تلفزيون قريب يُدعى «%1$@» إنه على شاشة تسجيل الدخول. ستتحقق من رمزه قبل الموافقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Televize poblíž s názvem „%1$@“ hlásí, že je na přihlašovací obrazovce. Před schválením zkontrolujete její kód."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et tv i nærheden med navnet ”%1$@” siger, at det er på sin loginskærm. Du tjekker dets kode, før du godkender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fernseher in der Nähe namens „%1$@“ meldet, dass er auf seinem Anmeldebildschirm ist. Du prüfst seinen Code, bevor du bestätigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV nearby named “%1$@” says it's on its sign-in screen. You'll check its code before approving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una TV cercana llamada “%1$@” indica que está en su pantalla de inicio de sesión. Comprobarás su código antes de aprobar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähellä oleva tv nimeltä ”%1$@” ilmoittaa olevansa kirjautumisnäytöllä. Tarkistat sen koodin ennen hyväksymistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une TV à proximité nommée « %1$@ » indique être sur son écran de connexion. Vous vérifierez son code avant d’approuver."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obližnji TV pod nazivom „%1$@“ navodi da je na zaslonu za prijavu. Prije odobrenja provjerit ćete njegov kôd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una TV nelle vicinanze di nome “%1$@” indica di trovarsi nella schermata di accesso. Verificherai il suo codice prima di approvare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」という名前の近くのテレビが、サインイン画面を表示していると伝えています。承認する前にそのコードを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근처에 있는 “%1$@” TV가 로그인 화면에 있다고 알려 왔어요. 승인하기 전에 코드를 확인하게 돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En TV i nærheten med navnet «%1$@» sier at den er på påloggingsskjermen. Du kontrollerer koden før du godkjenner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een tv in de buurt met de naam “%1$@” zegt dat hij op het inlogscherm staat. Je controleert de code voordat je goedkeurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telewizor w pobliżu o nazwie „%1$@” zgłasza, że wyświetla ekran logowania. Przed zatwierdzeniem sprawdzisz jego kod."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma TV próxima chamada “%1$@” diz que está na tela de login. Você vai conferir o código dela antes de aprovar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телевизор поблизости с именем «%1$@» сообщает, что на нём открыт экран входа. Перед подтверждением вы сверите его код."
          }
        },
        "sv" : {
          "stringUnit" : {
