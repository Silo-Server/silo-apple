    "topBar.hint.forYou" : {
      "comment" : "Apple TV: spoken hint on the For You tab in the top bar: keeping focus on it opens its menu.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ التركيز لاختيار قائمة المشاهدة أو المفضلة أو التوصيات"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verweile hier, um Merkliste, Favoriten oder Empfehlungen zu wählen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest to choose Watchlist, Favorites, or Recommendations"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el foco para elegir Lista para ver, Favoritos o Recomendaciones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez dessus pour choisir la liste à voir, les favoris ou les recommandations"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカスしたままにすると、ウォッチリスト、お気に入り、おすすめ作品を選択できます"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o foco para escolher Lista para assistir, Favoritos ou Recomendações"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停留以选择待看清单、收藏或推荐"
          }
        }
      }
    },
    "topBar.hint.libraries" : {
      "comment" : "Apple TV: spoken hint on a library-type tab (Movies, Series, Music, Audiobooks) in the top bar: keeping focus on it opens its list of libraries.",
