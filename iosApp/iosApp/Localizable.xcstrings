    "tvPair.link.mismatch" : {
      "comment" : "Apple (iPhone, iPad) device approval from a link: error when the server answering at the link's address isn't the server the link names. \"Settings > Sign in a TV or device\" names the menu path in the app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشير هذا الرابط إلى خادم لا يستطيع هذا الجهاز تأكيده. أدخل الرمز في الإعدادات ← تسجيل الدخول على تلفزيون أو جهاز بدلًا من ذلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този линк сочи сървър, който това устройство не може да потвърди. Вместо това въведете кода в Настройки > Вход в телевизор или устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest enllaç indica un servidor que aquest dispositiu no pot confirmar. Introdueix el codi a Configuració > Inicia la sessió en una TV o un dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkaz uvádí server, který toto zařízení nemůže ověřit. Zadejte místo toho kód v Nastavení > Přihlásit televizi nebo zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linket angiver en server, som denne enhed ikke kan bekræfte. Indtast i stedet koden under Indstillinger > Log et tv eller en enhed ind."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link nennt einen Server, den dieses Gerät nicht bestätigen kann. Gib den Code stattdessen unter Einstellungen > Fernseher oder Gerät anmelden ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο σύνδεσμος αναφέρει έναν διακομιστή που αυτή η συσκευή δεν μπορεί να επιβεβαιώσει. Εισαγάγετε αντί για αυτό τον κωδικό στην ενότητα «Ρυθμίσεις > Σύνδεση τηλεόρασης ή συσκευής»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That link names a server this device can't confirm. Enter the code in Settings > Sign in a TV or device instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese enlace indica un servidor que este dispositivo no puede confirmar. Introduce el código en Configuración > Iniciar sesión en una TV o dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selles lingis nimetatud serverit ei saa see seade kinnitada. Sisestage kood hoopis jaotises „Seaded > Teleri või seadme sisselogimine“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkki viittaa palvelimeen, jota tämä laite ei voi vahvistaa. Anna koodi sen sijaan kohdassa Asetukset > Tv:n tai laitteen kirjautuminen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien désigne un serveur que cet appareil ne peut pas confirmer. Saisissez plutôt le code dans Paramètres > Connecter une TV ou un appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקישור מציין שרת שהמכשיר הזה לא יכול לאמת. במקום זאת, יש להזין את הקוד במסך הגדרות ← התחברות בטלוויזיה או במכשיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह लिंक ऐसे सर्वर का नाम बताता है जिसकी पुष्टि यह डिवाइस नहीं कर सकता। इसके बजाय सेटिंग > टीवी या डिवाइस में साइन इन करें में कोड डालें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta poveznica navodi poslužitelj koji ovaj uređaj ne može potvrditi. Umjesto toga unesite kôd u Postavke > Prijava TV-a ili uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a hivatkozás olyan szervert nevez meg, amelyet ez az eszköz nem tud megerősíteni. Inkább adja meg a kódot itt: Beállítások > TV vagy eszköz bejelentkeztetése."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautan itu menyebut server yang tidak dapat dikonfirmasi perangkat ini. Sebagai gantinya, masukkan kode di Pengaturan > Masuk di TV atau perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link indica un server che questo dispositivo non può confermare. Inserisci invece il codice in Impostazioni > Accesso su una TV o un dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのリンクが示すサーバーをこのデバイスで確認できません。代わりに「設定」>「テレビやデバイスをサインイン」でコードを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 링크에 지정된 서버를 이 기기에서 확인할 수 없어요. 대신 설정 > TV 또는 기기 로그인에서 코드를 입력하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toje nuorodoje nurodytas serveris, kurio šis įrenginys negali patvirtinti. Verčiau įveskite kodą skiltyje „Nustatymai > Prisijungti televizoriuje ar įrenginyje“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saitē norādīts serveris, ko šī ierīce nevar pārbaudīt. Tā vietā ievadiet kodu sadaļā „Iestatījumi > Pierakstīt televizoru vai ierīci”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pautan itu menamakan pelayan yang tidak dapat disahkan oleh peranti ini. Sebaliknya, masukkan kod dalam Tetapan > Log masuk TV atau peranti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lenken peker til en server denne enheten ikke kan bekrefte. Skriv inn koden under Innstillinger > Logg på en TV eller enhet i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die link noemt een server die dit apparaat niet kan bevestigen. Voer de code in via Instellingen > Tv of apparaat aanmelden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten link wskazuje serwer, którego to urządzenie nie może potwierdzić. Zamiast tego wpisz kod w sekcji Ustawienia > Zaloguj telewizor lub urządzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse link indica um servidor que este dispositivo não consegue confirmar. Em vez disso, digite o código em Configurações > Conectar uma TV ou dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse link indica um servidor que este dispositivo não consegue confirmar. Em alternativa, introduza o código em Definições > Iniciar sessão numa TV ou dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkul indică un server pe care acest dispozitiv nu îl poate confirma. Introduceți codul în Setări > Conectați un TV sau un dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта ссылка указывает на сервер, который это устройство не может проверить. Вместо этого введите код в разделе «Настройки > Вход на телевизоре или устройстве»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento odkaz uvádza server, ktorý toto zariadenie nemôže overiť. Namiesto toho zadajte kód v časti Nastavenia > Prihlásiť televízor alebo zariadenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta povezava navaja strežnik, ki ga ta naprava ne more potrditi. Namesto tega vnesite kodo v razdelku Nastavitve > Prijava televizorja ali naprave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Länken anger en server som den här enheten inte kan bekräfta. Ange koden i Inställningar > Logga in en tv eller enhet i stället."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลิงก์นั้นระบุเซิร์ฟเวอร์ที่อุปกรณ์นี้ยืนยันไม่ได้ โปรดป้อนรหัสใน การตั้งค่า > ลงชื่อเข้าใช้ทีวีหรืออุปกรณ์ แทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bağlantı, bu cihazın doğrulayamadığı bir sunucuyu belirtiyor. Bunun yerine kodu Ayarlar > TV’de veya cihazda oturum aç ekranında girin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посилання вказує на сервер, який цей пристрій не може підтвердити. Натомість введіть код у розділі «Налаштування > Вхід на телевізорі або пристрої»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liên kết đó chỉ đến một máy chủ mà thiết bị này không thể xác nhận. Thay vào đó, nhập mã trong Cài đặt > Đăng nhập TV hoặc thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备无法确认该链接指向的服务器。请改为在“设置 > 登录电视或设备”中输入代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該連結指向的伺服器無法由此裝置確認。請改為在「設定 > 登入電視或裝置」中輸入代碼。"
          }
        }
      }
    },
