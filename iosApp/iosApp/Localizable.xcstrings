    "error.field.invalid_sort_field" : {
      "comment" : "Error shown next to or about one request field when the server reports the field-error code `invalid_sort_field`. Clients show it instead of the server's English detail in a translated interface. The server also sends this code when a list that sorts by one field at a time is given several.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد الفرز حقلًا لا تفرز هذه العملية حسبه، أو يحدد حقلًا مرتين."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řazení uvádí pole, podle kterého tato operace neřadí, nebo jedno pole uvádí dvakrát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorteringen angiver et felt, som denne handling ikke sorterer efter, eller angiver det samme felt to gange."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sortierung nennt ein Feld, nach dem dieser Vorgang nicht sortiert, oder nennt ein Feld doppelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sort names a field this operation does not sort by, or names one twice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El orden indica un campo por el que esta operación no ordena, o repite uno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lajittelu viittaa kenttään, jonka mukaan tätä toimintoa ei voi lajitella, tai samaan kenttään kahdesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tri désigne un champ que cette opération ne permet pas de trier, ou désigne le même champ deux fois."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortiranje navodi polje po kojem ova operacija ne sortira ili isto polje navodi dvaput."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ordinamento indica un campo non ordinabile in questa operazione, o lo indica due volte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "並べ替えに、この操作では使用できないフィールドが指定されているか、同じフィールドが2回指定されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 요청에서 정렬할 수 없는 필드를 지정했거나 같은 필드를 두 번 지정했어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorteringen angir et felt denne operasjonen ikke sorterer etter, eller angir samme felt to ganger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sortering noemt een veld waarop deze bewerking niet sorteert, of noemt een veld twee keer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortowanie wskazuje pole, według którego ta operacja nie sortuje, lub podaje to samo pole dwa razy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ordenação indica um campo pelo qual esta operação não ordena ou indica o mesmo campo duas vezes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В параметре сортировки указано поле, по которому эта операция не сортирует, или одно поле указано дважды."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorteringen anger ett fält som den här åtgärden inte sorterar efter, eller samma fält två gånger."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıralama, bu işlemin sıralamada kullanmadığı bir alanı içeriyor ya da bir alanı iki kez belirtiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сортування вказує поле, за яким ця операція не сортує, або вказує одне поле двічі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排序指定了此操作不支持排序的字段，或重复指定了同一字段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排序指定了此操作不支援的欄位，或重複指定了同一欄位。"
          }
        }
      }
    },
