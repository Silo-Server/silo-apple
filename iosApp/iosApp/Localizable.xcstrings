          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics är standard och kräver ingen diagnostiklagring på din egen server."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo Diagnostics เป็นค่าเริ่มต้นและไม่ต้องใช้พื้นที่จัดเก็บข้อมูลการวินิจฉัยในเซิร์ฟเวอร์ของคุณเอง"
