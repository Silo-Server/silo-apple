          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svatko s profilom na ovom Silo poslužitelju može ga unijeti u odjeljku Watch Party."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque abbia un profilo su questo server Silo può inserirlo da Watch Party."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このSiloサーバーにプロフィールがあるユーザーなら誰でも、Watch Partyからこのコードを入力できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Silo 서버에 프로필이 있는 사람은 누구나 Watch Party에서 이 코드를 입력할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle med en profil på denne Silo-serveren kan skrive den inn fra Watch Party."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen met een profiel op deze Silo-server kan de code invoeren via Watch Party."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda osoba z profilem na tym serwerze Silo może wpisać ten kod w Watch Party."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa com um perfil neste servidor Silo pode inseri-lo na Watch Party."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой, у кого есть профиль на этом сервере Silo, может ввести его в Watch Party."
          }
        },
        "sv" : {
