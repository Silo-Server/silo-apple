        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo не вдалося підтвердити зміну відстеження. Перевірте цей серіал ще раз, коли знову будете онлайн."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo无法确认监控更改。恢复联网后，请再次检查此剧集。"
