    "settings.about.trademarkNotice" : {
      "comment" : "Apple Acknowledgements (all Apple apps): notice under the list of outside services (TMDB, IMDb, Rotten Tomatoes and others).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الأسماء والشعارات ملك لأصحابها. Silo غير تابع لهم ولا معتمد منهم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Namen und Logos gehören ihren jeweiligen Inhabern. Silo ist nicht mit ihnen verbunden und wird nicht von ihnen unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These names and logos belong to their owners. Silo is not affiliated with or endorsed by them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos nombres y logotipos pertenecen a sus propietarios. Silo no está afiliado a ellos ni cuenta con su respaldo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces noms et logos appartiennent à leurs propriétaires. Silo n’est ni affilié à ces derniers ni approuvé par eux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの名称およびロゴは各所有者に帰属します。Siloはこれらの所有者と提携しておらず、承認も受けていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses nomes e logotipos pertencem aos seus proprietários. O Silo não é afiliado a eles nem endossado por eles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些名称和标志归其各自所有者所有。Silo与它们没有关联，也未获得它们的认可。"
          }
        }
      }
    },
