    "home.recipe.esDirectorAuto.description" : {
      "comment" : "One-line description of the Director Spotlight preset in the Add row gallery (shared key `home.recipe.esDirectorAuto.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسليط الضوء أسبوعيًا على مخرج في مكتبتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Седмичен акцент върху режисьор от вашата библиотека."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada setmana destaquem algú que dirigeix títols de la teva biblioteca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý týden představí režiséra z vaší knihovny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugentligt fokus på en instruktør i dit bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Woche steht eine Person aus der Regie deiner Mediathek im Fokus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε εβδομάδα στο επίκεντρο ένας σκηνοθέτης της βιβλιοθήκης σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weekly spotlight on a director in your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada semana destaca a un director o directora de tu biblioteca."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga nädal üks režissöör teie meediakogust fookuses."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joka viikko esittelyssä ohjaaja kirjastostasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque semaine, un ou une cinéaste de votre bibliothèque à l’honneur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זרקור שבועי על במאי מהספרייה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर हफ़्ते आपकी लाइब्रेरी के किसी डायरेक्टर पर खास नज़र।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki tjedan u fokusu je redatelj iz vaše medijateke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetente egy rendező a könyvtárából reflektorfényben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorotan mingguan untuk seorang sutradara di perpustakaan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni settimana, i riflettori su un regista della tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリの監督を毎週ピックアップ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매주 라이브러리 속 감독 한 명을 조명."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas savaitę dėmesio centre – režisierius iš jūsų bibliotekos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katru nedēļu uzmanības centrā – režisors no jūsu bibliotēkas."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorotan mingguan tentang seorang pengarah dalam pustaka anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukentlig søkelys på en regissør i biblioteket ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke week een regisseur uit je bibliotheek in de schijnwerpers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co tydzień wyróżnienie dla innego reżysera z twojej biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destaque semanal para alguém da direção da sua biblioteca."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destaque semanal de um realizador da sua biblioteca."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În fiecare săptămână, un regizor din biblioteca dvs. în prim-plan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждую неделю — режиссёр из вашей медиатеки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý týždeň v centre pozornosti jeden režisér z vašej knižnice."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsak teden v ospredju režiser iz vaše knjižnice."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veckans fokus på en regissör i ditt bibliotek."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฮไลต์ผู้กำกับในคลังประจำสัปดาห์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her hafta kitaplığınızdan bir yönetmen öne çıkar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щотижня – новий режисер із вашої бібліотеки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiêu điểm hằng tuần về một đạo diễn trong thư viện của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周聚焦你的媒体库中的一位导演。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每週聚焦你媒體庫中的一位導演。"
          }
        }
      }
    },
