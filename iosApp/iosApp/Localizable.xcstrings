        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díly, které server nedokáže převést do této kvality, se přeskočí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afsnit, som serveren ikke kan konvertere til denne kvalitet, springes over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgen, die der Server nicht in diese Qualität umwandeln kann, werden übersprungen."
