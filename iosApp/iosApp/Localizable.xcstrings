    "settings.playback.rejectedChange" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: message under Not Saved when the server refused a playback change.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يقبل الخادم تغييرًا في إعدادات التشغيل لهذا الجهاز، لذا لم يُحفظ."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърът не прие промяна в настройките за възпроизвеждане на това устройство, затова тя не е запазена."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no ha acceptat un canvi a la configuració de reproducció d’aquest dispositiu, així que no s’ha desat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server nepřijal změnu nastavení přehrávání tohoto zařízení, proto nebyla uložena."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren accepterede ikke en ændring af denne enheds afspilningsindstillinger, så den blev ikke gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat eine Änderung an den Wiedergabeeinstellungen dieses Geräts nicht angenommen, daher wurde sie nicht gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής δεν αποδέχτηκε μια αλλαγή στις ρυθμίσεις αναπαραγωγής αυτής της συσκευής, οπότε δεν αποθηκεύτηκε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server didn't accept a change to this device's playback settings, so it wasn't saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no aceptó un cambio en la configuración de reproducción de este dispositivo, así que no se guardó."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server ei aktsepteerinud selle seadme esitusseadete muudatust, seega seda ei salvestatud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin ei hyväksynyt tämän laitteen toistoasetuksiin tehtyä muutosta, joten sitä ei tallennettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n’a pas accepté une modification des paramètres de lecture de cet appareil ; elle n’a donc pas été enregistrée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת לא קיבל שינוי בהגדרות ההפעלה של המכשיר הזה, ולכן השינוי לא נשמר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर ने इस डिवाइस की प्लेबैक सेटिंग में किया गया बदलाव स्वीकार नहीं किया, इसलिए उसे सेव नहीं किया गया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj nije prihvatio promjenu postavki reprodukcije ovog uređaja pa ona nije spremljena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver nem fogadta el az eszköz lejátszási beállításainak módosítását, ezért a módosítás nem lett mentve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server tidak menerima perubahan pada pengaturan pemutaran perangkat ini, sehingga perubahan tidak disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non ha accettato una modifica alle impostazioni di riproduzione di questo dispositivo, quindi non è stata salvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの再生設定の変更がサーバーに受け入れられなかったため、保存されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 이 기기의 재생 설정 변경을 허용하지 않아 저장되지 않았어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveris nepriėmė šio įrenginio atkūrimo nustatymų pakeitimo, todėl jis neišsaugotas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveris nepieņēma šīs ierīces atskaņošanas iestatījumu izmaiņas, tāpēc tās netika saglabātas."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelayan tidak menerima perubahan pada tetapan main balik peranti ini, jadi perubahan itu tidak disimpan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren godtok ikke en endring i avspillingsinnstillingene for denne enheten, så den ble ikke lagret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server heeft een wijziging in de afspeelinstellingen van dit apparaat niet geaccepteerd, dus deze is niet opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer nie zaakceptował zmiany ustawień odtwarzania tego urządzenia, więc nie została zapisana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor não aceitou uma alteração nas configurações de reprodução deste dispositivo, então ela não foi salva."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor não aceitou uma alteração às definições de reprodução deste dispositivo, por isso não foi guardada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverul nu a acceptat o modificare a setărilor de redare ale acestui dispozitiv, așa că aceasta nu a fost salvată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер не принял изменение настроек воспроизведения этого устройства, поэтому оно не сохранено."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server neprijal zmenu nastavení prehrávania tohto zariadenia, preto sa neuložila."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežnik ni sprejel spremembe nastavitev predvajanja za to napravo, zato ni bila shranjena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern godtog inte en ändring av uppspelningsinställningarna för den här enheten, så den sparades inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซิร์ฟเวอร์ไม่ยอมรับการเปลี่ยนแปลงการตั้งค่าการเล่นของอุปกรณ์นี้ จึงไม่ได้บันทึกไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu bu cihazın oynatma ayarlarındaki bir değişikliği kabul etmedi, bu yüzden değişiklik kaydedilmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер не прийняв зміну налаштувань відтворення цього пристрою, тому її не збережено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ không chấp nhận thay đổi đối với cài đặt phát lại của thiết bị này nên thay đổi chưa được lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器未接受对此设备播放设置的更改，因此未保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器未接受此裝置播放設定的變更，因此未儲存。"
          }
        }
      }
    },
