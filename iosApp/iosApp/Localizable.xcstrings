    "setup.recovery.forgetBody" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV) saved-server recovery screen: message of the confirmation before removing the saved server. {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى إزالة الاتصال المحفوظ وبيانات اعتماد تسجيل الدخول الخاصة بـ %1$@ من هذا الجهاز. لا يمكن التراجع عن ذلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това премахва запазената връзка и данните за вход за сървъра %1$@ от това устройство. Действието не може да бъде отменено."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això elimina d’aquest dispositiu la connexió desada i les credencials d’inici de sessió del servidor %1$@. No es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto z tohoto zařízení odeberete uložené připojení a přihlašovací údaje pro server %1$@. Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner den gemte forbindelse og loginoplysningerne til %1$@ fra denne enhed. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die gespeicherte Verbindung und die Anmeldedaten für %1$@ von diesem Gerät entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η ενέργεια αφαιρεί την αποθηκευμένη σύνδεση και τα διαπιστευτήρια σύνδεσης για τον διακομιστή %1$@ από αυτή τη συσκευή. Δεν είναι δυνατή η αναίρεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes the saved connection and sign-in credentials for %1$@ from this device. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de este dispositivo la conexión guardada y las credenciales de inicio de sesión de %1$@. Esta acción no se puede deshacer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See eemaldab sellest seadmest serveri %1$@ salvestatud ühenduse ja sisselogimisandmed. Seda ei saa tagasi võtta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa palvelimen %1$@ tallennetun yhteyden ja kirjautumistiedot tästä laitteesta. Toimintoa ei voi kumota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime de cet appareil la connexion enregistrée et les identifiants de connexion pour %1$@. Elle est irréversible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעולה הזו מסירה מהמכשיר הזה את החיבור השמור ואת פרטי ההתחברות של השרת %1$@. אי אפשר לבטל את הפעולה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे इस डिवाइस से सर्वर %1$@ का सेव किया गया कनेक्शन और साइन-इन क्रेडेंशियल हट जाएँगे। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time se s ovog uređaja uklanjaju spremljena veza i podaci za prijavu za %1$@. To se ne može poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez eltávolítja a(z) %1$@ szerver mentett kapcsolatát és bejelentkezési adatait erről az eszközről. Ez nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini menghapus koneksi tersimpan dan kredensial masuk untuk server %1$@ dari perangkat ini. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione rimuove da questo dispositivo la connessione salvata e le credenziali di accesso per il server %1$@. L’operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスから%1$@の保存済みの接続情報とサインイン情報を削除します。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 %1$@ 서버의 저장된 연결 및 로그인 정보를 삭제해요. 이 작업은 실행 취소할 수 없어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iš šio įrenginio bus pašalinti išsaugoti serverio „%1$@“ ryšio ir prisijungimo duomenys. Šio veiksmo negalima anuliuoti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tādējādi no šīs ierīces tiks noņemti servera %1$@ saglabātais savienojums un pierakstīšanās akreditācijas dati. Šo darbību nevar atsaukt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini mengalih keluar sambungan tersimpan dan bukti kelayakan log masuk untuk pelayan %1$@ daripada peranti ini. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner den lagrede tilkoblingen og påloggingsinformasjonen for %1$@ fra denne enheten. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden de opgeslagen verbinding en inloggegevens voor %1$@ van dit apparaat verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie z tego urządzenia zapisanego połączenia i danych logowania do serwera %1$@. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove deste dispositivo a conexão salva e as credenciais de login de %1$@. Não é possível desfazer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação remove deste dispositivo a ligação guardada e as credenciais de início de sessão do servidor %1$@. Não é possível anular esta ação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiunea salvată și datele de conectare pentru serverul %1$@ vor fi eliminate de pe acest dispozitiv. Această acțiune nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённое подключение и данные для входа на сервер %1$@ будут удалены с этого устройства. Это действие нельзя отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týmto sa z tohto zariadenia odstránia uložené pripojenie a prihlasovacie údaje pre server %1$@. Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem boste iz te naprave odstranili shranjeno povezavo in poverilnice za prijavo za strežnik %1$@. Tega ni mogoče razveljaviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här tar bort den sparade anslutningen och inloggningsuppgifterna för servern %1$@ från den här enheten. Det går inte att ångra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะลบการเชื่อมต่อและข้อมูลการลงชื่อเข้าใช้ที่บันทึกไว้ของเซิร์ฟเวอร์ %1$@ ออกจากอุปกรณ์นี้ และเลิกทำไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, %1$@ sunucusu için kaydedilmiş bağlantıyı ve oturum açma bilgilerini bu cihazdan kaldırır. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережене з’єднання й облікові дані для входу на %1$@ буде видалено з цього пристрою. Цю дію не можна скасувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa kết nối và thông tin đăng nhập đã lưu cho %1$@ khỏi thiết bị này. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从此设备中移除%1$@的已保存连接和登录凭据。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
