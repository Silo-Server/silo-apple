    "error.snapshot_request_conflict" : {
      "comment" : "Error message shown when the server answers with the v2 problem type `snapshot_request_conflict` (server title: \"Snapshot request conflict\"). Clients show it instead of the server's English detail in a translated interface, so it must make sense on its own, without the request's specifics.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هناك مزامنة أخرى قيد التشغيل. حاول مرة أخرى بعد قليل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už probíhá jiná synchronizace. Zkuste to za chvíli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden synkronisering er allerede i gang. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es läuft bereits eine andere Synchronisierung. Versuche es gleich erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another sync is already running. Try again shortly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay otra sincronización en curso. Vuelve a intentarlo en breve."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toinen synkronointi on jo käynnissä. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre synchronisation est déjà en cours. Réessayez dans un instant."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druga sinkronizacija već je u tijeku. Uskoro pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È già in corso un’altra sincronizzazione. Riprova tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の同期がすでに実行中です。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 동기화가 이미 진행 중이에요. 잠시 후 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annen synkronisering pågår allerede. Prøv igjen om litt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er loopt al een andere synchronisatie. Probeer het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwa już inna synchronizacja. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra sincronização já está em andamento. Tente novamente em instantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже выполняется другая синхронизация. Повторите попытку чуть позже."
          }
