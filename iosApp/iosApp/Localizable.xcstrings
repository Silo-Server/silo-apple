          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest codi pertany al servidor %1$@, i aquí no hi tens la sessió iniciada. Inicia la sessió per aprovar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento kód patří k serveru %1$@ a zde k němu nejste přihlášeni. Chcete-li ho schválit, přihlaste se."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne kode hører til %1$@, og du er ikke logget ind på den her. Log ind for at godkende."
          }
