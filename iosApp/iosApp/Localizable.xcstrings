    "requests.remove.body" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message of the Remove this request? dialog. {title}: the movie or series title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف طلبك الفاشل لـ«%1$@». يمكنك طلب العنوان مرة أخرى لاحقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše neúspěšná žádost o titul „%1$@“ bude smazána. Později si ho můžete vyžádat znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din mislykkede anmodning om ”%1$@” bliver slettet. Du kan anmode om titlen igen senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine fehlgeschlagene Anfrage für „%1$@“ wird gelöscht. Du kannst den Titel später erneut anfragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your failed request for “%1$@” will be deleted. You can request the title again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará tu solicitud fallida de “%1$@”. Puedes volver a solicitar el título más adelante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epäonnistunut pyyntösi kohteesta ”%1$@” poistetaan. Voit pyytää nimikettä uudelleen myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre demande échouée pour « %1$@ » sera supprimée. Vous pourrez demander ce titre à nouveau plus tard."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš neuspjeli zahtjev za „%1$@“ bit će izbrisan. Naslov možete ponovno zatražiti kasnije."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua richiesta non riuscita per “%1$@” verrà eliminata. Potrai richiedere di nuovo il titolo più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」の失敗したリクエストを削除します。このタイトルは後でもう一度リクエストできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”에 대한 실패한 요청이 삭제돼요. 나중에 다시 요청할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den mislykkede forespørselen din om «%1$@» blir slettet. Du kan be om tittelen igjen senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mislukte aanvraag voor “%1$@” wordt verwijderd. Je kunt de titel later opnieuw aanvragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja nieudana prośba o „%1$@” zostanie usunięta. Możesz później ponownie poprosić o ten tytuł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua solicitação com falha de “%1$@” será excluída. Você pode solicitar o título novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неудавшийся запрос «%1$@» будет удалён. Позже вы сможете запросить его снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din misslyckade förfrågan om ”%1$@” raderas. Du kan begära titeln igen senare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” için başarısız isteğiniz silinecek. Bu içeriği daha sonra tekrar isteyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш невдалий запит на «%1$@» буде видалено. Ви зможете запитати цю назву пізніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你对“%1$@”的失败请求将被删除。你之后可以再次请求此作品。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你對「%1$@」的失敗請求將被刪除。你之後可以再次請求此作品。"
          }
        }
      }
    },
