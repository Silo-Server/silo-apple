    "downloads.offline.error.manifestMissing" : {
      "comment" : "Apple iOS/macOS: player error when opening a download offline: its playback data is missing.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيانات التشغيل دون اتصال لهذا التنزيل مفقودة. احذفه ونزّله مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chybí data pro offline přehrávání tohoto stažení. Smažte ho a stáhněte znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene til offlineafspilning af denne download mangler. Slet den, og download den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Offline-Wiedergabedaten dieses Downloads fehlen. Lösche ihn und lade ihn erneut herunter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The offline playback data for this download is missing. Delete and re-download it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltan los datos de reproducción sin conexión de esta descarga. Elimínala y vuelve a descargarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän latauksen offline-toistotiedot puuttuvat. Poista se ja lataa uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de lecture hors connexion de ce téléchargement sont introuvables. Supprimez-le, puis téléchargez-le à nouveau."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedostaju podaci za izvanmrežnu reprodukciju ovog preuzimanja. Izbrišite ga i ponovno preuzmite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mancano i dati di riproduzione offline di questo download. Eliminalo e scaricalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このダウンロードのオフライン再生データが見つかりません。削除してから再ダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 다운로드의 오프라인 재생 데이터가 없어요. 삭제한 후 다시 다운로드하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avspillingsdataene for denne nedlastingen mangler. Slett den og last den ned på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De offline afspeelgegevens van deze download ontbreken. Verwijder de download en download hem opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak danych odtwarzania offline dla tego pobranego elementu. Usuń go i pobierz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados de reprodução offline deste download estão ausentes. Exclua e baixe novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные для офлайн-воспроизведения этой загрузки отсутствуют. Удалите её и скачайте заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppspelningsdata för offline saknas för den här nedladdningen. Radera den och ladda ned den igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu indirmenin çevrimdışı oynatma verileri eksik. Silip yeniden indirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані для офлайн-відтворення цього завантаження відсутні. Видаліть і завантажте його знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此下载的离线播放数据丢失。请删除后重新下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個下載項目的離線播放資料遺失。請刪除後重新下載。"
          }
        }
      }
    },
