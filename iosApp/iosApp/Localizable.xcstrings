        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az Apple TV nem éri el a(z) %1$@ szervert ezen a címen: %2$@. Ellenőrizze a hálózati kapcsolatot, és próbálja újra."
