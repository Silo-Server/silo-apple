    "settingsManifest.playback.buffering_quality_mode.description" : {
      "comment" : "Help text under the playback.buffering_quality_mode setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يفعله Silo في وضع تلقائي عندما يستمر التخزين المؤقت أثناء التشغيل. يسأل Silo دائمًا قبل خفض جودة اخترتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was Silo bei der Qualität Auto tut, wenn die Wiedergabe immer wieder puffert. Silo fragt immer, bevor eine von dir gewählte Qualität gesenkt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What Silo does on Auto when playback keeps buffering. Silo always asks before lowering a quality you picked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué hace Silo en Automático cuando la reproducción no deja de almacenar en búfer. Silo siempre pregunta antes de bajar una calidad que elegiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que fait Silo en qualité Auto quand la lecture se met sans cesse en mémoire tampon. Silo demande toujours avant de baisser une qualité que vous avez choisie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動のときにバッファリングが続く場合のSiloの動作です。選択した画質を下げる前には必ず確認します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o Silo faz na qualidade Auto quando a reprodução fica carregando. O Silo sempre pergunta antes de reduzir uma qualidade que você escolheu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在自动模式下播放持续缓冲时Silo的处理方式。降低你手动选择的画质前，Silo总会先询问你。"
          }
        }
      }
    },
