        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login com senha está desativado neste servidor. Use o celular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход с паролем на этом сервере отключён. Используйте телефон."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggning med lösenord är avstängd på den här servern. Använd telefonen i stället."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucuda parolayla oturum açma kapalı. Bunun yerine telefonunuzu kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вхід за паролем на цьому сервері вимкнено. Скористайтеся телефоном."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
