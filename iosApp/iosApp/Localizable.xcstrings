        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Které zkratky pro oblíbené a zhlédnuté se zobrazují na kartách médií."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilke genveje til favoritter og set der vises på mediekort."
          }
        },
