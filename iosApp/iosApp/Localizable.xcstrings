                "stringUnit" : {
                  "state" : "translated",
                  "value" : "托管报告使用不与你的Silo账户关联的假名化安装凭据。报告不包含账户、个人资料、服务器地址和播放会话标识符，最多保留%1$lld天，且绝不会自动发送。"
                }
              }
            }
          }
        }
      }
    },
    "diagnostics.manual.hostedFooter" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad): footer under Send Diagnostics Now when reports go to Silo Diagnostics, the hosted service.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتضمن التقرير المستضاف تفاصيل قدرات الجهاز وسجلات التشخيص الحديثة بعد تنقيحها. ويستبعد معرّفات الحساب والملف الشخصي وعنوان الخادم وجلسة التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gehosteter Bericht enthält Angaben zu den Gerätefähigkeiten und aktuelle, geschwärzte Diagnoseprotokolle. Konto-, Profil-, Serveradressen- und Wiedergabe-Sitzungskennungen sind nicht enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hosted report includes device capability details and recent redacted diagnostic logs. It omits account, profile, server address, and playback session identifiers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un informe alojado incluye detalles de las capacidades del dispositivo y registros de diagnóstico recientes con los datos sensibles ocultos. Omite los identificadores de cuenta, perfil, dirección del servidor y sesión de reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rapport hébergé inclut les capacités de l’appareil et les journaux de diagnostic récents expurgés. Il omet les identifiants de compte, de profil, d’adresse du serveur et de session de lecture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト型のレポートには、デバイスの機能の詳細と、個人情報を除去した最近の診断ログが含まれます。アカウント、プロフィール、サーバーアドレス、再生セッションの識別子は含まれません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um relatório hospedado inclui detalhes dos recursos do dispositivo e logs de diagnóstico recentes com dados ocultados. Ele omite identificadores de conta, perfil, endereço do servidor e sessão de reprodução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "托管报告包含设备功能详情和近期经过脱敏的诊断日志，不包含账户、个人资料、服务器地址和播放会话标识符。"
          }
        }
      }
    },
    "diagnostics.manual.selfHostedFooter" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad): footer under Send Diagnostics Now when reports go to the user's own server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتضمن التقرير اليدوي تفاصيل قدرات الجهاز، ومعرّفات جلسات التشغيل الأخيرة، وسجلات التشخيص الحديثة لهذا الخادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein manueller Bericht enthält Angaben zu den Gerätefähigkeiten, aktuelle Wiedergabe-Sitzungskennungen und aktuelle Diagnoseprotokolle für diesen Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A manual report includes device capability details, recent playback session identifiers, and recent diagnostic logs for this server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un informe manual incluye detalles de las capacidades del dispositivo, identificadores de sesiones de reproducción recientes y registros de diagnóstico recientes de este servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rapport manuel inclut les capacités de l’appareil, les identifiants des sessions de lecture récentes et les journaux de diagnostic récents de ce serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動レポートには、デバイスの機能の詳細、最近の再生セッションの識別子、このサーバーの最近の診断ログが含まれます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um relatório manual inclui detalhes dos recursos do dispositivo, identificadores recentes de sessão de reprodução e logs de diagnóstico recentes deste servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动报告包含设备功能详情、近期的播放会话标识符以及此服务器的近期诊断日志。"
          }
        }
      }
    },
    "diagnostics.notice.consentReset" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: the destination's consent notice changed, so the Crash Reports setting went back to Ask. Crash Reports and Ask are the setting's and choice's names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت الموافقة؛ أُعيد ضبط «تقارير الأعطال» إلى «السؤال»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einwilligung geändert; „Absturzberichte“ wurde auf „Fragen“ zurückgesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consent changed; Crash Reports was reset to Ask."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El consentimiento cambió; Informes de fallos se restableció a Preguntar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le consentement a changé ; l’option « Rapports de plantage » est revenue à « Demander »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同意内容が変更されたため、クラッシュレポートが「毎回確認」にリセットされました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O consentimento mudou; a opção Relatórios de falhas voltou para Perguntar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同意条款已更改，崩溃报告已重置为询问。"
          }
        }
      }
    },
    "diagnostics.notice.createFailed" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: notice when Send Diagnostics Now couldn't build the report.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إنشاء التقرير. حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
