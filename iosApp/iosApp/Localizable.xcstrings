    "settingsManifest.playback.max_bitrate_kbps.description" : {
      "comment" : "Help text under the playback.max_bitrate_kbps setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحديد مقدار عرض النطاق الذي يمكن أن يستخدمه التشغيل. بلا حد يعني أن Silo يختار وفق الدقة المحددة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenzt, wie viel Bandbreite die Wiedergabe nutzen darf. Ohne Grenze wählt Silo passend zur gewählten Auflösung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap how much bandwidth playback may use. No cap means Silo picks for the chosen resolution."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita cuánto ancho de banda puede usar la reproducción. Sin límite, Silo elige según la resolución seleccionada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite la bande passante que la lecture peut utiliser. Sans limite, Silo choisit selon la résolution sélectionnée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生に使う帯域幅を制限します。制限なしの場合、Siloが選択した解像度に合わせて決めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita quanta largura de banda a reprodução pode usar. Sem limite, o Silo escolhe de acordo com a resolução selecionada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制播放可使用的带宽。不设上限时，Silo会根据所选分辨率自动选择。"
          }
        }
      }
    },
