          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo confirmar qué servidor es este. Comprueba la conexión y vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei õnnestunud kinnitada, milline server see on. Kontrollige ühendust ja proovige uuesti."
