    "settingsManifest.ui.theme_music_enabled.description" : {
      "comment" : "Help text under the ui.theme_music_enabled setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل موسيقى الشارة المحلية أثناء تصفح صفحات تفاصيل الأفلام والمسلسلات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Възпроизвеждане на локална музикална тема при разглеждане на страниците с подробности за филми и сериали."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodueix la música del tema local mentre navegues per les pàgines de detalls de pel·lícules i sèries."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při procházení stránek s podrobnostmi filmů a seriálů přehrávat místní znělku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil lokal temamusik, mens du ser detaljesider for film og serier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale Titelmusik auf den Detailseiten von Filmen und Serien abspielen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπαραγωγή τοπικής μουσικής θέματος κατά την περιήγηση στις σελίδες λεπτομερειών ταινιών και σειρών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play local theme music while browsing movie and show detail pages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce la música temática local al explorar las páginas de detalles de películas y series."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmide ja sarjade üksikasjade lehtede sirvimisel esitatakse kohalikku tunnusmuusikat."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toista paikallista tunnusmusiikkia, kun selaat elokuvien ja sarjojen tietosivuja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire la musique de générique locale pendant la consultation des pages de détails des films et des séries."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השמעת מוזיקת נושא מקומית בזמן גלישה בדפי הפרטים של סרטים וסדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़िल्म और सीरीज़ के विवरण पेज ब्राउज़ करते समय लोकल थीम म्यूज़िक चलाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducira lokalnu tematsku glazbu dok pregledavate stranice s detaljima filmova i serija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helyi főcímzene lejátszása a filmek és sorozatok részletes oldalainak böngészése közben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar musik tema lokal saat menjelajahi halaman detail film dan serial."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduci la sigla locale mentre sfogli le pagine di dettaglio di film e serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映画やシリーズの詳細ページを閲覧中に、ローカルのテーマ音楽を再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영화와 시리즈 상세 페이지를 둘러보는 동안 로컬 테마 음악을 재생해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leisti vietinę teminę muziką naršant filmų ir serialų išsamios informacijos puslapius."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atskaņot lokālo tēmas mūziku, pārlūkojot filmu un seriālu informācijas lapas."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mainkan muzik tema setempat semasa menyemak imbas halaman butiran filem dan siri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spill av lokal temamusikk når du blar i detaljsider for filmer og serier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel lokale themamuziek af op detailpagina’s van films en series."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarza lokalną muzykę tematyczną podczas przeglądania stron szczegółów filmów i seriali."
          }
        },
