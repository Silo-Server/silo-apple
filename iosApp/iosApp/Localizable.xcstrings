    "newProfile.childDetail" : {
      "comment" : "Secondary description line under the Child Profile toggle on the Roku new-profile screen. Apple (iPhone, iPad, Mac, Apple TV): same line under the Child Profile switch on the New Profile form.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقصر المحتوى على تصنيفات عمرية مناسبة للأطفال"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничава съдържанието до подходящото за деца"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita el contingut a qualificacions per edats aptes per a infants"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolí jen obsah s věkovým omezením vhodným pro děti"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrænser indhold til børnevenlige aldersgrænser"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschränkt Inhalte auf kindgerechte Altersfreigaben"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιορίζει το περιεχόμενο σε καταλληλότητες για παιδιά"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restricts content to kid-friendly ratings"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita el contenido a clasificaciones por edad aptas para niños"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirab sisu lastesõbralike vanusepiirangutega"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rajoittaa sisällön lapsille sopiviin ikärajoihin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite le contenu aux classifications adaptées aux enfants"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגבלת התוכן לסיווגי גיל שמתאימים לילדים"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कॉन्टेंट बच्चों के लिए उपयुक्त आयु रेटिंग तक सीमित रहता है"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ograničava sadržaj na dobne oznake prikladne za djecu"
          }
        },
        "hu" : {
