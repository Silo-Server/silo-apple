        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piekrišana mainījās; iestatījums „Avāriju pārskati” tika atiestatīts uz „Jautāt”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
