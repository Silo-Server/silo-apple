    "signInTv.serverAccount" : {
      "comment" : "Phone text on the device approval card explaining what will happen. Keep \"it\" device-neutral (do not say TV: the requesting client can be a TV, app, or other device). {server}: the server name; {account}: the account name that will be used. Apple (iPhone, iPad): same text on the device approval card and the nearby-TV pairing card; {server} is the server name with its host.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستسجّل دخول الجهاز إلى %1$@ باسم %2$@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройството ще влезе в сървъра %1$@ с акаунта %2$@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciaràs la sessió del dispositiu a %1$@ com a %2$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařízení přihlásíte k serveru %1$@ pod účtem %2$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du logger den ind på %1$@ som %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du meldest das Gerät bei %1$@ als %2$@ an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα συνδέσετε τη συσκευή στον διακομιστή %1$@ με τον λογαριασμό %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll sign it in to %1$@ as %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo iniciará sesión en %1$@ como %2$@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logite seadme serverisse %1$@ sisse kontoga %2$@."
