          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, Server. Zum Ändern doppelt tippen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διακομιστής: %1$@. Πατήστε δύο φορές για αλλαγή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, server. Double-tap to change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, servidor. Toca dos veces para cambiarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, server. Muutmiseks topeltpuudutage."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, palvelin. Vaihda kaksoisnapauttamalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, serveur. Touchez deux fois pour changer."
          }
        },
