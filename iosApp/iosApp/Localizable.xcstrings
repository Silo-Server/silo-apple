        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n’autorise pas cet appareil à se connecter à ce serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@により、このデバイスからこのサーバーへのサインインが許可されていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
