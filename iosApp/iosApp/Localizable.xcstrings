          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy rendszergazda ideiglenes jelszót állított be ehhez a fiókhoz. Jelentkezzen ki, majd jelentkezzen be újra, hogy saját jelszót válasszon."
