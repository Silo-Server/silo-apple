    "signIn.forgot.lead" : {
      "comment" : "Apple (iPhone, iPad, Mac) Reset password screen: line under the headline explaining what happens after sending.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل اسم المستخدم أو البريد الإلكتروني. إذا تطابق مع حساب، فسنرسل إلى بريد ذلك الحساب رابطًا لاختيار كلمة مرور جديدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deinen Benutzernamen oder deine E-Mail-Adresse ein. Passt die Angabe zu einem Konto, senden wir diesem Konto per E-Mail einen Link, mit dem du ein neues Passwort wählen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your username or email. If it matches an account, we'll email that account a link to choose a new password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe tu nombre de usuario o correo electrónico. Si coincide con una cuenta, enviaremos a esa cuenta un enlace para elegir una contraseña nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez votre nom d’utilisateur ou votre adresse e-mail. S’il correspond à un compte, nous enverrons à ce compte un lien par e-mail pour choisir un nouveau mot de passe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザー名またはメールアドレスを入力してください。一致するアカウントがある場合、新しいパスワードを設定するためのリンクをそのアカウントにメールでお送りします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite seu nome de usuário ou e-mail. Se corresponder a uma conta, enviaremos a ela um link por e-mail para escolher uma nova senha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入你的用户名或电子邮件。如果与某个账户匹配，我们会向该账户发送一封电子邮件，其中包含设置新密码的链接。"
          }
        }
      }
    },
