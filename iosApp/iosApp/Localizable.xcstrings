    "diagnostics.prompt.uncleanShutdownCountSelfHosted" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad, Apple TV), shown after a problem report is captured: message when several reports of one kind are waiting: the app did not shut down cleanly this many times. Reports go to the user's own Silo server, run by their server administrator. {count}: how many reports (2 or more in practice).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
