    "settings.profilePrefs.serverRejected" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac, Apple TV): error when the server refused the change. {status}: the HTTP status code, such as 409.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
