          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιλογή ποιότητας δεν είναι διαθέσιμη για αναπαραγωγή εκτός σύνδεσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quality selection is unavailable for offline playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La selección de calidad no está disponible para la reproducción sin conexión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvaliteedi valimine pole võrguühenduseta esituse ajal saadaval."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laadun valinta ei ole käytettävissä offline-toistossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection de la qualité n’est pas disponible pour la lecture hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחירת האיכות לא זמינה בהפעלה ללא חיבור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑफ़लाइन प्लेबैक के लिए क्वालिटी नहीं चुनी जा सकती।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odabir kvalitete nije dostupan za izvanmrežnu reprodukciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline lejátszásnál a minőségválasztás nem érhető el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihan kualitas tidak tersedia untuk pemutaran offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La selezione della qualità non è disponibile per la riproduzione offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフライン再生では画質を選択できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 재생 중에는 화질을 선택할 수 없어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokybės pasirinkimas nepasiekiamas atkuriant neprisijungus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvalitātes izvēle nav pieejama bezsaistes atskaņošanai."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemilihan kualiti tidak tersedia untuk main balik luar talian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvalitetsvalg er ikke tilgjengelig for frakoblet avspilling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwaliteit kiezen is niet beschikbaar bij offline afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybór jakości jest niedostępny podczas odtwarzania offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seleção de qualidade não está disponível na reprodução offline."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seleção de qualidade não está disponível na reprodução offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selectarea calității nu este disponibilă pentru redarea offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
