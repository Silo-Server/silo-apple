    "settingsManifest.playback.show_forced_subtitles.description" : {
      "comment" : "Help text under the playback.show_forced_subtitles setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض الترجمة للحوارات بلغة أجنبية حتى عند إيقاف الترجمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Untertitel für fremdsprachige Dialoge an, auch wenn Untertitel aus sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show subtitles for foreign-language dialogue even when subtitles are off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra subtítulos para los diálogos en otro idioma aunque los subtítulos estén desactivados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les sous-titres des dialogues en langue étrangère même quand les sous-titres sont désactivés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕がオフのときでも、外国語のセリフの字幕を表示します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra legendas para diálogos em língua estrangeira mesmo com as legendas desativadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使字幕已关闭，也为外语对白显示字幕。"
          }
        }
      }
    },
