            "value" : "Премахва настройките, променени на това Apple TV, за да използва то отново настройките на профила ви."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treu les opcions canviades en aquest Apple TV, perquè torni a utilitzar les opcions del teu perfil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebere nastavení změněná na tomto Apple TV, takže bude znovu používat nastavení vašeho profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner de indstillinger, der er ændret på dette Apple TV, så det bruger din profils indstillinger igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt die auf diesem Apple TV geänderten Einstellungen, sodass es wieder die Einstellungen deines Profils verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί τις ρυθμίσεις που άλλαξαν σε αυτό το Apple TV, ώστε να χρησιμοποιεί ξανά τις ρυθμίσεις του προφίλ σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes the settings changed on this Apple TV, so it uses your profile's settings again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita la configuración cambiada en este Apple TV para que vuelva a usar la configuración de tu perfil."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eemaldab selles Apple TV-s muudetud seaded, et see kasutaks taas teie profiili seadeid."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa tässä Apple TV:ssä muutetut asetukset, jotta se käyttää taas profiilisi asetuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les paramètres modifiés sur cette Apple TV, qui utilise ainsi de nouveau les paramètres de votre profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסירה את ההגדרות ששונו ב-Apple TV הזה, כך שייעשה שוב שימוש בהגדרות של הפרופיל שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Apple TV पर बदली गई सेटिंग हटा देता है, ताकि यह फिर से आपकी प्रोफ़ाइल की सेटिंग इस्तेमाल करे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanja postavke promijenjene na ovom Apple TV-u, pa on ponovno koristi postavke vašeg profila."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítja az ezen az Apple TV-n módosított beállításokat, így az eszköz ismét a profil beállításait használja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus pengaturan yang diubah di Apple TV ini, sehingga Apple TV ini kembali memakai pengaturan profil Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove le impostazioni modificate su questa Apple TV, così torna a usare le impostazioni del tuo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVで変更した設定を削除し、再びプロフィールの設定を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple TV에서 변경한 설정을 삭제해 프로필 설정을 다시 사용해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pašalina šiame „Apple TV“ įrenginyje pakeistus nustatymus, kad vėl būtų naudojami jūsų profilio nustatymai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noņem šajā Apple TV ierīcē mainītos iestatījumus, lai tajā atkal tiktu izmantoti jūsu profila iestatījumi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
