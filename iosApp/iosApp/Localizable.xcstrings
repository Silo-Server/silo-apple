    "downloads.seriesSheet.stopMessage" : {
      "comment" : "Apple iOS/macOS: series Download sheet, opened from a series page; message of the Stop monitoring alert. {device}: the device model name from the system, such as iPhone, iPad or Mac.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الحلقات الموجودة على جهاز %1$@ هذا حتى تحذفها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Епизодите, които вече са на това устройство (%1$@), остават, докато не ги изтриете."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els episodis que ja són en aquest %1$@ s’hi queden fins que els eliminis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díly, které už jsou v zařízení %1$@, zůstanou, dokud je nesmažete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afsnit, der allerede er på denne %1$@, bliver, indtil du sletter dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgen, die schon auf diesem %1$@ sind, bleiben, bis du sie löschst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα επεισόδια που υπάρχουν ήδη σε αυτή τη συσκευή %1$@ παραμένουν μέχρι να τα διαγράψετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episodes already on this %1$@ stay until you delete them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios que ya están en este %1$@ se quedan hasta que los elimines."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selles seadmes (%1$@) juba olevad osad jäävad alles, kuni need kustutate."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteessa %1$@ jo olevat jaksot säilyvät, kunnes poistat ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes déjà sur votre %1$@ y restent jusqu’à ce que vous les supprimiez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרקים שכבר נמצאים במכשיר %1$@ הזה יישארו בו עד שיימחקו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस %1$@ पर पहले से मौजूद एपिसोड मिटाए जाने तक बने रहेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epizode koje su već na uređaju %1$@ ostaju dok ih ne izbrišete."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ezen az eszközön (%1$@) lévő epizódok megmaradnak, amíg nem törli őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episode yang sudah ada di %1$@ ini tetap tersimpan sampai Anda menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli episodi già presenti su questo %1$@ restano finché non li elimini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%1$@にあるエピソードは、削除するまで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 %1$@에 이미 있는 에피소드는 삭제하기 전까지 남아 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epizodai, jau esantys šiame „%1$@“ įrenginyje, liks, kol juos ištrinsite."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
