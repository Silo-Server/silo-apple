    "profiles.error.passwordReset" : {
      "comment" : "TV: error on the Who's watching? screen when the account has a temporary password; the TV has no form to change it. Apple TV: same message on any screen the server refuses because the account has a temporary password.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب إعادة تعيين كلمة المرور. استخدم تطبيق Silo للهاتف أو موقع الويب لتعيين كلمة مرور جديدة، ثم عُد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše heslo je potřeba obnovit. Nastavte nové v mobilní aplikaci Silo nebo na webu a pak se vraťte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din adgangskode skal nulstilles. Brug Silo-mobilappen eller webstedet til at angive en ny, og vend derefter tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Passwort muss zurückgesetzt werden. Lege in der mobilen Silo-App oder auf der Website ein neues fest und komm dann zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your password needs to be reset. Use the Silo mobile app or website to set a new one, then come back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes que restablecer tu contraseña. Usa la app de Silo para teléfonos o el sitio web para crear una nueva y luego vuelve."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salasanasi on nollattava. Aseta uusi salasana Silon mobiilisovelluksessa tai verkkosivustolla ja palaa sitten takaisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe doit être réinitialisé. Utilisez l’app mobile ou le site web Silo pour en définir un nouveau, puis revenez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vašu lozinku treba poništiti. Postavite novu u mobilnoj aplikaciji Silo ili na web-mjestu, a zatim se vratite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua password deve essere reimpostata. Usa l’app mobile o il sito web di Silo per impostarne una nuova, poi torna qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードのリセットが必要です。Siloのモバイルアプリまたはウェブサイトで新しいパスワードを設定してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호를 재설정해야 해요. Silo 모바일 앱이나 웹사이트에서 새 비밀번호를 설정한 다음 다시 돌아오세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passordet ditt må tilbakestilles. Bruk Silo-mobilappen eller nettstedet til å angi et nytt, og kom tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wachtwoord moet opnieuw worden ingesteld. Stel een nieuw wachtwoord in via de mobiele Silo-app of de website en kom dan terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje hasło trzeba zresetować. Ustaw nowe w aplikacji mobilnej lub na stronie Silo, a potem wróć tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua senha precisa ser redefinida. Use o app Silo para celular ou o site para definir uma nova e depois volte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш пароль нужно сбросить. Задайте новый в мобильном приложении Silo или на сайте, затем вернитесь сюда."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt lösenord måste återställas. Använd Silos mobilapp eller webbplats för att ange ett nytt och kom sedan tillbaka."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolanızın sıfırlanması gerekiyor. Yeni bir parola belirlemek için Silo mobil uygulamasını veya web sitesini kullanın, ardından geri dönün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібно скинути ваш пароль. Установіть новий у мобільному застосунку Silo або на вебсайті, а потім поверніться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密码需要重置。请使用Silo手机应用或网站设置新密码，然后再回来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密碼需要重設。請使用 Silo 行動 App 或網站設定新密碼，然後再回來。"
          }
        }
      }
    },
    "profiles.error.rememberFailed" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error shown when the app could not save the chosen profile's session securely on the device.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Silo تذكّر هذا الملف الشخصي بشكل آمن. حاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikaci Silo se nepodařilo bezpečně uložit tento profil. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke huske denne profil sikkert. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo konnte dieses Profil nicht sicher speichern. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo couldn't securely remember this profile. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo no pudo recordar este perfil de forma segura. Vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ei voinut tallentaa tätä profiilia turvallisesti. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo n’a pas pu mémoriser ce profil de façon sécurisée. Réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo nije mogao sigurno zapamtiti ovaj profil. Pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo non è riuscito a memorizzare questo profilo in modo sicuro. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloはこのプロフィールを安全に保存できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo에서 이 프로필을 안전하게 기억하지 못했어요. 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kunne ikke huske denne profilen på en sikker måte. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo kan dit profiel niet veilig onthouden. Probeer het opnieuw."
