        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tjeneste, som serveren har brug for, er ikke tilgængelig. Prøv igen senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Dienst, den der Server benötigt, ist nicht verfügbar. Versuche es später erneut."
