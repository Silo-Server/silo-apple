        }
      }
    },
    "player.subtitles.deviceStyleNote" : {
      "comment" : "Apple iOS: note under the device settings switches on the Subtitle Appearance page of the iPhone and iPad player settings sheet while Use device settings is on. CC/SDH are caption types.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع لغة التسميات التوضيحية في هذا الجهاز وسلوكها وتفضيل CC/SDH والنمط الكامل من إعدادات تسهيلات الاستخدام."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следват се езикът на надписите, поведението, предпочитанието за CC/SDH и целият стил от настройките за достъпност на това устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se segueixen l’idioma dels subtítols, el comportament, la preferència de CC/SDH i l’estil complet d’aquest dispositiu definits a la configuració d’accessibilitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použije se jazyk titulků, chování, předvolba CC/SDH a celý styl z nastavení zpřístupnění tohoto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følger denne enheds undertekstsprog, adfærd, CC/SDH-præference og fulde stil fra indstillingerne for tilgængelighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgt der Untertitelsprache, dem Verhalten, der CC/SDH-Präferenz und dem vollständigen Stil dieses Geräts aus den Einstellungen für Bedienungshilfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμόζονται η γλώσσα λεζάντων, η συμπεριφορά, η προτίμηση CC/SDH και ολόκληρο το στυλ αυτής της συσκευής από τις ρυθμίσεις Προσβασιμότητας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Following this device's caption language, behavior, CC/SDH preference, and complete style from Accessibility settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usan el idioma de los subtítulos, el comportamiento, la preferencia de CC/SDH y el estilo completo de la configuración de Accesibilidad de este dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järgitakse selle seadme hõlbustusseadetes määratud subtiitrite keelt, käitumist, CC/SDH-eelistust ja kogu stiili."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noudatetaan tämän laitteen Käyttöapu-asetusten tekstityskieltä, toimintaa, CC/SDH-valintaa ja koko tyyliä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise la langue des sous-titres, le comportement, la préférence CC/SDH et le style complet définis dans les réglages d’accessibilité de cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בשימוש: שפת הכתוביות, ההתנהגות, העדפת CC/SDH והסגנון המלא מהגדרות הנגישות של המכשיר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस की ऐक्सेसिबिलिटी सेटिंग से कैप्शन की भाषा, व्यवहार, CC/SDH प्राथमिकता और पूरी स्टाइल का इस्तेमाल किया जा रहा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primjenjuju se jezik titlova, ponašanje, postavka CC/SDH i cjelokupni stil iz postavki pristupačnosti ovog uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek az eszköznek a Kisegítő lehetőségek beállításaiban megadott feliratnyelvét, működését, CC/SDH-preferenciáját és teljes stílusát követi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengikuti bahasa teks, perilaku, preferensi CC/SDH, dan seluruh gaya dari pengaturan Aksesibilitas di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono usati lingua, comportamento, preferenza CC/SDH e stile completo dei sottotitoli definiti nelle impostazioni di Accessibilità di questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスのアクセシビリティ設定にある字幕の言語、動作、CC/SDHの設定、スタイル全体に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손쉬운 사용 설정에 있는 이 기기의 자막 언어, 동작, CC/SDH 선호 설정과 전체 스타일을 따르고 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taikoma šio įrenginio titrų kalba, elgsena, CC/SDH nuostata ir visas stilius iš pritaikymo neįgaliesiems nustatymų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiek izmantota šīs ierīces subtitru valoda, darbība, CC/SDH preference un viss stils no pieejamības iestatījumiem."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengikut bahasa kapsyen, tingkah laku, keutamaan CC/SDH dan gaya penuh peranti ini daripada tetapan Kebolehcapaian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følger tekstingsspråket, virkemåten, CC/SDH-preferansen og hele stilen fra Tilgjengelighet-innstillingene på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volgt de ondertiteltaal, het gedrag, de CC/SDH-voorkeur en de volledige stijl van dit apparaat uit de instellingen voor Toegankelijkheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgodnie z ustawieniami dostępności tego urządzenia: język i działanie napisów, preferencja CC/SDH oraz pełny styl."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando o idioma, o comportamento, a preferência de CC/SDH e o estilo completo das legendas definidos nas configurações de Acessibilidade deste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seguir o idioma das legendas, o comportamento, a preferência de CC/SDH e o estilo completo das definições de Acessibilidade deste dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se folosesc limba subtitrărilor, comportamentul, preferința CC/SDH și stilul complet din setările de accesibilitate ale acestui dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используются язык, поведение, предпочтение CC/SDH и весь стиль субтитров из настроек универсального доступа этого устройства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používa sa jazyk titulkov, správanie, predvoľba CC/SDH a celý štýl z nastavení prístupnosti tohto zariadenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upoštevajo se jezik podnapisov, vedenje, prednostna izbira CC/SDH in celoten slog iz nastavitev dostopnosti te naprave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följer den här enhetens språk, beteende, CC/SDH-val och fullständiga stil för undertexter från inställningarna för hjälpmedel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ภาษาคำบรรยาย ลักษณะการทำงาน ตัวเลือก CC/SDH และรูปแบบทั้งหมดของอุปกรณ์นี้จากการตั้งค่าการช่วยการเข้าถึง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erişilebilirlik ayarlarındaki bu cihaza ait altyazı dili, davranışı, CC/SDH tercihi ve stilin tamamı kullanılıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуються мова субтитрів, поведінка, параметр CC/SDH і повний стиль цього пристрою з налаштувань «Доступність»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang theo ngôn ngữ phụ đề, cách hoạt động, tùy chọn CC/SDH và toàn bộ kiểu trong cài đặt Trợ năng của thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在使用此设备“辅助功能”设置中的字幕语言、行为、CC/SDH偏好和完整样式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在依照此裝置「輔助使用」設定中的字幕語言、行為、CC/SDH 偏好設定和完整樣式。"
          }
        }
      }
    },
