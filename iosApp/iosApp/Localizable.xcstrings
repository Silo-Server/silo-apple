    "settingsManifest.playback.max_bitrate_kbps.description" : {
      "comment" : "Help text under the playback.max_bitrate_kbps setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحديد مقدار عرض النطاق الذي يمكن أن يستخدمه التشغيل. بلا حد يعني أن Silo يختار وفق الدقة المحددة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничава колко честотна лента може да използва възпроизвеждането. Без ограничение Silo избира според избраната резолюция."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita l’amplada de banda que pot fer servir la reproducció. Sense límit, Silo tria segons la resolució escollida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omezí, kolik šířky pásma smí přehrávání využít. Bez omezení vybere Silo hodnotu podle zvoleného rozlišení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begræns, hvor meget båndbredde afspilningen må bruge. Uden grænse vælger Silo ud fra den valgte opløsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenzt, wie viel Bandbreite die Wiedergabe nutzen darf. Ohne Grenze wählt Silo passend zur gewählten Auflösung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όριο στο εύρος ζώνης που μπορεί να χρησιμοποιεί η αναπαραγωγή. Χωρίς όριο, το Silo επιλέγει με βάση την επιλεγμένη ανάλυση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap how much bandwidth playback may use. No cap means Silo picks for the chosen resolution."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita cuánto ancho de banda puede usar la reproducción. Sin límite, Silo elige según la resolución seleccionada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirab, kui palju ribalaiust esitus kasutada tohib. Kui piirangut pole, valib Silo bitikiiruse valitud eraldusvõime järgi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rajoita, kuinka paljon kaistaa toisto saa käyttää. Ilman rajoitusta Silo valitsee valitulle resoluutiolle sopivan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite la bande passante que la lecture peut utiliser. Sans limite, Silo choisit selon la résolution sélectionnée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגבלת רוחב הפס שההפעלה יכולה לנצל. ללא הגבלה, Silo בוחר לפי הרזולוציה שנבחרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेबैक में बैंडविड्थ इस्तेमाल की सीमा तय करें। कोई सीमा न होने पर Silo चुने गए रिज़ॉल्यूशन के हिसाब से बिटरेट चुनता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ograničava koliko propusnosti reprodukcija smije koristiti. Bez ograničenja Silo bira prema odabranoj rezoluciji."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korlátozza, mekkora sávszélességet használhat a lejátszás. Korlát nélkül a Silo a választott felbontáshoz igazítja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batasi bandwidth yang boleh digunakan pemutaran. Tanpa batas berarti Silo memilih sesuai resolusi yang dipilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita la larghezza di banda che la riproduzione può usare. Senza limite, Silo sceglie in base alla risoluzione selezionata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生に使う帯域幅を制限します。制限なしの場合、Siloが選択した解像度に合わせて決めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생에 사용할 대역폭을 제한해요. 제한이 없으면 Silo에서 선택한 해상도에 맞게 정해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riboti, kiek pralaidumo atkūrimas gali naudoti. Jei ribos nėra, „Silo“ parenka spartą pagal pasirinktą raišką."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ierobežo, cik daudz joslas platuma atskaņošana drīkst izmantot. Ja ierobežojuma nav, Silo izvēlas atbilstoši izvēlētajai izšķirtspējai."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadkan jumlah lebar jalur yang boleh digunakan oleh main balik. Tanpa had, Silo memilih mengikut resolusi yang dipilih."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrens hvor mye båndbredde avspillingen kan bruke. Uten begrensning velger Silo ut fra den valgte oppløsningen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperk hoeveel bandbreedte het afspelen mag gebruiken. Zonder limiet kiest Silo op basis van de gekozen resolutie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogranicz przepustowość, jaką może zużywać odtwarzanie. Bez limitu Silo dobiera ją do wybranej rozdzielczości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita quanta largura de banda a reprodução pode usar. Sem limite, o Silo escolhe de acordo com a resolução selecionada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limitar a largura de banda que a reprodução pode usar. Sem limite, o Silo escolhe de acordo com a resolução selecionada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limitează lățimea de bandă pe care o poate folosi redarea. Fără limită, Silo alege în funcție de rezoluția selectată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничить пропускную способность для воспроизведения. Без ограничения Silo подбирает битрейт под выбранное разрешение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obmedzí, koľko šírky pásma môže prehrávanie použiť. Bez obmedzenia Silo zvolí dátový tok podľa vybraného rozlíšenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omeji, koliko pasovne širine lahko porabi predvajanje. Brez omejitve Silo izbere glede na izbrano ločljivost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsa hur mycket bandbredd uppspelningen får använda. Utan gräns väljer Silo utifrån den valda upplösningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำกัดแบนด์วิดท์ที่การเล่นใช้ได้ หากไม่จำกัด Silo จะเลือกให้ตามความละเอียดที่เลือกไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatmanın kullanabileceği bant genişliğini sınırlar. Sınır yoksa Silo, seçilen çözünürlüğe göre belirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмежити пропускну здатність, яку може використовувати відтворення. Без обмеження Silo вибирає бітрейт відповідно до вибраної роздільної здатності."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giới hạn băng thông mà việc phát có thể dùng. Nếu không giới hạn, Silo sẽ tự chọn theo độ phân giải đã chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制播放可使用的带宽。不设上限时，Silo会根据所选分辨率自动选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制播放可使用的頻寬。不設上限時，Silo 會依所選解析度自動決定。"
          }
        }
      }
    },
