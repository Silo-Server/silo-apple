    "signIn.passwordChange.changedLead" : {
      "comment" : "Android phone Choose a new password screen, shown after signing in with a temporary password an admin set: text under Password changed. Apple (iPhone, iPad, Mac): same text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ كلمة المرور الجديدة، لكن لم يكتمل تسجيل دخولك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новата ви парола е запазена, но входът не завърши."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contrasenya nova s’ha desat, però no s’ha pogut completar l’inici de sessió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové heslo je uložené, ale přihlášení se nedokončilo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din nye adgangskode er gemt, men login blev ikke fuldført."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein neues Passwort ist gespeichert, aber die Anmeldung wurde nicht abgeschlossen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο νέος κωδικός πρόσβασης αποθηκεύτηκε, αλλά η σύνδεσή σας δεν ολοκληρώθηκε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your new password is saved, but signing you in didn't finish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña nueva se guardó, pero no se pudo terminar de iniciar sesión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie uus parool on salvestatud, kuid sisselogimine jäi lõpetamata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusi salasanasi on tallennettu, mutta kirjautuminen ei valmistunut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nouveau mot de passe est enregistré, mais la connexion n’a pas abouti."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסיסמה החדשה נשמרה, אבל ההתחברות לא הושלמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका नया पासवर्ड सेव हो गया है, लेकिन साइन इन पूरा नहीं हो सका।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša je nova lozinka spremljena, ali prijava nije dovršena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új jelszó mentve, de a bejelentkezés nem fejeződött be."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata sandi baru Anda telah disimpan, tetapi proses masuk belum selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuova password è stata salvata, ma l’accesso non è stato completato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいパスワードは保存されましたが、サインインは完了しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 비밀번호를 저장했지만 로그인을 완료하지 못했어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naujas slaptažodis išsaugotas, tačiau prisijungimas nebaigtas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu jaunā parole ir saglabāta, bet pierakstīšanos neizdevās pabeigt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata laluan baharu anda telah disimpan, tetapi proses log masuk tidak selesai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nye passordet ditt er lagret, men påloggingen ble ikke fullført."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je nieuwe wachtwoord is opgeslagen, maar het inloggen is niet voltooid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
