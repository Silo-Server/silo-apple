    "setup.recovery.forgetBody" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV) saved-server recovery screen: message of the confirmation before removing the saved server. {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى إزالة الاتصال المحفوظ وبيانات اعتماد تسجيل الدخول الخاصة بـ %1$@ من هذا الجهاز. لا يمكن التراجع عن ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die gespeicherte Verbindung und die Anmeldedaten für %1$@ von diesem Gerät entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes the saved connection and sign-in credentials for %1$@ from this device. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de este dispositivo la conexión guardada y las credenciales de inicio de sesión de %1$@. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime de cet appareil la connexion enregistrée et les identifiants de connexion pour %1$@. Elle est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスから%1$@の保存済みの接続情報とサインイン情報を削除します。この操作は元に戻せません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove deste dispositivo a conexão salva e as credenciais de login de %1$@. Não é possível desfazer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从此设备中移除%1$@的已保存连接和登录凭据。此操作无法撤销。"
          }
        }
      }
    },
