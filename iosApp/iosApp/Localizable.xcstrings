    "player.orientation.lockHint" : {
      "comment" : "Apple iOS: screen reader hint of the rotation lock button in the iPhone video player while rotation is unlocked.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمنع تدوير الفيديو عند تحريك الهاتف. يظل زر التدوير يعمل"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видеото няма да се завърта при движение на телефона. Бутонът за завъртане продължава да работи"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita que el moviment del telèfon giri el vídeo. El botó de girar continua funcionant"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video se nebude otáčet podle pohybu telefonu. Tlačítko otočení funguje dál"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhindrer, at videoen roterer, når telefonen bevæges. Rotationsknappen virker stadig"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhindert, dass sich das Video beim Bewegen des Smartphones dreht. Die Drehtaste funktioniert weiterhin"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κίνηση του τηλεφώνου δεν περιστρέφει πλέον το βίντεο. Το κουμπί περιστροφής εξακολουθεί να λειτουργεί"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops phone movement rotating video. The rotate button still works"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita que el movimiento del teléfono gire el video. El botón de girar sigue funcionando"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefoni liigutamine ei pööra videot. Pööramisnupp töötab endiselt"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estää videon kääntymisen puhelimen liikkeen mukana. Kiertopainike toimii edelleen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empêche la vidéo de pivoter quand vous bougez le téléphone. Le bouton de rotation reste actif"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תנועת הטלפון לא תסובב את הסרטון. כפתור הסיבוב ימשיך לפעול"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन घुमाने पर वीडियो को घूमने से रोकता है। रोटेट बटन फिर भी काम करता है"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomicanje telefona više ne okreće videozapis. Gumb za rotaciju i dalje radi"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A telefon mozgatása nem forgatja el a videót. Az elforgatás gomb továbbra is működik"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencegah gerakan ponsel merotasi video. Tombol rotasi tetap berfungsi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedisce che il video ruoti con i movimenti del telefono. Il pulsante di rotazione funziona comunque"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンを動かしてもビデオが回転しなくなります。回転ボタンは引き続き使用できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰을 움직여도 동영상이 회전하지 않아요. 회전 버튼은 계속 사용할 수 있어요"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefono judesiai nebesuka vaizdo įrašo. Pasukimo mygtukas vis tiek veikia"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tālruņa kustība vairs nepagriež video. Pagriešanas poga joprojām darbojas"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghalang pergerakan telefon daripada memutarkan video. Butang putar masih berfungsi"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindrer at videoen roterer når telefonen beveges. Rotasjonsknappen virker fortsatt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video draait niet meer mee als je de telefoon beweegt. De draaiknop werkt nog wel"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
