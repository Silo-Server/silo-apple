    "personal.favorites.emptyAnyBody" : {
      "comment" : "Apple tvOS: supporting line under the empty-state heading of a Favorites tab with no titles.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف عناصر إلى المفضلة من أي صفحة تفاصيل وستظهر هنا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете любими от която и да е страница с подробности и те ще се появят тук."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix preferits des de qualsevol pàgina de detalls i apareixeran aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte oblíbené na libovolné stránce s podrobnostmi a zobrazí se zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj favoritter fra en hvilken som helst detaljeside, så vises de her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Favoriten auf einer beliebigen Detailseite hinzu, dann erscheinen sie hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε αγαπημένα από οποιαδήποτε σελίδα λεπτομερειών και θα εμφανιστούν εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add favorites from any detail page and they will appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade favoritos desde cualquier página de detalles y aparecerán aquí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisage lemmikuid mis tahes üksikasjade lehelt ja need kuvatakse siin."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää suosikkeja miltä tahansa tietosivulta, niin ne näkyvät täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des favoris depuis n’importe quelle page de détails et ils apparaîtront ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להוסיף מועדפים מכל דף פרטים, והם יופיעו כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी विवरण पेज से पसंदीदा जोड़ें। जोड़े गए टाइटल यहाँ दिखेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte favorite s bilo koje stranice s detaljima i pojavit će se ovdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjon hozzá kedvenceket bármely részletek oldalon, és itt jelennek meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan favorit dari halaman detail mana pun dan favorit akan muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi preferiti da qualsiasi pagina dei dettagli e compariranno qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細ページからお気に入りに追加すると、ここに表示されます。"
