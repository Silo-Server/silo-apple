    "settingsManifest.ui.next_up_new_releases_first.description" : {
      "comment" : "Help text under the ui.next_up_new_releases_first setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقل المسلسل الذي لحقت بآخر حلقاته إلى بداية متابعة المشاهدة والحلقات التالية عند وصول حلقة أو موسم جديد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преместване на сериал, който сте наваксали, в началото на „Продължете да гледате“ и „Следващи епизоди“, когато излезе нов епизод или сезон."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mou una sèrie que tens al dia al principi de Continua veient i Propers episodis quan arriba un episodi o una temporada nous."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když vyjde nový díl nebo řada seriálu, který máte dosledovaný, přesunout ho na začátek řádků Pokračovat ve sledování a Další díly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt en serie, du har set færdig, forrest i Fortsæt med at se og Næste afsnit, når et nyt afsnit eller en ny sæson kommer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Serie, bei der du auf dem neuesten Stand bist, rückt in Weiterschauen und Nächste Folgen nach vorne, sobald eine neue Folge oder Staffel erscheint."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια σειρά που έχετε δει μέχρι το τελευταίο επεισόδιο μετακινείται στην αρχή των γραμμών «Συνέχεια παρακολούθησης» και «Επόμενα επεισόδια» όταν προστεθεί νέο επεισόδιο ή νέα σεζόν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move a show you've caught up on to the front of Continue Watching and Next Up when a new episode or season arrives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve una serie que tienes al día al principio de Seguir viendo y Próximos cuando llega un episodio o una temporada nuevos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui lisandub uus osa või hooaeg, viiakse sari, mille kõik osad olete juba vaadanud, ridade „Jätka vaatamist“ ja „Järgmised osad“ algusesse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä loppuun asti katsottu sarja rivien Jatka katsomista ja Seuraavat jaksot alkuun, kun uusi jakso tai kausi ilmestyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placer en tête de Reprendre la lecture et de Prochains épisodes une série que vous avez rattrapée lorsqu’un nouvel épisode ou une nouvelle saison arrive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמגיע פרק חדש או עונה חדשה לסדרה שהשלמת את הצפייה בה, היא תועבר לתחילת השורות ”המשך צפייה” ו”הפרקים הבאים”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो सीरीज़ पूरी देखी जा चुकी है, उसका नया एपिसोड या सीज़न आने पर उसे देखना जारी रखें और अगले एपिसोड में सबसे आगे ले जाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad stigne nova epizoda ili sezona, serija koju ste sustigli premješta se na početak redaka Nastavi gledati i Sljedeće epizode."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha új epizód vagy évad érkezik egy sorozathoz, amelynek minden részét megnézte, a sorozat a Megtekintés folytatása és a Következő epizódok sor elejére kerül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindahkan serial yang sudah Anda tonton hingga episode terbaru ke depan Lanjutkan menonton dan Episode berikutnya saat episode atau musim baru tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando arriva un nuovo episodio o una nuova stagione, sposta in cima a Continua a guardare e Prossimi episodi una serie che hai finito di recuperare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新話まで視聴済みのシリーズに新しいエピソードやシーズンが追加されると、視聴を続けると次のエピソードの先頭に移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다 본 시리즈에 새 에피소드나 시즌이 추가되면 이어서 보기와 다음 에피소드의 맨 앞으로 옮겨요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai pasirodo naujas epizodas ar sezonas, serialas, kurį jau peržiūrėjote, perkeliamas į eilučių „Tęsti žiūrėjimą“ ir „Kiti epizodai“ pradžią."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad iznāk jauna epizode vai sezona, seriāls, kura visas epizodes jau redzējāt, tiek pārvietots rindu „Turpināt skatīties” un „Nākamās epizodes” sākumā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alihkan siri yang sudah anda tonton sepenuhnya ke hadapan Teruskan menonton dan Episod seterusnya apabila episod atau musim baharu tiba."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt en serie du har tatt igjen, først i Fortsett å se og Neste episoder når en ny episode eller sesong kommer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet een serie die je hebt bijgehouden vooraan in Verder kijken en Volgende afleveringen wanneer er een nieuwe aflevering of een nieuw seizoen verschijnt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenosi serial, z którym jesteś na bieżąco, na początek rzędów Kontynuuj oglądanie i Następne odcinki, gdy pojawi się nowy odcinek lub sezon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leva uma série que você já pôs em dia para o início de Continuar assistindo e Próximos episódios quando chega um novo episódio ou uma nova temporada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover uma série que tenha em dia para o início de Continuar a ver e Próximos episódios quando chegar um novo episódio ou temporada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutați un serial pe care l-ați vizionat la zi la începutul rândurilor Continuați vizionarea și Episoade următoare când apare un episod sau un sezon nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда выходит новая серия или сезон сериала, который вы досмотрели, перемещать его в начало рядов «Продолжить просмотр» и «Следующие серии»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď pribudne nová epizóda alebo séria, seriál, ktorý máte dopozeraný, sa presunie na začiatok radov Pokračovať v sledovaní a Ďalšie epizódy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko izide nova epizoda ali sezona, se serija, ki ste jo dohiteli, premakne na začetek vrstic Nadaljuj z ogledom in Naslednje epizode."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytta en serie som du har kommit ikapp med till början av Fortsätt titta och Nästa avsnitt när ett nytt avsnitt eller en ny säsong kommer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้ายซีรีส์ที่คุณดูทันแล้วไปไว้หน้าสุดของดูต่อและตอนถัดไปเมื่อมีตอนหรือซีซั่นใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir bölüm veya sezon geldiğinde, son bölümüne kadar izlediğiniz bir diziyi “İzlemeye devam et” ve “Sıradaki bölümler” satırlarının başına taşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли виходить новий епізод або сезон серіалу, який ви вже наздогнали, переміщувати його на початок рядів «Продовжити перегляд» і «Наступні епізоди»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đưa phim bộ bạn đã xem hết lên đầu Tiếp tục xem và Tập tiếp theo khi có tập hoặc mùa mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你已追平的剧集有新的一集或一季推出时，将其移到继续观看和接下来的最前面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當有新的一集或新的一季推出時，將你已追上進度的影集移到繼續觀看和接下來的最前面。"
          }
        }
      }
    },
