    "settings.interface.playThemeMusicSubtitle" : {
      "comment" : "Apple Settings > Interface > Theme Music and Apple TV Settings > General > Theme Music: description of the Play Theme Music switch (VoiceOver hint on iPhone, iPad and Apple TV; shown under the switch on Mac).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل الأغنية الرئيسية للعنوان من مكتبتك أثناء فتح صفحته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt die Titelmusik eines Titels aus deiner Mediathek, solange seine Seite geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play a title's theme song from your library while its page is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce el tema musical de un título desde tu biblioteca mientras su página está abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit le thème musical d’un titre depuis votre bibliothèque tant que sa page est ouverte."
          }
        },
        "ja" : {
