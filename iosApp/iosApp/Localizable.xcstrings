    "notReady.unreachable" : {
      "comment" : "Message on Roku after rechecking when the server could not be reached. Apple (iPhone, iPad, Mac, Apple TV): same message after Check again on the server needs setup screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى الخادم. تأكد من أنه قيد التشغيل وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server konnte nicht erreicht werden. Prüfe, ob er läuft, und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach the server. Check it's running and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con el servidor. Comprueba que esté en funcionamiento y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le serveur. Vérifiez qu’il est en cours d’exécution et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーに接続できませんでした。サーバーが実行中か確認して、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o servidor. Verifique se ele está em execução e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到服务器。请确认它正在运行，然后重试。"
          }
        }
      }
    },
