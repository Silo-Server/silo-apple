    "watchParty.strip.guest" : {
      "comment" : "Caption of the suggestions strip for guests, who can suggest but only the host picks: Watch Party on Roku, Android phone and TV, beside the lobby's suggestions on Apple iPhone, iPad and Apple TV, and the web Watch Together lobby.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المضيف يقرر ما يتم تشغيله."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Домакинът решава какво да се пусне."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui organitza decideix què es reprodueix."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tom, co se přehraje, rozhoduje hostitel."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værten bestemmer, hvad der afspilles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer die Party leitet, entscheidet, was läuft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο οικοδεσπότης αποφασίζει τι θα αναπαραχθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host decides what plays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien organiza decide qué se reproduce."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korraldaja otsustab, mida esitatakse."
          }
