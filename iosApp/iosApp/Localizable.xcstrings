    "settings.playback.atmosFooter" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: sentence in the Streaming footer about the TrueHD Atmos and DTS:X switch. TrueHD Atmos and DTS:X are audio format names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تفعيل TrueHD Atmos وDTS:X، تحتفظ هذه المسارات بقنوات الارتفاع لكنها تُشغَّل كصوت مضغوط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je zapnuto TrueHD Atmos a DTS:X, tyto stopy si zachovají výškové kanály, ale přehrají se jako komprimovaný zvuk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med TrueHD Atmos og DTS:X slået til beholder disse spor deres højdekanaler, men afspilles som komprimeret lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn TrueHD Atmos und DTS:X eingeschaltet ist, behalten diese Spuren ihre Höhenkanäle, werden aber als komprimierter Ton wiedergegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With TrueHD Atmos and DTS:X on, those tracks keep their height channels but play as compressed audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con TrueHD Atmos y DTS:X activado, esas pistas conservan sus canales de altura, pero se reproducen como audio comprimido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun TrueHD Atmos ja DTS:X on päällä, näiden raitojen korkeuskanavat säilyvät, mutta ne toistetaan pakattuna äänenä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec TrueHD Atmos et DTS:X activé, ces pistes conservent leurs canaux de hauteur mais sont lues en audio compressé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je TrueHD Atmos i DTS:X uključeno, ti zapisi zadržavaju visinske kanale, ali se reproduciraju kao komprimirani zvuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con TrueHD Atmos e DTS:X attivo, queste tracce mantengono i canali di altezza ma vengono riprodotte come audio compresso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TrueHD AtmosとDTS:Xをオンにすると、これらのトラックはハイトチャンネルを保持したまま、圧縮オーディオとして再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TrueHD Atmos 및 DTS:X를 켜면 해당 트랙은 높이 채널을 유지하지만 압축 오디오로 재생돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med TrueHD Atmos og DTS:X på beholder disse sporene høydekanalene, men spilles av som komprimert lyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met TrueHD Atmos en DTS:X aan behouden die sporen hun hoogtekanalen, maar worden ze als gecomprimeerde audio afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy opcja TrueHD Atmos i DTS:X jest włączona, te ścieżki zachowują kanały wysokości, ale są odtwarzane jako dźwięk skompresowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com TrueHD Atmos e DTS:X ativado, essas faixas mantêm os canais de altura, mas são reproduzidas como áudio compactado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если параметр «TrueHD Atmos и DTS:X» включён, такие дорожки сохраняют каналы высоты, но воспроизводятся как сжатый звук."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med TrueHD Atmos och DTS:X på behåller de spåren sina höjdkanaler men spelas upp som komprimerat ljud."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TrueHD Atmos ve DTS:X açıkken bu parçalar yükseklik kanallarını korur, ancak sıkıştırılmış ses olarak oynatılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо TrueHD Atmos і DTS:X увімкнено, ці доріжки зберігають канали висоти, але відтворюються як стиснений звук."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启TrueHD Atmos和DTS:X后，这些音轨会保留天空声道，但以压缩音频播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟 TrueHD Atmos 和 DTS:X 後，這些音軌會保留高度聲道，但會以壓縮音訊播放。"
          }
        }
      }
    },
    "settings.playback.atmosReceiverFooter" : {
      "comment" : "Apple TV Settings > Playback: last sentence of the Streaming footer; it refers to the TrueHD Atmos and DTS:X switch.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عطّله إذا كان جهاز الاستقبال أو مكبر الصوت لديك لا يدعم Dolby Atmos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud váš receiver nebo soundbar nepodporuje Dolby Atmos, tuto možnost vypněte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå det fra, hvis din receiver eller soundbar ikke understøtter Dolby Atmos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte die Option aus, wenn dein Receiver oder deine Soundbar Dolby Atmos nicht unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn it off if your receiver or soundbar doesn't support Dolby Atmos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactívalo si tu receptor o barra de sonido no es compatible con Dolby Atmos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista se käytöstä, jos vahvistimesi tai soundbarisi ei tue Dolby Atmosia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez-le si votre ampli-tuner ou votre barre de son ne prend pas en charge Dolby Atmos."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isključite ovo ako vaš prijemnik ili soundbar ne podržava Dolby Atmos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivalo se il tuo ricevitore o la tua soundbar non supporta Dolby Atmos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシーバーやサウンドバーがDolby Atmosに対応していない場合はオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리시버나 사운드바가 Dolby Atmos를 지원하지 않으면 이 옵션을 끄세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå det av hvis receiveren eller lydplanken din ikke støtter Dolby Atmos."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet dit uit als je receiver of soundbar geen Dolby Atmos ondersteunt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz ją, jeśli twój amplituner lub soundbar nie obsługuje Dolby Atmos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative se o seu receiver ou soundbar não for compatível com Dolby Atmos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключите его, если ресивер или саундбар не поддерживает Dolby Atmos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng av det om din receiver eller soundbar inte har stöd för Dolby Atmos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alıcınız veya ses çubuğunuz Dolby Atmos desteklemiyorsa bunu kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкніть цей параметр, якщо ваш ресивер або саундбар не підтримує Dolby Atmos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你的功放或回音壁不支持Dolby Atmos，请关闭此选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你的擴大機或聲霸不支援 Dolby Atmos，請關閉此選項。"
