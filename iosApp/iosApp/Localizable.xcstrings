    "error.field.invalid_entity_tag" : {
      "comment" : "Error shown next to or about one request field when the server reports the field-error code `invalid_entity_tag`, for an If-Match or If-None-Match header that is not \"*\" or a list of quoted entity-tags. Clients show it instead of the server's English detail in a translated interface. \"*\" is the literal asterisk character.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن تكون القيمة «*» أو قائمة من وسوم الكيانات بين علامات اقتباس ومفصولة بفواصل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erwartet wird „*“ oder eine kommagetrennte Liste von Entity-Tags in Anführungszeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expected \"*\" or a comma-separated list of quoted entity-tags."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esperaba “*” o una lista de etiquetas de entidad entre comillas separadas por comas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeur attendue : \"*\" ou une liste de balises d’entité (ETag) entre guillemets, séparées par des virgules."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「*」、または引用符で囲んだエンティティタグのカンマ区切りリストを指定してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperava-se “*” ou uma lista de entity-tags entre aspas, separadas por vírgulas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应为“*”或以逗号分隔的带引号实体标签列表。"
          }
        }
      }
    },
    "error.field.invalid_enum" : {
