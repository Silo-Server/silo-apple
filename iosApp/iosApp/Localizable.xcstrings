          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת מכין גרסאות בקצב סיביות מוגדר מראש כשהמקור גדול יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ओरिजिनल फ़ाइल बड़ी होने पर, बिटरेट प्रीसेट सर्वर पर तैयार किए जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unaprijed postavljene brzine prijenosa pripremaju se na poslužitelju kada je izvornik veći."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bitráta-előbeállításokat a szerver készíti elő, ha az eredeti fájl nagyobb."
