    "settings.general.titleArtAllOffTv" : {
      "comment" : "Apple TV Settings > General > Title Pages: note while Apply to All Devices is on and Show Title Art is off. Title art is logo artwork used as a title's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شعار العنوان معطّل على كل جهاز مسجّل الدخول إلى هذا الملف الشخصي. تغييره هنا يغيّره في كل مكان. عطّل «تطبيق على جميع الأجهزة» للاختيار لهذا Apple TV فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Titelgrafik ist auf allen Geräten aus, die mit diesem Profil angemeldet sind. Eine Änderung hier gilt überall. Deaktiviere „Auf alle Geräte anwenden“, um nur für dieses Apple TV zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Title art is off on every device signed into this profile. Changing it here changes it everywhere. Turn off Apply to All Devices to choose for this Apple TV only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El arte del título está desactivado en todos los dispositivos con sesión iniciada en este perfil. Si lo cambias aquí, cambia en todas partes. Desactiva Aplicar a todos los dispositivos para elegir solo para este Apple TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les logos de titre sont désactivés sur tous les appareils connectés à ce profil. Les modifier ici les modifie partout. Désactivez Appliquer à tous les appareils pour choisir uniquement pour cette Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールでサインインしているすべてのデバイスで、タイトルロゴはオフです。ここで変更すると、すべてのデバイスで変更されます。このApple TVだけで選ぶには、「すべてのデバイスに適用」をオフにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A arte do título está desativada em todos os dispositivos conectados a este perfil. Alterar aqui altera em todos eles. Desative “Aplicar a todos os dispositivos” para escolher só para esta Apple TV."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录此个人资料的所有设备都已关闭标题图。在此更改会同步到所有设备。关闭“应用到所有设备”即可仅为这台Apple TV单独选择。"
          }
        }
      }
    },
    "settings.general.titleArtAllOnTv" : {
      "comment" : "Apple TV Settings > General > Title Pages: note while Apply to All Devices and Show Title Art are both on. Title art is logo artwork used as a title's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شعار العنوان مفعّل على كل جهاز مسجّل الدخول إلى هذا الملف الشخصي. تغييره هنا يغيّره في كل مكان. عطّل «تطبيق على جميع الأجهزة» للاختيار لهذا Apple TV فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Titelgrafik ist auf allen Geräten ein, die mit diesem Profil angemeldet sind. Eine Änderung hier gilt überall. Deaktiviere „Auf alle Geräte anwenden“, um nur für dieses Apple TV zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Title art is on on every device signed into this profile. Changing it here changes it everywhere. Turn off Apply to All Devices to choose for this Apple TV only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El arte del título está activado en todos los dispositivos con sesión iniciada en este perfil. Si lo cambias aquí, cambia en todas partes. Desactiva Aplicar a todos los dispositivos para elegir solo para este Apple TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les logos de titre sont activés sur tous les appareils connectés à ce profil. Les modifier ici les modifie partout. Désactivez Appliquer à tous les appareils pour choisir uniquement pour cette Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールでサインインしているすべてのデバイスで、タイトルロゴはオンです。ここで変更すると、すべてのデバイスで変更されます。このApple TVだけで選ぶには、「すべてのデバイスに適用」をオフにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A arte do título está ativada em todos os dispositivos conectados a este perfil. Alterar aqui altera em todos eles. Desative “Aplicar a todos os dispositivos” para escolher só para esta Apple TV."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录此个人资料的所有设备都已开启标题图。在此更改会同步到所有设备。关闭“应用到所有设备”即可仅为这台Apple TV单独选择。"
          }
        }
      }
    },
    "settings.general.titleArtThisAppleTv" : {
      "comment" : "Apple TV Settings > General > Title Pages: note while Apply to All Devices is off.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم صورة الشعار عنوانًا عند توفرها. يؤثر في هذا Apple TV فقط. تحتفظ أجهزتك الأخرى بإعدادها الخاص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet, wenn verfügbar, ein Logo als Titel. Gilt nur für dieses Apple TV. Deine anderen Geräte behalten ihre eigene Einstellung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use logo artwork as the title when available. Only affects this Apple TV. Your other devices keep their own setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el logotipo como título cuando esté disponible. Solo afecta a este Apple TV. Tus otros dispositivos mantienen su propia configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le logo comme titre lorsqu’il est disponible. S’applique uniquement à cette Apple TV. Vos autres appareils conservent leur propre paramètre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用できる場合は、ロゴのアートワークをタイトルとして使用します。このApple TVにのみ適用されます。ほかのデバイスはそれぞれの設定を保持します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o logotipo como título quando disponível. Afeta só esta Apple TV. Seus outros dispositivos mantêm a própria configuração."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有标志图时用其作为标题。仅影响这台Apple TV，你的其他设备保留各自的设置。"
          }
        }
      }
    },
