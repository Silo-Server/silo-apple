    "settings.spoilers.footer" : {
      "comment" : "Android phone and TV. Phone: note under the two spoiler switches on Settings → Playback, saying where they apply. TV: Settings > Playback > Spoilers: help text under the two spoiler switches. Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: note under the spoiler switches.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينطبق على الحلقات التي لم تبدأ مشاهدتها، على كل جهاز يستخدم هذا الملف الشخصي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прилага се за незапочнатите епизоди на всяко устройство, което използва този профил."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’aplica als episodis que no has començat, en tots els dispositius que utilitzen aquest perfil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pro nezačaté díly na všech zařízeních, která používají tento profil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder afsnit, du ikke er begyndt på, på alle enheder, der bruger denne profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Folgen, die du noch nicht begonnen hast, auf allen Geräten, die dieses Profil verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχύουν για επεισόδια που δεν έχετε αρχίσει, σε κάθε συσκευή που χρησιμοποιεί αυτό το προφίλ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to episodes you have not started, on every device that uses this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a los episodios que no has empezado, en todos los dispositivos que usan este perfil."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehtib osadele, mille vaatamist te pole alustanud, kõigis seadmetes, mis seda profiili kasutavad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koskee jaksoja, joita et ole aloittanut, kaikissa tätä profiilia käyttävissä laitteissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique aux épisodes que vous n’avez pas commencés, sur chaque appareil qui utilise ce profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חל על פרקים שעדיין לא התחלת, בכל מכשיר שמשתמש בפרופיל הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन एपिसोड पर लागू होता है जिन्हें आपने शुरू नहीं किया है, इस प्रोफ़ाइल का इस्तेमाल करने वाले हर डिवाइस पर।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odnosi se na epizode koje niste započeli, na svim uređajima koji koriste ovaj profil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azokra az epizódokra vonatkozik, amelyeket még nem kezdett el, minden olyan eszközön, amely ezt a profilt használja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berlaku untuk episode yang belum Anda mulai, di setiap perangkat yang menggunakan profil ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale per gli episodi che non hai iniziato, su ogni dispositivo che usa questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールを使用するすべてのデバイスで、未視聴のエピソードに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필을 사용하는 모든 기기에서 아직 시작하지 않은 에피소드에 적용돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taikoma epizodams, kurių dar nepradėjote žiūrėti, visuose įrenginiuose, kuriuose naudojamas šis profilis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiecas uz epizodēm, kuras neesat sākuši skatīties, visās ierīcēs, kurās tiek izmantots šis profils."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan pada episod yang belum anda mulakan, pada setiap peranti yang menggunakan profil ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjelder episoder du ikke har begynt på, på alle enheter som bruker denne profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt voor afleveringen waar je nog niet aan bent begonnen, op elk apparaat dat dit profiel gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy nierozpoczętych odcinków na każdym urządzeniu, które używa tego profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale para episódios que você ainda não começou, em todos os dispositivos que usam este perfil."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se aos episódios que ainda não começou, em todos os dispositivos que usam este perfil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplică episoadelor pe care nu le-ați început, pe toate dispozitivele care folosesc acest profil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует для серий, которые вы ещё не начали смотреть, на всех устройствах с этим профилем."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pre epizódy, ktoré ste ešte nezačali pozerať, vo všetkých zariadeniach, ktoré používajú tento profil."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velja za epizode, ki jih še niste začeli gledati, v vseh napravah, ki uporabljajo ta profil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller avsnitt som du inte har börjat titta på, på alla enheter som använder den här profilen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีผลกับตอนที่คุณยังไม่ได้เริ่มดู ในทุกอุปกรณ์ที่ใช้โปรไฟล์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlamadığınız bölümlere, bu profili kullanan tüm cihazlarda uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосовується до епізодів, які ви ще не почали дивитися, на всіх пристроях, що використовують цей профіль."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áp dụng cho các tập bạn chưa bắt đầu xem, trên mọi thiết bị dùng hồ sơ này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于你尚未开始观看的集，并作用于使用此个人资料的所有设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用於你尚未開始觀看的集數，並套用至所有使用此個人檔案的裝置。"
          }
        }
      }
    },
