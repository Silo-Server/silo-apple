        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールでサインインしているすべてのデバイスで、タイトルロゴはオンです。ここで変更すると、すべてのデバイスで変更されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
