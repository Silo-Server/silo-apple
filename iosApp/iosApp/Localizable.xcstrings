    "settingsManifest.player.seek_cache_enabled.description" : {
      "comment" : "Help text under the player.seek_cache_enabled setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاحتفاظ بالمقاطع التي شُغّلت مؤخرًا في التخزين المؤقت لتنقل أسرع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пази наскоро възпроизведените сегменти в буфера за по-бързо превъртане."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manté a la memòria intermèdia els segments reproduïts recentment per canviar de posició més ràpidament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uchovávat nedávno přehrané segmenty v mezipaměti pro rychlejší přetáčení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nyligt afspillede segmenter i bufferen for hurtigere spoling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuletzt abgespielte Segmente gepuffert halten, um schneller zu spulen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διατήρηση των πρόσφατα αναπαραγμένων τμημάτων στην προσωρινή μνήμη για ταχύτερη μετάβαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep recently played segments buffered for faster seeking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene en búfer los segmentos reproducidos recientemente para desplazarte más rápido."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoiab hiljuti esitatud lõigud puhvris, et kerimine oleks kiirem."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä äskettäin toistetut osat puskurissa, jotta siirtyminen on nopeampaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserver en mémoire tampon les segments lus récemment pour une navigation plus rapide."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמירת קטעים שהופעלו לאחרונה במאגר הזמני למעבר מהיר יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तेज़ी से आगे-पीछे करने के लिए हाल में चलाए गए सेगमेंट बफ़र में रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadržava nedavno reproducirane segmente u međuspremniku za brže premotavanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nemrég lejátszott szegmensek pufferben tartása a gyorsabb tekerés érdekében."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan segmen yang baru diputar di buffer agar lompat ke posisi lain lebih cepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni nel buffer i segmenti riprodotti di recente per spostarti più velocemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近再生したセグメントをバッファに保持し、シークを高速化します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 재생한 구간을 버퍼에 유지해 더 빠르게 탐색해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laikyti neseniai leistus segmentus buferyje, kad būtų greičiau persukama."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saglabāt nesen atskaņotos segmentus buferī ātrākai pārtīšanai."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan segmen yang baru dimainkan dalam penimbal supaya lompat ke kedudukan lain lebih pantas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nylig avspilte segmenter i bufferen for raskere spoling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd onlangs afgespeelde segmenten in de buffer om sneller te kunnen zoeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechowuje ostatnio odtworzone segmenty w buforze, aby przewijanie było szybsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém em cache os segmentos reproduzidos recentemente para avançar e voltar mais rápido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter em memória intermédia os segmentos reproduzidos recentemente para avançar ou recuar mais depressa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrați în buffer segmentele redate recent pentru o derulare mai rapidă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранить недавно воспроизведённые сегменты в буфере для более быстрой перемотки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uchováva nedávno prehrané segmenty vo vyrovnávacej pamäti pre rýchlejšie pretáčanie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedavno predvajani segmenti ostanejo v medpomnilniku za hitrejše previjanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåll nyligen uppspelade segment i bufferten för snabbare spolning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บส่วนที่เพิ่งเล่นไว้ในบัฟเฟอร์เพื่อให้กรอได้เร็วขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha hızlı sarma için son oynatılan kısımları arabellekte tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігати нещодавно відтворені сегменти в буфері для швидшого перемотування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ các phân đoạn vừa phát trong bộ đệm để tua nhanh hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓存最近播放的片段，以便更快地跳转。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留最近播放片段的緩衝，讓跳轉更快速。"
          }
        }
      }
    },
