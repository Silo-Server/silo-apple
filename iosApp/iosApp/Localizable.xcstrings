          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakındaki bir telefon veya tablet, bu Apple TV’de %1$@ sunucusunda oturum açmak istiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон або планшет поблизу хоче ввійти з цього Apple TV на %1$@."
          }
