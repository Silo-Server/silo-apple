    "shell.error.identityChanged" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error message when a load was abandoned because the user switched server or profile while it ran.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر الخادم النشط أو الملف الشخصي. حاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активният сървър или профил се промени. Опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor o el perfil actiu ha canviat. Torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivní server nebo profil se změnil. Zkuste to znovu."
