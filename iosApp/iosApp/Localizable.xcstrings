          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rendezés olyan mezőt ad meg, amely szerint ez a művelet nem rendez, vagy egy mezőt kétszer ad meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengurutan menyebut kolom yang tidak dapat digunakan untuk mengurutkan operasi ini, atau menyebut satu kolom dua kali."
