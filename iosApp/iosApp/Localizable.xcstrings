          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza s poslužiteljem prekinuta je prije kraja epizode."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megszakadt a kapcsolat a szerverrel, mielőtt az epizód véget ért."
          }
