          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电视准备你的个人资料用时过长。"
          }
        }
      }
    },
    "remote.error.profileUnverified" : {
      "comment" : "Apple iOS: Remote Control error when the TV's profile handoff reply did not match the phone's server and profile.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على التلفزيون التحقق من ملفك الشخصي للتشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher konnte dein Wiedergabeprofil nicht überprüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The TV could not verify your playback profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV no pudo verificar tu perfil de reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV n’a pas pu vérifier votre profil de lecture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テレビで再生用のプロフィールを確認できませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV não conseguiu verificar seu perfil de reprodução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电视无法验证你的播放个人资料。"
          }
        }
      }
    },
    "remote.error.reconnectFailed" : {
      "comment" : "Apple iOS: Remote Control error shown on the remote when playing from the phone could not reconnect to the last TV. 1: the TV's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت إعادة الاتصال بـ %1$@. اختر تلفزيونًا لمواصلة التشغيل عليه، أو أوقف وضع التحكم للتشغيل هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zu %1$@ konnte nicht wiederhergestellt werden. Wähle einen Fernseher, um dort weiterzuschauen, oder schalte den Steuerungsmodus aus, um hier abzuspielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reconnect to %1$@. Choose a TV to keep playing there, or turn off control mode to play here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo volver a conectar con %1$@. Elige una TV para seguir reproduciendo allí o desactiva el modo de control para reproducir aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de se reconnecter à %1$@. Choisissez une TV pour y poursuivre la lecture, ou désactivez le mode de contrôle pour lire ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に再接続できませんでした。そのテレビで再生を続けるにはテレビを選択し、このデバイスで再生するには操作モードをオフにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível reconectar a %1$@. Escolha uma TV para continuar assistindo nela ou desative o modo de controle para reproduzir aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法重新连接到%1$@。选择一台电视以继续在电视上播放，或关闭控制模式以在此处播放。"
          }
        }
      }
    },
    "remote.error.reconnectFailedUnnamed" : {
      "comment" : "Apple iOS: Remote Control error shown on the remote when playing from the phone could not reconnect to the last TV and its name is not known.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت إعادة الاتصال بالتلفزيون. اختر تلفزيونًا لمواصلة التشغيل عليه، أو أوقف وضع التحكم للتشغيل هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zum Fernseher konnte nicht wiederhergestellt werden. Wähle einen Fernseher, um dort weiterzuschauen, oder schalte den Steuerungsmodus aus, um hier abzuspielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reconnect to the TV. Choose a TV to keep playing there, or turn off control mode to play here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo volver a conectar con la TV. Elige una TV para seguir reproduciendo allí o desactiva el modo de control para reproducir aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de se reconnecter à la TV. Choisissez une TV pour y poursuivre la lecture, ou désactivez le mode de contrôle pour lire ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テレビに再接続できませんでした。そのテレビで再生を続けるにはテレビを選択し、このデバイスで再生するには操作モードをオフにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível reconectar à TV. Escolha uma TV para continuar assistindo nela ou desative o modo de controle para reproduzir aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法重新连接到电视。选择一台电视以继续在电视上播放，或关闭控制模式以在此处播放。"
          }
        }
      }
    },
    "remote.error.requiresPairing" : {
      "comment" : "Apple iOS: Remote Control error on the remote when a Roku must be paired first. Keep \"Connect a Phone\" as the Roku's menu item is named. 1: the Roku's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب %1$@ الإقران. على جهاز Roku، افتح «توصيل هاتف» في قائمة الملف الشخصي في Silo وامسح رمزه بكاميرا جهاز iPhone هذا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ muss gekoppelt werden. Öffne auf dem Roku im Profilmenü von Silo „Smartphone verbinden“ und scanne den Code mit der Kamera dieses iPhones."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ requires pairing. On the Roku, open Connect a Phone in Silo's profile menu and scan its code with this iPhone's camera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ requiere vinculación. En el Roku, abre Conectar un teléfono en el menú de perfil de Silo y escanea su código con la cámara de este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nécessite une association. Sur le Roku, ouvrez Connecter un téléphone dans le menu du profil de Silo et scannez son code avec l’appareil photo de cet iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@にはペアリングが必要です。RokuのSiloでプロフィールメニューから「スマートフォンを接続」を開き、このiPhoneのカメラでコードをスキャンしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ exige pareamento. No Roku, abra Conectar um celular no menu de perfil do Silo e escaneie o código com a câmera deste iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@需要配对。请在Roku上打开Silo个人资料菜单中的“连接手机”，然后用此iPhone的相机扫描其代码。"
          }
        }
      }
