    "downloads.seriesSheet.skipUnconvertible" : {
      "comment" : "Apple iOS/macOS: series Download sheet, opened from a series page; note under the options for a season or series download in a preset quality.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُتخطّى الحلقات التي يتعذّر على الخادم تحويلها إلى هذه الجودة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díly, které server nedokáže převést do této kvality, se přeskočí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afsnit, som serveren ikke kan konvertere til denne kvalitet, springes over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgen, die der Server nicht in diese Qualität umwandeln kann, werden übersprungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episodes the server can't convert to this quality are skipped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se omiten los episodios que el servidor no puede convertir a esta calidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaksot, joita palvelin ei voi muuntaa tähän laatuun, ohitetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes que le serveur ne peut pas convertir dans cette qualité sont ignorés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epizode koje poslužitelj ne može pretvoriti u ovu kvalitetu preskaču se."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli episodi che il server non può convertire in questa qualità vengono saltati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーがこの画質に変換できないエピソードはスキップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에서 이 화질로 변환할 수 없는 에피소드는 건너뛰어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episoder som serveren ikke kan konvertere til denne kvaliteten, hoppes over."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afleveringen die de server niet naar deze kwaliteit kan omzetten, worden overgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odcinki, których serwer nie może przekonwertować do tej jakości, są pomijane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episódios que o servidor não consegue converter para esta qualidade são ignorados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серии, которые сервер не может преобразовать в это качество, будут пропущены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsnitt som servern inte kan konvertera till den här kvaliteten hoppas över."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunun bu kaliteye dönüştüremediği bölümler atlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Епізоди, які сервер не може конвертувати в цю якість, пропускаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器无法转换为此画质的集将被跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器無法轉換為此畫質的集數將會略過。"
          }
        }
      }
    },
