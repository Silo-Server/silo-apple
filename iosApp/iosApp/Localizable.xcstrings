    },
    "watchParty.banner.unavailable.guest" : {
      "comment" : "Roku: warning banner in the lobby shown to guests when the chosen title is not available to their profile. {host}: the host's display name. Apple (iPhone, iPad, Apple TV): same warning banner in the lobby for guests. Android phone and TV Watch Party lobby: same banner for a guest. 1: the host's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا العنوان غير متاح لملفك الشخصي. سيتعيّن على %1$@ اختيار عنوان آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Titel ist für dein Profil nicht verfügbar. %1$@ muss etwas anderes auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This title isn't available to your profile. %1$@ will need to pick something else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este título no está disponible para tu perfil. %1$@ tendrá que elegir otra cosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce titre n’est pas disponible pour votre profil. %1$@ devra choisir autre chose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタイトルはこのプロフィールでは視聴できません。%1$@さんが別のタイトルを選ぶ必要があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este título não está disponível para seu perfil. %1$@ precisará escolher outro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的个人资料无法观看此影片。%1$@需要另选一部。"
          }
        }
      }
    },
    "watchParty.banner.unavailable.manager" : {
      "comment" : "Roku: warning banner in the lobby shown to the host when the chosen title is not available to this profile. Apple (iPhone, iPad, Apple TV): same warning banner in the lobby for the host. Android phone and TV Watch Party lobby: same banner for the host.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا العنوان غير متاح لملفك الشخصي. اختر عنوانًا آخر ليتمكن الجميع من المشاهدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Titel ist für dein Profil nicht verfügbar. Wähle etwas anderes, damit alle schauen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This title isn't available to your profile. Choose something else so everyone can watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este título no está disponible para tu perfil. Elige otra cosa para que todos puedan verla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce titre n’est pas disponible pour votre profil. Choisissez autre chose pour que tout le monde puisse regarder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタイトルはこのプロフィールでは視聴できません。全員が視聴できるよう、別のタイトルを選んでください。"
          }
        },
        "pt-BR" : {
