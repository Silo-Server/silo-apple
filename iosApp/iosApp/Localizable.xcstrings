          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is al een ander verzoek met dezelfde ID verzonden. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
