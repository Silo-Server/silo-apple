    "tvPair.link.unreachable" : {
      "comment" : "Apple (iPhone, iPad) Sign in a TV from a link: error when the server named in the link doesn't answer. {host}: the server's host name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى %1$@. تحقق من اتصال هذا الجهاز وافتح الرابط مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можа да се осъществи връзка със сървъра %1$@. Проверете връзката на това устройство и отворете линка отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut connectar a %1$@. Comprova la connexió d’aquest dispositiu i torna a obrir l’enllaç."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se spojit se serverem %1$@. Zkontrolujte připojení tohoto zařízení a otevřete odkaz znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke få kontakt til %1$@. Tjek denne enheds forbindelse, og åbn linket igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist nicht erreichbar. Prüfe die Verbindung dieses Geräts und öffne den Link erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η επικοινωνία με τον διακομιστή %1$@. Ελέγξτε τη σύνδεση αυτής της συσκευής και ανοίξτε ξανά τον σύνδεσμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach %1$@. Check this device's connection and open the link again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con %1$@. Revisa la conexión de este dispositivo y vuelve a abrir el enlace."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostiga %1$@ ei õnnestunud ühendust luua. Kontrollige selle seadme ühendust ja avage link uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimeen %1$@ ei saatu yhteyttä. Tarkista tämän laitteen yhteys ja avaa linkki uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre %1$@. Vérifiez la connexion de cet appareil, puis rouvrez le lien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה להתחבר לשרת %1$@. יש לבדוק את החיבור של המכשיר הזה ולפתוח שוב את הקישור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ से कनेक्ट नहीं हो सका। इस डिवाइस का कनेक्शन जाँचें और लिंक फिर से खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće povezati se s poslužiteljem %1$@. Provjerite vezu ovog uređaja i ponovno otvorite poveznicu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült elérni: %1$@. Ellenőrizze ennek az eszköznek a kapcsolatát, és nyissa meg újra a hivatkozást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
