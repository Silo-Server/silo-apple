            "state" : "translated",
            "value" : "%1$@ doit se reconnecter"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: potrebna je ponovna prijava"
          }
        },
        "it" : {
          "stringUnit" : {
