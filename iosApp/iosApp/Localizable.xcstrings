    "downloads.settings.removeOtherProfilesMessage" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; message of the removal alert for data of other profiles on the current server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف التنزيلات المحفوظة لملفات شخصية وحسابات أخرى على هذا الخادم من هذا الجهاز. قد يؤدي التبديل إلى أحد تلك الملفات الشخصية إلى تنزيل عناصره مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads, die für andere Profile und Konten auf diesem Server gespeichert sind, werden von diesem Gerät gelöscht. Wenn du zu einem dieser Profile wechselst, werden dessen Titel möglicherweise erneut heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads saved for other profiles and accounts on this server will be deleted from this device. Switching to one of those profiles may download its items again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las descargas guardadas para otros perfiles y cuentas de este servidor se eliminarán de este dispositivo. Si cambias a uno de esos perfiles, es posible que sus elementos se vuelvan a descargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les téléchargements enregistrés pour d’autres profils et comptes sur ce serveur seront supprimés de cet appareil. Passer à l’un de ces profils peut télécharger à nouveau ses éléments."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーの他のプロフィールとアカウント用に保存されたダウンロードが、このデバイスから削除されます。それらのプロフィールに切り替えると、項目が再度ダウンロードされる場合があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os downloads salvos para outros perfis e contas neste servidor serão excluídos deste dispositivo. Mudar para um desses perfis pode baixar os itens dele novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为此服务器上其他个人资料和账户保存的下载将从此设备删除。切换到其中某个个人资料后，可能会再次下载其内容。"
          }
        }
      }
    },
    "downloads.settings.removeOtherServerMessage" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; message of the removal alert for data of another saved server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف التنزيلات المحفوظة لهذا الخادم من هذا الجهاز. قد يؤدي التبديل إلى هذا الخادم إلى تنزيل عناصره مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads, die für diesen Server gespeichert sind, werden von diesem Gerät gelöscht. Wenn du zu diesem Server wechselst, werden seine Titel möglicherweise erneut heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads saved for this server will be deleted from this device. Switching to this server may download its items again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las descargas guardadas para este servidor se eliminarán de este dispositivo. Si cambias a este servidor, es posible que sus elementos se vuelvan a descargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les téléchargements enregistrés pour ce serveur seront supprimés de cet appareil. Passer à ce serveur peut télécharger à nouveau ses éléments."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバー用に保存されたダウンロードが、このデバイスから削除されます。このサーバーに切り替えると、項目が再度ダウンロードされる場合があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os downloads salvos para este servidor serão excluídos deste dispositivo. Mudar para este servidor pode baixar os itens dele novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为此服务器保存的下载将从此设备删除。切换到此服务器后，可能会再次下载其内容。"
          }
        }
      }
    },
