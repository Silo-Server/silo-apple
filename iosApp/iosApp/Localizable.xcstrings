        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje se posljednje poznato stanje dijagnostike. Izvješća ostaju na ovom uređaju dok je poslužitelj izvan mreže."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A legutóbb ismert diagnosztikai állapot látható. A jelentések ezen az eszközön maradnak, amíg a szerver offline."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan status diagnostik terakhir yang diketahui. Laporan tetap tersimpan di perangkat ini selama server offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene mostrato l’ultimo stato noto della diagnostica. I report restano su questo dispositivo mentre il server è offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後に確認された診断の状態を表示しています。サーバーがオフラインの間、レポートはこのデバイスに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막으로 확인된 진단 상태를 표시하고 있어요. 서버가 오프라인인 동안 보고서는 이 기기에 보관돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
