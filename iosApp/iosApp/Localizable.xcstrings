    "tvPairing.unreachablePublicAppleTv" : {
      "comment" : "Apple TV pairing screen (shown while a nearby phone sets up or signs in this Apple TV): body of the Can't reach screen. {server}: the server's name; {address}: the address the phone sent.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لجهاز Apple TV هذا الوصول إلى %1$@ على %2$@. تحقق من اتصاله بالشبكة وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
