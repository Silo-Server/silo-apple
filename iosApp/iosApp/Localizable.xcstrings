    "diagnostics.notice.offLocalRetry" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: notice after the user turned Crash Reports to Never and some reports on the device couldn't be deleted yet. Crash Reports is the setting's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«تقارير الأعطال» معطّلة. تعذّر حذف بعض التقارير المحلية وستُعاد المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройката „Отчети за сривове“ е изключена. Някои локални отчети не можаха да се изтрият и изтриването ще бъде опитано отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’opció Informes d’error està desactivada. Alguns informes locals no s’han pogut eliminar i es tornarà a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zprávy o pádech jsou vypnuté. Některé místní zprávy se nepodařilo smazat, pokus se bude opakovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedbrudsrapporter er slået fra. Nogle lokale rapporter kunne ikke slettes og forsøges slettet igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Absturzberichte“ ist aus. Einige lokale Berichte konnten nicht gelöscht werden; das Löschen wird erneut versucht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ρύθμιση «Αναφορές κατάρρευσης» είναι ανενεργή. Ορισμένες τοπικές αναφορές δεν ήταν δυνατό να διαγραφούν και θα γίνει νέα προσπάθεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crash Reports is off. Some local reports could not be deleted and will retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informes de fallos está desactivado. No se pudieron eliminar algunos informes locales; se volverá a intentar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seadistus „Kokkujooksmise aruanded“ on väljas. Mõnda kohalikku aruannet ei õnnestunud kustutada; seda proovitakse uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaatumisraportit on pois päältä. Joitakin paikallisia raportteja ei voitu poistaa, ja poistoa yritetään uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Rapports de plantage » est désactivé. Certains rapports locaux n’ont pas pu être supprimés ; la suppression sera retentée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההגדרה ”דוחות קריסה” כבויה. לא ניתן היה למחוק חלק מהדוחות המקומיים, ויתבצע ניסיון נוסף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“क्रैश रिपोर्ट” बंद है। कुछ लोकल रिपोर्टें मिटाई नहीं जा सकीं, इनके लिए फिर से कोशिश की जाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Izvješća o rušenju“ isključena su. Neka lokalna izvješća nije bilo moguće izbrisati pa će se brisanje ponoviti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Összeomlási jelentések beállítás ki van kapcsolva. Néhány helyi jelentést nem sikerült törölni; a Silo újrapróbálja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan crash nonaktif. Beberapa laporan lokal tidak dapat dihapus dan akan dicoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Report arresti anomali” è disattivato. Non è stato possibile eliminare alcuni report locali: verrà effettuato un nuovo tentativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュレポートはオフです。一部のローカルレポートを削除できなかったため、再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충돌 보고서가 꺼져 있어요. 일부 로컬 보고서를 삭제하지 못해 다시 시도할 거예요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nustatymas „Pranešimai apie strigtis“ išjungtas. Kai kurių vietinių pranešimų nepavyko ištrinti – bus bandoma dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iestatījums „Avāriju pārskati” ir izslēgts. Dažus lokālos pārskatus neizdevās izdzēst, un tiks mēģināts vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan ranap dimatikan. Sesetengah laporan setempat tidak dapat dipadam dan akan dicuba semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krasjrapporter er av. Noen lokale rapporter kunne ikke slettes og prøves på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crashrapporten staat uit. Sommige lokale rapporten konden niet worden verwijderd; dit wordt opnieuw geprobeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raporty o awariach wyłączone. Nie udało się usunąć niektórych raportów lokalnych; próba zostanie ponowiona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Relatórios de falhas está desativada. Não foi possível excluir alguns relatórios locais; o Silo tentará novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Relatórios de falhas está desativada. Não foi possível eliminar alguns relatórios locais; vai ser feita uma nova tentativa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opțiunea Rapoarte de blocare este dezactivată. Unele rapoarte locale nu au putut fi șterse; ștergerea va fi reîncercată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Параметр «Отчёты о сбоях» выключен. Некоторые локальные отчёты не удалось удалить; попытка будет повторена."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možnosť Hlásenia o zlyhaní je vypnutá. Niektoré lokálne hlásenia sa nepodarilo odstrániť, odstránenie sa skúsi znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poročila o zrušitvah so izklopljena. Nekaterih lokalnih poročil ni bilo mogoče izbrisati; brisanje se bo ponovilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kraschrapporter är av. Vissa lokala rapporter kunde inte raderas, och ett nytt försök görs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดรายงานข้อขัดข้องแล้ว รายงานบางรายการในอุปกรณ์ยังลบไม่ได้และจะลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitlenme raporları kapalı. Bazı yerel raporlar silinemedi; silme işlemi yeniden denenecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Звіти про збої» вимкнено. Деякі локальні звіти не вдалося видалити – спробу буде повторено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo sự cố đang tắt. Một số báo cáo cục bộ chưa thể xóa và sẽ được thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "崩溃报告已关闭。部分本地报告无法删除，将会重试。"
