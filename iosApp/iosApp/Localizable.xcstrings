    "home.recipe.tasteTop.description" : {
      "comment" : "One-line description of the Top Picks Today preset in the Add row gallery (shared key `home.recipe.tasteTop.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفضل ما يطابق ذوقك الأبرز — حدّد نوعًا لتضييق النتائج."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Най-добрите съвпадения за водещия ви вкус – задайте жанр, за да стесните избора."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les millors coincidències amb el teu gust principal — tria un gènere per concretar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejlepší shody s vaším nejvýraznějším vkusem — pro zúžení nastavte žánr."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedste match til din stærkeste smag — vælg en genre for at indsnævre det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die besten Treffer für deinen ausgeprägtesten Geschmack – lege ein Genre fest, um sie einzugrenzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι καλύτερες αντιστοιχίες για το πιο έντονο γούστο σας – ορίστε ένα είδος για να το περιορίσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Best matches for your strongest taste — set a genre to narrow it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que mejor encaja con tu gusto principal — elige un género para acotarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parimad vasted teie tugevaimale maitsele – kitsendamiseks valige žanr."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parhaat osumat vahvimpaan makuusi — rajaa valitsemalla lajityyppi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les meilleures correspondances avec votre goût dominant — choisissez un genre pour affiner."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההתאמות הטובות ביותר לטעם הבולט שלך – אפשר להגדיר ז׳אנר כדי לצמצם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सबसे खास पसंद से सबसे ज़्यादा मेल खाने वाले टाइटल — दायरा कम करने के लिए कोई शैली चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najbolji pogoci za vaš najizraženiji ukus — postavite žanr da biste suzili izbor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A legerősebb ízlésének legjobban megfelelő címek – a szűkítéshez adjon meg egy műfajt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kecocokan terbaik untuk selera terkuat Anda — atur genre untuk mempersempitnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I titoli più adatti ai tuoi gusti principali — imposta un genere per restringere la scelta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一番の好みに最も合う作品。ジャンルを設定して絞り込めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 뚜렷한 취향에 잘 맞는 작품이에요. 장르를 설정하면 범위를 좁힐 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geriausi atitikmenys pagal ryškiausią jūsų skonį – nurodykite žanrą, kad susiaurintumėte."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Labākās atbilstības jūsu izteiktākajai gaumei – iestatiet žanru, lai sašaurinātu izvēli."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padanan terbaik bagi cita rasa utama anda — tetapkan genre untuk menyempitkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De beste treffene for din sterkeste smak – angi en sjanger for å snevre inn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beste matches voor je sterkste smaak — kies een genre om te verfijnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepsze dopasowania do twojego głównego gustu — ustaw gatunek, aby zawęzić wybór."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As melhores combinações com o seu gosto principal — defina um gênero para refinar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As melhores sugestões para o seu gosto mais marcado — defina um género para restringir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cele mai bune potriviri pentru gustul dvs. dominant — setați un gen pentru a restrânge selecția."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучшие совпадения с вашими главными предпочтениями — укажите жанр, чтобы сузить выбор."
          }
