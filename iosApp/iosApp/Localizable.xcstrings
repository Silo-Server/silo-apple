          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी आइटम को यहाँ जोड़ने के लिए उसके बुकमार्क आइकन पर टैप करें"
          }
        },
        "hr" : {
