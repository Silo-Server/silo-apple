    "library.noLibrariesVisibleBody" : {
      "comment" : "Apple iOS and tvOS: supporting line under the empty-state heading when the profile can see no libraries (the Libraries tab on iOS, a library-type tab on Apple TV).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
