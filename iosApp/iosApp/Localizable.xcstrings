          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget schemalagt den här veckan"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hafta planlanmış bir şey yok"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цього тижня нічого не заплановано"
