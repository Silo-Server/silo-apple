    "remote.error.identityChanged" : {
      "comment" : "Apple iOS: Remote Control error when the phone's server or profile changed while handing playback to the TV.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر الخادم أو الملف الشخصي. حاول التشغيل مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърът или профилът ви се промени. Опитайте да пуснете отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor o el perfil han canviat. Torna a provar de reproduir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změnil se váš server nebo profil. Zkuste přehrávání spustit znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din server eller profil er ændret. Prøv at afspille igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Server oder Profil hat sich geändert. Versuche die Wiedergabe erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής ή το προφίλ σας άλλαξε. Δοκιμάστε ξανά την αναπαραγωγή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server or profile changed. Try playing again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor o perfil cambió. Vuelve a intentar reproducir."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie server või profiil muutus. Proovige uuesti esitada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimesi tai profiilisi vaihtui. Yritä toistaa uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur ou votre profil a changé. Relancez la lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת או הפרופיל שלך השתנו. אפשר לנסות להפעיל שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सर्वर या प्रोफ़ाइल में बदलाव हुआ है। फिर से चलाने की कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj ili profil se promijenio. Pokušajte ponovno pokrenuti reprodukciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megváltozott a szerver vagy a profil. Próbálja újra a lejátszást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server atau profil Anda berubah. Coba putar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server o il profilo è cambiato. Prova di nuovo a riprodurre."
          }
        },
        "ja" : {
          "stringUnit" : {
