      }
    },
    "remote.error.requiresPairing" : {
      "comment" : "Apple iOS: Remote Control error on the remote when a Roku must be paired first. Keep \"Connect a Phone\" as the Roku's menu item is named. 1: the Roku's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب %1$@ الإقران. على جهاز Roku، افتح «توصيل هاتف» في قائمة الملف الشخصي في Silo وامسح رمزه بكاميرا جهاز iPhone هذا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телевизорът %1$@ изисква сдвояване. На Roku отворете „Свързване на телефон“ в менюто на профила в Silo и сканирайте кода му с камерата на този iPhone."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ requereix vinculació. Al Roku, obre Connecta un telèfon al menú de perfil de Silo i escaneja’n el codi amb la càmera d’aquest iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařízení %1$@ vyžaduje spárování. Na zařízení Roku otevřete v nabídce profilu aplikace Silo položku Připojit telefon a naskenujte její kód fotoaparátem tohoto iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kræver parring. Åbn Forbind telefon i Silos profilmenu på Roku’en, og scan koden med denne iPhones kamera."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ muss gekoppelt werden. Öffne auf dem Roku im Profilmenü von Silo „Smartphone verbinden“ und scanne den Code mit der Kamera dieses iPhones."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τηλεόραση %1$@ απαιτεί σύζευξη. Στο Roku, ανοίξτε τη «Σύνδεση τηλεφώνου» στο μενού προφίλ του Silo και σαρώστε τον κωδικό με την κάμερα αυτού του iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ requires pairing. On the Roku, open Connect a Phone in Silo's profile menu and scan its code with this iPhone's camera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ requiere vinculación. En el Roku, abre Conectar un teléfono en el menú de perfil de Silo y escanea su código con la cámara de este iPhone."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teler %1$@ nõuab sidumist. Avage Rokus Silo profiilimenüüs „Ühenda telefon“ ja skannige kuvatud kood selle iPhone’i kaameraga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vaatii laiteparin muodostamisen. Avaa Rokussa Silon profiilivalikosta Yhdistä puhelin ja skannaa sen koodi tämän iPhonen kameralla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nécessite une association. Sur le Roku, ouvrez Connecter un téléphone dans le menu du profil de Silo et scannez son code avec l’appareil photo de cet iPhone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נדרש צימוד עם המכשיר %1$@. ב-Roku, יש לפתוח את ”חיבור טלפון” בתפריט הפרופיל של Silo ולסרוק את הקוד שלו במצלמה של ה-iPhone הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ के लिए पेयरिंग ज़रूरी है। Roku पर Silo के प्रोफ़ाइल मेन्यू में “फ़ोन कनेक्ट करें” खोलें और उसका कोड इस iPhone के कैमरे से स्कैन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uređaj %1$@ zahtijeva uparivanje. Na uređaju Roku u izborniku profila aplikacije Silo otvorite „Poveži telefon“ i skenirajte kod kamerom ovog iPhonea."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Párosítás szükséges: %1$@. A Rokun nyissa meg a Silo profilmenüjében a „Telefon csatlakoztatása” menüpontot, és olvassa be a kódját ennek az iPhone-nak a kamerájával."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ perlu dipasangkan. Di Roku, buka Hubungkan ponsel di menu profil Silo dan pindai kodenya dengan kamera iPhone ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ richiede l’abbinamento. Sul Roku, apri “Collega un telefono” nel menu del profilo di Silo e scansiona il codice con la fotocamera di questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@にはペアリングが必要です。RokuのSiloでプロフィールメニューから「スマートフォンを接続」を開き、このiPhoneのカメラでコードをスキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 기기는 페어링이 필요해요. Roku에서 Silo의 프로필 메뉴에 있는 휴대폰 연결을 열고 이 iPhone의 카메라로 코드를 스캔하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Televizorių „%1$@“ reikia susieti. „Roku“ įrenginyje „Silo“ profilio meniu atidarykite „Prijungti telefoną“ ir nuskaitykite jo kodą šio „iPhone“ kamera."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ierīcei %1$@ nepieciešama savienošana pārī. Roku ierīcē Silo profila izvēlnē atveriet „Savienot tālruni” un skenējiet tā kodu ar šī iPhone kameru."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ memerlukan penggandingan. Pada Roku, buka Sambungkan telefon dalam menu profil Silo dan imbas kodnya dengan kamera iPhone ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ krever sammenkobling. Åpne Koble til telefon i profilmenyen i Silo på Roku-enheten, og skann koden med kameraet på denne iPhonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ moet eerst gekoppeld worden. Open op de Roku Telefoon verbinden in het profielmenu van Silo en scan de code met de camera van deze iPhone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenie %1$@ wymaga sparowania. Na urządzeniu Roku otwórz „Połącz telefon” w menu profilu aplikacji Silo i zeskanuj wyświetlony kod aparatem tego iPhone’a."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ exige pareamento. No Roku, abra Conectar um celular no menu de perfil do Silo e escaneie o código com a câmera deste iPhone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ requer emparelhamento. No Roku, abra Ligar um telemóvel no menu de perfil do Silo e digitalize o código com a câmara deste iPhone."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispozitivul %1$@ necesită asociere. Pe Roku, deschideți Conectați un telefon din meniul profilului din Silo și scanați codul cu camera acestui iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для телевизора «%1$@» требуется привязка. На Roku откройте «Подключить телефон» в меню профиля Silo и отсканируйте код камерой этого iPhone."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Televízor %1$@ vyžaduje spárovanie. Na zariadení Roku otvorte v ponuke profilu v aplikácii Silo položku Pripojiť telefón a naskenujte zobrazený kód fotoaparátom tohto iPhonu."
          }
        },
        "sl" : {
          "stringUnit" : {
