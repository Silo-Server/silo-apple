    "watchParty.strip.guest" : {
      "comment" : "Caption of the suggestions strip for guests, who can suggest but only the host picks: Watch Party on Roku, Android phone and TV, beside the lobby's suggestions on Apple iPhone, iPad and Apple TV, and the web Watch Together lobby.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المضيف يقرر ما يتم تشغيله."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tom, co se přehraje, rozhoduje hostitel."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værten bestemmer, hvad der afspilles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer die Party leitet, entscheidet, was läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host decides what plays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien organiza decide qué se reproduce."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestäjä päättää, mitä toistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’hôte choisit ce qui est lu."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domaćin odlučuje što se reproducira."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi organizza decide cosa riprodurre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生する作品はホストが決めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생할 작품은 호스트가 정해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verten bestemmer hva som spilles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De host bepaalt wat er speelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tym, co leci, decyduje osoba prowadząca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem organiza decide o que será reproduzido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что включить, решает организатор."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värden bestämmer vad som spelas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neyin oynatılacağına ev sahibi karar verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що відтворювати, вирішує організатор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由主持人决定播放内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由主持人決定播放內容。"
          }
        }
      }
    },
    "watchParty.strip.manager" : {
      "comment" : "Caption of the suggestions strip for the host or manager, who can queue a suggestion to play next: Watch Party on Roku, Android phone and TV, beside the lobby's suggestions on Apple iPhone, iPad and Apple TV, and the web Watch Together lobby.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف اقتراحًا إلى قائمة الانتظار ليكون التالي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařaďte návrh do fronty a přehraje se jako další."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt et forslag i kø for at afspille det som det næste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reihe einen Vorschlag ein, damit er als Nächstes läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queue one to put it up next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon una en cola para que sea la siguiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää ehdotus jonoon, niin se toistetaan seuraavaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez-en une à la file d’attente pour la lire ensuite."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte prijedlog u red da bi bio sljedeći."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettine uno in coda per riprodurlo subito dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューに追加すると次に再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제안을 대기열에 추가하면 다음에 재생돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg et forslag i kø for å spille det som neste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet er een in de wachtrij om die hierna af te spelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj propozycję do kolejki, aby była następna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque uma na fila para ser a próxima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте предложение в очередь, чтобы включить его следующим."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köa ett förslag för att spela det härnäst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıradaki yapmak için bir öneriyi sıraya alın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте пропозицію в чергу, щоб відтворити її наступною."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将一项加入队列，即可设为即将播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將建議加入佇列，即可設為下一部播放。"
          }
        }
      }
    },
