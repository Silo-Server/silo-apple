          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichage du dernier état connu des diagnostics. Les rapports restent sur cet appareil tant que le serveur est hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוצג מצב האבחון האחרון הידוע. הדוחות נשמרים במכשיר הזה כל עוד השרת לא מקוון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डायग्नोस्टिक्स की आख़िरी ज्ञात स्थिति दिखाई जा रही है। सर्वर ऑफ़लाइन रहने तक रिपोर्टें इस डिवाइस पर रहती हैं।"
