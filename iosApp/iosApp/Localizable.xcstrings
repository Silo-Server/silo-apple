    "settings.connection.budget" : {
      "comment" : "Help text in connection settings explaining Auto quality plays videos without transcoding up to a speed. {rate}: the speed, such as 12 Mbps. Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: footer under the connection speed row.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل الوضع «تلقائي» مقاطع الفيديو حتى %1$@ دون تحويلها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Качеството „Автоматично“ възпроизвежда видеоклипове до %1$@ без транскодиране."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La qualitat Auto reprodueix vídeos de fins a %1$@ sense convertir-los."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvalita Auto přehrává videa do %1$@ bez převodu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvaliteten Auto afspiller videoer op til %1$@ uden at konvertere dem."
