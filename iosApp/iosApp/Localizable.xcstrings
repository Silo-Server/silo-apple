    "tvPairing.unreachablePublicAppleTv" : {
      "comment" : "Apple TV pairing screen (shown while a nearby phone sets up or signs in this Apple TV): body of the Can't reach screen. {server}: the server's name; {address}: the address the phone sent.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لجهاز Apple TV هذا الوصول إلى %1$@ على %2$@. تحقق من اتصاله بالشبكة وحاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това Apple TV не може да се свърже със сървъра %1$@ на адрес %2$@. Проверете мрежовата му връзка и опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest Apple TV no pot accedir a %1$@ a l’adreça %2$@. Comprova la connexió de xarxa i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto Apple TV se nemůže připojit k serveru %1$@ na adrese %2$@. Zkontrolujte připojení k síti a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette Apple TV kan ikke nå %1$@ på %2$@. Kontrollér netværksforbindelsen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Apple TV kann %1$@ unter %2$@ nicht erreichen. Prüfe die Netzwerkverbindung und versuche es erneut."
