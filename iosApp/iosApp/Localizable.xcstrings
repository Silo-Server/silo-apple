    "settings.playback.rejectedChange" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: message under Not Saved when the server refused a playback change.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يقبل الخادم تغييرًا في إعدادات التشغيل لهذا الجهاز، لذا لم يُحفظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat eine Änderung an den Wiedergabeeinstellungen dieses Geräts nicht angenommen, daher wurde sie nicht gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server didn't accept a change to this device's playback settings, so it wasn't saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no aceptó un cambio en la configuración de reproducción de este dispositivo, así que no se guardó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n’a pas accepté une modification des paramètres de lecture de cet appareil ; elle n’a donc pas été enregistrée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの再生設定の変更がサーバーに受け入れられなかったため、保存されませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor não aceitou uma alteração nas configurações de reprodução deste dispositivo, então ela não foi salva."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器未接受对此设备播放设置的更改，因此未保存。"
          }
        }
      }
    },
