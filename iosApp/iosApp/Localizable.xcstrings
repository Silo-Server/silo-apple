    "downloads.settings.cleanupFooter" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; footer under Keep watched downloads on iPhone and iPad.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تعطيل هذا الخيار، يقترح تبويب «التنزيلات» تحرير المساحة بإزالة العناصر التي أنهيت مشاهدتها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je tato možnost vypnutá, karta Stahování navrhne uvolnit místo odebráním zhlédnutých položek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når den er slået fra, foreslår fanen Downloads, at du frigør plads ved at fjerne det, du er færdig med at se."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Option aus ist, schlägt der Tab „Downloads“ vor, Speicherplatz freizugeben, indem Titel entfernt werden, die du fertig angesehen hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, the Downloads tab suggests freeing up space by removing items you've finished watching."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, la pestaña Descargas sugiere liberar espacio quitando lo que ya terminaste de ver."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun asetus on pois, Lataukset-välilehti ehdottaa tilan vapauttamista poistamalla kohteet, jotka olet katsonut loppuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est désactivée, l’onglet Téléchargements suggère de libérer de l’espace en retirant les éléments que vous avez fini de regarder."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada je isključeno, kartica Preuzimanja predlaže oslobađanje prostora uklanjanjem stavki koje ste završili gledati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando l’opzione è disattivata, la scheda Download suggerisce di liberare spazio rimuovendo gli elementi che hai finito di guardare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、ダウンロードタブで視聴済みの項目を削除して空き容量を増やすよう提案されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 다운로드 탭에서 시청을 마친 항목을 제거해 공간을 확보하도록 제안해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er av, foreslår fanen Nedlastinger å frigjøre plass ved å fjerne elementer du er ferdig med å se."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit uit staat, stelt het tabblad Downloads voor om ruimte vrij te maken door items te verwijderen die je hebt uitgekeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest wyłączona, karta Pobrane proponuje zwolnienie miejsca przez usunięcie obejrzanych pozycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando desativado, a aba Downloads sugere liberar espaço removendo os itens que você terminou de assistir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выключено, на вкладке «Загрузки» будет предлагаться освободить место, удалив то, что вы уже досмотрели."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är av föreslår fliken Nedladdningar att du frigör utrymme genom att ta bort det du har tittat klart på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalıyken İndirmeler sekmesi, izlemeyi bitirdiğiniz öğeleri kaldırarak yer açmayı önerir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо вимкнено, вкладка «Завантаження» пропонуватиме звільнити місце, видаливши те, що ви вже переглянули."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，下载标签页会建议你移除已看完的内容以释放空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉時，下載項目分頁會建議你移除已看完的項目以釋放空間。"
          }
        }
      }
    },
