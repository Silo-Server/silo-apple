            "state" : "translated",
            "value" : "Synkronointi epäonnistui. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la synchronisation. Réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronizacija nije uspjela. Pokušajte ponovno."
          }
