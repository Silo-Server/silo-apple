    "home.recipe.shortWatchesDefault.description" : {
      "comment" : "One-line description of the Short & Sweet preset in the Add row gallery (shared key `home.recipe.shortWatchesDefault.description`, sent as description_short_key). Shown under or beside the preset's name.",
