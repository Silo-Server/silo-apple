          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie z tego urządzenia zapisanego połączenia i danych logowania do tego serwera. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove deste dispositivo a conexão salva e as credenciais de login deste servidor. Não é possível desfazer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação remove deste dispositivo a ligação guardada e as credenciais de início de sessão deste servidor. Não é possível anular esta ação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiunea salvată și datele de conectare pentru acest server vor fi eliminate de pe acest dispozitiv. Această acțiune nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённое подключение и данные для входа на этот сервер будут удалены с этого устройства. Это действие нельзя отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týmto sa z tohto zariadenia odstránia uložené pripojenie a prihlasovacie údaje pre tento server. Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem boste iz te naprave odstranili shranjeno povezavo in poverilnice za prijavo za ta strežnik. Tega ni mogoče razveljaviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här tar bort den sparade anslutningen och inloggningsuppgifterna för den här servern från den här enheten. Det går inte att ångra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะลบการเชื่อมต่อและข้อมูลการลงชื่อเข้าใช้ที่บันทึกไว้ของเซิร์ฟเวอร์นี้ออกจากอุปกรณ์นี้ และเลิกทำไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, bu sunucu için kaydedilmiş bağlantıyı ve oturum açma bilgilerini bu cihazdan kaldırır. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережене з’єднання й облікові дані для входу на цей сервер буде видалено з цього пристрою. Цю дію не можна скасувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa kết nối và thông tin đăng nhập đã lưu cho máy chủ này khỏi thiết bị này. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从此设备中移除此服务器的已保存连接和登录凭据。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會從此裝置移除此伺服器的已儲存連線和登入憑證。此動作無法復原。"
          }
        }
      }
    },
