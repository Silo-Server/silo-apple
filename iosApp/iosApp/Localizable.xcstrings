    "watchParty.ended.expired" : {
      "comment" : "Roku: message shown when the party connection expired or the party is gone. Apple (iPhone, iPad, Apple TV): same message on the Watch Party hub.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية الاتصال بـ Watch Party أو لم تعد متاحة. انضم مرة أخرى للمتابعة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojení k Watch Party vypršelo nebo už není k dispozici. Chcete-li pokračovat, připojte se znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen til festen er udløbet eller ikke længere tilgængelig. Deltag igen for at fortsætte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zur Watch Party ist abgelaufen oder nicht mehr verfügbar. Tritt erneut bei, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The party connection expired or is no longer available. Join again to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión con la Watch Party caducó o ya no está disponible. Vuelve a unirte para continuar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Party -yhteys vanheni tai ei ole enää käytettävissä. Jatka liittymällä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à la Watch Party a expiré ou n’est plus disponible. Rejoignez-la à nouveau pour continuer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza s partyjem je istekla ili više nije dostupna. Ponovno se pridružite da biste nastavili."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione al party è scaduta o non è più disponibile. Partecipa di nuovo per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Partyへの接続の有効期限が切れたか、利用できなくなりました。続けるには、もう一度参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Party 연결이 만료됐거나 더 이상 사용할 수 없어요. 계속하려면 다시 참여하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilkoblingen til Watch Party er utløpt eller ikke lenger tilgjengelig. Bli med på nytt for å fortsette."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding met de party is verlopen of niet meer beschikbaar. Neem opnieuw deel om verder te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenie z Watch Party wygasło lub nie jest już dostępne. Dołącz ponownie, aby kontynuować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão com a Watch Party expirou ou não está mais disponível. Entre novamente para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключение к Watch Party истекло или больше недоступно. Присоединитесь снова, чтобы продолжить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslutningen till Watch Partyn har gått ut eller är inte längre tillgänglig. Gå med igen för att fortsätta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parti bağlantısının süresi doldu veya parti artık kullanılamıyor. Devam etmek için tekrar katılın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Термін з’єднання з Watch Party минув, або вона більше недоступна. Приєднайтеся ще раз, щоб продовжити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Party连接已过期或不再可用。请重新加入以继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Party 連線已過期或無法再使用。請重新加入以繼續。"
          }
        }
      }
    },
    "watchParty.ended.replaced" : {
      "comment" : "Roku: message shown on this device when the same profile joined the party elsewhere, taking over. Apple (iPhone, iPad, Apple TV): same message on the Watch Party hub.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انضم هذا الملف الشخصي إلى Watch Party على جهاز آخر. انضم مجددًا هنا لتولي التشغيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento profil se připojil k Watch Party na jiném zařízení. Chcete-li převzít přehrávání, připojte se znovu zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne profil deltager nu i festen på en anden enhed. Deltag igen her for at overtage afspilningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Profil ist der Watch Party auf einem anderen Gerät beigetreten. Tritt hier erneut bei, um die Wiedergabe zu übernehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This profile joined the party on another device. Rejoin here to take over playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil se unió a la Watch Party en otro dispositivo. Vuelve a unirte aquí para retomar la reproducción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä profiili liittyi Watch Partyyn toisella laitteella. Siirrä toisto tähän laitteeseen liittymällä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil a rejoint la Watch Party sur un autre appareil. Rejoignez-la ici pour reprendre la lecture."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj se profil pridružio partyju na drugom uređaju. Ponovno se pridružite ovdje da biste preuzeli reprodukciju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo profilo è entrato nel party da un altro dispositivo. Rientra da qui per riprendere la riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールが別のデバイスでWatch Partyに参加しました。このデバイスで再生を引き継ぐには、ここで再参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필이 다른 기기에서 Watch Party에 참여했어요. 여기서 재생하려면 다시 참여하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne profilen ble med i Watch Party på en annen enhet. Bli med igjen her for å ta over avspillingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit profiel neemt op een ander apparaat deel aan de party. Neem hier opnieuw deel om het afspelen over te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten profil dołączył do Watch Party na innym urządzeniu. Dołącz ponownie tutaj, aby przejąć odtwarzanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil entrou na Watch Party em outro dispositivo. Entre novamente aqui para assumir a reprodução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот профиль подключился к Watch Party на другом устройстве. Подключитесь снова здесь, чтобы продолжить просмотр на этом устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här profilen gick med i Watch Partyn på en annan enhet. Gå med igen här för att ta över uppspelningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu profil partiye başka bir cihazda katıldı. Oynatmayı devralmak için buradan yeniden katılın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей профіль приєднався до Watch Party на іншому пристрої. Приєднайтеся знову тут, щоб перейняти відтворення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此个人资料已在另一台设备上加入Watch Party。在此重新加入即可接管播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個個人檔案已在其他裝置上加入 Watch Party。在這裡重新加入即可接手播放。"
          }
        }
      }
    },
