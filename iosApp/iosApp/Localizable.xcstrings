    "settingsManifest.playback.show_marker_confidence.description" : {
      "comment" : "Help text under the playback.show_marker_confidence setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض مدى ثقة المصدر فوق زر «تخطي المقدمة». يقيّم كل مصدر وفق مقياسه الخاص، لذا لا تصلح النسبة المئوية للمقارنة إلا ضمن مصدر واحد؛ فعّل سطر المصدر لمعرفة المصدر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показва над бутона „Прескачане на въведението“ колко сигурен е източникът. Всеки източник оценява по своя скала, затова процентът е сравним само в рамките на един източник; включете реда с източника, за да видите кой е той."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la confiança de la font a sobre del botó Omet la introducció. Cada font puntua amb la seva pròpia escala, de manera que el percentatge només es pot comparar dins d’una mateixa font; activa la línia de la font per veure quina és."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nad tlačítkem Přeskočit úvod zobrazí, jak si je zdroj jistý. Každý zdroj hodnotí na vlastní stupnici, takže procenta lze porovnávat jen v rámci jednoho zdroje; zapněte řádek se zdrojem a uvidíte, o který jde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis over knappen Spring intro over, hvor sikker kilden er. Hver kilde bruger sin egen skala, så procentdelen kan kun sammenlignes inden for samme kilde. Slå kildelinjen til for at se, hvilken kilde det er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt über der Schaltfläche „Intro überspringen“ an, wie sicher sich die Quelle ist. Jede Quelle bewertet auf ihrer eigenen Skala, daher ist der Prozentwert nur innerhalb einer Quelle vergleichbar; schalte die Zeile zur Quelle ein, um zu sehen, welche es ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση της βεβαιότητας της πηγής πάνω από το κουμπί «Παράλειψη εισαγωγής». Κάθε πηγή βαθμολογεί με τη δική της κλίμακα, οπότε το ποσοστό είναι συγκρίσιμο μόνο μέσα στην ίδια πηγή. Ενεργοποιήστε τη γραμμή πηγής για να δείτε ποια είναι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show how confident the source is above the Skip Intro button. Each source rates on its own scale, so the percentage is only comparable within one source; turn the source line on to see which one it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra sobre el botón Omitir introducción qué tan segura está la fuente. Cada fuente usa su propia escala, así que el porcentaje solo es comparable dentro de una misma fuente; activa la línea de la fuente para ver cuál es."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näitab nupu „Jäta intro vahele“ kohal, kui kindel allikas on. Iga allikas hindab oma skaalal, seega on protsent võrreldav ainult ühe allika piires; lülitage sisse allika rida, et näha, milline allikas see on."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä Ohita alkutunnus -painikkeen yläpuolella, kuinka varma lähde on. Jokainen lähde arvioi omalla asteikollaan, joten prosentteja voi verrata vain saman lähteen sisällä. Ota lähderivi käyttöön nähdäksesi, mikä lähde on kyseessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche au-dessus du bouton « Passer l’intro » le degré de confiance de la source. Chaque source note selon sa propre échelle : le pourcentage n’est donc comparable qu’au sein d’une même source ; activez la ligne de source pour savoir de laquelle il s’agit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת רמת הוודאות של המקור מעל הכפתור ”דילוג על הפתיח”. כל מקור מדרג בסולם משלו, ולכן אפשר להשוות את האחוזים רק בתוך אותו מקור; אפשר להפעיל את שורת המקור כדי לראות באיזה מקור מדובר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“इंट्रो छोड़ें” बटन के ऊपर दिखाएँ कि सोर्स कितना आश्वस्त है। हर सोर्स अपने पैमाने पर रेटिंग देता है, इसलिए प्रतिशत की तुलना सिर्फ़ एक ही सोर्स के अंदर की जा सकती है; कौन-सा सोर्स है, यह देखने के लिए सोर्स वाली पंक्ति चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iznad gumba Preskoči uvod prikazuje koliko je izvor siguran. Svaki izvor ocjenjuje na vlastitoj ljestvici pa je postotak usporediv samo unutar jednog izvora; uključite redak s izvorom da biste vidjeli o kojem je riječ."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A forrás megbízhatóságának megjelenítése a Bevezető átugrása gomb felett. Minden forrás a saját skáláján értékel, így a százalék csak egy forráson belül hasonlítható össze; kapcsolja be a forrás sorát, hogy lássa, melyikről van szó."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan tingkat keyakinan sumber di atas tombol Lewati intro. Setiap sumber menilai dengan skalanya sendiri, jadi persentasenya hanya dapat dibandingkan dalam satu sumber; aktifkan baris sumber untuk melihat sumber mana itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra sopra il pulsante Salta intro quanto è affidabile la sorgente. Ogni sorgente usa una propria scala, quindi la percentuale è confrontabile solo all’interno della stessa sorgente; attiva la riga della sorgente per vedere quale è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「イントロをスキップ」ボタンの上にソースの信頼度を表示します。ソースごとに独自の基準で評価するため、割合は同じソース内でのみ比較できます。どのソースかを確認するには、ソースの表示をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인트로 건너뛰기 버튼 위에 소스의 신뢰도를 표시해요. 소스마다 자체 기준으로 평가하므로 백분율은 같은 소스 안에서만 비교할 수 있어요. 어떤 소스인지 보려면 소스 표시를 켜세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virš mygtuko „Praleisti įžangą“ rodyti, kiek šaltinis tikras. Kiekvienas šaltinis vertina savo skalėje, todėl procentus galima lyginti tik to paties šaltinio ribose; įjunkite šaltinio eilutę, kad matytumėte, kuris tai šaltinis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virs pogas „Izlaist ievadu” rāda, cik pārliecināts ir avots. Katrs avots vērtē savā skalā, tāpēc procentus var salīdzināt tikai viena avota ietvaros; ieslēdziet avota rindu, lai redzētu, kurš tas ir."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan tahap keyakinan sumber di atas butang Langkau intro. Setiap sumber menilai mengikut skalanya sendiri, jadi peratusan itu hanya boleh dibandingkan dalam satu sumber; hidupkan baris sumber untuk melihat sumber yang mana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis hvor sikker kilden er, over knappen «Hopp over intro». Hver kilde bruker sin egen skala, så prosenten kan bare sammenlignes innenfor én kilde. Slå på kildelinjen for å se hvilken kilde det er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon boven de knop Intro overslaan hoe zeker de bron is. Elke bron gebruikt een eigen schaal, dus het percentage is alleen binnen één bron vergelijkbaar; zet de bronregel aan om te zien welke het is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj nad przyciskiem Pomiń czołówkę, jak pewne jest źródło. Każde źródło ocenia w swojej skali, więc procenty można porównywać tylko w obrębie jednego źródła; włącz wiersz źródła, aby zobaczyć, które to jest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra acima do botão Pular abertura o grau de confiança da fonte. Cada fonte avalia na própria escala, então a porcentagem só é comparável dentro de uma mesma fonte; ative a linha da fonte para ver qual é."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar o grau de confiança da fonte por cima do botão Saltar introdução. Cada fonte usa a sua própria escala, por isso a percentagem só é comparável dentro da mesma fonte; ative a linha da fonte para ver qual é."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează deasupra butonului Omiteți introducerea cât de sigură este sursa. Fiecare sursă evaluează pe propria scară, deci procentul poate fi comparat doar în cadrul aceleiași surse; activați rândul sursei pentru a vedea care este."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать над кнопкой «Пропустить вступление», насколько уверен источник. У каждого источника своя шкала, поэтому проценты сравнимы только в пределах одного источника; включите строку источника, чтобы увидеть, какой это источник."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nad tlačidlom Preskočiť úvod zobrazí, nakoľko si je zdroj istý. Každý zdroj hodnotí na vlastnej stupnici, takže percentá sa dajú porovnávať iba v rámci jedného zdroja; ak chcete vidieť, o ktorý zdroj ide, zapnite riadok so zdrojom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nad gumbom „Preskoči uvod“ prikaži, kako zanesljiv je vir. Vsak vir ocenjuje po svoji lestvici, zato je odstotek primerljiv le znotraj enega vira; vklopite vrstico z virom, da vidite, za kateri vir gre."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa hur säker källan är ovanför knappen ”Hoppa över intro”. Varje källa använder sin egen skala, så procentsatsen kan bara jämföras inom samma källa. Slå på Visa markörkälla för att se vilken källa det är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงระดับความมั่นใจของแหล่งที่มาเหนือปุ่ม “ข้ามอินโทร” แต่ละแหล่งที่มาให้คะแนนด้วยมาตรวัดของตัวเอง เปอร์เซ็นต์จึงเปรียบเทียบกันได้ภายในแหล่งที่มาเดียวกันเท่านั้น เปิดบรรทัดแหล่งที่มาเพื่อดูว่าเป็นแหล่งใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girişi Atla düğmesinin üzerinde kaynağın ne kadar emin olduğunu gösterir. Her kaynak kendi ölçeğini kullanır, bu yüzden yüzde yalnızca aynı kaynak içinde karşılaştırılabilir; hangi kaynak olduğunu görmek için kaynak satırını açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати над кнопкою «Пропустити заставку», наскільки впевнене джерело. Кожне джерело має власну шкалу, тому відсотки можна порівнювати лише в межах одного джерела; увімкніть рядок джерела, щоб бачити, яке це джерело."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị mức độ tin cậy của nguồn phía trên nút Bỏ qua đoạn mở đầu. Mỗi nguồn đánh giá theo thang riêng, nên tỷ lệ phần trăm chỉ so sánh được trong cùng một nguồn; bật dòng nguồn để biết đó là nguồn nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“跳过片头”按钮上方显示来源的置信度。每个来源使用各自的评分标准，因此百分比只能在同一来源内比较；开启来源显示即可查看是哪个来源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「略過片頭」按鈕上方顯示來源的信賴度。每個來源的評分標準不同，因此百分比只能在同一來源內比較；開啟來源資訊即可查看是哪個來源。"
          }
        }
      }
    },
