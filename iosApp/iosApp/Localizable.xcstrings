    "diagnostics.turnOff.hostedMessage" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) > Crash Reports: message of the Never confirmation when reports go to Silo Diagnostics (a product name).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف التقارير المحلية المعلّقة. وستُضاف التقارير التي استلمها Silo Diagnostics بالفعل إلى قائمة انتظار الحذف أيضًا. سيستمر السجل الأساسي في الذاكرة في العمل، ولا يُرسل أبدًا دون إجراء صريح منك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausstehende lokale Berichte werden gelöscht. Berichte, die Silo Diagnostics bereits erhalten hat, werden ebenfalls zum Löschen vorgemerkt. Das einfache Protokoll im Arbeitsspeicher läuft weiter und wird nie ohne ausdrückliche Aktion gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pending local reports will be deleted. Reports already received by Silo Diagnostics will also be queued for deletion. The in-memory basic log will continue running and is never sent without an explicit action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán los informes locales pendientes. Los informes que Silo Diagnostics ya recibió también se pondrán en cola para eliminarse. El registro básico en memoria seguirá activo y nunca se envía sin una acción explícita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rapports locaux en attente seront supprimés. Les rapports déjà reçus par Silo Diagnostics seront également placés en file d’attente pour suppression. Le journal de base en mémoire continuera de fonctionner et n’est jamais envoyé sans action explicite de votre part."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信待ちのローカルレポートは削除されます。Silo Diagnosticsが受信済みのレポートも削除キューに追加されます。メモリ内の基本ログは引き続き記録されますが、明示的に操作しない限り送信されることはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os relatórios locais pendentes serão excluídos. Os relatórios já recebidos pelo Silo Diagnostics também entrarão na fila de exclusão. O log básico em memória continuará em execução e nunca será enviado sem uma ação explícita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地待发送的报告将被删除。Silo Diagnostics已收到的报告也将加入删除队列。内存中的基本日志会继续运行，未经你明确操作绝不会发送。"
          }
        }
      }
    },
    "diagnostics.turnOff.hostedMessageTv" : {
      "comment" : "Apple TV Settings > Diagnostics > Crash Reports: message of the Never confirmation when reports go to Silo Diagnostics (a product name).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف التقارير المحلية المعلّقة. وستُضاف التقارير التي استلمها Silo Diagnostics بالفعل إلى قائمة انتظار الحذف أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausstehende lokale Berichte werden gelöscht. Berichte, die Silo Diagnostics bereits erhalten hat, werden ebenfalls zum Löschen vorgemerkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pending local reports will be deleted. Reports already received by Silo Diagnostics will also be queued for deletion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán los informes locales pendientes. Los informes que Silo Diagnostics ya recibió también se pondrán en cola para eliminarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rapports locaux en attente seront supprimés. Les rapports déjà reçus par Silo Diagnostics seront également placés en file d’attente pour suppression."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信待ちのローカルレポートは削除されます。Silo Diagnosticsが受信済みのレポートも削除キューに追加されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os relatórios locais pendentes serão excluídos. Os relatórios já recebidos pelo Silo Diagnostics também entrarão na fila de exclusão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地待发送的报告将被删除。Silo Diagnostics已收到的报告也将加入删除队列。"
          }
        }
      }
    },
    "diagnostics.turnOff.selfHostedMessage" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) > Crash Reports: message of the Never confirmation when reports go to the user's own server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف التقارير المعلّقة الخاصة بحساب الخادم هذا. سيستمر السجل الأساسي في الذاكرة في العمل، ولا يُرسل أبدًا دون إجراء صريح منك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausstehende Berichte für dieses Serverkonto werden gelöscht. Das einfache Protokoll im Arbeitsspeicher läuft weiter und wird nie ohne ausdrückliche Aktion gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pending reports for this server account will be deleted. The in-memory basic log will continue running and is never sent without an explicit action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán los informes pendientes de esta cuenta del servidor. El registro básico en memoria seguirá activo y nunca se envía sin una acción explícita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rapports en attente pour ce compte de serveur seront supprimés. Le journal de base en mémoire continuera de fonctionner et n’est jamais envoyé sans action explicite de votre part."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーアカウントの送信待ちのレポートは削除されます。メモリ内の基本ログは引き続き記録されますが、明示的に操作しない限り送信されることはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os relatórios pendentes desta conta do servidor serão excluídos. O log básico em memória continuará em execução e nunca será enviado sem uma ação explícita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器账户的待发送报告将被删除。内存中的基本日志会继续运行，未经你明确操作绝不会发送。"
          }
        }
      }
    },
