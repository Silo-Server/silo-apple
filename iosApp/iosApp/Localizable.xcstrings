    "collections.group.emptyHint" : {
      "comment" : "Apple iOS: row shown in an empty collection group on the Collections screen; Move is the swipe action on a collection.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم «نقل» على مجموعة لإضافتها إلى هذه الفئة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
