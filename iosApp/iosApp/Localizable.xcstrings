    "home.recipe.continueListeningDefault.description" : {
      "comment" : "One-line description of the Continue Listening preset in the Add row gallery (shared key `home.recipe.continueListeningDefault.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع الكتب الصوتية من حيث توقفت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokračujte v poslechu audioknih od místa přerušení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsæt med lydbøger, hvor du slap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze Hörbücher dort fort, wo du aufgehört hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick up audiobooks where you left off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retoma los audiolibros donde los dejaste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatka äänikirjoja siitä, mihin jäit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprenez vos livres audio là où vous les avez laissés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavite slušati audioknjige ondje gdje ste stali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprendi gli audiolibri da dove li hai lasciati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "途中まで聴いたオーディオブックを続きから再開。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중단한 곳부터 오디오북 이어 듣기."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsett med lydbøker der du slapp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga verder met luisterboeken waar je gebleven was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słuchaj audiobooków od miejsca przerwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retome audiolivros de onde parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжите слушать аудиокниги с того места, где остановились."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsätt lyssna på ljudböcker där du slutade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli kitaplara kaldığınız yerden devam edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продовжуйте слухати аудіокниги з місця, де зупинилися."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从上次停下的地方继续收听有声书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從上次停下的地方繼續聆聽有聲書。"
          }
        }
      }
    },
    "home.recipe.continueWatchingDefault.description" : {
      "comment" : "One-line description of the Continue Watching preset in the Add row gallery (shared key `home.recipe.continueWatchingDefault.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع الأفلام والحلقات من حيث توقفت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokračujte ve sledování filmů a dílů od místa přerušení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsæt med film og afsnit, hvor du slap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze Filme und Folgen dort fort, wo du aufgehört hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick up movies and episodes where you left off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retoma las películas y los episodios donde los dejaste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatka elokuvia ja jaksoja siitä, mihin jäit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprenez films et épisodes là où vous les avez laissés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavite gledati filmove i epizode ondje gdje ste stali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprendi film ed episodi da dove li hai lasciati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "途中まで視聴した映画やエピソードを続きから再開。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중단한 곳부터 영화와 에피소드 이어 보기."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
