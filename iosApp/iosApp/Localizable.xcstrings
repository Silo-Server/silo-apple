          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการรับตอนใหม่โดยอัตโนมัติ ให้เปิดซีรีส์ แตะ “ดาวน์โหลด” แล้วเลือก “ติดตาม”"
