    "settingsManifest.downloads.keep_watched.description" : {
      "comment" : "Help text under the downloads.keep_watched setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدم اقتراح استعادة المساحة من التنزيلات التي أنهيت مشاهدتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt nicht vor, Speicherplatz von fertig geschauten Downloads freizugeben."
