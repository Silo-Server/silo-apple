    "pairing.error.stoppedKept" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: error that ended the session after some accounts had already signed in. {message}: the reason, a full sentence.",
      "extractionState" : "manual",
      "localizations" : {
