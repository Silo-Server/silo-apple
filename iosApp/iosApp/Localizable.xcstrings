    "settings.interface.applyToAllDevicesSubtitle" : {
      "comment" : "Apple Settings > Interface > Title Pages and Apple TV Settings > General: description of the Apply to All Devices switch (VoiceOver hint on iPhone, iPad and Apple TV; shown under the switch on Mac).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم هذا الاختيار في كل مكان على هذا الملف الشخصي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použít tuto volbu všude v tomto profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug dette valg overalt på denne profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Auswahl überall in diesem Profil verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this choice everywhere on this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa esta opción en todas partes en este perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä tätä valintaa kaikkialla tässä profiilissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise ce choix partout sur ce profil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi ovaj odabir posvuda na ovom profilu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa questa scelta ovunque in questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールのすべてのデバイスでこの選択を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필의 모든 기기에서 이 선택을 사용해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk dette valget overalt på denne profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik deze keuze overal binnen dit profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa tego wyboru wszędzie w tym profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar esta escolha em todos os lugares neste perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать этот выбор везде в этом профиле."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd det här valet överallt på den här profilen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seçim, bu profilde her yerde kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовувати цей вибір усюди в цьому профілі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此个人资料的所有设备上使用此选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此個人檔案的所有裝置上使用這個選擇。"
          }
        }
      }
    },
    "settings.interface.applyToAllFooterAppleTv" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac) > Title Pages on Apple TV: footer while Apply to All Devices is on. Apple TV is the product name; keep it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عطّل «تطبيق على جميع الأجهزة» للاختيار لهذا Apple TV فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li volbu nastavit jen pro toto zařízení Apple TV, vypněte možnost Použít na všech zařízeních."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå Anvend på alle enheder fra for kun at vælge for dette Apple TV."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiviere „Auf alle Geräte anwenden“, um nur für dieses Apple TV zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off Apply to All Devices to choose for this Apple TV only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva Aplicar a todos los dispositivos para elegir solo para este Apple TV."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista ”Kaikille laitteille” käytöstä, jos haluat valita vain tälle Apple TV:lle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez Appliquer à tous les appareils pour choisir uniquement pour cette Apple TV."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isključite Primijeni na sve uređaje da biste odabrali samo za ovaj Apple TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva “Applica a tutti i dispositivi” per scegliere solo per questa Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVだけで選ぶには、「すべてのデバイスに適用」をオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple TV에만 적용하려면 모든 기기에 적용을 끄세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå av Bruk på alle enheter for å velge bare for denne Apple TV-en."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet “Op alle apparaten toepassen” uit om alleen voor deze Apple TV te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz opcję „Zastosuj na wszystkich urządzeniach”, aby wybrać tylko dla tego Apple TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative “Aplicar a todos os dispositivos” para escolher só para esta Apple TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы выбрать только для этого Apple TV, выключите «Применить ко всем устройствам»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng av Tillämpa på alla enheter om du vill välja bara för denna Apple TV."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu Apple TV için seçmek üzere “Tüm cihazlara uygula” seçeneğini kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкніть «Застосувати до всіх пристроїв», щоб вибрати лише для цього Apple TV."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭“应用到所有设备”即可仅为这台Apple TV单独选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉「套用至所有裝置」即可只為這台 Apple TV 設定。"
          }
        }
      }
    },
