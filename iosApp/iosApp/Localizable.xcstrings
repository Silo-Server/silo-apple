          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conservó el informe; es posible que el servidor ya lo tenga, así que no se volverá a enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
