    "diagnostics.prompt.crashedHosted" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad, Apple TV), shown after a problem report is captured: message when one report is waiting. Reports go to Silo Diagnostics, the Silo project's hosted service; Silo Diagnostics is a product name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعطّل Silo مؤخرًا. يمكن أن يساعد إرسال تقرير تشخيص فريق Silo Diagnostics على فهم ما حدث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo ist kürzlich abgestürzt. Ein Diagnosebericht kann dem Silo Diagnostics-Team helfen zu verstehen, was passiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo crashed recently. Sending a diagnostics report can help the Silo Diagnostics team understand what happened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo falló recientemente. Enviar un informe de diagnóstico puede ayudar al equipo de Silo Diagnostics a entender qué pasó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo a planté récemment. L’envoi d’un rapport de diagnostic peut aider l’équipe Silo Diagnostics à comprendre ce qui s’est passé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloが最近クラッシュしました。診断レポートを送信すると、Silo Diagnosticsチームが原因を把握するのに役立ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Silo falhou recentemente. Enviar um relatório de diagnóstico pode ajudar a equipe do Silo Diagnostics a entender o que aconteceu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo最近发生了崩溃。发送诊断报告可以帮助Silo Diagnostics团队了解发生了什么。"
          }
        }
      }
    },
