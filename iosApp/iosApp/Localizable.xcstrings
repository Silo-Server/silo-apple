    "downloads.monitorList.entryEmpty" : {
      "comment" : "Apple iOS/macOS: Monitored screen (series this device downloads automatically), opened from the Downloads tab; subtitle of the Monitored row on the Downloads tab when no series is monitored yet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل على الحلقات الجديدة تلقائيًا"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Folgen automatisch erhalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep new episodes coming automatically"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe episodios nuevos automáticamente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez automatiquement les nouveaux épisodes"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいエピソードを自動で受け取る"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba novos episódios automaticamente"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动获取新集"
          }
        }
      }
    },
    "downloads.monitorList.footer" : {
      "comment" : "Apple iOS/macOS: Monitored screen (series this device downloads automatically), opened from the Downloads tab; note under the list when downloads may use cellular data.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنزَّل الحلقات الجديدة بعد عرضها. لإضافة مسلسل، اضغط على «تنزيل» فيه واختر «مراقبة»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Folgen werden nach der Ausstrahlung heruntergeladen. Um eine Serie hinzuzufügen, tippe darin auf „Download“ und wähle „Beobachten“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New episodes download after they air. To add a series, tap Download on it and choose Monitor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios nuevos se descargan después de emitirse. Para añadir una serie, toca Descargar en ella y elige Supervisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux épisodes se téléchargent après leur diffusion. Pour ajouter une série, touchez Télécharger sur sa page et choisissez Surveiller."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいエピソードは放送後にダウンロードされます。シリーズを追加するには、シリーズの「ダウンロード」をタップして「監視」を選択してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos episódios são baixados depois de irem ao ar. Para adicionar uma série, toque em Baixar nela e escolha Monitorar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新集播出后会自动下载。要添加剧集，请在剧集上轻点“下载”，然后选择“监控”。"
          }
        }
      }
    },
    "downloads.monitorList.footerWifi" : {
      "comment" : "Apple iOS/macOS: Monitored screen (series this device downloads automatically), opened from the Downloads tab; note under the list when downloads are Wi-Fi only.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنزَّل الحلقات الجديدة بعد عرضها عبر Wi-Fi. لإضافة مسلسل، اضغط على «تنزيل» فيه واختر «مراقبة»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Folgen werden nach der Ausstrahlung über Wi-Fi heruntergeladen. Um eine Serie hinzuzufügen, tippe darin auf „Download“ und wähle „Beobachten“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New episodes download after they air, over Wi-Fi. To add a series, tap Download on it and choose Monitor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios nuevos se descargan por Wi-Fi después de emitirse. Para añadir una serie, toca Descargar en ella y elige Supervisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux épisodes se téléchargent en Wi-Fi après leur diffusion. Pour ajouter une série, touchez Télécharger sur sa page et choisissez Surveiller."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいエピソードは放送後にWi-Fi経由でダウンロードされます。シリーズを追加するには、シリーズの「ダウンロード」をタップして「監視」を選択してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos episódios são baixados por Wi-Fi depois de irem ao ar. Para adicionar uma série, toque em Baixar nela e escolha Monitorar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新集播出后会通过Wi-Fi自动下载。要添加剧集，请在剧集上轻点“下载”，然后选择“监控”。"
          }
        }
      }
