    "diagnostics.send.debugOffFooterTv" : {
      "comment" : "Note under Send Diagnostics Now in Diagnostics settings when Debug Logging is off. Shown as a footer in the Diagnostics settings pane on Android TV, and on Apple (iPhone, iPad, Apple TV).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجل تصحيح الأخطاء معطّل. يحتوي هذا التقرير على آخر بضع دقائق من السجلات الأساسية فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladicí protokolování je vypnuto. Toto hlášení obsahuje jen základní protokoly z posledních několika minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fejlfindingslogning er slået fra. Denne rapport indeholder kun grundlæggende logs fra de seneste få minutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Debug-Protokollierung ist aus. Dieser Bericht enthält nur die einfachen Protokolle der letzten paar Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug logging is off. This report contains only the last few minutes of basic logs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de depuración está desactivado. Este informe solo contiene los últimos minutos de registros básicos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vianetsintälokit ovat pois päältä. Tämä raportti sisältää vain muutaman viime minuutin peruslokit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La journalisation de débogage est désactivée. Ce rapport ne contient que les dernières minutes des journaux de base."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisivanje za otklanjanje pogrešaka je isključeno. Ovo izvješće sadrži samo osnovne zapisnike iz posljednjih nekoliko minuta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il log di debug è disattivato. Questo report contiene solo gli ultimi minuti dei log di base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバッグログはオフです。このレポートには直近数分間の基本ログのみが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디버그 로깅이 꺼져 있어요. 이 보고서에는 최근 몇 분간의 기본 로그만 포함돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feilsøkingslogging er av. Denne rapporten inneholder bare de siste minuttene med grunnleggende logger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debuglogging staat uit. Dit rapport bevat alleen de basislogs van de laatste paar minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logi debugowania są wyłączone. Ten raport zawiera tylko podstawowe logi z ostatnich kilku minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os logs de depuração estão desativados. Este relatório contém apenas os últimos minutos de logs básicos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отладочное логирование выключено. Этот отчёт содержит только базовые логи за последние несколько минут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felsökningsloggning är av. Rapporten innehåller bara de senaste minuternas grundläggande loggar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hata ayıklama günlüğü kapalı. Bu rapor yalnızca son birkaç dakikanın temel günlüklerini içerir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Журнал налагодження вимкнено. Цей звіт містить лише базові логи за останні кілька хвилин."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调试日志已关闭。此报告仅包含最近几分钟的基本日志。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除錯記錄已關閉。這份報告只包含最近幾分鐘的基本記錄。"
          }
        }
      }
    },
