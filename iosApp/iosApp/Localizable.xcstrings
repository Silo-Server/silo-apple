          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントのプロフィールと設定はこの%1$@から削除され、%2$@も削除されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis e as configurações desta conta serão removidos deste %1$@, e %2$@ também será removido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账户的个人资料和设置将从此%1$@移除，%2$@也将从中移除。"
          }
        }
      }
    },
