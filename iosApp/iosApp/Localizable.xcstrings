    "settings.about.trademarkNotice" : {
      "comment" : "Apple Acknowledgements (all Apple apps): notice under the list of outside services (TMDB, IMDb, Rotten Tomatoes and others).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الأسماء والشعارات ملك لأصحابها. Silo غير تابع لهم ولا معتمد منهم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тези имена и лога принадлежат на съответните им собственици. Приложението Silo не е свързано с тях и не е одобрено от тях."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquests noms i logotips pertanyen als seus propietaris. Silo no hi està afiliat ni té el seu aval."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto názvy a loga patří jejich vlastníkům. Silo s nimi není spojeno ani jimi podporováno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse navne og logoer tilhører deres ejere. Silo er ikke tilknyttet eller godkendt af dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Namen und Logos gehören ihren jeweiligen Inhabern. Silo ist nicht mit ihnen verbunden und wird nicht von ihnen unterstützt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτά τα ονόματα και λογότυπα ανήκουν στους κατόχους τους. Το Silo δεν συνδέεται με αυτούς ούτε υποστηρίζεται από αυτούς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These names and logos belong to their owners. Silo is not affiliated with or endorsed by them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos nombres y logotipos pertenecen a sus propietarios. Silo no está afiliado a ellos ni cuenta con su respaldo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Need nimed ja logod kuuluvad nende omanikele. Silo ei ole nendega seotud ega nende poolt heaks kiidetud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä nimet ja logot kuuluvat omistajilleen. Silo ei ole sidoksissa niihin eikä niiden hyväksymä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces noms et logos appartiennent à leurs propriétaires. Silo n’est ni affilié à ces derniers ni approuvé par eux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השמות והסמלים האלה שייכים לבעליהם. Silo לא קשור אליהם ולא מאושר על ידם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये नाम और लोगो उनके मालिकों के हैं। Silo इनसे संबद्ध नहीं है और न ही इनके द्वारा समर्थित है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovi nazivi i logotipi pripadaju njihovim vlasnicima. Silo nije povezan s njima niti ga oni podržavaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek a nevek és logók a tulajdonosaikat illetik. A Silo nem áll kapcsolatban velük, és ők nem támogatják hivatalosan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama dan logo ini milik pemiliknya masing-masing. Silo tidak berafiliasi dengan atau didukung oleh mereka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi nomi e loghi appartengono ai rispettivi proprietari. Silo non è affiliato a loro né approvato da loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの名称およびロゴは各所有者に帰属します。Siloはこれらの所有者と提携しておらず、承認も受けていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이름과 로고는 각 소유자의 자산이에요. Silo는 이들과 제휴하거나 보증을 받지 않았어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šie pavadinimai ir logotipai priklauso jų savininkams. „Silo“ su jais nesusijęs ir jų neremiamas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šie nosaukumi un logotipi pieder to īpašniekiem. Silo nav ar tiem saistīts, un tie Silo neatbalsta."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama dan logo ini milik pemiliknya masing-masing. Silo tidak bergabung dengan mereka atau disokong oleh mereka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse navnene og logoene tilhører sine eiere. Silo er ikke tilknyttet eller godkjent av dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze namen en logo’s zijn eigendom van hun eigenaars. Silo is niet aan hen gelieerd en wordt niet door hen onderschreven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te nazwy i logo należą do ich właścicieli. Silo nie jest z nimi powiązane ani przez nie wspierane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses nomes e logotipos pertencem aos seus proprietários. O Silo não é afiliado a eles nem endossado por eles."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes nomes e logótipos pertencem aos respetivos proprietários. O Silo não tem qualquer afiliação com eles nem é apoiado por eles."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceste nume și logo-uri aparțin proprietarilor lor. Silo nu are nicio afiliere cu aceștia și nu beneficiază de susținerea lor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти названия и логотипы принадлежат их владельцам. Silo не связан с ними и не одобрен ими."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieto názvy a logá patria ich vlastníkom. Silo s nimi nie je prepojené ani nimi podporované."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta imena in logotipi pripadajo njihovim lastnikom. Silo z njimi ni povezan in ga ne podpirajo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa namn och logotyper tillhör sina respektive ägare. Silo är inte anknutet till eller godkänt av dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชื่อและโลโก้เหล่านี้เป็นของเจ้าของแต่ละราย Silo ไม่ได้มีส่วนเกี่ยวข้องหรือได้รับการรับรองจากเจ้าของเหล่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu adlar ve logolar sahiplerine aittir. Silo’nun onlarla bir bağlantısı yoktur ve onlar tarafından desteklenmemektedir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці назви й логотипи належать їхнім власникам. Silo не пов’язаний із ними й не має їхнього схвалення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tên và logo này thuộc về chủ sở hữu tương ứng. Silo không liên kết với họ và không được họ xác nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些名称和标志归其各自所有者所有。Silo与它们没有关联，也未获得它们的认可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些名稱和標誌屬於其各自的擁有者。Silo 與它們沒有關聯，也未獲得它們的背書。"
          }
        }
      }
    },
