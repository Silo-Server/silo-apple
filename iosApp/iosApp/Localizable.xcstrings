    "downloads.options.qualityFooter" : {
      "comment" : "Apple iOS/macOS: Download Options sheet; footer under the quality choices.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ هذه القيمة من الإعداد الافتراضي العام للتنزيلات. تغييرها هنا يسري على هذا التنزيل فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výchozí hodnota pochází z globálního nastavení stahování. Změna zde platí jen pro toto stažení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette tager udgangspunkt i din generelle standard for downloads. En ændring her gælder kun denne download."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voreingestellt ist dein allgemeiner Standard aus den Download-Einstellungen. Eine Änderung hier gilt nur für diesen Download."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This starts from your global Downloads default. Changing it here applies only to this download."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte de tu configuración predeterminada global de descargas. Si la cambias aquí, solo se aplica a esta descarga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähtökohtana on latausten yleinen oletusasetuksesi. Tässä tehty muutos koskee vain tätä latausta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette valeur reprend votre paramètre par défaut des téléchargements. La modifier ici ne s’applique qu’à ce téléchargement."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polazi od vaše globalne zadane postavke za preuzimanja. Promjena ovdje vrijedi samo za ovo preuzimanje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte dall’impostazione predefinita globale dei download. Se la modifichi qui, vale solo per questo download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全体のダウンロード設定のデフォルトが初期値になります。ここで変更した内容は、このダウンロードにのみ適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 다운로드 기본 설정에서 시작해요. 여기서 변경하면 이 다운로드에만 적용돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette tar utgangspunkt i standardvalget ditt for nedlastinger. Endringer her gjelder bare denne nedlastingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit begint bij je algemene standaard voor downloads. Een wijziging hier geldt alleen voor deze download."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Początkowo używane jest globalne ustawienie domyślne pobierania. Zmiana tutaj dotyczy tylko tego pobierania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começa pelo seu padrão global de Downloads. Alterar aqui vale apenas para este download."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изначально используется качество по умолчанию из общих настроек загрузок. Изменение здесь действует только для этой загрузки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utgår från din globala standard för nedladdningar. Ändringar här gäller bara den här nedladdningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seçenek, genel İndirmeler varsayılanınızla başlar. Burada değiştirmek yalnızca bu indirmeyi etkiler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Початкове значення береться із загальних налаштувань завантажень. Зміна тут стосується лише цього завантаження."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初始值来自你的全局下载默认设置。在此更改仅对本次下载生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設採用你的全域下載設定。在這裡變更只會套用到這次下載。"
          }
        }
      }
    },
    "downloads.options.qualityOriginalDetail" : {
      "comment" : "Apple iOS/macOS: Download Options sheet; detail under the Original quality choice.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جودة المصدر، مع بديل متوافق عند الحاجة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvalita zdroje, v případě potřeby s kompatibilní záložní verzí"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kildekvalitet med kompatibel reserveversion efter behov"
          }
        },
        "de" : {
