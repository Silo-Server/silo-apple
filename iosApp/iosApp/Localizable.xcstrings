        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridajte obľúbené z ľubovoľnej stránky s podrobnosťami a zobrazia sa tu."
          }
        },
        "sl" : {
          "stringUnit" : {
