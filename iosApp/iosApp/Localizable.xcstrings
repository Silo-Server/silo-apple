    "signInTv.warning" : {
      "comment" : "Phone safety warning on the approval card: only approve a sign-in request the user started themselves. Apple (iPhone, iPad): same warning on the approval card and nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توافق على هذا إلا إذا بدأت تسجيل الدخول بنفسك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одобрявайте само ако сами сте започнали входа."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprova-ho només si l’inici de sessió l’has començat tu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schvalujte jen přihlášení, které sami zahajujete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkend kun dette, hvis du selv har startet login."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genehmige dies nur, wenn du die Anmeldung selbst gestartet hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εγκρίνετε μόνο αν ξεκινήσατε εσείς τη σύνδεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only approve this if you started the sign-in yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprueba esto solo si el inicio de sesión lo empezaste tú."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinnitage see ainult siis, kui alustasite sisselogimist ise."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyväksy tämä vain, jos aloitit kirjautumisen itse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’approuvez que si vous avez lancé la connexion vous-même."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאשר רק אם התחלת את ההתחברות בעצמך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे सिर्फ़ तभी मंज़ूरी दें, जब साइन-इन आपने खुद शुरू किया हो।"
