    "player.error.unauthenticatedTransport" : {
      "comment" : "Apple iOS/tvOS/macOS: player error when the server's playback plan doesn't use the authenticated media transport this app requires. Used by the audiobook player.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يلتزم هذا الخادم بنقل الوسائط المصادَق عليه في خطة التشغيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server nedodržel pro plán přehrávání ověřený přenos médií."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren overholdt ikke godkendt medietransport for afspilningsplanen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server hat den authentifizierten Medientransport für den Wiedergabeplan nicht eingehalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server did not honor authenticated media transport for the playback plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no respetó el transporte autenticado del contenido en el plan de reproducción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä palvelin ei noudattanut todennettua mediasiirtoa toistosuunnitelmassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur n’a pas respecté le transport authentifié des médias pour le plan de lecture."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj poslužitelj nije poštovao autentificirani prijenos medija za plan reprodukcije."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo server non ha rispettato il trasporto autenticato dei contenuti per il piano di riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーは、再生プランで認証済みのメディア転送を使用しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버가 재생 계획에서 인증된 미디어 전송을 따르지 않았어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne serveren brukte ikke autentisert medietransport for avspillingsplanen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze server gebruikte geen geauthenticeerd mediatransport voor het afspeelplan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten serwer nie zastosował uwierzytelnionego przesyłania multimediów w planie odtwarzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor não respeitou o transporte de mídia autenticado no plano de reprodução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот сервер не обеспечил аутентифицированную передачу медиа для плана воспроизведения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här servern respekterade inte autentiserad medieöverföring för uppspelningsplanen."
          }
        },
        "tr" : {
