    "settingsManifest.catalog.metadata_language.description" : {
      "comment" : "Help text under the catalog.metadata_language setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللغة الاحتياطية التي يفضّلها Silo للعناوين والأوصاف والصور الفنية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервен език, който Silo предпочита за заглавия, описания и изображения."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idioma alternatiu que Silo prefereix per als títols, les descripcions i les imatges."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záložní jazyk, kterému Silo dává přednost u názvů, popisů a obrázků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservesprog, som Silo foretrækker til titler, beskrivelser og billeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersatzsprache, die Silo für Titel, Beschreibungen und Bilder bevorzugt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εναλλακτική γλώσσα που προτιμά το Silo για τίτλους, περιγραφές και εικόνες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallback language Silo prefers for titles, descriptions, and artwork."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idioma alternativo que Silo prefiere para títulos, descripciones e imágenes."
          }
        },
        "et" : {
          "stringUnit" : {
