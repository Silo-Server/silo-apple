    "player.notice.serverShuttingDown" : {
      "comment" : "Apple iOS/tvOS/macOS: default video player notice text under Server shutting down.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد ينتهي التشغيل قريبًا أثناء إيقاف تشغيل الخادم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Възпроизвеждането може скоро да спре, докато сървърът се изключва."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "És possible que la reproducció s’aturi aviat mentre el servidor s’apaga."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během vypínání serveru může přehrávání brzy skončit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspilningen stopper muligvis snart, mens serveren lukker ned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiedergabe kann in Kürze enden, da der Server heruntergefahren wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναπαραγωγή μπορεί να διακοπεί σύντομα κατά τον τερματισμό λειτουργίας του διακομιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback may end shortly while the server shuts down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reproducción puede terminar en breve mientras se apaga el servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esitus võib serveri väljalülitumise tõttu peagi lõppeda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toisto voi päättyä pian, kun palvelin sammuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lecture peut s’interrompre sous peu pendant l’arrêt du serveur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייתכן שההפעלה תסתיים בקרוב בזמן שהשרת נכבה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर के बंद होने के दौरान प्लेबैक जल्द ही बंद हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodukcija bi se uskoro mogla prekinuti dok se poslužitelj isključuje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lejátszás hamarosan leállhat, mert a szerver leáll."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemutaran mungkin segera berhenti selagi server dimatikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riproduzione potrebbe interrompersi a breve durante lo spegnimento del server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーのシャットダウンに伴い、まもなく再生が終了する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 종료되는 동안 재생이 곧 끝날 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atkūrimas netrukus gali baigtis, nes serveris išjungiamas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atskaņošana drīz var beigties, jo serveris tiek izslēgts."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Main balik mungkin berakhir sebentar lagi semasa pelayan ditutup."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avspillingen kan snart stoppe mens serveren slås av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het afspelen kan binnenkort stoppen terwijl de server wordt afgesloten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarzanie może wkrótce się zakończyć z powodu wyłączania serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reprodução pode ser encerrada em breve enquanto o servidor é desligado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reprodução pode terminar em breve enquanto o servidor encerra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redarea se poate încheia în curând, deoarece serverul se oprește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизведение может скоро прерваться из-за выключения сервера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počas vypínania servera sa prehrávanie môže čoskoro skončiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predvajanje se lahko kmalu konča, ker se strežnik zaustavlja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppspelningen kan snart avbrytas medan servern stängs av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเล่นอาจสิ้นสุดในไม่ช้าขณะที่เซิร์ฟเวอร์ปิดการทำงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu kapatılırken oynatma kısa süre içinde sona erebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відтворення може незабаром завершитися через вимкнення сервера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video có thể sớm dừng phát trong khi máy chủ tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器正在关闭，播放可能很快结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器關機期間，播放可能很快就會結束。"
          }
        }
      }
    },
