        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放恢复已尝试完V3协议的所有路由。"
          }
        }
      }
    },
    "player.error.seekReanchorChanged" : {
      "comment" : "Apple iOS/tvOS/macOS: video player error screen when a seek that needed the server changed how the video plays instead of only moving it.",
