    "home.recipe.continueListeningDefault.description" : {
      "comment" : "One-line description of the Continue Listening preset in the Add row gallery (shared key `home.recipe.continueListeningDefault.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
