          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบบจะลบคำขอ “%1$@” ที่ล้มเหลว คุณขอชื่อเรื่องนี้อีกครั้งได้ภายหลัง"
          }
