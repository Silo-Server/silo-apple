    "settings.appLanguage.footer" : {
      "comment" : "Apple Settings > General: explanation under the App Language picker. Playback is the name of the Playback settings page.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لغة قوائم Silo وأزراره على هذا الملف الشخصي. تُضبط لغات الصوت والترجمة في «التشغيل»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Езикът на менютата и бутоните на Silo за този профил. Езиците на аудиото и субтитрите се задават в настройките „Възпроизвеждане“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’idioma dels menús i els botons de Silo en aquest perfil. Els idiomes d’àudio i de subtítols es configuren a Reproducció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazyk nabídek a tlačítek Silo v tomto profilu. Jazyky zvuku a titulků se nastavují v sekci Přehrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sproget i Silos menuer og knapper på denne profil. Lyd- og undertekstsprog indstilles under Afspilning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprache der Menüs und Schaltflächen von Silo in diesem Profil. Audio- und Untertitelsprachen legst du unter „Wiedergabe“ fest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η γλώσσα των μενού και των κουμπιών του Silo σε αυτό το προφίλ. Οι γλώσσες ήχου και υποτίτλων ορίζονται στην ενότητα «Αναπαραγωγή»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The language of Silo’s menus and buttons on this profile. Audio and subtitle languages are set in Playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma de los menús y botones de Silo en este perfil. Los idiomas de audio y subtítulos se configuran en Reproducción."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo menüüde ja nuppude keel selles profiilis. Heli- ja subtiitrikeeled määratakse jaotises „Esitus“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silon valikkojen ja painikkeiden kieli tässä profiilissa. Ääni- ja tekstityskielet asetetaan Toisto-asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue des menus et des boutons de Silo sur ce profil. Les langues audio et de sous-titres se règlent dans Lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השפה של התפריטים והלחצנים של Silo בפרופיל הזה. שפות האודיו והכתוביות נקבעות בדף ”הפעלה”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस प्रोफ़ाइल पर Silo के मेन्यू और बटन की भाषा। ऑडियो और सबटाइटल की भाषाएँ प्लेबैक में सेट की जाती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jezik izbornika i gumba aplikacije Silo na ovom profilu. Jezici zvuka i titlova postavljaju se u odjeljku Reprodukcija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo menüinek és gombjainak nyelve ezen a profilon. A hang- és feliratnyelvet a Lejátszás oldalon állíthatja be."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa menu dan tombol Silo di profil ini. Bahasa audio dan subtitel diatur di Pemutaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lingua dei menu e dei pulsanti di Silo su questo profilo. Le lingue dell’audio e dei sottotitoli si impostano in Riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールでのSiloのメニューとボタンの言語です。音声と字幕の言語は再生の設定で指定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필에서 Silo 메뉴와 버튼에 쓰이는 언어예요. 오디오 및 자막 언어는 재생에서 설정하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Silo“ meniu ir mygtukų kalba šiame profilyje. Garso ir subtitrų kalbos nustatomos skiltyje „Atkūrimas“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo izvēlņu un pogu valoda šajā profilā. Audio un subtitru valodas tiek iestatītas sadaļā „Atskaņošana”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa menu dan butang Silo pada profil ini. Bahasa audio dan sari kata ditetapkan dalam Main balik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Språket i Silos menyer og knapper på denne profilen. Lyd- og undertekstspråk angis i Avspilling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De taal van de menu’s en knoppen van Silo op dit profiel. Audio- en ondertiteltalen stel je in bij Afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Język menu i przycisków aplikacji Silo w tym profilu. Języki dźwięku i napisów ustawisz w sekcji Odtwarzanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O idioma dos menus e botões do Silo neste perfil. Os idiomas de áudio e legendas são definidos em Reprodução."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O idioma dos menus e botões do Silo neste perfil. Os idiomas de áudio e de legendas são definidos em Reprodução."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limba meniurilor și a butoanelor aplicației Silo pe acest profil. Limbile pentru audio și subtitrări se setează în Redare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Язык меню и кнопок Silo в этом профиле. Языки аудио и субтитров задаются в разделе «Воспроизведение»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazyk ponúk a tlačidiel aplikácie Silo v tomto profile. Jazyky zvuku a titulkov sa nastavujú v časti Prehrávanie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jezik menijev in gumbov aplikacije Silo v tem profilu. Jezika zvoka in podnapisov nastavite v razdelku Predvajanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Språket i Silos menyer och knappar på den här profilen. Ljud- och undertextspråk ställs in under Uppspelning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาษาของเมนูและปุ่มของ Silo ในโปรไฟล์นี้ ภาษาเสียงและคำบรรยายตั้งค่าได้ในการเล่น"
