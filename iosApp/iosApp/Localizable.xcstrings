            "state" : "translated",
            "value" : "Не можахме да потвърдим премахването. Отворете отново екрана „Моите заявки“, за да проверите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hem pogut confirmar que s’hagi tret. Torna a obrir Les meves sol·licituds per comprovar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebrání se nepodařilo potvrdit. Znovu otevřete stránku Moje žádosti a zkontrolujte to."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke bekræfte fjernelsen. Åbn Mine anmodninger igen for at tjekke den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten das Entfernen nicht bestätigen. Öffne „Meine Anfragen“ erneut, um es zu prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η επιβεβαίωση της αφαίρεσης. Ανοίξτε ξανά τη σελίδα «Τα αιτήματά μου» για να το ελέγξετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't confirm the removal. Reopen My Requests to check it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos confirmar la eliminación. Vuelve a abrir Mis solicitudes para comprobarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eemaldamist ei õnnestunud kinnitada. Kontrollimiseks avage uuesti leht „Minu taotlused“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistoa ei voitu vahvistaa. Tarkista tilanne avaamalla Omat pyynnöt uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer la suppression. Rouvrez Mes demandes pour vérifier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לוודא את ההסרה. יש לפתוח מחדש את הדף ”הבקשות שלי” כדי לבדוק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हटाए जाने की पुष्टि नहीं हो सकी। जाँचने के लिए मेरे अनुरोध पेज फिर से खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nismo mogli potvrditi uklanjanje. Ponovno otvorite Moje zahtjeve da biste provjerili."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült megerősíteni az eltávolítást. Az ellenőrzéshez nyissa meg újra a Kéréseim oldalt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak dapat mengonfirmasi penghapusan. Buka kembali Permintaan Saya untuk memeriksanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
