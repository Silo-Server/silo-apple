          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menghubungi pelayan %1$@. Semak sambungan peranti ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
