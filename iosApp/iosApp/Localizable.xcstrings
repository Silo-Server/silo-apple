              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "لم يُغلق Silo بشكل سليم مرة واحدة. يمكنك مراجعة التقرير قبل إرساله إلى فريق Silo Diagnostics."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "لم يُغلق Silo بشكل سليم %1$lld مرة. يمكنك مراجعة التقارير قبل إرسالها إلى فريق Silo Diagnostics."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "لم يُغلق Silo بشكل سليم مرتين. يمكنك مراجعة التقريرين قبل إرسالهما إلى فريق Silo Diagnostics."
                }
              },
              "zero" : {
