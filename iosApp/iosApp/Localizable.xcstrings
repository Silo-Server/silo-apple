          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteys laitteeseen %1$@ katkesi. Avaa Silo Roku-laitteessasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion à %1$@ perdue. Ouvrez Silo sur votre Roku."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza s uređajem %1$@ je prekinuta. Otvorite Silo na svom Roku uređaju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connessione a %1$@ persa. Apri Silo sul tuo Roku."
          }
        },
        "ja" : {
