          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde vote. Vous lancez le titre en tête."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svi glasaju. Vi pokrećete naslov koji vodi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votano tutti. Tu avvii il titolo in testa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員が投票します。トップのタイトルを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
