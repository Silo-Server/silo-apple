  "strings" : {
    "account.alertTitle" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): title of the alert that reports a failed account action, such as a sign-out, server removal or server switch that didn't finish; the message under it says what went wrong.",
