    "library.error.someShelves" : {
      "comment" : "Notice above a library's Recommended rows when some rows only partly loaded for a Movies or Series view (Android phone and Apple iOS). Library is the name of the tab with every title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل بعض الرفوف بالكامل. أعد المحاولة أو افتح المكتبة لتصفح كل العناوين."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Някои редове не можаха да се заредят изцяло. Опитайте отново или отворете раздела „Библиотека“, за да разгледате всички заглавия."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunes files no s’han pogut carregar del tot. Torna-ho a provar o obre Biblioteca per explorar tots els títols."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé řádky se nepodařilo načíst celé. Zkuste to znovu nebo otevřete kartu Knihovna a procházejte všechny tituly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle hylder kunne ikke indlæses helt. Prøv igen, eller åbn Bibliotek for at gennemse alle titler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Reihen konnten nicht vollständig geladen werden. Versuche es erneut oder öffne Mediathek, um alle Titel zu durchsuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορισμένες γραμμές δεν φορτώθηκαν πλήρως. Δοκιμάστε ξανά ή ανοίξτε την καρτέλα «Βιβλιοθήκη» για περιήγηση σε όλους τους τίτλους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some shelves could not be fully loaded. Retry or open Library to browse all titles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
