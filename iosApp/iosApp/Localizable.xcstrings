    "tvSignIn.error.accountRequired" : {
      "comment" : "Android TV and phone sign-in error when the person has no account on the server. The server admin must add them. Apple (iPhone, iPad, Mac, Apple TV): same sign-in error.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس لديك حساب على هذا الخادم بعد. اطلب من أحد المسؤولين إضافتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast noch kein Konto auf diesem Server. Bitte jemanden mit Adminrechten, dich hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have an account on this server yet. Ask an admin to add you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no tienes una cuenta en este servidor. Pide a un administrador que te añada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas encore de compte sur ce serveur. Demandez à un administrateur de vous ajouter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーにはまだアカウントがありません。管理者に追加を依頼してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ainda não tem uma conta neste servidor. Peça a um administrador para adicionar você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在此服务器上还没有账户。请联系管理员添加你。"
          }
        }
      }
    },
    "tvSignIn.error.invalidCredentials" : {
      "comment" : "Android TV password form error for a wrong username or password. Apple (iPhone, iPad, Mac, Apple TV): same password sign-in error.",
