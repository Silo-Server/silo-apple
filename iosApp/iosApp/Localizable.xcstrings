    "home.recipe.genreRouletteWeekly.description" : {
      "comment" : "One-line description of the Genre Roulette preset in the Add row gallery (shared key `home.recipe.genreRouletteWeekly.description`, sent as description_short_key). Shown under or beside the preset's name.",
