    "player.subtitleSync.noticeAlreadyMatches" : {
      "comment" : "Apple iOS/tvOS/macOS: Title of the subtitle sync card in the player's top-trailing corner (iOS, tvOS, macOS). Shown when a sync found the timing already right. 1: subtitle language name, such as English, or the track's label. Android phone and TV player subtitle timing: same title of the sync card. 1: the subtitle's language name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترجمة %1$@ متطابقة مع الصوت بالفعل"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Субтитрите %1$@ вече съвпадат с аудиото"
