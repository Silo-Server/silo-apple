    "signIn.expired" : {
      "comment" : "Message on the Roku sign-in screen shown when the saved session ended. {server}: the server name. Apple (iPhone, iPad, Mac, Apple TV): same line on the sign-in screen after the saved session ended.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تسجيل خروجك من %1$@. سجّل الدخول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relace na serveru %1$@ skončila. Je nutné se znovu přihlásit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blev logget ud af %1$@. Log ind igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wurdest von %1$@ abgemeldet. Melde dich erneut an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You were signed out of %1$@. Sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerró tu sesión en %1$@. Vuelve a iniciar sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinut kirjattiin ulos palvelimelta %1$@. Kirjaudu uudelleen sisään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre session sur %1$@ a expiré. Reconnectez-vous."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odjavljeni ste s poslužitelja %1$@. Ponovno se prijavite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei stato disconnesso da %1$@. Accedi di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@からサインアウトされました。もう一度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 서버에서 로그아웃됐어요. 다시 로그인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ble logget ut av %1$@. Logg på igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent uitgelogd bij %1$@. Log in om verder te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wylogowano cię z serwera %1$@. Zaloguj się ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você saiu de %1$@. Entre novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс на сервере %1$@ завершён. Войдите снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
