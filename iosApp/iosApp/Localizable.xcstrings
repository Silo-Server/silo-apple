    "settings.profilePrefs.overrideLibrary" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac, Apple TV): note when a library's own subtitle setting wins over the profile's.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجاوز إعداد ترجمة خاص بالمكتبة هذا الإعداد الافتراضي للملف الشخصي. تُحفظ التغييرات هنا للملف الشخصي، لكن إعداد المكتبة يظل مطبّقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Untertitel-Einstellung für eine Mediathek hat Vorrang vor diesem Profilstandard. Änderungen hier werden für das Profil gespeichert, die Einstellung der Mediathek gilt aber weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A library-specific subtitle setting overrides this profile default. Changes here are saved for the profile, but the library override still applies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una configuración de subtítulos específica de la biblioteca prevalece sobre esta configuración predeterminada del perfil. Los cambios aquí se guardan para el perfil, pero la de la biblioteca sigue aplicándose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paramètre de sous-titres propre à une bibliothèque remplace cette valeur par défaut du profil. Les modifications effectuées ici sont enregistrées pour le profil, mais le paramètre de la bibliothèque s’applique toujours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリ専用の字幕設定が、このプロフィールのデフォルトより優先されます。ここでの変更はプロフィールに保存されますが、ライブラリの設定が引き続き優先されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
