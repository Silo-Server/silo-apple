    "settingsManifest.player.sleep_timer_default_minutes.description" : {
      "comment" : "Help text under the player.sleep_timer_default_minutes setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المدة التي يبدأ بها مؤقت النوم عند تشغيله. القيمة 0 تبقيه معطّلًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продължителност, с която стартира таймерът за заспиване, когато го включите. 0 го оставя изключен."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durada amb què comença el temporitzador de repòs quan l’actives. Amb 0 queda desactivat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doba, na kterou se časovač vypnutí nastaví po zapnutí. Hodnota 0 jej ponechá vypnutý."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den varighed, sovetimeren starter med, når du slår den til. 0 lader den være slået fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dauer, mit der der Sleep-Timer startet, wenn du ihn einschaltest. Bei 0 bleibt er aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διάρκεια με την οποία ξεκινά ο χρονοδιακόπτης ύπνου όταν τον ενεργοποιείτε. Με 0 παραμένει ανενεργός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duration the sleep timer starts on when you turn it on. 0 leaves it off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duración con la que empieza el temporizador de apagado al activarlo. Con 0 queda desactivado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kestus, millega unetaimer käivitub, kui selle sisse lülitate. 0 jätab selle välja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesto, jolla uniajastin käynnistyy, kun otat sen käyttöön. 0 jättää sen pois päältä."
