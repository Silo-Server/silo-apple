    "tvPair.link.signedOutBody" : {
      "comment" : "Apple (iPhone, iPad) device approval from a link: body when the link's server is saved but signed out on this phone. {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينتمي هذا الرمز إلى %1$@، ولم تسجّل الدخول إليه هنا. سجّل الدخول للموافقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
