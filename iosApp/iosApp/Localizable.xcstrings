    "player.error.unauthenticatedTransport" : {
      "comment" : "Apple iOS/tvOS/macOS: player error when the server's playback plan doesn't use the authenticated media transport this app requires. Used by the audiobook player.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يلتزم هذا الخادم بنقل الوسائط المصادَق عليه في خطة التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server hat den authentifizierten Medientransport für den Wiedergabeplan nicht eingehalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server did not honor authenticated media transport for the playback plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no respetó el transporte autenticado del contenido en el plan de reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur n’a pas respecté le transport authentifié des médias pour le plan de lecture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーは、再生プランで認証済みのメディア転送を使用しませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor não respeitou o transporte de mídia autenticado no plano de reprodução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器的播放计划未使用经过身份验证的媒体传输。"
          }
        }
      }
    },
    "player.error.versionNotInItem" : {
      "comment" : "Apple iOS/tvOS/macOS: video player error screen when the server's playback plan picked a file the title doesn't list.",
