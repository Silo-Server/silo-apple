    "setup.phone.body" : {
      "comment" : "Roku and Android TV: text under the heading on the phone-setup screen, explaining that using the phone avoids typing with the remote. Apple TV: same text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنها الطريقة الأسهل، فلا حاجة إلى الكتابة بجهاز التحكم عن بُعد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това е най-лесният начин. Няма нужда да въвеждате нищо с дистанционното."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "És la manera més fàcil. No cal escriure res amb el comandament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je to nejjednodušší způsob. Ovladačem nemusíte nic psát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er den nemmeste måde. Du skal ikke skrive noget med fjernbetjeningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist der einfachste Weg. Du musst nichts mit der Fernbedienung eingeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι ο πιο εύκολος τρόπος. Δεν χρειάζεται πληκτρολόγηση με το τηλεχειριστήριο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's the easiest way. There's nothing to type with the remote."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es la forma más fácil. No tienes que escribir nada con el control remoto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See on kõige lihtsam viis. Puldiga pole vaja midagi sisestada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se on helpoin tapa. Kaukosäätimellä ei tarvitse kirjoittaa mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est la méthode la plus simple. Rien à saisir avec la télécommande."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זו הדרך הקלה ביותר. אין צורך להקליד בשלט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सबसे आसान तरीका है। रिमोट से कुछ भी टाइप नहीं करना पड़ता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je najjednostavniji način. Ne morate ništa upisivati daljinskim upravljačem."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a legegyszerűbb módszer. Semmit sem kell begépelni a távirányítóval."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini cara termudah. Tidak perlu mengetik dengan remote."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È il modo più semplice. Non c’è niente da digitare con il telecomando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん簡単な方法です。リモコンで入力する必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 쉬운 방법이에요. 리모컨으로 입력할 필요가 없어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai paprasčiausias būdas. Nieko nereikės rinkti pultu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas ir vienkāršākais veids. Ar pulti nekas nav jāraksta."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini cara paling mudah. Tiada apa-apa yang perlu ditaip dengan alat kawalan jauh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er den enkleste måten. Du trenger ikke å skrive noe med fjernkontrollen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is het makkelijkst. Je hoeft niets te typen met de afstandsbediening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To najprostszy sposób. Nie trzeba niczego wpisywać pilotem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É o jeito mais fácil. Não é preciso digitar nada com o controle remoto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É a forma mais fácil. Não tem de escrever nada com o comando."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cea mai simplă metodă. Nu trebuie să tastați nimic cu telecomanda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это самый простой способ: ничего не нужно вводить с пульта."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je to najjednoduchší spôsob. Ovládačom nemusíte nič písať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je najlažji način. Z daljinskim upravljalnikom vam ni treba ničesar vnašati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är enklast så. Du behöver inte skriva något med fjärrkontrollen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นวิธีที่ง่ายที่สุด ไม่ต้องพิมพ์ด้วยรีโมต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kolay yol bu. Kumandayla hiçbir şey yazmanız gerekmez."
          }
        },
