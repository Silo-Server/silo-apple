    "home.recipe.collectionPostersPick.description" : {
      "comment" : "One-line description of the row-of-collections preset in the Add row gallery (shared key `home.recipe.collectionPostersPick.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض عدة مجموعات كملصقات. تفتح كل واحدة منها مجموعتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показване на няколко колекции като постери. Всеки постер отваря своята колекция."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra diverses col·leccions en forma de pòster. Cadascuna obre la seva col·lecció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit několik kolekcí jako plakáty. Každý plakát otevře svou kolekci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis flere samlinger som plakater. Hver plakat åbner sin samling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt mehrere Sammlungen als Poster. Jedes öffnet seine Sammlung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση πολλών συλλογών ως αφίσες. Η καθεμία ανοίγει τη συλλογή της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show several collections as posters. Each one opens its collection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra varias colecciones como pósteres. Cada una abre su colección."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näita mitut kollektsiooni plakatitena. Igaüks avab oma kollektsiooni."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä useita kokoelmia julisteina. Kukin avaa oman kokoelmansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher plusieurs collections sous forme d’affiches. Chacune ouvre sa collection."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת כמה אוספים כפוסטרים. כל אחד פותח את האוסף שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कई कलेक्शन को पोस्टर के रूप में दिखाएँ। हर पोस्टर अपना कलेक्शन खोलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži nekoliko kolekcija kao postere. Svaki otvara svoju kolekciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Több gyűjtemény megjelenítése poszterként. Mindegyik a saját gyűjteményét nyitja meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan beberapa koleksi sebagai poster. Masing-masing membuka koleksinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra più raccolte come poster. Ognuna apre la propria raccolta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数のコレクションをポスターで表示します。各ポスターからそのコレクションを開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 컬렉션을 포스터로 표시해요. 포스터마다 해당 컬렉션이 열려요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodyti kelias kolekcijas kaip plakatus. Kiekvienas plakatas atidaro savo kolekciją."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rādīt vairākas kolekcijas kā plakātus. Katrs plakāts atver savu kolekciju."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan beberapa koleksi sebagai poster. Setiap poster membuka koleksinya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis flere samlinger som plakater. Hver av dem åpner sin samling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon meerdere collecties als posters. Elke poster opent de bijbehorende collectie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż kilka kolekcji jako plakaty. Każdy plakat otwiera swoją kolekcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra várias coleções como pôsteres. Cada uma abre a sua coleção."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra várias coleções como cartazes. Cada uma abre a sua coleção."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișați mai multe colecții ca postere. Fiecare deschide colecția sa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает несколько коллекций в виде постеров. Каждый постер открывает свою коллекцию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje niekoľko kolekcií ako plagáty. Každý plagát otvorí svoju kolekciu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži več zbirk kot plakate. Vsak plakat odpre svojo zbirko."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa flera samlingar som affischer. Var och en öppnar sin samling."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงคอลเลกชันหลายรายการเป็นโปสเตอร์ แต่ละรายการจะเปิดคอลเลกชันนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birkaç koleksiyonu poster olarak gösterir. Her biri kendi koleksiyonunu açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати кілька колекцій як постери. Кожен постер відкриває свою колекцію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị nhiều bộ sưu tập dưới dạng áp phích. Mỗi áp phích mở bộ sưu tập của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以海报形式显示多个合集，每张海报都会打开对应的合集。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以海報顯示數個合輯，每張海報都會開啟對應的合輯。"
          }
        }
      }
    },
