    "error.conflict" : {
      "comment" : "Error message shown when the server answers with the v2 problem type `conflict` (server title: \"Conflict\"). Clients show it instead of the server's English detail in a translated interface, so it must make sense on its own, without the request's specifics.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
