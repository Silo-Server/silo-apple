    "diagnostics.alwaysSend.confirm" : {
      "comment" : "Apple (iPhone, iPad, Apple TV): button in the diagnostics prompt, and the confirm button of its confirmation, that sends crash reports automatically from now on.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
