    "settingsManifest.requests.watchlist_auto_request.description" : {
      "comment" : "Help text under the requests.watchlist_auto_request setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند إضافة عنوان غير موجود في المكتبة إلى قائمة المشاهدة، يتم طلبه أيضًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато добавите в списъка си за гледане заглавие, което не е в библиотеката, то също се заявява."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan afegeixes a la teva llista per veure un títol que no és a la biblioteca, també se sol·licita."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když na seznam ke zhlédnutí přidáte titul, který není v knihovně, zároveň si jej vyžádáte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du tilføjer en titel, der ikke er i biblioteket, til din huskeliste, anmodes der også om den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Titel, der nicht in der Mediathek ist, zu deiner Merkliste hinzufügst, wird er auch angefragt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν προσθέτετε στη λίστα παρακολούθησης έναν τίτλο που δεν υπάρχει στη βιβλιοθήκη, υποβάλλεται και αίτημα για αυτόν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you add a title that is not in the library to your watchlist, also request it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando añadas a tu lista para ver un título que no está en la biblioteca, también se solicitará."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui lisate oma vaatamisloendisse pealkirja, mida meediakogus pole, taotletakse see ka."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun lisäät katselulistallesi nimikkeen, jota ei ole kirjastossa, se myös pyydetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous ajoutez à votre liste à voir un titre absent de la bibliothèque, le demander également."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בהוספת פריט שלא נמצא בספרייה לרשימת הצפייה שלך, תישלח גם בקשה עבורו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप ऐसा टाइटल अपनी वॉचलिस्ट में जोड़ें जो लाइब्रेरी में नहीं है, तो उसका अनुरोध भी करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada na popis za gledanje dodate naslov koji nije u medijateci, za njega se šalje i zahtjev."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a könyvtárban nem szereplő címet ad hozzá a figyelőlistához, egyúttal igényli is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Anda menambahkan judul yang tidak ada di perpustakaan ke daftar tonton, judul itu juga akan diminta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando aggiungi a Da guardare un titolo che non è nella libreria, viene anche richiesto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリにないタイトルをウォッチリストに追加したとき、そのタイトルをリクエストもします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리에 없는 작품을 보고 싶은 목록에 추가하면 요청도 함께 보내요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai į žiūrėjimo sąrašą pridedate pavadinimą, kurio nėra bibliotekoje, kartu pateikiama ir jo užklausa."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad pievienojat skatīšanās sarakstam nosaukumu, kura nav bibliotēkā, to arī pieprasīt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila anda menambah judul yang tiada dalam pustaka ke senarai tontonan, buat permintaan untuknya juga."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du legger til en tittel i huskelisten som ikke finnes i biblioteket, blir det også bedt om den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een titel die niet in de bibliotheek staat aan je kijklijst toevoegt, wordt die ook aangevraagd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy dodajesz do listy do obejrzenia tytuł, którego nie ma w bibliotece, wysyła też prośbę o niego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você adiciona à sua lista para assistir um título que não está na biblioteca, ele também é solicitado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando adiciona à sua lista para ver um título que não está na biblioteca, este também é pedido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când adăugați în lista de vizionare un titlu care nu se află în bibliotecă, solicitați-l și pe acesta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы добавляете в список просмотра фильм или сериал, которого нет в медиатеке, на него также создаётся запрос."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď do zoznamu na pozretie pridáte titul, ktorý nie je v knižnici, zároveň sa vyžiada."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko na seznam za ogled dodate naslov, ki ga ni v knjižnici, se zanj pošlje tudi zahteva."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begär också titlar som inte finns i biblioteket när du lägger till dem i din bevakningslista."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อคุณเพิ่มรายการที่ไม่มีในคลังลงในรายการที่อยากดู ให้ส่งคำขอรายการนั้นด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitaplıkta olmayan bir içeriği izleme listesine eklediğinizde onun için istek de gönderilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли ви додаєте до списку перегляду назву, якої немає в бібліотеці, також надсилати на неї запит."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn thêm một nội dung chưa có trong thư viện vào danh sách xem, đồng thời gửi yêu cầu cho nội dung đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将媒体库中没有的影片添加到待看清单时，同时请求该影片。"
          }
        },
