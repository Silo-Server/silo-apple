    "settingsManifest.home.hide_watched_items.description" : {
      "comment" : "Help text under the home.hide_watched_items setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إزالة العناصر المشاهَدة من أقسام الرئيسية العادية مع إبقاء قسم المميز وأقسام سجل المشاهدة دون تغيير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Премахва изгледаните елементи от обикновените раздели на „Начало“, без да променя препоръчаните раздели и тези с историята на гледане."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treu els elements vistos de les seccions habituals d’Inici i deixa sense canvis les seccions Destacats i d’historial de visualització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebere zhlédnuté položky z běžných sekcí na obrazovce Domů; sekce Doporučené a sekce historie sledování zůstanou beze změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern sete elementer fra almindelige sektioner på Hjem, mens Fremhævet og sektioner med afspilningshistorik forbliver uændrede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt Gesehenes aus den normalen Bereichen der Startseite; „Empfohlen“ und Bereiche mit dem Verlauf bleiben unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαίρεση των στοιχείων που έχετε δει από τις συνήθεις ενότητες της Αρχικής, χωρίς αλλαγές στις ενότητες «Προτεινόμενα» και ιστορικού παρακολούθησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove watched items from ordinary Home sections while keeping Featured and watch-history sections unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita los elementos vistos de las secciones normales de Inicio, sin cambiar Destacados ni las secciones del historial."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eemaldab vaadatud üksused Avalehe tavalistest jaotistest, jättes jaotise „Esiletõstetud“ ja vaatamisajaloo jaotised muutmata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista katsotut kohteet Etusivun tavallisista osioista. Esittelyssä-osio ja katseluhistorian osiot pysyvät ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire les éléments vus des sections ordinaires de l’Accueil, sans modifier les sections À la une et d’historique de visionnage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסרת פריטים שנצפו מאזורים רגילים בדף הבית, בלי לשנות את האזור ”מומלצים” ואת אזורי היסטוריית הצפייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ीचर्ड और देखने के इतिहास वाले सेक्शन को बदले बिना, होम के सामान्य सेक्शन से देखे जा चुके आइटम हटाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanja pogledane stavke iz običnih odjeljaka Početne, a odjeljke Istaknuto i povijest gledanja ostavlja nepromijenjenima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megnézett elemek eltávolítása a Kezdőlap szokásos szakaszaiból; a Kiemelt és a megtekintési előzmények szakaszai változatlanok maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus item yang sudah ditonton dari bagian Beranda biasa, sementara bagian Unggulan dan riwayat tontonan tetap tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi i contenuti guardati dalle normali sezioni della Home, lasciando invariate le sezioni In evidenza e della cronologia di visione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常のホームのセクションから視聴済みのアイテムを外します。注目と視聴履歴のセクションは変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추천 섹션과 시청 기록 섹션은 그대로 두고, 일반 홈 섹션에서 시청한 항목을 제거해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pašalinti peržiūrėtus elementus iš įprastų skilties „Pagrindinis“ skilčių, nekeičiant rekomenduojamų ir žiūrėjimo istorijos skilčių."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noņem noskatītos vienumus no parastajām sākuma ekrāna sadaļām, bet izcelto vienumu un skatīšanās vēstures sadaļas paliek nemainīgas."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alih keluar item yang sudah ditonton daripada bahagian biasa Laman Utama sambil mengekalkan bahagian Pilihan dan sejarah tontonan tanpa perubahan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern sette titler fra vanlige seksjoner på Hjem, mens Fremhevet og seksjonene for seerhistorikk forblir uendret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder bekeken items uit gewone secties van Home; Uitgelicht en secties met kijkgeschiedenis blijven ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwaj obejrzane pozycje ze zwykłych sekcji ekranu głównego, bez zmian w sekcji Polecane i sekcjach historii oglądania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove os itens assistidos das seções comuns do Início, sem alterar as seções Destaques e de histórico."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover os itens vistos das secções normais do Início, mantendo inalteradas as secções Destaques e de histórico de visualização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimină elementele vizionate din secțiunile obișnuite de pe ecranul Acasă, fără a modifica secțiunea Recomandate și secțiunile cu istoricul vizionărilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убирать просмотренное из обычных разделов Главной; разделы «Рекомендуемое» и с историей просмотра не меняются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odoberie pozreté položky z bežných sekcií obrazovky Domov, pričom sekcia Odporúčané a sekcie histórie pozerania zostanú nezmenené."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstrani ogledane elemente iz običajnih razdelkov na zaslonu Domov, razdelka Izpostavljeno in razdelkov zgodovine ogledov pa ne spremeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta bort sedda objekt från vanliga sektioner på Hem, medan Utvalt och sektioner med visningshistorik lämnas oförändrade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นำรายการที่ดูแล้วออกจากส่วนทั่วไปในหน้าแรก โดยคงส่วนรายการเด่นและส่วนประวัติการดูไว้ตามเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlenen öğeleri normal Ana sayfa kısımlarından kaldırır; Öne çıkanlar ve izleme geçmişi kısımları değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прибирати переглянуті елементи зі звичайних розділів Головної, не змінюючи розділів «Рекомендоване» та історії перегляду."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa các mục đã xem khỏi những phần thông thường của Trang chủ, giữ nguyên phần Nổi bật và các phần lịch sử xem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从首页的普通版块中移除已观看的条目，精选和观看历史版块保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從一般的首頁區塊移除已觀看的項目，精選和觀看記錄區塊則維持不變。"
          }
        }
      }
    },
