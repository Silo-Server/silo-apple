    "settingsManifest.player.passout_threshold.description" : {
      "comment" : "Help text under the player.passout_threshold setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الحلقات التي تُشغَّل تلقائيًا قبل أن يسألك Silo إن كنت ما زلت تشاهد. القيمة 0 تعني عدم السؤال أبدًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolik dílů se automaticky přehraje, než se Silo zeptá, zda se stále díváte. Při hodnotě 0 se nikdy nezeptá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mange afsnit der afspilles automatisk, før Silo spørger, om du stadig ser med. 0 spørger aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Folgen automatisch abgespielt werden, bevor Silo fragt, ob du noch schaust. Bei 0 wird nie gefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many episodes auto-play before Silo asks whether you are still watching. 0 never asks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántos episodios se reproducen automáticamente antes de que Silo te pregunte si sigues viendo. Con 0 nunca pregunta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka monta jaksoa toistetaan automaattisesti, ennen kuin Silo kysyy, katsotko vielä. Arvolla 0 ei kysytä koskaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre d’épisodes lus automatiquement avant que Silo vous demande si vous regardez toujours. Avec 0, Silo ne demande jamais."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko se epizoda automatski reproducira prije nego što vas Silo upita gledate li još. Uz 0 nikad ne pita."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanti episodi vengono riprodotti automaticamente prima che Silo chieda se stai ancora guardando. Con 0 non lo chiede mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloが視聴を続けているか確認するまでに自動再生するエピソード数です。0にすると確認しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo에서 계속 시청 중인지 묻기 전에 자동 재생할 에피소드 수예요. 0으로 설정하면 묻지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mange episoder som spilles av automatisk før Silo spør om du fortsatt ser på. 0 spør aldri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoeveel afleveringen automatisch worden afgespeeld voordat Silo vraagt of je nog kijkt. Bij 0 vraagt Silo het nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile odcinków odtworzy się automatycznie, zanim Silo zapyta, czy nadal oglądasz. 0 – nigdy nie pyta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantos episódios são reproduzidos automaticamente antes de o Silo perguntar se você ainda está assistindo. Com 0, nunca pergunta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько серий воспроизводится автоматически, прежде чем Silo спросит, продолжаете ли вы просмотр. 0 — никогда не спрашивать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur många avsnitt som spelas upp automatiskt innan Silo frågar om du fortfarande tittar. 0 frågar aldrig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo’nun hâlâ izleyip izlemediğinizi sormadan önce otomatik oynatılacak bölüm sayısı. 0 olursa hiç sormaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скільки епізодів відтворюється автоматично, перш ніж Silo запитає, чи ви ще дивитеся. 0 – ніколи не запитувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动播放多少集后，Silo会询问你是否仍在观看。设为0则从不询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動播放幾集後，Silo 會詢問你是否還在觀看。設為 0 則永不詢問。"
          }
        }
      }
    },
