    "watchParty.hero.waiting" : {
      "comment" : "Roku: two-line headline on the lobby hero shown to guests before a title is chosen. {host}: the host's display name. The line break is intentional. Apple (iPhone, iPad, Apple TV): same headline in the lobby. Android phone and TV Watch Party lobby: same heading for a guest while nothing is staged; the line break is kept. 1: the host's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في انتظار\n%1$@"
          }
        },
        "cs" : {
