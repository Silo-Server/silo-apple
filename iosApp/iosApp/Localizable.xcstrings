    "pairing.error.signInAgainOn" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: error when the phone's session on the server has ended. {server}: the server's name; {model}: the device model the person is holding, as the system names it (iPhone or iPad; not translated).",
