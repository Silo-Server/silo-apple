          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This session can't change how the account signs in. Sign in with your own account and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión no puede cambiar cómo inicia sesión la cuenta. Inicia sesión con tu propia cuenta y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette session ne peut pas modifier la façon dont le compte se connecte. Connectez-vous avec votre propre compte et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションでは、アカウントのサインイン方法を変更できません。ご自身のアカウントでサインインして、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
