    "settings.profileLaunch.automatic.detailAppleTv" : {
      "comment" : "Apple TV Settings > General > Profile Selection: explanation under the Automatic choice. The Apple TV user is the person signed in to tvOS. A protected profile is one with a PIN.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام الملف الشخصي المختار لمستخدم Apple TV الحالي. قد يُفتح الملف الشخصي المحمي مجددًا دون طلب رمز PIN الخاص به."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използва се профилът, избран за текущия потребител на Apple TV. Защитен профил може да се отвори отново, без да се изисква PIN."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza el perfil seleccionat per a l’usuari actual de l’Apple TV. Un perfil protegit es pot tornar a obrir sense demanar-ne el PIN."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použít profil vybraný pro aktuálního uživatele Apple TV. Chráněný profil se může znovu otevřít bez zadání PINu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug den profil, der er valgt til den aktuelle Apple TV-bruger. En beskyttet profil kan åbnes igen uden at bede om dens PIN-kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet das für den aktuellen Apple TV-Benutzer gewählte Profil. Ein geschütztes Profil kann sich ohne PIN-Abfrage wieder öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρήση του προφίλ που επιλέχθηκε για τον τρέχοντα χρήστη του Apple TV. Ένα προστατευμένο προφίλ μπορεί να ανοίξει ξανά χωρίς να ζητηθεί το PIN του."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the profile selected for the current Apple TV user. A protected profile can reopen without asking for its PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el perfil seleccionado para el usuario actual del Apple TV. Un perfil protegido puede volver a abrirse sin pedir su PIN."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasutatakse praeguse Apple TV kasutaja jaoks valitud profiili. Kaitstud profiil võib uuesti avaneda ilma PIN-koodi küsimata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä nykyiselle Apple TV -käyttäjälle valittua profiilia. Suojattu profiili voi avautua uudelleen kysymättä PIN-koodia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le profil sélectionné pour l’utilisateur actuel de l’Apple TV. Un profil protégé peut se rouvrir sans demander son PIN."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שימוש בפרופיל שנבחר עבור המשתמש הנוכחי ב-Apple TV. פרופיל מוגן יכול להיפתח שוב בלי לבקש את קוד ה-PIN שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
