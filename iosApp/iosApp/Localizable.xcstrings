            "value" : "De inlogprovider is niet meer beschikbaar op deze server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten dostawca logowania nie jest już dostępny na tym serwerze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O provedor de login não está mais disponível neste servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
