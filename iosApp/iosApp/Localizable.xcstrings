          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiadas solicitudes. Espera un momento y vuelve a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liiga palju päringuid. Oodake hetk ja proovige uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liikaa pyyntöjä. Odota hetki ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de demandes. Patientez un instant, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יותר מדי בקשות. יש להמתין רגע ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत ज़्यादा अनुरोध। कृपया थोड़ी देर रुकें और फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previše zahtjeva. Pričekajte trenutak i pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túl sok kérés. Várjon egy kicsit, majd próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak permintaan. Silakan tunggu sebentar dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppe richieste. Attendi un momento e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストが多すぎます。しばらく待ってからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청이 너무 많아요. 잠시 기다린 후 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per daug užklausų. Šiek tiek palaukite ir bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārāk daudz pieprasījumu. Lūdzu, uzgaidiet brīdi un mēģiniet vēlreiz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak permintaan. Sila tunggu sebentar dan cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange forespørsler. Vent litt og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te veel verzoeken. Wacht even en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt wiele żądań. Zaczekaj chwilę i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitas solicitações. Aguarde um momento e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados pedidos. Aguarde um momento e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prea multe cereri. Așteptați puțin și încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком много запросов. Подождите немного и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Príliš veľa požiadaviek. Chvíľu počkajte a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preveč zahtev. Počakajte trenutek in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För många förfrågningar. Vänta en stund och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีคำขอมากเกินไป โปรดรอสักครู่แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok fazla istek gönderildi. Biraz bekleyip tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забагато запитів. Зачекайте трохи й спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá nhiều yêu cầu. Vui lòng chờ một lát rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
