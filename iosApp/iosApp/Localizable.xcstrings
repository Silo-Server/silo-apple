    "downloads.settings.qualitySinglePresets" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; second sentence of the quality footer, when only single items can be downloaded in a preset and the server reports no resolutions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالنسبة إلى العناصر المفردة، تُجهَّز إعدادات معدل البت المسبقة على الخادم عندما يكون الملف الأصلي أكبر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U jednotlivých položek se předvolby datového toku připravují na serveru, pokud je originál větší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For enkelte elementer forberedes forvalg for bitrate på serveren, når originalen er større."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einzelne Titel werden Bitraten-Voreinstellungen auf dem Server vorbereitet, wenn das Original größer ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For single items, bitrate presets are prepared on the server when the original is larger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para elementos individuales, los ajustes predefinidos de tasa de bits se preparan en el servidor cuando el original es más grande."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksittäisille kohteille bittinopeuden esiasetukset valmistellaan palvelimella, kun alkuperäinen on suurempi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les éléments individuels, les préréglages de débit sont préparés sur le serveur lorsque l’original est plus volumineux."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za pojedinačne stavke unaprijed postavljene brzine prijenosa pripremaju se na poslužitelju kada je izvornik veći."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i singoli elementi, i preset di bitrate vengono preparati sul server quando l’originale è più grande."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単体の項目では、オリジナルの方が大きい場合、ビットレートプリセットがサーバーで準備されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개별 항목은 원본이 더 크면 서버에서 비트레이트 프리셋을 준비해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For enkeltelementer forberedes forhåndsinnstillinger for bithastighet på serveren når originalen er større."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor losse items worden bitrate-presets op de server voorbereid als het origineel groter is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przypadku pojedynczych pozycji warianty bitrate’u są przygotowywane na serwerze, gdy oryginał jest większy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para itens individuais, as predefinições de taxa de bits são preparadas no servidor quando o original é maior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для отдельных объектов пресеты битрейта готовятся на сервере, если оригинал больше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För enskilda objekt förbereds bithastighetsförval på servern när originalet är större."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekil öğeler için, orijinal dosya daha büyükse bit hızı ön ayarları sunucuda hazırlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для окремих об’єктів пресети бітрейту готуються на сервері, якщо оригінал більший."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于单个项目，当原始文件较大时，服务器会准备码率预设版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單一項目的原始檔案較大時，伺服器會準備位元速率預設檔。"
          }
        }
      }
    },
    "downloads.settings.qualitySinglePresetsResolution" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; second sentence of the quality footer, when only single items can be downloaded in a preset and presets show a resolution.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالنسبة إلى العناصر المفردة، تُجهَّز إعدادات معدل البت المسبقة على الخادم عندما يكون الملف الأصلي أكبر، بدقة تصل إلى الدقة المعروضة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U jednotlivých položek se předvolby datového toku připravují na serveru, pokud je originál větší, a to až do zobrazeného rozlišení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For enkelte elementer forberedes forvalg for bitrate på serveren, når originalen er større, i op til den viste opløsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einzelne Titel werden Bitraten-Voreinstellungen auf dem Server vorbereitet, wenn das Original größer ist, und zwar bis zur angezeigten Auflösung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For single items, bitrate presets are prepared on the server when the original is larger, at up to the resolution shown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para elementos individuales, los ajustes predefinidos de tasa de bits se preparan en el servidor cuando el original es más grande, hasta la resolución indicada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksittäisille kohteille bittinopeuden esiasetukset valmistellaan palvelimella, kun alkuperäinen on suurempi, enintään näytetyllä resoluutiolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les éléments individuels, les préréglages de débit sont préparés sur le serveur lorsque l’original est plus volumineux, jusqu’à la résolution indiquée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za pojedinačne stavke unaprijed postavljene brzine prijenosa pripremaju se na poslužitelju kada je izvornik veći, do prikazane razlučivosti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i singoli elementi, i preset di bitrate vengono preparati sul server quando l’originale è più grande, fino alla risoluzione indicata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単体の項目では、オリジナルの方が大きい場合、ビットレートプリセットが表示されている解像度までの範囲でサーバーで準備されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개별 항목은 원본이 더 크면 서버에서 표시된 해상도 이하로 비트레이트 프리셋을 준비해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For enkeltelementer forberedes forhåndsinnstillinger for bithastighet på serveren når originalen er større, i opptil oppløsningen som vises."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor losse items worden bitrate-presets op de server voorbereid als het origineel groter is, tot maximaal de getoonde resolutie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przypadku pojedynczych pozycji warianty bitrate’u są przygotowywane na serwerze, gdy oryginał jest większy, maksymalnie w pokazanej rozdzielczości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para itens individuais, as predefinições de taxa de bits são preparadas no servidor quando o original é maior, com até a resolução mostrada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для отдельных объектов пресеты битрейта готовятся на сервере, если оригинал больше, с разрешением не выше указанного."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För enskilda objekt förbereds bithastighetsförval på servern när originalet är större, med upp till den upplösning som visas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekil öğeler için, orijinal dosya daha büyükse bit hızı ön ayarları sunucuda, gösterilen çözünürlüğe kadar hazırlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для окремих об’єктів пресети бітрейту готуються на сервері, якщо оригінал більший, з роздільністю до вказаної."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于单个项目，当原始文件较大时，服务器会准备码率预设版本，最高为所示分辨率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單一項目的原始檔案較大時，伺服器會準備位元速率預設檔，最高為所顯示的解析度。"
          }
        }
      }
    },
