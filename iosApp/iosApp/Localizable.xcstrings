    "player.subtitleSync.resultNoMatch" : {
      "comment" : "Apple iOS/tvOS/macOS: result of the last sync when the subtitle could not be matched. Shown under the selected subtitle's timing actions in the player: the iOS Audio & Subtitles sheet, the macOS player options panel and the tvOS info panel's Subtitles tab. Android phone and TV player subtitle timing: same result under the timing actions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تطابق صوت هذا الفيديو؛ ربما تخص إصدارًا آخر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не съвпадат с аудиото на това видео; вероятно са за друго издание."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No coincideix amb l’àudio d’aquest vídeo; probablement és d’una altra versió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neodpovídá zvuku tohoto videa; pravděpodobně patří k jinému vydání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer ikke til lyden i denne video; sandsynligvis til en anden udgivelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt nicht zum Ton dieses Videos; vermutlich für eine andere Fassung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ταιριάζει με τον ήχο αυτού του βίντεο – πιθανότατα προορίζεται για άλλη έκδοση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doesn't match this video's audio; probably for another release."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No coincide con el audio de este video; probablemente es de otra versión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vasta selle video helile; tõenäoliselt mõne teise väljalaske jaoks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vastaa tämän videon ääntä; luultavasti toiselle julkaisulle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne correspond pas à l’audio de cette vidéo ; probablement prévu pour une autre version."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכתוביות לא תואמות את האודיו של הסרטון הזה; כנראה שהן לגרסה אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस वीडियो के ऑडियो से मेल नहीं खाता; शायद किसी दूसरी रिलीज़ का है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne odgovara zvuku ovog videozapisa; vjerojatno je za drugo izdanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem illeszkedik a videó hangjához; valószínűleg egy másik kiadáshoz készült."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak sesuai dengan audio video ini; kemungkinan untuk rilis lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non corrisponde all’audio di questo video; probabilmente è per un’altra versione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビデオの音声と一致しません。別のリリース用の字幕と思われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 동영상의 오디오와 일치하지 않아요. 다른 릴리스용 자막일 수 있어요."
