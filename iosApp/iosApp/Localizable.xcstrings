          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att nå %1$@. Kontrollera den här enhetens anslutning och öppna länken igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อกับเซิร์ฟเวอร์ %1$@ ไม่ได้ โปรดตรวจสอบการเชื่อมต่อของอุปกรณ์นี้และเปิดลิงก์อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sunucusuna ulaşılamadı. Bu cihazın ağ bağlantısını kontrol edin ve bağlantıyı tekrar açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося з’єднатися із сервером %1$@. Перевірте з’єднання цього пристрою й відкрийте посилання ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kết nối với %1$@. Kiểm tra kết nối của thiết bị này và mở lại liên kết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接%1$@。请检查此设备的网络连接，然后重新打开链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線至 %1$@。請檢查此裝置的網路連線，然後再次開啟連結。"
          }
        }
      }
    },
