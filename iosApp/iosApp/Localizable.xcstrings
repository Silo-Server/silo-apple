    "settings.accounts.footerAppleTv" : {
      "comment" : "Apple TV Settings > Accounts: note at the bottom of the pane about what signing out removes.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي تسجيل الخروج من حساب إلى إزالته وإزالة إعداداته من جهاز Apple TV هذا. ويؤدي تسجيل الخروج من الحساب الوحيد على خادم إلى إزالة الخادم أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dich von einem Konto abmeldest, werden das Konto und seine Einstellungen von diesem Apple TV entfernt. Beim Abmelden vom einzigen Konto eines Servers wird auch der Server entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing out of an account removes it and its settings from this Apple TV. Signing out of a server's only account removes the server too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cerrar sesión en una cuenta, se quitan la cuenta y su configuración de este Apple TV. Al cerrar sesión en la única cuenta de un servidor, también se quita el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se déconnecter d’un compte le retire de cette Apple TV, avec ses paramètres. Se déconnecter du seul compte d’un serveur retire aussi le serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントからサインアウトすると、そのアカウントと設定がこのApple TVから削除されます。サーバーの唯一のアカウントからサインアウトすると、サーバーも削除されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sair de uma conta remove ela e as configurações dela desta Apple TV. Sair da única conta de um servidor também remove o servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出某个账户的登录会从这台Apple TV上移除该账户及其设置。退出服务器唯一账户的登录也会移除该服务器。"
          }
        }
      }
    },
    "settings.accounts.inUse" : {
