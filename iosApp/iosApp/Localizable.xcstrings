    "settings.interface.applyToAllDevices" : {
      "comment" : "Apple Settings > Interface > Title Pages (iPhone, iPad, Mac) and Apple TV Settings > General > Title Pages: switch that makes the Show Title Art choice the profile's for every device instead of this device's own.",
