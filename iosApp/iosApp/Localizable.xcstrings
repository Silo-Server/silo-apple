    "topBar.hint.forYou" : {
      "comment" : "Apple TV: spoken hint on the For You tab in the top bar: keeping focus on it opens its menu.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ التركيز لاختيار قائمة المشاهدة أو المفضلة أو التوصيات"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задръжте фокуса, за да изберете „Списък за гледане“, „Любими“ или „Препоръки“"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el focus per triar la llista per veure, els preferits o les recomanacions"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechte výběr a zvolte seznam ke zhlédnutí, oblíbené nebo doporučení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliv stående for at vælge Huskeliste, Favoritter eller Anbefalinger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verweile hier, um Merkliste, Favoriten oder Empfehlungen zu wählen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μείνετε εδώ για να επιλέξετε «Λίστα παρακολούθησης», «Αγαπημένα» ή «Προτάσεις»"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest to choose Watchlist, Favorites, or Recommendations"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el foco para elegir Lista para ver, Favoritos o Recomendaciones"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jääge siia, et valida vaatamisloend, Lemmikud või soovitused"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viivy tässä, niin voit valita katselulistan, suosikit tai suositukset"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez dessus pour choisir la liste à voir, les favoris ou les recommandations"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להשאיר את המיקוד כדי לבחור ברשימת הצפייה, במועדפים או בהמלצות"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉचलिस्ट, पसंदीदा या सुझाव चुनने के लिए फ़ोकस बनाए रखें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadržite fokus da biste odabrali popis za gledanje, favorite ili preporuke"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Időzzön rajta a Figyelőlista, a Kedvencek vagy az Ajánlások kiválasztásához"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan fokus untuk memilih daftar tonton, favorit, atau rekomendasi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni il focus per scegliere Da guardare, Preferiti o Consigliati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカスしたままにすると、ウォッチリスト、お気に入り、おすすめ作品を選択できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠시 머무르면 보고 싶은 목록, 즐겨찾기, 추천 콘텐츠를 선택할 수 있어요"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustokite ties šiuo skirtuku, kad pasirinktumėte žiūrėjimo sąrašą, mėgstamiausius arba rekomendacijas"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paturiet fokusu, lai izvēlētos skatīšanās sarakstu, izlasi vai ieteikumus"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kekalkan fokus untuk memilih Senarai tontonan, Kegemaran atau Cadangan"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fokuset her for å velge Huskeliste, Favoritter eller Anbefalinger"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat de focus rusten om kijklijst, favorieten of aanbevelingen te kiezen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostań tu, aby wybrać: Do obejrzenia, Ulubione lub Polecane"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o foco para escolher Lista para assistir, Favoritos ou Recomendações"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o foco para escolher Lista para ver, Favoritos ou Recomendações"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mențineți focalizarea pentru a alege Listă de vizionare, Favorite sau Recomandări"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задержите фокус, чтобы выбрать список просмотра, Избранное или рекомендации"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zotrvaním vyberiete zoznam na pozretie, obľúbené alebo odporúčania"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadržite fokus, da izberete seznam za ogled, Priljubljeno ali priporočila"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanna kvar för att välja Bevakningslista, Favoriter eller Rekommendationer"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางโฟกัสค้างไว้เพื่อเลือกรายการที่อยากดู รายการโปรด หรือรายการแนะนำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzleme listesi, Favoriler veya Öneriler arasından seçmek için üzerinde bekleyin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затримайте фокус, щоб вибрати список перегляду, обране або рекомендації"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ tiêu điểm để chọn Danh sách xem, Yêu thích hoặc Đề xuất"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停留以选择待看清单、收藏或推荐"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停留即可選擇待看清單、最愛或推薦"
          }
        }
      }
    },
