    "settingsManifest.playback.buffering_quality_mode.description" : {
      "comment" : "Help text under the playback.buffering_quality_mode setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يفعله Silo في وضع تلقائي عندما يستمر التخزين المؤقت أثناء التشغيل. يسأل Silo دائمًا قبل خفض جودة اخترتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Какво прави Silo при качество „Автоматично“, когато възпроизвеждането продължава да буферира. Silo винаги пита, преди да намали избрано от вас качество."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Què fa Silo amb la qualitat Auto quan la reproducció es continua aturant per carregar. Silo sempre pregunta abans de baixar una qualitat que has triat tu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co Silo udělá v režimu Auto, když se přehrávání opakovaně načítá. Před snížením ručně zvolené kvality se Silo vždy zeptá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad Silo gør med kvaliteten Auto, når afspilningen bliver ved med at buffere. Silo spørger altid, før en kvalitet, du har valgt, sænkes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was Silo bei der Qualität Auto tut, wenn die Wiedergabe immer wieder puffert. Silo fragt immer, bevor eine von dir gewählte Qualität gesenkt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τι κάνει το Silo με την ποιότητα «Αυτόματα» όταν η αναπαραγωγή σταματά συνεχώς για προσωρινή αποθήκευση. Το Silo ρωτά πάντα πριν μειώσει μια ποιότητα που επιλέξατε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What Silo does on Auto when playback keeps buffering. Silo always asks before lowering a quality you picked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué hace Silo en Automático cuando la reproducción no deja de almacenar en búfer. Silo siempre pregunta antes de bajar una calidad que elegiste."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mida Silo teeb kvaliteedi „Auto“ korral, kui esitus pidevalt puhverdab. Enne teie valitud kvaliteedi langetamist küsib Silo alati luba."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä Silo tekee laadulla Auto, kun toisto puskuroi toistuvasti. Silo kysyy aina ennen kuin laskee itse valitsemaasi laatua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que fait Silo en qualité Auto quand la lecture se met sans cesse en mémoire tampon. Silo demande toujours avant de baisser une qualité que vous avez choisie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מה Silo עושה במצב אוטומטי כשההפעלה נעצרת שוב ושוב לטעינה. Silo תמיד שואל לפני הפחתה של איכות שבחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेबैक बार-बार बफ़र होने पर “ऑटो” क्वालिटी में Silo क्या करे। आपकी चुनी हुई क्वालिटी कम करने से पहले Silo हमेशा पूछता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Što Silo radi s kvalitetom Auto kada se reprodukcija stalno međusprema. Silo uvijek pita prije snižavanja kvalitete koju ste odabrali."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit tegyen a Silo Auto beállításnál, ha a lejátszás folyamatosan pufferel. A Silo mindig rákérdez, mielőtt csökkenti az Ön által választott minőséget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan Silo pada mode Otomatis jika pemutaran terus buffering. Silo selalu bertanya sebelum menurunkan kualitas yang Anda pilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa fa Silo con la qualità Auto quando la riproduzione continua a fare buffering. Silo chiede sempre prima di abbassare una qualità che hai scelto tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動のときにバッファリングが続く場合のSiloの動作です。選択した画質を下げる前には必ず確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 화질에서 버퍼링이 계속될 때 Silo가 할 동작이에요. 직접 선택한 화질을 낮출 때는 항상 먼저 물어봐요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ką „Silo“ daro, kai pasirinkta kokybė „Auto“, o atkūrimas vis buferizuojamas. Prieš sumažindama jūsų pasirinktą kokybę, „Silo“ visada paklausia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko Silo dara ar kvalitāti „Auto”, ja atskaņošana atkārtoti buferizējas. Pirms jūsu izvēlētās kvalitātes pazemināšanas Silo vienmēr jautā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan Silo pada Auto apabila main balik terus menimbal. Silo sentiasa bertanya sebelum menurunkan kualiti yang anda pilih."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva Silo gjør med kvaliteten Auto når avspillingen stadig bufrer. Silo spør alltid før den senker en kvalitet du har valgt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat Silo met Auto doet als het afspelen blijft bufferen. Silo vraagt het altijd eerst voordat een door jou gekozen kwaliteit omlaag gaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co Silo robi w trybie Auto, gdy odtwarzanie ciągle się buforuje. Przed obniżeniem wybranej przez ciebie jakości Silo zawsze pyta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o Silo faz na qualidade Auto quando a reprodução fica carregando. O Silo sempre pergunta antes de reduzir uma qualidade que você escolheu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o Silo faz na qualidade Auto quando a reprodução continua a carregar. O Silo pergunta sempre antes de baixar uma qualidade que escolheu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce face Silo în modul Auto când redarea se încarcă în buffer în mod repetat. Silo întreabă întotdeauna înainte de a reduce o calitate aleasă de dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что делает Silo в режиме «Авто», если воспроизведение постоянно прерывается на буферизацию. Прежде чем снизить выбранное вами качество, Silo всегда спрашивает."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čo Silo urobí v režime Auto, keď sa prehrávanie opakovane zastavuje kvôli načítavaniu. Pred znížením kvality, ktorú ste si vybrali, sa Silo vždy opýta."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaj Silo naredi pri kakovosti Auto, ko se predvajanje nenehno medpomni. Preden zniža kakovost, ki ste jo izbrali sami, Silo vedno vpraša."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad Silo gör med kvaliteten Auto när uppspelningen buffrar gång på gång. Silo frågar alltid innan en kvalitet som du har valt sänks."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่ Silo ทำเมื่อใช้คุณภาพ “อัตโนมัติ” และการเล่นบัฟเฟอร์อยู่เรื่อย ๆ Silo จะถามก่อนลดคุณภาพที่คุณเลือกไว้เสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatma “Otomatik” kalitede sürekli arabelleğe alındığında Silo’nun ne yapacağı. Silo, sizin seçtiğiniz bir kaliteyi düşürmeden önce her zaman sorar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що робить Silo в режимі «Авто», якщо відтворення постійно буферизується. Silo завжди питає, перш ніж знизити вибрану вами якість."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc Silo làm ở chế độ Tự động khi phát lại liên tục phải tải vào bộ đệm. Silo luôn hỏi trước khi giảm chất lượng bạn đã chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在自动模式下播放持续缓冲时Silo的处理方式。降低你手动选择的画质前，Silo总会先询问你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設為自動時，若播放持續緩衝，Silo 要怎麼處理。降低你手動選擇的畫質前，Silo 一律會先詢問。"
          }
        }
      }
    },
