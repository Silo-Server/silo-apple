    "requests.notice.following" : {
      "comment" : "Toast on Roku after the user turns on notifications for a request. Promises a notice when the title is available. Apple (iPhone, iPad, Mac, Apple TV): same notice under the Notify Me button on a request detail page.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنُعلمك عندما يصبح متاحًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dáme vám vědět, až bude k dispozici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi giver dig besked, når den er tilgængelig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sagen dir Bescheid, sobald es verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll let you know when it's available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisaremos cuando esté disponible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ilmoituksen, kun se on saatavilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous vous avertirons dès que ce sera disponible."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obavijestit ćemo vas kad bude dostupno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avviseremo quando sarà disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴可能になったらお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이용할 수 있게 되면 알려 드릴게요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi gir deg beskjed når den er tilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We laten het je weten zodra het beschikbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damy ci znać, gdy będzie dostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisaremos quando estiver disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы сообщим вам, когда это станет доступно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi meddelar dig när den är tillgänglig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanılabilir olduğunda size haber vereceğiz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми повідомимо вам, коли це буде доступно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可观看时我们会通知你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可觀看時我們會通知你。"
          }
        }
      }
    },
    "requests.notice.removeConflict" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message on My Requests when the server refused to delete a request because its state changed. Android phone and TV request screens: same message on My Requests.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر هذا الطلب منذ تحميل القائمة، لذا لم تتم إزالته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádost se od načtení seznamu změnila, proto nebyla odebrána."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne anmodning er ændret, siden listen blev indlæst, så den blev ikke fjernet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anfrage hat sich seit dem Laden der Liste geändert und wurde daher nicht entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This request changed since the list loaded, so it wasn't removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud cambió desde que se cargó la lista, así que no se eliminó."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyntö muuttui luettelon latautumisen jälkeen, joten sitä ei poistettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette demande a changé depuis le chargement de la liste ; elle n’a donc pas été supprimée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj se zahtjev promijenio nakon učitavanja popisa pa nije uklonjen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa richiesta è cambiata dopo il caricamento dell’elenco, quindi non è stata rimossa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストの読み込み後にこのリクエストが変更されたため、削除されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록을 불러온 후 요청이 변경되어 제거하지 않았어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne forespørselen er endret siden listen ble lastet inn, så den ble ikke fjernet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze aanvraag is gewijzigd sinds de lijst werd geladen en is daarom niet verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta prośba zmieniła się od wczytania listy, więc jej nie usunięto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitação mudou desde que a lista foi carregada, por isso não foi removida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос изменился после загрузки списка, поэтому он не удалён."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förfrågan har ändrats sedan listan lästes in, så den togs inte bort."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste yüklendikten sonra bu istek değiştiği için kaldırılmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей запит змінився після завантаження списку, тому його не вилучено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此请求在列表加载后已发生变化，因此未被移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此請求在列表載入後已有變更，因此未移除。"
          }
        }
      }
    },
