          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speed tests are skipped on metered networks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pruebas de velocidad no se hacen en redes de uso medido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nopeustestejä ei tehdä käytön mukaan laskutettavissa verkoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tests de vitesse ne sont pas effectués sur les réseaux à données limitées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na mrežama s ograničenim prometom testovi brzine se preskaču."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulle reti a consumo i test di velocità non vengono eseguiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "従量制ネットワークでは速度テストは行われません。"
