    "watchParty.strip.manager" : {
      "comment" : "Caption of the suggestions strip for the host or manager, who can queue a suggestion to play next: Watch Party on Roku, Android phone and TV, beside the lobby's suggestions on Apple iPhone, iPad and Apple TV, and the web Watch Together lobby.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف اقتراحًا إلى قائمة الانتظار ليكون التالي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете предложение в опашката, за да е следващо."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posa’n un a la cua perquè sigui el següent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařaďte návrh do fronty a přehraje se jako další."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt et forslag i kø for at afspille det som det næste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reihe einen Vorschlag ein, damit er als Nächstes läuft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε μια πρόταση στην ουρά ώστε να ακολουθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queue one to put it up next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon una en cola para que sea la siguiente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisage soovitus järjekorda, et see järgmisena esitada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää ehdotus jonoon, niin se toistetaan seuraavaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez-en une à la file d’attente pour la lire ensuite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להוסיף הצעה לתור כדי שתהיה הבאה בתור."
