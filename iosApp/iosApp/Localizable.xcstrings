    "signIn.provider.reason.unavailable" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error when the server can't reach the sign-in provider (also used after a TV approval when the provider couldn't confirm the account).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى مزود تسجيل الدخول حاليًا. حاول مرة أخرى لاحقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskytovatel přihlášení je teď nedostupný. Zkuste to později."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loginudbyderen kan ikke kontaktes lige nu. Prøv igen senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anmeldeanbieter ist gerade nicht erreichbar. Versuche es später erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in provider can't be reached right now. Try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede contactar con el proveedor de inicio de sesión en este momento. Vuelve a intentarlo más tarde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjautumispalveluun ei saada yhteyttä juuri nyt. Yritä myöhemmin uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le fournisseur de connexion pour le moment. Réessayez plus tard."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pružatelj prijave trenutačno nije dostupan. Pokušajte ponovno kasnije."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il provider di accesso non è raggiungibile al momento. Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在サインインプロバイダーに接続できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 로그인 제공자에 연결할 수 없어요. 나중에 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påloggingsleverandøren kan ikke nås akkurat nå. Prøv igjen senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De inlogprovider is nu niet bereikbaar. Probeer het later opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostawca logowania jest teraz niedostępny. Spróbuj ponownie później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível acessar o provedor de login agora. Tente novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер входа сейчас недоступен. Повторите попытку позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggningsleverantören går inte att nå just nu. Försök igen senare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum açma sağlayıcısına şu anda ulaşılamıyor. Daha sonra tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
