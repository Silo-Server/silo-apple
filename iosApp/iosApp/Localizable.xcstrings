    "update.appRequired" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error shown on sign-in, pairing, playback, settings and other screens when the server no longer accepts this version of the app; the user should update the app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّث Silo لمواصلة استخدام هذا الخادم."
