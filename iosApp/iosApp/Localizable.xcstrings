    "tvSignIn.appleTv.typeOnPhoneBody" : {
      "comment" : "Apple TV: card text beside the password and server address forms explaining that nearby iPhones and iPads offer a keyboard.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند اختيار حقل، يظهر إشعار لوحة المفاتيح على أجهزة iPhone وiPad القريبة. اكتب هناك بدلًا من جهاز التحكم عن بُعد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато изберете поле, на близките iPhone и iPad устройства се появява известие за клавиатура. Пишете там вместо с дистанционното."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan seleccionis un camp, apareixerà una notificació de teclat als iPhone i iPad propers. Escriu-hi en lloc d’utilitzar el comandament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když vyberete pole, na iPhonech a iPadech v okolí se zobrazí oznámení s klávesnicí. Pište na nich místo dálkového ovladače."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du vælger et felt, vises en tastaturnotifikation på iPhones og iPads i nærheden. Skriv der i stedet for med fjernbetjeningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du ein Feld auswählst, erscheint auf iPhones und iPads in der Nähe eine Tastaturmitteilung. Tippe dort statt mit der Fernbedienung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν επιλέγετε ένα πεδίο, εμφανίζεται ειδοποίηση πληκτρολογίου στα κοντινά iPhone και iPad. Πληκτρολογήστε από εκεί αντί με το τηλεχειριστήριο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you select a field, a keyboard notification appears on nearby iPhones and iPads. Type there instead of with the remote."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al seleccionar un campo, aparece una notificación de teclado en los iPhone y iPad cercanos. Escribe ahí en lugar de usar el control remoto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui valite välja, ilmub läheduses olevatele iPhone’idele ja iPadidele klaviatuuri teavitus. Tippige seal, mitte puldiga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun valitset kentän, lähellä oleviin iPhoneihin ja iPadeihin tulee näppäimistöilmoitus. Kirjoita niillä kaukosäätimen sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous sélectionnez un champ, une notification de clavier apparaît sur les iPhone et iPad à proximité. Saisissez le texte sur l’un d’eux plutôt qu’avec la télécommande."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בבחירת שדה, מופיעה התראת מקלדת במכשירי iPhone ו-iPad קרובים. אפשר להקליד שם במקום עם השלט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई फ़ील्ड चुनने पर आस-पास के iPhone और iPad पर कीबोर्ड की सूचना दिखती है। रिमोट के बजाय वहाँ टाइप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada odaberete polje, na obližnjim iPhone i iPad uređajima pojavit će se obavijest s tipkovnicom. Tipkajte ondje umjesto daljinskim upravljačem."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha kiválaszt egy mezőt, a közeli iPhone-okon és iPadeken billentyűzetértesítés jelenik meg. Ott gépeljen a távirányító helyett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Anda memilih kolom, notifikasi keyboard muncul di iPhone dan iPad terdekat. Ketik di sana, bukan dengan remote."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando selezioni un campo, sugli iPhone e iPad vicini appare una notifica della tastiera. Digita lì invece di usare il telecomando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィールドを選択すると、近くのiPhoneやiPadにキーボードの通知が表示されます。リモコンの代わりにそちらで入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력란을 선택하면 근처 iPhone과 iPad에 키보드 알림이 표시돼요. 리모컨 대신 거기에서 입력하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkus lauką, netoliese esančiuose „iPhone“ ir „iPad“ įrenginiuose pasirodo klaviatūros pranešimas. Rašykite ten, o ne pultu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad atlasāt lauku, tuvumā esošajās iPhone un iPad ierīcēs parādās tastatūras paziņojums. Rakstiet tur, nevis ar pulti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila anda memilih medan, pemberitahuan papan kekunci muncul pada iPhone dan iPad yang berdekatan. Taip di sana dan bukan dengan alat kawalan jauh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du velger et felt, vises et tastaturvarsel på iPhone- og iPad-enheter i nærheten. Skriv der i stedet for med fjernkontrollen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een veld selecteert, verschijnt er een toetsenbordmelding op iPhones en iPads in de buurt. Typ daar in plaats van met de afstandsbediening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy wybierzesz pole, na pobliskich urządzeniach iPhone i iPad pojawi się powiadomienie klawiatury. Pisz tam zamiast pilotem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao selecionar um campo, uma notificação de teclado aparece nos iPhones e iPads próximos. Digite neles em vez de usar o controle remoto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando seleciona um campo, aparece uma notificação de teclado nos iPhones e iPads próximos. Escreva aí em vez de usar o comando."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când selectați un câmp, pe iPhone-urile și iPad-urile din apropiere apare o notificare de tastatură. Tastați acolo în loc să folosiți telecomanda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы выбираете поле, на iPhone и iPad поблизости появляется уведомление с клавиатурой. Вводите текст там, а не с помощью пульта."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď vyberiete pole, na zariadeniach iPhone a iPad v blízkosti sa zobrazí upozornenie s klávesnicou. Píšte na nich namiesto diaľkového ovládača."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko izberete polje, se na bližnjih napravah iPhone in iPad prikaže obvestilo s tipkovnico. Tipkajte tam namesto z daljinskim upravljalnikom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du väljer ett fält visas en tangentbordsavisering på iPhone- och iPad-enheter i närheten. Skriv där i stället för med fjärrkontrollen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อคุณเลือกช่อง การแจ้งเตือนแป้นพิมพ์จะปรากฏบน iPhone และ iPad ที่อยู่ใกล้เคียง พิมพ์ที่นั่นแทนการใช้รีโมต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir alanı seçtiğinizde yakındaki iPhone ve iPad’lerde bir klavye bildirimi görünür. Kumanda yerine oradan yazın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли ви виберете поле, на iPhone та iPad поблизу з’явиться сповіщення клавіатури. Вводьте текст там, а не пультом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn chọn một trường, thông báo bàn phím sẽ xuất hiện trên iPhone và iPad ở gần. Nhập trên đó thay vì dùng điều khiển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择字段时，附近的iPhone和iPad上会出现键盘通知。可以在那里输入，而不必使用遥控器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇欄位時，附近的 iPhone 和 iPad 會出現鍵盤通知。你可以在那裡輸入，不必使用遙控器。"
          }
        }
      }
    },
