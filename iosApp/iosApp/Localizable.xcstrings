    "notReady.still" : {
      "comment" : "Message on Roku after rechecking, saying the server still needs administrator setup. Apple (iPhone, iPad, Mac, Apple TV): same message after Check again on the server needs setup screen, and after Try again on the saved-server recovery screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال هذا الخادم يحتاج إلى إعداد من المسؤول."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server stále vyžaduje nastavení správcem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne server mangler stadig at blive sat op af en administrator."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server muss noch von der Administration eingerichtet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server still needs administrator setup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor aún requiere que un administrador lo configure."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä palvelin vaatii yhä ylläpitäjän määritystä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur doit encore être configuré par l’administrateur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrator još mora postaviti ovaj poslužitelj."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo server richiede ancora la configurazione da parte dell’amministratore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーはまだ管理者によるセットアップが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버는 아직 관리자 설정이 필요해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne serveren må fortsatt konfigureres av administratoren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze server moet nog door een beheerder worden geconfigureerd."
          }
