          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes la sesión iniciada en %1$@ como %2$@. Al reemplazar, se cerrará la sesión de %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à %1$@ utilise maintenant %2$@. Le remplacement déconnecte %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に%2$@としてサインインしました。置き換えると%3$@からサインアウトします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entrou em %1$@ como %2$@. Ao substituir, você sai de %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你现在已以%2$@的身份登录%1$@。替换将退出%3$@。"
