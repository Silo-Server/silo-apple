    "settings.about.creditAdvisoryAges" : {
      "comment" : "Apple Acknowledgements (all Apple apps): what Silo uses this outside service for, under its name or logo. Services: Common Sense Media and MDBList.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحد الأدنى المقترح لأعمار المشاهدين، عندما يوفّره خادمك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Препоръчителна минимална възраст на зрителите, когато сървърът ви я предоставя."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edats mínimes recomanades per als espectadors, quan el teu servidor les proporciona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doporučený minimální věk diváků, pokud ho váš server poskytuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anbefalede minimumsaldre for seere, når din server leverer dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfohlenes Mindestalter zum Ansehen, sofern dein Server es bereitstellt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προτεινόμενες ελάχιστες ηλικίες θεατών, όταν τις παρέχει ο διακομιστής σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggested minimum viewer ages, when your server provides them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edades mínimas sugeridas para el público, cuando tu servidor las proporciona."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soovituslikud vaatajate vanuse alampiirid, kui teie server neid pakub."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suositellut katsojien vähimmäisiät, kun palvelimesi antaa ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âges minimaux conseillés, lorsque votre serveur les fournit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גילאי צפייה מינימליים מומלצים, כשהשרת שלך מספק אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दर्शकों के लिए सुझाई गई न्यूनतम आयु, जब आपका सर्वर इसे उपलब्ध कराता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preporučena minimalna dob gledatelja, kada je pruža vaš poslužitelj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javasolt minimális nézői életkor, ha a szerver megadja."
          }
        },
        "id" : {
