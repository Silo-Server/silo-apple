          "stringUnit" : {
            "state" : "translated",
            "value" : "Undertexter med inbyggd formatering följer valet Video åsidosätter stil i varje textningsalternativ på enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำบรรยายที่มีรูปแบบในตัวจะใช้ตัวเลือก “วิดีโอแทนที่รูปแบบ” ของตัวเลือกคำบรรยายแต่ละรายการในอุปกรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerleşik stile sahip altyazılar, her cihaz altyazı seçeneğinin “Video stili geçersiz kılar” ayarına uyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Субтитри з вбудованим оформленням враховують вибір «Відео перевизначає стиль» для кожного параметра субтитрів пристрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phụ đề có kiểu định dạng tích hợp sẵn tuân theo lựa chọn Video ghi đè kiểu của từng tùy chọn phụ đề chi tiết trên thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自带样式的字幕遵循设备各字幕选项中的“视频覆盖样式”设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "具有內建樣式的字幕會依照各裝置字幕選項中的「影片覆寫樣式」設定。"
          }
        }
      }
    },
