        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du hier wieder beitrittst, wird das andere Gerät dieses Profils von der Party getrennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoining here disconnects this profile's other device from the party."
