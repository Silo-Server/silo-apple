    "settings.subtitles.lowLegibility" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac) and Apple TV Settings > Subtitles: warning under the subtitle preview when the chosen style is hard to read.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضوح منخفض — قد تصعب قراءة النص الشفاف جدًا أو الداكن دون مربع أو حدود."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlecht lesbar – sehr transparenter oder dunkler Text ohne Kasten oder Kontur kann schwer zu lesen sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low legibility — very transparent or dark text without a box or outline can be hard to read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poca legibilidad: el texto muy transparente u oscuro sin recuadro ni contorno puede ser difícil de leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisibilité faible — un texte très transparent ou sombre sans cadre ni contour peut être difficile à lire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読みにくい設定です。透明度が高い文字や暗い文字は、ボックスや縁取りがないと読みにくくなることがあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa legibilidade — texto muito transparente ou escuro sem caixa ou contorno pode ser difícil de ler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可读性低——非常透明或深色的文字在没有背景框或描边时可能难以阅读。"
          }
        }
      }
    },
