        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod telewizora należy do serwera %1$@, którego nie ma jeszcze na tym urządzeniu. Dodaj go i zaloguj się, a potem zatwierdź telewizor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O código da TV pertence a %1$@, que ainda não está neste dispositivo. Adicione o servidor e entre, depois aprove a TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код телевизора относится к серверу %1$@, которого ещё нет на этом устройстве. Добавьте его и войдите, затем подтвердите вход на телевизоре."
