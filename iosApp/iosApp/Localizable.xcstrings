          "stringUnit" : {
            "state" : "translated",
            "value" : "所有人准备好后，%1$@将开始播放。"
          }
        }
      }
    },
    "watchParty.hint.hostStartsTheWinner" : {
      "comment" : "Roku: hint line shown to guests in a voting lobby. {host}: the host's display name. Apple (iPhone, iPad, Apple TV): same hint under the lobby's buttons. Android phone and TV Watch Party lobby: same line under a guest's buttons. 1: the host's name.",
