    "settingsManifest.playback.auto_skip_credits.description" : {
      "comment" : "Help text under the playback.auto_skip_credits setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجاوز شارة النهاية تلقائيًا عند توفر التخطي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично прескачане на финалните надписи, когато прескачането е налично."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa automàticament els crèdits finals quan es poden ometre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky přeskočit závěrečné titulky, pokud je přeskočení k dispozici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring automatisk over rulleteksterne, når det er muligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt den Abspann automatisch, wenn das möglich ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτόματη παράλειψη των τίτλων τέλους όταν είναι διαθέσιμη η παράλειψη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move through end credits automatically when a skip is available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa los créditos finales automáticamente cuando se puedan omitir."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätab lõputiitrid automaatselt vahele, kui vahelejätmine on saadaval."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohita lopputekstit automaattisesti, kun ohitus on saatavilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe automatiquement le générique de fin quand c’est possible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דילוג אוטומטי על קרדיטי הסיום כשאפשר לדלג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोड़ने का विकल्प उपलब्ध होने पर एंड क्रेडिट अपने-आप छोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatski preskače odjavnu špicu kada je preskakanje dostupno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
