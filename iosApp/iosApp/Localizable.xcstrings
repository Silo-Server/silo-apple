    "profiles.error.accountChanged" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error shown when the signed-in account changed while a profile was being opened.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر الحساب النشط أثناء اختيار الملف الشخصي. حاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během výběru profilu se změnil aktivní účet. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den aktive konto blev ændret, mens profilen blev valgt. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das aktive Konto hat sich während der Profilauswahl geändert. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The active account changed while selecting the profile. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta activa cambió mientras se seleccionaba el perfil. Vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiivinen tili vaihtui profiilia valittaessa. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte actif a changé pendant la sélection du profil. Réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivni račun promijenio se tijekom odabira profila. Pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’account attivo è cambiato durante la selezione del profilo. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールの選択中に使用中のアカウントが変更されました。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필을 선택하는 동안 사용 중인 계정이 변경됐어요. 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den aktive kontoen ble endret mens profilen ble valgt. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het actieve account is gewijzigd tijdens het kiezen van het profiel. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywne konto zmieniło się podczas wybierania profilu. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta ativa mudou durante a seleção do perfil. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активный аккаунт изменился во время выбора профиля. Повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
