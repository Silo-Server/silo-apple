    "player.aiTranslate.quotaExhaustedNote" : {
      "comment" : "Apple iOS and tvOS: note under the AI subtitles quota line when no audio transcriptions are left.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدمت كل رصيد النسخ لهذه الفترة. لا تزال ترجمة مسار ترجمة موجود متاحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
