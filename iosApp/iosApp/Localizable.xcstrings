          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pruebas de velocidad no se hacen en redes de uso medido, y se aplica la configuración de Calidad con datos móviles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nopeustestejä ei tehdä käytön mukaan laskutettavissa verkoissa, vaan käytössä ovat Mobiiliverkon laatu -asetukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tests de vitesse ne sont pas effectués sur les réseaux à données limitées, et les paramètres Qualité sur réseau mobile s’appliquent."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na mrežama s ograničenim prometom testovi brzine se preskaču i primjenjuju se postavke kvalitete za mobilnu mrežu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulle reti a consumo i test di velocità non vengono eseguiti e si applicano le impostazioni Qualità rete cellulare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "従量制ネットワークでは速度テストは行われず、モバイル通信の画質の設定が適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터 요금제 네트워크에서는 속도 테스트를 건너뛰고 셀룰러 화질 설정이 적용돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hastighetstester hoppes over på forbruksmålte nettverk, og innstillingene for mobilnettkvalitet gjelder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op netwerken met een datalimiet worden geen snelheidstests uitgevoerd; dan gelden de instellingen voor Mobiele kwaliteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W sieciach z limitem danych testy szybkości są pomijane i obowiązują ustawienia jakości w sieci komórkowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os testes de velocidade não são feitos em redes limitadas, e as configurações de Qualidade em dados móveis se aplicam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В лимитных сетях проверка скорости не выполняется — действуют настройки «Качество в мобильной сети»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hastighetstester görs inte på nätverk med datapriser, och inställningarna för mobilkvalitet gäller."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sınırlı veri kullanan ağlarda hız testi yapılmaz ve Hücresel kalite ayarları uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У мережах із тарифікацією трафіку тест швидкості не виконується, і діють налаштування «Якість у мобільній мережі»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用按流量计费的网络时不进行测速，将应用蜂窝网络画质设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用計量付費網路時會略過速度測試，並套用「行動網路畫質」設定。"
          }
        }
      }
    },
