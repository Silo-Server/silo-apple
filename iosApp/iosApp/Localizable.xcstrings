    "settings.signIn.connectFooter.networkOwnerKeepsPassword" : {
      "comment" : "Apple Settings > Sign-in > Connect (iPhone, iPad, Mac): note under the Silo password when connecting a network provider such as Tailscale, which knows who owns this device, on a server that keeps the password. {owner}: the device owner's name at the provider; {provider}: the provider's name.",
      "extractionState" : "manual",
      "localizations" : {
