      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتبط الموافقة على تقارير الأعطال بحساب الخادم هذا. تسجيل التصحيح إعداد خاص بهذا الجهاز."
          }
