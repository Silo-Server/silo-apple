          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: poslužitelj ili Silo najprije treba ažurirati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: előbb frissíteni kell a szervert vagy a Silót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: server atau Silo perlu diperbarui terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
