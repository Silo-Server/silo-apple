          }
        }
      }
    },
    "requests.notice.removeConflict" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): message on My Requests when the server refused to delete a request because its state changed. Android phone and TV request screens: same message on My Requests.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر هذا الطلب منذ تحميل القائمة، لذا لم تتم إزالته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anfrage hat sich seit dem Laden der Liste geändert und wurde daher nicht entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This request changed since the list loaded, so it wasn't removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud cambió desde que se cargó la lista, así que no se eliminó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette demande a changé depuis le chargement de la liste ; elle n’a donc pas été supprimée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストの読み込み後にこのリクエストが変更されたため、削除されませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitação mudou desde que a lista foi carregada, por isso não foi removida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此请求在列表加载后已发生变化，因此未被移除。"
          }
        }
      }
    },
    "requests.notice.removed" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): short notice on My Requests after a failed request was deleted. Android phone and TV request screens: same notice on My Requests after a failed request was deleted.",
