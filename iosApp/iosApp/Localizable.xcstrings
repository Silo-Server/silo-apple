    "settings.profileSettings.removesCount" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: message of the Use Profile Settings confirmation when this device changed several settings (English uses settings.profileSettings.removesOne for exactly one). {count}: how many settings this device changed.",
