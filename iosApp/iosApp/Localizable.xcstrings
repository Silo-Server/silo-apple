            "value" : "Die Postergröße wird mit den anderen Fernsehern dieses Profils synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poster size syncs with other TV-family devices on this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tamaño de los pósteres se sincroniza con los demás dispositivos de TV de este perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La taille des affiches est synchronisée avec les autres appareils TV de ce profil."
          }
        },
        "ja" : {
          "stringUnit" : {
