          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tej sesji nie można zmienić hasła. Zaloguj się na własne konto i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
