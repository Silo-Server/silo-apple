    "player.subtitleSync.forbiddenOwner" : {
      "comment" : "Apple iOS/tvOS/macOS: replaces the timing actions after an older server refused them for this profile. Shown under the selected subtitle's timing actions in the player: the iOS Audio & Subtitles sheet, the macOS player options panel and the tvOS info panel's Subtitles tab.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تغيير توقيت هذه الترجمة إلا لمن أضافها أو للمسؤول."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časování těchto titulků může změnit jen ten, kdo je přidal, nebo správce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun den person, der tilføjede underteksten, eller en administrator kan ændre dens timing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Person, die diese Untertitel hinzugefügt hat, oder ein Admin kann das Timing ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the person who added this subtitle or an admin can change its timing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo quien añadió este subtítulo o un administrador puede cambiar sus tiempos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain tekstityksen lisännyt henkilö tai järjestelmänvalvoja voi muuttaa sen ajoitusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule la personne qui a ajouté ce sous-titre ou un administrateur peut modifier son minutage."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo osoba koja je dodala ove titlove ili administrator može promijeniti njihovo vrijeme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo chi ha aggiunto questo sottotitolo o un amministratore può modificarne i tempi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この字幕のタイミングを変更できるのは、字幕を追加した人または管理者のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 자막을 추가한 사용자나 관리자만 타이밍을 변경할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare personen som la til denne underteksten, eller en administrator kan endre timingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen wie deze ondertitel heeft toegevoegd of een beheerder kan de timing wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko osoba, która dodała te napisy, lub administrator może zmienić ich czas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só quem adicionou esta legenda ou um administrador pode mudar a sincronia dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменить тайминг этих субтитров может только тот, кто их добавил, или администратор."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast den som lade till undertexten eller en administratör kan ändra dess tidsinställning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu altyazının zamanlamasını yalnızca altyazıyı ekleyen kişi veya bir yönetici değiştirebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінити час цих субтитрів може лише той, хто їх додав, або адміністратор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有添加此字幕的人或管理员才能更改其时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有新增此字幕的使用者或管理員可以變更其時間。"
          }
        }
      }
    },
    "player.subtitleSync.forbiddenServer" : {
      "comment" : "Apple iOS/tvOS/macOS: replaces the timing actions after the server refused them. Shown under the selected subtitle's timing actions in the player: the iOS Audio & Subtitles sheet, the macOS player options panel and the tvOS info panel's Subtitles tab. Android phone and TV player subtitle timing: same text in place of the timing actions.",
