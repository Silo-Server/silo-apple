    "settingsManifest.ui.card_quick_actions.description" : {
      "comment" : "Help text under the ui.card_quick_actions setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختصارات المفضلة والمشاهدة التي تظهر على بطاقات الوسائط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кои преки пътища за любими и гледани се показват върху медийните карти."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
