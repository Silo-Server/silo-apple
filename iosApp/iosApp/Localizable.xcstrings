    "settings.profilePrefs.overrideDevice" : {
      "comment" : "Apple Settings > Subtitles (iPhone, iPad, Mac, Apple TV): note when this device's own setting for the profile wins over the profile's.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لهذا الجهاز، ضمن هذا الملف الشخصي، إعداد ترجمة أكثر تحديدًا. تُحدّث التغييرات هنا الإعداد الافتراضي للملف الشخصي، لكن إعداد الجهاز يظل مطبّقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat für dieses Profil eine spezifischere Untertitel-Einstellung. Änderungen hier aktualisieren den Profilstandard, die Einstellung des Geräts gilt aber weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device, for this profile, has a more specific subtitle setting. Changes here update the profile default, but the device override still applies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tiene, para este perfil, una configuración de subtítulos más específica. Los cambios aquí actualizan la configuración predeterminada del perfil, pero la del dispositivo sigue aplicándose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil a, pour ce profil, un paramètre de sous-titres plus spécifique. Les modifications effectuées ici mettent à jour la valeur par défaut du profil, mais le paramètre propre à l’appareil s’applique toujours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールには、このデバイス専用の字幕設定があります。ここでの変更はプロフィールのデフォルトを更新しますが、デバイスの設定が引き続き優先されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tem, para este perfil, uma configuração de legendas mais específica. As alterações aqui atualizam o padrão do perfil, mas a configuração do dispositivo continua valendo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备针对此个人资料有更具体的字幕设置。此处的更改会更新个人资料默认值，但设备覆盖设置仍然生效。"
          }
        }
      }
    },
    "settings.profilePrefs.overrideFamily" : {
