        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ποιες συντομεύσεις αγαπημένων και προβολής εμφανίζονται στις κάρτες πολυμέσων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
