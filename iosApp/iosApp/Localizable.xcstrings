          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o último perfil selecionado neste dispositivo. Um perfil protegido pode abrir novamente sem pedir o PIN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
