    "settings.about.creditTmdb" : {
      "comment" : "Apple Acknowledgements (all Apple apps): what Silo uses this outside service for, under its name or logo. Service: TMDB (The Movie Database). Requests is the name of Silo's media request section.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
