    "setup.cleartext.body" : {
      "comment" : "Roku and Android TV: body of the unencrypted-connection warning dialog. {host}: the server address the user is about to connect to. Apple (iPhone, iPad, Mac, Apple TV): same alert message.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُرسل كلمة المرور وما تشاهده دون تشفير إلى %1$@. لا تفعل ذلك إلا على شبكة تثق بها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паролата ви и това, което гледате, ще се изпращат без шифроване към %1$@. Правете това само в мрежа, на която имате доверие."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contrasenya i el que mires s’enviaran sense xifrar a %1$@. Fes-ho només en una xarxa de confiança."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše heslo a informace o tom, co sledujete, budou na server %1$@ odesílány nešifrovaně. Pokračujte jen v síti, které důvěřujete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din adgangskode og det, du ser, sendes ukrypteret til %1$@. Gør det kun på et netværk, du har tillid til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Passwort und was du ansiehst, werden unverschlüsselt an %1$@ gesendet. Tu das nur in einem Netzwerk, dem du vertraust."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός πρόσβασής σας και ό,τι παρακολουθείτε θα αποστέλλονται χωρίς κρυπτογράφηση στον διακομιστή %1$@. Κάντε το μόνο σε δίκτυο που εμπιστεύεστε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your password and what you watch will be sent unencrypted to %1$@. Only do this on a network you trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña y lo que ves se enviarán sin cifrar a %1$@. Hazlo solo en una red de confianza."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie parool ja teave selle kohta, mida vaatate, saadetakse krüpteerimata kujul aadressile %1$@. Tehke seda ainult usaldusväärses võrgus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salasanasi ja katselemasi sisältö lähetetään salaamattomina osoitteeseen %1$@. Tee näin vain verkossa, johon luotat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe et ce que vous regardez seront envoyés sans chiffrement à %1$@. Ne le faites que sur un réseau de confiance."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסיסמה שלך ופרטי הצפייה שלך יישלחו ללא הצפנה לשרת %1$@. יש לעשות זאת רק ברשת מהימנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका पासवर्ड और आपके देखे गए कॉन्टेंट की जानकारी बिना एन्क्रिप्शन के %1$@ को भेजे जाएँगे। ऐसा सिर्फ़ भरोसेमंद नेटवर्क पर ही करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša lozinka i ono što gledate bit će poslani nešifrirano na %1$@. Učinite to samo na mreži kojoj vjerujete."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelszava és a megtekintett tartalmak adatai titkosítás nélkül jutnak el ide: %1$@. Csak megbízható hálózaton tegye ezt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata sandi Anda dan apa yang Anda tonton akan dikirim tanpa enkripsi ke %1$@. Lakukan ini hanya di jaringan yang Anda percayai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua password e ciò che guardi verranno inviati senza crittografia a %1$@. Fallo solo su una rete di cui ti fidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードと視聴内容が暗号化されずに%1$@へ送信されます。信頼できるネットワークでのみ使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호와 시청 내용이 암호화되지 않은 채 %1$@ 서버로 전송돼요. 신뢰할 수 있는 네트워크에서만 사용하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsų slaptažodis ir tai, ką žiūrite, bus nešifruoti siunčiami į serverį %1$@. Tai darykite tik patikimame tinkle."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu parole un tas, ko skatāties, tiks nosūtīts nešifrētā veidā serverim %1$@. Dariet to tikai uzticamā tīklā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata laluan anda dan apa yang anda tonton akan dihantar tanpa penyulitan ke %1$@. Lakukan ini hanya pada rangkaian yang anda percayai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passordet ditt og det du ser på, blir sendt ukryptert til %1$@. Gjør dette bare på et nettverk du stoler på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wachtwoord en wat je kijkt worden onversleuteld naar %1$@ verstuurd. Doe dit alleen op een netwerk dat je vertrouwt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje hasło i informacje o tym, co oglądasz, zostaną wysłane bez szyfrowania na serwer %1$@. Rób to tylko w zaufanej sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua senha e o que você assiste serão enviados sem criptografia para %1$@. Faça isso apenas em uma rede confiável."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua palavra-passe e o que vê serão enviados sem encriptação para %1$@. Faça isto apenas numa rede em que confie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola dvs. și ce vizionați vor fi trimise necriptat către adresa %1$@. Faceți acest lucru doar într-o rețea în care aveți încredere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш пароль и сведения о том, что вы смотрите, будут отправлены на %1$@ без шифрования. Делайте это только в сети, которой доверяете."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše heslo a to, čo sledujete, sa odošlú bez šifrovania na adresu %1$@. Robte to iba v sieti, ktorej dôverujete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše geslo in podatki o tem, kaj gledate, bodo nešifrirano poslani na naslov %1$@. To storite samo v omrežju, ki mu zaupate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt lösenord och det du tittar på skickas okrypterat till %1$@. Gör det bara på ett nätverk du litar på."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รหัสผ่านและสิ่งที่คุณดูจะส่งไปยังเซิร์ฟเวอร์ %1$@ โดยไม่มีการเข้ารหัส ทำเช่นนี้บนเครือข่ายที่คุณเชื่อถือเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolanız ve izledikleriniz şifrelenmeden %1$@ adresine gönderilir. Bunu yalnızca güvendiğiniz bir ağda yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш пароль і те, що ви дивитеся, буде надіслано на %1$@ без шифрування. Робіть це лише в мережі, якій довіряєте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu và nội dung bạn xem sẽ được gửi đến %1$@ mà không được mã hóa. Chỉ làm điều này trên mạng bạn tin cậy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密码和观看内容将以未加密方式发送到%1$@。请仅在你信任的网络上这样做。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密碼和觀看內容將以未加密方式傳送至 %1$@。請只在你信任的網路上這麼做。"
          }
        }
      }
    },
