    "tvSignIn.appleTv.lead" : {
      "comment" : "Apple TV sign-in screen: paragraph under the headline beside the QR code. {page}: the server's activation address as typed, for example media.example.com/activate.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح الرمز بكاميرا هاتفك، أو انتقل إلى %1$@ وأدخله. وافق على هاتفك وسيسجّل Apple TV هذا الدخول تلقائيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte kód fotoaparátem telefonu nebo přejděte na %1$@ a zadejte ho. Schvalte přihlášení v telefonu a Apple TV se přihlásí automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan koden med telefonens kamera, eller gå til %1$@, og indtast den. Godkend på telefonen, så logger dette Apple TV ind af sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Code mit der Kamera deines Smartphones oder öffne %1$@ und gib ihn dort ein. Bestätige auf deinem Smartphone, dann meldet sich dieses Apple TV von selbst an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the code with your phone's camera, or go to %1$@ and enter it. Approve on your phone and this Apple TV signs in by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código con la cámara de tu teléfono o ve a %1$@ y escríbelo. Aprueba en tu teléfono y este Apple TV iniciará sesión solo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannaa koodi puhelimesi kameralla tai siirry osoitteeseen %1$@ ja syötä koodi. Hyväksy puhelimessa, niin tämä Apple TV kirjautuu sisään itsestään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code avec l’appareil photo de votre téléphone, ou accédez à %1$@ et saisissez-le. Approuvez sur votre téléphone et cette Apple TV se connecte d’elle-même."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenirajte kôd kamerom telefona ili otvorite %1$@ i unesite ga. Odobrite na telefonu i ovaj će se Apple TV sam prijaviti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra il codice con la fotocamera del telefono oppure vai su %1$@ e inseriscilo. Approva sul telefono e questa Apple TV accederà da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンのカメラでコードをスキャンするか、%1$@にアクセスしてコードを入力してください。スマートフォンで承認すると、このApple TVが自動的にサインインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰 카메라로 코드를 스캔하거나 %1$@에 접속해 코드를 입력하세요. 휴대폰에서 승인하면 이 Apple TV가 자동으로 로그인돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skann koden med telefonkameraet, eller gå til %1$@ og skriv den inn. Godkjenn på telefonen, så logger denne Apple TV-en på av seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan de code met de camera van je telefoon, of ga naar %1$@ en voer hem daar in. Keur het goed op je telefoon en deze Apple TV wordt vanzelf ingelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj kod aparatem telefonu albo otwórz stronę %1$@ i wpisz go. Zatwierdź na telefonie, a to Apple TV zaloguje się samo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie o código com a câmera do celular ou acesse %1$@ e digite-o. Aprove no celular e esta Apple TV entra sozinha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте код камерой телефона или откройте %1$@ и введите его. Подтвердите вход на телефоне, и этот Apple TV войдёт автоматически."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanna koden med telefonens kamera, eller gå till %1$@ och ange den. Godkänn på telefonen så loggar den här Apple TV:n in automatiskt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodu telefonunuzun kamerasıyla tarayın veya %1$@ adresine gidip kodu girin. Telefonunuzda onaylayın, bu Apple TV kendiliğinden oturum açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відскануйте код камерою телефона або перейдіть на %1$@ і введіть його. Підтвердьте вхід на телефоні, і цей Apple TV увійде автоматично."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手机相机扫描代码，或前往%1$@输入代码。在手机上批准后，这台Apple TV会自动登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手機相機掃描代碼，或前往 %1$@ 輸入代碼。在手機上核准後，這台 Apple TV 就會自動登入。"
          }
        }
      }
    },
    "tvSignIn.appleTv.leadNoPage" : {
      "comment" : "Apple TV sign-in screen: paragraph under the headline beside the QR code, before the server's activation address is known. Keep /activate unchanged.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح الرمز بكاميرا هاتفك، أو انتقل إلى صفحة /activate على خادمك وأدخله. وافق على هاتفك وسيسجّل Apple TV هذا الدخول تلقائيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte kód fotoaparátem telefonu nebo přejděte na stránku /activate vašeho serveru a zadejte ho. Schvalte přihlášení v telefonu a Apple TV se přihlásí automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan koden med telefonens kamera, eller gå til siden /activate på din server, og indtast den. Godkend på telefonen, så logger dette Apple TV ind af sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Code mit der Kamera deines Smartphones oder öffne die Seite /activate deines Servers und gib ihn dort ein. Bestätige auf deinem Smartphone, dann meldet sich dieses Apple TV von selbst an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the code with your phone's camera, or go to your server's /activate page and enter it. Approve on your phone and this Apple TV signs in by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código con la cámara de tu teléfono o ve a la página /activate de tu servidor y escríbelo. Aprueba en tu teléfono y este Apple TV iniciará sesión solo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannaa koodi puhelimesi kameralla tai siirry palvelimesi sivulle /activate ja syötä koodi. Hyväksy puhelimessa, niin tämä Apple TV kirjautuu sisään itsestään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code avec l’appareil photo de votre téléphone, ou accédez à la page /activate de votre serveur et saisissez-le. Approuvez sur votre téléphone et cette Apple TV se connecte d’elle-même."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenirajte kôd kamerom telefona ili otvorite stranicu /activate na svojem poslužitelju i unesite ga. Odobrite na telefonu i ovaj će se Apple TV sam prijaviti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra il codice con la fotocamera del telefono oppure vai alla pagina /activate del tuo server e inseriscilo. Approva sul telefono e questa Apple TV accederà da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンのカメラでコードをスキャンするか、サーバーの/activateページにアクセスしてコードを入力してください。スマートフォンで承認すると、このApple TVが自動的にサインインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰 카메라로 코드를 스캔하거나 서버의 /activate 페이지에 접속해 코드를 입력하세요. 휴대폰에서 승인하면 이 Apple TV가 자동으로 로그인돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skann koden med telefonkameraet, eller gå til /activate-siden på serveren din og skriv den inn. Godkjenn på telefonen, så logger denne Apple TV-en på av seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan de code met de camera van je telefoon, of ga naar de /activate-pagina van je server en voer hem daar in. Keur het goed op je telefoon en deze Apple TV wordt vanzelf ingelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj kod aparatem telefonu albo otwórz stronę /activate na swoim serwerze i wpisz go. Zatwierdź na telefonie, a to Apple TV zaloguje się samo."
