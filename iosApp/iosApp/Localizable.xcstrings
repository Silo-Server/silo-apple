    "tvPair.link.mismatch" : {
      "comment" : "Apple (iPhone, iPad) Sign in a TV from a link: error when the server answering at the link's address isn't the server the link names. \"Settings > Sign in a TV\" names the menu path in the app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشير هذا الرابط إلى خادم لا يستطيع هذا الجهاز تأكيده. أدخل رمز التلفزيون في الإعدادات ← تسجيل الدخول على تلفزيون بدلًا من ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkaz uvádí server, který toto zařízení nemůže ověřit. Zadejte místo toho kód televize v Nastavení > Přihlásit televizi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linket angiver en server, som denne enhed ikke kan bekræfte. Indtast i stedet tv’ets kode under Indstillinger > Log et tv ind."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link nennt einen Server, den dieses Gerät nicht bestätigen kann. Gib den Code des Fernsehers stattdessen unter Einstellungen > Fernseher anmelden ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That link names a server this device can't confirm. Enter the TV's code in Settings > Sign in a TV instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese enlace indica un servidor que este dispositivo no puede confirmar. Introduce el código de la TV en Configuración > Iniciar sesión en una TV."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkki viittaa palvelimeen, jota tämä laite ei voi vahvistaa. Syötä tv:n koodi sen sijaan kohdassa Asetukset > Tv:n kirjautuminen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien désigne un serveur que cet appareil ne peut pas confirmer. Saisissez plutôt le code de la TV dans Paramètres > Connecter une TV."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta poveznica navodi poslužitelj koji ovaj uređaj ne može potvrditi. Umjesto toga unesite kôd TV-a u Postavke > Prijava TV-a."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link indica un server che questo dispositivo non può confermare. Inserisci invece il codice della TV in Impostazioni > Accesso su una TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのリンクが示すサーバーをこのデバイスで確認できません。代わりに「設定」>「テレビをサインイン」でテレビのコードを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 링크에 지정된 서버를 이 기기에서 확인할 수 없어요. 대신 설정 > TV에 로그인에서 TV의 코드를 입력하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lenken peker til en server denne enheten ikke kan bekrefte. Skriv inn TV-ens kode under Innstillinger > Logg på en TV i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die link noemt een server die dit apparaat niet kan bevestigen. Voer de code van de tv in via Instellingen > Tv inloggen."
          }
        },
        "pl" : {
          "stringUnit" : {
