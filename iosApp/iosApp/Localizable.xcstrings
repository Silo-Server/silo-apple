    "errors.apple.accountStore.unreadable" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): error when the account stored on the device is damaged or from an unknown version, so the user must sign in again.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة بيانات تسجيل الدخول المحفوظة على هذا الجهاز. سجّل الدخول مرة أخرى."
