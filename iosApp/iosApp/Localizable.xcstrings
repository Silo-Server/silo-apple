      }
    },
    "diagnostics.notice.keptUncertain" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: the upload's result is unknown, so the report is kept but not sent again.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتُفظ بالتقرير؛ قد يكون لدى الخادم نسخة منه بالفعل، لذا لن يُرسل مرة أخرى."
          }
        },
        "de" : {
