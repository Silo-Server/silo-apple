    "pairing.error.unreachableApprove" : {
      "comment" : "Apple (iPhone, iPad) nearby-TV pairing card: error when the phone couldn't contact the server to approve. {server}: the server's name; {model}: the device model the person is holding, as the system names it (iPhone or iPad; not translated).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى %1$@ للموافقة على تسجيل الدخول. تحقق من اتصال جهاز %2$@ هذا وحاول مرة أخرى."
          }
