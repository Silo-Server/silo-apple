    "diagnostics.alwaysSend.confirmTitle" : {
      "comment" : "Apple (iPhone, iPad, Apple TV): title of the confirmation before crash reports are sent automatically, from Settings > Diagnostics > Crash Reports or the diagnostics prompt.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرسال تقارير الأعطال دائمًا؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždy odesílat zprávy o pádech?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send altid nedbrudsrapporter?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absturzberichte immer senden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always Send Crash Reports?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Enviar siempre los informes de fallos?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetetäänkö kaatumisraportit aina?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours envoyer les rapports de plantage ?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvijek slati izvješća o rušenju?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviare sempre i report sugli arresti anomali?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュレポートを常に送信しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충돌 보고서를 항상 보낼까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du alltid sende krasjrapporter?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crashrapporten altijd verzenden?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawsze wysyłać raporty o awariach?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre enviar relatórios de falhas?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда отправлять отчёты о сбоях?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skicka alltid kraschrapporter?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitlenme raporları her zaman gönderilsin mi?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завжди надсилати звіти про збої?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "始终发送崩溃报告？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要一律傳送當機報告嗎？"
          }
        }
      }
    },
    "diagnostics.alwaysSend.promptMessageMany" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad report review; Apple TV): message of the Always Send confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُرسل هذه التقارير وتقارير الأعطال المستقبلية لحساب الخادم هذا تلقائيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto zprávy a budoucí zprávy o pádech pro tento účet na serveru budou odesílány automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse rapporter og fremtidige nedbrudsrapporter for denne serverkonto sendes automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Berichte und künftige Absturzberichte für dieses Serverkonto werden automatisch gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These reports and future crash reports for this server account will be sent automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos informes y los futuros informes de fallos de esta cuenta del servidor se enviarán automáticamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä raportit ja tämän palvelintilin tulevat kaatumisraportit lähetetään automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces rapports et les futurs rapports de plantage de ce compte serveur seront envoyés automatiquement."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova izvješća i buduća izvješća o rušenju za ovaj račun na poslužitelju slat će se automatski."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi report e i futuri report sugli arresti anomali per questo account del server verranno inviati automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのレポートと、このサーバーアカウントの今後のクラッシュレポートは自動的に送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 보고서들과 이 서버 계정의 이후 충돌 보고서가 자동으로 전송돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse rapportene og fremtidige krasjrapporter for denne serverkontoen sendes automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze rapporten en toekomstige crashrapporten voor dit serveraccount worden automatisch verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te raporty i przyszłe raporty o awariach dla tego konta na serwerze będą wysyłane automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes relatórios e os futuros relatórios de falhas desta conta do servidor serão enviados automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти отчёты и будущие отчёты о сбоях для этого аккаунта на сервере будут отправляться автоматически."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa rapporter och framtida kraschrapporter för det här serverkontot skickas automatiskt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu raporlar ve bu sunucu hesabına ait gelecekteki kilitlenme raporları otomatik olarak gönderilecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці звіти й майбутні звіти про збої для цього облікового запису на сервері надсилатимуться автоматично."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些报告以及此服务器账户今后的崩溃报告将自动发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些報告以及此伺服器帳號日後的當機報告都會自動傳送。"
          }
        }
      }
    },
