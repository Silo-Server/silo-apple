    "diagnostics.alwaysSend.promptMessageMany" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad report review; Apple TV): message of the Always Send confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُرسل هذه التقارير وتقارير الأعطال المستقبلية لحساب الخادم هذا تلقائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тези отчети и бъдещите отчети за сривове за този акаунт на сървъра ще се изпращат автоматично."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquests informes i els futurs informes d’error d’aquest compte del servidor s’enviaran automàticament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto zprávy a budoucí zprávy o pádech pro tento účet na serveru budou odesílány automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse rapporter og fremtidige nedbrudsrapporter for denne serverkonto sendes automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Berichte und künftige Absturzberichte für dieses Serverkonto werden automatisch gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτές οι αναφορές και οι μελλοντικές αναφορές κατάρρευσης για αυτόν τον λογαριασμό διακομιστή θα αποστέλλονται αυτόματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These reports and future crash reports for this server account will be sent automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos informes y los futuros informes de fallos de esta cuenta del servidor se enviarán automáticamente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Need aruanded ja selle serverikonto edaspidised kokkujooksmise aruanded saadetakse automaatselt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä raportit ja tämän palvelintilin tulevat kaatumisraportit lähetetään automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces rapports et les futurs rapports de plantage de ce compte serveur seront envoyés automatiquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדוחות האלה ודוחות קריסה עתידיים לחשבון השרת הזה יישלחו אוטומטית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये रिपोर्टें और इस सर्वर खाते की आगे की क्रैश रिपोर्टें अपने-आप भेजी जाएँगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova izvješća i buduća izvješća o rušenju za ovaj račun na poslužitelju slat će se automatski."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Silo automatikusan elküldi ezeket a jelentéseket és az ehhez a szerverfiókhoz tartozó jövőbeli összeomlási jelentéseket."
          }
        },
        "id" : {
          "stringUnit" : {
