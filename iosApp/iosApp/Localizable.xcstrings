    "diagnostics.notice.keptUncertain" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: the upload's result is unknown, so the report is kept but not sent again.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتُفظ بالتقرير؛ قد يكون لدى الخادم نسخة منه بالفعل، لذا لن يُرسل مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpráva byla ponechána; server ji už možná má, proto nebude odeslána znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporten er gemt; serveren har den muligvis allerede, så den sendes ikke igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bericht aufbewahrt; der Server hat ihn möglicherweise bereits, daher wird er nicht erneut gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Report kept; the server may already have it, so it won't be sent again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conservó el informe; es posible que el servidor ya lo tenga, así que no se volverá a enviar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportti säilytettiin; palvelimella voi jo olla se, joten sitä ei lähetetä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapport conservé ; le serveur l’a peut-être déjà reçu, il ne sera donc pas renvoyé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvješće je zadržano; poslužitelj ga možda već ima pa se neće ponovno slati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Report conservato; il server potrebbe averlo già ricevuto, quindi non verrà inviato di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レポートを保持しました。サーバーがすでに受信している可能性があるため、再送信はしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보고서를 보관했어요. 서버에 이미 있을 수 있어서 다시 보내지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporten beholdes. Serveren kan allerede ha den, så den sendes ikke på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapport bewaard; de server heeft het mogelijk al, dus het wordt niet opnieuw verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raport zachowano; serwer mógł go już otrzymać, więc nie zostanie wysłany ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatório mantido; o servidor pode já tê-lo recebido, então ele não será enviado novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчёт сохранён; возможно, он уже есть на сервере, поэтому повторно отправляться не будет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporten sparades. Servern kan redan ha tagit emot den, så den skickas inte igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
