    "settingsManifest.ui.card_quick_actions_enabled.description" : {
      "comment" : "Help text under the ui.card_quick_actions_enabled setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض اختصارات المفضلة والمشاهدة المحددة على بطاقات الوسائط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показване на избраните преки пътища за любими и гледани върху медийните карти."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra les dreceres de preferits i de vist seleccionades a les targetes de contingut."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazovat vybrané zkratky pro oblíbené a zhlédnuté na kartách médií."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis de valgte genveje til favoritter og set på mediekort."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausgewählten Schnellzugriffe für Favoriten und Gesehen auf Medienkarten anzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση των επιλεγμένων συντομεύσεων αγαπημένων και προβολής στις κάρτες πολυμέσων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the selected favorite and watched shortcuts on media cards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra los accesos directos de favoritos y visto seleccionados en las tarjetas multimedia."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näitab meediakaartidel valitud lemmikute ja vaadatuse otseteid."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä valitut suosikki- ja katsottu-pikatoiminnot mediakorteissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher les raccourcis de favoris et de visionnage sélectionnés sur les cartes de médias."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת קיצורי הדרך שנבחרו של מועדפים וסימון צפייה בכרטיסי מדיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मीडिया कार्ड पर चुने गए पसंदीदा और देखा गया शॉर्टकट दिखाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje odabrane prečace za favorite i pogledano na medijskim karticama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiválasztott kedvenc- és megtekintésjelző gyorsgombok megjelenítése a médiakártyákon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan pintasan favorit dan sudah ditonton yang dipilih di kartu media."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra le scorciatoie scelte per preferiti e visti sulle schede dei contenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したお気に入りと視聴済みのショートカットをメディアカードに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 즐겨찾기 및 시청 완료 바로가기를 미디어 카드에 표시해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodyti pasirinktus mėgstamiausių ir peržiūrėtų sparčiuosius veiksmus ant medijos kortelių."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rādīt atlasītās izlases un skatīšanās īsinājumpogas uz multivides kartītēm."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan pintasan kegemaran dan ditonton yang dipilih pada kad media."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis de valgte snarveiene for favoritter og sett på mediekort."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon de gekozen snelkoppelingen voor favorieten en bekeken op mediakaarten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje wybrane skróty ulubionych i obejrzanych na kartach multimediów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra os atalhos de favoritos e de assistido selecionados nos cartões de mídia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar os atalhos de favoritos e de visto selecionados nos cartões de multimédia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișați pe cardurile media comenzile rapide selectate pentru favorite și vizionat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать выбранные быстрые кнопки избранного и отметки просмотра на карточках медиа."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje vybrané skratky pre obľúbené a pozreté na kartách médií."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži izbrane bližnjice za priljubljene in ogledane vsebine na karticah predstavnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa de valda genvägarna för favoriter och sett på mediekort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงทางลัดรายการโปรดและการดูแล้วที่เลือกไว้บนการ์ดสื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen favori ve izlendi kısayollarını medya kartlarında gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати вибрані швидкі дії для обраного й переглянутого на картках медіа."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị các lối tắt yêu thích và đã xem đã chọn trên thẻ nội dung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在媒体卡片上显示所选的收藏和已观看快捷操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
