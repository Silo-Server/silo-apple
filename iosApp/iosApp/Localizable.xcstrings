    "player.subtitleSync.actionNote" : {
      "comment" : "Apple iOS/tvOS/macOS: explains Sync to Audio for a stored subtitle. Shown under the selected subtitle's timing actions in the player: the iOS Audio & Subtitles sheet, the macOS player options panel and the tvOS info panel's Subtitles tab. Android phone and TV player subtitle timing: same note under the timing actions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطابق التوقيت مع الصوت لكل من يشاهد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sladí časování se zvukem pro všechny diváky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpasser timingen til lyden for alle, der ser med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt das Timing für alle, die zuschauen, an den Ton an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matches the timing to the audio for everyone watching."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta los tiempos al audio para todas las personas que lo ven."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovittaa ajoituksen ääneen kaikille katsojille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cale le minutage sur l’audio pour toutes les personnes qui regardent."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usklađuje vrijeme sa zvukom za sve gledatelje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allinea i tempi all’audio per chiunque stia guardando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴中の全員に対して、タイミングを音声に合わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시청하는 모든 사용자를 위해 타이밍을 오디오에 맞춰요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpasser timingen til lyden for alle som ser på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemt de timing af op de audio voor iedereen die kijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasowuje czas napisów do dźwięku dla wszystkich oglądających."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
