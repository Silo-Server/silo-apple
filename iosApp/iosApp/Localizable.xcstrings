    "signInTv.warning" : {
      "comment" : "Phone safety warning on the approval card: only approve a TV that the user can see and started themselves. Apple (iPhone, iPad): same warning on the Sign in a TV approval card and the nearby-TV pairing card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توافق إلا على تلفزيون موجود أمامك الآن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schvalujte jen televizi, kterou máte právě před sebou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkend kun et tv, der står foran dig lige nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genehmige nur einen Fernseher, der gerade vor dir steht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only approve a TV that's in front of you right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprueba solo una TV que tengas delante ahora mismo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyväksy vain tv, joka on juuri nyt edessäsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’approuvez qu’une TV qui se trouve devant vous en ce moment."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odobrite samo TV koji je upravo ispred vas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approva solo una TV che hai davanti in questo momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今目の前にあるテレビだけを承認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 눈앞에 있는 TV만 승인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkjenn bare en TV som står foran deg akkurat nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keur alleen een tv goed die nu voor je staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatwierdzaj tylko telewizor, który masz teraz przed sobą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só aprove uma TV que esteja na sua frente agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешайте вход только на телевизоре, который сейчас перед вами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkänn bara en tv som står framför dig just nu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca şu anda önünüzde olan bir TV’yi onaylayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Схвалюйте лише телевізор, який зараз перед вами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅批准此刻就在你面前的电视。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只核准此刻就在你面前的電視。"
          }
        }
      }
    },
    "status.errorGeneric" : {
      "comment" : "Android phone and TV: generic error message when loading or an action failed. Apple (iPhone, iPad, Mac, Apple TV): heading of the full-screen error when no more specific heading applies.",
