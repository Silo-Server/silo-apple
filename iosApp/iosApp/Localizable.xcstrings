          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til favoritter fra en hvilken som helst detaljside, så vises de her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg favorieten toe vanaf een willekeurige detailpagina en ze verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj ulubione na dowolnej stronie szczegółów, a pojawią się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione favoritos em qualquer página de detalhes e eles aparecerão aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione favoritos a partir de qualquer página de detalhes e vão aparecer aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
