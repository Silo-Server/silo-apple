    "shell.signOut.titleNamed" : {
      "comment" : "Sign-out confirmation dialog title phrased as a question, on Roku and Android TV. {account}: the account username; {server}: the server name. Apple (iPhone, iPad, Mac, Apple TV): same title of the sign-out confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد تسجيل الخروج من %1$@ على %2$@؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да се излезе ли от акаунта %1$@ в сървъра %2$@?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols tancar la sessió del compte %1$@ al servidor %2$@?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odhlásit účet %1$@ na serveru %2$@?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ud af %1$@ på %2$@?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ auf %2$@ abmelden?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποσύνδεση του λογαριασμού %1$@ από τον διακομιστή %2$@;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign out of %1$@ on %2$@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cerrar sesión de %1$@ en %2$@?"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas logida välja kontolt %1$@ serveris %2$@?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjataanko tili %1$@ ulos palvelimelta %2$@?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se déconnecter de %1$@ sur %2$@ ?"
          }
        },
        "he" : {
