    "settings.quality.cellularFooter" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad): footer under the Cellular Quality picker. Android phone Settings > Playback: footer under the Cellular quality picker.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم على بيانات الهاتف المحمول والشبكات محدودة البيانات، مثل نقطة اتصال الهاتف."
          }
