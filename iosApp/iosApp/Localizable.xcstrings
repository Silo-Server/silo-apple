        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรื่องที่ครบรอบปีสำคัญของการออกฉายในเดือนนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
