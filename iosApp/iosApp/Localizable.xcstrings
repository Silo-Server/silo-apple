    "settings.general.themeMusicFooterTv" : {
      "comment" : "Apple TV Settings > General > Theme Music: explanation under the switches.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل الأغنية الرئيسية للعنوان من مكتبتك أثناء فتح صفحته. يؤثر في هذا Apple TV فقط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Възпроизвежда музикалната тема на заглавието от вашата библиотека, докато страницата му е отворена. Засяга само това Apple TV."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodueix la sintonia d’un títol de la teva biblioteca mentre la seva pàgina està oberta. Només afecta aquest Apple TV."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrávat ústřední melodii titulu z vaší knihovny, dokud je otevřená jeho stránka. Platí jen pro toto zařízení Apple TV."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil en titels temasang fra dit bibliotek, mens dens side er åben. Gælder kun dette Apple TV."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt die Titelmusik eines Titels aus deiner Mediathek, solange seine Seite geöffnet ist. Gilt nur für dieses Apple TV."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπαραγωγή του μουσικού θέματος ενός τίτλου από τη βιβλιοθήκη σας όσο η σελίδα του είναι ανοιχτή. Επηρεάζει μόνο αυτό το Apple TV."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play a title's theme song from your library while its page is open. Only affects this Apple TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce el tema musical de un título desde tu biblioteca mientras su página está abierta. Solo afecta a este Apple TV."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui pealkirja leht on avatud, esitatakse teie meediakogust selle tunnuslugu. Mõjutab ainult seda Apple TV-d."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistaa kohteen tunnusmusiikin kirjastostasi, kun sen sivu on auki. Koskee vain tätä Apple TV:tä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit le thème musical d’un titre depuis votre bibliothèque tant que sa page est ouverte. S’applique uniquement à cette Apple TV."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעלת שיר הנושא של פריט מהספרייה שלך כשהדף שלו פתוח. חל רק על ה-Apple TV הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टाइटल का पेज खुला रहने पर आपकी लाइब्रेरी से उसका थीम सॉन्ग चलाएँ। इसका असर सिर्फ़ इस Apple TV पर पड़ता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducira tematsku pjesmu naslova iz vaše medijateke dok je njegova stranica otvorena. Utječe samo na ovaj Apple TV."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejátssza az elem főcímzenéjét a könyvtárból, amíg az oldala nyitva van. Csak erre az Apple TV-re vonatkozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar lagu tema judul dari perpustakaan Anda selama halamannya terbuka. Hanya berlaku untuk Apple TV ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduci la sigla di un titolo dalla tua libreria mentre la sua pagina è aperta. Vale solo per questa Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作品のページを開いている間、ライブラリにあるテーマ曲を再生します。このApple TVにのみ適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작품 페이지가 열려 있는 동안 라이브러리에 있는 테마 음악을 재생해요. 이 Apple TV에만 적용돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leisti pavadinimo teminę melodiją iš jūsų bibliotekos, kol atidarytas jo puslapis. Taikoma tik šiam „Apple TV“ įrenginiui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atskaņot vienuma tēmas dziesmu no jūsu bibliotēkas, kamēr ir atvērta tā lapa. Attiecas tikai uz šo Apple TV ierīci."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mainkan lagu tema sesuatu tajuk daripada pustaka anda semasa halamannya dibuka. Hanya mempengaruhi Apple TV ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spill av temasangen til en tittel fra biblioteket ditt mens siden er åpen. Gjelder bare denne Apple TV-en."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel het themanummer van een titel uit je bibliotheek af zolang de pagina open is. Geldt alleen voor deze Apple TV."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarza motyw muzyczny tytułu z twojej biblioteki, gdy jego strona jest otwarta. Dotyczy tylko tego Apple TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca a música tema de um título da sua biblioteca enquanto a página dele estiver aberta. Afeta só esta Apple TV."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduzir o tema musical de um título a partir da sua biblioteca enquanto a página estiver aberta. Só afeta esta Apple TV."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redați melodia temă a unui titlu din biblioteca dvs. cât timp pagina acestuia este deschisă. Afectează doar acest Apple TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводить музыкальную тему из вашей медиатеки, пока открыта страница фильма или сериала. Действует только на этом Apple TV."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prehráva znelku titulu z vašej knižnice, kým je otvorená jeho stránka. Platí len pre toto zariadenie Apple TV."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predvaja tematsko glasbo naslova iz vaše knjižnice, dokler je njegova stran odprta. Vpliva samo na ta Apple TV."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela en titels ledmotiv från ditt bibliotek medan dess sida är öppen. Gäller bara denna Apple TV."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล่นเพลงประกอบของรายการจากคลังขณะที่หน้าของรายการนั้นเปิดอยู่ มีผลกับ Apple TV เครื่องนี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayfası açıkken bir içeriğin tema müziğini kitaplığınızdan çalar. Yalnızca bu Apple TV’yi etkiler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відтворювати музичну тему твору з вашої бібліотеки, поки відкрита його сторінка. Діє лише на цьому Apple TV."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phát nhạc chủ đề của nội dung từ thư viện của bạn khi trang của nội dung đó đang mở. Chỉ ảnh hưởng đến Apple TV này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开作品页面时，播放媒体库中该作品的主题曲。仅影响这台Apple TV。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟作品頁面時，從你的媒體庫播放該作品的主題曲。只會影響這台 Apple TV。"
          }
        }
      }
    },
