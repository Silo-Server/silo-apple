    "settingsManifest.playback.audio_language.description" : {
      "comment" : "Help text under the playback.audio_language setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر اللغة المنطوقة التي يفضّلها Silo أولًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете кой говорим език Silo да предпочита първо."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria quin idioma parlat ha de preferir Silo en primer lloc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
