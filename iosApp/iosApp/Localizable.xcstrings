    "downloads.monitorList.emptyBody" : {
      "comment" : "Apple iOS/macOS: Monitored screen (series this device downloads automatically), opened from the Downloads tab; empty-state text. {device}: the device model name from the system, such as iPhone, iPad or Mac.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح مسلسلًا، واضغط على «تنزيل»، واختر «مراقبة» للحصول على الحلقات الجديدة على جهاز %1$@ هذا تلقائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отворете сериал, докоснете „Изтегляне“ и изберете „Наблюдение“, за да получавате новите епизоди автоматично на това устройство (%1$@)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre una sèrie, toca Baixa i tria Supervisa per obtenir episodis nous automàticament en aquest %1$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete seriál, klepněte na Stáhnout a vyberte Sledovat. Nové díly se pak budou do zařízení %1$@ stahovat automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn en serie, tryk på Download, og vælg Overvåg for automatisk at få nye afsnit på denne %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne eine Serie, tippe auf „Download“ und wähle „Beobachten“, um neue Folgen automatisch auf diesem %1$@ zu erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε μια σειρά, πατήστε «Λήψη» και επιλέξτε «Παρακολούθηση» για να λαμβάνετε αυτόματα νέα επεισόδια σε αυτή τη συσκευή %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a series, tap Download, and choose Monitor to get new episodes on this %1$@ automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre una serie, toca Descargar y elige Supervisar para recibir episodios nuevos en este %1$@ automáticamente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avage sari, puudutage nuppu „Laadi alla“ ja valige „Jälgi“, et saada uued osad automaatselt seadmesse %1$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa sarja, napauta Lataa ja valitse Seuraa, niin uudet jaksot latautuvat automaattisesti laitteeseen %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez une série, touchez Télécharger, puis choisissez Surveiller pour recevoir automatiquement les nouveaux épisodes sur votre %1$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לפתוח סדרה, להקיש על ”הורדה” ולבחור ”מעקב” כדי לקבל פרקים חדשים במכשיר %1$@ הזה באופן אוטומטי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस %1$@ पर नए एपिसोड अपने-आप पाने के लिए कोई सीरीज़ खोलें, “डाउनलोड” पर टैप करें और “मॉनिटर करें” चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite seriju, dodirnite Preuzmi i odaberite Prati kako biste automatski dobivali nove epizode na ovaj uređaj (%1$@)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyisson meg egy sorozatot, koppintson a Letöltés gombra, és válassza a Figyelés lehetőséget, hogy az új epizódok automatikusan letöltődjenek erre az eszközre (%1$@)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka serial, ketuk Unduh, lalu pilih Pantau untuk mendapatkan episode baru di %1$@ ini secara otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri una serie, tocca Scarica e scegli Monitora per ricevere automaticamente i nuovi episodi su questo %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シリーズを開いて「ダウンロード」をタップし、「監視」を選択すると、この%1$@に新しいエピソードが自動でダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시리즈를 열고 다운로드를 탭한 다음 모니터링을 선택하면 이 %1$@에서 새 에피소드를 자동으로 받을 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atidarykite serialą, palieskite „Atsisiųsti“ ir pasirinkite „Stebėti“, kad nauji epizodai būtų automatiškai atsisiunčiami į šį „%1$@“ įrenginį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atveriet seriālu, pieskarieties pogai „Lejupielādēt” un atlasiet „Uzraudzīt”, lai jaunās epizodes automātiski tiktu saņemtas šajā ierīcē %1$@."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka siri, ketik Muat turun dan pilih Pantau untuk mendapatkan episod baharu pada %1$@ ini secara automatik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne en serie, trykk på Last ned og velg Overvåk for å få nye episoder automatisk på denne %1$@-en."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open een serie, tik op Downloaden en kies Volgen om nieuwe afleveringen automatisch op deze %1$@ te krijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz serial, stuknij Pobierz i wybierz Monitoruj, aby nowe odcinki automatycznie trafiały na urządzenie %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra uma série, toque em Baixar e escolha Monitorar para receber novos episódios neste %1$@ automaticamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra uma série, toque em Transferir e escolha Monitorizar para receber automaticamente novos episódios neste dispositivo (%1$@)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deschideți un serial, atingeți „Descărcați” și alegeți „Monitorizați” pentru a primi automat episoade noi pe acest dispozitiv %1$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте сериал, коснитесь «Скачать» и выберите «Отслеживать», чтобы новые серии автоматически появлялись на устройстве %1$@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorte seriál, ťuknite na Stiahnuť a vyberte Sledovať. Nové epizódy sa potom budú automaticky sťahovať do tohto zariadenia %1$@."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odprite serijo, tapnite Prenesi in izberite Spremljaj, da se bodo nove epizode samodejno prenašale v napravo %1$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna en serie, tryck på Ladda ned och välj Bevaka för att få nya avsnitt automatiskt på %1$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดซีรีส์ แตะ “ดาวน์โหลด” แล้วเลือก “ติดตาม” เพื่อรับตอนใหม่ใน %1$@ เครื่องนี้โดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bölümleri bu %1$@ cihazına otomatik olarak almak için bir dizi açın, İndir düğmesine dokunun ve Takip et seçeneğini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте серіал, торкніться «Завантажити» й виберіть «Відстежувати», щоб нові епізоди автоматично з’являлися на %1$@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở một phim bộ, chạm vào Tải xuống và chọn Theo dõi để tự động nhận tập mới trên %1$@ này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开剧集，轻点“下载”，然后选择“监控”，即可在此%1$@上自动获取新集。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟影集，點一下「下載」，然後選擇「監控」，即可在這部 %1$@ 上自動取得新集數。"
          }
        }
      }
    },
