    "tvSignIn.form.providerHint" : {
      "comment" : "Android TV hint under the password form for users who normally use an external sign-in. {provider}: the provider name. Apple TV: same hint under the password form.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كنت تسجّل الدخول باستخدام %1$@، فاستخدم هاتفك بدلًا من ذلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако влизате с %1$@, използвайте телефона си."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fas servir %1$@ per iniciar la sessió, utilitza el telèfon."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud se přihlašujete přes %1$@, použijte raději telefon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du logger ind med %1$@, så brug din telefon i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dich mit %1$@ anmeldest, verwende stattdessen dein Smartphone."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν συνδέεστε μέσω %1$@, χρησιμοποιήστε το τηλέφωνό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you sign in with %1$@, use your phone instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si inicias sesión con %1$@, usa tu teléfono."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui kasutate sisselogimiseks teenust %1$@, kasutage hoopis telefoni."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos kirjaudut palvelulla %1$@, käytä sen sijaan puhelinta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous vous connectez avec %1$@, utilisez plutôt votre téléphone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם ההתחברות שלך היא דרך %1$@, יש להשתמש בטלפון במקום זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ से साइन इन करने पर इसके बजाय अपना फ़ोन इस्तेमाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako se prijavljujete putem usluge %1$@, upotrijebite telefon."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a következővel jelentkezik be: %1$@, használja inkább a telefonját."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda masuk dengan %1$@, gunakan ponsel Anda sebagai gantinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se accedi con %1$@, usa invece il telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@でサインインしている場合は、代わりにスマートフォンを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 계정으로 로그인한다면 대신 휴대폰을 사용하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jei jungiatės per „%1$@“, naudokite telefoną."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja pierakstāties ar %1$@, izmantojiet tālruni."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika anda log masuk dengan %1$@, gunakan telefon anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du logger på med %1$@, bruk telefonen i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log je in met %1$@? Gebruik dan je telefoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli logujesz się przez usługę %1$@, użyj telefonu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você entra com %1$@, use o celular."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se inicia sessão com %1$@, use o telemóvel."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă vă conectați cu %1$@, folosiți telefonul în schimb."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы входите через %1$@, используйте телефон."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak sa prihlasujete cez službu %1$@, použite radšej telefón."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če se prijavljate prek ponudnika %1$@, raje uporabite telefon."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du loggar in med %1$@, använd telefonen i stället."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากคุณลงชื่อเข้าใช้ด้วย %1$@ โปรดใช้โทรศัพท์แทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ile oturum açıyorsanız bunun yerine telefonunuzu kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви входите через %1$@, скористайтеся телефоном."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn đăng nhập bằng %1$@, hãy dùng điện thoại thay thế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你使用%1$@登录，请改用手机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你是使用 %1$@ 登入，請改用手機。"
          }
        }
      }
    },
