    "watchParty.hint.notReady.moreNames" : {
      "comment" : "Roku: hint line shown to the host when three or more members are not ready. {first}: name of one such member; {second}: name of another; 'and others' covers the rest. Apple (iPhone, iPad, Apple TV): same hint under the lobby's buttons. Android phone and TV Watch Party lobby: same line under the host's buttons. 1 and 2: the first two guests' names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعلن %1$@ و%2$@ وآخرون جاهزيتهم. لا يزال بإمكانك البدء."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ и други не потвърдиха готовност. Все пак можете да започнете."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ i altres persones no han indicat que estan a punt. Pots iniciar igualment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uživatelé %1$@, %2$@ a další ještě nejsou připraveni. Přesto můžete začít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ og andre har ikke meldt sig klar. Du kan stadig starte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ und weitere sind noch nicht bereit. Du kannst trotzdem starten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι χρήστες %1$@, %2$@ και άλλοι δεν έχουν δηλώσει ετοιμότητα. Μπορείτε πάντως να ξεκινήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ and %2$@ and others haven't marked ready. You can still start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ y otras personas todavía no han marcado “Listo”. Aun así puedes iniciar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ ja teised pole end valmis märkinud. Saate siiski alustada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ ja muut eivät ole merkinneet olevansa valmiina. Voit silti aloittaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ et d’autres n’ont pas signalé leur disponibilité. Vous pouvez quand même lancer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המשתתפים %1$@, %2$@ ואחרים עדיין לא סימנו מוכנות. אפשר להתחיל בכל זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ और अन्य लोगों ने खुद को तैयार मार्क नहीं किया है। फिर भी शुरू किया जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osobe %1$@, %2$@ i ostale još nisu označile da su spremne. Svejedno možete pokrenuti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ és mások még nem jelezték, hogy készen állnak. Ettől még elindíthatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@, dan lainnya belum menandai siap. Anda tetap dapat memulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ e altri ospiti non hanno ancora confermato. Puoi avviare comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、%2$@ほか数名が準備完了にしていません。このまま開始することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@님, %2$@님 외 여러 명이 아직 준비 완료를 표시하지 않았어요. 그래도 시작할 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ ir kiti dar nepažymėjo pasirengimo. Vis tiek galite pradėti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ un citi vēl neatzīmēja gatavību. Jūs tomēr varat sākt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dan %2$@ serta yang lain belum menandakan sedia. Anda masih boleh memulakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ og andre har ikke markert seg som klare. Du kan likevel starte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ en anderen hebben zich niet klaar gemeld. Je kunt toch starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ i inne osoby nie zgłaszają gotowości. Możesz mimo to zacząć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ e outras pessoas ainda não marcaram “Pronto”. Mesmo assim, você pode iniciar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ e outros ainda não indicaram que estão a postos. Pode iniciar na mesma."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ și alte persoane nu au confirmat că sunt gata. Puteți porni oricum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не готовы: %1$@, %2$@ и другие. Вы всё равно можете начать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostia %1$@, %2$@ a ďalší zatiaľ nepotvrdili pripravenosť. Aj tak môžete začať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostje %1$@, %2$@ in drugi še niso označili, da so pripravljeni. Še vedno lahko začnete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ och andra har inte markerat att de är redo. Du kan ändå starta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ และคนอื่น ๆ ยังไม่ได้แจ้งว่าพร้อม คุณยังเริ่มได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ ve diğerleri hazır olduğunu belirtmedi. Yine de başlatabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ та інші: готовність ще не позначено. Ви все одно можете почати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ và những người khác chưa đánh dấu sẵn sàng. Bạn vẫn có thể bắt đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、%2$@等人尚未标记为准备就绪。你仍可以开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、%2$@ 和其他人尚未標記為準備就緒。你仍然可以開始。"
          }
        }
      }
    },
