      }
    },
    "signIn.forgot.sentNote" : {
      "comment" : "Apple (iPhone, iPad, Mac): small note under Check your email after a reset link was requested.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يصلك شيء بعد بضع دقائق؟ تحقق من مجلد الرسائل غير المرغوب فيها، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach ein paar Minuten noch nichts angekommen? Sieh in deinem Spam-Ordner nach und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing after a few minutes? Check your spam folder, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿No llegó nada tras unos minutos? Revisa la carpeta de spam y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien reçu après quelques minutes ? Vérifiez votre dossier de spam, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数分経っても届きませんか？迷惑メールフォルダを確認してから、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
