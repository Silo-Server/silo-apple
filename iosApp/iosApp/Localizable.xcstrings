          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी आइटम को यहाँ जोड़ने के लिए उसके दिल वाले आइकन पर टैप करें"
          }
        },
        "hr" : {
