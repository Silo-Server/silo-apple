            "state" : "translated",
            "value" : "Nobody has voted yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie ha votado todavía."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keegi pole veel hääletanud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukaan ei ole vielä äänestänyt."
          }
        },
        "fr" : {
