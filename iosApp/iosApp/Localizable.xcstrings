    "tvSignIn.error.localLoginDisabled" : {
      "comment" : "Android TV error when the server has turned off password sign-in. Apple TV: same password sign-in error.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل الدخول بكلمة المرور معطّل على هذا الخادم. استخدم هاتفك بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung mit Passwort ist auf diesem Server deaktiviert. Verwende stattdessen dein Smartphone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Password sign-in is turned off on this server. Use your phone instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión con contraseña está desactivado en este servidor. Usa tu teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion par mot de passe est désactivée sur ce serveur. Utilisez plutôt votre téléphone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーではパスワードでのサインインがオフになっています。代わりにスマートフォンを使用してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login com senha está desativado neste servidor. Use o celular."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器已关闭密码登录。请改用手机。"
          }
        }
      }
    },
    "tvSignIn.error.networkIdentityRequired" : {
      "comment" : "Android TV and phone sign-in error telling the user to open the server through a network provider's address. {provider}: the network provider's name, such as Tailscale. Apple (iPhone, iPad, Mac, Apple TV): same network sign-in error.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح هذا الخادم عبر عنوان %1$@ الخاص به لتسجيل الدخول بهذه الطريقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne diesen Server über seine %1$@-Adresse, um dich auf diese Weise anzumelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open this server at its %1$@ address to sign in this way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre este servidor en su dirección de %1$@ para iniciar sesión de esta forma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez ce serveur à son adresse %1$@ pour vous connecter de cette façon."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この方法でサインインするには、%1$@のアドレスでこのサーバーを開いてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra este servidor pelo endereço de %1$@ para entrar dessa forma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请通过%1$@地址打开此服务器，才能以这种方式登录。"
          }
        }
      }
    },
    "tvSignIn.error.networkNotPermitted" : {
      "comment" : "Android TV sign-in error when the network provider blocks this device from the server. {provider}: the network provider name. Apple (iPhone, iPad, Mac, Apple TV): same network sign-in error, also in Settings › Sign-in.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسمح %1$@ لهذا الجهاز بتسجيل الدخول إلى هذا الخادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
