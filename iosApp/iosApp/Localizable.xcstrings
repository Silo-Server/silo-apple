        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkau ke belakang sejauh ini apabila menyambung semula item yang separa ditonton, untuk mengingatkan semula konteks. 0 mematikannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spol så langt tilbake når du gjenopptar noe du har sett delvis, så du får med deg sammenhengen. 0 slår det av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoel zo ver terug bij het hervatten van een deels bekeken item, zodat je weer in het verhaal komt. 0 schakelt dit uit."
