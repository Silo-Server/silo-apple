    "error.idempotency_conflict" : {
      "comment" : "Error message shown when the server answers with the v2 problem type `idempotency_conflict` (server title: \"Idempotency conflict\"). Clients show it instead of the server's English detail in a translated interface, so it must make sense on its own, without the request's specifics.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سبق إرسال طلب مختلف بالمعرّف نفسه. حاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiný požadavek se stejným ID už byl odeslán. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden forespørgsel med samme id er allerede sendt. Prøv igen."
