    "diagnostics.prompt.manualCount" : {
      "comment" : "Apple diagnostics prompt (iPhone, iPad, Apple TV), shown after a problem report is captured: message when several manually captured reports are waiting. {count}: how many (2 or more in practice).",
      "extractionState" : "manual",
