    "detail.translation.translated" : {
      "comment" : "Small status note saying the shown text was machine-translated by AI: on the Roku and Apple title pages, on Apple episode cards, and on Android phone and TV wherever text is machine-translated. On Android it is also the accessibility label of the compact translate icon.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
