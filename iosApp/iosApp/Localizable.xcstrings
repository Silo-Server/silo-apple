    "settings.quality.footerUpTo" : {
      "comment" : "Apple Settings > Playback (iPhone, iPad, Mac) and Apple TV Settings > Playback: footer under Resolution when a maximum resolution is chosen. {resolution}: the chosen resolution's label, such as 1080p. Android phone and TV Settings > Playback: the same footer, under the Resolution and Maximum Bitrate pickers.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُشغّل الملف الأصلي حتى %1$@. تُحوَّل الملفات الأكبر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Възпроизвежда оригиналния файл до %1$@. По-големите файлове се преобразуват."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodueix el fitxer original fins a %1$@. Els fitxers més grans es converteixen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrává původní soubor do rozlišení %1$@. Větší soubory se převedou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspiller den originale fil op til %1$@. Større filer konverteres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt die Originaldatei bis %1$@ ab. Größere Dateien werden konvertiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπαράγει το αρχικό αρχείο έως %1$@. Τα μεγαλύτερα αρχεία μετατρέπονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays the original file up to %1$@. Larger files are converted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce el archivo original hasta %1$@. Los archivos más grandes se convierten."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esitab originaalfaili kuni eraldusvõimeni %1$@. Suuremad failid teisendatakse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistaa alkuperäisen tiedoston tarkkuuteen %1$@ asti. Suuremmat tiedostot muunnetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit le fichier original jusqu’à %1$@. Les fichiers plus grands sont convertis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקובץ המקורי מופעל עד %1$@. קבצים גדולים יותר עוברים המרת קידוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ तक की ओरिजिनल फ़ाइल चलाता है। इससे बड़ी फ़ाइलें कन्वर्ट की जाती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
