        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο κωδικός ανήκει στον διακομιστή %1$@, στον οποίο δεν έχετε συνδεθεί εδώ. Συνδεθείτε για να εγκρίνετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This code belongs to %1$@, and you're not signed in to it here. Sign in to approve."
