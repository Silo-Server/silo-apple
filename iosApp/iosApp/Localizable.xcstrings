    "settings.interface.deviceOverrideFooter" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac): explanation under the button that drops this device's older own card settings. Like-family devices are devices of the same kind (phones, tablets or computers).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسح تجاوز الجهاز يجعل عناصر التحكم أدناه تنطبق على جميع الأجهزة من الفئة نفسها على هذا الملف الشخصي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изчистването на собствените настройки на устройството прилага опциите по-долу за всички устройства от същия вид в този профил."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si esborres la configuració pròpia del dispositiu, els controls de sota s’aplicaran a tots els dispositius de la mateixa família en aquest perfil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po vymazání vlastního nastavení zařízení budou ovládací prvky níže platit pro všechna zařízení stejného typu v tomto profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når enhedens egne indstillinger ryddes, gælder indstillingerne nedenfor for alle enheder af samme type på denne profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du die Geräteeinstellungen entfernst, gelten die Optionen unten für alle Geräte derselben Art in diesem Profil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με την εκκαθάριση των ρυθμίσεων της συσκευής, οι παρακάτω επιλογές ισχύουν για όλες τις συσκευές του ίδιου τύπου σε αυτό το προφίλ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clearing the device override makes the controls below apply to all like-family devices on this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al quitar la configuración propia del dispositivo, los controles de abajo se aplican a todos los dispositivos similares de este perfil."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui seadme alistus tühjendada, kehtivad allolevad juhtelemendid selle profiili kõigis sama tüüpi seadmetes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun laitekohtainen ohitus poistetaan, alla olevat asetukset koskevat kaikkia tämän profiilin samantyyppisiä laitteita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacer les paramètres propres à cet appareil applique les options ci-dessous à tous les appareils du même type sur ce profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניקוי ההגדרות הייעודיות למכשיר יחיל את האפשרויות שלמטה על כל המכשירים מאותו סוג בפרופיל הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
