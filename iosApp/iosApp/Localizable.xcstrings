    "settings.interface.deviceOverride" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac): notice when this device still has its own card settings from an older version, which win over the settings synced across devices of its kind.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لدى هذا الجهاز إعدادات واجهة قديمة خاصة به تتجاوز مزامنة فئة الأجهزة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat ältere gerätespezifische Oberflächeneinstellungen, die die Synchronisierung der Gerätefamilie überschreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device has older device-specific interface settings that override family sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tiene una configuración de interfaz propia más antigua que prevalece sobre la sincronización con dispositivos similares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil possède d’anciens paramètres d’interface qui lui sont propres et qui prévalent sur la synchronisation entre appareils du même type."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスには、同じ種類のデバイス間の同期より優先される、以前のデバイス固有のインターフェース設定があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tem configurações de interface antigas, específicas dele, que se sobrepõem à sincronização da família de dispositivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备有旧版的设备专属界面设置，会覆盖同类设备的同步设置。"
          }
        }
      }
    },
    "settings.interface.deviceOverrideFooter" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac): explanation under the button that drops this device's older own card settings. Like-family devices are devices of the same kind (phones, tablets or computers).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسح تجاوز الجهاز يجعل عناصر التحكم أدناه تنطبق على جميع الأجهزة من الفئة نفسها على هذا الملف الشخصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du die Geräteeinstellungen entfernst, gelten die Optionen unten für alle Geräte derselben Art in diesem Profil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clearing the device override makes the controls below apply to all like-family devices on this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al quitar la configuración propia del dispositivo, los controles de abajo se aplican a todos los dispositivos similares de este perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacer les paramètres propres à cet appareil applique les options ci-dessous à tous les appareils du même type sur ce profil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス固有の設定をクリアすると、以下の設定がこのプロフィールの同じ種類のすべてのデバイスに適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpar a substituição deste dispositivo faz os controles abaixo se aplicarem a todos os dispositivos da mesma família neste perfil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除设备覆盖后，下方的设置将应用到此个人资料中的所有同类设备。"
          }
        }
      }
    },
    "settings.interface.loopThemeMusicSubtitle" : {
      "comment" : "Apple Settings > Interface > Theme Music and Apple TV Settings > General > Theme Music: description of the Loop Theme Music switch (VoiceOver hint on iPhone, iPad and Apple TV; shown under the switch on Mac).",
