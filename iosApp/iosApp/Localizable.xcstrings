    "settings.interface.titleArtAllOff" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac) > Title Pages: note while Apply to All Devices is on and Show Title Art is off. Title art is logo artwork used as a title's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شعار العنوان معطّل على كل جهاز مسجّل الدخول إلى هذا الملف الشخصي. تغييره هنا يغيّره في كل مكان."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Графичното заглавие е изключено на всички устройства с вход в този профил. Промяната тук важи навсякъде."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’art del títol està desactivat a tots els dispositius amb la sessió iniciada en aquest perfil. Si el canvies aquí, canvia a tot arreu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logo titulu je vypnuté na všech zařízeních přihlášených k tomuto profilu. Změna zde se projeví všude."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titelgrafik er slået fra på alle enheder, der er logget ind på denne profil. Ændrer du det her, ændres det overalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Titelgrafik ist auf allen Geräten aus, die mit diesem Profil angemeldet sind. Eine Änderung hier gilt überall."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εικόνα τίτλου είναι απενεργοποιημένη σε κάθε συσκευή που είναι συνδεδεμένη σε αυτό το προφίλ. Αν την αλλάξετε εδώ, αλλάζει παντού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Title art is off on every device signed into this profile. Changing it here changes it everywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El arte del título está desactivado en todos los dispositivos con sesión iniciada en este perfil. Si lo cambias aquí, cambia en todas partes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pealkirjagraafika on väljas kõigis seadmetes, kus on sisse logitud selle profiiliga. Siin muutmine muudab seda kõikjal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimilogot ovat pois käytöstä kaikilla tähän profiiliin kirjautuneilla laitteilla. Tässä tehty muutos koskee kaikkia laitteita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les logos de titre sont désactivés sur tous les appareils connectés à ce profil. Les modifier ici les modifie partout."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לוגו הכותרת כבוי בכל המכשירים המחוברים לפרופיל הזה. שינוי כאן משנה אותו בכל מקום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस प्रोफ़ाइल में साइन इन किए गए हर डिवाइस पर टाइटल आर्ट बंद है। इसे यहाँ बदलने से यह हर जगह बदल जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logotip naslova isključen je na svim uređajima prijavljenima na ovaj profil. Promjena ovdje mijenja ga posvuda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A címgrafika ki van kapcsolva a profilba bejelentkezett összes eszközön. Ha itt módosítja, mindenhol módosul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar judul nonaktif di setiap perangkat yang masuk ke profil ini. Mengubahnya di sini akan mengubahnya di semua perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grafica del titolo è disattivata su tutti i dispositivi connessi a questo profilo. Se la cambi qui, cambia ovunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールでサインインしているすべてのデバイスで、タイトルロゴはオフです。ここで変更すると、すべてのデバイスで変更されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필로 로그인한 모든 기기에서 타이틀 아트가 꺼져 있어요. 여기서 바꾸면 모든 기기에서 바뀌어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pavadinimo grafika išjungta visuose įrenginiuose, kuriuose prisijungta prie šio profilio. Pakeitus čia, pasikeis visur."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nosaukuma attēls ir izslēgts visās ierīcēs, kurās izmanto šo profilu. Ja to maināt šeit, tas mainās visur."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seni tajuk dimatikan pada setiap peranti yang log masuk ke profil ini. Menukarnya di sini akan menukarnya di semua tempat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tittelgrafikk er av på alle enheter som er logget på denne profilen. Endrer du det her, endres det overalt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titellogo’s staan uit op elk apparaat dat met dit profiel is aangemeld. Als je het hier wijzigt, verandert het overal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafika tytułu jest wyłączona na każdym urządzeniu zalogowanym do tego profilu. Zmiana tutaj zmienia ją wszędzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A arte do título está desativada em todos os dispositivos conectados a este perfil. Alterar aqui altera em todos eles."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A arte de título está desativada em todos os dispositivos com sessão iniciada neste perfil. Alterá-la aqui altera-a em todo o lado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafica titlului este dezactivată pe toate dispozitivele conectate la acest profil. Dacă o modificați aici, se modifică peste tot."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Логотипы названий выключены на всех устройствах, где выполнен вход в этот профиль. Изменение здесь применится везде."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafika názvu je vypnutá na všetkých zariadeniach prihlásených do tohto profilu. Zmena tu sa prejaví všade."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naslovna grafika je izklopljena na vseh napravah, prijavljenih v ta profil. Če jo spremenite tukaj, se spremeni povsod."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titelgrafik är av på alla enheter som är inloggade på den här profilen. Om du ändrar det här ändras det överallt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาพชื่อเรื่องปิดอยู่ในทุกอุปกรณ์ที่ลงชื่อเข้าใช้โปรไฟล์นี้ การเปลี่ยนที่นี่จะเปลี่ยนในทุกอุปกรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlık görseli, bu profilde oturum açılmış tüm cihazlarda kapalı. Burada yaptığınız değişiklik her yerde geçerli olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назви-логотипи вимкнено на всіх пристроях, де виконано вхід у цей профіль. Зміна тут діє всюди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh tiêu đề đang tắt trên mọi thiết bị đăng nhập vào hồ sơ này. Thay đổi ở đây sẽ thay đổi ở mọi nơi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录此个人资料的所有设备都已关闭标题图。在此更改会同步到所有设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有登入此個人檔案的裝置都已關閉標題圖像。在這裡變更會同時變更所有裝置。"
          }
        }
      }
    },
