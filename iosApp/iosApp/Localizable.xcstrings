    "settingsManifest.ui.app_language.description" : {
      "comment" : "Help text under the ui.app_language setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لغة قوائم التطبيق وأزراره ورسائله. منفصلة عن لغات الصوت والترجمة والبيانات الوصفية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Език на менютата, бутоните и съобщенията на приложението. Отделен е от езиците на аудиото, субтитрите и метаданните."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idioma dels menús, els botons i els missatges de l’aplicació. És independent dels idiomes d’àudio, de subtítols i de metadades."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazyk nabídek, tlačítek a zpráv aplikace. Nezávisí na jazyce zvuku, titulků a metadat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sproget i appens menuer, knapper og beskeder. Adskilt fra sprogene for lyd, undertekster og metadata."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache der Menüs, Schaltflächen und Meldungen der App. Unabhängig von den Sprachen für Audio, Untertitel und Metadaten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η γλώσσα των μενού, των κουμπιών και των μηνυμάτων της εφαρμογής. Είναι ξεχωριστή από τις γλώσσες ήχου, υποτίτλων και μεταδεδομένων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Language of the app's menus, buttons and messages. Separate from the audio, subtitle and metadata languages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idioma de los menús, botones y mensajes de la app. Es independiente de los idiomas de audio, subtítulos y metadatos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakenduse menüüde, nuppude ja teadete keel. Ei sõltu heli, subtiitrite ega metaandmete keelest."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovelluksen valikkojen, painikkeiden ja viestien kieli. Erillinen ääni-, tekstitys- ja metatietokielistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langue des menus, boutons et messages de l’application. Distincte des langues de l’audio, des sous-titres et des métadonnées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שפת התפריטים, הכפתורים וההודעות באפליקציה. נפרדת משפות האודיו, הכתוביות והמטא-נתונים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के मेन्यू, बटन और मैसेज की भाषा। यह ऑडियो, सबटाइटल और मेटाडेटा की भाषाओं से अलग है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jezik izbornika, gumba i poruka aplikacije. Odvojeno od jezika zvuka, titlova i metapodataka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazás menüinek, gombjainak és üzeneteinek nyelve. Független a hang-, a felirat- és a metaadat-nyelvtől."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa menu, tombol, dan pesan aplikasi. Terpisah dari bahasa audio, subtitel, dan metadata."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingua di menu, pulsanti e messaggi dell’app. È separata dalle lingue di audio, sottotitoli e metadati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのメニュー、ボタン、メッセージの言語です。音声、字幕、メタデータの言語とは別に設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 메뉴, 버튼, 메시지에 사용하는 언어예요. 오디오, 자막, 메타데이터 언어와는 별도예요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programėlės meniu, mygtukų ir pranešimų kalba. Atskira nuo garso, subtitrų ir metaduomenų kalbų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lietotnes izvēlņu, pogu un ziņojumu valoda. Atsevišķi no audio, subtitru un metadatu valodām."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa menu, butang dan mesej apl. Berasingan daripada bahasa audio, sari kata dan metadata."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Språket i appens menyer, knapper og meldinger. Uavhengig av språkene for lyd, undertekster og metadata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taal van de menu’s, knoppen en meldingen van de app. Los van de talen voor audio, ondertitels en metadata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Język menu, przycisków i komunikatów aplikacji. Niezależny od języka dźwięku, napisów i metadanych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idioma dos menus, botões e mensagens do app. Independente dos idiomas de áudio, legendas e metadados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idioma dos menus, botões e mensagens da app. Independente dos idiomas de áudio, legendas e metadados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limba meniurilor, butoanelor și mesajelor aplicației. Este separată de limbile pentru audio, subtitrări și metadate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Язык меню, кнопок и сообщений приложения. Не зависит от языков аудио, субтитров и метаданных."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazyk ponúk, tlačidiel a správ aplikácie. Nezávisí od jazykov zvuku, titulkov a metadát."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jezik menijev, gumbov in sporočil aplikacije. Ločeno od jezikov zvoka, podnapisov in metapodatkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Språket för appens menyer, knappar och meddelanden. Skilt från språken för ljud, undertext och metadata."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาษาของเมนู ปุ่ม และข้อความในแอป แยกจากภาษาเสียง ภาษาคำบรรยาย และภาษาข้อมูลเมตา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın menülerinin, düğmelerinin ve mesajlarının dili. Ses, altyazı ve meta veri dillerinden ayrıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мова меню, кнопок і повідомлень застосунку. Не залежить від мови аудіо, субтитрів і метаданих."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngôn ngữ của menu, nút và thông báo trong ứng dụng. Tách biệt với ngôn ngữ âm thanh, phụ đề và siêu dữ liệu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用菜单、按钮和消息使用的语言。与音频、字幕和元数据语言分开设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 選單、按鈕和訊息使用的語言。與音訊、字幕和中繼資料語言分開設定。"
          }
        }
      }
    },
