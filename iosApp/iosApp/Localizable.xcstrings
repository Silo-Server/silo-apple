    "account.removal.downloads" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV): sentence in the sign-out and remove-server confirmations saying which downloads go with the account. {count}: the number of downloads (selects the form); {count_text}: the same number as written digits; {size}: their total size, such as 8.4 GB; {device}: the device's product name (iPhone, iPad, Mac or Apple TV).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
