    "tvPair.approval.unreachable" : {
      "comment" : "Apple (iPhone, iPad) Sign in a TV approval card: error when the phone can't contact the chosen server. {server}: the server's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
