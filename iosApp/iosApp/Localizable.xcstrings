    "downloads.settings.qualityOriginal" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; first sentence of the footer under the quality picker. The footer's sentences are joined with a space.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفضّل خيار «الأصلية» جودة المصدر وقد يجهّز ملفًا متوافقًا إذا احتاج هذا الجهاز إليه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvalita Původní upřednostňuje kvalitu zdroje a může připravit soubor pro kompatibilitu, pokud ho toto zařízení potřebuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original foretrækker kildekvaliteten og kan forberede en kompatibilitetsfil, hvis denne enhed har brug for en."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original bevorzugt die Qualität der Quelle und bereitet eventuell eine kompatible Datei vor, falls dieses Gerät eine benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original prefers source quality and may prepare a compatibility file if this device needs one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original prioriza la calidad de origen y puede preparar un archivo compatible si este dispositivo lo necesita."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkuperäinen suosii lähteen laatua ja voi valmistella yhteensopivuustiedoston, jos tämä laite tarvitsee sellaisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’option Original privilégie la qualité de la source et peut préparer un fichier de compatibilité si cet appareil en a besoin."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcija Izvorno daje prednost kvaliteti izvora i može pripremiti datoteku za kompatibilnost ako je ovom uređaju potrebna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La qualità Originale privilegia la qualità della sorgente e può preparare un file di compatibilità se questo dispositivo ne ha bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「オリジナル」はソースの画質を優先し、このデバイスで必要な場合は互換ファイルを準備することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본은 소스 화질을 우선하며, 이 기기에 필요하면 호환 파일을 준비할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original foretrekker kildekvalitet og kan forberede en kompatibilitetsfil hvis denne enheten trenger det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Origineel geeft de voorkeur aan bronkwaliteit en kan een compatibel bestand voorbereiden als dit apparaat dat nodig heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcja Oryginał preferuje jakość źródła i może przygotować zgodny plik, jeśli to urządzenie go potrzebuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Original prefere a qualidade da origem e pode preparar um arquivo de compatibilidade se este dispositivo precisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вариант «Оригинал» использует качество источника и может подготовить совместимый файл, если он нужен этому устройству."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original föredrar källkvalitet och kan förbereda en kompatibilitetsfil om den här enheten behöver en."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Orijinal” seçeneği kaynak kalitesini tercih eder ve bu cihaz gerektiriyorsa bir uyumluluk dosyası hazırlayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якість «Оригінал» віддає перевагу якості джерела й може підготувати сумісний файл, якщо він потрібен цьому пристрою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“原始”优先使用来源质量；如果此设备需要，可能会准备一个兼容文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「原始」會優先使用來源畫質，若此裝置需要，可能會準備相容檔案。"
          }
        }
      }
    },
    "downloads.settings.qualityPresets" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; second sentence of the quality footer, when seasons and series can also be downloaded in a preset and the server reports no resolutions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجهَّز إعدادات معدل البت المسبقة على الخادم عندما يكون الملف الأصلي أكبر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předvolby datového toku se připravují na serveru, pokud je originál větší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forvalg for bitrate forberedes på serveren, når originalen er større."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitraten-Voreinstellungen werden auf dem Server vorbereitet, wenn das Original größer ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitrate presets are prepared on the server when the original is larger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes predefinidos de tasa de bits se preparan en el servidor cuando el original es más grande."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bittinopeuden esiasetukset valmistellaan palvelimella, kun alkuperäinen on suurempi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les préréglages de débit sont préparés sur le serveur lorsque l’original est plus volumineux."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unaprijed postavljene brzine prijenosa pripremaju se na poslužitelju kada je izvornik veći."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I preset di bitrate vengono preparati sul server quando l’originale è più grande."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オリジナルの方が大きい場合、ビットレートプリセットがサーバーで準備されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본이 더 크면 서버에서 비트레이트 프리셋을 준비해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhåndsinnstillinger for bithastighet forberedes på serveren når originalen er større."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitrate-presets worden op de server voorbereid als het origineel groter is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warianty bitrate’u są przygotowywane na serwerze, gdy oryginał jest większy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As predefinições de taxa de bits são preparadas no servidor quando o original é maior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если оригинал больше, пресеты битрейта готовятся на сервере."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bithastighetsförval förbereds på servern när originalet är större."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinal dosya daha büyükse bit hızı ön ayarları sunucuda hazırlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо оригінал більший, пресети бітрейту готуються на сервері."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当原始文件较大时，服务器会准备码率预设版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始檔案較大時，伺服器會準備位元速率預設檔。"
          }
        }
      }
    },
    "downloads.settings.qualityPresetsResolution" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; second sentence of the quality footer, when seasons and series can also be downloaded in a preset and presets show a resolution.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجهَّز إعدادات معدل البت المسبقة على الخادم عندما يكون الملف الأصلي أكبر، بدقة تصل إلى الدقة المعروضة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předvolby datového toku se připravují na serveru, pokud je originál větší, a to až do zobrazeného rozlišení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forvalg for bitrate forberedes på serveren, når originalen er større, i op til den viste opløsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitraten-Voreinstellungen werden auf dem Server vorbereitet, wenn das Original größer ist, und zwar bis zur angezeigten Auflösung."
