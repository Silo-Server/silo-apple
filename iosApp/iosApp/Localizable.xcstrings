    "signIn.error.checkCredentials" : {
      "comment" : "Apple (iPhone, iPad, Mac, Apple TV) password sign-in: error when the server rejects the request as invalid (HTTP 400 or 422).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من اسم المستخدم وكلمة المرور، ثم حاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte uživatelské jméno a heslo a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollér dit brugernavn og din adgangskode, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe deinen Benutzernamen und dein Passwort und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your username and password, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa tu nombre de usuario y contraseña, y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista käyttäjänimi ja salasana ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez votre nom d’utilisateur et votre mot de passe, puis réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
