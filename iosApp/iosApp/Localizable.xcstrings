            "value" : "报告已保留，供捕获它的服务器使用。"
          }
        }
      }
    },
    "diagnostics.notice.keptRetry" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: sending failed for a reason that may pass; the report stays on the device and is sent again later.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
