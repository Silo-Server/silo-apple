    "diagnostics.notice.keptOtherServer" : {
      "comment" : "Apple Settings > Diagnostics (iPhone, iPad) and Apple TV Settings > Diagnostics: the report belongs to a different server than the one now selected, so it wasn't sent.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
