    "setup.cleartext.body" : {
      "comment" : "Roku and Android TV: body of the unencrypted-connection warning dialog. {host}: the server address the user is about to connect to. Apple (iPhone, iPad, Mac, Apple TV): same alert message.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُرسل كلمة المرور وما تشاهده دون تشفير إلى %1$@. لا تفعل ذلك إلا على شبكة تثق بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Passwort und was du ansiehst, werden unverschlüsselt an %1$@ gesendet. Tu das nur in einem Netzwerk, dem du vertraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your password and what you watch will be sent unencrypted to %1$@. Only do this on a network you trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña y lo que ves se enviarán sin cifrar a %1$@. Hazlo solo en una red de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe et ce que vous regardez seront envoyés sans chiffrement à %1$@. Ne le faites que sur un réseau de confiance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードと視聴内容が暗号化されずに%1$@へ送信されます。信頼できるネットワークでのみ使用してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua senha e o que você assiste serão enviados sem criptografia para %1$@. Faça isso apenas em uma rede confiável."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密码和观看内容将以未加密方式发送到%1$@。请仅在你信任的网络上这样做。"
          }
        }
      }
    },
