    "shell.searchIntent.description" : {
      "comment" : "Apple Siri and Shortcuts: one-line description of the Search Silo action in the Shortcuts app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح البحث في Silo بعبارة البحث الخاصة بك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отваря „Търсене“ в Silo с текста, който търсите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre la cerca de Silo amb el teu terme de cerca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevře hledání v aplikaci Silo se zadaným výrazem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner Søg i Silo med dit søgeord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Suche in Silo mit deinem Suchbegriff."
          }
