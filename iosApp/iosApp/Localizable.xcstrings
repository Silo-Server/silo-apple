    "tvPairing.consentNote" : {
      "comment" : "Android TV warning on the setup request: allow only if the user started setup on their own device. Apple TV: same warning on the pairing screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تسمح بذلك إلا إذا بدأت الإعداد على هاتفك أو جهازك اللوحي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte to, jen pokud jste nastavení spustili ve svém vlastním telefonu nebo tabletu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad det kun, hvis du har startet konfigurationen på din egen telefon eller tablet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass es nur zu, wenn du die Einrichtung auf deinem eigenen Smartphone oder Tablet gestartet hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only allow it if you started setup on your own phone or tablet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permítelo solo si iniciaste la configuración en tu propio teléfono o tableta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli vain, jos aloitit määrityksen omalla puhelimellasi tai tabletillasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’autorisez cette opération que si vous avez lancé la configuration sur votre propre téléphone ou tablette."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopustite samo ako ste postavljanje pokrenuli na vlastitom telefonu ili tabletu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti solo se hai avviato la configurazione sul tuo telefono o tablet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご自身のスマートフォンまたはタブレットで設定を開始した場合のみ許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본인의 휴대폰이나 태블릿에서 직접 설정을 시작한 경우에만 허용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillat det bare hvis du startet oppsettet på din egen telefon eller ditt eget nettbrett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta dit alleen toe als je het instellen op je eigen telefoon of tablet bent gestart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól tylko, jeśli konfiguracja została uruchomiona na twoim telefonie lub tablecie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só permita se você iniciou a configuração no seu próprio celular ou tablet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешайте, только если вы сами начали настройку на своём телефоне или планшете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt bara detta om du startade konfigurationen på din egen telefon eller surfplatta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca kurulumu kendi telefonunuzda veya tabletinizde başlattıysanız izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяйте, лише якщо ви самі почали налаштування на своєму телефоні або планшеті."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
