    "buffering.promptMessage" : {
      "comment" : "Roku player: message in the buffering prompt suggesting a lower video quality so playback can continue. Apple iOS/tvOS/macOS: second line of the buffering pill over the player.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جرّب جودة أقل لمواصلة المشاهدة"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете по-ниско качество, за да продължите гледането"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova una qualitat més baixa per continuar mirant"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkuste nižší kvalitu a pokračujte ve sledování"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv en lavere kvalitet for at se videre"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine niedrigere Qualität, um weiterzuschauen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δοκιμάστε χαμηλότερη ποιότητα για να συνεχίσετε την παρακολούθηση"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try a lower quality to keep watching"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba una calidad más baja para seguir viendo"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaatamise jätkamiseks proovige madalamat kvaliteeti"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatka katselua kokeilemalla alempaa laatua"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez une qualité inférieure pour continuer à regarder"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לעבור לאיכות נמוכה יותר כדי להמשיך לצפות"
          }
        },
        "hi" : {
          "stringUnit" : {
