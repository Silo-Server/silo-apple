          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर सेव की गई कॉपी चलाएँ या सर्वर से स्ट्रीम करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducirajte kopiju spremljenu na ovom uređaju ili streamajte s poslužitelja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
