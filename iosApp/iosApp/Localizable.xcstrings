        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show Who's Watching when you've been away from Silo for 12 hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra “¿Quién está viendo?” cuando hayas estado fuera de Silo durante 12 horas."
