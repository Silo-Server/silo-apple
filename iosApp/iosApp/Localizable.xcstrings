    "downloads.monitorList.footer" : {
      "comment" : "Apple iOS/macOS: Monitored screen (series this device downloads automatically), opened from the Downloads tab; note under the list when downloads may use cellular data.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنزَّل الحلقات الجديدة بعد عرضها. لإضافة مسلسل، اضغط على «تنزيل» فيه واختر «مراقبة»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новите епизоди се изтеглят, след като бъдат излъчени. За да добавите сериал, докоснете „Изтегляне“ в него и изберете „Наблюдение“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els episodis nous es baixen després d’emetre’s. Per afegir una sèrie, toca-hi Baixa i tria Supervisa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové díly se stáhnou po odvysílání. Seriál přidáte tak, že u něj klepnete na Stáhnout a vyberete Sledovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye afsnit downloades, når de er blevet sendt. Tilføj en serie ved at trykke på Download på den og vælge Overvåg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Folgen werden nach der Ausstrahlung heruntergeladen. Um eine Serie hinzuzufügen, tippe darin auf „Download“ und wähle „Beobachten“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η λήψη των νέων επεισοδίων γίνεται μετά την προβολή τους. Για να προσθέσετε μια σειρά, πατήστε «Λήψη» σε αυτήν και επιλέξτε «Παρακολούθηση»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New episodes download after they air. To add a series, tap Download on it and choose Monitor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios nuevos se descargan después de emitirse. Para añadir una serie, toca Descargar en ella y elige Supervisar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uued osad laaditakse alla pärast eetrisse jõudmist. Sarja lisamiseks puudutage selle juures nuppu „Laadi alla“ ja valige „Jälgi“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudet jaksot ladataan niiden ilmestyttyä. Lisää sarja napauttamalla sen Lataa-painiketta ja valitsemalla Seuraa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux épisodes se téléchargent après leur diffusion. Pour ajouter une série, touchez Télécharger sur sa page et choisissez Surveiller."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרקים חדשים יורדים אחרי השידור. כדי להוסיף סדרה, יש להקיש על ”הורדה” בדף שלה ולבחור ”מעקב”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए एपिसोड प्रसारित होने के बाद डाउनलोड होते हैं। कोई सीरीज़ जोड़ने के लिए उसमें “डाउनलोड” पर टैप करें और “मॉनिटर करें” चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nove epizode preuzimaju se nakon emitiranja. Da biste dodali seriju, dodirnite Preuzmi na njoj i odaberite Prati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új epizódok a vetítésük után töltődnek le. Sorozat hozzáadásához koppintson a sorozaton a Letöltés gombra, és válassza a Figyelés lehetőséget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episode baru diunduh setelah tayang. Untuk menambahkan serial, ketuk Unduh pada serial itu, lalu pilih Pantau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi episodi vengono scaricati dopo la messa in onda. Per aggiungere una serie, tocca Scarica e scegli Monitora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいエピソードは放送後にダウンロードされます。シリーズを追加するには、シリーズの「ダウンロード」をタップして「監視」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 에피소드는 방영 후 다운로드돼요. 시리즈를 추가하려면 시리즈에서 다운로드를 탭하고 모니터링을 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nauji epizodai atsisiunčiami, kai jie parodomi. Kad pridėtumėte serialą, jame palieskite „Atsisiųsti“ ir pasirinkite „Stebėti“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaunās epizodes tiek lejupielādētas pēc to pirmizrādes. Lai pievienotu seriālu, pieskarieties tā pogai „Lejupielādēt” un atlasiet „Uzraudzīt”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episod baharu dimuat turun selepas disiarkan. Untuk menambah siri, ketik Muat turun pada siri itu dan pilih Pantau."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye episoder lastes ned etter at de er sendt. For å legge til en serie, trykk på Last ned på den og velg Overvåk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe afleveringen worden gedownload nadat ze zijn uitgezonden. Wil je een serie toevoegen? Tik bij de serie op Downloaden en kies Volgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe odcinki są pobierane po emisji. Aby dodać serial, stuknij w nim Pobierz i wybierz Monitoruj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos episódios são baixados depois de irem ao ar. Para adicionar uma série, toque em Baixar nela e escolha Monitorar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os novos episódios são transferidos depois de serem emitidos. Para adicionar uma série, toque em Transferir na série e escolha Monitorizar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episoadele noi se descarcă după difuzare. Pentru a adăuga un serial, atingeți „Descărcați” pe pagina acestuia și alegeți „Monitorizați”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые серии скачиваются после выхода. Чтобы добавить сериал, коснитесь «Скачать» на его странице и выберите «Отслеживать»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové epizódy sa stiahnu po odvysielaní. Ak chcete pridať seriál, ťuknite pri ňom na Stiahnuť a vyberte Sledovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nove epizode se prenesejo po izidu. Če želite dodati serijo, na njej tapnite Prenesi in izberite Spremljaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nya avsnitt laddas ned när de har sänts. Om du vill lägga till en serie trycker du på Ladda ned i den och väljer Bevaka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนใหม่จะดาวน์โหลดหลังออกอากาศ หากต้องการเพิ่มซีรีส์ ให้แตะ “ดาวน์โหลด” ในซีรีส์นั้นแล้วเลือก “ติดตาม”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bölümler yayınlandıktan sonra indirilir. Dizi eklemek için dizide İndir düğmesine dokunun ve Takip et seçeneğini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові епізоди завантажуються після виходу. Щоб додати серіал, торкніться «Завантажити» на його сторінці й виберіть «Відстежувати»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tập mới được tải xuống sau khi phát sóng. Để thêm một phim bộ, chạm vào Tải xuống trên phim bộ đó và chọn Theo dõi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新集播出后会自动下载。要添加剧集，请在剧集上轻点“下载”，然后选择“监控”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新集數會在播出後下載。若要新增影集，請在影集上點一下「下載」，然後選擇「監控」。"
          }
        }
      }
    },
    "downloads.monitorList.footerWifi" : {
      "comment" : "Apple iOS/macOS: Monitored screen (series this device downloads automatically), opened from the Downloads tab; note under the list when downloads are Wi-Fi only.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنزَّل الحلقات الجديدة بعد عرضها عبر Wi-Fi. لإضافة مسلسل، اضغط على «تنزيل» فيه واختر «مراقبة»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новите епизоди се изтеглят през Wi-Fi, след като бъдат излъчени. За да добавите сериал, докоснете „Изтегляне“ в него и изберете „Наблюдение“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els episodis nous es baixen per Wi-Fi després d’emetre’s. Per afegir una sèrie, toca-hi Baixa i tria Supervisa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové díly se po odvysílání stáhnou přes Wi-Fi. Seriál přidáte tak, že u něj klepnete na Stáhnout a vyberete Sledovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye afsnit downloades via Wi-Fi, når de er blevet sendt. Tilføj en serie ved at trykke på Download på den og vælge Overvåg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Folgen werden nach der Ausstrahlung über Wi-Fi heruntergeladen. Um eine Serie hinzuzufügen, tippe darin auf „Download“ und wähle „Beobachten“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η λήψη των νέων επεισοδίων γίνεται μετά την προβολή τους, μέσω Wi-Fi. Για να προσθέσετε μια σειρά, πατήστε «Λήψη» σε αυτήν και επιλέξτε «Παρακολούθηση»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New episodes download after they air, over Wi-Fi. To add a series, tap Download on it and choose Monitor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios nuevos se descargan por Wi-Fi después de emitirse. Para añadir una serie, toca Descargar en ella y elige Supervisar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uued osad laaditakse pärast eetrisse jõudmist Wi-Fi kaudu alla. Sarja lisamiseks puudutage selle juures nuppu „Laadi alla“ ja valige „Jälgi“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudet jaksot ladataan Wi-Fi-yhteydellä niiden ilmestyttyä. Lisää sarja napauttamalla sen Lataa-painiketta ja valitsemalla Seuraa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux épisodes se téléchargent en Wi-Fi après leur diffusion. Pour ajouter une série, touchez Télécharger sur sa page et choisissez Surveiller."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרקים חדשים יורדים ברשת Wi-Fi אחרי השידור. כדי להוסיף סדרה, יש להקיש על ”הורדה” בדף שלה ולבחור ”מעקב”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए एपिसोड प्रसारित होने के बाद Wi-Fi पर डाउनलोड होते हैं। कोई सीरीज़ जोड़ने के लिए उसमें “डाउनलोड” पर टैप करें और “मॉनिटर करें” चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nove epizode preuzimaju se putem Wi-Fi mreže nakon emitiranja. Da biste dodali seriju, dodirnite Preuzmi na njoj i odaberite Prati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új epizódok a vetítésük után, Wi-Fi-n keresztül töltődnek le. Sorozat hozzáadásához koppintson a sorozaton a Letöltés gombra, és válassza a Figyelés lehetőséget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episode baru diunduh melalui Wi-Fi setelah tayang. Untuk menambahkan serial, ketuk Unduh pada serial itu, lalu pilih Pantau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi episodi vengono scaricati tramite Wi-Fi dopo la messa in onda. Per aggiungere una serie, tocca Scarica e scegli Monitora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいエピソードは放送後にWi-Fi経由でダウンロードされます。シリーズを追加するには、シリーズの「ダウンロード」をタップして「監視」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 에피소드는 방영 후 Wi-Fi로 다운로드돼요. 시리즈를 추가하려면 시리즈에서 다운로드를 탭하고 모니터링을 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nauji epizodai atsisiunčiami per Wi-Fi, kai jie parodomi. Kad pridėtumėte serialą, jame palieskite „Atsisiųsti“ ir pasirinkite „Stebėti“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaunās epizodes tiek lejupielādētas pēc to pirmizrādes, izmantojot Wi-Fi. Lai pievienotu seriālu, pieskarieties tā pogai „Lejupielādēt” un atlasiet „Uzraudzīt”."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episod baharu dimuat turun melalui Wi-Fi selepas disiarkan. Untuk menambah siri, ketik Muat turun pada siri itu dan pilih Pantau."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye episoder lastes ned over Wi-Fi etter at de er sendt. For å legge til en serie, trykk på Last ned på den og velg Overvåk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe afleveringen worden via Wi-Fi gedownload nadat ze zijn uitgezonden. Wil je een serie toevoegen? Tik bij de serie op Downloaden en kies Volgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe odcinki są pobierane po emisji przez Wi-Fi. Aby dodać serial, stuknij w nim Pobierz i wybierz Monitoruj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos episódios são baixados por Wi-Fi depois de irem ao ar. Para adicionar uma série, toque em Baixar nela e escolha Monitorar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os novos episódios são transferidos através de Wi-Fi depois de serem emitidos. Para adicionar uma série, toque em Transferir na série e escolha Monitorizar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episoadele noi se descarcă după difuzare, prin Wi-Fi. Pentru a adăuga un serial, atingeți „Descărcați” pe pagina acestuia și alegeți „Monitorizați”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые серии скачиваются по Wi-Fi после выхода. Чтобы добавить сериал, коснитесь «Скачать» на его странице и выберите «Отслеживать»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové epizódy sa stiahnu po odvysielaní cez Wi-Fi. Ak chcete pridať seriál, ťuknite pri ňom na Stiahnuť a vyberte Sledovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nove epizode se prenesejo po izidu prek omrežja Wi-Fi. Če želite dodati serijo, na njej tapnite Prenesi in izberite Spremljaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nya avsnitt laddas ned via Wi-Fi när de har sänts. Om du vill lägga till en serie trycker du på Ladda ned i den och väljer Bevaka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนใหม่จะดาวน์โหลดผ่าน Wi-Fi หลังออกอากาศ หากต้องการเพิ่มซีรีส์ ให้แตะ “ดาวน์โหลด” ในซีรีส์นั้นแล้วเลือก “ติดตาม”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bölümler yayınlandıktan sonra Wi-Fi üzerinden indirilir. Dizi eklemek için dizide İndir düğmesine dokunun ve Takip et seçeneğini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові епізоди завантажуються через Wi-Fi після виходу. Щоб додати серіал, торкніться «Завантажити» на його сторінці й виберіть «Відстежувати»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tập mới được tải xuống qua Wi-Fi sau khi phát sóng. Để thêm một phim bộ, chạm vào Tải xuống trên phim bộ đó và chọn Theo dõi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新集播出后会通过Wi-Fi自动下载。要添加剧集，请在剧集上轻点“下载”，然后选择“监控”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新集數會在播出後透過 Wi-Fi 下載。若要新增影集，請在影集上點一下「下載」，然後選擇「監控」。"
          }
        }
      }
    },
