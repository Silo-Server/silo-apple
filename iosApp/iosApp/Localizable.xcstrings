    "remote.replace.alertTitle" : {
      "comment" : "Apple iOS: Remote Control remote; title of the alert asking whether to replace what another profile is watching on the TV.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استبدال ما يُعرض الآن؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahradit přehrávaný obsah?"
          }
        },
        "da" : {
