    "requests.hub.emptyBody" : {
      "comment" : "Phone: body of the empty state on the Requests page when the user has no requests and the server suggests nothing. Apple (iPhone, iPad, Mac): same empty-state body on the Requests page.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث عن فيلم أو مسلسل لطلبه"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потърсете филм или сериал, за да го заявите"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca una pel·lícula o una sèrie per sol·licitar-la"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhledejte film nebo seriál a požádejte o něj"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søg efter en film eller serie for at anmode om den"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche nach einem Film oder einer Serie, um sie anzufragen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζητήστε μια ταινία ή σειρά για να τη ζητήσετε"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search for a movie or series to request it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca una película o serie para solicitarla"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otsige filmi või sarja, et seda taotleda"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydä elokuvaa tai sarjaa hakemalla se"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez un film ou une série pour en faire la demande"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לחפש סרט או סדרה כדי לבקש אותם"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी फ़िल्म या सीरीज़ का अनुरोध करने के लिए उसे खोजें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potražite film ili seriju da biste ih zatražili"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keressen egy filmet vagy sorozatot az igényléshez"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cari film atau serial untuk memintanya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca un film o una serie per richiederlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映画やシリーズを検索してリクエストしてください"
          }
        },
        "ko" : {
