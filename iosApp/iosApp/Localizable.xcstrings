    "downloads.large.upToNoSpace" : {
      "comment" : "Apple iOS/macOS: size warning in the large download confirmation and the Download Options sheet footer, when the server may pick one of several files. {size}: largest file size; {free}: free space on the device.",
      "extractionState" : "manual",
