    "newProfile.pickLook" : {
      "comment" : "TV: short instruction under the New Profile heading, asking the user to choose an avatar and type a name. Apple TV: same line under the New Profile heading.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
