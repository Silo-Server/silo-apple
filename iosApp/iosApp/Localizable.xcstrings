        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une TV à proximité nommée « %1$@ » indique être sur son écran de connexion. Vous vérifierez son code avant d’approuver."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」という名前の近くのテレビが、サインイン画面を表示していると伝えています。承認する前にそのコードを確認します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma TV próxima chamada “%1$@” diz que está na tela de login. Você vai conferir o código dela antes de aprovar."
          }
