          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles y la configuración de esta cuenta se quitarán de este %1$@, y %2$@ se eliminará de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
