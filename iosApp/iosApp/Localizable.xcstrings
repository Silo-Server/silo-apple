          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再プラン中に、サーバーが認証済みのメディア転送を維持しませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor não manteve o transporte de mídia autenticado durante o replanejamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器在重新规划时未保留经过身份验证的媒体传输。"
          }
        }
      }
    },
    "player.error.routeLadderExhausted" : {
      "comment" : "Apple iOS/tvOS/macOS: video player error screen when recovery tried every playback route the server offered and none played.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
