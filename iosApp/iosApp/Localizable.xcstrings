    "settingsManifest.playback.auto_skip_recap.description" : {
      "comment" : "Help text under the playback.auto_skip_recap setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخطي ملخصات «في الحلقات السابقة» تلقائيًا عندما يتمكن Silo من اكتشافها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично прескачане на обобщенията „Досега в сериала“, когато Silo може да ги открие."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omet automàticament els resums «anteriorment a…» quan Silo els pot detectar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky přeskočit shrnutí „v minulém díle“, pokud je Silo dokáže rozpoznat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring automatisk over resuméer (”Tidligere i …”), når Silo kan genkende dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt Rückblicke („Was bisher geschah“) automatisch, wenn Silo sie erkennen kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτόματη παράλειψη των ανακεφαλαιώσεων «Στα προηγούμενα» όταν το Silo μπορεί να τις εντοπίσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip \"previously on\" recaps automatically when Silo can detect them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omite los resúmenes “anteriormente en” automáticamente cuando Silo pueda detectarlos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätab „Eelmises osas“ kokkuvõtted automaatselt vahele, kui Silo suudab need tuvastada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohita ”aiemmin tapahtunutta” -kertaukset automaattisesti, kun Silo tunnistaa ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe automatiquement les récapitulatifs « Précédemment dans… » quand Silo peut les détecter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דילוג אוטומטי על סיכומי ”בפרקים הקודמים” כש-Silo מזהה אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब Silo “पिछले एपिसोड में” वाले रीकैप पहचान सके, तब उन्हें अपने-आप छोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatski preskače sažetke „u prethodnim epizodama“ kada ih Silo može prepoznati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az „előző részek tartalmából” összefoglalók automatikus átugrása, ha a Silo felismeri őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lewati rekap “sebelumnya” secara otomatis jika Silo dapat mendeteksinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta automaticamente i riassunti “nelle puntate precedenti” quando Silo riesce a rilevarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siloが「前回までのあらすじ」を検出できた場合、自動的にスキップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo에서 “지난 이야기” 요약을 감지할 수 있으면 자동으로 건너뛰어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatiškai praleisti ankstesnių epizodų santraukas, kai „Silo“ gali jas aptikti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automātiski izlaiž iepriekšējo epizožu kopsavilkumus, ja Silo tos spēj noteikt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkau imbasan “sebelum ini” secara automatik apabila Silo dapat mengesannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hopp automatisk over sammendrag av tidligere episoder når Silo kan oppdage dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla samenvattingen van “eerder in” automatisch over wanneer Silo ze kan detecteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie pomijaj streszczenia „W poprzednich odcinkach”, gdy Silo potrafi je wykryć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pula as recapitulações “anteriormente em” automaticamente quando o Silo consegue detectá-las."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltar automaticamente os resumos «anteriormente em» quando o Silo os consegue detetar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omite automat rezumatele „Anterior în…” când Silo le poate detecta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически пропускать краткое содержание предыдущих серий, когда Silo может его распознать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky preskočí zhrnutia „V predchádzajúcich častiach“, keď ich Silo dokáže rozpoznať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samodejno preskoči povzetke „v prejšnjih epizodah“, kadar jih Silo zazna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppa automatiskt över sammanfattningar (”tidigare i serien”) när Silo kan identifiera dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้ามบทสรุปตอนที่แล้วโดยอัตโนมัติเมื่อ Silo ตรวจพบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo algılayabildiğinde “önceki bölümlerde” özetlerini otomatik olarak atlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично пропускати перекази «Раніше в серіалі», коли Silo може їх розпізнати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động bỏ qua đoạn tóm tắt “tập trước” khi Silo phát hiện được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo检测到“前情提要”时自动跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silo 偵測到「前情提要」時自動略過。"
          }
        }
      }
    },
