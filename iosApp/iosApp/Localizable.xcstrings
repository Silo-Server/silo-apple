    "player.seekInterval.loadFailed" : {
      "comment" : "Apple iOS/tvOS/macOS: skip interval settings (video and audiobook skip back/forward); error when the first load failed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل فواصل التخطي من الخادم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можаха да се заредят интервалите на прескачане от сървъра."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’han pogut carregar els intervals de salt des del servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervaly přeskočení se nepodařilo načíst ze serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke indlæse springintervaller fra serveren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprungintervalle konnten nicht vom Server geladen werden."
