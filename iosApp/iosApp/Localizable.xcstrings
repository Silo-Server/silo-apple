    "home.recipe.esActor.description" : {
      "comment" : "One-line description of the Actor Spotlight preset in the Add row gallery (shared key `home.recipe.esActor.description`, sent as description_short_key). Shown under or beside the preset's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسليط الضوء أسبوعيًا على ممثل في مكتبتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý týden představí herce z vaší knihovny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugentligt fokus på en skuespiller i dit bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Woche steht eine Person aus der Besetzung deiner Mediathek im Fokus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weekly spotlight on an actor in your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada semana destaca a un actor o actriz de tu biblioteca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joka viikko esittelyssä näyttelijä kirjastostasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque semaine, un ou une interprète de votre bibliothèque à l’honneur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki tjedan u fokusu je glumac iz vaše medijateke."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni settimana, i riflettori su un interprete della tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリの俳優を毎週ピックアップ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매주 라이브러리 속 배우 한 명을 조명."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukentlig søkelys på en skuespiller i biblioteket ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke week een acteur uit je bibliotheek in de schijnwerpers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co tydzień wyróżnienie dla innego aktora z twojej biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destaque semanal para alguém do elenco da sua biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждую неделю — актёр из вашей медиатеки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veckans fokus på en skådespelare i ditt bibliotek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her hafta kitaplığınızdan bir oyuncu öne çıkar."
          }
        },
        "uk" : {
