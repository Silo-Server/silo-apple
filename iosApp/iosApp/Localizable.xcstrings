    "downloads.settings.otherDataFooter" : {
      "comment" : "Apple iOS/macOS: Downloads settings screen; footer of the Other Download Data section.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظة لخوادم أخرى أو ملفات شخصية أخرى أو بواسطة إصدارات أخرى من Silo. لا تظهر في «التنزيلات» لهذا الملف الشخصي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data uložená pro jiné servery, jiné profily nebo jinými verzemi aplikace Silo. Ve Stahování pro tento profil se nezobrazují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemt for andre servere, andre profiler eller af andre versioner af Silo. De vises ikke i Downloads for denne profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für andere Server, für andere Profile oder von anderen Silo-Versionen gespeichert. Diese Daten erscheinen für dieses Profil nicht unter „Downloads“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved for other servers, other profiles, or by other versions of Silo. It doesn't appear in Downloads for this profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardados para otros servidores, otros perfiles o por otras versiones de Silo. No aparecen en Descargas para este perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennettu muita palvelimia tai profiileja varten tai Silon muilla versioilla. Ei näy tämän profiilin Latauksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrées pour d’autres serveurs, d’autres profils ou par d’autres versions de Silo. Elles n’apparaissent pas dans Téléchargements pour ce profil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremljeno za druge poslužitelje, druge profile ili iz drugih verzija aplikacije Silo. Ne prikazuje se u Preuzimanjima za ovaj profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvati per altri server, altri profili o da altre versioni di Silo. Non compaiono in Download per questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のサーバーや他のプロフィール用に、またはSiloの他のバージョンによって保存されたデータです。このプロフィールのダウンロードには表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 서버나 다른 프로필용으로 저장됐거나 다른 버전의 Silo에서 저장한 데이터예요. 이 프로필의 다운로드에는 표시되지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagret for andre servere, andre profiler eller av andre versjoner av Silo. Dataene vises ikke i Nedlastinger for denne profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opgeslagen voor andere servers, andere profielen of door andere versies van Silo. Deze gegevens verschijnen niet in Downloads voor dit profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane dla innych serwerów, innych profili lub przez inne wersje aplikacji Silo. Nie są widoczne w sekcji Pobrane dla tego profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvos para outros servidores, outros perfis ou por outras versões do Silo. Não aparecem em Downloads para este perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранены для других серверов, других профилей или другими версиями Silo. Не отображаются в разделе «Загрузки» для этого профиля."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparad för andra servrar, andra profiler eller av andra versioner av Silo. Den visas inte under Nedladdningar för den här profilen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer sunucular veya profiller için ya da Silo’nun başka sürümleri tarafından kaydedildi. Bu profilin İndirmeler listesinde görünmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережено для інших серверів, інших профілів або іншими версіями Silo. Ці дані не відображаються в розділі «Завантаження» цього профілю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为其他服务器、其他个人资料或由其他版本的Silo保存。这些数据不会显示在此个人资料的下载中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為其他伺服器或其他個人檔案儲存，或由其他版本的 Silo 儲存。不會出現在此個人檔案的下載項目中。"
          }
        }
      }
    },
