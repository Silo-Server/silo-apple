    "settingsManifest.watch_party.guest_control_policy.description" : {
      "comment" : "Help text under the watch_party.guest_control_policy setting. From the server's settings manifest.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من يمكنه التشغيل والإيقاف المؤقت في جلسات Watch Party التي تستضيفها. يُحفظ تغيير هذا الخيار داخل Watch Party لجلستك التالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer in Watch Partys, die du leitest, abspielen und pausieren darf. Eine Änderung während einer Party wird für deine nächste gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who can play and pause in Watch Parties you host. Changing it in a party saves it for your next one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién puede reproducir y pausar en las Watch Party que organizas. Si lo cambias durante una Watch Party, se guarda para la siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui peut lancer et mettre en pause la lecture dans les Watch Party que vous organisez. Le modifier pendant une Watch Party l’enregistre pour la suivante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストするWatch Partyで再生と一時停止を操作できる人です。Watch Party中に変更すると、次回にも保存されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem pode reproduzir e pausar nas Watch Parties que você organiza. Alterar essa opção durante uma Watch Party a salva para a próxima."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你主持的Watch Party中谁可以播放和暂停。在Watch Party中更改后，会保存用于你的下一场。"
          }
        }
      }
    },
