    "settings.about.creditTmdb" : {
      "comment" : "Apple Acknowledgements (all Apple apps): what Silo uses this outside service for, under its name or logo. Service: TMDB (The Movie Database). Requests is the name of Silo's media request section.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التقييمات، ونتائج البحث وصفوف الاستكشاف والصور الفنية في الطلبات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnocení a také výsledky hledání, řádky objevování a obrázky v sekci Žádosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedømmelser samt søgeresultater, opdagelsesrækker og billeder i Anmodninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewertungen sowie Suchergebnisse, Entdecken-Reihen und Artwork in Anfragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratings, and the search results, discovery rows, and artwork in Requests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calificaciones, y los resultados de búsqueda, las filas de descubrimiento y las imágenes de Solicitudes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arviot sekä Pyynnöt-osion hakutulokset, löytörivit ja kuvitus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes, ainsi que les résultats de recherche, les rangées de découverte et les visuels de Demandes."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocjene te rezultati pretraživanja, retci za otkrivanje i slike u odjeljku Zahtjevi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valutazioni, oltre a risultati di ricerca, righe di scoperta e immagini in Richieste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "評価、およびリクエストの検索結果、おすすめの行、アートワーク。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평점, 그리고 요청의 검색 결과, 추천 행, 아트워크."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vurderinger, samt søkeresultatene, oppdagelsesradene og bildene i Forespørsler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beoordelingen, en de zoekresultaten, ontdekrijen en afbeeldingen in Aanvragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oceny oraz wyniki wyszukiwania, rzędy odkrywania i grafiki w sekcji Prośby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaliações e, em Solicitações, os resultados de busca, as fileiras de descoberta e as imagens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
