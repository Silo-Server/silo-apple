    "library.emptyNamedBody" : {
      "comment" : "Roku and Apple tvOS library screen: supporting line under the named empty-state heading, telling the user media must be added on the server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف وسائط إلى هذه المكتبة على الخادم لتظهر هنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte do této knihovny média na serveru a zobrazí se zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj medier til dette bibliotek på serveren for at se dem her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge auf dem Server Medien zu dieser Mediathek hinzu, damit sie hier erscheinen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add media to this library on the server to see it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade contenido a esta biblioteca en el servidor para verlo aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää mediaa tähän kirjastoon palvelimella, niin se näkyy täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des médias à cette bibliothèque sur le serveur pour les voir ici."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte medije u ovu medijateku na poslužitelju da biste ih vidjeli ovdje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi contenuti a questa libreria sul server per vederli qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここに表示するには、サーバーでこのライブラリにメディアを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에서 이 라이브러리에 미디어를 추가하면 여기에 표시돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til medier i dette biblioteket på serveren for å se dem her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg op de server media aan deze bibliotheek toe om ze hier te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj multimedia do tej biblioteki na serwerze, aby zobaczyć je tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione mídia a esta biblioteca no servidor para vê-la aqui."
          }
        },
        "ru" : {
