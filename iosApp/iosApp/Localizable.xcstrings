    "error.field.managed_by_environment" : {
      "comment" : "Field error when an administrator tries to edit a plugin or stream node setting that the deployment controls through environment configuration.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعيَّن هذا الخيار من البيئة. غيّره هناك وأعد تشغيل الخدمة المتأثرة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стойността е зададена от средата. Променете я там и рестартирайте засегнатата услуга."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho defineix l’entorn. Canvia-ho allà i reinicia el servei afectat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaveno prostředím. Změňte to tam a restartujte dotčenou službu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angivet af miljøet. Skift det dér, og genstart den berørte tjeneste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird über die Umgebung festgelegt. Ändere den Wert dort und starte den betroffenen Dienst neu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορίζεται από το περιβάλλον. Αλλάξτε το εκεί και επανεκκινήστε την υπηρεσία που επηρεάζεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set by the environment. Change it there and restart the affected service."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo define el entorno. Cámbialo allí y reinicia el servicio afectado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle määrab keskkond. Muutke seda seal ja taaskäivitage asjaomane teenus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asetettu ympäristössä. Muuta asetusta siellä ja käynnistä kyseinen palvelu uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeur définie par l’environnement. Modifiez-la à cet endroit et redémarrez le service concerné."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הערך נקבע בסביבה. יש לשנות אותו שם ולהפעיל מחדש את השירות המושפע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह एनवायरनमेंट में सेट है। इसे वहीं बदलें और प्रभावित सेवा रीस्टार्ट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo postavlja okruženje. Promijenite to ondje i ponovno pokrenite zahvaćenu uslugu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A környezet állítja be. Ott módosítsa, majd indítsa újra az érintett szolgáltatást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditetapkan oleh lingkungan. Ubah di sana, lalu mulai ulang layanan yang terdampak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostato dall’ambiente. Modificalo lì e riavvia il servizio interessato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "環境で設定されています。環境側で変更してから、影響を受けるサービスを再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "환경에서 설정된 값이에요. 환경에서 변경한 후 해당 서비스를 다시 시작하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nustatyta aplinkoje. Pakeiskite reikšmę ten ir paleiskite paveiktą paslaugą iš naujo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šo vērtību iestata vide. Mainiet to tur un restartējiet attiecīgo pakalpojumu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditetapkan oleh persekitaran. Ubah di sana dan mulakan semula perkhidmatan yang terjejas."
          }
        },
        "nb" : {
