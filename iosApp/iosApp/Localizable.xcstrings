        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din session har gått ut. Logga in igen för att fortsätta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซสชันหมดอายุแล้ว ลงชื่อเข้าใช้อีกครั้งเพื่อดำเนินการต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumunuzun süresi doldu. Devam etmek için yeniden oturum açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Термін дії сеансу минув. Увійдіть знову, щоб продовжити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên của bạn đã hết hạn. Đăng nhập lại để tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
