    "player.notice.pipNotReady" : {
      "comment" : "Apple iOS: video player notice text under Picture in Picture not ready.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الفيديو غير جاهز لوضع صورة داخل صورة بعد. حاول مرة أخرى بعد لحظات."
