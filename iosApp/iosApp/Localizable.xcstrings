    "settings.interface.posterSizeSyncsDesktop" : {
      "comment" : "Apple Settings > Interface (iPhone, iPad, Mac): explanation under Cards & Posters on computers (Mac): the poster size is shared with the profile's other devices of the same kind.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
