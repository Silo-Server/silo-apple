          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour Silo pour continuer à utiliser ce serveur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ažurirajte Silo da biste nastavili koristiti ovaj poslužitelj."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna Silo per continuare a usare questo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーを引き続き使用するには、Siloをアップデートしてください。"
