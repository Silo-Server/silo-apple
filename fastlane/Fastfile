require "base64"

# Root-level Fastfile — covers iOS, tvOS (Android lanes to be added later).
#
# Lane overview:
#   ios beta_ios   — build iOS app, upload to TestFlight
#   ios beta_tvos  — build tvOS app, upload to TestFlight (must run after beta_ios to avoid
#                    build number races; enforce ordering in CI)
#
# All identifying values (bundle ID, team ID, email, certs repo) come from environment
# variables. Nothing is hardcoded — this file is safe to commit to a public repo.

default_platform(:ios)

# ── Private helpers ──────────────────────────────────────────────────────────

# Loads the App Store Connect API key.
#
# CI path:   base64-decode APP_STORE_CONNECT_API_KEY_KEY env var.
# Local path: read ~/.appstoreconnect/AuthKey_<KEY_ID>.p8 from disk.
#
# Returns the api_key hash produced by app_store_connect_api_key() so callers
# can pass it explicitly to actions that accept api_key:.
private_lane :setup_api_key do
  key_id     = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
  issuer_id  = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
  key_base64 = ENV["APP_STORE_CONNECT_API_KEY_KEY"]

  if key_base64 && !key_base64.empty?
    # CI: key content is stored as a base64-encoded environment variable.
    # Encode with: base64 < AuthKey_XXXX.p8 | tr -d '\n'
    key_content = Base64.decode64(key_base64)
  else
    # Local dev: read the .p8 file from the standard App Store Connect location.
    p8_path = File.expand_path("~/.appstoreconnect/AuthKey_#{key_id}.p8")
    UI.user_error!(
      "ASC API key not found at #{p8_path}. " \
      "Either place the .p8 file there or set APP_STORE_CONNECT_API_KEY_KEY."
    ) unless File.exist?(p8_path)
    key_content = File.read(p8_path)
  end

  app_store_connect_api_key(
    key_id:      key_id,
    issuer_id:   issuer_id,
    key_content: key_content,
    in_house:    false,
    duration:    1200          # Max allowed by Apple — avoids expiry during slow SPM steps
  )
end

def env_list(name)
  ENV[name].to_s.split(",").map(&:strip).reject(&:empty?)
end

def env_truthy?(name, default:)
  value = ENV[name]
  return default if value.nil? || value.strip.empty?

  %w[1 true yes y on].include?(value.strip.downcase)
end

# Returns an xcarg fragment that overrides MARKETING_VERSION when the CI-provided
# env var is set; empty string otherwise (local builds keep the project.yml value).
#
# The value is appended to xcodebuild's xcargs as a shell string, so it must be a
# plain dotted version (e.g. 1.4.0). Rejecting anything else here is the last gate
# against a value with spaces or shell metacharacters injecting extra build
# settings ("1.4.0 CURRENT_PROJECT_VERSION=999") or running commands on the
# signing runner ("1.2.3$(cmd)"). CI also validates this in resolve-marketing-version.sh.
def marketing_version_xcarg
  value = ENV["MARKETING_VERSION"].to_s.strip
  return "" if value.empty?

  unless value.match?(/\A\d+(?:\.\d+){1,2}\z/)
    UI.user_error!("Invalid MARKETING_VERSION #{value.inspect}; expected a dotted version like 1.4.0")
  end
  "MARKETING_VERSION=#{value} "
end

# Optional CURRENT_PROJECT_VERSION override for the unsigned sideload lanes.
# CI passes a GitHub-release-derived build number via BUILD_NUMBER so sideload
# builds carry a distinct CFBundleVersion per release (v1.0.0-build.N). Same
# validation/threat model as marketing_version_xcarg: this flows into
# xcodebuild's xcargs as a shell string.
def build_number_xcarg
  value = ENV["BUILD_NUMBER"].to_s.strip
  return "" if value.empty?

  unless value.match?(/\A\d+\z/)
    UI.user_error!("Invalid BUILD_NUMBER #{value.inspect}; expected a positive integer")
  end
  "CURRENT_PROJECT_VERSION=#{value} "
end

# Overrides the SILO_BUILD_CHANNEL build setting (project.yml default: release)
# for the unsigned sideload lanes. It reaches the app as the SiloBuildChannel
# Info.plist key and is reported to the server as X-Silo-Client-Channel, so an
# operator can tell a re-signed sideload build from the TestFlight build of the
# same marketing version + build number. Constant, not env-derived: there is no
# untrusted input to validate.
SIDELOAD_CHANNEL_XCARG = "SILO_BUILD_CHANNEL=sideload ".freeze

# Returns the build number to stamp on a TestFlight build.
#
# In CI the reserve_build_numbers job computes the next number per platform once
# and passes it to the (parallel) ios/tvos jobs via BUILD_NUMBER — so the two
# jobs never race latest_testflight_build_number against each other. Local and
# ad-hoc runs leave BUILD_NUMBER unset and fall back to querying App Store
# Connect directly.
#
# BUILD_NUMBER is validated as a positive integer before use: it flows into
# xcodebuild's xcargs as CURRENT_PROJECT_VERSION, so it must never carry spaces
# or shell metacharacters (same threat model as marketing_version_xcarg).
def resolve_build_number(api_key:, app_identifier:, platform:)
  injected = ENV["BUILD_NUMBER"].to_s.strip
  unless injected.empty?
    unless injected.match?(/\A\d+\z/)
      UI.user_error!("Invalid BUILD_NUMBER #{injected.inspect}; expected a positive integer")
    end
    UI.message("Using injected BUILD_NUMBER=#{injected} for #{platform}")
    return injected.to_i
  end

  latest_testflight_build_number(
    api_key:        api_key,
    app_identifier: app_identifier,
    platform:       platform
  ) + 1
end

# Regenerates Silo.xcodeproj from project.yml and resolves SPM packages for the
# given scheme. Shared by the unsigned IPA lanes.
# Returns the absolute iosApp directory.
#
# Note: beta_ios/beta_tvos intentionally do NOT use this helper — they interleave
# match() and the build-number query between xcodegen and resolvePackageDependencies,
# so the three steps are not contiguous there.
def prepare_xcode_project(scheme:)
  ios_app_dir = File.expand_path("../iosApp", __dir__)
  sh("xcodegen generate --spec '#{ios_app_dir}/project.yml'")
  sh("xcodebuild -project '#{ios_app_dir}/Silo.xcodeproj' " \
     "-scheme #{scheme} -resolvePackageDependencies")
  ios_app_dir
end

# Repackages a compiled .app from an unsigned .xcarchive into an unsigned .ipa.
#
# An .ipa is just a zip with the app under Payload/. We build the archive with
# code signing disabled (no certs, no match, no ASC secrets needed) and wrap the
# product here. The resulting IPA is NOT installable as-is — it is meant to be
# re-signed by the end user with their own certificate via AltStore, Sideloadly,
# SideStore, etc. before sideloading. See docs/release/sideloading.md.
def package_unsigned_ipa(archive_path:, app_name:, output_dir:, output_ipa:)
  app_path = "#{archive_path}/Products/Applications/#{app_name}.app"
  UI.user_error!("Expected app not found at #{app_path}") unless File.exist?(app_path)

  # zip must run from output_dir so the archive root is Payload/, not an
  # absolute path. Rebuild Payload/ from scratch each run for idempotency.
  sh(<<~SH)
    set -euo pipefail
    cd #{output_dir.shellescape}
    rm -rf Payload #{output_ipa.shellescape}
    mkdir Payload
    cp -R #{app_path.shellescape} Payload/
    zip -qry #{output_ipa.shellescape} Payload
    rm -rf Payload
  SH

  UI.success("Unsigned IPA written to #{output_dir}/#{output_ipa}")
end

def testflight_distribution
  mode = ENV.fetch("TESTFLIGHT_DISTRIBUTION", "internal").strip.downcase

  case mode
  when "", "internal", "private"
    "internal"
  when "external", "public"
    "external"
  else
    UI.user_error!(
      "Unsupported TESTFLIGHT_DISTRIBUTION=#{mode.inspect}. " \
      "Use internal, public, or external."
    )
  end
end

def testflight_upload_config
  distribution = testflight_distribution
  internal_groups = env_list("TESTFLIGHT_INTERNAL_GROUPS")

  return {
    distribution: distribution,
    groups: internal_groups.any? ? internal_groups : nil,
    distribute_external: false,
    notify_external_testers: false,
  } if distribution == "internal"

  external_groups = env_list("TESTFLIGHT_EXTERNAL_GROUPS")
  UI.user_error!(
    "TESTFLIGHT_EXTERNAL_GROUPS must be set to one or more external " \
    "TestFlight group names when TESTFLIGHT_DISTRIBUTION is public/external."
  ) if external_groups.empty?

  {
    distribution: distribution,
    groups: external_groups,
    distribute_external: true,
    notify_external_testers: env_truthy?("TESTFLIGHT_NOTIFY_EXTERNAL_TESTERS", default: true),
  }
end

# ── CI keychain teardown ──────────────────────────────────────────────────────
#
# setup_ci creates fastlane_tmp_keychain and makes it the user default. With
# no teardown, an interrupted lane leaves the temp keychain as the permanent
# user default; once its file is later removed, macOS pops "Keychain Not
# Found" prompts at random for unrelated apps on the runner. Snapshot the
# original state before any lane runs and restore it on success and error.
#
# Keychains only exist on macOS; the reserve_build_numbers lane runs on a
# Linux runner where `security` is absent, so gate every hook on mac? too.

def ci_keychain_managed?
  is_ci && FastlaneCore::Helper.mac?
end

before_all do |_lane, _options|
  next unless ci_keychain_managed?
  ENV["FL_ORIG_DEFAULT_KC"] = `security default-keychain -d user`.scan(/"([^"]+)"/).flatten.first.to_s
  ENV["FL_ORIG_KC_LIST"]    = `security list-keychains   -d user`.scan(/"([^"]+)"/).flatten.join(":")
end

after_all do |_lane, _options|
  restore_ci_keychain_state if ci_keychain_managed?
end

error do |_lane, _exception, _options|
  restore_ci_keychain_state if ci_keychain_managed?
end

# Each step is independently rescued so a failure in one doesn't abort the
# others — the search-list restore is the load-bearing recovery for the
# original "Keychain Not Found" symptom and must run even if the default
# restore fails.
def restore_ci_keychain_state
  begin
    delete_keychain(name: "fastlane_tmp_keychain")
  rescue StandardError
    # Already removed by another lane / the keychain sweeper — fine.
  end

  default = ENV["FL_ORIG_DEFAULT_KC"]
  if default && !default.empty? && File.exist?(default)
    begin
      sh("security default-keychain -d user -s #{default.shellescape}")
    rescue StandardError => e
      UI.important("Failed to restore default keychain (#{default}): #{e.message}")
    end
  end

  list = (ENV["FL_ORIG_KC_LIST"] || "").split(":").reject(&:empty?)
  unless list.empty?
    begin
      sh("security list-keychains   -d user -s #{list.map(&:shellescape).join(' ')}")
    rescue StandardError => e
      UI.important("Failed to restore keychain search list: #{e.message}")
    end
  end
end

# ── iOS + tvOS ────────────────────────────────────────────────────────────────

platform :ios do

  # ── Signing maintenance ───────────────────────────────────────────────────

  desc "Generate/refresh all App Store provisioning profiles in the Match repo (run locally, read-write)"
  lane :sync_signing do
    api_key = setup_api_key

    # iOS: app + notification service extension + downloads Live Activity extension.
    match(
      type:           "appstore",
      platform:       "ios",
      app_identifier: [
        "org.siloserver.silo",
        "org.siloserver.silo.NotificationService",
        "org.siloserver.silo.DownloadsActivity",
      ],
      readonly:       false,
      api_key:        api_key
    )

    # tvOS: app + Top Shelf extension.
    match(
      type:           "appstore",
      platform:       "tvos",
      app_identifier: ["org.siloserver.silo", "org.siloserver.silo.topshelf"],
      readonly:       false,
      api_key:        api_key
    )
  end

  # ── iOS TestFlight ────────────────────────────────────────────────────────

  desc "Build the iOS app and upload to TestFlight"
  lane :beta_ios do
    # setup_ci creates a temporary keychain on CI runners; no-op locally.
    setup_ci if is_ci

    api_key        = setup_api_key
    app_id         = "org.siloserver.silo"
    notification_id = "org.siloserver.silo.NotificationService"
    downloads_id    = "org.siloserver.silo.DownloadsActivity"
    team_id        = ENV["TEAM_ID"]
    # The release workflow always sets TESTFLIGHT_DISTRIBUTION=external (see
    # .github/workflows/release.yml): every tag and manual dispatch distributes
    # to TESTFLIGHT_EXTERNAL_GROUPS and notifies testers. Internal remains the
    # default only for ad-hoc local runs with the env var unset.
    testflight_upload = testflight_upload_config
    # Apple requires a "What to Test" note for every external group build.
    # Set TESTFLIGHT_CHANGELOG in CI variables for an explicit note;
    # falls back to the latest git commit subject when not set.
    changelog       = ENV["TESTFLIGHT_CHANGELOG"] || `git log -1 --pretty=format:"%s"`.strip
    ios_app_dir     = File.expand_path("../iosApp", __dir__)
    UI.message("TestFlight distribution: #{testflight_upload[:distribution]}")

    # Regenerate Silo.xcodeproj from project.yml first — match must run on
    # an existing project so it can write the provisioning profile specifier into
    # it. Running xcodegen after match would wipe those settings out.
    sh("xcodegen generate --spec '#{ios_app_dir}/project.yml'")

    # Sync distribution certs + provisioning profiles for the app and both
    # embedded extensions. Each needs its own profile because they have
    # different bundle IDs (and the notification service extension carries its
    # own App Group entitlement, which must be declared on its App ID).
    match(
      type:           "appstore",
      platform:       "ios",
      app_identifier: [app_id, notification_id, downloads_id],
      readonly:       is_ci,
      api_key:        api_key
    )

    # iOS-specific build number (injected by CI's reserve_build_numbers job, or
    # queried directly for local runs). platform: "ios" scopes the query to iOS
    # builds only — tvOS tracks its own sequence independently under Universal
    # Purchase.
    build_number = resolve_build_number(
      api_key:        api_key,
      app_identifier: app_id,
      platform:       "ios"
    )

    # Resolve SPM packages before building.
    sh("xcodebuild -project '#{ios_app_dir}/Silo.xcodeproj' " \
       "-scheme Silo -resolvePackageDependencies")

    # Pull the profile names for all three targets from the match mapping.
    profile_map          = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    app_profile          = profile_map[app_id]
    notification_profile = profile_map[notification_id]
    downloads_profile    = profile_map[downloads_id]

    # Patch signing settings per-target in the regenerated Xcode project.
    # xcodebuild needs per-target PROVISIONING_PROFILE_SPECIFIER during the
    # archive step; a single global xcarg would apply the app's profile to the
    # extension targets (different bundle IDs → signing failure). Same pattern
    # as the tvOS lane's Top Shelf handling.
    {
      "Silo"                    => app_profile,
      "SiloNotificationService" => notification_profile,
      "SiloDownloadsActivity"   => downloads_profile,
    }.each do |target, profile|
      update_code_signing_settings(
        use_automatic_signing: false,
        path:                  "#{ios_app_dir}/Silo.xcodeproj",
        targets:               [target],
        code_sign_identity:    "Apple Distribution",
        profile_name:          profile,
        team_id:               team_id
      )
    end

    build_app(
      project:          "#{ios_app_dir}/Silo.xcodeproj",
      scheme:           "Silo",
      destination:      "generic/platform=iOS",
      export_method:    "app-store",
      output_directory: "build/ios",
      output_name:      "Silo.ipa",
      # PROVISIONING_PROFILE_SPECIFIER is intentionally absent from xcargs —
      # a global value would override every target with the same profile.
      # Per-target settings were written above via update_code_signing_settings.
      xcargs: "#{marketing_version_xcarg}" \
              "CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY='Apple Distribution' " \
              "CURRENT_PROJECT_VERSION=#{build_number} " \
              "DEVELOPMENT_TEAM=#{team_id}",
      # export_options.provisioningProfiles maps each bundle ID to its profile
      # name for the IPA packaging step (separate from the archive step above).
      export_options: {
        method:               "app-store",
        signingStyle:         "manual",
        provisioningProfiles: {
          app_id          => app_profile,
          notification_id => notification_profile,
          downloads_id    => downloads_profile,
        }
      }
    )

    upload_to_testflight(
      api_key:                 api_key,
      app_identifier:          app_id,
      ipa:                     "build/ios/Silo.ipa",
      # Public/external tags wait for Apple processing so groups can be assigned.
      changelog:               changelog,
      groups:                  testflight_upload[:groups],
      distribute_external:     testflight_upload[:distribute_external],
      notify_external_testers: testflight_upload[:notify_external_testers]
    )
  end

  # ── tvOS TestFlight ───────────────────────────────────────────────────────

  desc "Build the tvOS app and upload to TestFlight"
  lane :beta_tvos do
    # setup_ci creates a temporary keychain on CI runners; no-op locally.
    setup_ci if is_ci

    api_key        = setup_api_key
    app_id         = "org.siloserver.silo"
    topshelf_id    = "org.siloserver.silo.topshelf"
    team_id        = ENV["TEAM_ID"]
    # The release workflow always sets TESTFLIGHT_DISTRIBUTION=external (see
    # .github/workflows/release.yml): every tag and manual dispatch distributes
    # to TESTFLIGHT_EXTERNAL_GROUPS and notifies testers. Internal remains the
    # default only for ad-hoc local runs with the env var unset.
    testflight_upload = testflight_upload_config
    # Apple requires a "What to Test" note for every external group build.
    # Set TESTFLIGHT_CHANGELOG in CI variables for an explicit note;
    # falls back to the latest git commit subject when not set.
    changelog       = ENV["TESTFLIGHT_CHANGELOG"] || `git log -1 --pretty=format:"%s"`.strip
    ios_app_dir     = File.expand_path("../iosApp", __dir__)
    UI.message("TestFlight distribution: #{testflight_upload[:distribution]}")

    # Regenerate .xcodeproj from project.yml first — same reason as beta_ios:
    # match must write the provisioning profile into an existing project, and
    # xcodegen must not run after match or it will overwrite those settings.
    sh("xcodegen generate --spec '#{ios_app_dir}/project.yml'")

    # Sync distribution certs + provisioning profiles for both the tvOS app
    # and the embedded Top Shelf extension. Both need their own profile because
    # they have different bundle IDs and different entitlements (App Group +
    # Keychain Sharing must be declared in the portal for both App IDs).
    match(
      type:           "appstore",
      platform:       "tvos",
      app_identifier: [app_id, topshelf_id],
      readonly:       is_ci,
      api_key:        api_key
    )

    # tvOS-specific build number (injected by CI's reserve_build_numbers job, or
    # queried directly for local runs). platform: "appletvos" scopes the query to
    # tvOS builds only — independent from the iOS sequence under Universal Purchase.
    build_number = resolve_build_number(
      api_key:        api_key,
      app_identifier: app_id,
      platform:       "appletvos"
    )

    # Resolve SPM packages before building.
    sh("xcodebuild -project '#{ios_app_dir}/Silo.xcodeproj' " \
       "-scheme SiloTV -resolvePackageDependencies")

    # Pull both profile names from the match mapping.
    profile_map     = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    tv_profile      = profile_map[app_id]
    shelf_profile   = profile_map[topshelf_id]

    # Patch signing settings per-target in the regenerated Xcode project.
    # xcodebuild needs per-target PROVISIONING_PROFILE_SPECIFIER during the
    # archive step; a single global xcarg would apply the wrong profile to the
    # extension target (different bundle ID → different entitlements → signing
    # failure). update_code_signing_settings writes the correct profile name
    # into each target's build settings before archiving.
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "#{ios_app_dir}/Silo.xcodeproj",
      targets:               ["SiloTV"],
      code_sign_identity:    "Apple Distribution",
      profile_name:          tv_profile,
      team_id:               team_id
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "#{ios_app_dir}/Silo.xcodeproj",
      targets:               ["SiloTVTopShelf"],
      code_sign_identity:    "Apple Distribution",
      profile_name:          shelf_profile,
      team_id:               team_id
    )

    build_app(
      project:          "#{ios_app_dir}/Silo.xcodeproj",
      scheme:           "SiloTV",
      destination:      "generic/platform=tvOS",
      export_method:    "app-store",
      output_directory: "build/tvos",
      output_name:      "SiloTV.ipa",
      # PROVISIONING_PROFILE_SPECIFIER is intentionally absent from xcargs —
      # a global value would override both targets with the same profile.
      # Per-target settings were written above via update_code_signing_settings.
      xcargs: "#{marketing_version_xcarg}" \
              "CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY='Apple Distribution' " \
              "CURRENT_PROJECT_VERSION=#{build_number} " \
              "DEVELOPMENT_TEAM=#{team_id}",
      # export_options.provisioningProfiles maps each bundle ID to its profile
      # name for the IPA packaging step (separate from the archive step above).
      export_options: {
        method:               "app-store",
        signingStyle:         "manual",
        provisioningProfiles: {
          app_id      => tv_profile,
          topshelf_id => shelf_profile,
        }
      }
    )

    upload_to_testflight(
      api_key:                 api_key,
      app_identifier:          app_id,
      ipa:                     "build/tvos/SiloTV.ipa",
      # Public/external tags wait for Apple processing so groups can be assigned.
      changelog:               changelog,
      groups:                  testflight_upload[:groups],
      distribute_external:     testflight_upload[:distribute_external],
      notify_external_testers: testflight_upload[:notify_external_testers]
    )
  end

  # ── Build-number reservation ────────────────────────────────────────────────

  desc "Reserve the next per-platform TestFlight build numbers (CI preflight)"
  lane :reserve_build_numbers do
    # Query-only: no keychain/signing setup needed, so this runs on a plain
    # Linux runner. Computes the next iOS and tvOS build numbers once so the
    # parallel beta_ios / beta_tvos jobs consume fixed values instead of each
    # racing latest_testflight_build_number.
    api_key = setup_api_key
    app_id  = "org.siloserver.silo"

    ios_build = latest_testflight_build_number(
      api_key: api_key, app_identifier: app_id, platform: "ios"
    ) + 1
    tvos_build = latest_testflight_build_number(
      api_key: api_key, app_identifier: app_id, platform: "appletvos"
    ) + 1

    # Emit key=value lines to BUILD_NUMBERS_FILE (CI points this at
    # $GITHUB_OUTPUT). Append so we never clobber other outputs already there.
    out = ENV.fetch("BUILD_NUMBERS_FILE", "build_numbers.env")
    File.open(out, "a") do |f|
      f.puts "ios_build=#{ios_build}"
      f.puts "tvos_build=#{tvos_build}"
    end
    UI.success("Reserved build numbers — iOS: #{ios_build}, tvOS: #{tvos_build}")
  end

  # ── Unsigned IPAs for third-party signing / sideloading ─────────────────────
  #
  # These lanes build an installable-once-re-signed IPA with NO code signing:
  # no match, no distribution cert, no App Store Connect key. The user re-signs
  # the artifact with their own account (AltStore / Sideloadly / SideStore / etc.)
  # before sideloading. Because nothing is uploaded and no secrets are read, they
  # run on any macOS runner without release credentials. See
  # docs/release/sideloading.md for the caveats (entitlement remapping, 7-day
  # free-account expiry, and the tvOS host-pairing / Top Shelf notes).

  desc "Build an unsigned iOS IPA for third-party signing / sideloading (no upload)"
  lane :ipa_ios_unsigned do
    ios_app_dir  = prepare_xcode_project(scheme: "Silo")
    output_dir   = File.expand_path("../build/ios-unsigned", __dir__)
    archive_path = "#{output_dir}/Silo.xcarchive"

    # Archive with signing disabled — no certs required. CURRENT_PROJECT_VERSION
    # comes from CI when set; local runs fall back to the project.yml value.
    xcodebuild(
      archive:      true,
      project:      "#{ios_app_dir}/Silo.xcodeproj",
      scheme:       "Silo",
      destination:  "generic/platform=iOS",
      archive_path: archive_path,
      xcargs:       "#{marketing_version_xcarg}#{build_number_xcarg}" \
                    "#{SIDELOAD_CHANNEL_XCARG}" \
                    "CODE_SIGNING_ALLOWED=NO " \
                    "CODE_SIGNING_REQUIRED=NO " \
                    "CODE_SIGN_IDENTITY='' " \
                    "CODE_SIGN_ENTITLEMENTS=''"
    )

    package_unsigned_ipa(
      archive_path: archive_path,
      app_name:     "Silo",
      output_dir:   output_dir,
      output_ipa:   "Silo-unsigned.ipa"
    )
  end

  desc "Build an unsigned tvOS IPA for third-party signing / sideloading (no upload)"
  lane :ipa_tvos_unsigned do
    ios_app_dir  = prepare_xcode_project(scheme: "SiloTV")
    output_dir   = File.expand_path("../build/tvos-unsigned", __dir__)
    archive_path = "#{output_dir}/SiloTV.xcarchive"

    # The embedded Top Shelf extension is archived as part of SiloTV.app, so no
    # per-target signing handling is needed here. Re-signers that cannot sign the
    # extension (e.g. free accounts) can strip it before sideloading.
    xcodebuild(
      archive:      true,
      project:      "#{ios_app_dir}/Silo.xcodeproj",
      scheme:       "SiloTV",
      destination:  "generic/platform=tvOS",
      archive_path: archive_path,
      xcargs:       "#{marketing_version_xcarg}#{build_number_xcarg}" \
                    "#{SIDELOAD_CHANNEL_XCARG}" \
                    "CODE_SIGNING_ALLOWED=NO " \
                    "CODE_SIGNING_REQUIRED=NO " \
                    "CODE_SIGN_IDENTITY='' " \
                    "CODE_SIGN_ENTITLEMENTS=''"
    )

    package_unsigned_ipa(
      archive_path: archive_path,
      app_name:     "SiloTV",
      output_dir:   output_dir,
      output_ipa:   "SiloTV-unsigned.ipa"
    )
  end

end
