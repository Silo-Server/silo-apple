# Xcode / XcodeGen
iosApp/Silo.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
DerivedData/
iosApp/.deriveddata/

# XcodeGen regenerates the project, but the exact Aether transitive graph is a
# release input and must remain reviewable.
!iosApp/Silo.xcodeproj/
iosApp/Silo.xcodeproj/*
!iosApp/Silo.xcodeproj/project.xcworkspace/
iosApp/Silo.xcodeproj/project.xcworkspace/*
!iosApp/Silo.xcodeproj/project.xcworkspace/xcshareddata/
iosApp/Silo.xcodeproj/project.xcworkspace/xcshareddata/*
!iosApp/Silo.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
iosApp/Silo.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!iosApp/Silo.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# SwiftPM / CocoaPods
.build/
iosApp/.spm-packages/
iosApp/Pods/

# Fastlane build outputs (IPAs, archives from the ipa_*_unsigned lanes)
build/
fastlane/README.md

# Local signing and secrets
iosApp/Signing/Local.xcconfig
.env
.env.*
!.env.example
*.p8
*.p12
*.mobileprovision
*.cer

# Ruby / Fastlane
vendor/bundle/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Local tooling state
# `.agents/skills` is a symlink to `.claude/skills` so non-Claude agents find the
# same files; everything else under .agents/ is per-developer scratch.
/.agents/*
!/.agents/skills
# Ignore everything in .claude/ except the committed, shared skills.
/.claude/*
!/.claude/skills/
.codex/
.cursor/
.sweetpad/
.worktrees/
.playwright-mcp/
.playwright-cli/
.superpowers/
buildServer.json

# Logs and OS files
*.log
logs/
output/
.DS_Store
Thumbs.db
.swiftpm/
docs/*
!docs/tvos-focus.md
!docs/mac-builder.md
!docs/tvos-player/
docs/tvos-player/*
!docs/tvos-player/aetherengine-replacement-spec.md
!docs/release/*
